# Copy this file to `.env` for local builds and scripts.
# Do not commit real tokens. Store production secrets in Infisical and mirror CI-required values
# to GitHub Actions secrets.

# GitHub fine-grained PAT used by Changesets to create release pull requests.
# Grant Contents and Pull requests read/write access to this repository.
CHANGESETS_TOKEN=

# Canonical production URL used by the docs app (Astro), sitemap, and OG tags.
# The deploy-docs workflow falls back to this value when the repo var is unset.
PUBLIC_SITE_URL=https://lumen.santi020k.com

# Cloudflare account id used by Wrangler and the deploy-docs workflow.
# Cloudflare Dashboard -> Workers & Pages -> Overview -> Account ID.
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with permission to deploy Cloudflare Pages.
# Create at https://dash.cloudflare.com/profile/api-tokens
# Recommended permissions:
# - Account: Cloudflare Pages: Edit
# - Account: Account Settings: Read
CLOUDFLARE_API_TOKEN=

# Cloudflare Pages project name. Keep this in sync with the Pages project.
CLOUDFLARE_PAGES_PROJECT_NAME=lumen

# Branch that Wrangler treats as the production deployment branch.
CLOUDFLARE_PAGES_PRODUCTION_BRANCH=main

# npm publishing
# Used by the release workflow to publish the lumen packages to npm.
# Generate at https://www.npmjs.com/settings/<user>/tokens
NPM_TOKEN=

# Maven Central publishing for the Jetpack Compose package.
# Generate a Central Portal user token at https://central.sonatype.com/usertoken
# and keep the complete ASCII-armored private signing key in the local value.
MAVEN_CENTRAL_USERNAME=
MAVEN_CENTRAL_PASSWORD=
MAVEN_SIGNING_KEY=
MAVEN_SIGNING_PASSWORD=

# Turbo remote cache — shares build artifacts across CI runs.
# Get a token at https://vercel.com/docs/monorepos/remote-caching
TURBO_TOKEN=
TURBO_TEAM=

# Auth token for private remote component registries used by the lumen CLI.
# Optional; can also be passed via the --registry-token flag.
LUMEN_REGISTRY_TOKEN=

# Set to 1 to force regeneration of docs OG images (apps/docs/scripts/generate-og-images.mjs).
# Optional; leave blank to only generate missing images.
FORCE_OG=

---
import Stack from '@santi020k/lumen-astro/components/Stack'
import Grid from '@santi020k/lumen-astro/components/Grid'
import Card from '@santi020k/lumen-astro/components/Card'
import CardHeader from '@santi020k/lumen-astro/components/CardHeader'
import CardTitle from '@santi020k/lumen-astro/components/CardTitle'
import CardDescription from '@santi020k/lumen-astro/components/CardDescription'
import CardContent from '@santi020k/lumen-astro/components/CardContent'
import CardFooter from '@santi020k/lumen-astro/components/CardFooter'
import Button from '@santi020k/lumen-astro/components/Button'
import ButtonLink from '@santi020k/lumen-astro/components/ButtonLink'
import Badge from '@santi020k/lumen-astro/components/Badge'
import Alert from '@santi020k/lumen-astro/components/Alert'
import Icon from '@santi020k/lumen-astro/components/Icon'
import ThemeToggle from '@santi020k/lumen-astro/components/ThemeToggle'
import Timeline from '@santi020k/lumen-astro/components/Timeline'
import TimelineItem from '@santi020k/lumen-astro/components/TimelineItem'
import Code from '@santi020k/lumen-astro/components/Code'
import Typography from '@santi020k/lumen-astro/components/Typography'
import InputGroup from '@santi020k/lumen-astro/components/InputGroup'
import Input from '@santi020k/lumen-astro/components/Input'
import Label from '@santi020k/lumen-astro/components/Label'
import Field from '@santi020k/lumen-astro/components/Field'
import FieldError from '@santi020k/lumen-astro/components/FieldError'
import Checkbox from '@santi020k/lumen-astro/components/Checkbox'
import Switch from '@santi020k/lumen-astro/components/Switch'
import Textarea from '@santi020k/lumen-astro/components/Textarea'
import NativeSelect from '@santi020k/lumen-astro/components/NativeSelect'
import Progress from '@santi020k/lumen-astro/components/Progress'
import Skeleton from '@santi020k/lumen-astro/components/Skeleton'
import Avatar from '@santi020k/lumen-astro/components/Avatar'
import Collapsible from '@santi020k/lumen-astro/components/Collapsible'
import Separator from '@santi020k/lumen-astro/components/Separator'
import Table from '@santi020k/lumen-astro/components/Table'
import SpeedDial from '@santi020k/lumen-astro/components/SpeedDial'
---

<h1>Component composition</h1>
<Stack gap="group">
  <Card>
    <CardHeader><CardTitle>Delivery sample</CardTitle><CardDescription>Shared composition</CardDescription></CardHeader>
    <CardContent><Badge variant="outline">Ready</Badge><Avatar alt="Sample author" fallback="SA" /><Alert>Saved successfully</Alert></CardContent>
    <CardFooter><Button><Icon name="check" />Save</Button><ButtonLink href="#details">Read more</ButtonLink></CardFooter>
  </Card>
  <Grid><ThemeToggle /><Code variant="block" code="const greeting = 'Hello'" copy label="Example" /><Icon name="copy" /></Grid>
  <Typography><h2 id="details">Details</h2><p>Keep <strong>semantic structure</strong> and <code>readable examples</code>.</p></Typography>
  <Timeline><TimelineItem><p>First milestone</p></TimelineItem><TimelineItem><Icon slot="dot" name="check" />Second milestone</TimelineItem></Timeline>
  <Field><Label for="sample-input">Email</Label><InputGroup><Icon name="mail" /><Input id="sample-input" value="sample@example.test" /><Button>Send</Button></InputGroup><FieldError>Example data only.</FieldError></Field>
  <Checkbox checked aria-label="Selected item" /><Switch checked aria-label="Enabled option" />
  <Textarea aria-label="Notes">Sample notes</Textarea>
  <NativeSelect aria-label="Location"><option>Colombia</option><option>Japan</option></NativeSelect>
  <Progress value={65} aria-label="Progress" /><Skeleton animation="none" width="60%" height={20} />
  <Collapsible open><summary>More detail</summary><p>Expanded content</p></Collapsible>
  <Separator />
  <Table><table><thead><tr><th>Name</th><th>Status</th></tr></thead><tbody><tr><td>Sample</td><td>Ready</td></tr></tbody></table></Table>
  <SpeedDial defaultOpen actions={[{ label: 'Copy', icon: 'copy' }, { label: 'Save', icon: 'check' }]} />
</Stack>

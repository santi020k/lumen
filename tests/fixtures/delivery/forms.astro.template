---
import Form from '@santi020k/lumen-astro/components/Form'
import Field from '@santi020k/lumen-astro/components/Field'
import Label from '@santi020k/lumen-astro/components/Label'
import Input from '@santi020k/lumen-astro/components/Input'
import Select from '@santi020k/lumen-astro/components/Select'
import UIPrimitives from '@santi020k/lumen-astro/runtime'
---
<h1>Form delivery</h1>
<Form>
  <Field controlId="email"><Label for="email">Email</Label><Input id="email" name="email" type="email" required /></Field>
  <Field controlId="plan"><Label for="plan">Plan</Label><Select id="plan" name="plan" options={['Personal', 'Team']} /></Field>
</Form>
<UIPrimitives />

---
import { createSatteriMarkdownProcessor } from '@astrojs/markdown-satteri'
import { ClientRouter } from 'astro:transitions'

import Link from '@santi020k/lumen-astro/components/Link'
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import CodeExample from '../lumen/code-example.astro'
import Share from '../lumen/share.astro'
import VideoDialog from '../lumen/editorial-video-dialog.astro'

const source = Array.from({ length: 60 }, (_, index) => 'export const item' + index + ' = "' + 'readable source '.repeat(15) + '";').join('\n')
const processor = await createSatteriMarkdownProcessor()
const highlighted = await processor.render('~~~ts\n' + source + '\n~~~')
---

<!doctype html>
<html lang="en" data-theme="lumen-light">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Product workflows</title><ClientRouter /></head>
  <body>
    <main>
      <h1>Product workflows</h1>
      <VideoDialog id="workflow-film" title="Product film" src="/film.mp4" playLabel="Watch film" closeLabel="Close film" fileLabel="Open film file" errorLabel="Film unavailable." transcriptLabel="Read transcript" captions={[{ src: '/captions.vtt', language: 'en', label: 'English', default: true }]}>
        <p slot="transcript" id="film-transcript">A complete transcript of the product film.</p>
      </VideoDialog>
      <CodeExample id="long-source" title="Complete configuration" source={source} language="ts" highlighted>
        <Fragment set:html={highlighted.code} />
      </CodeExample>
      <Share id="workflow-share" title="Product workflows" url="https://example.com/guide/" destinations={[{ label: 'Email the guide', href: 'mailto:reader@example.com', newTab: true }]} />
      <Link href="/other/">Continue to another page</Link>
    </main>
    <footer><Link href="https://santi020k.com">Santiago Molina</Link></footer>
    <UIPrimitives />
  </body>
</html>

<script>
  import { navigate } from 'astro:transitions/client'

  document.addEventListener('fixture:navigate', () => { void navigate('/other/') })
</script>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: hsl(var(--canvas)); color: hsl(var(--ink)); font-family: system-ui, sans-serif; overflow-wrap: anywhere; }
  main, footer { inline-size: min(100% - 2rem, 64rem); margin-inline: auto; padding-block: 1rem; }
  main { display: grid; gap: 1.25rem; }
</style>

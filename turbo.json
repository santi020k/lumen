{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CI", "NPM_TOKEN", "NODE_AUTH_TOKEN", "VITEST"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig*.json"],
      "outputs": ["dist/**", ".astro/**", ".next/**"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig*.json"],
      "outputLogs": "errors-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/vitest.config.ts"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "outputLogs": "errors-only"
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"],
      "outputLogs": "errors-only"
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "check": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "//#lint:repo": {
      "outputLogs": "errors-only"
    },
    "//#lint:spell": {
      "outputLogs": "errors-only"
    },
    "//#lint:knip": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "//#check:registry": {
      "outputLogs": "errors-only"
    },
    "clean": {
      "cache": false
    }
  },
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "errorsOnlyShowHash": true
  }
}

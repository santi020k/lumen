---
import '../../styles/composition.css'
import '@santi020k/lumen-astro/styles.css'

import { lumenEasings } from '@santi020k/lumen-core'
import { transformSync } from 'esbuild'

import BrandOutro from '../../components/BrandOutro.astro'
import { formats, outroDuration } from '../../composition'
import timelineSource from '../../scripts/timeline.ts?raw'

export const getStaticPaths = () => formats.map(format => ({ params: { format } }))

const format = Astro.params.format
const timeline = transformSync(timelineSource, { loader: 'ts', format: 'iife' }).code
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Lumen UI — Reusable brand ending</title>
    <script is:inline src="/assets/gsap.min.js"></script>
    <script is:inline src="/assets/CustomEase.min.js"></script>
  </head>
  <body>
    <main data-composition-id="brand-outro" data-width={format === 'landscape' ? 1920 : 1080} data-height={format === 'portrait' ? 1920 : 1080} data-duration={outroDuration} data-outro-start="0" data-ease={lumenEasings.emphasized.join(',')} data-format={format}>
      <BrandOutro />
    </main>
    <script is:inline set:html={timeline}></script>
  </body>
</html>

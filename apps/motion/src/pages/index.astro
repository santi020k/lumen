---
import '@santi020k/lumen-astro/styles.css'
import '../styles/preview.css'

import { Badge, Button, Image, Link } from '@santi020k/lumen-astro'
---

<!doctype html>
<html lang="en" data-theme="lumen-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Lumen motion studio — One interface, three themes</title>
    <meta name="description" content="Preview a locally rendered Lumen UI composition in vertical, square, and landscape formats." />
  </head>
  <body>
    <main class="preview-shell">
      <header class="preview-header">
        <Image src="/assets/logo.svg" alt="Lumen UI" width={194} height={50} loading="eager" />
        <Badge variant="outline">Local pilot · 18 seconds</Badge>
      </header>
      <div class="preview-layout">
        <section class="preview-copy" aria-labelledby="preview-title">
          <p class="preview-eyebrow">LUMEN MOTION STUDIO</p>
          <h1 id="preview-title">One interface.<br />Three themes.</h1>
          <p>Watch the same interface build, change appearance, and adapt from a wide workspace to a compact layout.</p>
          <div class="controls" role="group" aria-label="Video format">
            <Button data-format="portrait" aria-pressed="true">Vertical</Button>
            <Button data-format="square" variant="outline" aria-pressed="false">Square</Button>
            <Button data-format="landscape" variant="outline" aria-pressed="false">Landscape</Button>
          </div>
          <div class="controls" role="group" aria-label="Choose appearance">
            <Button data-time="2" variant="outline" aria-pressed="true">Light</Button>
            <Button data-time="8" variant="outline" aria-pressed="false">Dark</Button>
            <Button data-time="14" variant="outline" aria-pressed="false">Studio</Button>
          </div>
          <div class="controls" role="group" aria-label="Playback">
            <Button id="play">Play animation</Button>
            <Button id="pause" variant="outline">Pause</Button>
          </div>
          <p id="playback-status" role="status">Paused · Lumen Light</p>
          <p id="motion-preference" hidden>Reduced motion is enabled. Choose an appearance to view a still frame.</p>
          <p class="preview-note">Illustrative workspace with sample data. The composition is silent and uses local assets.</p>
          <Link href="https://lumen.santi020k.com/docs/theme-playground" newTab>Explore the theme playground ↗</Link>
        </section>
        <section class="preview-stage" aria-label="Animation preview">
          <div class="frame-container" data-preview-format="portrait">
            <iframe id="composition" src="/portrait/" title="Lumen UI theme animation" width="1080" height="1920"></iframe>
          </div>
        </section>
      </div>
      <footer class="preview-footer">Created with Lumen UI and HyperFrames · <Link href="https://santi020k.com" newTab>santi020k</Link></footer>
    </main>
    <script>
      import '../scripts/preview'
    </script>
  </body>
</html>

{
  "expo": {
    "name": "Lumen React Native Playground",
    "slug": "lumen-react-native-playground",
    "description": "Explore Lumen UI's accessible React Native components, themes, charts, forms, and native interaction patterns without creating an account.",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "lumen-playground",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0f172a",
    "primaryColor": "#7c3aed",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "githubUrl": "https://github.com/santi020k/lumen",
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.santi020k.lumen.playground.reactnative",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "allowBackup": false,
      "icon": "./assets/icon.png",
      "package": "com.santi020k.lumen.playground.reactnative"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Lumen Playground",
      "output": "single",
      "shortName": "Lumen"
    },
    "extra": {
      "eas": {
        "projectId": "669035f0-04c0-41cd-9ca6-73d99bdb7dce"
      }
    },
    "owner": "santi020k",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/669035f0-04c0-41cd-9ca6-73d99bdb7dce"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0f172a",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ]
  }
}

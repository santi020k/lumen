{
  "name": "@santi020k/lumen-template-showcase",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone verification and preview app for Lumen product templates.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "clean": "rm -rf dist .astro coverage",
    "dev": "astro dev --port 4322",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts --project template-showcase --passWithNoTests",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@santi020k/lumen-astro": "workspace:^",
    "@santi020k/lumen-templates": "workspace:*",
    "astro": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/ts-plugin": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

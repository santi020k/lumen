{
  "name": "@santi020k/lumen-figma-plugin",
  "version": "1.1.0",
  "private": true,
  "description": "Offline Figma plugin for versioned Lumen web and native starters and design handoff.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite --host 127.0.0.1 --port 4348",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "test": "vitest run --config ../../vitest.config.ts --project figma-plugin && node --test scripts/package.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.plugin.json --noEmit",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:generated": "node scripts/build.mjs && node scripts/verify-generated.mjs"
  },
  "dependencies": {
    "@santi020k/lumen-core": "workspace:^",
    "@santi020k/lumen-react": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@astrojs/compiler": "catalog:",
    "@figma/plugin-typings": "catalog:",
    "@santi020k/lumen-elements": "workspace:^",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "lumen-astro-v4": "catalog:",
    "lumen-astro-v5": "catalog:",
    "lumen-elements-v4": "catalog:",
    "lumen-react-v4": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  }
}

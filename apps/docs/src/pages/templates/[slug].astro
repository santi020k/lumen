---
import '@santi020k/lumen-templates/styles.css'

import { Link } from '@santi020k/lumen-astro'
import {
  getLumenTemplate,
  type TemplateSlug,
  templateSlugs } from '@santi020k/lumen-templates'
import TemplateRenderer from '@santi020k/lumen-templates/TemplateRenderer.astro'

import FigmaCommunityLink from '../../components/FigmaCommunityLink.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'

export const getStaticPaths = () => templateSlugs.map(slug => ({ params: { slug } }))

const slug = Astro.params.slug as TemplateSlug
const template = getLumenTemplate(slug)

if (!template) {
  throw new Error(`Unknown template slug: ${slug}`)
}
---

<BaseLayout
  description={template.description}
  title={`${template.name} — Lumen templates`}
>
  <TemplateRenderer {slug} />
  <nav
    aria-label="Template resources"
    class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-5 py-6"
  >
    <Link href="/templates">All templates</Link>
    <FigmaCommunityLink file="templates" />
  </nav>
</BaseLayout>

---

/* cspell:ignore aaronmgz Aarón commitprompt coolstead difftale */

import {
  Alert,
  AnimatedNumber,
  Avatar,
  Badge,
  Button,
  ButtonGroup,
  ButtonLink,
  Calendar,
  Card,
  Checkbox,
  Eyebrow,
  Field,
  Icon,
  Image,
  Input,
  Label,
  Marker,
  Progress,
  RevealGroup,
  ScrollReveal,
  Stat,
  Switch,
  Tabs
} from '@santi020k/lumen-astro'
import { lumenComponentNames } from '@santi020k/lumen-core'

import FrameworkSetupTabs from '../components/FrameworkSetupTabs.astro'
import GitHubIcon from '../components/GitHubIcon.astro'
import HomeWorkbench from '../components/HomeWorkbench.astro'
import { frameworkSetups } from '../data/docs'
import BaseLayout from '../layouts/BaseLayout.astro'

const componentCount = lumenComponentNames.length
const aiSkillInstallCommand = 'npx skills add santi020k/lumen --skill lumen-ui'

const installerIcons = {
  astro: 'asterisk',
  elements: 'blocks',
  react: 'atom'
} as const

const heroInstallers = frameworkSetups.map(setup => ({
  command: setup.installCommands.find(install => install.label === 'pnpm')?.command ?? '',
  icon: installerIcons[setup.id],
  id: setup.id,
  label: setup.label
}))

const principles = [
  {
    description: 'One semantic token and component contract keeps web and native products recognizably aligned.',
    icon: 'layers-3',
    metric: '4 surfaces',
    title: 'Change platforms, not your design language.'
  },
  {
    description: 'Keyboard paths, focus management, labels, and meaningful markup are part of the primitive.',
    icon: 'shield-check',
    metric: 'A11y first',
    title: 'The accessible path is the default path.'
  },
  {
    description: 'Interactive Astro primitives use a tiny progressive-enhancement layer, not an app runtime.',
    icon: 'zap',
    metric: '~4 KB',
    title: 'Keep the interaction. Lose the weight.'
  }
] as const

const categories = [
  'Actions',
  'Forms',
  'Navigation',
  'Overlays',
  'Data display',
  'Feedback',
  'Layout',
  'Brand'
] as const

interface UseCase {
  category: string
  description: string
  featured?: boolean
  href: string
  image: {
    height: number
    src: string
    width: number
  }
  linkLabel?: string
  name: string
}

const useCases: readonly UseCase[] = [
  {
    category: 'AI marketplace',
    description: 'A bilingual real-estate discovery experience that turns dense property signals into a calm, guided search.',
    href: 'https://memudo.ai',
    image: { height: 720, src: '/use-cases/memudo.jpg', width: 1280 },
    name: 'MeMudo.ai',
    featured: true
  },
  {
    category: 'Developer tooling',
    description: 'A bold documentation and product surface for catching quality, security, and accessibility problems in Astro code.',
    href: 'https://doctor.santi020k.com',
    image: { height: 716, src: '/use-cases/astro-doctor.png', width: 1272 },
    name: 'Astro Doctor',
    featured: true
  },
  {
    category: 'Family platform',
    description: 'A warm, bilingual family experience built around milestones, memories, and the arrival of baby Aarón.',
    href: 'https://aaronmgz.com',
    image: { height: 716, src: '/use-cases/aaronmgz.png', width: 1272 },
    name: 'Aarón MGZ'
  },
  {
    category: 'CLI documentation',
    description: 'A focused product story for writing intentional Conventional Commits without memorizing the syntax.',
    href: 'https://commitprompt.santi020k.com',
    image: { height: 720, src: '/use-cases/commitprompt.png', width: 1280 },
    name: 'Commitprompt'
  },
  {
    category: 'macOS utility',
    description: 'A safety-minded landing page for steady Mac cooling, live thermal insight, and quieter fan control.',
    href: 'https://coolstead.santi020k.com',
    image: { height: 630, src: '/use-cases/coolstead.jpg', width: 1200 },
    name: 'Coolstead'
  },
  {
    category: 'Editor intelligence',
    description: 'Documentation for dependency health, safe update targets, and vulnerability signals inside VS Code and Zed.',
    href: 'https://beacon.santi020k.com',
    image: { height: 900, src: '/use-cases/dep-beacon.jpg', width: 1600 },
    name: 'Dep Beacon'
  },
  {
    category: 'VS Code extension',
    description: 'A crisp product site for AI-assisted commits, pull-request drafts, and file history without leaving the editor.',
    href: 'https://difftale.santi020k.com',
    image: { height: 630, src: '/use-cases/difftale.jpg', width: 1200 },
    name: 'Difftale'
  },
  {
    category: 'Documentation system',
    description: 'A deep technical reference that makes a large, multi-package ESLint platform approachable and navigable.',
    href: 'https://eslint.santi020k.com',
    image: { height: 630, src: '/use-cases/eslint-config.webp', width: 1200 },
    name: 'ESLint Config'
  },
  {
    category: 'Private dashboard',
    description: 'An owner-only project intelligence workspace for repository, package, deployment, and attention signals.',
    href: 'https://github.com/santi020k/observatory',
    image: { height: 720, src: '/use-cases/observatory.jpg', width: 1280 },
    linkLabel: 'View source',
    name: 'Observatory'
  },
  {
    category: 'iPhone app',
    description: 'A bilingual launch and support hub for a private, on-device visual studio for photos and social layouts.',
    href: 'https://postlens.santi020k.com',
    image: { height: 630, src: '/use-cases/postlens.png', width: 1200 },
    name: 'PostLens'
  },
  {
    category: 'Theme ecosystem',
    description: 'One calm violet design language presented across VS Code, Zed, Chrome, and terminal experiences.',
    href: 'https://theme.santi020k.com',
    image: { height: 630, src: '/use-cases/theme.png', width: 1200 },
    name: 'Santi020k Theme'
  },
  {
    category: 'Personal platform',
    description: 'A content-rich home for engineering work, open-source projects, writing, talks, and professional history.',
    href: 'https://santi020k.com',
    image: { height: 630, src: '/use-cases/portfolio.webp', width: 1200 },
    name: 'Santiago Molina'
  },
  {
    category: 'macOS productivity',
    description: 'A product and commerce site for organizing application windows into focused, restorable workspaces.',
    href: 'https://workspace.santi020k.com',
    image: { height: 630, src: '/use-cases/workspace-organizer.png', width: 1200 },
    name: 'Workspace Organizer'
  }
]

const pageDescription =
  `Lumen is a crafted multi-framework UI system with ${componentCount} accessible primitives ` +
  'for Web, React Native, Apple platforms, and Android.'
---

<BaseLayout
  description={pageDescription}
  title="Lumen UI — Crafted primitives for web and native platforms"
>
  <main class="home">
    <section class="home-hero">
      <div class="home-hero__wash" aria-hidden="true"></div>
      <RevealGroup class="home-hero__copy" stagger={70}>
        <Eyebrow class="home-hero__eyebrow">
          <Marker variant="success">Open source</Marker>
          <span>{componentCount} crafted primitives</span>
        </Eyebrow>
        <h1>
          Build interfaces<br />
          people <em>want</em> to use.
        </h1>
        <p class="home-hero__lede">
          A complete UI foundation for Web, React Native, Apple platforms, and Android.
          Accessible by default, beautifully tokenized, and native to every environment.
        </p>
        <div class="home-hero__actions">
          <ButtonLink class="home-button-lg" href="/docs" showArrow variant="primary">
            Start building
          </ButtonLink>
          <ButtonLink class="home-button-lg" href="/docs/components" variant="secondary">
            Explore components
          </ButtonLink>
        </div>
        <Tabs class="home-installer" glass="subtle">
          <span class="home-installer__label">Web quick install</span>
          <div role="tablist" aria-label="Choose a web framework to install">
            {heroInstallers.map((installer, index) => (
              <button
                aria-controls={`hero-install-panel-${installer.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                id={`hero-install-tab-${installer.id}`}
                role="tab"
              >
                <Icon name={installer.icon} size="sm" />
                {installer.label}
              </button>
            ))}
          </div>
          {heroInstallers.map((installer, index) => (
            <section
              aria-labelledby={`hero-install-tab-${installer.id}`}
              hidden={index !== 0}
              id={`hero-install-panel-${installer.id}`}
              role="tabpanel"
            >
              <Button
                class="home-install"
                data-copy-command={installer.command}
                variant="ghost"
              >
                <Icon name="terminal" size="sm" />
                <code>{installer.command}</code>
                <span class="home-install__copy" data-copy-feedback>Copy</span>
              </Button>
            </section>
          ))}
        </Tabs>
      </RevealGroup>

      <ScrollReveal animation="scale" class="home-hero__product" delay={140}>
        <div class="home-hero__product-label" aria-hidden="true">
          <span>Actual primitives</span>
          <i></i>
          <span>Live canvas</span>
        </div>
        <HomeWorkbench />
      </ScrollReveal>
    </section>

    <section class="home-proof" aria-label="Lumen at a glance">
      <div class="home-container home-proof__inner">
        <p>One system. Every surface.</p>
        <div class="home-proof__stats">
          <Stat label="components">
            <span class="ui-stat-value"><AnimatedNumber value={componentCount} /></span>
          </Stat>
          <Stat label="platform surfaces">
            <span class="ui-stat-value"><AnimatedNumber value={4} /></span>
          </Stat>
          <Stat label="runtime lock-in">
            <span class="ui-stat-value"><AnimatedNumber value={0} /></span>
          </Stat>
        </div>
        <div class="home-proof__categories" aria-label="Component categories">
          {categories.map(category => <Badge variant="outline">{category}</Badge>)}
        </div>
      </div>
    </section>

    <section class="home-section home-container" aria-labelledby="components-title">
      <ScrollReveal animation="slide-up">
        <div class="home-section__head home-section__head--split">
          <div>
            <Eyebrow>Designed as a system</Eyebrow>
            <h2 id="components-title">The pieces already know<br />how to work together.</h2>
          </div>
          <div class="home-section__aside">
            <p>
              Production-ready controls with consistent states, spacing, motion,
              and behavior—composed into real interface patterns.
            </p>
            <ButtonLink href="/docs/components" showArrow variant="inline">
              Browse all {componentCount} components
            </ButtonLink>
          </div>
        </div>
      </ScrollReveal>

      <RevealGroup class="home-specimens" stagger={60}>
        <Card class="home-specimen home-specimen--actions">
          <div class="home-specimen__label">
            <span>Actions</span>
            <Badge variant="secondary">7 variants</Badge>
          </div>
          <div class="home-specimen__center">
            <ButtonGroup>
              <Button>
                <Icon name="plus" size="sm" />
                Create
              </Button>
              <Button variant="secondary">Duplicate</Button>
              <Button aria-label="More actions" size="icon" variant="outline">
                <Icon name="ellipsis" size="sm" />
              </Button>
            </ButtonGroup>
          </div>
          <p>Buttons, links, groups, toggles, and toolbars share one visual rhythm.</p>
        </Card>

        <Card class="home-specimen home-specimen--form">
          <div class="home-specimen__label">
            <span>Forms</span>
            <Marker variant="success">Valid</Marker>
          </div>
          <div class="home-specimen__form">
            <Field>
              <Label for="home-email">Work email</Label>
              <Input id="home-email" placeholder="you@company.com" type="email" />
            </Field>
            <label>
              <Checkbox checked />
              <span>Send me product updates</span>
            </label>
            <Button>Join the preview</Button>
          </div>
        </Card>

        <Card class="home-specimen home-specimen--calendar">
          <div class="home-specimen__label">
            <span>Date & time</span>
            <Badge variant="outline">Keyboard ready</Badge>
          </div>
          <Calendar
            aria-label="Choose a launch date"
            month="2026-07"
            value="2026-07-23"
          />
        </Card>

        <Card class="home-specimen home-specimen--feedback">
          <div class="home-specimen__label">
            <span>Feedback</span>
            <Badge variant="secondary">Live states</Badge>
          </div>
          <div class="home-specimen__alerts">
            <Alert variant="success">
              <Icon name="circle-check" size="sm" />
              <div>
                <strong>Changes published</strong>
                <p>Your new theme is live everywhere.</p>
              </div>
            </Alert>
            <Alert variant="warning">
              <Icon name="triangle-alert" size="sm" />
              <div>
                <strong>Review contrast</strong>
                <p>Accent text needs a darker surface.</p>
              </div>
            </Alert>
          </div>
        </Card>

        <Card class="home-specimen home-specimen--identity">
          <div class="home-specimen__label">
            <span>People & progress</span>
            <Marker>In review</Marker>
          </div>
          <div class="home-specimen__identity">
            <div class="home-specimen__avatar-stack">
              <Avatar fallback="SA" />
              <Avatar fallback="AK" />
              <Avatar fallback="JM" />
              <Avatar fallback="+6" />
            </div>
            <div>
              <span>Design system rollout</span>
              <strong>82%</strong>
            </div>
            <Progress aria-label="Design system rollout" value={82} />
          </div>
        </Card>

        <Card class="home-specimen home-specimen--tokens">
          <div class="home-specimen__label">
            <span>Semantic tokens</span>
            <Switch aria-label="Enable brand theme" checked />
          </div>
          <div class="home-specimen__swatches" aria-label="Token colors">
            <span style="--swatch: hsl(var(--brand));">brand</span>
            <span style="--swatch: hsl(var(--accent));">accent</span>
            <span style="--swatch: hsl(var(--success));">success</span>
            <span style="--swatch: hsl(var(--warning));">warning</span>
            <span style="--swatch: hsl(var(--danger));">danger</span>
          </div>
          <p>Theme the meaning once. Every primitive follows.</p>
        </Card>
      </RevealGroup>
    </section>

    <section class="home-section home-container home-use-cases" aria-labelledby="use-cases-title">
      <ScrollReveal animation="slide-up">
        <div class="home-section__head home-section__head--split">
          <div>
            <Eyebrow>Lumen in production</Eyebrow>
            <h2 id="use-cases-title">One system.<br />Very different products.</h2>
          </div>
          <div class="home-section__aside">
            <p>
              From consumer products and native-app launches to private dashboards and deep
              technical documentation, these real projects use Lumen without losing their voice.
            </p>
          </div>
        </div>
      </ScrollReveal>

      <RevealGroup class="home-use-cases__grid" stagger={45}>
        {useCases.map(useCase => (
          <Card
            as="article"
            class:list={[
              'home-use-case',
              { 'home-use-case--featured': useCase.featured }
            ]}
          >
            <div class="home-use-case__preview">
              <Image
                alt={`${useCase.name} website preview`}
                height={useCase.image.height}
                src={useCase.image.src}
                width={useCase.image.width}
              />
            </div>
            <div class="home-use-case__body">
              <div class="home-use-case__meta">
                <Badge variant="outline">{useCase.category}</Badge>
                <span>{new URL(useCase.href).hostname.replace('www.', '')}</span>
              </div>
              <h3>{useCase.name}</h3>
              <p>{useCase.description}</p>
              <ButtonLink
                ariaLabel={`Open ${useCase.name} in a new tab`}
                href={useCase.href}
                newTab
                showArrow
                variant="inline"
              >
                {'linkLabel' in useCase ? useCase.linkLabel : 'Visit project'}
              </ButtonLink>
            </div>
          </Card>
        ))}
      </RevealGroup>
    </section>

    <section class="home-principles">
      <div class="home-container">
        <ScrollReveal animation="slide-up">
          <div class="home-section__head">
            <Eyebrow>Quietly rigorous</Eyebrow>
            <h2>Craft you can see.<br />Details you don’t have to chase.</h2>
          </div>
        </ScrollReveal>
        <RevealGroup class="home-principles__grid" stagger={90}>
          {principles.map((principle, index) => (
            <article class="home-principle">
              <span class="home-principle__number">0{index + 1}</span>
              <Icon name={principle.icon} />
              <Badge variant="outline">{principle.metric}</Badge>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))}
        </RevealGroup>
      </div>
    </section>

    <section class="home-section home-container home-ai" id="ai-native" aria-labelledby="ai-title">
      <ScrollReveal animation="slide-up">
        <div class="home-ai__copy">
          <Eyebrow>AI-native UI</Eyebrow>
          <h2 id="ai-title">Give your coding agent<br />the Lumen design system.</h2>
          <p>
            Install one portable skill for Codex, Claude Code, Cursor, Windsurf, and other Agent
            Skills clients. It teaches your AI to choose real Lumen primitives, respect the current
            framework, use semantic tokens, and verify accessible interactions.
          </p>
          <div class="home-ai__actions">
            <ButtonLink href="/docs/ai-skill" showArrow variant="primary">
              Explore the AI skill
            </ButtonLink>
            <ButtonLink href="/docs/mcp" variant="inline">
              Add live MCP context
            </ButtonLink>
          </div>
        </div>
      </ScrollReveal>
      <ScrollReveal animation="scale" delay={100}>
        <Card class="home-ai__terminal" glass="subtle">
          <div class="home-ai__terminal-head">
            <div class="home-ai__terminal-dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <Badge variant="outline">Agent Skills</Badge>
          </div>
          <div class="home-ai__terminal-line">
            <span>$</span>
            <code>{aiSkillInstallCommand}</code>
          </div>
          <div class="home-ai__agent-flow">
            <span><Icon decorative name="scan-search" size="sm" /> Detect framework</span>
            <span><Icon decorative name="blocks" size="sm" /> Select primitives</span>
            <span><Icon decorative name="palette" size="sm" /> Apply tokens</span>
            <span><Icon decorative name="shield-check" size="sm" /> Verify behavior</span>
          </div>
          <Button
            class="home-ai__copy-command"
            data-copy-command={aiSkillInstallCommand}
            variant="ghost"
          >
            <Icon decorative name="copy" size="sm" />
            <span data-copy-feedback>Copy install command</span>
          </Button>
        </Card>
      </ScrollReveal>
    </section>

    <section class="home-section home-container" aria-labelledby="framework-title">
      <ScrollReveal animation="slide-up">
        <div class="home-section__head home-section__head--split">
          <div>
            <Eyebrow>Web packages</Eyebrow>
            <h2 id="framework-title">One web contract.<br />Three framework implementations.</h2>
          </div>
          <div class="home-section__aside">
            <p>
              Start with the adapter for your web stack. For React Native, Apple, and Android,
              choose the platform guide from the documentation gateway.
            </p>
          </div>
        </div>
      </ScrollReveal>
      <div class="home-framework">
        <FrameworkSetupTabs setups={frameworkSetups} />
      </div>
    </section>

    <section class="home-container">
      <ScrollReveal animation="scale">
        <Card as="section" class="home-cta">
          <div class="home-cta__orb" aria-hidden="true"></div>
          <Eyebrow>Build something considered</Eyebrow>
          <h2>Your product deserves<br />better defaults.</h2>
          <p>
            Start with Lumen’s accessible primitives, then make the system unmistakably yours.
          </p>
          <div class="home-cta__actions">
            <ButtonLink class="home-button-lg" href="/docs" showArrow variant="primary">
              Read the docs
            </ButtonLink>
            <ButtonLink
              class="home-button-lg"
              href="https://github.com/santi020k/lumen"
              newTab
              variant="secondary"
            >
              <GitHubIcon />
              View on GitHub
            </ButtonLink>
          </div>
        </Card>
      </ScrollReveal>
    </section>
  </main>
</BaseLayout>

<script>
  const initHomeCopy = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-command]')) {
      if (button.dataset.copyInit === 'true') continue

      button.dataset.copyInit = 'true'

      button.addEventListener('click', async () => {
        const command = button.dataset.copyCommand

        if (!command) return

        try {
          await navigator.clipboard.writeText(command)

          const feedback = button.querySelector('[data-copy-feedback]')

          if (!feedback) return

          feedback.textContent = 'Copied'

          setTimeout(() => {
            feedback.textContent = 'Copy'
          }, 1800)
        } catch {
          // Clipboard access can be unavailable in non-secure preview contexts.
        }
      })
    }
  }

  initHomeCopy()

  document.addEventListener('astro:page-load', initHomeCopy)
</script>

<style>
  .home {
    overflow: hidden;
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .home-container {
    width: min(100% - 2.5rem, 74rem);
    margin-inline: auto;
  }

  .home-hero {
    position: relative;
    padding: clamp(5rem, 10vw, 8.5rem) 0 0;
  }

  .home-hero__wash {
    position: absolute;
    top: -12rem;
    left: 50%;
    z-index: -1;
    width: min(100rem, 130vw);
    height: 52rem;
    transform: translateX(-50%);
    background:
      radial-gradient(circle at 30% 35%, hsl(var(--brand) / .17), transparent 31%),
      radial-gradient(circle at 70% 30%, hsl(var(--accent) / .12), transparent 28%);
    filter: blur(18px);
    pointer-events: none;
  }

  .home-hero__copy {
    display: flex;
    width: min(100% - 2.5rem, 61rem);
    margin-inline: auto;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    margin-bottom: 1.5rem;
  }

  .home-hero h1 {
    max-width: 13ch;
    margin: 0;
    color: hsl(var(--ink));
    font-family: var(--app-font-display), "Montserrat", sans-serif;
    font-size: clamp(3.25rem, 7.4vw, 6.65rem);
    font-weight: 800;
    letter-spacing: -.045em;
    line-height: .96;
  }

  .home-hero h1 em {
    position: relative;
    display: inline-block;
    background: linear-gradient(110deg, hsl(var(--brand)), hsl(var(--accent)));
    background-clip: text;
    color: transparent;
    font-style: normal;
  }

  .home-hero h1 em::after {
    position: absolute;
    right: -.04em;
    bottom: -.08em;
    left: -.04em;
    height: .08em;
    border-radius: 999px;
    background: linear-gradient(90deg, hsl(var(--brand)), hsl(var(--accent)));
    content: "";
    transform: rotate(-1.5deg);
  }

  .home-hero__lede {
    max-width: 42rem;
    margin: 1.8rem 0 0;
    color: hsl(var(--ink-soft));
    font-size: clamp(1rem, 1.7vw, 1.22rem);
    line-height: 1.7;
  }

  .home-hero__actions,
  .home-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .75rem;
    margin-top: 1.8rem;
  }

  .home-button-lg {
    min-height: 3.25rem;
    padding-inline: 1.55rem;
  }

  .home-installer {
    display: grid;
    width: min(100%, 45rem);
    margin-top: 1.1rem;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: .35rem;
    border: 1px solid hsl(var(--line) / .8);
    border-radius: 999px;
    background:
      linear-gradient(180deg, hsl(var(--canvas) / .38), transparent),
      hsl(var(--surface) / .66);
    box-shadow:
      0 12px 38px hsl(var(--ink) / .055),

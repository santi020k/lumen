---
/* eslint-disable better-tailwindcss/no-unknown-classes */
import {
  Alert,
  Avatar,
  Badge,
  Button,
  ButtonGroup,
  ButtonLink,
  Calendar,
  Card,
  Checkbox,
  Eyebrow,
  Field,
  Icon,
  Input,
  Label,
  Marker,
  Progress,
  Stat,
  Switch,
  Tabs
} from '@santi020k/lumen-astro'
import { lumenComponentNames } from '@santi020k/lumen-core'

import FrameworkSetupTabs from '../components/FrameworkSetupTabs.astro'
import GitHubIcon from '../components/GitHubIcon.astro'
import HomeWorkbench from '../components/HomeWorkbench.astro'
import { frameworkSetups } from '../data/docs'
import BaseLayout from '../layouts/BaseLayout.astro'

const componentCount = lumenComponentNames.length

const installerIcons = {
  astro: 'asterisk',
  elements: 'blocks',
  react: 'atom'
} as const

const heroInstallers = frameworkSetups.map(setup => ({
  command: setup.installCommands.find(install => install.label === 'pnpm')?.command ?? '',
  icon: installerIcons[setup.id],
  id: setup.id,
  label: setup.label
}))

const principles = [
  {
    description: 'One semantic class contract keeps Astro, React, and custom elements visually aligned.',
    icon: 'layers-3',
    metric: '3 targets',
    title: 'Change frameworks, not your design language.'
  },
  {
    description: 'Keyboard paths, focus management, labels, and meaningful markup are part of the primitive.',
    icon: 'shield-check',
    metric: 'A11y first',
    title: 'The accessible path is the default path.'
  },
  {
    description: 'Interactive Astro primitives use a tiny progressive-enhancement layer, not an app runtime.',
    icon: 'zap',
    metric: '~4 KB',
    title: 'Keep the interaction. Lose the weight.'
  }
] as const

const categories = [
  'Actions',
  'Forms',
  'Navigation',
  'Overlays',
  'Data display',
  'Feedback',
  'Layout',
  'Brand'
] as const
---

<BaseLayout
  description={`Lumen is a crafted multi-framework UI system with ${componentCount} accessible primitives for Astro, React, and Web Components.`}
  title="Lumen UI — Crafted primitives for every framework"
>
  <main class="home">
    <section class="home-hero">
      <div class="home-hero__wash" aria-hidden="true"></div>
      <div class="home-hero__copy">
        <Eyebrow class="home-hero__eyebrow">
          <Marker variant="success">Open source</Marker>
          <span>{componentCount} crafted primitives</span>
        </Eyebrow>
        <h1>
          Build interfaces<br />
          people <em>want</em> to use.
        </h1>
        <p class="home-hero__lede">
          A complete UI foundation for Astro, React, and Web Components.
          Accessible by default, beautifully tokenized, and designed to feel like yours.
        </p>
        <div class="home-hero__actions">
          <ButtonLink class="home-button-lg" href="/docs" showArrow variant="primary">
            Start building
          </ButtonLink>
          <ButtonLink class="home-button-lg" href="/docs/components" variant="secondary">
            Explore components
          </ButtonLink>
        </div>
        <Tabs class="home-installer" glass="subtle">
          <div class="home-installer__heading">
            <span>Install for your stack</span>
            <span>One package. Ready to use.</span>
          </div>
          <div role="tablist" aria-label="Choose a framework to install">
            {heroInstallers.map((installer, index) => (
              <button
                aria-controls={`hero-install-panel-${installer.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                id={`hero-install-tab-${installer.id}`}
                role="tab"
              >
                <Icon name={installer.icon} size="sm" />
                {installer.label}
              </button>
            ))}
          </div>
          {heroInstallers.map((installer, index) => (
            <section
              aria-labelledby={`hero-install-tab-${installer.id}`}
              hidden={index !== 0}
              id={`hero-install-panel-${installer.id}`}
              role="tabpanel"
            >
              <Button
                class="home-install"
                data-copy-command={installer.command}
                variant="ghost"
              >
                <Icon name="terminal" size="sm" />
                <code>{installer.command}</code>
                <span class="home-install__copy" data-copy-feedback>Copy</span>
              </Button>
            </section>
          ))}
        </Tabs>
      </div>

      <div class="home-hero__product">
        <div class="home-hero__product-label" aria-hidden="true">
          <span>Actual primitives</span>
          <i></i>
          <span>Live canvas</span>
        </div>
        <HomeWorkbench />
      </div>
    </section>

    <section class="home-proof" aria-label="Lumen at a glance">
      <div class="home-container home-proof__inner">
        <p>One system. Every surface.</p>
        <div class="home-proof__stats">
          <Stat label="components" value={String(componentCount)} />
          <Stat label="framework targets" value="03" />
          <Stat label="runtime lock-in" value="00" />
        </div>
        <div class="home-proof__categories" aria-label="Component categories">
          {categories.map(category => <Badge variant="outline">{category}</Badge>)}
        </div>
      </div>
    </section>

    <section class="home-section home-container" aria-labelledby="components-title">
      <div class="home-section__head home-section__head--split">
        <div>
          <Eyebrow>Designed as a system</Eyebrow>
          <h2 id="components-title">The pieces already know<br />how to work together.</h2>
        </div>
        <div class="home-section__aside">
          <p>
            Production-ready controls with consistent states, spacing, motion,
            and behavior—composed into real interface patterns.
          </p>
          <ButtonLink href="/docs/components" showArrow variant="inline">
            Browse all {componentCount} components
          </ButtonLink>
        </div>
      </div>

      <div class="home-specimens">
        <Card class="home-specimen home-specimen--actions">
          <div class="home-specimen__label">
            <span>Actions</span>
            <Badge variant="secondary">7 variants</Badge>
          </div>
          <div class="home-specimen__center">
            <ButtonGroup>
              <Button>
                <Icon name="plus" size="sm" />
                Create
              </Button>
              <Button variant="secondary">Duplicate</Button>
              <Button aria-label="More actions" size="icon" variant="outline">
                <Icon name="ellipsis" size="sm" />
              </Button>
            </ButtonGroup>
          </div>
          <p>Buttons, links, groups, toggles, and toolbars share one visual rhythm.</p>
        </Card>

        <Card class="home-specimen home-specimen--form">
          <div class="home-specimen__label">
            <span>Forms</span>
            <Marker variant="success">Valid</Marker>
          </div>
          <div class="home-specimen__form">
            <Field>
              <Label for="home-email">Work email</Label>
              <Input id="home-email" placeholder="you@company.com" type="email" />
            </Field>
            <label>
              <Checkbox checked />
              <span>Send me product updates</span>
            </label>
            <Button>Join the preview</Button>
          </div>
        </Card>

        <Card class="home-specimen home-specimen--calendar">
          <div class="home-specimen__label">
            <span>Date & time</span>
            <Badge variant="outline">Keyboard ready</Badge>
          </div>
          <Calendar
            aria-label="Choose a launch date"
            month="2026-07"
            value="2026-07-23"
          />
        </Card>

        <Card class="home-specimen home-specimen--feedback">
          <div class="home-specimen__label">
            <span>Feedback</span>
            <Badge variant="secondary">Live states</Badge>
          </div>
          <div class="home-specimen__alerts">
            <Alert variant="success">
              <Icon name="circle-check" size="sm" />
              <div>
                <strong>Changes published</strong>
                <p>Your new theme is live everywhere.</p>
              </div>
            </Alert>
            <Alert variant="warning">
              <Icon name="triangle-alert" size="sm" />
              <div>
                <strong>Review contrast</strong>
                <p>Accent text needs a darker surface.</p>
              </div>
            </Alert>
          </div>
        </Card>

        <Card class="home-specimen home-specimen--identity">
          <div class="home-specimen__label">
            <span>People & progress</span>
            <Marker>In review</Marker>
          </div>
          <div class="home-specimen__identity">
            <div class="home-specimen__avatar-stack">
              <Avatar fallback="SA" />
              <Avatar fallback="AK" />
              <Avatar fallback="JM" />
              <Avatar fallback="+6" />
            </div>
            <div>
              <span>Design system rollout</span>
              <strong>82%</strong>
            </div>
            <Progress aria-label="Design system rollout" value={82} />
          </div>
        </Card>

        <Card class="home-specimen home-specimen--tokens">
          <div class="home-specimen__label">
            <span>Semantic tokens</span>
            <Switch aria-label="Enable brand theme" checked />
          </div>
          <div class="home-specimen__swatches" aria-label="Token colors">
            <span style="--swatch: hsl(var(--brand));">brand</span>
            <span style="--swatch: hsl(var(--accent));">accent</span>
            <span style="--swatch: hsl(var(--success));">success</span>
            <span style="--swatch: hsl(var(--warning));">warning</span>
            <span style="--swatch: hsl(var(--danger));">danger</span>
          </div>
          <p>Theme the meaning once. Every primitive follows.</p>
        </Card>
      </div>
    </section>

    <section class="home-principles">
      <div class="home-container">
        <div class="home-section__head">
          <Eyebrow>Quietly rigorous</Eyebrow>
          <h2>Craft you can see.<br />Details you don’t have to chase.</h2>
        </div>
        <div class="home-principles__grid">
          {principles.map((principle, index) => (
            <article class="home-principle">
              <span class="home-principle__number">0{index + 1}</span>
              <Icon name={principle.icon} />
              <Badge variant="outline">{principle.metric}</Badge>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section home-container" aria-labelledby="framework-title">
      <div class="home-section__head home-section__head--split">
        <div>
          <Eyebrow>Bring your framework</Eyebrow>
          <h2 id="framework-title">One design language.<br />Three native implementations.</h2>
        </div>
        <div class="home-section__aside">
          <p>
            Start with the adapter for your stack. The names, tokens, and interaction
            model stay familiar when your project changes.
          </p>
        </div>
      </div>
      <div class="home-framework">
        <FrameworkSetupTabs setups={frameworkSetups} />
      </div>
    </section>

    <section class="home-container">
      <Card as="section" class="home-cta">
        <div class="home-cta__orb" aria-hidden="true"></div>
        <Eyebrow>Build something considered</Eyebrow>
        <h2>Your product deserves<br />better defaults.</h2>
        <p>
          Start with Lumen’s accessible primitives, then make the system unmistakably yours.
        </p>
        <div class="home-cta__actions">
          <ButtonLink class="home-button-lg" href="/docs" showArrow variant="primary">
            Read the docs
          </ButtonLink>
          <ButtonLink
            class="home-button-lg"
            href="https://github.com/santi020k/lumen"
            newTab
            variant="secondary"
          >
            <GitHubIcon />
            View on GitHub
          </ButtonLink>
        </div>
      </Card>
    </section>
  </main>
</BaseLayout>

<script>
  const initHomeCopy = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-command]')) {
      if (button.dataset.copyInit === 'true') continue

      button.dataset.copyInit = 'true'

      button.addEventListener('click', async () => {
        const command = button.dataset.copyCommand

        if (!command) return

        try {
          await navigator.clipboard.writeText(command)

          const feedback = button.querySelector('[data-copy-feedback]')

          if (!feedback) return

          feedback.textContent = 'Copied'

          setTimeout(() => {
            feedback.textContent = 'Copy'
          }, 1800)
        } catch {
          // Clipboard access can be unavailable in non-secure preview contexts.
        }
      })
    }
  }

  initHomeCopy()

  document.addEventListener('astro:page-load', initHomeCopy)
</script>

<style>
  .home {
    overflow: hidden;
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .home-container {
    width: min(100% - 2.5rem, 74rem);
    margin-inline: auto;
  }

  .home-hero {
    position: relative;
    padding: clamp(5rem, 10vw, 8.5rem) 0 0;
  }

  .home-hero__wash {
    position: absolute;
    top: -12rem;
    left: 50%;
    z-index: -1;
    width: min(100rem, 130vw);
    height: 52rem;
    transform: translateX(-50%);
    background:
      radial-gradient(circle at 30% 35%, hsl(var(--brand) / .17), transparent 31%),
      radial-gradient(circle at 70% 30%, hsl(var(--accent) / .12), transparent 28%);
    filter: blur(18px);
    pointer-events: none;
  }

  .home-hero__copy {
    display: flex;
    width: min(100% - 2.5rem, 61rem);
    margin-inline: auto;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    margin-bottom: 1.5rem;
  }

  .home-hero h1 {
    max-width: 13ch;
    margin: 0;
    color: hsl(var(--ink));
    font-family: var(--app-font-display), "Montserrat", sans-serif;
    font-size: clamp(3.25rem, 7.4vw, 6.65rem);
    font-weight: 800;
    letter-spacing: -.065em;
    line-height: .91;
  }

  .home-hero h1 em {
    position: relative;
    display: inline-block;
    background: linear-gradient(110deg, hsl(var(--brand)), hsl(var(--accent)));
    background-clip: text;
    color: transparent;
    font-style: normal;
  }

  .home-hero h1 em::after {
    position: absolute;
    right: -.04em;
    bottom: -.08em;
    left: -.04em;
    height: .08em;
    border-radius: 999px;
    background: linear-gradient(90deg, hsl(var(--brand)), hsl(var(--accent)));
    content: "";
    transform: rotate(-1.5deg);
  }

  .home-hero__lede {
    max-width: 42rem;
    margin: 1.8rem 0 0;
    color: hsl(var(--ink-soft));
    font-size: clamp(1rem, 1.7vw, 1.22rem);
    line-height: 1.7;
  }

  .home-hero__actions,
  .home-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .75rem;
    margin-top: 1.8rem;
  }

  .home-button-lg {
    min-height: 3.25rem;
    padding-inline: 1.55rem;
  }

  .home-installer {
    width: min(100%, 35rem);
    margin-top: 1.15rem;
    gap: .65rem;
    border: 1px solid hsl(var(--line) / .8);
    border-radius: calc(var(--ui-radius) + .45rem);
    background: hsl(var(--surface) / .7);
    box-shadow:
      0 18px 50px hsl(var(--ink) / .07),
      inset 0 1px 0 hsl(var(--canvas) / .8);
    padding: .55rem;
    backdrop-filter: blur(18px);
  }

  .home-installer__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .25rem .45rem 0;
    color: hsl(var(--ink));
    font-size: .72rem;
    font-weight: 750;
  }

  .home-installer__heading span:last-child {
    color: hsl(var(--ink-muted));
    font-size: .66rem;
    font-weight: 550;
  }

  .home-installer [role="tablist"] {
    width: 100%;
    justify-content: stretch;
    border: 0;
    border-radius: calc(var(--ui-radius) - .05rem);
    background: hsl(var(--surface-muted) / .82);
  }

  .home-installer [role="tab"] {
    display: inline-flex;
    min-width: 0;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: .4rem;
  }

  .home-installer [role="tabpanel"] {
    min-width: 0;
  }

  .home-install {
    width: 100%;
    min-width: 0;
    justify-content: flex-start;
    gap: .65rem;
    border: 1px solid hsl(var(--line) / .85);
    border-radius: calc(var(--ui-radius) - .05rem);
    background: hsl(var(--canvas) / .62);
    padding-inline: .9rem;
  }

  .home-install code {
    min-width: 0;
    overflow: hidden;
    flex: 1;
    color: hsl(var(--ink-soft));
    font-size: .78rem;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-install__copy {
    color: hsl(var(--brand));
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .home-hero__product {
    position: relative;
    width: min(100% - 2.5rem, 82rem);
    margin: clamp(3.5rem, 7vw, 6rem) auto 0;
  }

  .home-hero__product::before {
    position: absolute;
    inset: -2rem 5% 30%;
    z-index: -1;
    border-radius: 50%;
    background: hsl(var(--brand) / .14);
    content: "";
    filter: blur(55px);
  }

  .home-hero__product-label {
    display: flex;
    align-items: center;
    gap: .65rem;
    margin: 0 0 .8rem .5rem;
    color: hsl(var(--ink-muted));
    font-size: .66rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .home-hero__product-label i {
    width: 2.5rem;
    height: 1px;
    background: hsl(var(--line));
  }

  .home-proof {
    border-top: 1px solid hsl(var(--line) / .7);
    border-bottom: 1px solid hsl(var(--line) / .7);
    background: hsl(var(--surface-muted) / .35);
    margin-top: 5rem;
    padding: 2rem 0;
  }

  .home-proof__inner {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 2.25rem;
  }

  .home-proof__inner > p {
    margin: 0;
    color: hsl(var(--ink));
    font-family: var(--app-font-display), sans-serif;
    font-weight: 800;
  }

  .home-proof__stats {
    display: flex;
    gap: 1.5rem;
    border-right: 1px solid hsl(var(--line));
    border-left: 1px solid hsl(var(--line));
    padding-inline: 2rem;
  }

  .home-proof__stats :global(.ui-stat-value) {
    color: hsl(var(--ink));
    font-family: var(--app-font-display), sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
  }

  .home-proof__stats :global(.ui-stat-label) {
    color: hsl(var(--ink-muted));
    font-size: .62rem;
  }

  .home-proof__categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .4rem;
  }

  .home-section {
    padding-top: clamp(6rem, 11vw, 10rem);
  }

  .home-section__head {
    display: grid;
    gap: .75rem;
  }

  .home-section__head--split {
    grid-template-columns: minmax(0, 1.35fr) minmax(17rem, .65fr);
    align-items: end;
    gap: 3rem;
  }

  .home-section__head h2,
  .home-cta h2 {
    margin: 0;
    color: hsl(var(--ink));
    font-family: var(--app-font-display), "Montserrat", sans-serif;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -.045em;
    line-height: 1.02;
  }

  .home-section__aside {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .home-section__aside p {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: .95rem;
    line-height: 1.7;
  }

  .home-specimens {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: .9rem;
    margin-top: 3rem;
  }

  .home-specimen {
    display: flex;
    min-height: 18rem;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
    border-color: hsl(var(--line) / .86);
    box-shadow: none;
    padding: 1.15rem;
  }

  .home-specimen--actions { grid-column: span 7; }
  .home-specimen--form { grid-column: span 5; }
  .home-specimen--calendar { grid-column: span 5; }
  .home-specimen--feedback { grid-column: span 7; }
  .home-specimen--identity { grid-column: span 7; }
  .home-specimen--tokens { grid-column: span 5; }

  .home-specimen__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: hsl(var(--ink));
    font-size: .74rem;
    font-weight: 800;
  }

  .home-specimen__center {
    display: grid;
    min-height: 10rem;
    place-items: center;
    border-radius: .9rem;
    background:
      linear-gradient(hsl(var(--line) / .35) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--line) / .35) 1px, transparent 1px),
      hsl(var(--surface-muted) / .45);
    background-size: 24px 24px;
  }

  .home-specimen > p {
    margin: auto 0 0;
    color: hsl(var(--ink-muted));
    font-size: .78rem;
    line-height: 1.6;
  }

  .home-specimen__form {
    display: grid;
    gap: .8rem;
    margin: auto 0;
    border: 1px solid hsl(var(--line) / .75);
    border-radius: 1rem;
    background: hsl(var(--surface-muted) / .45);
    padding: 1rem;
  }

  .home-specimen__form > label {
    display: flex;
    align-items: center;
    gap: .55rem;
    color: hsl(var(--ink-soft));
    font-size: .72rem;
  }

  .home-specimen__form :global(.ui-input) {
    width: 100%;
  }

  .home-specimen--calendar :global(.ui-calendar) {
    margin: auto;
    border: 0;
    box-shadow: none;
    transform: scale(.9);
  }

  .home-specimen__alerts {
    display: grid;
    gap: .75rem;
    margin: auto 0;
  }

  .home-specimen__alerts :global(.ui-alert) {
    display: flex;
    align-items: flex-start;
    gap: .75rem;
  }

  .home-specimen__alerts strong {
    font-size: .82rem;
  }

  .home-specimen__alerts p {
    margin: .2rem 0 0;
    font-size: .72rem;
  }

  .home-specimen__identity {
    display: grid;
    gap: 1rem;
    margin: auto 0;
    border-radius: 1rem;
    background: hsl(var(--surface-muted) / .5);
    padding: 1.2rem;
  }

  .home-specimen__avatar-stack {
    display: flex;
    padding-left: .65rem;
  }

  .home-specimen__avatar-stack :global(.ui-avatar) {
    width: 2.5rem;
    height: 2.5rem;
    margin-left: -.65rem;
    border: 3px solid hsl(var(--surface));
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
    font-size: .68rem;
  }


---
import {
  Badge,
  Button,
  Card,
  Field,
  Icon,
  Input,
  Label,
  Marker,
  Progress,
  Separator,
  Switch,
  Toggle,
  ToggleGroup
} from '@santi020k/lumen-astro'
import { lumenComponentNames } from '@santi020k/lumen-core'

import FrameworkSetupTabs from '../components/FrameworkSetupTabs.astro'
import { componentCategories, componentDocs, frameworkSetups } from '../data/docs'
import BaseLayout from '../layouts/BaseLayout.astro'
import { toSlug } from '../lib/routes'

const componentCount = lumenComponentNames.length
const installCommand = 'pnpm add @santi020k/lumen-astro'

const highlights = [
  {
    description: 'Real buttons, dialogs, tables, and forms. Accessibility comes from the markup, not a wrapper div.',
    icon: 'shield-check',
    metric: 'A11y',
    tone: 'brand',
    title: 'Semantic first'
  },
  {
    description: 'Every target shares the same ui-* stylesheet driven by design tokens, so screens look identical across frameworks.',
    icon: 'layers-3',
    metric: '1 CSS',
    tone: 'accent',
    title: 'One class contract'
  },
  {
    description: 'A single progressive-enhancement script powers dialogs, menus, tabs, and toasts in about 4 KB.',
    icon: 'zap',
    metric: '~4 KB',
    tone: 'warning',
    title: 'No framework runtime'
  }
] as const

const featured = componentDocs.slice(0, 12)
---

<BaseLayout
  description={`Lumen is a multi-framework primitive UI system with ${componentCount} components for Astro, React, and Web Components, documented with live examples.`}
  title="Lumen UI - Primitives for Astro, React, and Web Components"
>
  <main class="
    docs-home-shell mx-auto flex w-full max-w-7xl flex-col gap-16 px-5 pt-8
    pb-12
    sm:px-8
  ">
    <section class="
      docs-home-hero grid gap-10
      lg:grid-cols-[1.05fr_0.95fr] lg:items-center
    ">
      <div class="space-y-6">
        <div class="docs-home-eyebrow flex flex-wrap gap-2">
          <Badge>{componentCount} components</Badge>
          <Badge variant="secondary">Astro</Badge>
          <Badge variant="secondary">React</Badge>
          <Badge variant="secondary">Web Components</Badge>
        </div>
        <h1 class="
          max-w-3xl text-5xl/tight font-black text-ink
          sm:text-6xl/tight
        ">Write it once. Ship it in any framework.</h1>
        <p class="max-w-2xl text-lg/8 text-ink-soft">
          Lumen is a primitive UI system built on semantic markup and shared design tokens.
          The same component, the same classes, the same behavior, in Astro, React, and
          standards-based custom elements.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="ui-button ui-button--lg ui-button--default no-underline" href="/docs">
            Get started
            <Icon name="arrow-right" size="sm" />
          </a>
          <a class="ui-button ui-button--lg ui-button--secondary no-underline" href="/docs/components">
            <Icon name="blocks" size="sm" />
            Browse components
          </a>
        </div>
        <button
          class="
            docs-home-install-command inline-flex cursor-pointer items-center
            gap-2.5 rounded-md border border-line px-3 py-2 font-mono text-sm
            text-ink-muted transition-colors
            hover:border-ink-muted hover:text-ink
          "
          data-copy-command={installCommand}
          type="button"
        >
          <Icon name="terminal" size="sm" />
          <span aria-hidden="true">{installCommand}</span>
          <span class="docs-home-install-command__action text-xs font-bold" data-copy-feedback>Copy</span>
          <span class="sr-only">Copy install command: {installCommand}</span>
        </button>
      </div>

      <Card glass="strong" class="
        docs-home-showcase grid gap-5 p-6
        sm:p-7
      ">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-sm font-bold text-ink">Everything below is Lumen</p>
            <p class="text-sm text-ink-soft">This site is built with its own primitives.</p>
          </div>
          <Marker variant="success">Live</Marker>
        </div>
        <ToggleGroup aria-label="Billing interval">
          <Toggle>Monthly</Toggle>
          <Toggle pressed>Yearly</Toggle>
        </ToggleGroup>
        <Field glass="subtle" class="p-4">
          <Label for="hero-email">Work email</Label>
          <Input id="hero-email" type="email" placeholder="you@example.com" />
        </Field>
        <label class="flex items-center gap-2 text-sm text-ink-soft">
          <Switch name="hero-updates" checked /> Send me release notes
        </label>
        <Progress value={72} aria-label="Onboarding progress" />
        <div class="flex flex-wrap gap-3">
          <Button>Create workspace</Button>
          <Button variant="ghost">Skip for now</Button>
        </div>
      </Card>
    </section>

    <section class="
      docs-home-highlights grid gap-4
      md:grid-cols-3
    " aria-label="Why Lumen">
      {highlights.map(highlight => (
        <Card
          as="article"
          class="docs-home-highlight h-full p-6"
          data-tone={highlight.tone}
          variant="interactive"
        >
          <div class="docs-home-highlight__top">
            <span class="docs-home-highlight__icon">
              <Icon name={highlight.icon} />
            </span>
            <span class="docs-home-highlight__metric">{highlight.metric}</span>
          </div>
          <h2 class="text-base font-bold text-ink">{highlight.title}</h2>
          <p class="text-sm/6 text-ink-soft">{highlight.description}</p>
        </Card>
      ))}
    </section>

    <section class="docs-home-section space-y-6" aria-labelledby="usage-title">
      <div class="space-y-2">
        <p class="text-sm font-semibold tracking-[0.22em] text-brand uppercase">Proof, not promises</p>
        <h2 class="text-3xl font-bold text-ink" id="usage-title">
          The same component in every framework
        </h2>
        <p class="max-w-2xl text-sm/7 text-ink-soft">
          Install the adapter for your stack and write the same markup. Same classes,
          same tokens, same behavior.
        </p>
      </div>
      <FrameworkSetupTabs setups={frameworkSetups} />
    </section>

    <section class="docs-home-section space-y-6" aria-labelledby="catalog-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="space-y-2">
          <p class="
            text-sm font-semibold tracking-[0.22em] text-brand uppercase
          ">Component reference</p>
          <h2 class="text-3xl font-bold text-ink" id="catalog-title">
            Live previews, code in three flavors
          </h2>
          <p class="max-w-2xl text-sm/7 text-ink-soft">
            Every component page renders the real thing and shows matching Astro, React, and
            custom-element usage side by side. {componentCategories.join(', ')}.
          </p>
        </div>
        <a class="
          ui-button ui-button--default-size ui-button--outline no-underline
        " href="/docs/components">
          See all {componentCount}
          <Icon name="arrow-up-right" size="sm" />
        </a>
      </div>
      <div class="
        docs-home-catalog-grid grid gap-4
        md:grid-cols-2
        xl:grid-cols-4
      ">
        {featured.map(component => (
          <a class="no-underline" href={`/docs/components/${toSlug(component.name)}`}>
            <Card class="docs-home-component-card h-full space-y-2 p-5" variant="interactive">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-sm font-bold text-ink">{component.name}</h3>
                {component.glass && <Badge variant="outline">Glass</Badge>}
              </div>
              <p class="text-sm/6 text-ink-soft">{component.summary}</p>
              <span class="docs-home-component-card__arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size="sm" />
              </span>
            </Card>
          </a>
        ))}
      </div>
    </section>

    <Separator />

    <section class="docs-home-cta grid gap-6 text-center" aria-label="Get started">
      <h2 class="text-3xl font-bold text-ink">Start with the framework you already use.</h2>
      <div class="flex flex-wrap justify-center gap-3">
        <a class="ui-button ui-button--lg ui-button--default no-underline" href="/docs">
          <Icon name="book-open" size="sm" />
          Read the docs
        </a>
        <a class="ui-button ui-button--lg ui-button--outline no-underline" href="https://github.com/santi020k/lumen">
          <Icon name="github" size="sm" />
          Star on GitHub
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.addEventListener('click', event => {
    const button = event.target instanceof Element
      ? event.target.closest<HTMLButtonElement>('[data-copy-command]')
      : null

    const command = button?.dataset.copyCommand

    if (!button || command === undefined) return

    navigator.clipboard.writeText(command).then(() => {
      const feedback = button.querySelector('[data-copy-feedback]')

      if (!feedback) return null

      feedback.textContent = 'Copied!'

      setTimeout(() => {
        feedback.textContent = 'Copy'
      }, 2000)

      return null
    }).catch(() => null)
  })
</script>

---

/* cspell:ignore aaronmgz Aarón commitprompt coolstead */

import {
  Alert,
  AnimatedNumber,
  Badge,
  Button,
  ButtonGroup,
  ButtonLink,
  Card,
  Checkbox,
  Code,
  CodeTabs,
  Eyebrow,
  Field,
  Icon,
  Image,
  Input,
  Label,
  Marker,
  RevealGroup,
  ScrollReveal,
  Stack,
  Stat } from '@santi020k/lumen-astro'

import HomePlatformShowcase from '../components/HomePlatformShowcase.astro'
import HomeWorkbench from '../components/HomeWorkbench.astro'
import { frameworkSetups } from '../data/docs'
import { showcaseProjects } from '../data/showcase'
import { documentedComponentCount, primaryPageMetadata } from '../data/site-metadata'
import BaseLayout from '../layouts/BaseLayout.astro'

const componentCount = documentedComponentCount
const aiSkillInstallCommand = 'npx skills add santi020k/lumen --skill lumen-ui'

const heroInstallers = frameworkSetups.map(setup => ({
  code: setup.installCommands.find(install => install.label === 'pnpm')?.command ?? '',
  label: setup.label,
  language: 'shell',
  value: setup.id
}))

const principles = [
  {
    description: 'One semantic token and component contract keeps web and native products recognizably aligned.',
    icon: 'layers-3',
    metric: '4 platforms',
    title: 'Change platforms, not your design language.'
  },
  {
    description: 'Keyboard paths, focus management, labels, and meaningful markup are part of the primitive.',
    icon: 'shield-check',
    metric: 'A11y first',
    title: 'The accessible path is the default path.'
  },
  {
    description: 'Interactive Astro primitives use a tiny progressive-enhancement layer, not an app runtime.',
    icon: 'zap',
    metric: '~4 KB',
    title: 'Keep the interaction. Lose the weight.'
  }
] as const

const categories = [
  'Actions',
  'Forms',
  'Navigation',
  'Overlays',
  'Data display',
  'Feedback',
  'Layout',
  'Brand'
] as const

interface UseCase {
  category: string
  description: string
  featured?: boolean
  href: string
  desktop: {
    height: number
    src: string
    width: number
  }
  mobile: {
    height: number
    src: string
    width: number
  }
  name: string
  stack: string
}

const featuredProjects = ['Astro Doctor', 'PostLens', 'Coolstead']

const useCases: readonly UseCase[] = featuredProjects.flatMap(name => {
  const project = showcaseProjects.find(item => item.name === name)

  return project ?
[{
    ...project,
    desktop: { height: 1000, src: project.image, width: 1440 },
    featured: name === 'Astro Doctor',
    mobile: { height: 844, src: project.mobileImage, width: 390 }
  }] :
[]
})

---

<BaseLayout
  description={primaryPageMetadata.home.description}
  title={primaryPageMetadata.home.title}
>
  <main class="home">
    <section class="home-hero">
      <div class="home-hero__wash" aria-hidden="true"></div>
      <RevealGroup class="home-hero__copy" stagger={70}>
        <Eyebrow class="home-hero__eyebrow">
          <Marker variant="success">Open source</Marker>
          <span>{componentCount} primitives</span>
        </Eyebrow>
        <h1>
          Build interfaces<br />
          people <em>want</em> to use.
        </h1>
        <p class="home-hero__lede">
          A cross-platform UI system for Web, React Native, Apple platforms, and Android.
          Accessible by default, beautifully tokenized, and native to every environment.
        </p>
        <div class="home-hero__actions">
          <ButtonLink class="home-button-lg" href="/docs" showArrow variant="primary">
            Start building
          </ButtonLink>
          <ButtonLink class="home-button-lg" href="/docs/components" variant="secondary">
            Explore components
          </ButtonLink>
        </div>
        <CodeTabs
          ariaLabel="Choose a web framework to install"
          class="home-installer"
          codeLabel="Web install command"
          copiedLabel="Install command copied"
          copyLabel="Copy install command"
          items={heroInstallers}
        />
      </RevealGroup>

      <ScrollReveal animation="scale" class="home-hero__product" delay={140}>
        <div class="home-hero__product-label" aria-hidden="true">
          <span>Actual primitives</span>
          <i></i>
          <span>Live canvas</span>
        </div>
        <HomeWorkbench />
      </ScrollReveal>
    </section>

    <section class="home-proof" aria-label="Lumen at a glance">
      <div class="home-container home-proof__inner">
        <p>One system. Every surface.</p>
        <div class="home-proof__stats">
          <Stat label="components" variant="bare">
            <span class="ui-stat-value"><AnimatedNumber value={componentCount} /></span>
          </Stat>
          <Stat label="product platforms" variant="bare">
            <span class="ui-stat-value"><AnimatedNumber value={4} /></span>
          </Stat>
          <Stat label="runtime lock-in" variant="bare">
            <span class="ui-stat-value"><AnimatedNumber value={0} /></span>
          </Stat>
        </div>
        <div class="home-proof__categories" aria-label="Component categories">
          {categories.map(category => <Badge variant="outline">{category}</Badge>)}
        </div>
      </div>
    </section>

    <section class="home-section home-container home-platforms" aria-labelledby="platforms-title">
      <ScrollReveal animation="slide-up">
        <div class="home-section__head home-section__head--split">
          <div>
            <Eyebrow>Built for every surface</Eyebrow>
            <h2 id="platforms-title">One design language.<br />Web and three native platforms.</h2>
          </div>
          <div class="home-section__aside">
            <p>
              Share semantic color, type, spacing, motion, and component intent—then let each
              platform render and behave the way its users expect.
            </p>
            <Marker variant="success">Shared foundations. Platform-native behavior.</Marker>
            <ButtonLink href="/docs/foundations" showArrow variant="inline">
              Explore shared foundations
            </ButtonLink>
          </div>
        </div>
      </ScrollReveal>

      <HomePlatformShowcase />
    </section>

    <section class="home-section home-container" aria-labelledby="components-title">
      <ScrollReveal animation="slide-up">
        <div class="home-section__head home-section__head--split">
          <div>
            <Eyebrow>Designed as a system</Eyebrow>
            <h2 id="components-title">The pieces already know<br />how to work together.</h2>
          </div>
          <div class="home-section__aside">
            <p>
              Production-ready controls with consistent states, spacing, motion,
              and behavior—composed into real interface patterns.
            </p>
            <ButtonLink href="/docs/components" showArrow variant="inline">
              Browse all {componentCount} components
            </ButtonLink>
          </div>
        </div>
      </ScrollReveal>

      <RevealGroup class="home-specimens" stagger={60}>
        <Card class="home-specimen home-specimen--actions">
          <div class="home-specimen__label">
            <span>Actions</span>
            <Badge variant="secondary">7 variants</Badge>
          </div>
          <div class="home-specimen__center">
            <ButtonGroup>
              <Button>
                <Icon name="plus" size="sm" />
                Create
              </Button>
              <Button variant="secondary">Duplicate</Button>
              <Button aria-label="More actions" size="icon" variant="outline">
                <Icon name="ellipsis" size="sm" />
              </Button>
            </ButtonGroup>
          </div>
          <p>Buttons, links, groups, toggles, and toolbars share one visual rhythm.</p>
        </Card>

        <Card class="home-specimen home-specimen--form">
          <div class="home-specimen__label">
            <span>Forms</span>
            <Marker variant="success">Valid</Marker>
          </div>
          <Stack class="home-specimen__form" gap="md">
            <Field>
              <Label for="home-email">Work email</Label>
              <Input id="home-email" placeholder="you@company.com" type="email" />
            </Field>
            <Label class="home-specimen__preference">
              <Checkbox checked />
              <span>Send me product updates</span>
            </Label>
            <Button>Join the preview</Button>
          </Stack>
        </Card>

        <Card class="home-specimen home-specimen--feedback">
          <div class="home-specimen__label">
            <span>Feedback</span>
            <Badge variant="secondary">Live states</Badge>
          </div>
          <div class="home-specimen__alerts">
            <Alert variant="success">
              <Icon name="circle-check" size="sm" />
              <div>
                <strong>Changes published</strong>
                <p>Your new theme is live everywhere.</p>
              </div>
            </Alert>
            <Alert variant="warning">
              <Icon name="triangle-alert" size="sm" />
              <div>
                <strong>Review contrast</strong>
                <p>Accent text needs a darker surface.</p>
              </div>
            </Alert>
          </div>
        </Card>

        <Card class="home-specimen home-specimen--tokens">
          <div class="home-specimen__label">
            <span>Semantic tokens</span>
            <Badge variant="secondary">Shared roles</Badge>
          </div>
          <div class="home-specimen__swatches" aria-label="Token colors">
            <span style="--swatch: hsl(var(--brand));">brand</span>
            <span style="--swatch: hsl(var(--accent));">accent</span>
            <span style="--swatch: hsl(var(--success));">success</span>
            <span style="--swatch: hsl(var(--warning));">warning</span>
            <span style="--swatch: hsl(var(--danger));">danger</span>
          </div>
          <p>Theme the meaning once. Every primitive follows.</p>
        </Card>
      </RevealGroup>
    </section>

    <section class="home-section home-container home-use-cases" aria-labelledby="use-cases-title">
      <ScrollReveal animation="slide-up">
        <div class="home-section__head home-section__head--split">
          <div>
            <Eyebrow>Lumen in production</Eyebrow>
            <h2 id="use-cases-title">One system.<br />Very different products.</h2>
          </div>
          <div class="home-section__aside">
            <p>
              One shared foundation, three unmistakable identities. Explore real Lumen products
              across desktop and mobile—not component demos, but finished experiences.
            </p>
          </div>
        </div>
      </ScrollReveal>

      <RevealGroup class="home-use-cases__grid" stagger={45}>
        {useCases.map(useCase => (
          <Card
            as="article"
            class:list={[
              'home-use-case',
              { 'home-use-case--featured': useCase.featured }
            ]}
          >
            <div class="home-use-case__stage">
              <div class="home-use-case__browser">
                <div class="home-use-case__browser-bar" aria-hidden="true">
                  <span><i></i><i></i><i></i></span>
                  <code>{new URL(useCase.href).hostname.replace('www.', '')}</code>
                </div>
                <Image
                  alt={`${useCase.name} website on desktop`}
                  height={useCase.desktop.height}
                  src={useCase.desktop.src}
                  width={useCase.desktop.width}
                />
              </div>
              <div class="home-use-case__phone">
                <span aria-hidden="true"></span>
                <Image
                  alt={`${useCase.name} website on mobile`}
                  height={useCase.mobile.height}
                  src={useCase.mobile.src}
                  width={useCase.mobile.width}
                />
              </div>
              <Badge class="home-use-case__viewport-badge" variant="secondary">
                <Icon decorative name="panels-top-left" size="sm" />
                Desktop + mobile
              </Badge>
            </div>
            <div class="home-use-case__body">
              <div class="home-use-case__meta">
                <Badge variant="outline">{useCase.category}</Badge>
                <span>{useCase.stack}</span>
              </div>
              <h3>{useCase.name}</h3>
              <p>{useCase.description}</p>
              <ButtonLink
                ariaLabel={`Open ${useCase.name} in a new tab`}
                href={useCase.href}
                newTab
                showArrow
                variant="inline"
              >
                Experience the project
              </ButtonLink>
            </div>
          </Card>
        ))}
      </RevealGroup>
    </section>

    <section class="home-principles">
      <div class="home-container">
        <ScrollReveal animation="slide-up">
          <div class="home-section__head">
            <Eyebrow>Quietly rigorous</Eyebrow>
            <h2>Craft you can see.<br />Details you don’t have to chase.</h2>
          </div>
        </ScrollReveal>
        <RevealGroup class="home-principles__grid" stagger={90}>
          {principles.map((principle, index) => (
            <article class="home-principle">
              <span class="home-principle__number">0{index + 1}</span>
              <Icon name={principle.icon} />
              <Badge variant="outline">{principle.metric}</Badge>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))}
        </RevealGroup>
      </div>
    </section>

    <section class="home-section home-container home-ai" id="ai-native" aria-labelledby="ai-title">
      <ScrollReveal animation="slide-up">
        <div class="home-section__head home-ai__copy">
          <Eyebrow>AI-native UI</Eyebrow>
          <h2 id="ai-title">Give your coding agent the Lumen design system.</h2>
          <p>
            Install one portable skill for Codex, Claude Code, Cursor, Windsurf, and other Agent
            Skills clients. It teaches your AI to choose real Lumen primitives, respect the current
            framework, use semantic tokens, and verify accessible interactions.
          </p>
          <div class="home-ai__actions">
            <ButtonLink href="/docs/ai-skill" showArrow variant="primary">
              Explore the AI skill
            </ButtonLink>
            <ButtonLink href="/docs/mcp" variant="inline">
              Add live MCP context
            </ButtonLink>
          </div>
        </div>
      </ScrollReveal>
      <ScrollReveal animation="scale" delay={100}>
        <Card class="home-ai__terminal">
          <Code
            code={aiSkillInstallCommand}
            copy
            copiedLabel="AI skill install command copied"
            copyLabel="Copy AI skill install command"
            label="Agent Skills"
            language="shell"
            variant="block"
            wrap
          />
          <div class="home-ai__agent-flow">
            <span><Icon decorative name="scan-search" size="sm" /> Detect framework</span>
            <span><Icon decorative name="blocks" size="sm" /> Select primitives</span>
            <span><Icon decorative name="palette" size="sm" /> Apply tokens</span>
            <span><Icon decorative name="shield-check" size="sm" /> Verify behavior</span>
          </div>

        </Card>
      </ScrollReveal>
    </section>

  </main>
</BaseLayout>

<style>
  .home {
    --home-section-space: clamp(4rem, 7vw, 7rem);
    --home-content-gap: clamp(1.5rem, 3vw, 2.5rem);
    overflow: clip;
    padding-bottom: var(--home-section-space);
  }

  .home-container {
    width: min(100% - 2.5rem, 74rem);
    margin-inline: auto;
  }

  .home-hero {
    position: relative;
    padding: var(--home-section-space) 0 0;
  }

  .home-hero__wash {
    position: absolute;
    top: -12rem;
    left: 50%;
    z-index: -1;
    width: min(100rem, 130vw);
    height: 52rem;
    transform: translateX(-50%);
    background:
      radial-gradient(circle at 30% 35%, hsl(var(--brand) / .17), transparent 31%),
      radial-gradient(circle at 70% 30%, hsl(var(--accent) / .12), transparent 28%);
    filter: blur(18px);
    pointer-events: none;
  }

  .home-hero__copy {
    display: flex;
    width: min(100% - 2.5rem, 61rem);
    margin-inline: auto;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    margin-bottom: 1.5rem;
  }

  .home-hero h1 {
    max-width: 20ch;
    margin: 0;
    color: hsl(var(--ink));
    font-family: var(--app-font-display), "Montserrat", sans-serif;
    font-size: clamp(3rem, 6vw, 5.25rem);
    font-weight: 700;
    letter-spacing: -.045em;
    line-height: 1.06;
  }

  .home-hero h1 em {
    position: relative;
    display: inline-block;
    background: linear-gradient(110deg, hsl(var(--brand)), hsl(var(--accent)));
    background-clip: text;
    color: transparent;
    font-style: normal;
  }

  .home-hero h1 em::after {
    position: absolute;
    right: -.04em;
    bottom: -.08em;
    left: -.04em;
    height: .08em;
    border-radius: 999px;
    background: linear-gradient(90deg, hsl(var(--brand)), hsl(var(--accent)));
    content: "";
    transform: rotate(-1.5deg);
  }

  .home-hero__lede {
    max-width: 42rem;
    margin: 1.8rem 0 0;
    color: hsl(var(--ink-soft));
    font-size: clamp(1rem, 1.7vw, 1.22rem);
    line-height: 1.7;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .75rem;
    margin-top: 1.8rem;
  }

  .home-button-lg {
    min-height: 3.25rem;
    padding-inline: 1.55rem;
  }

  .home-installer {
    width: min(100%, 34rem);
    margin-top: 1.5rem;
    text-align: left;
  }

  .home-hero__product {
    position: relative;
    width: min(100% - 2.5rem, 74rem);
    margin: var(--home-section-space) auto 0;
  }

  .home-hero__product::before {
    position: absolute;
    inset: -2rem 5% 30%;
    z-index: -1;
    border-radius: 50%;
    background: hsl(var(--brand) / .14);
    content: "";
    filter: blur(55px);
  }

  .home-hero__product-label {
    display: flex;
    align-items: center;
    gap: .65rem;
    margin: 0 0 .8rem .5rem;
    color: hsl(var(--ink-muted));
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .home-hero__product-label i {
    width: 2.5rem;
    height: 1px;
    background: hsl(var(--line));
  }

  .home-proof {
    border-top: 1px solid hsl(var(--line) / .7);
    border-bottom: 1px solid hsl(var(--line) / .7);
    background: hsl(var(--surface-muted) / .35);
    margin-top: var(--home-section-space);
    padding: 2rem 0;
  }

  .home-proof__inner {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 2.25rem;
  }

  .home-proof__inner > p {
    margin: 0;
    color: hsl(var(--ink));
    font-family: var(--app-font-display), sans-serif;
    font-weight: 700;
  }

  .home-proof__stats {
    display: flex;
    gap: 1.5rem;
    border-right: 1px solid hsl(var(--line));
    border-left: 1px solid hsl(var(--line));
    padding-inline: 2rem;
  }

  .home-proof__stats :global(.ui-stat-value) {
    color: hsl(var(--ink));
    font-family: var(--app-font-display), sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
  }

  .home-proof__stats :global(.ui-stat-label) {
    color: hsl(var(--ink-muted));
    font-size: .75rem;
  }

  .home-proof__categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .4rem;
  }

  .home-section {
    padding-top: var(--home-section-space);
  }

  .home-section__head {
    display: grid;
    gap: .75rem;
  }

  .home-section__head--split {
    grid-template-columns: minmax(0, 1.35fr) minmax(17rem, .65fr);
    align-items: end;
    gap: 3rem;
  }

  .home-section__head h2 {
    margin: 0;
    color: hsl(var(--ink));
    font-family: var(--app-font-display), "Montserrat", sans-serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    text-wrap: balance;
    letter-spacing: -.03em;
    line-height: 1.15;
  }

  .home-section__aside {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .home-section__aside p {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: .95rem;
    line-height: 1.7;
  }

  .home-specimens {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
    margin-top: var(--home-content-gap);
  }

  .home-specimen {
    display: flex;
    min-height: 18rem;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
    border-color: hsl(var(--line) / .86);
    box-shadow: none;
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .home-specimen--actions { grid-column: span 7; }
  .home-specimen--form { grid-column: span 5; }
  .home-specimen--feedback { grid-column: span 7; }
  .home-specimen--tokens { grid-column: span 5; }

  .home-specimen__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: hsl(var(--ink));
    font-size: .875rem;
    font-weight: 700;
  }

  .home-specimen__center {
    display: grid;
    min-height: 10rem;
    place-items: center;
    border-radius: var(--ui-radius);
    background:
      linear-gradient(hsl(var(--line) / .35) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--line) / .35) 1px, transparent 1px),
      hsl(var(--surface-muted) / .45);
    background-size: 24px 24px;
  }

  .home-specimen > p {
    margin: auto 0 0;
    color: hsl(var(--ink-muted));
    font-size: .875rem;
    line-height: 1.6;
  }

  .home-specimen__form {
    margin: auto 0;
    border: 1px solid hsl(var(--line) / .75);
    border-radius: var(--ui-radius);
    background: hsl(var(--surface-muted) / .45);
    padding: 1rem;
  }

  .home-specimen__preference {
    display: flex;
    align-items: center;
    gap: .55rem;
    color: hsl(var(--ink-soft));
    font-size: .875rem;
  }

  .home-specimen__form :global(.ui-input) {
    width: 100%;
  }

  .home-specimen__alerts {
    display: grid;
    gap: .75rem;
    margin: auto 0;
  }

  .home-specimen__alerts :global(.ui-alert) {
    display: flex;
    align-items: flex-start;
    gap: .75rem;
  }

  .home-specimen__alerts strong {
    font-size: .82rem;
  }

  .home-specimen__alerts p {
    margin: .2rem 0 0;
    font-size: .72rem;
  }

  .home-specimen__swatches {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: .55rem;
    margin: auto 0;
  }

  .home-specimen__swatches span {
    display: grid;
    gap: .5rem;
    color: hsl(var(--ink-muted));
    font-size: .58rem;
    text-align: center;
  }

  .home-specimen__swatches span::before {
    height: 5.5rem;
    border: 1px solid hsl(var(--line) / .5);
    border-radius: var(--ui-radius-sm);
    background: var(--swatch);
    content: "";
  }

  .home-use-cases__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
    margin-top: var(--home-content-gap);
  }

  .home-use-case {
    display: flex;
    min-width: 0;
    grid-column: span 6;
    flex-direction: column;
    overflow: hidden;
    border-color: hsl(var(--line) / .78);
    background: hsl(var(--surface) / .88);
    box-shadow: none;
    padding: 0;
  }

  .home-use-case--featured {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.65fr) minmax(18rem, .75fr);
  }


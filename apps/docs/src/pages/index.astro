---
import {
  Badge,
  Button,
  ButtonLink,
  Card,
  Eyebrow,
  Icon,
  Separator,
  Stat,
} from '@santi020k/lumen-astro'
import { lumenComponentNames } from '@santi020k/lumen-core'

import FrameworkSetupTabs from '../components/FrameworkSetupTabs.astro'
import GitHubIcon from '../components/GitHubIcon.astro'
import PrimitiveShowcase from '../components/PrimitiveShowcase.astro'
import { componentCategories, componentDocs, frameworkSetups } from '../data/docs'
import BaseLayout from '../layouts/BaseLayout.astro'
import { toSlug } from '../lib/routes'

const componentCount = lumenComponentNames.length
const installCommand = 'pnpm add @santi020k/lumen-astro'

const highlights = [
  {
    description: 'Real buttons, dialogs, tables, and forms. Accessibility comes from the markup, not a wrapper div.',
    icon: 'shield-check',
    metric: 'A11y',
    title: 'Semantic first'
  },
  {
    description: 'Every target shares the same ui-* stylesheet driven by design tokens, so screens look identical across frameworks.',
    icon: 'layers-3',
    metric: '1 CSS',
    title: 'One class contract'
  },
  {
    description: 'A single progressive-enhancement script powers dialogs, menus, tabs, and toasts in about 4 KB.',
    icon: 'zap',
    metric: '~4 KB',
    title: 'No framework runtime'
  }
] as const

const stats = [
  { label: 'components', value: String(componentCount) },
  { label: 'targets', value: '3' },
  { label: 'app runtime lock-in', value: '0' }
] as const

const featured = componentDocs.slice(0, 8)
---

<BaseLayout
  description={`Lumen is a multi-framework primitive UI system with ${componentCount} components for Astro, React, and Web Components, documented with live examples.`}
  title="Lumen UI - Primitives for Astro, React, and Web Components"
>
  <main class="
    docs-home-shell mx-auto flex w-full max-w-6xl flex-col gap-24 px-5 py-16
    sm:px-8
  ">
    <section class="
      docs-home-hero grid gap-14
      lg:grid-cols-[0.82fr_1.18fr] lg:items-center
    ">
      <div class="docs-home-hero__content">
        <Eyebrow class="docs-home-eyebrow docs-anim">
          {componentCount} primitives, one shared contract
        </Eyebrow>
        <h1 class="docs-home-title docs-anim">
          Primitive UI that ships in <span>every framework.</span>
        </h1>
        <p class="docs-home-lede docs-anim">
          Lumen is a primitive UI system built on semantic markup and shared design tokens.
          The same component, the same classes, the same behavior, in Astro, React, and
          standards-based custom elements.
        </p>
        <div class="docs-home-targets docs-anim" aria-label="Supported frameworks">
          <Badge variant="outline">Astro</Badge>
          <Badge variant="outline">React</Badge>
          <Badge variant="outline">Web Components</Badge>
        </div>
        <div class="docs-home-actions docs-anim">
          <ButtonLink class="docs-cta-lg" href="/docs" showArrow variant="primary">
            Get started
          </ButtonLink>
          <ButtonLink class="docs-cta-lg" href="/docs/components" variant="ghost">
            Browse components
          </ButtonLink>
        </div>
        <Button
          class="docs-home-install docs-anim"
          data-copy-command={installCommand}
          variant="outline"
        >
          <Icon name="terminal" size="sm" />
          <span aria-hidden="true">{installCommand}</span>
          <span class="docs-home-install__action" data-copy-feedback>Copy</span>
          <span class="sr-only">Copy install command: {installCommand}</span>
        </Button>
        <dl class="docs-home-stats docs-anim" aria-label="Lumen at a glance">
          {stats.map(stat => (
            <Stat class="docs-home-stat" label={stat.label} value={stat.value} />
          ))}
        </dl>
      </div>

      <div class="docs-home-showcase-wrap docs-anim">
        <span class="docs-home-showcase-glow" aria-hidden="true"></span>
        <div class="docs-home-window">
          <div class="docs-home-window__bar" aria-hidden="true">
            <span class="docs-home-window__dots">
              <i></i><i></i><i></i>
            </span>
            <span class="docs-home-window__url">lumen.santi020k.com</span>
            <span class="docs-home-window__live">
              <Icon name="circle-dot" size="sm" />
              Live
            </span>
          </div>
          <PrimitiveShowcase
            class="docs-home-showcase"
            description="This site is built with the same primitives it documents: controls, status, and tokens sharing one contract."
            title="Workspace launch"
          />
        </div>
      </div>
    </section>

    <section class="docs-home-block" aria-label="Why Lumen">
      <div class="
        docs-home-highlights grid gap-4
        md:grid-cols-3
      ">
        {highlights.map(highlight => (
          <Card as="article" class="docs-home-highlight">
            <div class="docs-home-highlight__top">
              <span class="docs-home-highlight__icon">
                <Icon name={highlight.icon} size="sm" />
              </span>
              <span class="docs-home-highlight__metric">{highlight.metric}</span>
            </div>
            <h2 class="docs-home-highlight__title">{highlight.title}</h2>
            <p class="docs-home-highlight__body">{highlight.description}</p>
          </Card>
        ))}
      </div>
    </section>

    <section class="docs-home-block" aria-labelledby="usage-title">
      <div class="docs-home-block__head">
        <Eyebrow>Proof, not promises</Eyebrow>
        <h2 class="docs-home-block__title" id="usage-title">
          The same component in every framework
        </h2>
        <p class="docs-home-block__lede">
          Install the adapter for your stack and write the same markup. Same classes,
          same tokens, same behavior.
        </p>
      </div>
      <FrameworkSetupTabs setups={frameworkSetups} />
    </section>

    <section class="docs-home-block" aria-labelledby="catalog-title">
      <div class="docs-home-block__head docs-home-block__head--split">
        <div>
          <Eyebrow>Component reference</Eyebrow>
          <h2 class="docs-home-block__title" id="catalog-title">
            Live previews, code in three flavors
          </h2>
          <p class="docs-home-block__lede">
            Every component page renders the real thing and shows matching Astro, React, and
            custom-element usage side by side. {componentCategories.join(', ')}.
          </p>
        </div>
        <ButtonLink href="/docs/components" showArrow variant="secondary">
          See all {componentCount}
        </ButtonLink>
      </div>
      <div class="
        docs-home-catalog grid gap-3
        sm:grid-cols-2
        lg:grid-cols-4
      ">
        {featured.map(component => (
          <a
            class="docs-home-component no-underline"
            href={`/docs/components/${toSlug(component.name)}`}
          >
            <div class="docs-home-component__header">
              <span class="docs-home-component__mark" aria-hidden="true">
                {component.name.slice(0, 2)}
              </span>
              <div class="docs-home-component__meta">
                <h3>{component.name}</h3>
                <p>{component.category}</p>
              </div>
              <Icon class="docs-home-component__arrow" name="arrow-up-right" size="sm" />
            </div>
            <p class="docs-home-component__body">{component.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <Separator />

    <section class="docs-home-cta" aria-label="Get started">
      <h2 class="docs-home-cta__title">Start with the framework you already use.</h2>
      <div class="docs-home-cta__actions">
        <ButtonLink class="docs-cta-lg" href="/docs" variant="primary">
          <Icon name="book-open" size="sm" />
          Read the docs
        </ButtonLink>
        <ButtonLink
          class="docs-cta-lg"
          href="https://github.com/santi020k/lumen"
          newTab
          variant="secondary"
        >
          <GitHubIcon />
          Star on GitHub
        </ButtonLink>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.addEventListener('click', event => {
    const button = event.target instanceof Element
      ? event.target.closest<HTMLButtonElement>('[data-copy-command]')
      : null

    const command = button?.dataset.copyCommand

    if (!button || command === undefined) return

    navigator.clipboard.writeText(command).then(() => {
      const feedback = button.querySelector('[data-copy-feedback]')

      if (!feedback) return null

      feedback.textContent = 'Copied!'

      setTimeout(() => {
        feedback.textContent = 'Copy'
      }, 2000)

      return null
    }).catch(() => null)
  })
</script>

---
import { ButtonLink } from '@santi020k/lumen-astro'

import DocsPageHero from '../components/DocsPageHero.astro'
import DeviceFrameGallery from '../examples/DeviceFrame.astro'
import DocsLayout from '../layouts/DocsLayout.astro'
---

<DocsLayout
  breadcrumbs={[
    { href: '/docs/web/playground', label: 'Web playground' },
    { href: '/device-frame-demo', label: 'Device frame showcase' }
  ]}
  description="Try a responsive Lumen workspace on six simulated devices. Compare screen sizes and finishes, and copy the Astro example."
  title="Responsive Device Frame Showcase - Lumen UI"
>
  <DocsPageHero
    compact
    eyebrow="Interactive showcase"
    title="One workspace across six device frames"
    description="Compare how the same Lumen workspace adapts to desktop, laptop, tablet, and phone viewports. Pick a device, change its finish, and copy the Astro example to use in your own docs."
  >
    <ButtonLink slot="actions" href="/docs/components/device-frame" variant="secondary">Read the Device Frame docs</ButtonLink>
  </DocsPageHero>

  <section class="docs-section" aria-labelledby="device-showcase-gallery">
    <h2 id="device-showcase-gallery">Try the device gallery</h2>
    <DeviceFrameGallery />
  </section>
</DocsLayout>

---
import { Link } from '@santi020k/lumen-astro'
import { lumenIcons, renderLumenIconSvg } from '@santi020k/lumen-core'

import CodeBlock from '../../components/CodeBlock.astro'
import DocsActionLink from '../../components/DocsActionLink.astro'
import DocsPageHero from '../../components/DocsPageHero.astro'
import IconCatalog from '../../components/IconCatalog.astro'
import IconHeroGrid from '../../components/IconHeroGrid.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

interface IconEntry {
  name: string
  svg: string
  terms: string
}

// lumenIcons maps every kebab name, canonical Lucide name, and alias to the same
// icon data. Collapse them to one entry per icon while keeping the other keys as
// search terms so people can find an icon by any name Lumen accepts.
const byName = new Map<string, { name: string, terms: Set<string> }>()

for (const [key, icon] of Object.entries(lumenIcons)) {
  const existing = byName.get(icon.name)

  if (existing) {
    existing.terms.add(key)

    continue
  }

  byName.set(icon.name, { name: icon.name, terms: new Set([icon.name, key]) })
}

const iconEntries: IconEntry[] = [...byName.values()]
  .sort((a, b) => a.name.localeCompare(b.name))
  .map(({ name, terms }) => ({
    name,
    svg: renderLumenIconSvg(name),
    terms: [...terms].join(' ')
  }))

const iconCount = iconEntries.length

const featuredIcons = [
  'search',
  'house',
  'calendar-days',
  'message-circle',
  'heart',
  'star',
  'bell',
  'circle-check',
  'settings'
].map(name => renderLumenIconSvg(name))

const astroUsage = `---
import { Icon } from '@santi020k/lumen-astro'
---

<Icon name="search" label="Search" />
<Icon name="wand-sparkles" decorative />
<Icon name="circle-check" label="Synced" size="lg" />`

const reactUsage = `import { Icon } from '@santi020k/lumen-react'

export const Toolbar = () => (
  <>
    <Icon name="search" label="Search" />
    <Icon name="wand-sparkles" decorative />
    <Icon name="circle-check" label="Synced" size="lg" />
  </>
)`

const elementsUsage = `<lumen-icon name="search" label="Search"></lumen-icon>
<lumen-icon name="wand-sparkles" decorative></lumen-icon>
<lumen-icon name="circle-check" label="Synced" size="lg"></lumen-icon>`
---

<DocsLayout
  description={`Browse the ${iconCount} Lucide icons available through the Lumen Icon component across Astro, React, and Elements.`}
  title="Icons - Lumen UI"
>
  <div class="icons-page">
    <DocsPageHero
      description="Search the complete Lucide set through one accessible component. Kebab-case names and aliases resolve consistently in every Lumen framework target."
      eyebrow="Icon library"
      stats={[
        { label: 'Icons', value: iconCount },
        { label: 'Frameworks', value: 3 },
        { label: 'Component API', value: 1 }
      ]}
      title="A familiar symbol for every action."
    >
      <Fragment slot="actions">
        <DocsActionLink href="#icon-catalog">Explore icons</DocsActionLink>
        <DocsActionLink href="/docs/brand-icons" variant="outline">Browse brand icons</DocsActionLink>
      </Fragment>

      <IconHeroGrid icons={featuredIcons} slot="visual" />
    </DocsPageHero>

    <p class="icons-attribution">
      Icons by <Link href="https://lucide.dev/" rel="noopener noreferrer" target="_blank">Lucide</Link>,
      created and maintained by its open-source contributors.
    </p>

    <section class="icons-section" aria-labelledby="usage-title">
      <div class="icons-section__heading">
        <div>
          <p>One component</p>
          <h2 id="usage-title">Use it everywhere</h2>
        </div>
        <p>
          Names, sizes, and accessibility props stay aligned across Astro, React, and custom
          elements. Decorative icons stay hidden; meaningful icons require a label.
        </p>
      </div>

      <div class="icons-usage-grid">
        <CodeBlock code={astroUsage} lang="astro" title="Astro" />
        <CodeBlock code={reactUsage} lang="tsx" title="React" />
        <CodeBlock code={elementsUsage} lang="html" title="Elements" />
      </div>
    </section>

    <IconCatalog
      description="Search by canonical name or alias, then select any tile to copy its component name."
      entries={iconEntries}
      id="icon-catalog"
      searchLabel="Search the icon library"
      title="Find your icon"
    />

    <section class="icons-section icons-section--brands" aria-labelledby="brand-icons-title">
      <div class="icons-section__heading">
        <div>
          <p>Need a logo?</p>
          <h2 id="brand-icons-title">Brand marks have their own catalog</h2>
        </div>
        <p>
          Browse more than 570 opt-in company and product marks without loading them into this
          interface-icon page.
        </p>
      </div>

      <DocsActionLink href="/docs/brand-icons">Explore brand icons</DocsActionLink>
    </section>
  </div>
</DocsLayout>

<style>
  .icons-page {
    display: grid;
    gap: 3.5rem;
  }

  .icons-attribution {
    margin-top: -2.5rem;
    color: hsl(var(--ink-muted));
    font-size: 0.78rem;
    text-align: right;
  }

  .icons-section {
    display: grid;
    gap: 1.4rem;
    scroll-margin-top: 6rem;
  }

  .icons-section__heading {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  .icons-section__heading > div > p {
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .icons-section__heading h2 {
    margin-top: 0.25rem;
    color: hsl(var(--ink));
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  .icons-section__heading > p {
    max-width: 36rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .icons-usage-grid {
    display: grid;
    gap: 0.85rem;
  }

  .icons-section--brands {
    justify-items: start;
    padding: 1.4rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.2rem;
    background: hsl(var(--surface-muted));
  }

  .icons-section--brands .icons-section__heading {
    width: 100%;
  }

  @media (min-width: 48rem) {
    .icons-section__heading {
      grid-template-columns: minmax(13rem, 0.8fr) minmax(18rem, 1fr);
      align-items: end;
    }
  }

  @media (max-width: 36rem) {
    .icons-attribution {
      text-align: left;
    }
  }

  @media (min-width: 75rem) {
    .icons-usage-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

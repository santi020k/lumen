---
import { Button, Input, Label, Link } from '@santi020k/lumen-astro'
import { lumenIcons, renderLumenIconSvg } from '@santi020k/lumen-core'
import {
  lumenBrandIconNames,
  registerLumenBrandIcons
} from '@santi020k/lumen-icons-brand'

import CodeBlock from '../../components/CodeBlock.astro'
import DocsActionLink from '../../components/DocsActionLink.astro'
import DocsPageHero from '../../components/DocsPageHero.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

interface IconEntry {
  name: string
  svg: string
  terms: string
}

registerLumenBrandIcons()

// lumenIcons maps every kebab name, canonical Lucide name, and alias to the same
// icon data. Collapse them to one entry per icon while keeping the other keys as
// search terms so people can find an icon by any name Lumen accepts.
const byName = new Map<string, { name: string, terms: Set<string> }>()

for (const [key, icon] of Object.entries(lumenIcons)) {
  const existing = byName.get(icon.name)

  if (existing) {
    existing.terms.add(key)

    continue
  }

  byName.set(icon.name, { name: icon.name, terms: new Set([icon.name, key]) })
}

const iconEntries: IconEntry[] = [...byName.values()]
  .sort((a, b) => a.name.localeCompare(b.name))
  .map(({ name, terms }) => ({
    name,
    svg: renderLumenIconSvg(name),
    terms: [...terms].join(' ')
  }))

const iconCount = iconEntries.length

const featuredIcons = [
  'search',
  'house',
  'calendar-days',
  'message-circle',
  'heart',
  'star',
  'bell',
  'circle-check',
  'settings'
].map(name => renderLumenIconSvg(name))

const astroUsage = `---
import { Icon } from '@santi020k/lumen-astro'
---

<Icon name="search" label="Search" />
<Icon name="wand-sparkles" decorative />
<Icon name="circle-check" label="Synced" size="lg" />`

const reactUsage = `import { Icon } from '@santi020k/lumen-react'

export const Toolbar = () => (
  <>
    <Icon name="search" label="Search" />
    <Icon name="wand-sparkles" decorative />
    <Icon name="circle-check" label="Synced" size="lg" />
  </>
)`

const elementsUsage = `<lumen-icon name="search" label="Search"></lumen-icon>
<lumen-icon name="wand-sparkles" decorative></lumen-icon>
<lumen-icon name="circle-check" label="Synced" size="lg"></lumen-icon>`

const brandUsage = `import { registerLumenBrandIcons } from '@santi020k/lumen-icons-brand'

registerLumenBrandIcons()

// The same name works in Astro, React, and Elements.
<Icon name="brand:github" label="GitHub" />`

const brandIcons = lumenBrandIconNames.map(name => ({
  name,
  svg: renderLumenIconSvg(`brand:${name}`)
}))
---

<DocsLayout
  description={`Browse the ${iconCount} Lucide icons available through the Lumen Icon component across Astro, React, and Elements.`}
  title="Icons - Lumen UI"
>
  <div class="icons-page">
    <DocsPageHero
      description="Search the complete Lucide set through one accessible component. Kebab-case names and aliases resolve consistently in every Lumen framework target."
      eyebrow="Icon library"
      stats={[
        { label: 'Icons', value: iconCount },
        { label: 'Frameworks', value: 3 },
        { label: 'Component API', value: 1 }
      ]}
      title="A familiar symbol for every action."
    >
      <Fragment slot="actions">
        <DocsActionLink href="#icon-catalog">Explore icons</DocsActionLink>
        <DocsActionLink href="/docs/components/icon" variant="outline">View Icon API</DocsActionLink>
      </Fragment>

      <div class="icons-hero-grid" slot="visual" aria-hidden="true">
        {featuredIcons.map(svg => (
          <span class="icons-hero-grid__tile">
            <span class="ui-icon ui-icon--xl" set:html={svg} />
          </span>
        ))}
      </div>
    </DocsPageHero>

    <p class="icons-attribution">
      Icons by <Link href="https://lucide.dev/" rel="noopener noreferrer" target="_blank">Lucide</Link>,
      created and maintained by its open-source contributors.
    </p>

    <section class="icons-section" aria-labelledby="usage-title">
      <div class="icons-section__heading">
        <div>
          <p>One component</p>
          <h2 id="usage-title">Use it everywhere</h2>
        </div>
        <p>
          Names, sizes, and accessibility props stay aligned across Astro, React, and custom
          elements. Decorative icons stay hidden; meaningful icons require a label.
        </p>
      </div>

      <div class="icons-usage-grid">
        <CodeBlock code={astroUsage} lang="astro" title="Astro" />
        <CodeBlock code={reactUsage} lang="tsx" title="React" />
        <CodeBlock code={elementsUsage} lang="html" title="Elements" />
      </div>
    </section>

    <section class="icons-section" id="icon-catalog" aria-labelledby="catalog-title">
      <div class="icons-section__heading">
        <div>
          <p>Complete set</p>
          <h2 id="catalog-title">Find your icon</h2>
        </div>
        <p>
          Search by canonical name or alias, then select any tile to copy its component name.
        </p>
      </div>

      <div class="icons-search">
        <Label for="icon-search">Search the icon library</Label>
        <Input
          autocomplete="off"
          data-icon-search
          id="icon-search"
          placeholder={`Search ${iconCount} icons by name or alias...`}
          spellcheck="false"
          type="search"
        />
        <p data-icon-status>
          Showing <span data-icon-visible-count>{iconCount}</span> of {iconCount} icons
        </p>
      </div>

      <p class="icons-empty" data-icon-empty hidden>
        No icons match your search.
      </p>

      <div class="icons-grid" data-icon-grid>
        {iconEntries.map(entry => (
          <Button
            data-icon-name={entry.name}
            data-icon-terms={entry.terms}
            variant="ghost"
            title={`Copy "${entry.name}"`}
          >
            <span class="ui-icon ui-icon--xl" aria-hidden="true" set:html={entry.svg} />
            <span>{entry.name}</span>
          </Button>
        ))}
      </div>
    </section>

    <section class="icons-section" aria-labelledby="brand-icons-title">
      <div class="icons-section__heading">
        <div>
          <p>Optional package</p>
          <h2 id="brand-icons-title">Official brand marks, intentionally separate</h2>
        </div>
        <p>
          Install the opt-in brand pack when a product needs company marks. Names stay namespaced
          so the X brand can never be confused with Lucide's close icon.
        </p>
      </div>

      <CodeBlock code={brandUsage} lang="tsx" title="Register once" />

      <ul class="icons-brand-grid" aria-label="Available brand icons">
        {brandIcons.map(icon => (
          <li>
            <span class="ui-icon ui-icon--xl" aria-hidden="true" set:html={icon.svg} />
            <code>{`brand:${icon.name}`}</code>
          </li>
        ))}
      </ul>
    </section>
  </div>
</DocsLayout>

<script>
  const grid = document.querySelector<HTMLElement>('[data-icon-grid]')
  const search = document.querySelector<HTMLInputElement>('[data-icon-search]')
  const empty = document.querySelector<HTMLElement>('[data-icon-empty]')
  const visibleCount = document.querySelector<HTMLElement>('[data-icon-visible-count]')

  if (grid && search) {
    const cells = [...grid.querySelectorAll<HTMLButtonElement>('[data-icon-name]')]

    const applyFilter = (raw: string) => {
      const query = raw.trim().toLowerCase()
      let visible = 0

      for (const cell of cells) {
        const terms = cell.dataset.iconTerms ?? ''
        const match = query === '' || terms.includes(query)

        cell.hidden = !match

        if (match) visible += 1
      }

      if (visibleCount) visibleCount.textContent = String(visible)

      if (empty) empty.hidden = visible !== 0
    }

    const flashCopied = (cell: HTMLButtonElement) => {
      const label = cell.querySelector('span:last-child')

      if (!label) return

      const original = label.textContent

      label.textContent = 'Copied!'

      window.setTimeout(() => {
        label.textContent = original
      }, 1000)
    }

    search.addEventListener('input', event => {
      applyFilter((event.target as HTMLInputElement).value)
    })

    grid.addEventListener('click', async event => {
      const cell = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-icon-name]')

      if (!cell) return

      const name = cell.dataset.iconName ?? ''

      try {
        await navigator.clipboard.writeText(name)

        flashCopied(cell)
      } catch {
        // Clipboard access can be blocked; ignore silently.
      }
    })
  }
</script>

<style>
  .icons-page {
    display: grid;
    gap: 3.5rem;
  }

  .icons-attribution {
    margin-top: -2.5rem;
    color: hsl(var(--ink-muted));
    font-size: 0.78rem;
    text-align: right;
  }

  .icons-hero-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    padding: 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.1rem;
    background: hsl(var(--canvas) / 0.62);
    box-shadow:
      0 1rem 2.5rem hsl(var(--ink) / 0.06),
      inset 0 1px 0 hsl(0 0% 100% / 0.18);
    backdrop-filter: blur(14px);
  }

  .icons-hero-grid__tile {
    display: grid;
    min-height: 3.35rem;
    place-items: center;
    border: 1px solid hsl(var(--line));
    border-radius: 0.75rem;
    background: hsl(var(--surface) / 0.8);
    color: hsl(var(--brand));
    box-shadow:
      0 0.2rem 0.7rem hsl(var(--ink) / 0.05),
      inset 0 1px 0 hsl(0 0% 100% / 0.2);
  }

  .icons-hero-grid__tile:nth-child(2n) {
    color: hsl(var(--ink-soft));
  }

  .icons-hero-grid__tile:nth-child(5) {
    border-color: hsl(var(--brand) / 0.45);
    background: linear-gradient(145deg, hsl(var(--brand)), hsl(var(--brand-solid)));
    color: hsl(var(--canvas));
    box-shadow: 0 0.55rem 1.2rem hsl(var(--brand) / 0.22);
    transform: scale(1.04);
  }

  .icons-hero-grid__tile .ui-icon {
    --ui-icon-size: 1.6rem;
  }

  .icons-section {
    display: grid;
    gap: 1.4rem;
    scroll-margin-top: 6rem;
  }

  .icons-section__heading {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  .icons-section__heading > div > p {
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .icons-section__heading h2 {
    margin-top: 0.25rem;
    color: hsl(var(--ink));
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  .icons-section__heading > p {
    max-width: 36rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .icons-usage-grid {
    display: grid;
    gap: 0.85rem;
  }

  .icons-search {
    display: grid;
    gap: 0.55rem;
    max-width: 46rem;
  }

  .icons-search label {
    color: hsl(var(--ink));
    font-size: 0.8rem;
    font-weight: 850;
  }

  .icons-search input {
    height: 3.25rem;
    border-radius: 0.9rem;
    font-size: 1rem;
  }

  .icons-search p {
    color: hsl(var(--ink-muted));
    font-size: 0.8rem;
  }

  .icons-empty {
    padding: 3rem 1rem;
    border: 1px dashed hsl(var(--line));
    border-radius: 1rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    text-align: center;
  }

  .icons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: 0.6rem;
  }

  .icons-brand-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .icons-brand-grid li {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: var(--ui-radius);
    background: hsl(var(--surface));
    padding: 0.8rem;
  }

  .icons-brand-grid code {
    overflow: hidden;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    text-overflow: ellipsis;
  }

  .icons-grid button {
    display: flex;
    aspect-ratio: 1;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.9rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink-soft));
    cursor: pointer;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease,
      transform 150ms ease;
  }

  .icons-grid button:hover {
    border-color: hsl(var(--brand));
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
    transform: translateY(-2px);
  }

  .icons-grid button > span:last-child {
    overflow: hidden;
    width: 100%;
    color: hsl(var(--ink-muted));
    font-size: 0.63rem;
    line-height: 1.2;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .icons-section__heading {
      grid-template-columns: minmax(13rem, 0.8fr) minmax(18rem, 1fr);
      align-items: end;
    }
  }

  @media (max-width: 36rem) {
    .icons-attribution {
      text-align: left;
    }
  }

  @media (min-width: 75rem) {
    .icons-usage-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

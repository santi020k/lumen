---
import { Code, Link, Typography } from '@santi020k/lumen-astro'

import DocsPageHero from '../../components/DocsPageHero.astro'
import VisualGuideDirectory from '../../components/VisualGuideDirectory.astro'
import VisualGuideNavigation from '../../components/VisualGuideNavigation.astro'
import VisualWorkbench from '../../components/VisualWorkbench.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'
---

<DocsLayout title="Visual playground — Lumen UI" description="Explore coordinated motion, semantic visual effects, and application-owned AI surfaces with reduced-motion comparisons.">
  <DocsPageHero
    compact
    eyebrow="Interactive web workbench"
    title="Make interfaces feel connected."
    description="Start with a focused guide, copy a working example, then explore the full workbench below."
    stats={[{ label: 'New primitives', value: 8 }, { label: 'Visual effects', value: 7 }, { label: 'Product recipes', value: 4 }]}
  />
  <VisualGuideNavigation />
  <VisualGuideDirectory />
  <VisualWorkbench />
  <Typography><h2>Install only what you use</h2><p>MotionGroup uses browser animation APIs. VisualEffect defaults to a static treatment. Mount <Link href="/docs/frameworks/astro">UIPrimitives</Link> once in Astro; register custom elements once in Elements.</p></Typography>
  <Code variant="block" language="bash" copy code="lumen add MotionGroup --target astro\nlumen add VisualEffect --target react\nlumen add PromptComposer --target elements" />
</DocsLayout>

---
import { Breadcrumb, Card } from '@santi020k/lumen-astro'

import CodeBlock from '../../../components/CodeBlock.astro'
import DocsActionLink from '../../../components/DocsActionLink.astro'
import DocsPageHero from '../../../components/DocsPageHero.astro'
import RuntimeExamples from '../../../components/RuntimeExamples.astro'
import { frameworkGuides, frameworkSetups } from '../../../data/docs'
import DocsLayout from '../../../layouts/DocsLayout.astro'

const guide = frameworkGuides.find(g => g.id === 'astro')
const setup = frameworkSetups.find(s => s.id === 'astro')

if (!guide || !setup) {
  throw new Error('Astro framework docs are missing their guide or setup data.')
}
---

<DocsLayout
  description="Install Lumen UI in Astro with automatic component CSS and on-demand interactions. Follow setup examples for accessible components and progressive enhancement."
  title="Astro UI Components: Installation & Setup - Lumen UI"
>
  <div class="framework-page">
    <Breadcrumb class="docs-breadcrumb">
      <ol>
        <li><a href="/docs">Docs</a></li>
        <li><span aria-current="page">Astro</span></li>
      </ol>
    </Breadcrumb>

    <DocsPageHero
      description="The reference implementation for Lumen UI, with the complete component catalog, automatic component CSS, and controllers that load on demand."
      eyebrow="Framework guide"
      stats={[
        { label: 'Surface', value: 'Full' },
        { label: 'Runtime', value: 'On demand' },
        { label: 'Package', value: 'Astro' }
      ]}
      title={guide.title}
    >
      <Fragment slot="actions">
        <DocsActionLink href="#install-title">
          Install for Astro
        </DocsActionLink>
        <DocsActionLink href="/starters/astro" variant="outline">
          Try the free starter
        </DocsActionLink>
      </Fragment>
    </DocsPageHero>

    <section class="docs-section space-y-4" aria-labelledby="starter-title">
      <div class="docs-section-heading">
        <h2 id="starter-title" class="text-xl font-bold text-ink">Start with a complete Astro project</h2>
        <p class="text-sm/6 text-ink-soft">
          The free MIT starter includes landing page, ecommerce, dashboard, and portfolio templates.
          Explore seven Lumen themes in light and dark mode, then edit the same source in your own project.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <DocsActionLink href="/starters/astro">Preview the templates</DocsActionLink>
        <DocsActionLink href="/downloads/lumen-astro-starter.zip" download variant="outline">Download starter</DocsActionLink>
        <DocsActionLink href="/guides/build-an-astro-starter" variant="outline">Follow the walkthrough</DocsActionLink>
      </div>
    </section>

    <section class="docs-section space-y-4" aria-labelledby="install-title">
      <div class="docs-section-heading">
        <h2 id="install-title" class="text-xl font-bold text-ink">Installation</h2>
        <p class="text-sm/6 text-ink-soft">{setup.note}</p>
      </div>
      <div class="
        grid gap-4
        md:grid-cols-2
      "
      >
        {setup.installCommands.map(install => (
          <Card variant="muted" class="space-y-2">
            <p class="
              text-xs font-black tracking-[0.14em] text-ink-muted uppercase
            "
            >{install.label}
            </p>
            <CodeBlock code={install.command} lang="bash" />
          </Card>
        ))}
      </div>
      <div class="mt-4">
        <h3 class="mb-2 text-sm font-bold text-ink">Usage Example</h3>
        <CodeBlock code={setup.usage} lang={setup.lang} />
      </div>
    </section>

    <section class="docs-section mt-10 space-y-4" aria-labelledby="overview-title">
      <div class="docs-section-heading">
        <h2 id="overview-title" class="text-xl font-bold text-ink">Overview</h2>
      </div>
      <ul class="m-0 grid list-disc gap-2 pl-4 text-sm/6 text-ink-soft">
        {guide.body.map(item => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="docs-section mt-10 space-y-4" aria-labelledby="runtime-title">
      <div class="docs-section-heading">
        <h2 id="runtime-title" class="text-xl font-bold text-ink">Progressive Enhancement Runtime</h2>
        <p class="text-sm/6 text-ink-soft">
          Interactive components like Dialogs, Popovers, Tabs, and Selects rely on a lightweight,
          vanilla JavaScript runtime. Mount <code>&lt;UIPrimitives /&gt;</code> once in your Astro
          root layout to wire up keyboard navigation, focus trapping, and disclosure state
          for matching components. In v5, controllers load on demand and initialization is asynchronous.
          Await <code>window.LumenInitUiPrimitives(scope)</code> for application-created markup;
          <code>ui:ready</code> follows completion and <code>ui:runtime-error</code> reports failures.
        </p>
      </div>
      <CodeBlock code={guide.code} lang={guide.lang} />
      <RuntimeExamples idPrefix="astro" />
    </section>
  </div>

</DocsLayout>

---
/* eslint-disable better-tailwindcss/no-unknown-classes */
import { Card } from '@santi020k/lumen-astro'

import CodeBlock from '../../../components/CodeBlock.astro'
import DocsPageHero from '../../../components/DocsPageHero.astro'
import { frameworkGuides, frameworkSetups } from '../../../data/docs'
import DocsLayout from '../../../layouts/DocsLayout.astro'

const guide = frameworkGuides.find(g => g.id === 'astro')
const setup = frameworkSetups.find(s => s.id === 'astro')

if (!guide || !setup) {
  throw new Error('Astro framework docs are missing their guide or setup data.')
}
---

<DocsLayout
  description="Using Lumen UI in Astro: Reference implementation, progressive enhancement, and component registry."
  title="Astro - Lumen UI"
>
  <div class="framework-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a href="/docs">Docs</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Astro</span>
    </nav>

    <DocsPageHero
      description="The reference implementation for Lumen UI, with the complete component catalog, standalone CSS, and a tiny progressive-enhancement runtime."
      eyebrow="Framework guide"
      stats={[
        { label: 'Surface', value: 'Full' },
        { label: 'Runtime', value: '~4 KB' },
        { label: 'Package', value: 'Astro' }
      ]}
      title={guide.title}
    >
      <Fragment slot="actions">
        <a class="
          ui-button ui-button--default-size ui-button--default no-underline
        " href="#install-title">
          Install for Astro
        </a>
        <a class="
          ui-button ui-button--default-size ui-button--outline no-underline
        " href="/docs/components">
          Browse components
        </a>
      </Fragment>
    </DocsPageHero>

    <section class="docs-section space-y-4" aria-labelledby="install-title">
    <div class="docs-section-heading">
      <h2 id="install-title" class="text-xl font-bold text-ink">Installation</h2>
      <p class="text-sm/6 text-ink-soft">{setup.note}</p>
    </div>
    <div class="
      grid gap-4
      md:grid-cols-2
    ">
      {setup.installCommands.map(install => (
        <Card variant="muted" class="space-y-2">
          <p class="
            text-xs font-black tracking-[0.14em] text-ink-muted uppercase
          ">{install.label}</p>
          <CodeBlock code={install.command} lang="bash" />
        </Card>
      ))}
    </div>
    <div class="mt-4">
      <h3 class="mb-2 text-sm font-bold text-ink">Usage Example</h3>
      <CodeBlock code={setup.usage} lang={setup.lang} />
    </div>
    </section>

    <section class="docs-section mt-10 space-y-4" aria-labelledby="overview-title">
    <div class="docs-section-heading">
      <h2 id="overview-title" class="text-xl font-bold text-ink">Overview</h2>
    </div>
    <ul class="m-0 grid list-disc gap-2 pl-4 text-sm/6 text-ink-soft">
      {guide.body.map(item => (
        <li>{item}</li>
      ))}
    </ul>
    </section>

    <section class="docs-section mt-10 space-y-4" aria-labelledby="runtime-title">
    <div class="docs-section-heading">
      <h2 id="runtime-title" class="text-xl font-bold text-ink">Progressive Enhancement Runtime</h2>
      <p class="text-sm/6 text-ink-soft">
        Interactive components like Dialogs, Popovers, Tabs, and Selects rely on a lightweight,
        vanilla JavaScript runtime. Mount <code>&lt;UIPrimitives /&gt;</code> once in your Astro root layout to wire up
        keyboard navigation, focus trapping, and disclosure state globally.
      </p>
    </div>
    <CodeBlock code={guide.code} lang={guide.lang} />
    </section>
  </div>

</DocsLayout>

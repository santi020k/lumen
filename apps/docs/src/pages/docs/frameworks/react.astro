---
import { Breadcrumb, CodeTabs, Link, Note } from '@santi020k/lumen-astro'

import CodeBlock from '../../../components/CodeBlock.astro'
import DocsActionLink from '../../../components/DocsActionLink.astro'
import DocsPageHero from '../../../components/DocsPageHero.astro'
import { frameworkGuides, frameworkSetups } from '../../../data/docs'
import { reactHookGuides } from '../../../data/react-hooks'
import DocsLayout from '../../../layouts/DocsLayout.astro'

const guide = frameworkGuides.find(g => g.id === 'react')
const setup = frameworkSetups.find(s => s.id === 'react')

if (!guide || !setup) {
  throw new Error('React framework docs are missing their guide or setup data.')
}
---

<DocsLayout
  breadcrumbs={[
    { href: '/docs', label: 'Docs' },
    { href: '/docs/web', label: 'Web' },
    { href: '/docs/frameworks/react', label: 'React' }
  ]}
  pageNavigation={[
    { id: 'install-title', label: 'Installation' },
    { id: 'overview-title', label: 'React behavior' },
    { id: 'hooks-title', label: 'Find a hook' }
  ]}
  description="Using Lumen UI in React: Component adapters, interactive hooks, and form validation."
  title="React - Lumen UI"
>
  <div class="framework-page">
    <Breadcrumb class="docs-breadcrumb">
      <ol>
        <li><a href="/docs">Docs</a></li>
        <li><span aria-current="page">React</span></li>
      </ol>
    </Breadcrumb>

    <DocsPageHero
      compact
      description="React components that preserve Lumen’s shared visual contract, paired with focused hooks for dialogs, menus, selects, and other interactive patterns."
      eyebrow="Framework guide"
      stats={[
        { label: 'Surface', value: 'Adapter' },
        { label: 'Behavior', value: 'Hooks' },
        { label: 'Package', value: 'React' }
      ]}
      title={guide.title}
    >
      <Fragment slot="actions">
        <DocsActionLink href="#install-title">
          Install for React
        </DocsActionLink>
        <DocsActionLink href="/docs/frameworks/react/hooks" variant="outline">
          Explore hooks
        </DocsActionLink>
      </Fragment>
    </DocsPageHero>

    <section class="docs-section space-y-4" aria-labelledby="install-title">
      <div class="docs-section-heading">
        <h2 id="install-title" class="text-xl font-bold text-ink">Installation</h2>
        <p class="text-sm/6 text-ink-soft">{setup.note}</p>
      </div>
      <CodeTabs
        ariaLabel="React package manager"
        items={setup.installCommands.map(install => ({
          code: install.command,
          label: install.label,
          language: 'bash',
          value: install.label.toLowerCase()
        }))}
      />
      <div class="mt-4">
        <h3 class="mb-2 text-sm font-bold text-ink">Usage Example</h3>
        <CodeBlock code={setup.usage} lang={setup.lang} />
      </div>
    </section>

    <section class="docs-section mt-10 space-y-4" aria-labelledby="overview-title">
      <div class="docs-section-heading">
        <h2 id="overview-title" class="text-xl font-bold text-ink">Overview</h2>
      </div>
      <ul class="m-0 grid list-disc gap-2 pl-4 text-sm/6 text-ink-soft">
        {guide.body.map(item => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <Note>
      <p>In an application with React Server Components, add <code>'use client'</code> to modules that call Lumen hooks. Import the stylesheet once at the application boundary. React hooks own interactive behavior; the Astro <code>UIPrimitives</code> runtime is for Astro markup.</p>
    </Note>

    <section class="docs-section space-y-4" aria-labelledby="hooks-title">
      <div class="docs-section-heading">
        <h2 id="hooks-title" class="text-2xl font-bold text-ink">Find the behavior you need</h2>
        <p class="max-w-3xl text-sm/7 text-ink-soft">Each hook now has a focused page with a live component preview, a copyable React example, options, and return values.</p>
      </div>
      <DocsActionLink href="/docs/frameworks/react/hooks">Browse all {reactHookGuides.length} React hooks</DocsActionLink>
      <nav class="react-hook-shortcuts" aria-label="React hook quick links">
        {reactHookGuides.map(hook => (
          <Link id={hook.name} href={hook.href}>{hook.name} →</Link>
        ))}
      </nav>
    </section>
  </div>

</DocsLayout>

<style>
  .react-hook-shortcuts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
  }

  .react-hook-shortcuts :global(a) {
    padding-block: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
</style>

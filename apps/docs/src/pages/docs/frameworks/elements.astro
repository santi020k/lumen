---
/* eslint-disable better-tailwindcss/no-unknown-classes */
import { Breadcrumb, Card, Separator } from '@santi020k/lumen-astro'

import CodeBlock from '../../../components/CodeBlock.astro'
import DocsPageHero from '../../../components/DocsPageHero.astro'
import { elementsApiReference, frameworkGuides, frameworkSetups } from '../../../data/docs'
import DocsLayout from '../../../layouts/DocsLayout.astro'

const guide = frameworkGuides.find(g => g.id === 'elements')
const setup = frameworkSetups.find(s => s.id === 'elements')

if (!guide || !setup) {
  throw new Error('Elements framework docs are missing their guide or setup data.')
}
---

<DocsLayout
  description="Using Lumen UI Web Components: Custom elements, DOM APIs, and enhancement functions."
  title="Elements - Lumen UI"
>
  <div class="framework-page">
    <Breadcrumb class="docs-breadcrumb">
      <ol>
        <li><a href="/docs">Docs</a></li>
        <li><span aria-current="page">Elements</span></li>
      </ol>
    </Breadcrumb>

    <DocsPageHero
      description="Standards-based custom elements for the complete Lumen catalog, ready for plain HTML or any framework through the same shared class and data contract."
      eyebrow="Framework guide"
      stats={[
        { label: 'Surface', value: 'Native' },
        { label: 'API', value: 'DOM' },
        { label: 'Package', value: 'Elements' }
      ]}
      title={guide.title}
    >
      <Fragment slot="actions">
        <a class="
          ui-button ui-button--default-size ui-button--default no-underline
        " href="#install-title">
          Install Elements
        </a>
        <a class="
          ui-button ui-button--default-size ui-button--outline no-underline
        " href="#api-title">
          Explore the API
        </a>
      </Fragment>
    </DocsPageHero>

    <section class="docs-section space-y-4" aria-labelledby="install-title">
    <div class="docs-section-heading">
      <h2 id="install-title" class="text-xl font-bold text-ink">Installation</h2>
      <p class="text-sm/6 text-ink-soft">{setup.note}</p>
    </div>
    <div class="
      grid gap-4
      md:grid-cols-2
    ">
      {setup.installCommands.map(install => (
        <Card variant="muted" class="space-y-2">
          <p class="
            text-xs font-black tracking-[0.14em] text-ink-muted uppercase
          ">{install.label}</p>
          <CodeBlock code={install.command} lang="bash" />
        </Card>
      ))}
    </div>
    <div class="mt-4">
      <h3 class="mb-2 text-sm font-bold text-ink">Usage Example</h3>
      <CodeBlock code={setup.usage} lang={setup.lang} />
    </div>
    </section>

    <section class="docs-section mt-10 space-y-4" aria-labelledby="overview-title">
    <div class="docs-section-heading">
      <h2 id="overview-title" class="text-xl font-bold text-ink">Overview</h2>
    </div>
    <ul class="m-0 grid list-disc gap-2 pl-4 text-sm/6 text-ink-soft">
      {guide.body.map(item => (
        <li>{item}</li>
      ))}
    </ul>
    </section>

    <Separator class="my-10" />

    <section class="docs-section space-y-8" aria-labelledby="api-title">
    <div class="docs-section-heading">
      <h2 id="api-title" class="text-2xl font-bold text-ink">API Reference</h2>
      <p class="max-w-2xl text-sm/7 text-ink-soft">
        DOM APIs, registration, and progressive enhancement functions for Lumen elements.
      </p>
    </div>

    <div class="space-y-16">
      {elementsApiReference.map(api => (
        <div class="space-y-4">
          <div class="space-y-2">
            <h3 class="text-xl font-bold text-ink" id={api.name}>{api.name}</h3>
            <p class="max-w-3xl text-sm/6 text-ink-soft">{api.description}</p>
          </div>

          {api.rows.length > 0 && (
            <div class="
              overflow-x-auto rounded-xl border border-line bg-surface
            ">
              <table class="w-full min-w-176 border-collapse text-left text-sm">
                <thead class="
                  bg-surface-muted text-xs font-black tracking-[0.12em]
                  text-ink-muted uppercase
                ">
                  <tr>
                    <th class="border-b border-line px-4 py-3">Signature / Attribute</th>
                    <th class="border-b border-line px-4 py-3">Description</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-line">
                  {api.rows.map(row => (
                    <tr>
                      <th class="
                        w-64 px-4 py-3 align-top font-mono text-xs font-bold
                        text-ink
                      " scope="row">
                        {row.name}
                        {row.signature && <div class="
                          mt-1 font-mono text-[0.65rem] font-normal
                          text-ink-muted
                        ">{row.signature}</div>}
                      </th>
                      <td class="px-4 py-3 align-top text-sm/6 text-ink-soft">{row.description}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <div class="space-y-2">
            <h4 class="
              text-sm font-black tracking-[0.14em] text-ink-muted uppercase
            ">Example</h4>
            <div class="docs-code-compact">
              <CodeBlock code={api.code} lang="html" />
            </div>
          </div>
        </div>
      ))}
    </div>
    </section>
  </div>

</DocsLayout>

---
import { Code } from 'astro:components'

import { Badge, Card } from '@santi020k/lumen-astro'

import FrameworkSetupTabs from '../../components/FrameworkSetupTabs.astro'
import {
  frameworkPackages,
  frameworkSetups,
  glassSurfaceExamples,
  globalStyleSetups,
  runtimeFeatures
} from '../../data/docs'
import DocsLayout from '../../layouts/DocsLayout.astro'
---

<DocsLayout
  description="Install and use Lumen UI, a multi-framework primitive component system for Astro, React, and Elements."
  title="Getting started - Lumen UI"
>
  <div class="mb-10 space-y-4" id="introduction">
    <Badge>Getting started</Badge>
    <h1 class="max-w-2xl text-4xl/tight font-black text-ink">One primitive system, three framework targets.</h1>
    <p class="max-w-2xl text-lg/8 text-ink-soft">
      Lumen centers on semantic markup, one standalone stylesheet driven by design tokens, and a
      small progressive-enhancement runtime. Pick your framework below; the markup and class
      contract stay the same everywhere.
    </p>
  </div>

  <section class="space-y-4" id="installation" aria-labelledby="install-title">
    <h2 class="text-2xl font-bold text-ink" id="install-title">Install and use</h2>
    <FrameworkSetupTabs setups={frameworkSetups} />
  </section>

  <section class="mt-12 space-y-4" id="global-styles" aria-labelledby="global-styles-title">
    <div class="space-y-2">
      <h2 class="text-2xl font-bold text-ink" id="global-styles-title">Add styles once</h2>
      <p class="max-w-2xl text-sm/7 text-ink-soft">
        Lumen ships standalone CSS, so you do not need to import it in every component. Load it once
        from your global CSS file, root layout, or app entry; Tailwind configuration is optional.
      </p>
    </div>
    <div class="
      grid gap-4
      lg:grid-cols-3
    ">
      {globalStyleSetups.map(setup => (
        <Card class="space-y-3 p-5" variant="muted">
          <div class="space-y-1">
            <h3 class="text-base font-bold text-ink">{setup.label}</h3>
            <p class="text-sm/6 text-ink-soft">{setup.description}</p>
          </div>
          <Code code={setup.code} lang={setup.lang} theme="one-dark-pro" />
        </Card>
      ))}
    </div>
  </section>

  <section class="mt-12 space-y-4" id="glassmorphism" aria-labelledby="glassmorphism-title">
    <div class="space-y-2">
      <h2 class="text-2xl font-bold text-ink" id="glassmorphism-title">Glassmorphism surfaces</h2>
      <p class="max-w-2xl text-sm/7 text-ink-soft">
        Lumen includes reusable glass tokens, utility classes, component variants, and fallbacks for
        browsers without backdrop-filter support.
      </p>
    </div>
    <div class="
      grid gap-4
      xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]
    ">
      <div
        class="
          min-h-64 rounded-xl border border-line p-6
        "
        style="background: radial-gradient(circle at 20% 10%, hsl(var(--brand) / 0.28), transparent 34%), radial-gradient(circle at 85% 80%, hsl(var(--accent) / 0.24), transparent 34%), linear-gradient(135deg, hsl(var(--canvas)), hsl(var(--surface-muted)));"
      >
        <Card class="max-w-sm space-y-3 p-5" variant="glass">
          <Badge variant="outline">Glass</Badge>
          <h3 class="text-xl font-black text-ink">Translucent by design</h3>
          <p class="text-sm/7 text-ink-soft">
            Shared tokens control blur, saturation, borders, highlights, and shadow depth across
            light and dark themes.
          </p>
        </Card>
      </div>
      <div class="
        grid gap-4
        lg:grid-cols-3
      ">
        {glassSurfaceExamples.map(example => (
          <Card class="space-y-3 p-5" variant="muted">
            <div class="space-y-1">
              <h3 class="text-base font-bold text-ink">{example.label}</h3>
              <p class="text-sm/6 text-ink-soft">{example.description}</p>
            </div>
            <Code code={example.code} lang={example.lang} theme="one-dark-pro" />
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="mt-12 space-y-4" id="packages" aria-labelledby="packages-title">
    <h2 class="text-2xl font-bold text-ink" id="packages-title">Packages</h2>
    <div class="
      grid gap-4
      md:grid-cols-2
    ">
      {frameworkPackages.map(([name, packageName, status, description]) => (
        <Card class="space-y-2 p-5">
          <div class="flex items-center justify-between gap-3">
            <h3 class="text-base font-bold text-ink">{name}</h3>
            <Badge variant={status === 'Complete' ? 'success' : 'outline'}>{status}</Badge>
          </div>
          <p class="font-mono text-xs text-ink-muted">{packageName}</p>
          <p class="text-sm/6 text-ink-soft">{description}</p>
        </Card>
      ))}
    </div>
  </section>

  <section class="mt-12 space-y-4" id="runtime" aria-labelledby="runtime-title">
    <h2 class="text-2xl font-bold text-ink" id="runtime-title">Progressive-enhancement runtime</h2>
    <p class="max-w-2xl text-sm/7 text-ink-soft">
      Interactive primitives are wired up by a single UIPrimitives include. Static components do not
      need it; behavior attaches to semantic markup and data attributes when the runtime is mounted.
    </p>
    <div class="
      grid gap-4
      md:grid-cols-2
    ">
      {runtimeFeatures.map(([feature, description]) => (
        <Card class="space-y-1 p-5" variant="muted">
          <h3 class="text-sm font-bold text-ink">{feature}</h3>
          <p class="text-sm/6 text-ink-soft">{description}</p>
        </Card>
      ))}
    </div>
  </section>

  <section class="mt-12 space-y-3" aria-labelledby="next-title">
    <h2 class="text-2xl font-bold text-ink" id="next-title">Next steps</h2>
    <p class="text-sm/7 text-ink-soft">
      Every component page includes a live preview plus code for all three targets.
    </p>
    <a class="ui-button ui-button--default-size ui-button--default no-underline" href="/docs/components">Browse the component reference</a>
  </section>
</DocsLayout>

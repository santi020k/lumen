---
import { Badge, Card, Tabs } from '@santi020k/lumen-astro'
import { Code } from 'astro:components'

import { frameworkPackages, runtimeFeatures } from '../../data/docs'
import DocsLayout from '../../layouts/DocsLayout.astro'

const astroUsage = `---
import { Button, Card, Input, UIPrimitives } from '@santi020k/lumen-astro'
import '@santi020k/lumen-astro/styles.css'
---

<UIPrimitives />

<Card>
  <label for="email">Email</label>
  <Input id="email" type="email" placeholder="you@example.com" />
  <Button>Subscribe</Button>
</Card>`

const reactUsage = `import { Button, Card, Input } from '@santi020k/lumen-react'
import '@santi020k/lumen-astro/styles.css'

export const Subscribe = () => (
  <Card>
    <label htmlFor="email">Email</label>
    <Input id="email" type="email" placeholder="you@example.com" />
    <Button>Subscribe</Button>
  </Card>
)`

const elementsUsage = `<script type="module">
  import { defineLumenElements } from '@santi020k/lumen-elements/define'

  defineLumenElements()
</script>

<lumen-card>
  <label for="email">Email</label>
  <input id="email" class="ui-input" type="email" placeholder="you@example.com" />
  <lumen-button>Subscribe</lumen-button>
</lumen-card>`

const setups = [
  {
    id: 'astro',
    install: 'pnpm add @santi020k/lumen-astro',
    label: 'Astro',
    lang: 'astro' as const,
    note: 'Import components in any .astro file, add the shared stylesheet once, and mount UIPrimitives near your root layout for interactive behavior.',
    usage: astroUsage
  },
  {
    id: 'react',
    install: 'pnpm add @santi020k/lumen-react',
    label: 'React',
    lang: 'tsx' as const,
    note: 'The React package mirrors the same component API and class contract. Styles ship in the shared Lumen stylesheet.',
    usage: reactUsage
  },
  {
    id: 'elements',
    install: 'pnpm add @santi020k/lumen-elements',
    label: 'Web Components',
    lang: 'html' as const,
    note: 'Register the custom elements once with defineLumenElements(), then use lumen-* tags in any HTML page or framework.',
    usage: elementsUsage
  }
]
---

<DocsLayout
  description="Install and use Lumen UI, a multi-framework primitive component system for Astro, React, and Web Components."
  title="Getting started - Lumen UI"
>
  <div class="mb-10 space-y-4" id="introduction">
    <Badge>Getting started</Badge>
    <h1 class="max-w-2xl text-4xl/tight font-black text-ink">One primitive system, three framework targets.</h1>
    <p class="max-w-2xl text-lg/8 text-ink-soft">
      Lumen centers on semantic markup, one shared stylesheet driven by design tokens, and a small
      progressive-enhancement runtime. Pick your framework below; the markup and class contract
      stay the same everywhere.
    </p>
  </div>

  <section class="space-y-4" id="installation" aria-labelledby="install-title">
    <h2 class="text-2xl font-bold text-ink" id="install-title">Install and use</h2>
    <Tabs class="docs-code-tabs">
      <div role="tablist" aria-label="Framework setup">
        {setups.map((setup, index) => (
          <button
            aria-controls={`setup-panel-${setup.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            id={`setup-tab-${setup.id}`}
            role="tab"
          >{setup.label}</button>
        ))}
      </div>
      {setups.map((setup, index) => (
        <section
          aria-labelledby={`setup-tab-${setup.id}`}
          class="docs-code-panel space-y-4"
          hidden={index !== 0}
          id={`setup-panel-${setup.id}`}
          role="tabpanel"
        >
          <Code code={setup.install} lang="bash" theme="one-dark-pro" />
          <p class="text-sm/7 text-ink-soft">{setup.note}</p>
          <Code code={setup.usage} lang={setup.lang} theme="one-dark-pro" />
        </section>
      ))}
    </Tabs>
  </section>

  <section class="mt-12 space-y-4" id="packages" aria-labelledby="packages-title">
    <h2 class="text-2xl font-bold text-ink" id="packages-title">Packages</h2>
    <div class="
      grid gap-4
      md:grid-cols-2
    ">
      {frameworkPackages.map(([name, packageName, status, description]) => (
        <Card class="space-y-2 p-5">
          <div class="flex items-center justify-between gap-3">
            <h3 class="text-base font-bold text-ink">{name}</h3>
            <Badge variant={status === 'Complete' ? 'success' : 'outline'}>{status}</Badge>
          </div>
          <p class="font-mono text-xs text-ink-muted">{packageName}</p>
          <p class="text-sm/6 text-ink-soft">{description}</p>
        </Card>
      ))}
    </div>
  </section>

  <section class="mt-12 space-y-4" id="runtime" aria-labelledby="runtime-title">
    <h2 class="text-2xl font-bold text-ink" id="runtime-title">Progressive-enhancement runtime</h2>
    <p class="max-w-2xl text-sm/7 text-ink-soft">
      Interactive primitives are wired up by a single UIPrimitives include. No framework runtime
      is shipped; behavior attaches to semantic markup and data attributes.
    </p>
    <div class="
      grid gap-4
      md:grid-cols-2
    ">
      {runtimeFeatures.map(([feature, description]) => (
        <Card class="space-y-1 p-5" variant="muted">
          <h3 class="text-sm font-bold text-ink">{feature}</h3>
          <p class="text-sm/6 text-ink-soft">{description}</p>
        </Card>
      ))}
    </div>
  </section>

  <section class="mt-12 space-y-3" aria-labelledby="next-title">
    <h2 class="text-2xl font-bold text-ink" id="next-title">Next steps</h2>
    <p class="text-sm/7 text-ink-soft">
      Every component page includes a live preview plus code for all three targets.
    </p>
    <a class="
      ui-button ui-button--default-size ui-button--default no-underline
    " href="/docs/components">Browse the component reference</a>
  </section>
</DocsLayout>

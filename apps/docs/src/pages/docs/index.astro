---
import {
  Badge,
  ButtonLink,
  Card,
  Icon,
  Link,
  Marker
} from '@santi020k/lumen-astro'
import { lumenComponentNames } from '@santi020k/lumen-core'

import { getPlatformGuide, productPlatformGuides } from '../../data/platforms'
import DocsLayout from '../../layouts/DocsLayout.astro'

const foundations = getPlatformGuide('foundations')
const platformNumbers = ['01', '02', '03', '04']
---

<DocsLayout
  description="Choose the Lumen UI documentation for Web, React Native, Apple platforms, or Android, and explore their shared foundations."
  title="Documentation - Lumen UI"
>
  <section class="docs-gateway-hero" aria-labelledby="docs-gateway-title">
    <div>
      <Badge variant="outline">Lumen documentation</Badge>
      <h1 id="docs-gateway-title">One system.<br /><em>Native to every platform.</em></h1>
      <p>
        Start with the technology you are building for. Every implementation shares Lumen's
        semantic design language while preserving the rendering, interaction, and accessibility
        conventions of its platform.
      </p>
      <div class="docs-gateway-hero__actions">
        <ButtonLink href="#platforms" showArrow>Choose a platform</ButtonLink>
        <ButtonLink href="/docs/foundations" variant="secondary">Explore foundations</ButtonLink>
      </div>
    </div>
    <div class="docs-gateway-hero__stats" role="list" aria-label="Lumen platform coverage">
      <Card role="listitem" glass="subtle">
        <strong>4</strong>
        <span>platform surfaces</span>
      </Card>
      <Card role="listitem" glass="subtle">
        <strong>{lumenComponentNames.length}</strong>
        <span>web primitives</span>
      </Card>
      <Card role="listitem" glass="subtle">
        <strong>1</strong>
        <span>token source</span>
      </Card>
    </div>
  </section>

  <section class="docs-section" id="platforms" aria-labelledby="platforms-title">
    <div class="docs-section-heading">
      <p>Choose your environment</p>
      <h2 id="platforms-title">Platform documentation</h2>
      <p>
        Each guide uses the vocabulary and setup expected by its ecosystem. Switch platforms at
        any time from the documentation sidebar.
      </p>
    </div>
    <div class="docs-platform-grid">
      {productPlatformGuides.map((guide, index) => (
        <Link class="docs-platform-link no-underline" href={guide.href}>
          <Card as="article" class="docs-platform-card" variant="muted">
            <div class="docs-platform-card__top">
              <span>{platformNumbers[index]}</span>
              <Marker variant="success">{guide.status}</Marker>
            </div>
            <div>
              <h3>{guide.label}</h3>
              <code>{guide.packageName}</code>
            </div>
            <p>{guide.summary}</p>
            <span class="docs-platform-card__action">
              Read documentation
              <Icon decorative name="arrow-right" size="sm" />
            </span>
          </Card>
        </Link>
      ))}
    </div>
  </section>

  <Card as="section" class="docs-foundations-feature" glass="subtle" aria-labelledby="foundations-title">
    <div>
      <Badge variant="outline">{foundations.eyebrow}</Badge>
      <h2 id="foundations-title">{foundations.title}</h2>
      <p>{foundations.summary}</p>
    </div>
    <div class="docs-foundations-feature__roles" role="list" aria-label="Shared foundation roles">
      {foundations.components.slice(0, 6).map(component => (
        <span role="listitem">{component}</span>
      ))}
    </div>
    <ButtonLink href={foundations.href} showArrow variant="secondary">
      Understand the system
    </ButtonLink>
  </Card>

  <section class="docs-section" aria-labelledby="resources-title">
    <div class="docs-section-heading">
      <p>Build with confidence</p>
      <h2 id="resources-title">Shared tools and resources</h2>
    </div>
    <div class="docs-resource-grid">
      <Card variant="muted">
        <h3>Figma library</h3>
        <p>Use the same variables, component intent, and handoff vocabulary as the code packages.</p>
        <Link href="/docs/figma">Open Figma guidance <Icon decorative name="arrow-right" size="sm" /></Link>
      </Card>
      <Card variant="muted">
        <h3>AI integrations</h3>
        <p>Give coding agents direct access to Lumen's real component contracts and usage rules.</p>
        <Link href="/docs/ai-skill">Install the AI skill <Icon decorative name="arrow-right" size="sm" /></Link>
      </Card>
      <Card variant="muted">
        <h3>Release history</h3>
        <p>Follow package changes across web and native adapters from one release timeline.</p>
        <Link href="/changelog">Read the changelog <Icon decorative name="arrow-right" size="sm" /></Link>
      </Card>
    </div>
  </section>
</DocsLayout>

<script>
  const legacyWebSections = new Set([
    '#installation',
    '#framework-guides',
    '#global-styles',
    '#themes',
    '#glassmorphism',
    '#packages',
    '#runtime'
  ])

  if (window.location.pathname === '/docs' && legacyWebSections.has(window.location.hash)) {
    window.location.replace(`/docs/web${window.location.hash}`)
  }
</script>

<style>
  .docs-gateway-hero {
    display: grid;
    gap: 2.5rem;
    overflow: hidden;
    padding: clamp(1.5rem, 5vw, 4rem);
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 88% 12%, hsl(var(--brand) / 0.24), transparent 30%),
      radial-gradient(circle at 70% 80%, hsl(var(--accent) / 0.14), transparent 34%),
      linear-gradient(145deg, hsl(var(--surface)), hsl(var(--surface-muted)));
  }

  .docs-gateway-hero > div:first-child {
    display: grid;
    align-content: center;
    gap: 1.25rem;
  }

  .docs-gateway-hero h1 {
    max-width: 14ch;
    color: hsl(var(--ink));
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .docs-gateway-hero h1 em {
    color: hsl(var(--brand));
    font-style: normal;
  }

  .docs-gateway-hero > div:first-child > p {
    max-width: 46rem;
    color: hsl(var(--ink-soft));
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .docs-gateway-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .docs-gateway-hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    align-self: end;
  }

  .docs-gateway-hero__stats :global(.ui-card) {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    padding: 1rem;
  }

  .docs-gateway-hero__stats strong {
    color: hsl(var(--ink));
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 900;
  }

  .docs-gateway-hero__stats span {
    color: hsl(var(--ink-muted));
    font-size: 0.72rem;
    font-weight: 700;
  }

  .docs-platform-grid {
    display: grid;
    gap: 1rem;
  }

  .docs-platform-link {
    display: block;
    border-radius: 1.25rem;
    outline: none;
  }

  .docs-platform-link:focus-visible {
    box-shadow: 0 0 0 2px hsl(var(--brand));
  }

  .docs-platform-link :global(.docs-platform-card) {
    display: grid;
    gap: 1.25rem;
    height: 100%;
    padding: 1.4rem;
    transition: border-color 160ms ease, transform 160ms ease, background-color 160ms ease;
  }

  .docs-platform-link:hover :global(.docs-platform-card) {
    border-color: hsl(var(--brand) / 0.45);
    background: hsl(var(--surface-strong));
    transform: translateY(-2px);
  }

  .docs-platform-card__top,
  .docs-platform-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .docs-platform-card__top > span {
    color: hsl(var(--ink-muted));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .docs-platform-card h3 {
    color: hsl(var(--ink));
    font-size: 1.35rem;
    font-weight: 900;
  }

  .docs-platform-card code {
    overflow-wrap: anywhere;
    color: hsl(var(--brand));
    font-size: 0.72rem;
  }

  .docs-platform-card > p,
  .docs-resource-grid p,
  .docs-foundations-feature p {
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .docs-platform-card__action {
    justify-content: flex-start;
    margin-top: auto;
    color: hsl(var(--ink));
    font-size: 0.875rem;
    font-weight: 800;
  }

  :global(.docs-foundations-feature) {
    display: grid;
    gap: 1.5rem;
    margin-block: 3rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .docs-foundations-feature > div:first-child {
    display: grid;
    gap: 0.8rem;
  }

  .docs-foundations-feature h2 {
    color: hsl(var(--ink));
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  .docs-foundations-feature__roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .docs-foundations-feature__roles span {
    padding: 0.45rem 0.7rem;
    border: 1px solid hsl(var(--line));
    border-radius: 999px;
    background: hsl(var(--surface));
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-weight: 700;
  }

  .docs-resource-grid {
    display: grid;
    gap: 1rem;
  }

  .docs-resource-grid :global(.ui-card) {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .docs-resource-grid h3 {
    color: hsl(var(--ink));
    font-size: 1rem;
    font-weight: 850;
  }

  .docs-resource-grid :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    font-size: 0.875rem;
    font-weight: 750;
  }

  @media (min-width: 48rem) {
    .docs-platform-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .docs-resource-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .docs-gateway-hero {
      grid-template-columns: minmax(0, 1.4fr) minmax(19rem, 0.6fr);
      min-height: 34rem;
    }

    .docs-gateway-hero__stats {
      grid-template-columns: 1fr;
    }

    :global(.docs-foundations-feature) {
      grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr) auto;
      align-items: center;
    }
  }
</style>

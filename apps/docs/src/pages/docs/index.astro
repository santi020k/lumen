---
import {
  Badge,
  Card,
  Icon,
  Link,
  Marker
} from '@santi020k/lumen-astro'

import DocsActionLink from '../../components/DocsActionLink.astro'
import DocsPageHero from '../../components/DocsPageHero.astro'
import { getPlatformGuide, productPlatformGuides } from '../../data/platforms'
import { documentedComponentCount, primaryPageMetadata } from '../../data/site-metadata'
import DocsLayout from '../../layouts/DocsLayout.astro'

const foundations = getPlatformGuide('foundations')
const platformNumbers = ['01', '02', '03', '04']

const resources = [
  {
    description: 'Use the same variables, component intent, and handoff vocabulary as the code packages.',
    href: '/docs/figma',
    icon: 'figma',
    label: 'Design workflow',
    linkLabel: 'Open Figma guidance',
    title: 'Figma library'
  },
  {
    description: 'Give coding agents direct access to Lumen’s real component contracts and usage rules.',
    href: '/docs/ai-skill',
    icon: 'sparkles',
    label: 'Agent workflow',
    linkLabel: 'Install the AI skill',
    title: 'AI integrations'
  },
  {
    description: 'Follow package changes across web and native adapters from one release timeline.',
    href: '/changelog',
    icon: 'history',
    label: 'What changed',
    linkLabel: 'Read the changelog',
    title: 'Release history'
  }
] as const
---

<DocsLayout
  description={primaryPageMetadata.docs.description}
  title={primaryPageMetadata.docs.title}
>
  <div class="docs-gateway-page">
    <DocsPageHero
      description="Choose the technology you are building for. Every Lumen adapter shares one semantic design language while preserving its platform’s native rendering, interaction, and accessibility conventions."
      eyebrow="Lumen documentation"
      stats={[
        { label: 'Platforms', value: productPlatformGuides.length },
        { label: 'Adapters', value: 6 },
        { label: 'Web primitives', value: documentedComponentCount }
      ]}
      title="One system, every platform."
    >
      <Fragment slot="actions">
        <DocsActionLink href="#platforms">
          Choose a platform
          <Icon decorative name="arrow-down" size="sm" />
        </DocsActionLink>
        <DocsActionLink href="/docs/foundations" variant="outline">
          Explore foundations
          <Icon decorative name="arrow-right" size="sm" />
        </DocsActionLink>
      </Fragment>

      <div class="docs-platform-map" slot="visual" aria-label="Lumen platform architecture">
        <div class="docs-platform-map__source">
          <span><Icon decorative name="palette" size="sm" /></span>
          <div>
            <strong>Shared foundations</strong>
            <small>Tokens · roles · behavior</small>
          </div>
        </div>
        <div class="docs-platform-map__branches" aria-hidden="true"></div>
        <ul>
          {productPlatformGuides.map(guide => (
            <li>
              <span>{guide.shortLabel.slice(0, 2).toUpperCase()}</span>
              <strong>{guide.shortLabel}</strong>
              <small>{guide.status}</small>
            </li>
          ))}
        </ul>
      </div>
    </DocsPageHero>

    <section class="docs-gateway-section" id="platforms" aria-labelledby="platforms-title">
      <div class="docs-gateway-section__heading">
        <div>
          <p>Choose your environment</p>
          <h2 id="platforms-title">Start with the platform</h2>
        </div>
        <p>
          Each guide uses the vocabulary, setup, and accessibility conventions expected by its
          ecosystem. The shared foundations stay familiar when you move between them.
        </p>
      </div>
      <div class="docs-platform-grid">
        {productPlatformGuides.map((guide, index) => (
          <Link class="docs-platform-link no-underline" href={guide.href}>
            <Card as="article" class="docs-platform-card" variant="muted">
              <div class="docs-platform-card__top">
                <span>{platformNumbers[index]}</span>
                <div>
                  <Marker variant="success">{guide.status}</Marker>
                </div>
              </div>
              <div>
                <p>{guide.eyebrow}</p>
                <h3>{guide.label}</h3>
                <code>{guide.packageName}</code>
              </div>
              <p>{guide.summary}</p>
              <span class="docs-platform-card__action">
                Open {guide.shortLabel} docs
                <Icon decorative name="arrow-right" size="sm" />
              </span>
            </Card>
          </Link>
        ))}
      </div>
    </section>

    <Card
      as="section"
      class="docs-foundations-feature"
      glass="subtle"
      aria-labelledby="foundations-title"
    >
      <div class="docs-foundations-feature__copy">
        <Badge variant="outline">{foundations.eyebrow}</Badge>
        <h2 id="foundations-title">One foundation beneath every adapter</h2>
        <p>{foundations.summary}</p>
        <DocsActionLink href={foundations.href} variant="outline">
          Understand the system
          <Icon decorative name="arrow-right" size="sm" />
        </DocsActionLink>
      </div>
      <div class="docs-foundations-feature__system">
        <span class="docs-foundations-feature__label">Canonical vocabulary</span>
        <div class="docs-foundations-feature__roles" role="list" aria-label="Shared foundation roles">
          {foundations.components.slice(0, 6).map(component => (
            <span role="listitem">{component}</span>
          ))}
        </div>
        <p>One token source, translated into platform-native values and components.</p>
      </div>
    </Card>

    <section class="docs-gateway-section" aria-labelledby="resources-title">
      <div class="docs-gateway-section__heading">
        <div>
          <p>Build with confidence</p>
          <h2 id="resources-title">Keep design and code in sync</h2>
        </div>
        <p>
          Move from design to implementation with the same public vocabulary, then keep up with
          the system as its packages evolve.
        </p>
      </div>
      <div class="docs-resource-grid">
        {resources.map(resource => (
          <Card as="article" class="docs-resource-card" variant="muted">
            <div class="docs-resource-card__icon">
              <Icon decorative name={resource.icon} size="sm" />
            </div>
            <span>{resource.label}</span>
            <h3>{resource.title}</h3>
            <p>{resource.description}</p>
            <Link href={resource.href}>
              {resource.linkLabel} <Icon decorative name="arrow-right" size="sm" />
            </Link>
          </Card>
        ))}
      </div>
    </section>
  </div>
</DocsLayout>

<script>
  const legacyWebSections = new Set([
    '#installation',
    '#framework-guides',
    '#global-styles',
    '#themes',
    '#glassmorphism',
    '#packages',
    '#runtime'
  ])

  if (window.location.pathname === '/docs' && legacyWebSections.has(window.location.hash)) {
    window.location.replace(`/docs/web${window.location.hash}`)
  }
</script>

<style>
  .docs-gateway-page,
  .docs-gateway-section {
    display: grid;
  }

  .docs-gateway-page {
    gap: 3.5rem;
  }

  .docs-gateway-section {
    gap: 1.4rem;
    scroll-margin-top: 10rem;
  }

  .docs-platform-map {
    display: grid;
    gap: 0.55rem;
    padding: 0.8rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.1rem;
    background: hsl(var(--canvas) / 0.62);
    backdrop-filter: blur(14px);
  }

  .docs-platform-map__source,
  .docs-platform-map li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.72rem 0.8rem;
    border-radius: 0.75rem;
  }

  .docs-platform-map__source {
    grid-template-columns: auto minmax(0, 1fr);
    background: hsl(var(--brand-soft) / 0.88);
  }

  .docs-platform-map__source > span,
  .docs-resource-card__icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 0.65rem;
    background: hsl(var(--surface));
    color: hsl(var(--brand));
  }

  .docs-platform-map__source > div {
    display: grid;
    gap: 0.15rem;
  }

  .docs-platform-map__source strong,
  .docs-platform-map li strong {
    color: hsl(var(--ink));
    font-size: 0.78rem;
  }

  .docs-platform-map__source small,
  .docs-platform-map li small {
    color: hsl(var(--ink-muted));
    font-size: 0.65rem;
  }

  .docs-platform-map__branches {
    width: 1px;
    height: 0.7rem;
    margin-inline: 1.8rem;
    background: hsl(var(--brand) / 0.55);
  }

  .docs-platform-map ul {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-platform-map li {
    background: hsl(var(--surface) / 0.82);
  }

  .docs-platform-map li > span {
    width: 2rem;
    color: hsl(var(--brand));
    font: 800 0.62rem/1 var(--font-mono);
  }

  .docs-gateway-section__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.85fr);
    gap: 2rem;
    align-items: end;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  .docs-gateway-section__heading > div > p,
  .docs-resource-card > span,
  .docs-foundations-feature__label {
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .docs-gateway-section__heading h2,
  .docs-foundations-feature h2 {
    margin-top: 0.25rem;
    color: hsl(var(--ink));
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  .docs-gateway-section__heading > p,
  .docs-foundations-feature p {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .docs-platform-grid,
  .docs-resource-grid {
    display: grid;
    gap: 1rem;
  }

  .docs-platform-link {
    display: block;
    border-radius: 1.25rem;
    outline: none;
  }

  .docs-platform-link:focus-visible {
    box-shadow: 0 0 0 2px hsl(var(--brand));
  }

  .docs-platform-link :global(.docs-platform-card) {
    display: grid;
    gap: 1.25rem;
    height: 100%;
    min-height: 18rem;
    padding: 1.5rem;
    transition: border-color 160ms ease, transform 160ms ease, background-color 160ms ease;
  }

  .docs-platform-link:hover :global(.docs-platform-card) {
    border-color: hsl(var(--brand) / 0.45);
    background: hsl(var(--surface-strong));
    transform: translateY(-2px);
  }

  .docs-platform-card__top,
  .docs-platform-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .docs-platform-card__top > span {
    color: hsl(var(--ink-muted));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .docs-platform-card__top > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .docs-platform-card h3 {
    margin-top: 0.25rem;
    color: hsl(var(--ink));
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.025em;
  }

  .docs-platform-card > div:nth-child(2) > p {
    color: hsl(var(--brand));
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .docs-platform-card code {
    overflow-wrap: anywhere;
    color: hsl(var(--brand));
    font-size: 0.72rem;
  }

  .docs-platform-card > p,
  .docs-resource-grid p {
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .docs-platform-card__action {
    justify-content: flex-start;
    margin-top: auto;
    color: hsl(var(--ink));
    font-size: 0.875rem;
    font-weight: 800;
  }

  :global(.docs-foundations-feature) {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .docs-foundations-feature__copy,
  .docs-foundations-feature__system {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
  }

  .docs-foundations-feature__system {
    padding: 1.25rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1rem;
    background: hsl(var(--canvas) / 0.62);
  }

  .docs-foundations-feature__roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .docs-foundations-feature__roles span {
    padding: 0.45rem 0.7rem;
    border: 1px solid hsl(var(--line));
    border-radius: 999px;
    background: hsl(var(--surface) / 0.88);
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-weight: 700;
  }

  :global(.docs-resource-card) {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.7rem;
    min-height: 17rem;
    padding: 1.4rem;
  }

  .docs-resource-grid h3 {
    color: hsl(var(--ink));
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .docs-resource-grid :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    margin-top: auto;
    font-size: 0.875rem;
    font-weight: 750;
  }

  @media (min-width: 48rem) {
    .docs-platform-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .docs-resource-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    :global(.docs-foundations-feature) {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.9fr);
      align-items: center;
    }
  }

  @media (max-width: 47.99rem) {
    .docs-gateway-section__heading {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>

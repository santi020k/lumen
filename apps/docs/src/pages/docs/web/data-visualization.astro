---
import { Badge, BulletChart, Heatmap, Histogram, Icon, LineChart, Link, PieChart, Sparkline, Stat, Tabs, TabsList, TabsPanel, TabsTrigger, WaterfallChart } from '@santi020k/lumen-astro'

import DocsLayout from '../../../layouts/DocsLayout.astro'
import { chartDemoBins, chartDemoBulletRanges, chartDemoChannels, chartDemoHeatmap, chartDemoMetrics, chartDemoSeries, chartDemoWaterfall } from '../../../lib/chart-demo-data'
---

<DocsLayout title="Interactive data visualization — Lumen UI" description="Inspect shared chart behavior, honest time spacing, distributions, balance changes, and missing observations across the three web adapters." breadcrumbs={[{ href: '/docs/web', label: 'Web' }, { href: '/docs/web/data-visualization', label: 'Data visualization' }]}>
  <div class="viz-gallery">
    <section class="viz-intro">
      <p class="viz-eyebrow"><span aria-hidden="true"></span>Lumen / Data visualization</p>
      <h1>Data, in its<br /><em>best light.</em></h1>
      <div class="viz-intro-bottom">
        <p>Find the pattern. Follow the detail. Beautiful, accessible charts that make every observation count.</p>
        <Link href="/docs/components/line-chart">Explore the API <Icon name="arrow-up-right" decorative size="sm" /></Link>
      </div>
    </section>

    <section class="viz-workspace" aria-label="Interactive visualization gallery">
      <header class="viz-workspace-heading">
        <div><p class="viz-eyebrow">The overview</p><h2>A clearer picture.</h2></div>
        <Badge variant="outline">Illustrative dataset</Badge>
      </header>
      <div class="viz-metrics">
        {chartDemoMetrics.map((metric, index) => (
          <Stat variant="bare" label={metric.label} value={metric.value}>
            <p>Observed, 09:00–12:00</p>
            <Sparkline values={metric.values} tone={index === 0 ? 'series-1' : 'series-2'} area label={`${metric.label} trend`} />
          </Stat>
        ))}
        <Stat variant="bare" label="Response samples" value={String(chartDemoBins.reduce((sum, bin) => sum + bin.count, 0))}>
          <p>12 intervals · 0–300 ms</p>
          <Sparkline values={chartDemoBins.map(bin => bin.count)} tone="series-3" area label="Response-time distribution" />
        </Stat>
      </div>
      <Tabs class="viz-frameworks" initialValue="astro">
        <div class="viz-toolbar">
          <TabsList aria-label="Chart framework">
            <TabsTrigger value="astro">Astro</TabsTrigger>
            <TabsTrigger value="react">React</TabsTrigger>
            <TabsTrigger value="elements">Web Components</TabsTrigger>
          </TabsList>
          <span>One system. Three renderers.</span>
        </div>
        <TabsPanel value="astro">
          <section class="viz-chart-grid" data-chart-demo="astro" aria-label="Astro charts">
            <LineChart class="viz-main-chart" aria-label="Astro request volume" heading="Request volume" description="Requests and completions · 09:00–12:00" series={chartDemoSeries} xScale="linear" area markers="none" interactive syncGroup="visualization-demo" annotations={[{ id: 'target', label: 'Capacity target', value: 160 }]} />
            <BulletChart aria-label="Astro delivery performance" heading="On-time delivery" description="Actual performance against the service target" value={86} target={95} ranges={chartDemoBulletRanges} formatValue={value => `${value}%`} />
            <WaterfallChart aria-label="Astro balance changes" heading="Revenue movement" description="Opening balance to closing · USD, thousands" data={chartDemoWaterfall} valueLabel="USD, thousands" />
            <Histogram aria-label="Astro response times" heading="Response time" description="Distribution of requests · milliseconds" bins={chartDemoBins} tone="series-3" />
            <PieChart aria-label="Astro traffic sources" heading="Traffic sources" description="Share of acquisition by channel" series={chartDemoChannels} centerValue="48%" centerLabel="Organic" />
            <Heatmap aria-label="Astro daily difference" heading="Activity patterns" description="Difference from baseline · every two hours" data={chartDemoHeatmap} colorScale="diverging" />
          </section>
        </TabsPanel>
        <TabsPanel value="react">
          <section data-chart-demo="react" aria-label="React charts"><div data-react-chart-demo><p>Loading the React example…</p></div></section>
        </TabsPanel>
        <TabsPanel value="elements">
          <section class="viz-chart-grid" data-chart-demo="elements" aria-label="Web Component charts">
            <lumen-line-chart class="viz-main-chart" aria-label="Elements request volume" heading="Request volume" description="Requests and completions · 09:00–12:00" series={JSON.stringify(chartDemoSeries)} x-scale="linear" area markers="none" interactive sync-group="visualization-demo" annotations={JSON.stringify([{ id: 'target', label: 'Capacity target', value: 160 }])}></lumen-line-chart>
            <lumen-bullet-chart aria-label="Elements delivery performance" heading="On-time delivery" description="Actual performance against the service target · percent" value="86" target="95" ranges={JSON.stringify(chartDemoBulletRanges)}></lumen-bullet-chart>
            <lumen-waterfall-chart aria-label="Elements balance changes" heading="Revenue movement" description="Opening balance to closing · USD, thousands" value-label="USD, thousands" data={JSON.stringify(chartDemoWaterfall)}></lumen-waterfall-chart>
            <lumen-histogram aria-label="Elements response times" heading="Response time" description="Distribution of requests · milliseconds" tone="series-3" bins={JSON.stringify(chartDemoBins)}></lumen-histogram>
            <lumen-pie-chart aria-label="Elements traffic sources" heading="Traffic sources" description="Share of acquisition by channel" series={JSON.stringify([chartDemoChannels])} center-value="48%" center-label="Organic"></lumen-pie-chart>
            <lumen-heatmap aria-label="Elements daily difference" heading="Activity patterns" description="Difference from baseline · every two hours" data={JSON.stringify(chartDemoHeatmap)} color-scale="diverging"></lumen-heatmap>
          </section>
        </TabsPanel>
      </Tabs>
      <div class="viz-instructions"><Icon name="mouse-pointer-2" decorative size="sm" /><p>Hover or tap to explore. Use arrow keys to inspect, Escape to clear, and the legend to compare. Switch frameworks to keep exploring the same observation.</p></div>
    </section>

    <footer class="viz-footer"><p>Designed to reveal more.</p><span>Semantic colors · Keyboard accessible · Exact source data</span><Link href="/docs/components">Explore the component library <Icon name="arrow-up-right" decorative size="sm" /></Link></footer>
  </div>
</DocsLayout>

<script>
  import { createElement } from 'react'
import { createRoot, type Root } from 'react-dom/client'

import { defineLumenElements } from '@santi020k/lumen-elements'

import { ReactChartDemo } from '../../../lib/react-chart-demo'

  let root: Root | undefined

  const mount = () => {
    const container = document.querySelector<HTMLElement>('[data-react-chart-demo]')

    if (!container || container.dataset.mounted) return

    container.dataset.mounted = 'true'

    defineLumenElements(['BulletChart', 'LineChart', 'WaterfallChart', 'Histogram', 'Heatmap', 'PieChart'])

    root = createRoot(container)

    root.render(createElement(ReactChartDemo))
  }

  mount()

  document.addEventListener('astro:page-load', mount)

  document.addEventListener('astro:before-swap', () => {
    root?.unmount()

    root = undefined
  })
</script>

<style>
  .viz-gallery { display: grid; gap: 2.5rem; }
  .viz-intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: 1rem 2rem; padding-block: 1rem 0; align-items: end; }
  .viz-intro > .viz-eyebrow { grid-column: 1 / -1; margin-bottom: 0; }
  .viz-eyebrow { display: flex; align-items: center; gap: 0.625rem; margin: 0 0 1.25rem; color: hsl(var(--ink-soft)); font-size: 0.625rem; font-weight: 650; letter-spacing: 0.16em; text-transform: uppercase; }
  .viz-eyebrow > span { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: hsl(var(--brand)); box-shadow: 0 0 0 4px hsl(var(--brand) / 0.1); }
  .viz-intro h1 { margin: 0; font-size: clamp(2.5rem, 4.5vw, 4rem); font-weight: 650; letter-spacing: -0.065em; line-height: 1.04; }
  .viz-intro em { color: hsl(var(--brand)); font-style: normal; }
  .viz-intro-bottom { display: flex; flex-direction: column; align-items: start; gap: 0.875rem; }
  .viz-intro-bottom p { max-width: 31rem; margin: 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; }
  .viz-intro-bottom :global(a) { flex-shrink: 0; display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; }
  .viz-workspace { display: grid; gap: 1.5rem; min-width: 0; }
  .viz-workspace-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .viz-workspace-heading .viz-eyebrow { margin-bottom: 0.375rem; }
  .viz-workspace-heading h2 { margin: 0; font-size: 1.375rem; font-weight: 600; letter-spacing: -0.04em; }
  .viz-workspace-heading :global(.ui-badge) { width: auto; font-size: 0.625rem; }
  .viz-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid hsl(var(--line)); padding-block: 1.5rem; }
  .viz-metrics :global(.ui-stat) { position: relative; min-width: 0; padding: 0 1.25rem; border-inline-start: 1px solid hsl(var(--line)); }
  .viz-metrics :global(.ui-stat:first-child) { padding-inline-start: 0; border: 0; }
  .viz-metrics :global(.ui-stat-label) { font-size: 0.6875rem; font-weight: 550; color: hsl(var(--ink-soft)); }
  .viz-metrics :global(.ui-stat-value) { margin-block: 0.5rem; font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 600; letter-spacing: -0.055em; line-height: 1; }
  .viz-metrics p { margin: 0; font-size: 0.625rem; color: hsl(var(--ink-soft)); }
  .viz-metrics :global(.ui-sparkline) { position: absolute; inset-inline-end: 1.25rem; top: 1.25rem; width: 4rem; height: 2rem; }
  .viz-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .viz-toolbar > span { color: hsl(var(--ink-soft)); font-size: 0.625rem; }
  .viz-toolbar :global([role="tablist"]) { margin: 0; }
  .viz-toolbar :global([role="tab"]) { font-size: 0.6875rem; }
  .viz-frameworks :global([role="tabpanel"]) { margin-top: 1.25rem; padding: 0; border: 0; outline-offset: 0.375rem; }
  .viz-gallery :global(.viz-chart-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; align-items: start; }
  .viz-gallery :global(.viz-main-chart) { grid-column: 1 / -1; }
  .viz-gallery :global(.viz-main-chart .ui-chart__plot) { margin-top: -0.5rem; }
  .viz-instructions { display: flex; gap: 0.625rem; align-items: start; color: hsl(var(--ink-soft)); }
  .viz-instructions :global(svg) { flex-shrink: 0; margin-top: 0.1rem; }
  .viz-instructions p { margin: 0; font-size: 0.6875rem; line-height: 1.8; }
  .viz-footer { display: grid; gap: 0.75rem; border-top: 1px solid hsl(var(--line)); padding-block: 2rem; }
  .viz-footer p { margin: 0; font-size: 1.5rem; font-weight: 600; letter-spacing: -0.04em; }
  .viz-footer span { color: hsl(var(--ink-soft)); font-size: 0.75rem; }
  .viz-footer :global(a) { display: flex; align-items: center; gap: 0.5rem; width: fit-content; margin-top: 0.75rem; font-size: 0.75rem; }
  @media (max-width: 640px) {
    .viz-gallery { gap: 2.5rem; }
    .viz-intro { grid-template-columns: 1fr; }
    .viz-intro-bottom { align-items: start; flex-direction: column; gap: 1rem; }
    .viz-gallery :global(.viz-chart-grid) { grid-template-columns: minmax(0, 1fr); }
    .viz-metrics { grid-template-columns: 1fr; padding-block: 0; }
    .viz-metrics :global(.ui-stat), .viz-metrics :global(.ui-stat:first-child) { padding: 1rem 0; border: 0; }
    .viz-metrics :global(.ui-stat + .ui-stat) { border-top: 1px solid hsl(var(--line)); }
    .viz-metrics :global(.ui-sparkline) { width: 6rem; height: 2.5rem; top: 2rem; inset-inline-end: 0; }
    .viz-toolbar > span { display: none; }
  }
</style>

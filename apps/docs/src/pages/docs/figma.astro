---
import { Badge, Card } from '@santi020k/lumen-astro'

import DocsLayout from '../../layouts/DocsLayout.astro'

const figmaLibraryUrl = 'https://www.figma.com/design/luQW2pTQ3jGGxSFPAAsfa9'
const figmaFileKey = 'luQW2pTQ3jGGxSFPAAsfa9'

const figmaDetails = [
  [
    'Variables',
    'Color includes 15 semantic tokens with Light and Dark modes. Radius includes sm, md, and lg values.'
  ],
  [
    'Library pages',
    'Cover, Foundations, and Components keep the design file easy to scan during handoff.'
  ],
  [
    'Component variants',
    'Button, Badge, Input, Field, Card, Alert, Checkbox, Switch, Tabs, and Avatar mirror code props where possible.'
  ],
  [
    'Code workflow',
    'Use the file as the source for Figma variables, component review, and future Code Connect mappings.'
  ]
] as const
---

<DocsLayout
  description="Open the Lumen Figma library and learn how variables, pages, and component variants map back to code."
  title="Figma library - Lumen UI"
>
  <nav class="mb-6 text-sm text-ink-soft" aria-label="Breadcrumb">
    <a class="
      text-ink-soft no-underline
      hover:text-ink
    " href="/docs">Docs</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page" class="font-bold text-ink">Figma library</span>
  </nav>

  <section class="docs-section" aria-labelledby="figma-title">
    <div class="docs-section-heading">
      <p>Design handoff</p>
      <h1 class="
        text-4xl/tight font-black text-ink
        sm:text-5xl/tight
      " id="figma-title">
        Figma library
      </h1>
      <p>
        Lumen has a Figma library for semantic variables and component review. The library follows
        the same token contract as the code, so handoff can stay centered on names like
        <code>brand</code>, <code>surface</code>, <code>line</code>, and <code>ink</code> instead
        of copied hex values.
      </p>
    </div>
    <div class="
      grid gap-4
      lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]
    ">
      <Card class="docs-example-card" variant="muted">
        <Badge>Library file</Badge>
        <h2 class="text-base font-bold text-ink">Lumen UI Library</h2>
        <p class="text-sm/6 text-ink-soft">
          Open the shared Figma file when you need token references, component variants, or a
          design-to-code handoff surface.
        </p>
        <p class="font-mono text-xs text-ink-muted">File key: {figmaFileKey}</p>
        <div class="flex flex-wrap gap-3">
          <a class="
            ui-button ui-button--default-size ui-button--default no-underline
          " href={figmaLibraryUrl} target="_blank" rel="noopener noreferrer">Open in Figma</a>
          <a class="
            ui-button ui-button--default-size ui-button--outline no-underline
          " href="https://github.com/santi020k/lumen/blob/main/docs/figma.md" target="_blank" rel="noopener noreferrer">Read Figma notes</a>
        </div>
      </Card>
      <div class="
        grid gap-3
        sm:grid-cols-2
      ">
        {figmaDetails.map(([title, description]) => (
          <Card class="docs-example-card" variant="muted">
            <h2 class="text-sm font-bold text-ink">{title}</h2>
            <p class="text-sm/6 text-ink-soft">{description}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>
</DocsLayout>

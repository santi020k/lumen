---
import { Badge, Card, CodeTabs, Icon } from '@santi020k/lumen-astro'

import DocsActionLink from '../../components/DocsActionLink.astro'
import DocsPageHero from '../../components/DocsPageHero.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const figmaCommunityUrl = 'https://www.figma.com/community/file/1662337342676541513'
const figmaFileKey = 'luQW2pTQ3jGGxSFPAAsfa9'
const pluginSetup = 'pnpm install --frozen-lockfile\npnpm exec turbo run build --filter=@santi020k/lumen-figma-plugin'

const figmaDetails = [
  [
    'Variables',
    'Semantic colors, radius, and effects connect component appearance to shared design decisions.',
    'swatch-book'
  ],
  [
    'Library pages',
    'Cover, Foundations, and Components keep the design file easy to scan during handoff.',
    'layout-template'
  ],
  [
    'Component variants',
    'Core variants mirror code props where possible, so review language remains consistent.',
    'component'
  ],
  [
    'Code workflow',
    'Use Code Connect mappings and the plugin to bring Lumen components into an Astro handoff.',
    'code-xml'
  ]
] as const

const workflow = [
  ['01', 'Start with semantics', 'Choose canvas, surface, ink, brand, and state tokens before reaching for raw color values.'],
  ['02', 'Compose with variants', 'Use library components and their variants to keep behavior and naming close to production.'],
  ['03', 'Hand off by contract', 'Reference component names, props, and semantic tokens—the same vocabulary engineers use in code.']
] as const
---

<DocsLayout
  description="Open the Lumen Figma library and learn how variables, pages, and component variants map back to code."
  title="Figma library - Lumen UI"
>
  <div class="figma-page">
    <DocsPageHero
      description="Design and implementation share one semantic language. Explore variables, component variants, and handoff patterns that map directly to Lumen code."
      eyebrow="Design handoff"
      stats={[
        { label: 'Plugin version', value: '1.0.0' },
        { label: 'Mapped components', value: 21 },
        { label: 'Plugin target', value: 'Astro v4 / v5' }
      ]}
      title="One system from canvas to code."
    >
      <Fragment slot="actions">
        <DocsActionLink
          href="#plugin"
          variant="outline"
        >Explore the plugin
        </DocsActionLink>
        <DocsActionLink
          href={figmaCommunityUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Get the Figma library
          <Icon decorative name="arrow-up-right" size="sm" />
        </DocsActionLink>
        <DocsActionLink
          href="https://github.com/santi020k/lumen/blob/main/docs/figma.md"
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
        >Read Figma notes
        </DocsActionLink>
      </Fragment>

      <div class="figma-token-stack" slot="visual" aria-label="Semantic token preview">
        <div>
          <span style="--token-color: hsl(var(--brand));"></span>
          <p><strong>brand</strong><small>Primary interaction</small></p>
        </div>
        <div>
          <span style="--token-color: hsl(var(--surface));"></span>
          <p><strong>surface</strong><small>Raised content</small></p>
        </div>
        <div>
          <span style="--token-color: hsl(var(--success));"></span>
          <p><strong>success</strong><small>Positive state</small></p>
        </div>
      </div>
    </DocsPageHero>

    <Card as="section" class="figma-plugin-card" aria-labelledby="plugin-title" id="plugin">
      <div class="figma-plugin-card__title">
        <span id="plugin-beta" aria-hidden="true"></span>
        <h2 id="plugin-title">Lumen for Figma</h2>
        <Badge variant="outline">Local build</Badge>
      </div>
      <p>
        Select a design built with Lumen, inspect its components, and take an Astro starter into
        your project. The AI handoff gives your coding agent the selected structure, component
        properties, semantic color references, and items that need review.
      </p>
      <p>
        The plugin recognizes 21 components by their canonical library keys, including form controls,
        CodeTabs, Prose, Timeline and RevealGroup. Detached components and custom layers appear in the review findings.
      </p>
      <p>
        Choose the version of <code>@santi020k/lumen-astro</code> installed in your project.
        Version 5.0.0 uses per-component imports and loads your chosen appearance, including Paper and Field.
        Version 4.4.0 uses the full stylesheet. Copy the matching runtime setup from <strong>Astro layout</strong>.
      </p>
      <CodeTabs
        ariaLabel="Build the Figma plugin"
        items={[{ value: 'setup', label: 'Build the development plugin', language: 'bash', code: pluginSetup }]}
      />
      <p>
        In Figma desktop, choose <strong>Plugins → Development → Import plugin from manifest</strong>{' '}
        and select <code>apps/figma-plugin/dist/manifest.json</code>. Run these build commands from
        the Lumen repository root. The plugin is not yet published to Figma Community; the separate
        Community link on this page opens the design library.
      </p>
      <p>
        Select one frame or component instance, choose <strong>Inspect selection</strong>, and
        review the findings. Copy or save the <strong>Astro starter</strong> or <strong>AI handoff</strong> for your project.
        Exports include the selected design's visible
        text and component data, so review them before sharing with your coding agent.
      </p>
      <p>
        Community publication follows the Lumen v5 package and documentation release. An install
        link will appear here after Figma approval and verified public installation.
      </p>
      <DocsActionLink
        href="https://github.com/santi020k/lumen/blob/main/apps/figma-plugin/README.md"
        rel="noopener noreferrer"
        target="_blank"
        variant="outline"
      >Setup and component coverage<Icon decorative name="arrow-up-right" size="sm" /></DocsActionLink>
    </Card>

    <section class="figma-section" aria-labelledby="library-title">
      <div class="figma-section__heading">
        <div>
          <p>Inside the file</p>
          <h2 id="library-title">Built for useful handoff</h2>
        </div>
        <p>
          The library is intentionally compact: foundations establish the contract, components
          demonstrate it, and the codebase remains the source of truth for behavior.
        </p>
      </div>

      <div class="figma-details">
        {figmaDetails.map(([title, description, icon]) => (
          <Card class="figma-detail-card" variant="muted">
            <span class="figma-detail-card__icon">
              <Icon decorative name={icon} />
            </span>
            <h3>{title}</h3>
            <p>{description}</p>
          </Card>
        ))}
      </div>
    </section>

    <section class="figma-section" aria-labelledby="workflow-title">
      <div class="figma-section__heading">
        <div>
          <p>Recommended flow</p>
          <h2 id="workflow-title">Design with the contract</h2>
        </div>
        <p>
          A short loop keeps visual decisions traceable from the first frame through production.
        </p>
      </div>

      <ol class="figma-workflow">
        {workflow.map(([step, title, description]) => (
          <li>
            <span>{step}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="figma-section" aria-labelledby="working-files-title">
      <div class="figma-section__heading">
        <div>
          <p>Design files</p>
          <h2 id="working-files-title">Work with Lumen 5 in Figma</h2>
        </div>
        <p>Use the library for components and themes, Templates for editable layouts, and Playgrounds for platform examples. Working files follow their Figma sharing settings.</p>
      </div>
      <div class="figma-plugin-card__title">
        <DocsActionLink href={`https://www.figma.com/design/${figmaFileKey}`} rel="noopener noreferrer" target="_blank" variant="outline">Open UI Library</DocsActionLink>
        <DocsActionLink href="https://www.figma.com/design/DX5clPFAvKTjrSe4wyfMe3" rel="noopener noreferrer" target="_blank" variant="outline">Open Templates</DocsActionLink>
        <DocsActionLink href="https://www.figma.com/design/G0NjJ4eAci1013PaLmseXI" rel="noopener noreferrer" target="_blank" variant="outline">Open Playgrounds</DocsActionLink>
      </div>
    </section>

    <Card as="section" class="figma-file-card" aria-labelledby="file-title" glass="subtle">
      <div>
        <Badge>Figma Community</Badge>
        <h2 id="file-title">Lumen UI Library</h2>
        <p>
          Add the published library to your Figma workflow for token references, component
          variants, and design-to-code review.
        </p>
      </div>
      <code>File key: {figmaFileKey}</code>
      <DocsActionLink
        href={figmaCommunityUrl}
        target="_blank"
        rel="noopener noreferrer"
      >View in Community
      </DocsActionLink>
    </Card>
  </div>
</DocsLayout>

<style>
  .figma-plugin-card {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    scroll-margin-top: 8rem;
  }

  .figma-plugin-card__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .figma-plugin-card h2 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .figma-plugin-card p {
    color: hsl(var(--ink-soft));
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .figma-plugin-card > :global(.ui-button) { width: fit-content; }

  .figma-page {
    display: grid;
    gap: 3.5rem;
  }

  .figma-token-stack {
    display: grid;
    gap: 0.55rem;
    padding: 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.1rem;
    background: hsl(var(--canvas) / 0.62);
    backdrop-filter: blur(14px);
  }

  .figma-token-stack > div {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem;
    border-radius: 0.75rem;
    background: hsl(var(--surface) / 0.75);
  }

  .figma-token-stack span {
    width: 2.4rem;
    height: 2.4rem;
    flex: 0 0 auto;
    border: 1px solid hsl(var(--line));
    border-radius: 0.65rem;
    background: var(--token-color);
    box-shadow: inset 0 1px 0 hsl(0 0% 100% / 0.24);
  }

  .figma-token-stack p {
    display: grid;
    margin: 0;
  }

  .figma-token-stack strong {
    color: hsl(var(--ink));
    font: 800 0.78rem/1.3 ui-monospace, monospace;
  }

  .figma-token-stack small {
    color: hsl(var(--ink-muted));
    font-size: 0.7rem;
  }

  .figma-section {
    display: grid;
    gap: 1.4rem;
  }

  .figma-section__heading {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  .figma-section__heading > div > p {
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .figma-section__heading h2,
  .figma-file-card h2 {
    margin-top: 0.25rem;
    color: hsl(var(--ink));
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.025em;
  }

  .figma-section__heading > p,
  .figma-file-card p {
    max-width: 36rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .figma-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.85rem;
  }

  .figma-detail-card {
    display: flex;
    min-height: 13rem;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.15rem;
  }

  .figma-detail-card__icon {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border-radius: 0.7rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }

  .figma-detail-card h3,
  .figma-workflow h3 {
    color: hsl(var(--ink));
    font-size: 0.95rem;
    font-weight: 800;
  }

  .figma-detail-card p,
  .figma-workflow p {
    color: hsl(var(--ink-soft));
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .figma-workflow {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .figma-workflow li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid hsl(var(--line));
  }

  .figma-workflow li > span {
    color: hsl(var(--brand));
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .figma-workflow li div {
    display: grid;
    gap: 0.35rem;
  }

  .figma-file-card {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .figma-file-card > div {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .figma-file-card code {
    overflow: hidden;
    color: hsl(var(--ink-muted));
    font-size: 0.72rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .figma-file-card > :global(.ui-button) {
    width: max-content;
  }

  @media (min-width: 48rem) {
    .figma-section__heading {
      grid-template-columns: minmax(13rem, 0.8fr) minmax(18rem, 1fr);
      align-items: end;
    }

    .figma-file-card {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .figma-file-card > :global(.ui-button) {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>

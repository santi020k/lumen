---
import '../../styles/global.css'

import {
  Badge,
  Card,
  UIPrimitives
} from '@santi020k/lumen-astro'

import { componentCategories, componentDocs, docNavigation } from '../../data/docs'

const importsExample = [
  '---',
  'import {',
  '  Button,',
  '  Card,',
  '  Dialog,',
  '  Field,',
  '  Input,',
  '  Label,',
  '  UIPrimitives',
  "} from '@santi020k/lumen-astro'",
  "import '@santi020k/lumen-astro/styles.css'",
  '---'
].join('\n')
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Usage examples for every Lumen Astro component exported by @santi020k/lumen-astro."
    />
    <title>Components - Lumen UI</title>
  </head>
  <body>
    <UIPrimitives />
    <main data-docs="shell">
      <nav data-docs="nav" aria-label="Documentation">
        <a data-docs="brand" href="/">Lumen UI</a>
        <div data-docs="nav-links">
          <a href="/docs">Getting started</a>
          <a href="/docs/components">Components</a>
        </div>
      </nav>

      <div data-docs="layout">
        <aside data-docs="sidebar" aria-label="Documentation">
          <p>Documentation</p>
          {docNavigation.map(([label, href]) => <a href={href}>{label}</a>)}
          <p>Component groups</p>
          {componentCategories.map(category => (
            <a href={`#${category.toLowerCase().replaceAll(' ', '-')}`}>{category}</a>
          ))}
        </aside>

        <div data-docs="content">
          <section data-docs="hero compact">
            <Badge>Astro reference</Badge>
            <h1>Component examples for the complete Astro catalog.</h1>
            <p>
              The reference shows the composition style Lumen expects: import only what a page uses,
              keep semantic HTML visible, and pass standard attributes directly to primitives.
            </p>
          </section>

          <section data-docs="band" aria-labelledby="imports">
            <div data-docs="section-heading">
              <p>Imports</p>
              <h2 id="imports">Start from the package barrel</h2>
              <span>
                Every Astro primitive is exported from <code>@santi020k/lumen-astro</code>. Add the
                stylesheet once in a shared layout or global entry.
              </span>
            </div>
            <Card data-docs="card command-card">
              <pre><code>{importsExample}</code></pre>
            </Card>
          </section>

          <section data-docs="band" aria-labelledby="categories">
            <div data-docs="section-heading">
              <p>Browse</p>
              <h2 id="categories">Component groups</h2>
              <span>
                Lumen groups primitives by the job they do in an application interface.
              </span>
            </div>
            <div data-docs="category-grid">
              {componentCategories.map(category => (
                <a href={`#${category.toLowerCase().replaceAll(' ', '-')}`}>
                  <strong>{category}</strong>
                  <span>{componentDocs.filter(component => component.category === category).length} components</span>
                </a>
              ))}
            </div>
          </section>

          {componentCategories.map(category => (
            <section data-docs="band" aria-labelledby={category.toLowerCase().replaceAll(' ', '-')}>
              <div data-docs="section-heading">
                <p>{category}</p>
                <h2 id={category.toLowerCase().replaceAll(' ', '-')}>
                  {componentDocs.filter(component => component.category === category).length} components
                </h2>
                <span>
                  Copy an example as a starting point, then add your app-specific content, attributes,
                  event hooks, and validation.
                </span>
              </div>
              <div data-docs="component-grid">
                {componentDocs
                  .filter(component => component.category === category)
                  .map(component => (
                    <Card data-docs="component-card">
                      <div data-docs="card-header">
                        <h3>{component.name}</h3>
                        <Badge variant="outline">{component.category}</Badge>
                      </div>
                      <p>{component.summary}</p>
                      <pre><code>{component.example}</code></pre>
                    </Card>
                  ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>

---
import {
  Badge,
  Button,
  Card,
  Icon,
  Input,
  Kbd,
  Label,
  Link,
  Progress,
  Select,
  Switch,
  Tabs
} from '@santi020k/lumen-astro'

import {
  componentCategories,
  componentCollections,
  componentDocs
} from '../../../data/docs'
import DocsLayout from '../../../layouts/DocsLayout.astro'
import { toSlug } from '../../../lib/routes'

const categoryDescriptions: Record<string, string> = {
  Actions: 'Buttons, toggles, and controls that help people take action.',
  Brand: 'Expressive primitives for bringing the Lumen identity into a product.',
  'Data display': 'Present structured information, media, metrics, and content.',
  Feedback: 'Communicate status, progress, loading, and important outcomes.',
  Forms: 'Collect, validate, and refine user input.',
  Layout: 'Compose content, manage space, and build responsive structure.',
  Navigation: 'Help people move through pages, views, and collections.',
  Overlays: 'Layer focused tasks and contextual information above the interface.'
}

const componentGroups = componentCategories.map(category => ({
  category,
  components: componentDocs
    .filter(component => component.category === category)
    .sort((left, right) => left.name.localeCompare(right.name))
}))

const categoryId = (category: string) => toSlug(category).replaceAll(' ', '-')
const glassCount = componentDocs.filter(component => component.glass).length
---

<DocsLayout
  description="Browse all Lumen UI components with live previews and usage examples for Astro, React, and Elements."
  title="Components - Lumen UI"
>
  <div class="components-page">
    <header class="components-hero">
      <div class="components-hero__copy">
        <Badge variant="outline">Component library</Badge>
        <h1>Find the right primitive.</h1>
        <p>
          Browse accessible building blocks for Astro, React, and Web Components.
          Every primitive includes a live preview, usage examples, and a complete API reference.
        </p>
      </div>

      <dl class="components-stats" aria-label="Component library totals">
        <div>
          <dt>Primitives</dt>
          <dd>{componentDocs.length}</dd>
        </div>
        <div>
          <dt>Categories</dt>
          <dd>{componentCategories.length}</dd>
        </div>
        <div>
          <dt>Glass surfaces</dt>
          <dd>{glassCount}</dd>
        </div>
      </dl>
    </header>

    <section class="components-live" aria-labelledby="components-live-title">
      <div class="components-live__heading">
        <div>
          <p>Rendered with Lumen</p>
          <h2 id="components-live-title">See the components in action</h2>
        </div>
        <p>
          These are real components, not screenshots. Try the controls here, then open any
          component to resize its preview, compare frameworks, and edit it in the browser.
        </p>
      </div>

      <div class="components-live__grid">
        <Card as="article" class="components-live-card">
          <div
            class="
              components-live-card__preview
              components-live-card__preview--actions
            "
          >
            <Button>Continue</Button>
            <Button variant="outline">Preview</Button>
          </div>
          <div class="components-live-card__meta">
            <div><small>Actions</small><h3>Button</h3></div>
            <Link href="/docs/components/button">Open playground</Link>
          </div>
        </Card>

        <Card as="article" class="components-live-card">
          <div class="components-live-card__preview">
            <Label for="components-live-email">Email address</Label>
            <Input
              id="components-live-email"
              name="components-live-email"
              placeholder="you@example.com"
              type="email"
            />
          </div>
          <div class="components-live-card__meta">
            <div><small>Forms</small><h3>Input</h3></div>
            <Link href="/docs/components/input">Open playground</Link>
          </div>
        </Card>

        <Card as="article" class="components-live-card">
          <div class="components-live-card__preview">
            <Card class="components-live-card__sample" variant="muted">
              <Badge variant="success">Active</Badge>
              <strong>Team workspace</strong>
              <span>Everything your team needs to ship.</span>
            </Card>
          </div>
          <div class="components-live-card__meta">
            <div><small>Layout</small><h3>Card</h3></div>
            <Link href="/docs/components/card">Open playground</Link>
          </div>
        </Card>

        <Card as="article" class="components-live-card">
          <div
            class="
              components-live-card__preview
              components-live-card__preview--badges
            "
          >
            <Badge>New</Badge>
            <Badge variant="success">Ready</Badge>
            <Badge variant="warning">Review</Badge>
            <Badge variant="outline">Draft</Badge>
          </div>
          <div class="components-live-card__meta">
            <div><small>Data display</small><h3>Badge</h3></div>
            <Link href="/docs/components/badge">Open playground</Link>
          </div>
        </Card>

        <Card as="article" class="components-live-card">
          <div class="components-live-card__preview">
            <Label class="components-live-switch" for="components-live-notifications">
              <span><strong>Notifications</strong><small>Product updates and mentions</small></span>
              <Switch checked id="components-live-notifications" name="components-live-notifications" />
            </Label>
          </div>
          <div class="components-live-card__meta">
            <div><small>Forms</small><h3>Switch</h3></div>
            <Link href="/docs/components/switch">Open playground</Link>
          </div>
        </Card>

        <Card as="article" class="components-live-card">
          <div
            class="
              components-live-card__preview
              components-live-card__preview--progress
            "
          >
            <div><strong>Documentation</strong><span>72%</span></div>
            <Progress aria-label="Documentation progress" value={72} />
          </div>
          <div class="components-live-card__meta">
            <div><small>Feedback</small><h3>Progress</h3></div>
            <Link href="/docs/components/progress">Open playground</Link>
          </div>
        </Card>

        <Card as="article" class="components-live-card">
          <div class="components-live-card__preview">
            <Tabs initialValue="preview">
              <div role="tablist" aria-label="Live component view">
                <button
                  aria-controls="components-live-preview-panel"
                  aria-selected="true"
                  id="components-live-preview-tab"
                  role="tab"
                >Preview</button>
                <button
                  aria-controls="components-live-code-panel"
                  aria-selected="false"
                  id="components-live-code-tab"
                  role="tab"
                >Code</button>
              </div>
              <div
                aria-labelledby="components-live-preview-tab"
                id="components-live-preview-panel"
                role="tabpanel"
              >A shared visual contract.</div>
              <div
                aria-labelledby="components-live-code-tab"
                hidden
                id="components-live-code-panel"
                role="tabpanel"
              >Astro, React, and Elements.</div>
            </Tabs>
          </div>
          <div class="components-live-card__meta">
            <div><small>Navigation</small><h3>Tabs</h3></div>
            <Link href="/docs/components/tabs">Open playground</Link>
          </div>
        </Card>

        <Card as="article" class="components-live-card">
          <div class="components-live-card__preview">
            <Label for="components-live-framework">Framework</Label>
            <Select id="components-live-framework" name="components-live-framework" placeholder="Choose one">
              <option value="astro">Astro</option>
              <option value="react">React</option>
              <option value="elements">Web Components</option>
            </Select>
          </div>
          <div class="components-live-card__meta">
            <div><small>Forms</small><h3>Select</h3></div>
            <Link href="/docs/components/select">Open playground</Link>
          </div>
        </Card>
      </div>
    </section>

    <section class="components-patterns" aria-labelledby="component-patterns-title">
      <div class="components-patterns__heading">
        <div>
          <p>Compare before choosing</p>
          <h2 id="component-patterns-title">Browse by pattern</h2>
        </div>
        <p>
          Similar primitives are grouped by the job they solve, so the differences are easier to
          understand before you open an API reference.
        </p>
      </div>
      <div class="components-patterns__grid">
        {componentCollections.map(collection => (
          <Card class="components-pattern-card">
            <h3>{collection.title}</h3>
            <p>{collection.description}</p>
            <div aria-label={`${collection.title} components`}>
              {collection.names.map(name => (
                <Link href={`/docs/components/${toSlug(name)}`}>{name}</Link>
              ))}
            </div>
          </Card>
        ))}
      </div>
    </section>

    <div class="components-explorer">
      <div class="components-filter">
        <Label for="component-filter">Search the component library</Label>
        <div class="components-filter__control">
          <Icon decorative name="search" size="sm" />
          <Input
            autocomplete="off"
            id="component-filter"
            placeholder="Search by name, category, or use case..."
            type="search"
            data-component-filter
          />
          <Kbd>/</Kbd>
        </div>
        <p id="component-filter-status" aria-live="polite">
          Showing all {componentDocs.length} components
        </p>
      </div>

      <nav class="components-categories" aria-label="Component categories">
        {componentGroups.map(({ category, components }) => (
          <Link href={`#${categoryId(category)}`}>
            <span>{category}</span>
            <span>{components.length}</span>
          </Link>
        ))}
      </nav>
    </div>

    <div class="components-catalog" data-component-catalog>
      {componentGroups.map(({ category, components }) => (
        <section
          aria-labelledby={`${categoryId(category)}-title`}
          data-component-section
          id={categoryId(category)}
        >
          <div class="components-section__heading">
            <div>
              <p>{components.length} components</p>
              <h2 id={`${categoryId(category)}-title`}>{category}</h2>
            </div>
            <p>{categoryDescriptions[category]}</p>
          </div>

          <div class="components-grid">
            {components.map(component => (
              <Link
                aria-label={`${component.name}: ${component.summary}`}
                data-component-card
                data-component-search={`${component.name} ${category} ${component.summary} ${component.guidance?.when ?? ''} ${component.guidance?.distinction ?? ''}`.toLowerCase()}
                href={`/docs/components/${toSlug(component.name)}`}
              >
                <Card class="components-card" variant="interactive">
                  <div class="components-card__top">
                    <h3>{component.name}</h3>
                    {component.glass && <Badge variant="outline">Glass</Badge>}
                  </div>
                  <p>{component.summary}</p>
                  <span class="components-card__link">
                    View usage
                    <Icon decorative name="arrow-right" size="sm" />
                  </span>
                </Card>
              </Link>
            ))}
          </div>
        </section>
      ))}

      <div class="components-empty" data-component-empty hidden>
        <Icon decorative name="search-x" size="lg" />
        <h2>No components found</h2>
        <p>Try a component name, category, or a broader use case.</p>
      </div>
    </div>
  </div>
</DocsLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-component-filter]')
  const catalog = document.querySelector<HTMLElement>('[data-component-catalog]')
  const status = document.querySelector<HTMLElement>('#component-filter-status')
  const empty = document.querySelector<HTMLElement>('[data-component-empty]')

  const filterSection = (section: HTMLElement, query: string): number => {
    let sectionCount = 0

    for (const card of section.querySelectorAll<HTMLElement>('[data-component-card]')) {
      const matches = !query || card.dataset.componentSearch?.includes(query)

      card.hidden = !matches

      if (matches) sectionCount += 1
    }

    section.hidden = sectionCount === 0

    return sectionCount
  }

  const getFilterStatus = (query: string, visibleCount: number): string => {
    if (!query) return `Showing all ${visibleCount} components`

    return `${visibleCount} component${visibleCount === 1 ? '' : 's'} found`
  }

  const filterComponents = () => {
    if (!input || !catalog || !status || !empty) return

    const query = input.value.trim().toLowerCase()
    let visibleCount = 0

    for (const section of catalog.querySelectorAll<HTMLElement>('[data-component-section]')) {
      visibleCount += filterSection(section, query)
    }

    empty.hidden = visibleCount !== 0

    status.textContent = getFilterStatus(query, visibleCount)
  }

  input?.addEventListener('input', filterComponents)

  document.addEventListener('keydown', event => {
    if (
      event.key === '/' &&
      document.activeElement?.tagName !== 'INPUT' &&
      document.activeElement?.tagName !== 'TEXTAREA'
    ) {
      event.preventDefault()

      input?.focus()
    }
  })
</script>

<style>
  .components-page {
    display: grid;
    gap: 3rem;
  }

  .components-hero {
    display: grid;
    gap: 2rem;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 88% 8%, hsl(var(--brand) / 0.18), transparent 34%),
      linear-gradient(145deg, hsl(var(--surface)), hsl(var(--surface-muted)));
  }

  .components-hero__copy {
    max-width: 44rem;
  }

  .components-hero h1 {
    max-width: 12ch;
    margin-top: 1rem;
    color: hsl(var(--ink));
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .components-hero__copy > p {
    max-width: 42rem;
    margin-top: 1.25rem;
    color: hsl(var(--ink-soft));
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .components-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    align-self: end;
    margin: 0;
  }

  .components-stats div {
    padding: 1rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1rem;
    background: hsl(var(--canvas) / 0.72);
    backdrop-filter: blur(12px);
  }

  .components-stats dt {
    color: hsl(var(--ink-muted));
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .components-stats dd {
    margin-top: 0.35rem;
    color: hsl(var(--ink));
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .components-explorer {
    display: grid;
    gap: 1.5rem;
  }

  .components-live {
    display: grid;
    gap: 1.25rem;
  }

  .components-live__heading {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  .components-live__heading > div > p {
    margin-bottom: 0.25rem;
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .components-live__heading h2 {
    color: hsl(var(--ink));
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .components-live__heading > p {
    max-width: 42rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .components-live__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.85rem;
  }

  .components-live-card {
    display: grid;
    min-height: 18rem;
    grid-template-rows: minmax(11rem, 1fr) auto;
    gap: 0;
    overflow: hidden;
    padding: 0;
  }

  .components-live-card__preview {
    display: grid;
    align-content: center;
    gap: 0.65rem;
    min-width: 0;
    padding: 1.35rem;
    background:
      radial-gradient(circle at 15% 0%, hsl(var(--brand) / 0.12), transparent 44%),
      linear-gradient(145deg, hsl(var(--surface)), hsl(var(--surface-muted) / 0.72));
  }

  .components-live-card__preview--actions,
  .components-live-card__preview--badges {
    display: flex;
    align-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .components-live-card__preview--progress > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: hsl(var(--ink));
    font-size: 0.82rem;
  }

  .components-live-card__sample {
    display: grid;
    gap: 0.45rem;
    padding: 1rem;
  }

  .components-live-card__sample :global(.ui-badge) {
    width: fit-content;
  }

  .components-live-card__sample strong {
    color: hsl(var(--ink));
    font-size: 0.9rem;
  }

  .components-live-card__sample > span {
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .components-live-switch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .components-live-switch > span {
    display: grid;
    gap: 0.2rem;
  }

  .components-live-switch small {
    color: hsl(var(--ink-muted));
    font-size: 0.7rem;
    font-weight: 500;
  }

  .components-live-card__meta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-top: 1px solid hsl(var(--line));
  }

  .components-live-card__meta > div {
    display: grid;
    gap: 0.15rem;
  }

  .components-live-card__meta small {
    color: hsl(var(--ink-muted));
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .components-live-card__meta h3 {
    color: hsl(var(--ink));
    font-size: 1rem;
    font-weight: 900;
  }

  .components-live-card__meta a {
    font-size: 0.72rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .components-patterns {
    display: grid;
    gap: 1.25rem;
  }

  .components-patterns__heading {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  .components-patterns__heading > div > p {
    margin-bottom: 0.25rem;
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .components-patterns__heading h2 {
    color: hsl(var(--ink));
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .components-patterns__heading > p {
    max-width: 38rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .components-patterns__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 0.85rem;
  }

  .components-pattern-card {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    min-height: 12rem;
    padding: 1.15rem;
  }

  .components-pattern-card h3 {
    color: hsl(var(--ink));
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .components-pattern-card > p {
    color: hsl(var(--ink-soft));
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .components-pattern-card > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.35rem;
  }

  .components-pattern-card a {
    padding: 0.3rem 0.5rem;
    border: 1px solid hsl(var(--line));
    border-radius: 999px;
    background: hsl(var(--surface-muted) / 0.72);
    color: hsl(var(--ink-soft));
    font-size: 0.68rem;
    font-weight: 800;
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .components-pattern-card a:hover {
    border-color: hsl(var(--brand) / 0.55);
    color: hsl(var(--brand));
  }

  .components-filter {
    display: grid;
    gap: 0.55rem;
    max-width: 46rem;
  }

  .components-filter label {
    color: hsl(var(--ink));
    font-size: 0.8rem;
    font-weight: 800;
  }

  .components-filter__control {
    position: relative;
    display: flex;
    align-items: center;
  }

  .components-filter__control > :global(.ui-icon) {
    position: absolute;
    z-index: 1;
    left: 1rem;
    color: hsl(var(--ink-muted));
    pointer-events: none;
  }

  .components-filter__control > :global(.ui-input) {
    height: 3.25rem;
    padding-right: 3.25rem;
    padding-left: 2.75rem;
    border-radius: 0.9rem;
    font-size: 1rem;
  }

  .components-filter__control kbd {
    position: absolute;
    right: 0.9rem;
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border: 1px solid hsl(var(--line));
    border-radius: 0.4rem;
    background: hsl(var(--surface-muted));
    color: hsl(var(--ink-muted));
    font: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    pointer-events: none;
  }

  .components-filter > p {
    color: hsl(var(--ink-muted));
    font-size: 0.8rem;
  }

  .components-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .components-categories a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 999px;
    background: hsl(var(--surface));
    color: hsl(var(--ink-soft));
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .components-categories a:hover {
    border-color: hsl(var(--brand));
    color: hsl(var(--ink));
    transform: translateY(-1px);
  }

  .components-categories a span:last-child {
    display: grid;
    min-width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    border-radius: 999px;
    background: hsl(var(--surface-muted));
    color: hsl(var(--ink-muted));
    font-size: 0.68rem;
  }

  .components-catalog {
    display: grid;
    gap: 3.5rem;
  }

  .components-catalog section {
    scroll-margin-top: 6rem;
  }

  .components-section__heading {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  .components-section__heading > div > p {
    margin-bottom: 0.25rem;
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .components-section__heading h2 {
    color: hsl(var(--ink));
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.025em;
  }

  .components-section__heading > p {
    max-width: 34rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    line-height: 1.6;
  }


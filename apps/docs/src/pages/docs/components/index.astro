---
import { Badge, Card } from '@santi020k/lumen-astro'

import { componentCategories, componentDocs } from '../../../data/docs'
import DocsLayout from '../../../layouts/DocsLayout.astro'
import { toSlug } from '../../../lib/routes'
---

<DocsLayout
  description="Browse all Lumen UI components with live previews and usage examples for Astro, React, and Elements."
  title="Components - Lumen UI"
>
  <div class="docs-components-hero mb-10 space-y-3">
    <div class="flex flex-wrap gap-2">
      <Badge>{componentDocs.length} primitives</Badge>
      <Badge variant="outline">{componentDocs.filter(component => component.glass).length} glass surfaces</Badge>
    </div>
    <h1 class="text-4xl font-black text-ink">Components</h1>
    <p class="max-w-2xl text-lg/8 text-ink-soft">
      {componentDocs.length} primitives, each documented with a live preview and code for
      Astro, React, and Elements. Glass-capable surfaces use the same tokenized blur,
      highlight, and border treatment across targets.
    </p>
  </div>

  {componentCategories.map(category => (
    <section class="mb-10 space-y-4" aria-label={category}>
      <h2 class="text-sm font-black tracking-[0.14em] text-ink-muted uppercase">{category}</h2>
      <div class="
        grid gap-4
        md:grid-cols-2
        xl:grid-cols-3
      ">
        {componentDocs.filter(component => component.category === category).map(component => (
          <a class="no-underline" href={`/docs/components/${toSlug(component.name)}`}>
            <Card class="h-full space-y-2 p-5" variant="interactive">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-base font-bold text-ink">{component.name}</h3>
                <div class="flex flex-wrap justify-end gap-2">
                  <Badge variant="outline">{category}</Badge>
                  {component.glass && <Badge variant="outline">Glass</Badge>}
                </div>
              </div>
              <p class="text-sm/6 text-ink-soft">{component.summary}</p>
            </Card>
          </a>
        ))}
      </div>
    </section>
  ))}
</DocsLayout>

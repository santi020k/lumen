---
import type { InferGetStaticPropsType } from 'astro'

import {
  Badge,
  Breadcrumb,
  Icon,
  Link,
  Note,
  Pagination,
  Separator,
  Tabs
} from '@santi020k/lumen-astro'

import ChartUsageDetails from '../../../components/ChartUsageDetails.astro'
import CodeBlock from '../../../components/CodeBlock.astro'
import CommunityFeedback from '../../../components/CommunityFeedback.astro'
import DeviceFrameUsage from '../../../components/DeviceFrameUsage.astro'
import DocsActionLink from '../../../components/DocsActionLink.astro'
import DocsReferenceTable from '../../../components/DocsReferenceTable.astro'
import FrameworkExample from '../../../components/FrameworkExample.astro'
import { chartGuides, getChartGuide } from '../../../data/chart-guides'
import { deviceFrameQuickStart } from '../../../data/device-frame'
import {
  componentCollections,
  componentDocs,
  frameworkSetups,
  getFigmaComponentUrl
} from '../../../data/docs'
import DocsLayout from '../../../layouts/DocsLayout.astro'
import { getExample, getGlassExample } from '../../../lib/examples'
import { toSlug } from '../../../lib/routes'
import { buildSnippets } from '../../../lib/snippets'

export const getStaticPaths = () => componentDocs.map(component => ({
  params: { slug: toSlug(component.name) },
  props: { component }
}))

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { component } = Astro.props
const { component: Example, source } = getExample(component.name)
const componentSlug = toSlug(component.name)
const chartGuide = getChartGuide(component.name)
const solidMapExample = component.name === 'WorldMap' ? getExample('WorldMapSolid') : undefined
const SolidMapExample = solidMapExample?.component
const solidMapSnippets = solidMapExample ? buildSnippets('WorldMapSolid', solidMapExample.source) : undefined
const snippets = buildSnippets(component.name, component.name === 'DeviceFrame' ? deviceFrameQuickStart : source)
const registryCommand = `lumen add ${component.name}`

const packageInstallSetups = frameworkSetups.map(setup => ({
  addCommand: setup.id === 'astro' ?
    registryCommand :
    `${registryCommand} --target ${setup.id}`,
  command: setup.installCommands.find(install => install.label === 'pnpm')?.command ?? setup.installCommands[0]?.command ?? '',
  id: setup.id,
  label: setup.label,
  packageName: setup.packageName
}))

const glassExample = component.glass ? getGlassExample(component.name) : undefined
const GlassExample = glassExample?.component
const glassSnippets = glassExample ? buildSnippets(component.name, glassExample.source) : undefined
const paginationComponents = chartGuide ? chartGuides : componentDocs
const index = paginationComponents.findIndex(entry => entry.name === component.name)
const previous = index > 0 ? paginationComponents[index - 1] : undefined

const next = index >= 0 && index < paginationComponents.length - 1 ?
  paginationComponents[index + 1] :
  undefined

const requiresAstroRuntime = Boolean(
  component.keyboardInteractions ??
  component.runtimeEvents ??
  component.apiReference.some(row => /UIPrimitives|runtime/i.test(row.description))
)

const relatedCollection = componentCollections.find(collection => collection.names.includes(component.name))

const relatedComponents = relatedCollection?.names
  .filter(name => name !== component.name)
  .map(name => componentDocs.find(entry => entry.name === name))
  .filter(entry => entry !== undefined) ??
  []

const figmaUrl = component.figmaNodeId ?
  getFigmaComponentUrl(component.figmaNodeId) :
  '/docs/figma'

const componentNameParts = component.name.split(/(?<=[a-z])(?=[A-Z])/)
const isImage = component.name === 'Image'

const astroImageOptimizationExample = `---
import { Image } from '@santi020k/lumen-astro'
import hero from '../assets/hero.jpg'
---

<Image
  alt="Mountain valley at sunrise"
  layout="full-width"
  priority
  quality={80}
  src={hero}
/>`

const nextImageOptimizationExample = `import NextImage from 'next/image'
import { Image as LumenImage } from '@santi020k/lumen-react'
import hero from './hero.jpg'

export function HeroImage() {
  return (
    <LumenImage
      alt="Mountain valley at sunrise"
      as={NextImage}
      placeholder="blur"
      preload
      sizes="(max-width: 768px) 100vw, 50vw"
      src={hero}
      style={{ height: 'auto', width: '100%' }}
    />
  )
}`
---

<DocsLayout
  pageNavigation={chartGuide ?
[
    { id: 'preview-title', label: 'Live example & code' },
    { id: 'chart-reading-title', label: 'When to use it' },
    { id: 'chart-data-title', label: 'Data shape' },
    { id: 'chart-pitfalls-title', label: 'Reading accurately' },
    { id: 'install-title', label: 'Installation' },
    { id: 'api-title', label: 'API reference' },
    ...(component.keyboardInteractions ? [{ id: 'keyboard-title', label: 'Keyboard access' }] : []),
    ...(component.runtimeEvents ? [{ id: 'runtime-events-title', label: 'Events' }] : [])
  ] :
undefined}
  breadcrumbs={[
    { href: '/', label: 'Home' },
    { href: '/docs', label: 'Docs' },
    { href: '/docs/components', label: 'Components' },
    { href: `/docs/components/${componentSlug}`, label: component.name }
  ]}
  description={chartGuide ? `${chartGuide.description} Live examples, data shapes, and code for Astro, React, and Web Components.` : `${component.name}: ${component.summary} Usage examples for Astro, React, and Elements.`}
  title={`${component.name} - Lumen UI`}
>
  <div class="component-doc-page">
    <Breadcrumb class="docs-breadcrumb">
      <ol>
        <li><a href="/docs">Docs</a></li>
        <li><a href="/docs/components">Components</a></li>
        <li><span aria-current="page">{component.name}</span></li>
      </ol>
    </Breadcrumb>

    <header class:list={['component-doc-hero', { 'component-doc-hero--chart': chartGuide }]}>
      <div class="component-doc-hero__copy">
        <div class="component-doc-hero__badges">
          <Badge variant="secondary">{component.category}</Badge>
          {component.glass && <Badge variant="outline">Glass surface</Badge>}
        </div>
        <h1 data-long-title={component.name.length >= 12 ? 'true' : undefined}>
          {componentNameParts.map((part, index) => (
            <Fragment>{index > 0 && <wbr />}{part}</Fragment>
          ))}
        </h1>
        <p>{component.summary}</p>
        <div class="component-doc-hero__actions">
          <DocsActionLink href="#preview-title">
            View preview
          </DocsActionLink>
          <DocsActionLink href="#api-title" variant="outline">
            API reference
          </DocsActionLink>
          <DocsActionLink
            href={figmaUrl}
            rel="noopener noreferrer"
            target="_blank"
            variant="outline"
          >
            <Icon decorative name="swatch-book" size="sm" />
            {component.figmaNodeId ? 'View in Figma' : 'Figma behavior note'}
          </DocsActionLink>
        </div>
      </div>
      <div class="component-doc-hero__meta" aria-label={`${component.name} support`}>
        <div>
          <span><Icon decorative name="layers-3" size="sm" /></span>
          <p><small>Frameworks</small><strong>Astro · React · Elements</strong></p>
        </div>
        <div>
          <span><Icon decorative name="package" size="sm" /></span>
          <p><small>Registry command</small><code>{registryCommand}</code></p>
        </div>
        <div>
          <span><Icon decorative name="shield-check" size="sm" /></span>
          <p><small>Interaction</small><strong>{requiresAstroRuntime ? 'Enhanced runtime' : 'Native markup'}</strong></p>
        </div>
        <div>
          <span><Icon decorative name="swatch-book" size="sm" /></span>
          <p>
            <small>Design source</small>
            {component.figmaNodeId ?
              <Link href={figmaUrl} rel="noopener noreferrer" target="_blank">Linked component node</Link> :
              <Link href={figmaUrl}>Behavior-only contract</Link>}
          </p>
        </div>
      </div>
    </header>

    {component.name === 'WorldMap' && <p>Explore <Link href="/docs/web/world-map">navigation guidance</Link> and <Link href="/docs/web/world-map/destinations">regional destination examples</Link>.</p>}
    {component.guidance && !chartGuide && (
      <aside class="component-doc-guidance" aria-label={`${component.name} usage guidance`}>
        <div>
          <span><Icon decorative name="check-circle-2" size="sm" /></span>
          <p><small>Use it when</small>{component.guidance.when}</p>
        </div>
        {component.guidance.distinction && (
          <div>
            <span><Icon decorative name="split" size="sm" /></span>
            <p><small>How it differs</small>{component.guidance.distinction}</p>
          </div>
        )}
      </aside>
    )}

    {chartGuide && (
      <p class="text-sm text-ink-soft"><Link href="/docs/web/data-visualization">← All chart guides</Link> · <Link href="/docs/web/data-visualization/setup">Framework setup</Link> · <Link href="/docs/web/data-visualization/native">Native counterparts</Link></p>
    )}

    {relatedCollection && !chartGuide && relatedComponents.length > 0 && (
      <aside class="component-doc-related" aria-labelledby="related-components-title">
        <div>
          <small>Compare the pattern</small>
          <h2 id="related-components-title">{relatedCollection.title}</h2>
          <p>{relatedCollection.description}</p>
        </div>
        <nav aria-label={`Components related to ${component.name}`}>
          {relatedComponents.map(related => (
            <Link href={`/docs/components/${toSlug(related.name)}`}>
              <span>{related.name}</span>
              <small>{related.summary}</small>
            </Link>
          ))}
        </nav>
      </aside>
    )}

    <section class="component-doc-section space-y-3" aria-labelledby="preview-title">
      <div class="component-doc-heading">
        <span>01</span>
        <div>
          <p>See it and copy it</p>
          <h2 id="preview-title">Framework example</h2>
        </div>
      </div>
      <p class="max-w-2xl text-sm/7 text-ink-soft">
        {chartGuide ?
          'Explore the live chart, then open its code for Astro, React, or Elements.' :
          'Choose Astro, React, or Elements to compare native usage against the shared visual output. Each example assumes the framework-level setup is already complete.'}
      </p>
      {component.name === 'WorldMap' && <h3>Dotted destinations</h3>}
      <FrameworkExample
        componentName={component.name}
        codeCollapsed={Boolean(chartGuide) || component.name === 'DeviceFrame'}
        groupId={`code-${componentSlug}`}
        snippets={snippets}
      >
        <Example />
      </FrameworkExample>
      {component.name === 'DeviceFrame' && <DeviceFrameUsage />}
      {SolidMapExample && solidMapSnippets && (
        <>
          <h3>Solid regions</h3>
          <p>Use Lumen accent colors and country labels to match your product.</p>
          <FrameworkExample componentName="WorldMap" examplePath="apps/docs/src/examples/WorldMapSolid.astro" groupId="code-world-map-solid" snippets={solidMapSnippets}>
            <SolidMapExample />
          </FrameworkExample>
        </>
      )}
      {component.adapterNotes && (
        <Note label="Framework differences">
          {component.adapterNotes.map(note => (
            <p>
              <Link href={`/docs/frameworks/${note.framework.toLowerCase()}`}>{note.framework}</Link>
              {`: ${note.text}`}
            </p>
          ))}
        </Note>
      )}
    </section>

    {chartGuide && <ChartUsageDetails guide={chartGuide} />}

    {isImage && (
      <section class="component-doc-section space-y-5" aria-labelledby="image-optimization-title">
        <div class="component-doc-heading">
          <span>02</span>
          <div>
            <p>Keep the host framework in control</p>
            <h2 id="image-optimization-title">Astro and Next.js optimization</h2>
          </div>
        </div>
        <p class="max-w-3xl text-sm/7 text-ink-soft">
          Lumen owns the final image styling, including <code>ui-image</code> and optional dark-mode
          inversion. It does not run a second image pipeline. The Astro adapter delegates to
          <code>astro:assets</code>; the React adapter renders the optimizer supplied through
          <code>as</code> and forwards its props.
        </p>

        <div class="
          grid gap-6
          xl:grid-cols-2
        "
        >
          <article class="
            space-y-4 rounded-2xl border border-line bg-surface p-5
          "
          >
            <div class="space-y-2">
              <h3 class="font-black text-ink">Astro: import local assets</h3>
              <p class="text-sm/7 text-ink-soft">
                A static import supplies intrinsic dimensions and enables build-time processing.
                Choose <code>layout="full-width"</code> for viewport-width media,
                <code>"constrained"</code> for fluid media with a maximum width, or
                <code>"fixed"</code> for a fixed-size asset. Astro generates the responsive
                <code>srcset</code>, <code>sizes</code>, and layout styles.
              </p>
            </div>
            <CodeBlock code={astroImageOptimizationExample} lang="astro" title="HeroImage.astro" />
            <ul class="list-disc space-y-2 pl-5 text-sm/7 text-ink-soft">
              <li>
                Use <code>priority</code> only for the likely LCP image. Astro applies eager
                loading, high fetch priority, and synchronous decoding.
              </li>
              <li>
                Public-directory and remote string sources need known dimensions. Use
                <code>inferSize</code> for an authorized remote source when its dimensions are not
                available, and configure remote image domains in the Astro app.
              </li>
              <li>
                Override <code>widths</code>, <code>sizes</code>, <code>quality</code>, or
                <code>format</code> only when the layout or delivery target calls for it.
              </li>
            </ul>
            <Link
              class="text-sm"
              href="https://docs.astro.build/en/reference/modules/astro-assets/"
              rel="noopener noreferrer"
              target="_blank"
            >Astro Image reference
            </Link>
          </article>

          <article class="
            space-y-4 rounded-2xl border border-line bg-surface p-5
          "
          >
            <div class="space-y-2">
              <h3 class="font-black text-ink">Next.js: pass next/image through as</h3>
              <p class="text-sm/7 text-ink-soft">
                Passing <code>NextImage</code> keeps Next.js in charge of resizing, format
                negotiation, caching, placeholders, and preloading. With an optimizer supplied,
                Lumen does not inject its native <code>loading="lazy"</code> default.
              </p>
            </div>
            <CodeBlock code={nextImageOptimizationExample} lang="tsx" title="HeroImage.tsx" />
            <ul class="list-disc space-y-2 pl-5 text-sm/7 text-ink-soft">
              <li>
                Static imports provide dimensions and can provide blur data automatically. String
                or remote sources need <code>width</code> and <code>height</code>, unless
                <code>fill</code> is used.
              </li>
              <li>
                Add an accurate <code>sizes</code> value for responsive or <code>fill</code>
                images; without it the browser can select an unnecessarily large candidate.
              </li>
              <li>
                In Next.js 16+, use <code>preload</code> for the one clear LCP image; do not combine
                it with <code>loading</code> or <code>fetchPriority</code>. Leave below-the-fold
                images on Next.js defaults.
              </li>
              <li>
                Allow remote sources with narrow <code>images.remotePatterns</code> entries in
                <code>next.config</code>. For <code>fill</code>, give the parent a positioned box
                and a real size.
              </li>
            </ul>
            <Link
              class="text-sm"
              href="https://nextjs.org/docs/app/api-reference/components/image"
              rel="noopener noreferrer"
              target="_blank"
            >Next.js Image reference
            </Link>
          </article>
        </div>

        <aside class="
          rounded-2xl border border-line bg-surface-muted p-5 text-sm/7
          text-ink-soft
        "
        >
          <strong class="text-ink">For both frameworks:</strong> write useful alt text (or
          <code>alt=""</code> for decoration), preserve intrinsic aspect ratio, keep
          <code>sizes</code> aligned with the rendered layout, and reserve eager or priority
          loading for the page’s likely LCP image. Use <code>invertOnDark</code> only for
          monochrome artwork, not photographs.
        </aside>
      </section>
    )}

    <section class="component-doc-section space-y-3" aria-labelledby="install-title">
      <div class="component-doc-heading">
        <span>{isImage ? '03' : '02'}</span>
        <div>
          <p>Choose your target</p>
          <h2 id="install-title">Add this component</h2>
        </div>
      </div>
      <p class="max-w-2xl text-sm/7 text-ink-soft">
        Choose the package for your runtime. All adapters share the Lumen stylesheet. Use the
        matching registry command when you want a local wrapper for that framework.
      </p>
      <Tabs>
        <div role="tablist" aria-label="Package install">
          {packageInstallSetups.map((setup, index) => (
            <button
              aria-controls={`install-${componentSlug}-panel-${setup.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              id={`install-${componentSlug}-tab-${setup.id}`}
              role="tab"
            >{setup.label}
            </button>
          ))}
        </div>
        {packageInstallSetups.map((setup, index) => (
          <section
            aria-labelledby={`install-${componentSlug}-tab-${setup.id}`}
            class="docs-code-panel"
            hidden={index !== 0}
            id={`install-${componentSlug}-panel-${setup.id}`}
            role="tabpanel"
          >
            <div class="
              grid gap-4
              lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.8fr)]
            "
            >
              <CodeBlock code={setup.command} lang="bash" title={setup.packageName} />
              <CodeBlock code={setup.addCommand} lang="bash" title={`${setup.label} wrapper`} />
            </div>
          </section>
        ))}
      </Tabs>
    </section>

    {GlassExample && glassSnippets && (
      <section class="mt-10 space-y-3" aria-labelledby="glass-title">
        <div class="space-y-2">
          <h2
            class="text-sm font-black tracking-[0.14em] text-ink-soft uppercase"
            id="glass-title"
          >Glass
          </h2>
          <p class="max-w-2xl text-sm/7 text-ink-soft">
            Add the glass prop to apply the shared blur, saturation, border, and highlight tokens.
            Glass reads best over vivid content, so place the surface above imagery or color.
          </p>
        </div>
        <FrameworkExample
          componentName={component.name}
          examplePath={`apps/docs/src/examples/glass/${component.name}.astro`}
          groupId={`code-${componentSlug}-glass`}
          previewClass=""
          snippets={glassSnippets}
        >
          <GlassExample />
        </FrameworkExample>
      </section>
    )}

    <section class="mt-10 space-y-3" aria-labelledby="api-title">
      <div class="space-y-2">
        <h2
          class="text-sm font-black tracking-[0.14em] text-ink-soft uppercase"
          id="api-title"
        >API reference
        </h2>
        <p class="max-w-2xl text-sm/7 text-ink-soft">
          Lumen-specific props and runtime attributes for the Astro primitive. Use the framework differences above and the copyable examples for React composition and
          Elements attributes; the public adapter types define their supported contracts.
        </p>
      </div>
      <DocsReferenceTable
        columns={['Attribute', 'Values', 'Default', 'Description']}
        labelledBy="api-title"
        rows={component.apiReference.map(row => [row.attribute, row.values, row.defaultValue, row.description])}
      />
    </section>

    {component.keyboardInteractions && (
      <section class="mt-10 space-y-3" aria-labelledby="keyboard-title">
        <div class="space-y-2">
          <h2
            class="text-sm font-black tracking-[0.14em] text-ink-soft uppercase"
            id="keyboard-title"
          >Keyboard interactions
          </h2>
          <p class="max-w-2xl text-sm/7 text-ink-soft">
            Keyboard behavior provided by the Astro UIPrimitives runtime for this component.
          </p>
        </div>
        <DocsReferenceTable
        columns={['Key', 'Action']}
        labelledBy="keyboard-title"
        rows={component.keyboardInteractions.map(row => [row.key, row.action])}
        />
      </section>
    )}

    {component.runtimeEvents && (
      <section class="mt-10 space-y-3" aria-labelledby="runtime-events-title">
        <div class="space-y-2">
          <h2
            class="text-sm font-black tracking-[0.14em] text-ink-soft uppercase"
            id="runtime-events-title"
          >Runtime events
          </h2>
          <p class="max-w-2xl text-sm/7 text-ink-soft">
            CustomEvents dispatched by the Astro UIPrimitives runtime for this component.
          </p>
        </div>
        <DocsReferenceTable
        columns={['Event', 'Target', 'Detail', 'When']}
        labelledBy="runtime-events-title"
        rows={component.runtimeEvents.map(row => [row.name, row.target, row.detail, row.when])}
        />
      </section>
    )}

    <Separator class="my-10" />

    <CommunityFeedback documentationPath={`/docs/components/${componentSlug}`} subject={component.name} />

    <Pagination class="component-doc-pagination" aria-label="Component pagination">
      {previous ?
        (
          <DocsActionLink
            aria-label={`Previous component: ${previous.name}`}
            class="
              component-doc-pagination__link
              component-doc-pagination__link--previous
            "
            href={`/docs/components/${toSlug(previous.name)}`}
            variant="outline"
          >
            <span class="component-doc-pagination__icon" aria-hidden="true">
              <Icon name="arrow-left" size="sm" />
            </span>
            <span class="component-doc-pagination__copy">
              <small>Previous component</small>
              <strong>{previous.name}</strong>
            </span>
          </DocsActionLink>
        ) :
        <span />}
      {next && (
        <DocsActionLink
          aria-label={`Next component: ${next.name}`}
          class="
            component-doc-pagination__link component-doc-pagination__link--next
          "
          href={`/docs/components/${toSlug(next.name)}`}
          variant="outline"
        >
          <span class="component-doc-pagination__copy">
            <small>Next component</small>
            <strong>{next.name}</strong>
          </span>
          <span class="component-doc-pagination__icon" aria-hidden="true">
            <Icon name="arrow-right" size="sm" />
          </span>
        </DocsActionLink>
      )}
    </Pagination>
  </div>
</DocsLayout>

<style>
  .component-doc-hero--chart { min-height: 0; grid-template-columns: minmax(0, 1fr); padding: 1.5rem; gap: 0; }
  .component-doc-hero--chart .component-doc-hero__meta { display: none; }
  .component-doc-hero--chart h1,
  .component-doc-hero--chart h1[data-long-title] { max-width: none; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; }
  .component-doc-hero--chart .component-doc-hero__copy > p { margin-top: .75rem; font-size: .9375rem; }
  .component-doc-hero--chart .component-doc-hero__actions { margin-top: 1rem; }
</style>

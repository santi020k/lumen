---
import { Badge, Separator, Tabs } from '@santi020k/lumen-astro'

import type { InferGetStaticPropsType } from 'astro'

import CodeBlock from '../../../components/CodeBlock.astro'
import CodeTabs from '../../../components/CodeTabs.astro'
import { componentDocs, frameworkSetups } from '../../../data/docs'
import DocsLayout from '../../../layouts/DocsLayout.astro'
import { getExample, getGlassExample } from '../../../lib/examples'
import { toSlug } from '../../../lib/routes'
import { buildSnippets } from '../../../lib/snippets'

export const getStaticPaths = () =>
  componentDocs.map(component => ({
    params: { slug: toSlug(component.name) },
    props: { component }
  }))

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { component } = Astro.props
const { component: Example, source } = getExample(component.name)
const componentSlug = toSlug(component.name)
const snippets = buildSnippets(component.name, source)
const registryCommand = `lumen add ${component.name}`
const packageInstallSetups = frameworkSetups.map(setup => ({
  command: setup.installCommands.find(install => install.label === 'pnpm')?.command ?? setup.installCommands[0]?.command ?? '',
  id: setup.id,
  label: setup.label,
  packageName: setup.packageName
}))
const glassExample = component.glass ? getGlassExample(component.name) : undefined
const GlassExample = glassExample?.component
const glassSnippets = glassExample ? buildSnippets(component.name, glassExample.source) : undefined
const index = componentDocs.findIndex(entry => entry.name === component.name)
const previous = index > 0 ? componentDocs[index - 1] : undefined
const next = index < componentDocs.length - 1 ? componentDocs[index + 1] : undefined
const requiresAstroRuntime = Boolean(
  component.keyboardInteractions ||
  component.runtimeEvents ||
  component.apiReference.some(row => /UIPrimitives|runtime/i.test(row.description))
)
---

<DocsLayout
  description={`${component.name}: ${component.summary} Usage examples for Astro, React, and Elements.`}
  title={`${component.name} - Lumen UI`}
>
  <nav class="mb-6 text-sm text-ink-soft" aria-label="Breadcrumb">
    <a class="
      text-ink-soft no-underline
      hover:text-ink
    " href="/docs">Docs</a>
    <span aria-hidden="true"> / </span>
    <a class="
      text-ink-soft no-underline
      hover:text-ink
    " href="/docs/components">Components</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page" class="font-bold text-ink">{component.name}</span>
  </nav>

  <div class="mb-8 space-y-3">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-4xl font-black text-ink">{component.name}</h1>
      <Badge variant="secondary">{component.category}</Badge>
      {component.glass && <Badge variant="outline">Glass</Badge>}
    </div>
    <p class="max-w-2xl text-lg/8 text-ink-soft">{component.summary}</p>
  </div>

  <section class="space-y-3" aria-labelledby="preview-title">
    <h2 class="text-sm font-black tracking-[0.14em] text-ink-muted uppercase" id="preview-title">Preview</h2>
    <div class="docs-preview">
      <Example />
    </div>
  </section>

  <section class="mt-8 space-y-3" aria-labelledby="usage-title">
    <div class="space-y-2">
      <h2 class="text-sm font-black tracking-[0.14em] text-ink-muted uppercase" id="usage-title">Usage</h2>
      {requiresAstroRuntime && (
        <p class="max-w-2xl text-sm/7 text-ink-soft">
          Astro examples assume UIPrimitives is mounted once in your root layout. Do not add the
          runtime next to each component instance.
        </p>
      )}
    </div>
    <CodeTabs groupId={`code-${componentSlug}`} snippets={snippets} />
  </section>

  <section class="mt-10 space-y-3" aria-labelledby="install-title">
    <div class="space-y-2">
      <h2 class="text-sm font-black tracking-[0.14em] text-ink-muted uppercase" id="install-title">Add this component</h2>
      <p class="max-w-2xl text-sm/7 text-ink-soft">
        Choose the package for your runtime. All adapters share the Lumen stylesheet. Use the
        registry command only when you want a local Astro wrapper for this component.
      </p>
    </div>
    <div class="
      grid gap-4
      lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.8fr)]
    ">
      <Tabs>
        <div role="tablist" aria-label="Package install">
          {packageInstallSetups.map((setup, index) => (
            <button
              aria-controls={`install-${componentSlug}-panel-${setup.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              id={`install-${componentSlug}-tab-${setup.id}`}
              role="tab"
            >{setup.label}</button>
          ))}
        </div>
        {packageInstallSetups.map((setup, index) => (
          <section
            aria-labelledby={`install-${componentSlug}-tab-${setup.id}`}
            class="docs-code-panel"
            hidden={index !== 0}
            id={`install-${componentSlug}-panel-${setup.id}`}
            role="tabpanel"
          >
            <CodeBlock code={setup.command} lang="bash" title={setup.packageName} />
          </section>
        ))}
      </Tabs>
      <CodeBlock code={registryCommand} lang="bash" title="Optional Astro wrapper" />
    </div>
  </section>

  {GlassExample && glassSnippets && (
    <section class="mt-10 space-y-3" aria-labelledby="glass-title">
      <div class="space-y-2">
        <h2 class="
          text-sm font-black tracking-[0.14em] text-ink-muted uppercase
        " id="glass-title">Glass</h2>
        <p class="max-w-2xl text-sm/7 text-ink-soft">
          Add the glass prop to apply the shared blur, saturation, border, and highlight tokens.
          Glass reads best over vivid content, so place the surface above imagery or color.
        </p>
      </div>
      <div class="docs-preview">
        <GlassExample />
      </div>
      <CodeTabs groupId={`code-${componentSlug}-glass`} snippets={glassSnippets} />
    </section>
  )}

  <section class="mt-10 space-y-3" aria-labelledby="api-title">
    <div class="space-y-2">
      <h2 class="text-sm font-black tracking-[0.14em] text-ink-muted uppercase" id="api-title">API reference</h2>
      <p class="max-w-2xl text-sm/7 text-ink-soft">
        Lumen-specific props and runtime attributes for the Astro primitive. React props follow the
        same names; Elements use equivalent kebab-case attributes where custom elements expose them.
      </p>
    </div>
    <div class="overflow-x-auto rounded-xl border border-line bg-surface">
      <table class="w-full min-w-176 border-collapse text-left text-sm">
        <thead class="
          bg-surface-muted text-xs font-black tracking-[0.12em] text-ink-muted
          uppercase
        ">
          <tr>
            <th class="border-b border-line px-4 py-3">Attribute</th>
            <th class="border-b border-line px-4 py-3">Values</th>
            <th class="border-b border-line px-4 py-3">Default</th>
            <th class="border-b border-line px-4 py-3">Description</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {component.apiReference.map(row => (
            <tr>
              <th class="
                w-48 px-4 py-3 align-top font-mono text-xs font-bold text-ink
              " scope="row">
                {row.attribute}
              </th>
              <td class="
                w-64 px-4 py-3 align-top font-mono text-xs text-ink-soft
              ">{row.values}</td>
              <td class="
                w-28 px-4 py-3 align-top font-mono text-xs text-ink-soft
              ">{row.defaultValue}</td>
              <td class="px-4 py-3 align-top text-sm/6 text-ink-soft">{row.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {component.keyboardInteractions && (
    <section class="mt-10 space-y-3" aria-labelledby="keyboard-title">
      <div class="space-y-2">
        <h2 class="
          text-sm font-black tracking-[0.14em] text-ink-muted uppercase
        " id="keyboard-title">Keyboard interactions</h2>
        <p class="max-w-2xl text-sm/7 text-ink-soft">
          Keyboard behavior provided by the Astro UIPrimitives runtime for this component.
        </p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-line bg-surface">
        <table class="w-full min-w-xl border-collapse text-left text-sm">
          <thead class="
            bg-surface-muted text-xs font-black tracking-[0.12em] text-ink-muted
            uppercase
          ">
            <tr>
              <th class="border-b border-line px-4 py-3">Key</th>
              <th class="border-b border-line px-4 py-3">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {component.keyboardInteractions.map(row => (
              <tr>
                <th class="
                  w-72 px-4 py-3 align-top font-mono text-xs font-bold text-ink
                " scope="row">
                  {row.key}
                </th>
                <td class="px-4 py-3 align-top text-sm/6 text-ink-soft">{row.action}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {component.runtimeEvents && (
    <section class="mt-10 space-y-3" aria-labelledby="runtime-events-title">
      <div class="space-y-2">
        <h2 class="
          text-sm font-black tracking-[0.14em] text-ink-muted uppercase
        " id="runtime-events-title">Runtime events</h2>
        <p class="max-w-2xl text-sm/7 text-ink-soft">
          CustomEvents dispatched by the Astro UIPrimitives runtime for this component.
        </p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-line bg-surface">
        <table class="w-full min-w-176 border-collapse text-left text-sm">
          <thead class="
            bg-surface-muted text-xs font-black tracking-[0.12em] text-ink-muted
            uppercase
          ">
            <tr>
              <th class="border-b border-line px-4 py-3">Event</th>
              <th class="border-b border-line px-4 py-3">Target</th>
              <th class="border-b border-line px-4 py-3">Detail</th>
              <th class="border-b border-line px-4 py-3">When</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {component.runtimeEvents.map(row => (
              <tr>
                <th class="
                  w-56 px-4 py-3 align-top font-mono text-xs font-bold text-ink
                " scope="row">
                  {row.name}
                </th>
                <td class="w-64 px-4 py-3 align-top text-sm/6 text-ink-soft">{row.target}</td>
                <td class="
                  w-64 px-4 py-3 align-top font-mono text-xs text-ink-soft
                ">{row.detail}</td>
                <td class="px-4 py-3 align-top text-sm/6 text-ink-soft">{row.when}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <Separator class="my-10" />

  <nav class="flex flex-wrap justify-between gap-3" aria-label="Component pagination">
    {previous
      ? (
          <a class="
            ui-button ui-button--default-size ui-button--outline no-underline
          " href={`/docs/components/${toSlug(previous.name)}`}>
            Previous: {previous.name}
          </a>
        )
      : <span />}
    {next && (
      <a class="
        ui-button ui-button--default-size ui-button--outline no-underline
      " href={`/docs/components/${toSlug(next.name)}`}>
        Next: {next.name}
      </a>
    )}
  </nav>
</DocsLayout>

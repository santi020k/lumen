---
/* cspell:ignore Consolas Menlo */
/* eslint-disable better-tailwindcss/no-unknown-classes */
import {
  Button,
  ButtonGroup,
  Card,
  Field,
  Input,
  Label,
  NumberField,
  Slider,
  Tabs,
  Textarea,
  ThemeBuilder
} from '@santi020k/lumen-astro'
import { createThemeFromHue, lumenTokenNames } from '@santi020k/lumen-core'

import DocsPageHero from '../../components/DocsPageHero.astro'
import PrimitiveShowcase from '../../components/PrimitiveShowcase.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const defaultHue = 264
const defaultAccentHue = 54
const defaultPrimaryHex = '#6f20f0'
const defaultSecondaryHex = '#ad9e1f'
const defaultScheme = 'light'

const defaultTokens = createThemeFromHue(defaultHue, {
  accentHue: defaultAccentHue,
  scheme: defaultScheme
})

const tokenStyle = Object.entries(defaultTokens)
  .map(([token, value]) => `--${token}: ${value};`)
  .join(' ')

const defaultCss = `:root {
  color-scheme: ${defaultScheme};
${lumenTokenNames.map(token => `  --${token}: ${defaultTokens[token]};`).join('\n')}
}`
---

<DocsLayout
  description="Generate Lumen theme tokens from a brand hue, preview representative primitives, and copy a CSS theme."
  title="Theme playground - Lumen UI"
>
  <div class="theme-page">
    <DocsPageHero
      description="Generate a complete semantic theme from a pair of colors, preview it against real Lumen primitives, and export production-ready CSS, Figma variables, or JSON."
      eyebrow="Theme studio"
      stats={[
        { label: 'Semantic tokens', value: lumenTokenNames.length },
        { label: 'Schemes', value: 2 },
        { label: 'Export formats', value: 3 }
      ]}
      title="Shape a theme. See it live."
    >
      <Fragment slot="actions">
        <a
          class="
            ui-button ui-button--default-size ui-button--default no-underline
          "
          href="#theme-workbench"
        >Start building</a>
        <a
          class="
            ui-button ui-button--default-size ui-button--outline no-underline
          "
          href="/docs#themes"
        >Read theme guide</a>
      </Fragment>

      <div class="theme-hero-swatches" slot="visual" aria-label="Generated theme preview">
        <span style="--theme-swatch: hsl(var(--brand));"><small>Brand</small></span>
        <span style="--theme-swatch: hsl(var(--accent));"><small>Accent</small></span>
        <span style="--theme-swatch: hsl(var(--success));"><small>Success</small></span>
        <span style="--theme-swatch: hsl(var(--warning));"><small>Warning</small></span>
        <span style="--theme-swatch: hsl(var(--danger));"><small>Danger</small></span>
      </div>
    </DocsPageHero>

    <div class="theme-workbench-heading">
      <div>
        <p>Interactive workbench</p>
        <h2>Build, preview, and export</h2>
      </div>
      <p>
        Adjust generated or manual colors on the left. The preview and export stay in sync as you
        refine the system.
      </p>
    </div>

    <ThemeBuilder
      class="theme-playground"
      data-theme-playground
      data-ui-theme-target="#theme-playground-preview"
      glass="subtle"
      id="theme-workbench"
    >
    <Card class="theme-playground__controls" variant="muted">
      <div class="theme-playground__section-heading">
        <p>Inputs</p>
        <h2>Build tokens</h2>
      </div>

      <Tabs class="theme-playground__tabs">
        <div role="tablist" aria-label="Theme input mode">
          <button
            aria-controls="theme-generate-panel"
            aria-selected="true"
            data-ui-theme-mode="generated"
            id="theme-generate-tab"
            role="tab"
            type="button"
          >Generate</button>
          <button
            aria-controls="theme-manual-panel"
            aria-selected="false"
            data-ui-theme-mode="manual"
            id="theme-manual-tab"
            role="tab"
            type="button"
          >Manual</button>
        </div>

        <section
          class="theme-playground__tab-panel"
          id="theme-generate-panel"
          role="tabpanel"
          aria-labelledby="theme-generate-tab"
        >
          <Field class="theme-playground__field">
            <Label for="theme-brand-hue">Brand hue</Label>
            <div class="theme-playground__control-row">
              <Slider
                aria-describedby="theme-brand-hue-value"
                data-ui-theme-brand-hue
                id="theme-brand-hue"
                max="359"
                min="0"
                name="brandHue"
                value={String(defaultHue)}
              />
              <NumberField
                aria-label="Brand hue value"
                data-ui-theme-brand-hue-number
                id="theme-brand-hue-value"
                max="359"
                min="0"
                value={String(defaultHue)}
              />
            </div>
          </Field>

          <Field class="theme-playground__field">
            <Label for="theme-accent-hue">Accent hue</Label>
            <div class="theme-playground__control-row">
              <Slider
                aria-describedby="theme-accent-hue-value"
                data-ui-theme-accent-hue
                id="theme-accent-hue"
                max="359"
                min="0"
                name="accentHue"
                value={String(defaultAccentHue)}
              />
              <NumberField
                aria-label="Accent hue value"
                data-ui-theme-accent-hue-number
                id="theme-accent-hue-value"
                max="359"
                min="0"
                value={String(defaultAccentHue)}
              />
            </div>
          </Field>
        </section>

        <section
          class="theme-playground__tab-panel"
          hidden
          id="theme-manual-panel"
          role="tabpanel"
          aria-labelledby="theme-manual-tab"
        >
          <Field class="theme-playground__field">
            <Label for="theme-primary-hex">Primary</Label>
            <div class="theme-playground__hex-row">
              <input
                aria-label="Primary color"
                class="theme-playground__color"
                data-ui-theme-primary-color
                type="color"
                value={defaultPrimaryHex}
              />
              <Input
                autocomplete="off"
                data-ui-theme-primary-hex
                id="theme-primary-hex"
                inputmode="text"
                pattern="^#?[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
                spellcheck="false"
                value={defaultPrimaryHex}
              />
            </div>
          </Field>

          <Field class="theme-playground__field">
            <Label for="theme-secondary-hex">Secondary</Label>
            <div class="theme-playground__hex-row">
              <input
                aria-label="Secondary color"
                class="theme-playground__color"
                data-ui-theme-secondary-color
                type="color"
                value={defaultSecondaryHex}
              />
              <Input
                autocomplete="off"
                data-ui-theme-secondary-hex
                id="theme-secondary-hex"
                inputmode="text"
                pattern="^#?[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
                spellcheck="false"
                value={defaultSecondaryHex}
              />
            </div>
          </Field>
        </section>
      </Tabs>

      <Field class="theme-playground__field">
        <Label id="theme-scheme-label">Preview scheme</Label>
        <ButtonGroup aria-labelledby="theme-scheme-label" class="
          theme-playground__scheme-toggle
        ">
          <Button
            aria-pressed="true"
            data-ui-theme-scheme="light"
            type="button"
            variant="secondary"
          >Light</Button>
          <Button
            aria-pressed="false"
            data-ui-theme-scheme="dark"
            type="button"
            variant="outline"
          >Dark</Button>
        </ButtonGroup>
      </Field>
    </Card>

    <section class="theme-playground__preview-shell" aria-labelledby="theme-preview-title">
      <div class="theme-playground__section-heading">
        <p>Live preview</p>
        <h2 id="theme-preview-title">Representative primitives</h2>
      </div>

      <PrimitiveShowcase
        class="theme-playground__preview"
        data-ui-theme-preview
        description="The preview reads generated tokens from this scoped container."
        eyebrow="Generated"
        headingLevel="h3"
        id="theme-playground-preview"
        status="Ready"
        style={`color-scheme: ${defaultScheme}; ${tokenStyle}`}
        swatchMode="all"
        title="Workspace launch"
      />
    </section>

    <Card class="theme-playground__export" variant="muted">
      <div class="theme-playground__section-heading">
        <p>Export</p>
        <h2>Copy tokens</h2>
      </div>
      <Field class="theme-playground__field">
        <Label id="theme-export-format-label">Format</Label>
        <ButtonGroup aria-labelledby="theme-export-format-label" class="
          theme-playground__export-formats
        ">
          <Button
            aria-pressed="true"
            data-ui-theme-export-format="css"
            type="button"
            variant="secondary"
          >CSS</Button>
          <Button
            aria-pressed="false"
            data-ui-theme-export-format="figma"
            type="button"
            variant="outline"
          >Figma</Button>
          <Button
            aria-pressed="false"
            data-ui-theme-export-format="tokens"
            type="button"
            variant="outline"
          >JSON</Button>
        </ButtonGroup>
      </Field>
      <Textarea
        aria-label="Generated theme export"
        class="theme-playground__css"
        data-ui-theme-output
        rows={18}
      >{defaultCss}</Textarea>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <Button data-ui-theme-export type="button">Copy CSS</Button>
        <Button data-ui-theme-import type="button" variant="outline">Import CSS</Button>
        <Button data-ui-theme-check-contrast type="button" variant="secondary">Fix Contrast</Button>
      </div>
    </Card>
    </ThemeBuilder>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-theme-playground]')

      if (!(root instanceof HTMLElement)) return

      let isSyncingScheme = false
      let userSelectedScheme = false

      const getPageScheme = () => (
        document.documentElement.dataset.theme?.includes('dark') ? 'dark' : 'light'
      )

      const setSchemeButtonState = (scheme) => {
        const buttons = root.querySelectorAll('[data-ui-theme-scheme]')

        for (const button of buttons) {
          const isPressed = button.getAttribute('data-ui-theme-scheme') === scheme

          button.setAttribute('aria-pressed', String(isPressed))

          button.classList.toggle('ui-button--secondary', isPressed)

          button.classList.toggle('ui-button--outline', !isPressed)
        }

        return buttons
      }

      const syncSchemeWithPageTheme = ({ notify = false } = {}) => {
        if (userSelectedScheme) return

        const scheme = getPageScheme()
        const buttons = setSchemeButtonState(scheme)

        const activeButton = [...buttons].find(button =>
          button.getAttribute('data-ui-theme-scheme') === scheme
        )

        if (!notify || !(activeButton instanceof HTMLButtonElement)) return

        if (root.dataset.uiThemeBuilderBound !== 'true') return

        isSyncingScheme = true

        activeButton.click()

        isSyncingScheme = false
      }

      root.addEventListener('click', event => {
        if (isSyncingScheme) return

        const target = event.target instanceof Element
          ? event.target.closest('[data-ui-theme-scheme]')
          : null

        userSelectedScheme = Boolean(target) || userSelectedScheme
      })

      const syncSchemeAfterPageThemeChange = event => {
        const target = event.target instanceof Element
          ? event.target.closest('[data-theme-toggle], [data-theme-select]')
          : null

        if (!target) return

        requestAnimationFrame(() => syncSchemeWithPageTheme({ notify: true }))
      }

      document.addEventListener('click', syncSchemeAfterPageThemeChange)

      document.addEventListener('change', syncSchemeAfterPageThemeChange)

      syncSchemeWithPageTheme()
    })()
  </script>
</DocsLayout>


<style>
  .theme-page {
    display: grid;
    gap: 3.5rem;
  }

  .theme-hero-swatches {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.45rem;
    padding: 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.1rem;
    background: hsl(var(--canvas) / 0.62);
    backdrop-filter: blur(14px);
  }

  .theme-hero-swatches span {
    display: flex;
    min-height: 8rem;
    align-items: end;
    overflow: hidden;
    border: 1px solid hsl(var(--line));
    border-radius: 0.75rem;
    background: var(--theme-swatch);
  }

  .theme-hero-swatches small {
    width: 100%;
    padding: 0.45rem 0.25rem;
    background: hsl(var(--canvas) / 0.76);
    color: hsl(var(--ink-soft));
    font-size: 0.55rem;
    font-weight: 850;
    text-align: center;
    backdrop-filter: blur(10px);
  }

  .theme-workbench-heading {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  .theme-workbench-heading > div > p {
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .theme-workbench-heading h2 {
    margin-top: 0.25rem;
    color: hsl(var(--ink));
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  .theme-workbench-heading > p {
    max-width: 36rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .theme-playground {
    --theme-playground-panel: hsl(var(--surface-muted) / 0.78);
    --theme-playground-panel-strong: hsl(var(--surface) / 0.9);
    --theme-playground-border: hsl(var(--line));
    --theme-playground-shadow: var(--ui-shadow-sm);
    display: grid;
    gap: 1rem;
    scroll-margin-top: 6rem;
  }

  .theme-playground__controls,
  .theme-playground__export {
    display: grid;
    gap: 1rem;
    border-color: var(--theme-playground-border);
    border-radius: 1.1rem;
    background: var(--theme-playground-panel);
    box-shadow: var(--theme-playground-shadow);
    padding: 1rem;
  }

  .theme-playground__section-heading {
    display: grid;
    gap: 0.25rem;
  }

  .theme-playground__section-heading p {
    margin: 0;
    color: hsl(var(--ink-muted));
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .theme-playground__section-heading h2 {
    margin: 0;
    color: hsl(var(--ink));
    font-size: 1.125rem;
    font-weight: 900;
    line-height: 1.3;
  }

  .theme-playground__field {
    gap: 0.5rem;
  }

  .theme-playground__tabs,
  .theme-playground__tab-panel {
    display: grid;
    gap: 1rem;
  }

  .theme-playground__tab-panel[hidden] {
    display: none;
  }

  .theme-playground__control-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.25rem;
    gap: 0.75rem;
    align-items: center;
  }

  .theme-playground__hex-row {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
  }

  .theme-playground__color {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem;
    background: hsl(var(--surface));
    cursor: pointer;
    padding: 0.2rem;
  }

  .theme-playground__color::-webkit-color-swatch-wrapper {
    padding: 0;
  }

  .theme-playground__color::-webkit-color-swatch {
    border: 0;
    border-radius: 0.25rem;
  }

  .theme-playground__color::-moz-color-swatch {
    border: 0;
    border-radius: 0.25rem;
  }

  :global(.theme-playground .ui-slider) {
    height: 1.75rem;
    appearance: none;
    border-radius: 999px;
    background: transparent;
  }

  :global(.theme-playground .ui-slider:focus-visible) {
    outline: 2px solid hsl(var(--brand));
    outline-offset: 0.35rem;
  }

  :global(.theme-playground .ui-slider::-webkit-slider-runnable-track) {
    height: 0.4rem;
    border-radius: 999px;
    background: linear-gradient(90deg, hsl(var(--brand-solid)), hsl(var(--brand)));
  }

  :global(.theme-playground .ui-slider::-moz-range-track) {
    height: 0.4rem;
    border-radius: 999px;
    background: linear-gradient(90deg, hsl(var(--brand-solid)), hsl(var(--brand)));
  }

  :global(.theme-playground .ui-slider::-webkit-slider-thumb) {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: -0.375rem;
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: hsl(var(--brand));
    box-shadow: 0 0 0 0.2rem hsl(var(--surface)), 0 2px 8px hsl(var(--brand) / 0.36);
  }

  :global(.theme-playground .ui-slider::-moz-range-thumb) {
    width: 1.15rem;
    height: 1.15rem;
    border: 0;
    border-radius: 999px;
    background: hsl(var(--brand));
    box-shadow: 0 0 0 0.2rem hsl(var(--surface)), 0 2px 8px hsl(var(--brand) / 0.36);
  }

  :global(.theme-playground .ui-slider:focus-visible::-webkit-slider-thumb) {
    box-shadow:
      0 0 0 0.2rem hsl(var(--surface)),
      0 0 0 0.35rem hsl(var(--brand) / 0.32),
      0 2px 8px hsl(var(--brand) / 0.36);
  }

  :global(.theme-playground .ui-slider:focus-visible::-moz-range-thumb) {
    box-shadow:
      0 0 0 0.2rem hsl(var(--surface)),
      0 0 0 0.35rem hsl(var(--brand) / 0.32),
      0 2px 8px hsl(var(--brand) / 0.36);
  }

  .theme-playground__export-formats,
  .theme-playground__scheme-toggle {
    width: fit-content;
  }

  .theme-playground__preview-shell {
    display: grid;
    gap: 0.75rem;
  }

  .theme-playground__preview {
    display: grid;
    gap: 1rem;
    overflow: hidden;
    border: 1px solid var(--theme-playground-border);
    border-radius: 1.1rem;
    background:
      linear-gradient(135deg, hsl(var(--brand) / 0.14), transparent 35%),
      linear-gradient(315deg, hsl(var(--accent) / 0.14), transparent 38%),
      hsl(var(--canvas));
    color: hsl(var(--ink));
    box-shadow: var(--theme-playground-shadow);
    padding: 1rem;
  }

  .theme-playground__preview-card {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
    padding: 1rem;
  }

  .theme-playground__preview-header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: start;
    justify-content: space-between;
  }

  .theme-playground__preview-header h3 {
    margin: 0.35rem 0 0;
    color: hsl(var(--ink));
    font-size: 1.35rem;
    font-weight: 900;
    line-height: 1.25;
  }

  .theme-playground__preview-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .theme-playground__swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.5rem;
  }

  .theme-playground__swatches > span {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem;
    background: hsl(var(--surface) / 0.78);
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-weight: 750;
    padding: 0.5rem;
  }

  .theme-playground__swatches i {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    flex: 0 0 auto;
    border: 1px solid hsl(var(--line));
    border-radius: 999px;
    background: var(--swatch);
  }

  .theme-playground__css {
    min-height: 20rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  :global(:root[data-theme="dark"]) .theme-playground,
  :global(:root[data-theme="lumen-dark"]) .theme-playground,
  :global(:root[data-theme="santi020k-dark"]) .theme-playground {
    --theme-playground-panel: hsl(260 20% 11% / 0.78);
    --theme-playground-panel-strong: hsl(260 20% 13% / 0.88);
    --theme-playground-border: hsl(260 18% 38% / 0.72);
    --theme-playground-shadow:
      inset 0 1px 0 hsl(260 45% 96% / 0.08),
      0 18px 48px hsl(260 55% 3% / 0.42);
  }

  :global(:root[data-theme="dark"]) .theme-playground__controls,
  :global(:root[data-theme="dark"]) .theme-playground__export,
  :global(:root[data-theme="lumen-dark"]) .theme-playground__controls,
  :global(:root[data-theme="lumen-dark"]) .theme-playground__export,
  :global(:root[data-theme="santi020k-dark"]) .theme-playground__controls,
  :global(:root[data-theme="santi020k-dark"]) .theme-playground__export {
    background:
      linear-gradient(180deg, hsl(260 38% 92% / 0.055), transparent 42%),
      var(--theme-playground-panel);
  }

  :global(:root[data-theme="dark"]) .theme-playground__preview,
  :global(:root[data-theme="lumen-dark"]) .theme-playground__preview,
  :global(:root[data-theme="santi020k-dark"]) .theme-playground__preview {
    border-color: hsl(260 18% 44% / 0.82);
    background:
      linear-gradient(135deg, hsl(var(--brand) / 0.18), transparent 38%),
      linear-gradient(315deg, hsl(var(--accent) / 0.16), transparent 42%),
      linear-gradient(180deg, hsl(var(--canvas)), hsl(var(--surface-muted) / 0.92));
    box-shadow:
      inset 0 1px 0 hsl(260 45% 96% / 0.18),
      0 20px 54px hsl(260 55% 3% / 0.36);
  }

  :global(:root[data-theme="dark"]) .theme-playground__preview-card,
  :global(:root[data-theme="lumen-dark"]) .theme-playground__preview-card,
  :global(:root[data-theme="santi020k-dark"]) .theme-playground__preview-card {
    border-color: hsl(var(--line) / 0.82);
    background:
      linear-gradient(180deg, hsl(var(--ink) / 0.07), transparent 44%),
      hsl(var(--surface) / 0.84);
  }

  :global(:root[data-theme="dark"]) .theme-playground__swatches > span,
  :global(:root[data-theme="lumen-dark"]) .theme-playground__swatches > span,
  :global(:root[data-theme="santi020k-dark"]) .theme-playground__swatches > span {
    border-color: hsl(var(--line) / 0.82);
    background: hsl(var(--surface) / 0.82);
    color: hsl(var(--ink-soft));
  }

  :global(:root[data-theme="dark"]) .theme-playground__css,
  :global(:root[data-theme="lumen-dark"]) .theme-playground__css,
  :global(:root[data-theme="santi020k-dark"]) .theme-playground__css {
    border-color: hsl(260 18% 34% / 0.9);
    background: hsl(260 24% 6% / 0.96);
    box-shadow:
      inset 0 1px 0 hsl(260 45% 96% / 0.06),
      inset 0 0 0 1px hsl(260 45% 96% / 0.025);
    color: hsl(260 18% 91%);
  }

  @media (min-width: 1024px) {
    .theme-playground {
      grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.35fr);
      align-items: start;
    }

    .theme-playground__export {
      grid-column: 1 / -1;
    }
  }


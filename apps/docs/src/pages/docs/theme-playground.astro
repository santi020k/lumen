---
import {
  Alert,
  Badge,
  Button,
  ButtonGroup,
  Card,
  Field,
  Input,
  Label,
  NumberField,
  Slider,
  Textarea,
  ThemeBuilder
} from '@santi020k/lumen-astro'
import { createThemeFromHue, lumenTokenNames } from '@santi020k/lumen-core'

import DocsLayout from '../../layouts/DocsLayout.astro'

const defaultHue = 264
const defaultAccentHue = 54
const defaultScheme = 'light'
const defaultTokens = createThemeFromHue(defaultHue, {
  accentHue: defaultAccentHue,
  scheme: defaultScheme
})
const tokenStyle = Object.entries(defaultTokens)
  .map(([token, value]) => `--${token}: ${value};`)
  .join(' ')
const defaultCss = `:root {
  color-scheme: ${defaultScheme};
${lumenTokenNames.map(token => `  --${token}: ${defaultTokens[token]};`).join('\n')}
}`
---

<DocsLayout
  description="Generate Lumen theme tokens from a brand hue, preview representative primitives, and copy a CSS theme."
  title="Theme playground - Lumen UI"
>
  <nav class="mb-6 text-sm text-ink-soft" aria-label="Breadcrumb">
    <a class="
      text-ink-soft no-underline
      hover:text-ink
    " href="/docs">Docs</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page" class="font-bold text-ink">Theme playground</span>
  </nav>

  <div class="mb-8 space-y-3">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="
        text-4xl/tight font-black text-ink
        sm:text-5xl/tight
      ">Theme playground</h1>
      <Badge variant="secondary">Tokens</Badge>
    </div>
    <p class="max-w-3xl text-lg/8 text-ink-soft">
      Generate the Lumen token set from a brand hue, tune the accent hue, preview light and dark
      schemes, and copy CSS ready for your app.
    </p>
  </div>

  <ThemeBuilder
    class="theme-playground"
    data-ui-theme-target="#theme-playground-preview"
    glass="subtle"
  >
    <Card class="theme-playground__controls" variant="muted">
      <div class="theme-playground__section-heading">
        <p>Inputs</p>
        <h2>Generate tokens</h2>
      </div>

      <Field class="theme-playground__field">
        <Label for="theme-brand-hue">Brand hue</Label>
        <div class="theme-playground__control-row">
          <Slider
            aria-describedby="theme-brand-hue-value"
            data-theme-brand-hue
            id="theme-brand-hue"
            max="359"
            min="0"
            name="brandHue"
            value={String(defaultHue)}
          />
          <NumberField
            aria-label="Brand hue value"
            data-theme-brand-hue-number
            id="theme-brand-hue-value"
            max="359"
            min="0"
            value={String(defaultHue)}
          />
        </div>
      </Field>

      <Field class="theme-playground__field">
        <Label for="theme-accent-hue">Accent hue</Label>
        <div class="theme-playground__control-row">
          <Slider
            aria-describedby="theme-accent-hue-value"
            data-theme-accent-hue
            id="theme-accent-hue"
            max="359"
            min="0"
            name="accentHue"
            value={String(defaultAccentHue)}
          />
          <NumberField
            aria-label="Accent hue value"
            data-theme-accent-hue-number
            id="theme-accent-hue-value"
            max="359"
            min="0"
            value={String(defaultAccentHue)}
          />
        </div>
      </Field>

      <Field class="theme-playground__field">
        <Label id="theme-scheme-label">Preview scheme</Label>
        <ButtonGroup aria-labelledby="theme-scheme-label" class="theme-playground__scheme-toggle">
          <Button
            aria-pressed="true"
            data-theme-scheme="light"
            type="button"
            variant="secondary"
          >Light</Button>
          <Button
            aria-pressed="false"
            data-theme-scheme="dark"
            type="button"
            variant="outline"
          >Dark</Button>
        </ButtonGroup>
      </Field>
    </Card>

    <section class="theme-playground__preview-shell" aria-labelledby="theme-preview-title">
      <div class="theme-playground__section-heading">
        <p>Live preview</p>
        <h2 id="theme-preview-title">Representative primitives</h2>
      </div>

      <div
        class="theme-playground__preview"
        data-theme-preview
        id="theme-playground-preview"
        style={`color-scheme: ${defaultScheme}; ${tokenStyle}`}
      >
        <Card class="theme-playground__preview-card" glass="subtle">
          <div class="theme-playground__preview-header">
            <div>
              <Badge variant="secondary">Generated</Badge>
              <h3>Project access</h3>
            </div>
            <Badge variant="success">Ready</Badge>
          </div>

          <Field glass="subtle">
            <Label for="theme-preview-email">Email</Label>
            <Input id="theme-preview-email" placeholder="you@example.com" type="email" />
          </Field>

          <div class="theme-playground__preview-actions">
            <Button>Invite</Button>
            <Button variant="outline">Preview</Button>
          </div>

          <Alert variant="success">
            <strong>Theme applied.</strong>
            <p>The preview reads tokens from this scoped container.</p>
          </Alert>
        </Card>

        <div class="theme-playground__swatches" aria-label="Generated token swatches">
          {lumenTokenNames.map(token => (
            <span>
              <i style={`--swatch: hsl(var(--${token}));`}></i>
              <span>{token}</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <Card class="theme-playground__export" variant="muted">
      <div class="theme-playground__section-heading">
        <p>Export</p>
        <h2>Copy CSS</h2>
      </div>
      <Textarea
        aria-label="Generated theme CSS"
        class="theme-playground__css"
        data-ui-theme-output
        readonly
        rows={18}
      >{defaultCss}</Textarea>
      <Button data-theme-export type="button">Copy CSS</Button>
    </Card>
  </ThemeBuilder>
</DocsLayout>

<script>
  import {
    createThemeFromHue,
    exportThemeCss,
    lumenTokenNames,
    type LumenThemeTokens
  } from '@santi020k/lumen-core'

  type ThemeScheme = 'dark' | 'light'

  const normalizeHue = (value: string | number): number => {
    const parsed = Number(value)

    if (!Number.isFinite(parsed)) return 0

    return ((Math.round(parsed) % 360) + 360) % 360
  }

  const buildThemeCss = (tokens: LumenThemeTokens, scheme: ThemeScheme): string =>
    exportThemeCss(tokens).replace('{', `{\n  color-scheme: ${scheme};`)

  const applyTokens = (target: HTMLElement, tokens: LumenThemeTokens, scheme: ThemeScheme) => {
    target.style.colorScheme = scheme

    for (const token of lumenTokenNames) {
      target.style.setProperty(`--${token}`, tokens[token] ?? '')
    }
  }

  const bindSyncedHueInputs = (
    range: HTMLInputElement | null,
    number: HTMLInputElement | null,
    onChange: () => void
  ) => {
    const sync = (source: HTMLInputElement, target: HTMLInputElement | null) => {
      source.value = String(normalizeHue(source.value))

      if (target) {
        target.value = source.value
      }

      onChange()
    }

    range?.addEventListener('input', () => sync(range, number))
    number?.addEventListener('input', () => sync(number, range))
  }

  const initThemePlayground = (root: HTMLElement) => {
    const preview = root.querySelector<HTMLElement>('[data-theme-preview]')
    const output = root.querySelector<HTMLTextAreaElement>('[data-ui-theme-output]')
    const brandHue = root.querySelector<HTMLInputElement>('[data-theme-brand-hue]')
    const brandHueNumber = root.querySelector<HTMLInputElement>('[data-theme-brand-hue-number]')
    const accentHue = root.querySelector<HTMLInputElement>('[data-theme-accent-hue]')
    const accentHueNumber = root.querySelector<HTMLInputElement>('[data-theme-accent-hue-number]')
    const exportButton = root.querySelector<HTMLButtonElement>('[data-theme-export]')
    const schemeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-theme-scheme]'))

    if (!preview || !output || !brandHue || !accentHue) return

    let scheme: ThemeScheme = 'light'

    const update = () => {
      const hue = normalizeHue(brandHue.value)
      const nextAccentHue = normalizeHue(accentHue.value)
      const tokens = createThemeFromHue(hue, {
        accentHue: nextAccentHue,
        scheme
      })

      applyTokens(preview, tokens, scheme)

      output.value = buildThemeCss(tokens, scheme)

      root.dispatchEvent(new CustomEvent('ui:theme-change', {
        bubbles: true,
        detail: { hue, tokens }
      }))
    }

    bindSyncedHueInputs(brandHue, brandHueNumber, update)
    bindSyncedHueInputs(accentHue, accentHueNumber, update)

    for (const button of schemeButtons) {
      button.addEventListener('click', () => {
        const nextScheme = button.dataset.themeScheme

        if (nextScheme !== 'dark' && nextScheme !== 'light') return

        scheme = nextScheme

        for (const option of schemeButtons) {
          const isPressed = option === button

          option.setAttribute('aria-pressed', String(isPressed))
          option.classList.toggle('ui-button--secondary', isPressed)
          option.classList.toggle('ui-button--outline', !isPressed)
        }

        update()
      })
    }

    exportButton?.addEventListener('click', async () => {
      await navigator.clipboard?.writeText(output.value).catch(() => null)

      root.dispatchEvent(new CustomEvent('ui:theme-export', {
        bubbles: true,
        detail: { css: output.value }
      }))
    })

    update()
  }

  const initThemePlaygrounds = () => {
    for (const root of document.querySelectorAll<HTMLElement>('.theme-playground')) {
      if (root.dataset.themePlaygroundBound === 'true') continue

      root.dataset.themePlaygroundBound = 'true'

      initThemePlayground(root)
    }
  }

  document.addEventListener('astro:page-load', initThemePlaygrounds)
  initThemePlaygrounds()
</script>

<style>
  .theme-playground {
    display: grid;
    gap: 1rem;
  }

  .theme-playground__controls,
  .theme-playground__export {
    display: grid;
    gap: 1rem;
    padding: 1rem;
  }

  .theme-playground__section-heading {
    display: grid;
    gap: 0.25rem;
  }

  .theme-playground__section-heading p {
    margin: 0;
    color: hsl(var(--ink-muted));
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .theme-playground__section-heading h2 {
    margin: 0;
    color: hsl(var(--ink));
    font-size: 1.125rem;
    font-weight: 900;
    line-height: 1.3;
  }

  .theme-playground__field {
    gap: 0.5rem;
  }

  .theme-playground__control-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6rem;
    gap: 0.75rem;
    align-items: center;
  }

  .theme-playground__scheme-toggle {
    width: fit-content;
  }

  .theme-playground__preview-shell {
    display: grid;
    gap: 0.75rem;
  }

  .theme-playground__preview {
    display: grid;
    gap: 1rem;
    overflow: hidden;
    border: 1px solid hsl(var(--line));
    border-radius: 0.5rem;
    background:
      linear-gradient(135deg, hsl(var(--brand) / 0.14), transparent 35%),
      linear-gradient(315deg, hsl(var(--accent) / 0.14), transparent 38%),
      hsl(var(--canvas));
    color: hsl(var(--ink));
    padding: 1rem;
  }

  .theme-playground__preview-card {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
    padding: 1rem;
  }

  .theme-playground__preview-header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: start;
    justify-content: space-between;
  }

  .theme-playground__preview-header h3 {
    margin: 0.35rem 0 0;
    color: hsl(var(--ink));
    font-size: 1.35rem;
    font-weight: 900;
    line-height: 1.25;
  }

  .theme-playground__preview-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .theme-playground__swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.5rem;
  }

  .theme-playground__swatches > span {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem;
    background: hsl(var(--surface) / 0.78);
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-weight: 750;
    padding: 0.5rem;
  }

  .theme-playground__swatches i {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    flex: 0 0 auto;
    border: 1px solid hsl(var(--line));
    border-radius: 999px;
    background: var(--swatch);
  }

  .theme-playground__css {
    min-height: 20rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  @media (min-width: 1024px) {
    .theme-playground {
      grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.35fr);
      align-items: start;
    }

    .theme-playground__export {
      grid-column: 1 / -1;
    }
  }
</style>

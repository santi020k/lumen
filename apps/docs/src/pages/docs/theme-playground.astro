---
/* eslint-disable better-tailwindcss/no-unknown-classes */
import {
  Alert,
  Badge,
  Button,
  ButtonGroup,
  Card,
  Field,
  Input,
  Label,
  NumberField,
  Slider,
  Tabs,
  Textarea,
  ThemeBuilder
} from '@santi020k/lumen-astro'
import { createThemeFromHue, lumenTokenNames } from '@santi020k/lumen-core'

import DocsLayout from '../../layouts/DocsLayout.astro'

const defaultHue = 264
const defaultAccentHue = 54
const defaultPrimaryHex = '#6f20f0'
const defaultSecondaryHex = '#ad9e1f'
const defaultScheme = 'light'

const defaultTokens = createThemeFromHue(defaultHue, {
  accentHue: defaultAccentHue,
  scheme: defaultScheme
})

const tokenStyle = Object.entries(defaultTokens)
  .map(([token, value]) => `--${token}: ${value};`)
  .join(' ')

const defaultCss = `:root {
  color-scheme: ${defaultScheme};
${lumenTokenNames.map(token => `  --${token}: ${defaultTokens[token]};`).join('\n')}
}`
---

<DocsLayout
  description="Generate Lumen theme tokens from a brand hue, preview representative primitives, and copy a CSS theme."
  title="Theme playground - Lumen UI"
>
  <nav class="mb-6 text-sm text-ink-soft" aria-label="Breadcrumb">
    <a class="
      text-ink-soft no-underline
      hover:text-ink
    " href="/docs">Docs</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page" class="font-bold text-ink">Theme playground</span>
  </nav>

  <div class="mb-8 space-y-3">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="
        text-4xl/tight font-black text-ink
        sm:text-5xl/tight
      ">Theme playground</h1>
      <Badge variant="secondary">Tokens</Badge>
    </div>
    <p class="max-w-3xl text-lg/8 text-ink-soft">
      Generate the Lumen token set from a brand hue, tune the accent hue, preview light and dark
      schemes, and copy CSS ready for your app.
    </p>
  </div>

  <ThemeBuilder
    class="theme-playground"
    data-ui-theme-target="#theme-playground-preview"
    glass="subtle"
  >
    <Card class="theme-playground__controls" variant="muted">
      <div class="theme-playground__section-heading">
        <p>Inputs</p>
        <h2>Build tokens</h2>
      </div>

      <Tabs class="theme-playground__tabs">
        <div role="tablist" aria-label="Theme input mode">
          <button
            aria-controls="theme-generate-panel"
            aria-selected="true"
            data-theme-mode="generated"
            id="theme-generate-tab"
            role="tab"
            type="button"
          >Generate</button>
          <button
            aria-controls="theme-manual-panel"
            aria-selected="false"
            data-theme-mode="manual"
            id="theme-manual-tab"
            role="tab"
            type="button"
          >Manual</button>
        </div>

        <section
          class="theme-playground__tab-panel"
          id="theme-generate-panel"
          role="tabpanel"
          aria-labelledby="theme-generate-tab"
        >
          <Field class="theme-playground__field">
            <Label for="theme-brand-hue">Brand hue</Label>
            <div class="theme-playground__control-row">
              <Slider
                aria-describedby="theme-brand-hue-value"
                data-theme-brand-hue
                id="theme-brand-hue"
                max="359"
                min="0"
                name="brandHue"
                value={String(defaultHue)}
              />
              <NumberField
                aria-label="Brand hue value"
                data-theme-brand-hue-number
                id="theme-brand-hue-value"
                max="359"
                min="0"
                value={String(defaultHue)}
              />
            </div>
          </Field>

          <Field class="theme-playground__field">
            <Label for="theme-accent-hue">Accent hue</Label>
            <div class="theme-playground__control-row">
              <Slider
                aria-describedby="theme-accent-hue-value"
                data-theme-accent-hue
                id="theme-accent-hue"
                max="359"
                min="0"
                name="accentHue"
                value={String(defaultAccentHue)}
              />
              <NumberField
                aria-label="Accent hue value"
                data-theme-accent-hue-number
                id="theme-accent-hue-value"
                max="359"
                min="0"
                value={String(defaultAccentHue)}
              />
            </div>
          </Field>
        </section>

        <section
          class="theme-playground__tab-panel"
          hidden
          id="theme-manual-panel"
          role="tabpanel"
          aria-labelledby="theme-manual-tab"
        >
          <Field class="theme-playground__field">
            <Label for="theme-primary-hex">Primary</Label>
            <div class="theme-playground__hex-row">
              <input
                aria-label="Primary color"
                class="theme-playground__color"
                data-theme-primary-color
                type="color"
                value={defaultPrimaryHex}
              />
              <Input
                autocomplete="off"
                data-theme-primary-hex
                id="theme-primary-hex"
                inputmode="text"
                pattern="^#?[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
                spellcheck="false"
                value={defaultPrimaryHex}
              />
            </div>
          </Field>

          <Field class="theme-playground__field">
            <Label for="theme-secondary-hex">Secondary</Label>
            <div class="theme-playground__hex-row">
              <input
                aria-label="Secondary color"
                class="theme-playground__color"
                data-theme-secondary-color
                type="color"
                value={defaultSecondaryHex}
              />
              <Input
                autocomplete="off"
                data-theme-secondary-hex
                id="theme-secondary-hex"
                inputmode="text"
                pattern="^#?[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
                spellcheck="false"
                value={defaultSecondaryHex}
              />
            </div>
          </Field>
        </section>
      </Tabs>

      <Field class="theme-playground__field">
        <Label id="theme-scheme-label">Preview scheme</Label>
        <ButtonGroup aria-labelledby="theme-scheme-label" class="
          theme-playground__scheme-toggle
        ">
          <Button
            aria-pressed="true"
            data-theme-scheme="light"
            type="button"
            variant="secondary"
          >Light</Button>
          <Button
            aria-pressed="false"
            data-theme-scheme="dark"
            type="button"
            variant="outline"
          >Dark</Button>
        </ButtonGroup>
      </Field>
    </Card>

    <section class="theme-playground__preview-shell" aria-labelledby="theme-preview-title">
      <div class="theme-playground__section-heading">
        <p>Live preview</p>
        <h2 id="theme-preview-title">Representative primitives</h2>
      </div>

      <div
        class="theme-playground__preview"
        data-theme-preview
        id="theme-playground-preview"
        style={`color-scheme: ${defaultScheme}; ${tokenStyle}`}
      >
        <Card class="theme-playground__preview-card" glass="subtle">
          <div class="theme-playground__preview-header">
            <div>
              <Badge variant="secondary">Generated</Badge>
              <h3>Project access</h3>
            </div>
            <Badge variant="success">Ready</Badge>
          </div>

          <Field glass="subtle">
            <Label for="theme-preview-email">Email</Label>
            <Input id="theme-preview-email" placeholder="you@example.com" type="email" />
          </Field>

          <div class="theme-playground__preview-actions">
            <Button>Invite</Button>
            <Button variant="outline">Preview</Button>
          </div>

          <Alert variant="success">
            <strong>Theme applied.</strong>
            <p>The preview reads tokens from this scoped container.</p>
          </Alert>
        </Card>

        <div class="theme-playground__swatches" aria-label="Generated token swatches">
          {lumenTokenNames.map(token => (
            <span>
              <i style={`--swatch: hsl(var(--${token}));`}></i>
              <span>{token}</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <Card class="theme-playground__export" variant="muted">
      <div class="theme-playground__section-heading">
        <p>Export</p>
        <h2>Copy CSS</h2>
      </div>
      <Textarea
        aria-label="Generated theme CSS"
        class="theme-playground__css"
        data-ui-theme-output
        readonly
        rows={18}
      >{defaultCss}</Textarea>
      <Button data-theme-export type="button">Copy CSS</Button>
    </Card>
  </ThemeBuilder>
</DocsLayout>

<script>
  import {
    createThemeFromHue,
    exportThemeCss,
    type LumenThemeTokens,
    lumenTokenNames
  } from '@santi020k/lumen-core'

  type ThemeMode = 'generated' | 'manual'

  type ThemeScheme = 'dark' | 'light'

  const normalizeHue = (value: string | number): number => {
    const parsed = Number(value)

    if (!Number.isFinite(parsed)) return 0

    return ((Math.round(parsed) % 360) + 360) % 360
  }

  const buildThemeCss = (tokens: LumenThemeTokens, scheme: ThemeScheme): string =>
    exportThemeCss(tokens).replace('{', `{\n  color-scheme: ${scheme};`)

  const normalizeHex = (value: string): string | null => {
    const hex = value.trim().replace(/^#/, '')

    if (/^[\da-f]{3}$/i.test(hex)) {
      return `#${[...hex].map(character => `${character}${character}`).join('').toLowerCase()}`
    }

    return /^[\da-f]{6}$/i.test(hex) ? `#${hex.toLowerCase()}` : null
  }

  const hexToHsl = (hex: string): { hue: number, value: string } | null => {
    const normalized = normalizeHex(hex)

    if (!normalized) return null

    const red = Number.parseInt(normalized.slice(1, 3), 16) / 255
    const green = Number.parseInt(normalized.slice(3, 5), 16) / 255
    const blue = Number.parseInt(normalized.slice(5, 7), 16) / 255
    const max = Math.max(red, green, blue)
    const min = Math.min(red, green, blue)
    const lightness = (max + min) / 2
    const delta = max - min
    let hue = 0
    let saturation = 0

    if (delta !== 0) {
      saturation = delta / (1 - Math.abs(2 * lightness - 1))

      if (max === red) {
        hue = 60 * (((green - blue) / delta) % 6)
      } else if (max === green) {
        hue = 60 * ((blue - red) / delta + 2)
      } else {
        hue = 60 * ((red - green) / delta + 4)
      }
    }

    return {
      hue: normalizeHue(hue),
      value: `${normalizeHue(hue)} ${Math.round(saturation * 100)}% ${Math.round(lightness * 100)}%`
    }
  }

  const applyTokens = (target: HTMLElement, tokens: LumenThemeTokens, scheme: ThemeScheme) => {
    target.style.colorScheme = scheme

    for (const token of lumenTokenNames) {
      target.style.setProperty(`--${token}`, tokens[token] ?? '')
    }
  }

  const setHexValidity = (input: HTMLInputElement, isValid: boolean) => {
    if (isValid) {
      input.removeAttribute('aria-invalid')

      return
    }

    input.setAttribute('aria-invalid', 'true')
  }

  const bindSyncedHueInputs = (
    range: HTMLInputElement | null,
    number: HTMLInputElement | null,
    onChange: () => void
  ) => {
    const sync = (source: HTMLInputElement, target: HTMLInputElement | null) => {
      source.value = String(normalizeHue(source.value))

      if (target) {
        target.value = source.value
      }

      onChange()
    }

    range?.addEventListener('input', () => sync(range, number))

    number?.addEventListener('input', () => sync(number, range))
  }

  const initThemePlayground = (root: HTMLElement) => {
    const preview = root.querySelector<HTMLElement>('[data-theme-preview]')
    const output = root.querySelector<HTMLTextAreaElement>('[data-ui-theme-output]')
    const brandHue = root.querySelector<HTMLInputElement>('[data-theme-brand-hue]')
    const brandHueNumber = root.querySelector<HTMLInputElement>('[data-theme-brand-hue-number]')
    const accentHue = root.querySelector<HTMLInputElement>('[data-theme-accent-hue]')
    const accentHueNumber = root.querySelector<HTMLInputElement>('[data-theme-accent-hue-number]')
    const modeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-theme-mode]')]
    const primaryColor = root.querySelector<HTMLInputElement>('[data-theme-primary-color]')
    const primaryHex = root.querySelector<HTMLInputElement>('[data-theme-primary-hex]')
    const secondaryColor = root.querySelector<HTMLInputElement>('[data-theme-secondary-color]')
    const secondaryHex = root.querySelector<HTMLInputElement>('[data-theme-secondary-hex]')
    const exportButton = root.querySelector<HTMLButtonElement>('[data-theme-export]')
    const schemeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-theme-scheme]')]

    if (!preview || !output || !brandHue || !accentHue) return

    let mode: ThemeMode = 'generated'
    let scheme: ThemeScheme = 'light'

    // eslint-disable-next-line complexity
    const update = () => {
      const hue = normalizeHue(brandHue.value)
      const nextAccentHue = normalizeHue(accentHue.value)
      const primary = primaryHex ? hexToHsl(primaryHex.value) : null
      const secondary = secondaryHex ? hexToHsl(secondaryHex.value) : null
      const baseHue = mode === 'manual' ? primary?.hue ?? hue : hue
      const baseAccentHue = mode === 'manual' ? secondary?.hue ?? nextAccentHue : nextAccentHue

      const tokens = createThemeFromHue(baseHue, {
        accentHue: baseAccentHue,
        scheme
      })

      if (mode === 'manual') {
        if (primary) {
          tokens.brand = primary.value

          tokens['brand-solid'] = primary.value
        }

        if (secondary) {
          tokens.accent = secondary.value
        }
      }

      applyTokens(preview, tokens, scheme)

      output.value = buildThemeCss(tokens, scheme)

      root.dispatchEvent(new CustomEvent('ui:theme-change', {
        bubbles: true,
        detail: { hue: baseHue, mode, tokens }
      }))
    }

    bindSyncedHueInputs(brandHue, brandHueNumber, update)

    bindSyncedHueInputs(accentHue, accentHueNumber, update)

    const bindHexInputs = (
      color: HTMLInputElement | null,
      text: HTMLInputElement | null
    ) => {
      const syncColor = () => {
        if (!color || !text) return

        text.value = color.value

        setHexValidity(text, true)

        update()
      }

      const syncText = () => {
        if (!color || !text) return

        const normalized = normalizeHex(text.value)

        setHexValidity(text, Boolean(normalized))

        if (normalized) {
          color.value = normalized

          text.value = normalized
        }

        update()
      }

      color?.addEventListener('input', syncColor)

      text?.addEventListener('change', syncText)

      text?.addEventListener('input', () => {
        const normalized = normalizeHex(text.value)

        setHexValidity(text, Boolean(normalized))

        if (normalized) {
          if (color) color.value = normalized

          update()
        }
      })
    }

    bindHexInputs(primaryColor, primaryHex)

    bindHexInputs(secondaryColor, secondaryHex)

    for (const button of modeButtons) {
      button.addEventListener('click', () => {
        const nextMode = button.dataset.themeMode

        if (nextMode !== 'generated' && nextMode !== 'manual') return

        mode = nextMode

        update()
      })
    }

    for (const button of schemeButtons) {
      button.addEventListener('click', () => {
        const nextScheme = button.dataset.themeScheme

        if (nextScheme !== 'dark' && nextScheme !== 'light') return

        scheme = nextScheme

        for (const option of schemeButtons) {
          const isPressed = option === button

          option.setAttribute('aria-pressed', String(isPressed))

          option.classList.toggle('ui-button--secondary', isPressed)

          option.classList.toggle('ui-button--outline', !isPressed)
        }

        update()
      })
    }

    exportButton?.addEventListener('click', async () => {
      await navigator.clipboard?.writeText(output.value).catch(() => null)

      root.dispatchEvent(new CustomEvent('ui:theme-export', {
        bubbles: true,
        detail: { css: output.value }
      }))
    })

    update()
  }

  const initThemePlaygrounds = () => {
    for (const root of document.querySelectorAll<HTMLElement>('.theme-playground')) {
      if (root.dataset.themePlaygroundBound === 'true') continue

      root.dataset.themePlaygroundBound = 'true'

      initThemePlayground(root)
    }
  }

  document.addEventListener('astro:page-load', initThemePlaygrounds)

  initThemePlaygrounds()
</script>

<style>
  .theme-playground {
    display: grid;
    gap: 1rem;
  }

  .theme-playground__controls,
  .theme-playground__export {
    display: grid;
    gap: 1rem;
    padding: 1rem;
  }

  .theme-playground__section-heading {
    display: grid;
    gap: 0.25rem;
  }

  .theme-playground__section-heading p {
    margin: 0;
    color: hsl(var(--ink-muted));
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .theme-playground__section-heading h2 {
    margin: 0;
    color: hsl(var(--ink));
    font-size: 1.125rem;
    font-weight: 900;
    line-height: 1.3;
  }

  .theme-playground__field {
    gap: 0.5rem;
  }

  .theme-playground__tabs,
  .theme-playground__tab-panel {
    display: grid;
    gap: 1rem;
  }

  .theme-playground__tab-panel[hidden] {
    display: none;
  }

  .theme-playground__control-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.25rem;
    gap: 0.75rem;
    align-items: center;
  }

  .theme-playground__hex-row {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
  }

  .theme-playground__color {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem;
    background: hsl(var(--surface));
    cursor: pointer;
    padding: 0.2rem;
  }

  .theme-playground__color::-webkit-color-swatch-wrapper {
    padding: 0;
  }

  .theme-playground__color::-webkit-color-swatch {
    border: 0;
    border-radius: 0.25rem;
  }

  .theme-playground__color::-moz-color-swatch {
    border: 0;
    border-radius: 0.25rem;
  }

  :global(.theme-playground .ui-slider) {
    height: 1.75rem;
    appearance: none;
    border-radius: 999px;
    background: transparent;
  }

  :global(.theme-playground .ui-slider:focus-visible) {
    outline: 0;
  }

  :global(.theme-playground .ui-slider::-webkit-slider-runnable-track) {
    height: 0.4rem;
    border-radius: 999px;
    background: linear-gradient(90deg, hsl(var(--brand-solid)), hsl(var(--brand)));
  }

  :global(.theme-playground .ui-slider::-moz-range-track) {
    height: 0.4rem;
    border-radius: 999px;
    background: linear-gradient(90deg, hsl(var(--brand-solid)), hsl(var(--brand)));
  }

  :global(.theme-playground .ui-slider::-webkit-slider-thumb) {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: -0.375rem;
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: hsl(var(--brand));
    box-shadow: 0 0 0 0.2rem hsl(var(--surface)), 0 2px 8px hsl(var(--brand) / 0.36);
  }

  :global(.theme-playground .ui-slider::-moz-range-thumb) {
    width: 1.15rem;
    height: 1.15rem;
    border: 0;
    border-radius: 999px;
    background: hsl(var(--brand));
    box-shadow: 0 0 0 0.2rem hsl(var(--surface)), 0 2px 8px hsl(var(--brand) / 0.36);
  }

  :global(.theme-playground .ui-slider:focus-visible::-webkit-slider-thumb) {
    box-shadow:
      0 0 0 0.2rem hsl(var(--surface)),
      0 0 0 0.35rem hsl(var(--brand) / 0.32),
      0 2px 8px hsl(var(--brand) / 0.36);
  }

  :global(.theme-playground .ui-slider:focus-visible::-moz-range-thumb) {
    box-shadow:
      0 0 0 0.2rem hsl(var(--surface)),
      0 0 0 0.35rem hsl(var(--brand) / 0.32),
      0 2px 8px hsl(var(--brand) / 0.36);
  }

  .theme-playground__scheme-toggle {
    width: fit-content;
  }

  .theme-playground__preview-shell {
    display: grid;
    gap: 0.75rem;
  }

  .theme-playground__preview {
    display: grid;
    gap: 1rem;
    overflow: hidden;
    border: 1px solid hsl(var(--line));
    border-radius: 0.5rem;
    background:
      linear-gradient(135deg, hsl(var(--brand) / 0.14), transparent 35%),
      linear-gradient(315deg, hsl(var(--accent) / 0.14), transparent 38%),
      hsl(var(--canvas));
    color: hsl(var(--ink));
    padding: 1rem;
  }

  .theme-playground__preview-card {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
    padding: 1rem;
  }

  .theme-playground__preview-header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: start;
    justify-content: space-between;
  }

  .theme-playground__preview-header h3 {
    margin: 0.35rem 0 0;
    color: hsl(var(--ink));
    font-size: 1.35rem;
    font-weight: 900;
    line-height: 1.25;
  }

  .theme-playground__preview-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .theme-playground__swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.5rem;
  }

  .theme-playground__swatches > span {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem;
    background: hsl(var(--surface) / 0.78);
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-weight: 750;
    padding: 0.5rem;
  }

  .theme-playground__swatches i {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    flex: 0 0 auto;
    border: 1px solid hsl(var(--line));
    border-radius: 999px;
    background: var(--swatch);
  }

  .theme-playground__css {
    min-height: 20rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  @media (min-width: 1024px) {
    .theme-playground {
      grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.35fr);
      align-items: start;
    }

    .theme-playground__export {
      grid-column: 1 / -1;
    }
  }
</style>

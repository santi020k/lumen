---
import {
  Breadcrumb,
  Card,
  ErrorSummary,
  Field,
  FieldError,
  Form,
  Input,
  Label,
  Link,
  PasswordField,
  Stack
} from '@santi020k/lumen-astro'

import CodeBlock from '../../../components/CodeBlock.astro'
import DocsActionLink from '../../../components/DocsActionLink.astro'
import DocsPageHero from '../../../components/DocsPageHero.astro'
import DocsLayout from '../../../layouts/DocsLayout.astro'

const nativeExample = `---
import { Button, Field, FieldError, Form, Input, Label } from '@santi020k/lumen-astro'
---

<Form action="/profile" method="POST">
  <Field controlId="email" describedBy="email-error">
    <Label for="email">Email</Label>
    <Input
      aria-describedby="email-error"
      id="email"
      name="email"
      required
      type="email"
    />
    <FieldError id="email-error" />
  </Field>
  <Button type="submit">Save profile</Button>
</Form>`

const ownership = [
  ['Lumen', 'Controls, labels, hints, errors, summaries, pending presentation, native values, and reset behavior.'],
  ['Browser', 'FormData, constraint validation, autofill, password managers, ordinary POST, and no-JavaScript fallback.'],
  ['Integration', 'React Hook Form state or Astro Action parsing and server validation when the application opts in.'],
  ['Application', 'Business rules, authorization, persistence, rate limits, redirects, and domain-specific copy.']
] as const
---

<DocsLayout
  description="Build accessible native-first forms with Lumen in Astro, React, and Web Components."
  title="Forms - Lumen UI"
>
  <div class="framework-page">
    <Breadcrumb class="docs-breadcrumb">
      <ol>
        <li><Link href="/docs">Docs</Link></li>
        <li><span aria-current="page">Forms</span></li>
      </ol>
    </Breadcrumb>

    <DocsPageHero
      description="One accessible field contract, native submission by default, and focused adapters when a framework should own form state."
      eyebrow="Form system"
      stats={[
        { label: 'Baseline', value: 'Native' },
        { label: 'Validation', value: 'Composable' },
        { label: 'Targets', value: '3' }
      ]}
      title="Forms that keep the platform working"
    >
      <Fragment slot="actions">
        <DocsActionLink href="#building-blocks">Start with the primitives</DocsActionLink>
        <DocsActionLink href="/docs/forms/react-hook-form" variant="outline">React Hook Form</DocsActionLink>
      </Fragment>
    </DocsPageHero>

    <section class="docs-section space-y-5" aria-labelledby="architecture-title">
      <div class="docs-section-heading">
        <h2 class="text-2xl font-bold text-ink" id="architecture-title">Architecture</h2>
        <p class="max-w-3xl text-sm/7 text-ink-soft">
          Lumen does not replace a form state manager or server framework. It makes controls,
          errors, and submission states consistent while preserving native browser behavior.
        </p>
      </div>
      <div class="
        grid gap-4
        md:grid-cols-2
      "
      >
        {ownership.map(([owner, responsibility]) => (
          <Card class="space-y-2" variant="muted">
            <h3 class="font-bold text-ink">{owner}</h3>
            <p class="text-sm/6 text-ink-soft">{responsibility}</p>
          </Card>
        ))}
      </div>
    </section>

    <section class="docs-section mt-10 space-y-5" aria-labelledby="building-blocks">
      <div class="docs-section-heading">
        <h2 class="text-2xl font-bold text-ink" id="building-blocks">Building blocks</h2>
        <p class="max-w-3xl text-sm/7 text-ink-soft">
          Form is a real form element. Field owns the relationship between its Label, hint, control,
          and FieldError. ErrorSummary collects failures after submit. PasswordField and ListBox
          preserve native submitted controls behind their enhanced presentation.
        </p>
      </div>

      <Card>
        <Form class="space-y-5" status="error">
          <ErrorSummary
            errors={{
              fields: [{
                controlId: 'forms-demo-email',
                message: 'Enter a complete email address.',
                name: 'email'
              }],
              form: []
            }}
          />
          <Field controlId="forms-demo-email" data-invalid="true" describedBy="forms-demo-email-error">
            <Label for="forms-demo-email">Email</Label>
            <Input
              aria-describedby="forms-demo-email-error"
              aria-invalid="true"
              id="forms-demo-email"
              name="email"
              type="email"
              value="maya@example"
            />
            <FieldError id="forms-demo-email-error" message="Enter a complete email address." />
          </Field>
          <PasswordField
            autocomplete="new-password"
            hint="Use at least 12 characters."
            name="password"
          />
        </Form>
      </Card>
      <CodeBlock code={nativeExample} lang="astro" />
    </section>

    <section class="docs-section mt-10 space-y-5" aria-labelledby="choose-title">
      <div class="docs-section-heading">
        <h2 class="text-2xl font-bold text-ink" id="choose-title">Choose one validation owner</h2>
      </div>
      <Stack gap="md">
        <Card variant="muted">
          <h3 class="font-bold text-ink">Native mode</h3>
          <p class="mt-2 text-sm/6 text-ink-soft">
            Use Form plus native attributes such as required, pattern, min, and max. Astro and
            Elements can enhance the same validity events; React can use useFormValidation.
          </p>
        </Card>
        <Card variant="muted">
          <h3 class="font-bold text-ink">Managed React mode</h3>
          <p class="mt-2 text-sm/6 text-ink-soft">
            React Hook Form owns validation and touched/dirty state. Lumen reflects the result.
            Do not mount useFormValidation on the same form unless duplicate validation is intentional.
          </p>
        </Card>
        <Card variant="muted">
          <h3 class="font-bold text-ink">Server-first Astro mode</h3>
          <p class="mt-2 text-sm/6 text-ink-soft">
            Astro Actions parse and validate the POST. Render returned values and normalized errors
            on the server, then redirect after success.
          </p>
        </Card>
      </Stack>
    </section>

    <section class="docs-section mt-10 space-y-4" aria-labelledby="guides-title">
      <h2 class="text-2xl font-bold text-ink" id="guides-title">Integration guides</h2>
      <div class="
        grid gap-4
        md:grid-cols-3
      "
      >
        <Card><Link href="/docs/forms/react-hook-form">React Hook Form adapters</Link></Card>
        <Card><Link href="/docs/forms/astro-actions">Astro Actions and native POST</Link></Card>
        <Card><Link href="/docs/forms/elements">Form-associated Elements</Link></Card>
      </div>
    </section>
  </div>
</DocsLayout>

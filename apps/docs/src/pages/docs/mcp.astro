---
import { Badge, Card, Icon, Link } from '@santi020k/lumen-astro'

import DocsActionLink from '../../components/DocsActionLink.astro'
import DocsPageHero from '../../components/DocsPageHero.astro'
import McpGuideLayout from '../../components/McpGuideLayout.astro'
import { mcpGuideTopics, npmUrl, packageName, readmeUrl, resources, tools } from '../../data/mcp-guides'
import { nativeComponentDocs } from '../../data/native-components'
import { documentedComponentCount } from '../../data/site-metadata'

const movedSections = [
  { id: 'setup-title', href: '/docs/mcp/clients#setup-title', label: 'Client configuration' },
  { id: 'plugin-title', href: '/docs/mcp/clients#plugin-title', label: 'ChatGPT and Codex plugin' },
  { id: 'claude-plugin-title', href: '/docs/mcp/clients#claude-plugin-title', label: 'Claude Code plugin' },
  { id: 'tools-title', href: '/docs/mcp/reference#tools-title', label: 'MCP tools' },
  { id: 'resources-title', href: '/docs/mcp/reference#resources-title', label: 'MCP resources' },
  { id: 'workflow-title', href: '/docs/mcp/reference#workflow-title', label: 'Agent workflow' }
]
---

<McpGuideLayout
  description="Give AI agents the Lumen component catalog. Choose client setup or explore the MCP tool and resource reference for web and native development."
  title="MCP server overview — Lumen UI"
>
    <DocsPageHero
      description="A Model Context Protocol server that gives AI agents structured access to Lumen web and native contracts, platform usage, recipes, design tokens, resources, and generation rules."
      eyebrow="AI integration"
      stats={[
        { label: 'Tools', value: tools.length },
        { label: 'Resources', value: resources.length },
        { label: 'Web components', value: documentedComponentCount },
        { label: 'Native components', value: nativeComponentDocs.length }
      ]}
      title="Give agents the Lumen contract."
    >
      <Fragment slot="actions">
        <DocsActionLink
          href={npmUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on npm
          <Icon decorative name="arrow-up-right" size="sm" />
        </DocsActionLink>
        <DocsActionLink
          href={readmeUrl}
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
        >Read the README
        </DocsActionLink>
      </Fragment>

      <div class="mcp-hero-card" slot="visual" aria-label="MCP tools preview">
        <div>
          <span><Icon decorative name="list" /></span>
          <p><strong>lumen_list_components</strong><small>Discover primitives</small></p>
        </div>
        <div>
          <span><Icon decorative name="component" /></span>
          <p><strong>lumen_get_native_component</strong><small>Native contracts</small></p>
        </div>
        <div>
          <span><Icon decorative name="scroll-text" /></span>
          <p><strong>lumen_get_rules</strong><small>Stay on-system</small></p>
        </div>
      </div>
    </DocsPageHero>

  <section class="mcp-section" aria-labelledby="explore-mcp-title">
    <div class="mcp-section__heading">
      <div><p>Your next step</p><h2 id="explore-mcp-title">Connect. Discover. Build.</h2></div>
      <p>Connect your preferred client, then use the reference when you need a specific contract or tool.</p>
    </div>
    <div class="mcp-guide-topics">
      {mcpGuideTopics.slice(1).map((topic, index) => (
        <Card class="mcp-guide-topic" variant="muted">
          <Icon decorative name={index === 0 ? 'plug' : 'book-open'} />
          <h3>{topic.label}</h3>
          <p>{topic.description}</p>
          <DocsActionLink href={topic.href} variant="outline">{topic.label}<Icon decorative name="arrow-right" size="sm" /></DocsActionLink>
        </Card>
      ))}
    </div>
  </section>

    <Card as="section" class="mcp-file-card" aria-labelledby="package-title" glass="subtle">
      <div>
        <Badge>npm package</Badge>
        <h2 id="package-title">{packageName}</h2>
        <p>
          The deterministic snapshot is generated from the component registry, documentation API
          rows and examples, Astro and React declarations, Web Component definitions, tokens,
          recipes, accessibility interactions, runtime events, and llms.txt.
        </p>
      </div>
      <code>npx -y {packageName}</code>
      <DocsActionLink
        href={npmUrl}
        target="_blank"
        rel="noopener noreferrer"
      >Open on npm
      </DocsActionLink>
    </Card>

  <nav class="mcp-legacy-links" aria-label="MCP quick links" data-mcp-moved-sections>
    {movedSections.map(section => <Link id={section.id} href={section.href}>{section.label}</Link>)}
  </nav>
</McpGuideLayout>

<script>
  const followMovedSection = (): void => {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-mcp-moved-sections] a')
    const destination = Array.from(links).find(link => `#${link.id}` === location.hash)

    if (destination) location.replace(destination.href)
  }

  followMovedSection()

  document.addEventListener('astro:page-load', followMovedSection)

  window.addEventListener('hashchange', followMovedSection)
</script>

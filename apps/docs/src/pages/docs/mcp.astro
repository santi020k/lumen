---
/* eslint-disable better-tailwindcss/no-unknown-classes */
import { Badge, Card, Icon } from '@santi020k/lumen-astro'
import { lumenComponentNames } from '@santi020k/lumen-core'

import DocsActionLink from '../../components/DocsActionLink.astro'
import DocsPageHero from '../../components/DocsPageHero.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const packageName = '@santi020k/lumen-mcp'
const npmUrl = 'https://www.npmjs.com/package/@santi020k/lumen-mcp'
const readmeUrl = 'https://github.com/santi020k/lumen/blob/main/packages/mcp/README.md'

const tools = [
  [
    'lumen_list_components',
    'List every component with its framework availability and recipe membership. Filter by framework, recipe, or a name query.',
    'list'
  ],
  [
    'lumen_get_component',
    'Return framework-specific imports, styles, props or attributes, examples, accessibility behavior, events, and optional source.',
    'component'
  ],
  [
    'lumen_get_recipe',
    'Return a recipe’s purpose, categories, components, files, and framework-specific install command.',
    'blocks'
  ],
  [
    'lumen_search',
    'Rank tolerant natural-language matches across descriptions, framework contracts, recipes, tokens, and rules.',
    'search'
  ],
  [
    'lumen_get_meta',
    'Return the schema version, package versions, component count, and deterministic catalog hash.',
    'fingerprint'
  ],
  [
    'lumen_get_catalog_manifest',
    'Return stable fingerprints for every component and recipe so clients can retain a known baseline.',
    'notebook-tabs'
  ],
  [
    'lumen_diff_catalog',
    'Compare a retained manifest with the current catalog and identify exactly which entries changed.',
    'git-compare-arrows'
  ],
  [
    'lumen_diagnose',
    'Verify snapshot integrity and report framework coverage when testing a new connection.',
    'stethoscope'
  ],
  [
    'lumen_get_tokens',
    'Return semantic token names, base color values, glass tokens, and the theme attribute for generated code.',
    'swatch-book'
  ],
  [
    'lumen_get_rules',
    'Return the Lumen agent rules (llms.txt) to read before producing Lumen code.',
    'scroll-text'
  ]
] as const

const workflow = [
  ['01', 'Verify the snapshot', 'lumen_get_meta identifies the snapshot and lumen_diagnose verifies its integrity and framework coverage.'],
  ['02', 'Discover', 'The agent calls lumen_list_components or lumen_search with the target framework to find the right primitives.'],
  ['03', 'Read framework usage', 'lumen_get_component returns authored examples and the required Astro runtime, React hook, or Elements registration contract.'],
  ['04', 'Compose a recipe', 'lumen_get_recipe explains multi-component patterns and gives the correct framework install command.'],
  ['05', 'Track changes', 'Retain lumen://catalog-manifest and compare it after upgrades to refresh only contracts that changed.']
] as const

const resources = [
  ['lumen://meta', 'Snapshot provenance, package versions, and deterministic catalog hash.'],
  ['lumen://catalog-manifest', 'Stable component and recipe fingerprints for change detection.'],
  ['lumen://diagnostics', 'Snapshot integrity checks and framework coverage.'],
  ['lumen://rules', 'Agent generation rules as Markdown.'],
  ['lumen://tokens', 'Structured semantic, color, glass, and theme tokens.'],
  ['lumen://components', 'Compact structured component catalog.'],
  ['lumen://components/{name}', 'One component’s metadata and default Astro usage.'],
  ['lumen://recipes/{name}', 'Recipe metadata and framework install commands.']
] as const

const claudeConfig = `{
  "mcpServers": {
    "lumen": {
      "command": "npx",
      "args": ["-y", "@santi020k/lumen-mcp"]
    }
  }
}`

const cursorConfig = `{
  "mcpServers": {
    "lumen": {
      "command": "npx",
      "args": ["-y", "@santi020k/lumen-mcp"]
    }
  }
}`

const codexConfig = `[mcp_servers.lumen]
enabled = true
command = "npx"
args = ["-y", "@santi020k/lumen-mcp"]
startup_timeout_sec = 10.0
tool_timeout_sec = 30.0`

const genericConfig = `{
  "name": "lumen",
  "transport": "stdio",
  "command": "npx",
  "args": ["-y", "@santi020k/lumen-mcp"]
}`

const httpCommand = `npx -y --package @santi020k/lumen-mcp lumen-mcp-http
# MCP endpoint: http://127.0.0.1:3000/mcp
# Health check: http://127.0.0.1:3000/health`
---

<DocsLayout
  description="Connect the Lumen MCP server so AI agents can discover components, read framework contracts and recipes, and follow Lumen tokens and rules."
  title="MCP server - Lumen UI"
>
  <div class="mcp-page">
    <DocsPageHero
      description="A Model Context Protocol server that gives AI agents structured access to Lumen component contracts, framework usage, recipes, design tokens, resources, and generation rules."
      eyebrow="AI integration"
      stats={[
        { label: 'Tools', value: tools.length },
        { label: 'Resources', value: resources.length },
        { label: 'Components', value: lumenComponentNames.length },
      ]}
      title="Give agents the Lumen contract."
    >
      <Fragment slot="actions">
        <DocsActionLink
          href={npmUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on npm
          <Icon decorative name="arrow-up-right" size="sm" />
        </DocsActionLink>
        <DocsActionLink
          href={readmeUrl}
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
        >Read the README</DocsActionLink>
      </Fragment>

      <div class="mcp-hero-card" slot="visual" aria-label="MCP tools preview">
        <div>
          <span><Icon decorative name="list" /></span>
          <p><strong>lumen_list_components</strong><small>Discover primitives</small></p>
        </div>
        <div>
          <span><Icon decorative name="component" /></span>
          <p><strong>lumen_get_component</strong><small>Framework contracts</small></p>
        </div>
        <div>
          <span><Icon decorative name="scroll-text" /></span>
          <p><strong>lumen_get_rules</strong><small>Stay on-system</small></p>
        </div>
      </div>
    </DocsPageHero>

    <section class="mcp-section" aria-labelledby="tools-title">
      <div class="mcp-section__heading">
        <div>
          <p>What agents can do</p>
          <h2 id="tools-title">Focused MCP tools</h2>
        </div>
        <p>
          Every tool returns readable text plus validated structured content, grounded in the same
          catalog, docs, framework source, tokens, and rules the packages ship.
        </p>
      </div>

      <div class="mcp-tools">
        {tools.map(([name, description, icon]) => (
          <Card class="mcp-tool-card" variant="muted">
            <span class="mcp-tool-card__icon">
              <Icon decorative name={icon} />
            </span>
            <code>{name}</code>
            <p>{description}</p>
          </Card>
        ))}
      </div>
    </section>

    <section class="mcp-section" aria-labelledby="setup-title">
      <div class="mcp-section__heading">
        <div>
          <p>Connect a client</p>
          <h2 id="setup-title">Run with npx over stdio or HTTP</h2>
        </div>
        <p>
          The server ships a self-contained snapshot of the catalog, so no repository checkout is
          required. With Node.js 20.20 or newer, point any MCP client at
          <code>npx -y {packageName}</code>.
        </p>
      </div>

      <div class="mcp-setup">
        <Card class="mcp-setup-card" variant="muted">
          <div class="mcp-setup-card__head">
            <Badge variant="outline">Codex</Badge>
            <span>.codex/config.toml</span>
          </div>
          <pre><code>{codexConfig}</code></pre>
          <p>Or run <code>codex mcp add lumen -- npx -y {packageName}</code>.</p>
        </Card>

        <Card class="mcp-setup-card" variant="muted">
          <div class="mcp-setup-card__head">
            <Badge variant="outline">Claude Desktop</Badge>
            <span>claude_desktop_config.json</span>
          </div>
          <pre><code>{claudeConfig}</code></pre>
        </Card>

        <Card class="mcp-setup-card" variant="muted">
          <div class="mcp-setup-card__head">
            <Badge variant="outline">Cursor</Badge>
            <span>.cursor/mcp.json</span>
          </div>
          <pre><code>{cursorConfig}</code></pre>
        </Card>

        <Card class="mcp-setup-card" variant="muted">
          <div class="mcp-setup-card__head">
            <Badge variant="outline">Any stdio client</Badge>
            <span>generic shape</span>
          </div>
          <pre><code>{genericConfig}</code></pre>
        </Card>

        <Card class="mcp-setup-card" variant="muted">
          <div class="mcp-setup-card__head">
            <Badge variant="outline">Streamable HTTP</Badge>
            <span>local or self-hosted</span>
          </div>
          <pre><code>{httpCommand}</code></pre>
          <p>Public deployments must add TLS, authentication, rate limiting, and an allowed-host configuration.</p>
        </Card>
      </div>
    </section>

    <section class="mcp-section" aria-labelledby="resources-title">
      <div class="mcp-section__heading">
        <div>
          <p>Stable context</p>
          <h2 id="resources-title">Browsable MCP resources</h2>
        </div>
        <p>
          Clients can read or cache stable catalog context without calling a tool. Component and
          recipe templates are enumerable and support name completion.
        </p>
      </div>

      <div class="mcp-resources">
        {resources.map(([uri, description]) => (
          <Card class="mcp-resource-card" variant="muted">
            <code>{uri}</code>
            <p>{description}</p>
          </Card>
        ))}
      </div>
    </section>

    <section class="mcp-section" aria-labelledby="workflow-title">
      <div class="mcp-section__heading">
        <div>
          <p>How agents use it</p>
          <h2 id="workflow-title">Discover, read, and stay on-system</h2>
        </div>
        <p>
          Start compact, read the target framework’s usage contract, and request full source only
          when the imports, examples, accessibility notes, and API rows are insufficient.
        </p>
      </div>

      <ol class="mcp-workflow">
        {workflow.map(([step, title, description]) => (
          <li>
            <span>{step}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <Card as="section" class="mcp-file-card" aria-labelledby="package-title" glass="subtle">
      <div>
        <Badge>npm package</Badge>
        <h2 id="package-title">{packageName}</h2>
        <p>
          The deterministic snapshot is generated from the component registry, documentation API
          rows and examples, Astro and React declarations, Web Component definitions, tokens,
          recipes, accessibility interactions, runtime events, and llms.txt.
        </p>
      </div>
      <code>npx -y {packageName}</code>
      <DocsActionLink
        href={npmUrl}
        target="_blank"
        rel="noopener noreferrer"
      >Open on npm</DocsActionLink>
    </Card>
  </div>
</DocsLayout>

<style>
  .mcp-page {
    display: grid;
    gap: 3.5rem;
  }

  .mcp-hero-card {
    display: grid;
    gap: 0.55rem;
    padding: 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.1rem;
    background: hsl(var(--canvas) / 0.62);
    backdrop-filter: blur(14px);
  }

  .mcp-hero-card > div {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem;
    border-radius: 0.75rem;
    background: hsl(var(--surface) / 0.75);
  }

  .mcp-hero-card span {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid hsl(var(--line));
    border-radius: 0.65rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }

  .mcp-hero-card p {
    display: grid;
    margin: 0;
  }

  .mcp-hero-card strong {
    color: hsl(var(--ink));
    font: 800 0.78rem/1.3 ui-monospace, monospace;
  }

  .mcp-hero-card small {
    color: hsl(var(--ink-muted));
    font-size: 0.7rem;
  }

  .mcp-section {
    display: grid;
    gap: 1.4rem;
  }

  .mcp-section__heading {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  .mcp-section__heading > div > p {
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mcp-section__heading h2,
  .mcp-file-card h2 {
    margin-top: 0.25rem;
    color: hsl(var(--ink));
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  .mcp-section__heading > p,
  .mcp-file-card p {
    max-width: 40rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .mcp-section__heading code,
  .mcp-file-card code {
    color: hsl(var(--ink));
    font-family: ui-monospace, monospace;
    font-size: 0.82em;
  }

  .mcp-tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.85rem;
  }

  .mcp-tool-card {
    display: flex;
    min-height: 12rem;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.15rem;
  }

  .mcp-tool-card__icon {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border-radius: 0.7rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }

  .mcp-tool-card code {
    color: hsl(var(--ink));
    font-family: ui-monospace, monospace;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .mcp-tool-card p {
    color: hsl(var(--ink-soft));
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .mcp-setup {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.85rem;
  }

  .mcp-setup-card {
    display: grid;
    gap: 0.85rem;
    padding: 1.15rem;
  }

  .mcp-setup-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .mcp-setup-card__head span {
    color: hsl(var(--ink-muted));
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
  }

  .mcp-setup-card pre {
    overflow-x: auto;
    margin: 0;
    padding: 0.9rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.75rem;
    background: hsl(var(--surface-strong) / 0.5);
  }

  .mcp-setup-card code {
    color: hsl(var(--ink));
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .mcp-setup-card > p,
  .mcp-resource-card p {
    color: hsl(var(--ink-soft));
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .mcp-setup-card > p code {
    color: hsl(var(--ink));
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }

  .mcp-resources {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.85rem;
  }

  .mcp-resource-card {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
  }

  .mcp-resource-card code {
    overflow-wrap: anywhere;
    color: hsl(var(--brand));
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 750;
  }

  .mcp-workflow {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mcp-workflow li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid hsl(var(--line));
  }

  .mcp-workflow li > span {
    color: hsl(var(--brand));
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .mcp-workflow li div {
    display: grid;
    gap: 0.35rem;
  }

  .mcp-workflow h3 {
    color: hsl(var(--ink));
    font-size: 0.95rem;
    font-weight: 850;
  }

  .mcp-workflow p {
    color: hsl(var(--ink-soft));
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .mcp-file-card {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .mcp-file-card > code {
    overflow: hidden;
    color: hsl(var(--ink-muted));
    font-size: 0.72rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mcp-file-card > :global(.ui-button) {
    width: max-content;
  }

  @media (min-width: 48rem) {
    .mcp-section__heading {
      grid-template-columns: minmax(13rem, 0.8fr) minmax(18rem, 1fr);
      align-items: end;
    }

    .mcp-file-card {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .mcp-file-card > :global(.ui-button) {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>

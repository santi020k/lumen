---
import { createElement } from 'react'
import { renderToStaticMarkup } from 'react-dom/server'

import '../../styles/global.css'

import { Container, Prose, Stack } from '@santi020k/lumen-astro'
import { Code as ReactCode, Image as ReactImage, Prose as ReactProse } from '@santi020k/lumen-react'

type Adapter = 'astro' | 'react' | 'elements'

const imageRadii = ['none', 'sm', 'md', 'lg', 'full'] as const

const radiusImages = (id: string) => imageRadii.map(radius => renderToStaticMarkup(
  createElement(ReactImage, {
    alt: `Image with ${radius} corners`,
height: 50,
width: 80,
    id: `${id}-radius-${radius}`,
radius,
src: '/comparison-before.svg'
  })
)).join('')

// Static authored HTML represents already-rendered CMS content; Prose does not parse or sanitize it.
const content = (adapter: Adapter) => `
<section>
  <h2 id="${adapter}-heading">Read <em>what matters</em> first</h2>
  <p>${'Keep content readable as its container, theme, and text size change. '.repeat(8)}</p>
  <blockquote cite="https://lumen.santi020k.com/guides/build-an-editorial-article">
    <p>A reading surface keeps the authored words and their source together.</p>
    <footer>From <cite>Example editorial notes</cite></footer>
  </blockquote>
  <figure id="${adapter}-figure">
    <img src="/comparison-before.svg" width="960" height="600" alt="Illustrated mountains reflected in a lake">
    <figcaption>A native caption remains attached to its illustration. <a href="#${adapter}-details">Read the context</a>.</figcaption>
  </figure>
  <h3 id="${adapter}-details">The original context</h3>
  <p><a href="#${adapter}-heading">${'a-long-reference-'.repeat(12)}</a></p>
</section>
${radiusImages(adapter)}
${renderToStaticMarkup(createElement(ReactCode, { code: 'const readable = true', id: `${adapter}-code`, label: 'Owned code caption', language: 'ts', variant: 'block' }))}`

const reactMarkup = renderToStaticMarkup(createElement(ReactProse, {
  appearance: 'editorial',
className: 'reading-prose',
id: 'react-prose',
  dangerouslySetInnerHTML: { __html: content('react') }
}))
---

<!doctype html>
<html lang="en" data-theme="light">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex, nofollow" /><title>Editorial prose examples</title></head>
  <body>
    <Container as="main" size="lg"><Stack gap="section">
      <h1>Editorial prose examples</h1>
      <Prose appearance="editorial" class="reading-prose" id="astro-prose"><Fragment set:html={content('astro')} /></Prose>
      <Fragment set:html={reactMarkup} />
      <lumen-prose appearance="editorial" class="reading-prose" id="elements-prose"><Fragment set:html={content('elements')} /></lumen-prose>
      <Prose id="default-prose"><h2>Default prose</h2><blockquote><p>Existing appearance stays available.</p></blockquote><Fragment set:html={radiusImages('default')} /></Prose>
      <div id="radius-reference"><Fragment set:html={radiusImages('reference')} /></div>
    </Stack></Container>
  </body>
</html>

<script>
  import { defineLumenElements } from '@santi020k/lumen-elements'

  defineLumenElements()
</script>

<style>
  :global(.reading-prose) { --ui-prose-measure: 35ch; display: block; }
</style>

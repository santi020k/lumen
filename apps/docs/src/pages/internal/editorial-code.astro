---
import '../../styles/global.css'

import { Container, Stack } from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import CodeBlock from '../../components/CodeBlock.astro'

const code = Array.from({ length: 30 }, (_, index) => `const line${index + 1} = "Example ${index + 1}: a deliberately wide source line for keyboard scrolling and exact clipboard verification"`).join('\n')
---

<!doctype html>
<html lang="en" data-theme="light">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex, nofollow" /><title>Editorial code examples</title></head>
  <body>
    <Container as="main" size="md">
      <Stack gap="group">
        <h1>Editorial code examples</h1>
        <CodeBlock code={code} lang="ts" title="Long example with a filename that remains readable at narrow widths" />
        <CodeBlock code={code} collapsible={false} lang="ts" title="Always expanded" />
        <CodeBlock code="pnpm add @santi020k/lumen-astro" lang="bash" title="Install Lumen" />
      </Stack>
    </Container>
    <UIPrimitives />
  </body>
</html>

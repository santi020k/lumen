---
import { createElement } from 'react'
import { renderToString } from 'react-dom/server'

import '@santi020k/lumen/styles.css'

import { ReactReveal } from '../../components/internal/ReactReveal'
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <script is:inline>
      const scenario = new URLSearchParams(window.location.search)

      document.documentElement.dataset.theme = scenario.get('theme') === 'dark' ? 'dark' : 'light'

      document.documentElement.style.fontSize = scenario.get('textScale') === '2' ? '200%' : '100%'
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>React reveal verification — Lumen</title>
  </head>
  <body>
    <main>
      <h1>React reveal examples</h1>
      <p>Single and grouped entrances at normal and enlarged text sizes.</p>
      <div id="react-reveal" set:html={renderToString(createElement(ReactReveal))} />
    </main>
    <script>
      import { createElement } from 'react'
      import { hydrateRoot } from 'react-dom/client'

      import { ReactReveal } from '../../components/internal/ReactReveal'

      const island = document.getElementById('react-reveal')

      if (island) hydrateRoot(island, createElement(ReactReveal))
    </script>
  </body>
</html>

<style is:global>
  body { margin: 0; background: hsl(var(--canvas)); color: hsl(var(--ink)); font-family: var(--ui-font); }
  main { max-width: 68rem; margin-inline: auto; padding: 1rem; }
  h1, h2, h3, p { overflow-wrap: anywhere; }
  section { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-block: 2rem; }
  section > * { min-width: 0; }
  [data-ui-reveal-group] { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1rem; }
  .ui-card { min-width: 0; padding: 1rem; }
  [data-reveal-spacer] { height: 110vh; }
</style>

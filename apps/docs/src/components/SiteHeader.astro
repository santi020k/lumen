---
import { Badge, Button } from '@santi020k/lumen-astro'

import LumenLogo from './LumenLogo.astro'
---

<header class="docs-site-header">
  <div class="
    docs-site-header__inner mx-auto flex w-full max-w-7xl flex-wrap items-center
    justify-between gap-4 px-5 py-3
    sm:px-8
  ">
    <a class="flex items-center gap-2.5 text-ink no-underline" href="/">
      <LumenLogo markClass="size-8" />
      <Badge variant="outline">v0.1</Badge>
    </a>
    <nav
      class="
        flex max-w-full flex-wrap items-center justify-start gap-2 text-sm
        font-bold
        sm:ml-auto sm:justify-end
      "
      aria-label="Site"
    >
      <a class="
        text-ink-soft no-underline
        hover:text-ink
      " href="/docs">Docs</a>
      <a class="
        text-ink-soft no-underline
        hover:text-ink
      " href="/docs/components">Components</a>
      <a class="
        text-ink-soft no-underline
        hover:text-ink
        max-sm:hidden
      " href="https://github.com/santi020k/lumen">GitHub</a>
      <div class="ui-theme-controls" aria-label="Theme controls">
        <label class="sr-only" for="site-color-theme">Theme</label>
        <select
          id="site-color-theme"
          class="ui-theme-select"
          data-theme-select
          aria-label="Theme"
        >
          <option value="santi020k">Santi020k</option>
          <option value="lumen">Lumen</option>
        </select>
        <Button
          class="ui-theme-toggle"
          size="icon"
          variant="outline"
          data-theme-toggle
          aria-label="Switch color mode"
          title="Switch color mode"
        >
          <span class="ui-theme-toggle__icon" aria-hidden="true">
            <span class="ui-theme-toggle__sun"></span>
            <span class="ui-theme-toggle__moon"></span>
          </span>
          <span class="sr-only" data-theme-toggle-label>Switch color mode</span>
        </Button>
      </div>
    </nav>
  </div>
</header>

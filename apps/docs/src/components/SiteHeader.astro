---
import { Badge, Button, Icon } from '@santi020k/lumen-astro'

import LumenLogo from './LumenLogo.astro'

const currentPath = Astro.url.pathname

const navLinks = [
  {
    href: '/docs',
    icon: 'book-open',
    isActive: currentPath === '/docs' || (
      currentPath.startsWith('/docs/') && !currentPath.startsWith('/docs/components')
    ),
    label: 'Docs'
  },
  {
    href: '/docs/components',
    icon: 'blocks',
    isActive: currentPath.startsWith('/docs/components'),
    label: 'Components'
  }
] as const
---

<header class="docs-site-header">
  <div class="
    docs-site-header__inner mx-auto flex w-full max-w-7xl items-center
    justify-between gap-3 px-5 py-3
    sm:px-8
  ">
    <a class="docs-site-header__brand text-ink no-underline" href="/">
      <LumenLogo markClass="size-8" />
      <Badge variant="outline">v0.1</Badge>
    </a>
    <nav
      class="
        docs-site-header__nav flex max-w-full items-center justify-end gap-1
        text-sm font-bold
      "
      aria-label="Site"
    >
      {navLinks.map(link => (
        <a
          class:list={[
            'docs-site-header__link no-underline',
            link.isActive && 'docs-site-header__link--active'
          ]}
          href={link.href}
          aria-current={link.isActive ? 'page' : undefined}
        >
          <Icon name={link.icon} size="sm" />
          <span>{link.label}</span>
        </a>
      ))}
      <a
        class="docs-site-header__github no-underline"
        href="https://github.com/santi020k/lumen"
      >
        <Icon name="github" size="sm" />
        <span>GitHub</span>
      </a>
      <div class="ui-theme-controls" aria-label="Theme controls">
        <label class="sr-only" for="site-color-theme">Theme</label>
        <select
          id="site-color-theme"
          class="ui-theme-select"
          data-theme-select
          aria-label="Theme"
        >
          <option value="santi020k">Santi020k</option>
          <option value="lumen">Lumen</option>
        </select>
        <Button
          class="ui-theme-toggle"
          size="icon"
          variant="outline"
          data-theme-toggle
          aria-label="Switch color mode"
          title="Switch color mode"
        >
          <span class="ui-theme-toggle__icon" aria-hidden="true">
            <span class="ui-theme-toggle__sun"></span>
            <span class="ui-theme-toggle__moon"></span>
          </span>
          <span class="sr-only" data-theme-toggle-label>Switch color mode</span>
        </Button>
      </div>
    </nav>
  </div>
</header>

---
import {
  Badge,
  Icon,
  Label,
  Link,
  NativeSelect,
  NavigationMenu,
  ThemeToggle
} from '@santi020k/lumen-astro'
import { lumenComponentNames } from '@santi020k/lumen-core'

import {
  getActiveSiteNavigationIndex,
  siteNavigationItems
} from '../data/site-navigation'

import DocsContextNavigation from './DocsContextNavigation.astro'
import GitHubIcon from './GitHubIcon.astro'
import GlobalDocsSearch from './GlobalDocsSearch.astro'
import LumenLogo from './LumenLogo.astro'

const currentPath = Astro.url.pathname
const hasDocsContext = currentPath.startsWith('/docs') || currentPath === '/changelog'
const activeIndex = getActiveSiteNavigationIndex(currentPath)
const componentCount = lumenComponentNames.length
---

<div class="docs-site-header">
  <header class="docs-header-shell" data-site-header>
    <Link class="docs-header-brand no-underline" href="/" aria-label="Lumen UI home">
      <LumenLogo markClass="size-7" />
      <Badge class="docs-header-count" variant="outline">{componentCount}</Badge>
    </Link>

    <NavigationMenu class="docs-nav-track" aria-label="Primary" style={`--item-count:${siteNavigationItems.length};--active-index:${activeIndex};`}>
      {activeIndex >= 0 && <span class="docs-nav-indicator" aria-hidden="true"></span>}
      {siteNavigationItems.map((link, index) => (
        <Link
          class:list={[
            'docs-nav-link no-underline',
            index === activeIndex && 'docs-nav-link--active'
          ]}
          href={link.href}
          aria-current={index === activeIndex ? 'page' : undefined}
        >
          {link.label}
        </Link>
      ))}
    </NavigationMenu>

    <div class="docs-header-actions">
      <GlobalDocsSearch />

      <Link
        class="docs-header-github no-underline"
        href="https://github.com/santi020k/lumen"
        aria-label="Lumen on GitHub"
      >
        <GitHubIcon />
        <span>GitHub</span>
      </Link>

      <div class="docs-theme-controls" aria-label="Theme controls">
        <div class="docs-theme-picker">
          <Icon aria-hidden="true" name="palette" size="sm" />
          <Label class="sr-only" for="site-color-theme">Theme family</Label>
          <NativeSelect
            id="site-color-theme"
            class="docs-theme-select"
            data-theme-select
            aria-label="Theme family"
            size="sm"
          >
            <option value="lumen">Lumen</option>
            <option value="santi020k">Santi020k</option>
          </NativeSelect>
        </div>
        <span class="docs-theme-divider" aria-hidden="true"></span>
        <ThemeToggle
          class="docs-theme-toggle"
          controlled
          data-theme-toggle
          aria-label="Switch color mode"
          title="Switch color mode"
        />
      </div>
    </div>
  </header>
  {hasDocsContext && <DocsContextNavigation currentPath={currentPath} />}
</div>

<script>
  let siteHeaderScrollController: AbortController | undefined

  const initSiteHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-site-header]')

    if (!header) return

    siteHeaderScrollController?.abort()

    siteHeaderScrollController = new AbortController()

    const onScroll = () => {
      header.dataset.scrolled = String(window.scrollY > 8)
    }

    onScroll()

    window.addEventListener('scroll', onScroll, {
      passive: true,
      signal: siteHeaderScrollController.signal
    })
  }

  initSiteHeader()

  document.addEventListener('astro:after-swap', initSiteHeader)
</script>

---
import { Icon, NativeSelect, NavigationMenu } from '@santi020k/lumen-astro'

import GitHubIcon from './GitHubIcon.astro'
import LumenLogo from './LumenLogo.astro'

const currentPath = Astro.url.pathname

const navLinks = [
  {
    href: '/',
    isActive: currentPath === '/',
    label: 'Home'
  },
  {
    href: '/docs',
    isActive: currentPath === '/docs' || (
      currentPath.startsWith('/docs/')
      && !currentPath.startsWith('/docs/components')
      && !currentPath.startsWith('/docs/theme-playground')
    ),
    label: 'Docs'
  },
  {
    href: '/docs/components',
    isActive: currentPath.startsWith('/docs/components'),
    label: 'Components'
  },
  {
    href: '/docs/theme-playground',
    isActive: currentPath.startsWith('/docs/theme-playground'),
    label: 'Theme'
  }
] as const

const activeIndex = Math.max(0, navLinks.findIndex(link => link.isActive))
---

<div class="docs-site-header">
  <header class="docs-header-shell" data-site-header>
    <a class="docs-header-brand no-underline" href="/">
      <LumenLogo markClass="size-7" />
    </a>

    <NavigationMenu class="docs-nav-track" aria-label="Main menu" style={`--item-count:${navLinks.length};--active-index:${activeIndex};`}>
      <span class="docs-nav-indicator" aria-hidden="true"></span>
      {navLinks.map(link => (
        <a
          class:list={[
            'docs-nav-link no-underline',
            link.isActive && 'docs-nav-link--active'
          ]}
          href={link.href}
          aria-current={link.isActive ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </NavigationMenu>

    <div class="docs-header-actions">
      <a
        class="docs-header-github no-underline"
        href="https://github.com/santi020k/lumen"
        aria-label="Lumen on GitHub"
      >
        <GitHubIcon />
        <span>GitHub</span>
      </a>

      <div class="docs-theme-controls" aria-label="Theme controls">
        <label class="sr-only" for="site-color-theme">Theme</label>
        <NativeSelect
          id="site-color-theme"
          class="docs-theme-select"
          data-theme-select
          aria-label="Theme"
        >
          <option value="santi020k">Santi020k</option>
          <option value="lumen">Lumen</option>
        </NativeSelect>
        <button
          class="docs-theme-toggle"
          type="button"
          data-theme-toggle
          aria-label="Switch color mode"
          title="Switch color mode"
        >
          <Icon class="docs-theme-toggle__sun" name="sun" size="sm" aria-hidden="true" />
          <Icon class="docs-theme-toggle__moon" name="moon" size="sm" aria-hidden="true" />
          <span class="sr-only" data-theme-toggle-label>Switch color mode</span>
        </button>
      </div>
    </div>
  </header>
</div>

<script>
  const initSiteHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-site-header]')

    if (!header) return

    const onScroll = () => {
      header.dataset.scrolled = String(window.scrollY > 8)
    }

    onScroll()

    window.addEventListener('scroll', onScroll, { passive: true })
  }

  initSiteHeader()

  document.addEventListener('astro:after-swap', initSiteHeader)
</script>

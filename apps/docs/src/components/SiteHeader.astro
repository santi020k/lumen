---
import { Badge, Button } from '@santi020k/lumen-astro'
---

<header class="
  sticky top-0 z-40 border-b border-line bg-canvas/90 backdrop-blur
">
  <div class="
    mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-5 py-3
    sm:px-8
  ">
    <a class="
      flex items-center gap-2 text-sm font-black tracking-wide text-ink
      no-underline
    " href="/">
      <span class="
        inline-block size-2.5 rounded-full bg-brand
      " aria-hidden="true"></span>
      Lumen UI
      <Badge variant="outline">v0.1</Badge>
    </a>
    <nav class="flex items-center gap-4 text-sm font-bold" aria-label="Site">
      <a class="
        text-ink-soft no-underline
        hover:text-ink
      " href="/docs">Docs</a>
      <a class="
        text-ink-soft no-underline
        hover:text-ink
      " href="/docs/components">Components</a>
      <a class="
        text-ink-soft no-underline
        hover:text-ink
      " href="https://github.com/santi020k/lumen">GitHub</a>
      <Button size="sm" variant="outline" data-theme-toggle aria-label="Toggle color theme">Theme</Button>
    </nav>
  </div>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark'

    root.dataset.theme = next

    localStorage.setItem('lumen-theme', next)
  })
</script>

---
import { Link } from '@santi020k/lumen-astro'

import { mcpGuideTopics } from '../data/mcp-guides'
import DocsLayout from '../layouts/DocsLayout.astro'
import type { DocsPageNavigationItem } from '../lib/docs-page-navigation'

interface Props {
  title: string
  description: string
  pageNavigation?: DocsPageNavigationItem[] | false
}

const { title, description, pageNavigation = false } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '')
const activeTopic = mcpGuideTopics.find(topic => topic.href === currentPath)
const breadcrumbs = [{ href: '/docs/mcp', label: 'MCP server' }]

if (activeTopic && currentPath !== '/docs/mcp') breadcrumbs.push({ href: activeTopic.href, label: activeTopic.label })
---

<DocsLayout title={title} description={description} breadcrumbs={breadcrumbs} pageNavigation={pageNavigation}>
  <div class="mcp-page">
    <nav class="mcp-guide-navigation" aria-label="MCP guide">
      {mcpGuideTopics.map(topic => (
        <Link href={topic.href} aria-current={topic.href === currentPath ? 'page' : undefined}>{topic.label}</Link>
      ))}
    </nav>
    <slot />
  </div>
</DocsLayout>

<style is:global>
  .mcp-page {
    display: grid;
    gap: 3.5rem;
  }

  .mcp-hero-card {
    display: grid;
    gap: 0.55rem;
    padding: 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.1rem;
    background: hsl(var(--canvas) / 0.62);
    backdrop-filter: blur(14px);
  }

  .mcp-hero-card > div {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem;
    border-radius: 0.75rem;
    background: hsl(var(--surface) / 0.75);
  }

  .mcp-hero-card span {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid hsl(var(--line));
    border-radius: 0.65rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }

  .mcp-hero-card p {
    display: grid;
    margin: 0;
  }

  .mcp-hero-card strong {
    color: hsl(var(--ink));
    font: 800 0.78rem/1.3 ui-monospace, monospace;
  }

  .mcp-hero-card small {
    color: hsl(var(--ink-soft));
    font-size: 0.7rem;
  }

  .mcp-section {
    display: grid;
    gap: 1.4rem;
  }

  .mcp-section__heading {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  .mcp-section__heading > div > p {
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mcp-section__heading h2,
  .mcp-file-card h2 {
    margin-top: 0.25rem;
    color: hsl(var(--ink));
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.025em;
  }

  .mcp-section__heading > p,
  .mcp-file-card p {
    max-width: 40rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .mcp-section__heading code,
  .mcp-file-card code {
    color: hsl(var(--ink));
    font-family: ui-monospace, monospace;
    font-size: 0.82em;
  }

  .mcp-tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.85rem;
  }

  .mcp-tool-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.15rem;
  }

  .mcp-tool-card__icon {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border-radius: 0.7rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }

  .mcp-tool-card code {
    overflow-wrap: anywhere;
    color: hsl(var(--ink));
    font-family: ui-monospace, monospace;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .mcp-tool-card p {
    color: hsl(var(--ink-soft));
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .mcp-resource-card p {
    color: hsl(var(--ink-soft));
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .mcp-resources {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.85rem;
  }

  .mcp-resource-card {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
  }

  .mcp-resource-card code {
    overflow-wrap: anywhere;
    color: hsl(var(--brand));
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .mcp-workflow {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mcp-workflow li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid hsl(var(--line));
  }

  .mcp-workflow li > span {
    color: hsl(var(--brand));
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .mcp-workflow li div {
    display: grid;
    gap: 0.35rem;
  }

  .mcp-workflow h3 {
    color: hsl(var(--ink));
    font-size: 0.95rem;
    font-weight: 800;
  }

  .mcp-workflow p {
    color: hsl(var(--ink-soft));
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .mcp-file-card {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .mcp-file-card > div {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .mcp-file-card > code {
    overflow: hidden;
    color: hsl(var(--ink-soft));
    font-size: 0.72rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mcp-file-card > .ui-button {
    width: max-content;
  }

  @media (min-width: 48rem) {
    .mcp-section__heading {
      grid-template-columns: minmax(13rem, 0.8fr) minmax(18rem, 1fr);
      align-items: end;
    }

    .mcp-file-card {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .mcp-file-card > .ui-button {
      grid-column: 2;
      grid-row: 1;
    }
  }

  .mcp-guide-navigation { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-bottom: 1rem; border-bottom: 1px solid hsl(var(--line)); }
  .mcp-guide-navigation a { padding: 0.55rem 0.85rem; border-radius: 0.5rem; color: hsl(var(--ink-soft)); font-size: 0.8125rem; font-weight: 700; text-decoration: none; }
  .mcp-guide-navigation a[aria-current='page'] { color: hsl(var(--brand)); background: hsl(var(--brand-soft)); }
  .mcp-guide-navigation a:hover { color: hsl(var(--ink)); background: hsl(var(--surface-muted)); }
  .mcp-guide-topics { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1rem; }
  .mcp-guide-topic { display: grid; gap: 0.75rem; padding: 1.5rem; }
  .mcp-guide-topic h3 { font-size: 1.15rem; font-weight: 800; }
  .mcp-guide-topic p { color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.7; }
  .mcp-legacy-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; padding-top: 1rem; border-top: 1px solid hsl(var(--line)); font-size: 0.8125rem; }
  .mcp-client-notes { display: grid; gap: 1rem; font-size: 0.875rem; line-height: 1.7; color: hsl(var(--ink-soft)); }
</style>

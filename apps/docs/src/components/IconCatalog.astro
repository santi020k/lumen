---
import { Button, Collapsible, Input, Label } from '@santi020k/lumen-astro'

import { type IconEntry, iconPageSize } from '../lib/icon-catalog'

interface Props {
  description: string
  emptyMessage?: string
  entries: IconEntry[]
  eyebrow?: string
  id: string
  searchLabel: string
  source: string
  title: string
}

const {
  description,
  emptyMessage = 'No icons match your search.',
  entries,
  eyebrow = 'Complete set',
  id,
  searchLabel,
  source,
  title
} = Astro.props

const searchId = `${id}-search`
---

<section
  data-icon-catalog
  data-icon-source={source}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div data-icon-catalog-heading>
    <div>
      <p>{eyebrow}</p>
      <h2 id={`${id}-title`}>{title}</h2>
    </div>
    <p>{description}</p>
  </div>

  <div data-icon-catalog-search>
    <Label for={searchId}>{searchLabel}</Label>
    <Input
      autocomplete="off"
      data-icon-search
      disabled
      id={searchId}
      placeholder={`Search ${entries.length} icons by name...`}
      spellcheck="false"
      type="search"
    />
    <p data-icon-status aria-live="polite" aria-atomic="true">
      Showing <span data-icon-visible-count>{Math.min(iconPageSize, entries.length)}</span> of {entries.length} icons
    </p>
  </div>

  <p data-icon-empty hidden>
    {emptyMessage}
  </p>

  <div data-icon-grid>
    {entries.slice(0, iconPageSize).map(entry => (
      <Button
        data-icon-name={entry.name}
        data-icon-terms={entry.terms}
        variant="ghost"
        title={`Copy "${entry.name}"`}
      >
        <span class="ui-icon ui-icon--xl" aria-hidden="true" set:html={entry.svg} />
        <span data-icon-label>{entry.name}</span>
      </Button>
    ))}
  </div>

  <template data-icon-template>
    <Button variant="ghost">
      <span class="ui-icon ui-icon--xl" aria-hidden="true" data-icon-art />
      <span data-icon-label />
    </Button>
  </template>
  <Button data-icon-more hidden variant="outline">Show more icons</Button>
  <Collapsible>
    <summary>All icon names</summary>
    <p data-icon-names>{entries.map(entry => entry.name).join(', ')}</p>
  </Collapsible>
  <noscript><p>Use your browser’s Find command to search all icon names below.</p></noscript>
</section>

<script>
  import { setupIconCatalogs } from '../lib/icon-catalog-client'

  setupIconCatalogs()

  document.addEventListener('astro:page-load', setupIconCatalogs)
</script>

<style is:global>
  [data-icon-catalog] {
    display: grid;
    gap: 1.4rem;
    scroll-margin-top: 6rem;
  }

  [data-icon-catalog-heading] {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  [data-icon-catalog-heading] > div > p {
    color: hsl(var(--brand));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  [data-icon-catalog-heading] h2 {
    margin-top: 0.25rem;
    color: hsl(var(--ink));
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  [data-icon-catalog-heading] > p {
    max-width: 36rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    line-height: 1.65;
  }

  [data-icon-catalog-search] {
    display: grid;
    gap: 0.55rem;
    max-width: 46rem;
  }

  [data-icon-catalog-search] label {
    color: hsl(var(--ink));
    font-size: 0.8rem;
    font-weight: 850;
  }

  [data-icon-catalog-search] input {
    height: 3.25rem;
    border-radius: 0.9rem;
    font-size: 1rem;
  }

  [data-icon-catalog-search] p {
    color: hsl(var(--ink-soft));
    font-size: 0.8rem;
  }

  [data-icon-empty] {
    padding: 3rem 1rem;
    border: 1px dashed hsl(var(--line));
    border-radius: 1rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9rem;
    text-align: center;
  }

  [data-icon-grid] {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: 0.6rem;
  }

  [data-icon-grid] button {
    display: flex;
    aspect-ratio: 1;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.9rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink-soft));
    cursor: pointer;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease,
      transform 150ms ease;
  }

  [data-icon-grid] .ui-button__content {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  [data-icon-names] {
    margin-top: 1rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  [data-icon-grid] button:hover {
    border-color: hsl(var(--brand));
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
    transform: translateY(-2px);
  }

  [data-icon-grid] [data-icon-label] {
    overflow: hidden;
    width: 100%;
    color: hsl(var(--ink-soft));
    font-size: 0.63rem;
    line-height: 1.2;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    [data-icon-catalog-heading] {
      grid-template-columns: minmax(13rem, 0.8fr) minmax(18rem, 1fr);
      align-items: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-icon-grid] button {
      transition: none;
    }

    [data-icon-grid] button:hover {
      transform: none;
    }
  }
</style>

---
import {
  Badge,
  Button,
  ButtonGroup,
  ButtonLink,
  CodeTabs,
  Icon,
  ThemeToggle
} from '@santi020k/lumen-astro'

import type { FrameworkSnippet } from '../lib/snippets'

interface Props {
  componentName: string
  examplePath?: string
  groupId: string
  previewClass?: string
  snippets: FrameworkSnippet[]
}

const {
  componentName,
  examplePath = `apps/docs/src/examples/${componentName}.astro`,
  groupId,
  previewClass = 'component-doc-preview',
  snippets
} = Astro.props

const componentSlug = componentName
  .replaceAll(/([a-z0-9])([A-Z])/g, '$1-$2')
  .toLowerCase()

const stackBlitzUrl = new URL('https://stackblitz.com/~/github.com/santi020k/lumen')

stackBlitzUrl.searchParams.set('file', examplePath)

stackBlitzUrl.searchParams.set(['initial', 'path'].join(''), `/docs/components/${componentSlug}`)

stackBlitzUrl.searchParams.set('startScript', 'docs:dev')

const codeTabItems = snippets.map(snippet => ({
  code: snippet.code,
  label: snippet.label,
  language: snippet.lang,
  value: snippet.label.toLowerCase()
}))
---

<div class="framework-example" data-framework-example={groupId}>
  <div class="framework-example__toolbar">
    <div class="framework-example__target" aria-live="polite">
      <Badge variant="secondary">
        <Icon decorative name="blocks" size="sm" />
        <span data-framework-label>Astro</span>
      </Badge>
      <span>Same visual contract, native framework API</span>
    </div>
    <div class="framework-example__tools">
      <ButtonGroup aria-label="Preview width">
        <Button
          aria-label="Desktop preview width"
          aria-pressed="true"
          data-playground-width="desktop"
          size="icon"
          variant="ghost"
        >
          <Icon decorative name="monitor" size="sm" />
        </Button>
        <Button
          aria-label="Tablet preview width"
          aria-pressed="false"
          data-playground-width="tablet"
          size="icon"
          variant="ghost"
        >
          <Icon decorative name="tablet" size="sm" />
        </Button>
        <Button
          aria-label="Phone preview width"
          aria-pressed="false"
          data-playground-width="phone"
          size="icon"
          variant="ghost"
        >
          <Icon decorative name="smartphone" size="sm" />
        </Button>
      </ButtonGroup>
      <span class="framework-example__tool-divider" aria-hidden="true"></span>
      <ThemeToggle
        aria-label="Toggle playground color theme"
        class="framework-example__icon-button"
      />
      <Button
        aria-label="Toggle preview grid"
        aria-pressed="false"
        data-playground-grid
        size="icon"
        variant="ghost"
      >
        <Icon decorative name="grid-3x3" size="sm" />
      </Button>
      <Button
        aria-label="View preview fullscreen"
        data-playground-fullscreen
        size="icon"
        variant="ghost"
      >
        <Icon decorative name="maximize" size="sm" />
      </Button>
      <Button
        aria-label="Reset playground"
        data-playground-reset
        size="icon"
        variant="ghost"
      >
        <Icon decorative name="rotate-ccw" size="sm" />
      </Button>
    </div>
  </div>

  <div class="framework-example__canvas" data-playground-canvas data-playground-grid-visible="false">
    <div
      class:list={[previewClass, 'docs-preview', 'framework-example__preview']}
      data-playground-preview
      data-playground-viewport="desktop"
    >
      <slot />
    </div>
  </div>

  <div class="framework-example__code">
    <div>
      <p>Framework usage</p>
      <span>
        Switch targets to compare the adapter code. The preview stays visually stable because all
        three packages share the same tokens and <code>ui-*</code> class contract.
      </span>
    </div>
    <div class="framework-example__code-actions">
      <CodeTabs
        ariaLabel="Framework"
        class="framework-example__code-tabs"
        items={codeTabItems}
        storageKey="lumen-docs-framework"
      />
      <ButtonLink
        class="framework-example__browser-link"
        href={stackBlitzUrl.toString()}
        newTab
        showArrow
        variant="secondary"
      >
        Edit {componentName} in browser
      </ButtonLink>
    </div>
  </div>
</div>

<script>
  const initializeFrameworkExamples = () => {
    for (const example of document.querySelectorAll<HTMLElement>('[data-framework-example]')) {
      if (example.dataset.frameworkExampleReady === 'true') continue

      example.dataset.frameworkExampleReady = 'true'

      const label = example.querySelector<HTMLElement>('[data-framework-label]')
      const tabsRoot = example.querySelector<HTMLElement>('.framework-example__code-tabs')
      const canvas = example.querySelector<HTMLElement>('[data-playground-canvas]')
      const preview = example.querySelector<HTMLElement>('[data-playground-preview]')
      const gridButton = example.querySelector<HTMLButtonElement>('[data-playground-grid]')
      const fullscreenButton = example.querySelector<HTMLButtonElement>('[data-playground-fullscreen]')
      const resetButton = example.querySelector<HTMLButtonElement>('[data-playground-reset]')
      const widthButtons = example.querySelectorAll<HTMLButtonElement>('[data-playground-width]')

      const setViewport = (viewport: string) => {
        if (preview) preview.dataset.playgroundViewport = viewport

        for (const button of widthButtons) {
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.playgroundWidth === viewport)
          )
        }
      }

      const setGridVisible = (visible: boolean) => {
        if (canvas) canvas.dataset.playgroundGridVisible = String(visible)

        gridButton?.setAttribute('aria-pressed', String(visible))
      }

      const updateLabel = () => {
        const selectedTab = tabsRoot?.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]')
        const framework = selectedTab?.textContent?.trim()

        if (framework && label) label.textContent = framework
      }

      tabsRoot?.addEventListener('ui:tabs-change', updateLabel)

      for (const button of widthButtons) {
        button.addEventListener('click', () => {
          setViewport(button.dataset.playgroundWidth ?? 'desktop')
        })
      }

      gridButton?.addEventListener('click', () => {
        setGridVisible(gridButton.getAttribute('aria-pressed') !== 'true')
      })

      fullscreenButton?.addEventListener('click', () => {
        if (!canvas?.requestFullscreen) return

        void canvas.requestFullscreen()
      })

      resetButton?.addEventListener('click', () => {
        setViewport('desktop')

        setGridVisible(false)

        preview?.scrollTo({ left: 0, top: 0 })
      })

      requestAnimationFrame(updateLabel)
    }
  }

  initializeFrameworkExamples()

  document.addEventListener('astro:page-load', initializeFrameworkExamples)
</script>

<style>
  .framework-example {
    display: grid;
    gap: 0;
    min-width: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--line));
    border-radius: 1.15rem;
    background: hsl(var(--surface));
    box-shadow: 0 18px 40px hsl(var(--ink) / 0.04);
  }

  .framework-example__toolbar,
  .framework-example__target,
  .framework-example__tools {
    display: flex;
    align-items: center;
  }

  .framework-example__toolbar {
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px solid hsl(var(--line));
    background: hsl(var(--surface-muted) / 0.64);
    padding: 0.75rem 0.9rem;
  }

  .framework-example__target {
    flex-wrap: wrap;
    gap: 0.65rem;
    color: hsl(var(--ink-muted));
    font-size: 0.75rem;
    font-weight: 700;
  }

  .framework-example__target :global(.ui-badge) {
    gap: 0.35rem;
  }

  .framework-example__tools {
    gap: 0.3rem;
  }

  .framework-example__tools :global(.ui-button-group) {
    gap: 0.15rem;
    border-radius: 999px;
    background: hsl(var(--surface) / 0.8);
    padding: 0.15rem;
  }

  .framework-example__tools :global(.ui-button),
  .framework-example__tools :global(.ui-theme-toggle) {
    width: 2.15rem;
    min-width: 2.15rem;
    height: 2.15rem;
    min-height: 2.15rem;
    padding: 0;
  }

  .framework-example__tools :global([aria-pressed="true"]) {
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand-solid));
  }

  .framework-example__tool-divider {
    width: 1px;
    height: 1.4rem;
    margin-inline: 0.15rem;
    background: hsl(var(--line));
  }

  .framework-example__canvas {
    display: grid;
    min-height: 15rem;
    overflow: auto;
    background: hsl(var(--canvas));
    padding: 1rem;
  }

  .framework-example__canvas[data-playground-grid-visible="true"] {
    background-color: hsl(var(--canvas));
    background-image:
      linear-gradient(hsl(var(--line) / 0.45) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--line) / 0.45) 1px, transparent 1px);
    background-size: 1rem 1rem;
  }

  .framework-example__canvas:fullscreen {
    align-content: center;
    padding: clamp(1rem, 4vw, 4rem);
  }

  .framework-example__preview {
    align-self: center;
    justify-self: center;
    transition: max-width 180ms ease, box-shadow 180ms ease;
  }

  .framework-example__preview[data-playground-viewport="tablet"] {
    max-width: 48rem;
  }

  .framework-example__preview[data-playground-viewport="phone"] {
    max-width: 24rem;
  }

  .framework-example__canvas .framework-example__preview {
    min-height: 13rem;
    border: 0;
    border-radius: 0.85rem;
    background:
      radial-gradient(circle at 5% 0%, hsl(var(--brand) / 0.09), transparent 35%),
      linear-gradient(145deg, hsl(var(--surface)), hsl(var(--surface-muted) / 0.74));
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.12),
      0 1rem 2.5rem hsl(var(--ink) / 0.08);
  }

  .framework-example__code {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
    border-top: 1px solid hsl(var(--line));
    padding: 1rem;
  }

  .framework-example__code > div:first-child {
    display: grid;
    gap: 0.2rem;
  }

  .framework-example__code-actions {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }

  .framework-example__browser-link {
    justify-self: start;
  }

  .framework-example__code p,
  .framework-example__code span {
    margin: 0;
  }

  .framework-example__code p {
    color: hsl(var(--ink));
    font-size: 0.78rem;
    font-weight: 900;
  }

  .framework-example__code > div:first-child > span {
    max-width: 48rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .framework-example__tools {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.15rem;
    }

    .framework-example__canvas {
      padding: 0.75rem;
    }
  }
</style>

---
interface Props {
  class?: string
  markClass?: string
  showText?: boolean
}

const {
  class: className = '',
  markClass = 'size-8',
  showText = true
} = Astro.props
---

<span class:list={['lumen-logo', className]}>
  <svg
    class:list={['shrink-0', markClass]}
    viewBox="0 0 64 64"
    role={showText ? undefined : 'img'}
    aria-hidden={showText ? 'true' : undefined}
    aria-label={showText ? undefined : 'Lumen UI'}
  >
    <rect width="64" height="64" rx="16" fill="hsl(var(--lumen-logo-mark))" />
    <rect x="5" y="5" width="54" height="54" rx="13" fill="none" stroke="hsl(var(--lumen-logo-on-mark) / 0.22)" stroke-width="1.5" />
    <g fill="hsl(var(--lumen-logo-on-mark))" transform="translate(7.5 45.5) scale(.049 -.049)">
      <path d="M305 0L21 0L21 38Q54 38 69.5 44.5Q85 51 89 67Q93 83 93 110L93 596Q93 626 79 632.5Q65 639 46 639Q33 639 24 638Q15 637 15 637L15 674L167 706L225 706L225 110Q225 82 230 66Q235 50 252 44Q269 38 305 38Z" />

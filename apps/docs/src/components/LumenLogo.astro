---
interface Props {
  class?: string
  markClass?: string
  showText?: boolean
}

const {
  class: className = '',
  markClass = 'size-8',
  showText = true
} = Astro.props
---

<span class:list={['lumen-logo', className]}>
  <svg
    class:list={['shrink-0', markClass]}
    viewBox="0 0 64 64"
    role={showText ? undefined : 'img'}
    aria-hidden={showText ? 'true' : undefined}
    aria-label={showText ? undefined : 'Lumen UI'}
  >
    <rect width="64" height="64" rx="16" fill="hsl(var(--ink))" />
    <rect
      x="5"
      y="5"
      width="54"
      height="54"
      rx="13"
      fill="none"
      stroke="hsl(var(--surface) / 0.28)"
      stroke-width="1.5"
    />
    <text
      x="9"
      y="45"
      fill="hsl(var(--canvas))"
      font-family="ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif"
      font-size="42"
      font-weight="700"
      letter-spacing="0"
    >lu</text>
    <circle
      cx="50"
      cy="18"
      r="3.75"
      fill="hsl(var(--lumen-logo-dot))"
      stroke="hsl(var(--ink))"
      stroke-width="2"
    />
  </svg>

  {showText && (
    <span class="lumen-logo__wordmark">
      <span class="lumen-logo__name">lumen</span>
      <span class="lumen-logo__ui">ui</span>
    </span>
  )}
</span>

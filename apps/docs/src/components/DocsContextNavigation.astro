---
import {
  ContextNavigation,
  Icon,
  Label,
  Link,
  NavigationMenu,
  Select
} from '@santi020k/lumen-astro'

import { getDocsContextLinks, isDocsContextLinkCurrent } from '../data/docs-context-navigation'
import {
  getDocsPlatform,
  getPlatformGuide,
  productPlatformGuides
} from '../data/platforms'

interface Props {
  currentPath: string
}

const { currentPath } = Astro.props
const activePlatform = getDocsPlatform(currentPath)
const activeGuide = activePlatform ? getPlatformGuide(activePlatform) : undefined
const foundationsGuide = getPlatformGuide('foundations')
const links = getDocsContextLinks(activePlatform)
---

<div
  class="docs-context-navigation"
  data-docs-platform-selector
  data-current-platform={activePlatform ?? ''}
>
  <ContextNavigation class="docs-context-navigation__shell" variant="unstyled">
    <div class="docs-context-navigation__platform" slot="context">
      <Icon decorative name="panels-top-left" size="sm" />
      <div>
        <Label for="docs-context-platform-select">Documentation scope</Label>
        <Select
          id="docs-context-platform-select"
          aria-label="Choose documentation scope"
          data-docs-platform-select
          size="sm"
        >
          <option value="/docs" selected={!activePlatform}>Project overview</option>
          <optgroup label="Shared documentation">
            <option value={foundationsGuide.href} selected={activePlatform === foundationsGuide.id}>
              Shared foundations
            </option>
          </optgroup>
          <optgroup label="Platform documentation">
            {productPlatformGuides.map(guide => (
              <option value={guide.href} selected={activePlatform === guide.id}>{guide.shortLabel}</option>
            ))}
          </optgroup>
        </Select>
      </div>
    </div>

    <NavigationMenu
      class="docs-context-navigation__links"
      aria-label={`${activeGuide?.shortLabel ?? 'All platforms'} documentation`}
      variant="unstyled"
    >
      {links.map(link => {
        const isCurrent = isDocsContextLinkCurrent(link, currentPath)

        return (
          <Link
            class="docs-context-navigation__link no-underline"
            href={link.href}
            data-docs-context-match={link.match}
            aria-current={isCurrent ? 'page' : undefined}
          >
            {link.label}
          </Link>
        )
      })}
    </NavigationMenu>
  </ContextNavigation>
</div>

<script>
  import { getCurrentDocsContextLink } from '../data/docs-context-navigation'

  const syncDocsContextCurrentLink = (): void => {
    const navigation = document.querySelector<HTMLElement>('.docs-context-navigation__links')

    if (!navigation) return

    const anchors = [...navigation.querySelectorAll<HTMLAnchorElement>('a[href]')]

    const current = getCurrentDocsContextLink(anchors.map(anchor => ({
      href: anchor.getAttribute('href') ?? '',
      label: anchor.textContent?.trim() ?? '',
      match: anchor.dataset.docsContextMatch === 'prefix' ? 'prefix' : 'exact'
    })), window.location.pathname, window.location.hash)

    for (const anchor of anchors) {
      if (current && anchor.getAttribute('href') === current.href) {
        anchor.setAttribute('aria-current', current.href.includes('#') ? 'location' : 'page')
      } else {
        anchor.removeAttribute('aria-current')
      }
    }

    const active = anchors.find(anchor => anchor.hasAttribute('aria-current'))

    if (!active) return

    const navigationRect = navigation.getBoundingClientRect()
    const activeRect = active.getBoundingClientRect()

    navigation.scrollLeft += activeRect.left - navigationRect.left -
      (navigation.clientWidth - active.clientWidth) / 2
  }

  const docsPlatformStorageKey = 'lumen-docs-platform'

  const initDocsContextNavigation = (): void => {
    syncDocsContextCurrentLink()

    const container = document.querySelector<HTMLElement>('.docs-context-navigation')

    if (!container || container.dataset.initialized === 'true') return

    const select = container.querySelector<HTMLSelectElement>('[data-docs-platform-select]')

    if (!select) return

    select.addEventListener('change', () => {
      try {
        if (select.value === '/docs') {
          window.localStorage.removeItem(docsPlatformStorageKey)
        } else {
          window.localStorage.setItem(docsPlatformStorageKey, select.value)
        }
      } catch {
        // The selected page still opens when browser storage is unavailable.
      }

      window.location.assign(select.value)
    })

    container.dataset.initialized = 'true'
  }

  initDocsContextNavigation()

  document.addEventListener('astro:after-swap', initDocsContextNavigation)

  document.addEventListener('astro:page-load', syncDocsContextCurrentLink)

  for (const event of ['hashchange', 'popstate', 'pageshow', 'resize']) {
    window.addEventListener(event, syncDocsContextCurrentLink)
  }

  document.addEventListener('click', event => {
    if (!(event.target instanceof Element)) return

    const anchor = event.target.closest('a[href]')

    if (!(anchor instanceof HTMLAnchorElement) || anchor.origin !== window.location.origin ||
      anchor.pathname !== window.location.pathname) return

    // Astro's same-page navigation updates history without a swap or guaranteed hashchange.
    // Read the actual URL after the click handlers finish, including canceled navigation.
    window.setTimeout(syncDocsContextCurrentLink, 0)
  })
</script>

---
import { Badge, ButtonLink, Card, CodeTabs, Icon } from '@santi020k/lumen-astro'

import type { PlatformGuide } from '../data/platforms'
import DocsLayout from '../layouts/DocsLayout.astro'

import CommunityFeedback from './CommunityFeedback.astro'
import NativeLivePreview from './NativeLivePreview.astro'
import PlatformShipping from './PlatformShipping.astro'
import PlatformStoreAvailability from './PlatformStoreAvailability.astro'

interface Props {
  guide: PlatformGuide
}

const { guide } = Astro.props
const commands = guide.playgroundCommands ?? []
---

<DocsLayout
  breadcrumbs={[
    { href: guide.href, label: guide.shortLabel },
    { href: `${guide.href}/playground`, label: 'Playground' }
  ]}
  description={`Try the ${guide.label} playground and use its source as a reference for your own Lumen app.`}
  title={`${guide.shortLabel} playground - Lumen UI`}
>
  <section class="docs-hero docs-intro-hero" aria-labelledby="playground-title">
    <div class="docs-hero__content">
      <Badge variant="outline">{guide.shortLabel} playground</Badge>
      <h1 class="docs-intro-title" id="playground-title">Try every component on {guide.shortLabel}</h1>
      <p class="max-w-2xl text-lg/8 text-ink-soft">
        {guide.playgroundNote ?? `Open the ${guide.shortLabel} gallery and explore Lumen components in their native runtime.`}
      </p>
      <div class="flex flex-wrap gap-3">
        {guide.id === 'react-native' && <ButtonLink href="#preview" showArrow>Try in browser</ButtonLink>}
        <ButtonLink href="#run" showArrow variant={guide.id === 'react-native' ? 'secondary' : 'primary'}>Run the playground</ButtonLink>
        <ButtonLink href={`${guide.href}/components`} variant="secondary">Browse components</ButtonLink>
      </div>
    </div>
    <Card class="docs-hero__surface docs-hero__surface--summary" glass="strong">
      <Icon decorative name="play" size="lg" />
      <h2>Real package, real runtime</h2>
      <p class="text-ink-soft">
        The gallery uses the local Lumen package, so component behavior and tokens match the code in this repository.
      </p>
    </Card>
  </section>

  {guide.storeAvailability && (
    <PlatformStoreAvailability availability={guide.storeAvailability} />
  )}

  {guide.id === 'react-native' && (
    <section class="docs-section" id="preview" aria-labelledby="preview-title">
      <div class="docs-section-heading">
        <p>No setup needed</p>
        <h2 id="preview-title">Try React Native in your browser</h2>
        <p>Explore the web preview, then use the local app to evaluate native device behavior.</p>
      </div>
      <NativeLivePreview embedded={false} guide={{ ...guide, id: 'react-native' }} />
    </section>
  )}

  <section class="docs-section" id="reference" aria-labelledby="reference-title">
    <div class="docs-section-heading">
      <p>From playground to your app</p>
      <h2 id="reference-title">Try it. Read the source. Build with Lumen.</h2>
      <p>
        Search for a component, try its interactive states, and compare light and dark themes.
        Use the open-source app to see how Lumen components fit together, then follow the
        component reference to bring them into your own project.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      {guide.playgroundSource && (
        <ButtonLink href={guide.playgroundSource} newTab showArrow variant="secondary">
          Explore the {guide.shortLabel} app source
        </ButtonLink>
      )}
      <ButtonLink href={`${guide.href}/components`} variant="inline">Read the component reference</ButtonLink>
    </div>
    <p class="mt-4 text-sm/6 text-ink-soft">
      Store releases and the repository can show different versions. Follow the local setup below
      to explore the workspace version; check the app’s release notes when comparing a store build.
    </p>
  </section>

  <section class="docs-section" id="run" aria-labelledby="run-title">
    <div class="docs-section-heading">
      <p>Local gallery</p>
      <h2 id="run-title">Run the {guide.shortLabel} playground</h2>
      <p>Choose the workflow that matches your development environment.</p>
    </div>
    <CodeTabs
      ariaLabel={`${guide.label} playground commands`}
      items={commands}
      storageKey={`lumen-${guide.id}-playground-page`}
    />
    {guide.shippingNotes && <PlatformShipping notes={guide.shippingNotes} />}
  </section>
  <CommunityFeedback documentationPath={`${guide.href}/playground`} subject={`${guide.label} playground`} />
</DocsLayout>

---
import { Card, Icon, Link } from '@santi020k/lumen-astro'

import type { ChartGuide } from '../data/chart-guides'
import { getExample } from '../lib/examples'

interface Props { guide: ChartGuide }

const { guide } = Astro.props
const { component: Preview } = getExample(guide.name)
---
<Card as="article" class="chart-tile" variant="interactive" id={`${guide.slug}-usage`} data-chart-tile data-chart-category={guide.category} data-chart-search={`${guide.name} ${guide.category} ${guide.question} ${guide.description}`.toLowerCase()}>
  <div class="chart-tile-preview" aria-hidden="true" inert data-docs-toc-ignore>
    <div class="chart-tile-stage"><Preview /></div>
  </div>
  <div class="chart-tile-copy">
    <span>{guide.category}</span>
    <h3><Link href={`/docs/components/${guide.slug}`}>{guide.name}<Icon name="arrow-up-right" decorative size="sm" /></Link></h3>
    <p>{guide.question}</p>
  </div>
</Card>
<style>
  .chart-tile { position: relative; min-width: 0; padding: 0; overflow: hidden; }
  .chart-tile-preview { height: 10rem; overflow: hidden; padding: 1rem 1rem 0; background: hsl(var(--surface-muted) / .5); pointer-events: none; }
  .chart-tile-stage { width: 200%; transform: scale(.5); transform-origin: top left; }
  .chart-tile-stage :global(.ui-chart) { margin: 0; padding: 0; border: 0; border-radius: 0; box-shadow: none; background: transparent; }
  .chart-tile-stage :global(.ui-chart > header), .chart-tile-stage :global(figcaption), .chart-tile-stage :global(details), .chart-tile-stage :global(.ui-chart__legend), .chart-tile-stage :global(.ui-chart__summary) { display: none; }
  .chart-tile-stage :global(.ui-sparkline) { width: 100%; height: 10rem; }
  .chart-tile-stage :global(.ui-stat) { display: none; }
  .chart-tile-copy { display: grid; gap: .5rem; padding: 1rem 1.25rem 1.25rem; }
  .chart-tile-copy > span { color: hsl(var(--ink-soft)); font-size: .625rem; text-transform: uppercase; letter-spacing: .1em; }
  .chart-tile h3, .chart-tile p { margin: 0; }
  .chart-tile h3 { font-size: 1rem; font-weight: 650; }
  .chart-tile h3 :global(a) { display: flex; align-items: center; justify-content: space-between; color: hsl(var(--ink)); }
  .chart-tile h3 :global(a::after) { content: ''; position: absolute; inset: 0; }
  .chart-tile:focus-within { outline: 2px solid hsl(var(--brand)); outline-offset: 3px; }
  .chart-tile p { color: hsl(var(--ink-soft)); font-size: .8125rem; line-height: 1.5; }
</style>

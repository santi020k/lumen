---
import { Callout, CodeTabs, Link, Table } from '@santi020k/lumen-astro'

import boxPlotSource from '../examples/BoxPlot.astro?raw'
import bulletSource from '../examples/BulletChart.astro?raw'
import calendarSource from '../examples/CalendarHeatmap.astro?raw'
import dumbbellSource from '../examples/DumbbellChart.astro?raw'
import funnelSource from '../examples/FunnelChart.astro?raw'
import lollipopSource from '../examples/LollipopChart.astro?raw'
import { buildSnippets } from '../lib/snippets'

const charts = [
  ['Read daily activity', 'CalendarHeatmap', 'calendar-heatmap', 'Date-only observations; omitted days stay missing.'],
  ['Compare process stages', 'FunnelChart', 'funnel-chart', 'Nonnegative counts for the same cohort, in your chosen stage order.'],
  ['Compare distributions', 'BoxPlot', 'box-plot', 'Precomputed quartiles, whisker bounds, and explicit outliers.'],
  ['Rank categories', 'LollipopChart', 'lollipop-chart', 'One value per category; sort the rows in your application.'],
  ['Compare two observations', 'DumbbellChart', 'dumbbell-chart', 'Previous and current values in the same unit.'],
  ['Track a target', 'BulletChart', 'bullet-chart', 'One actual value, a target, and optional performance ranges.'],
  ['Follow a trend', 'LineChart', 'line-chart', 'Ordered categories, numeric positions, or elapsed time.'],
  ['Compare magnitudes', 'BarChart', 'bar-chart', 'Categories, grouped series, or meaningful stacked totals.'],
  ['Explain a balance', 'WaterfallChart', 'waterfall-chart', 'Signed changes and explicit total checkpoints.'],
  ['Show a distribution', 'Histogram', 'histogram', 'Your own numeric bins and counts; density for unequal widths.'],
  ['Reveal a matrix', 'Heatmap', 'heatmap', 'Sequential magnitude or differences around a midpoint.'],
  ['Show part of a whole', 'PieChart', 'pie-chart', 'A few nonnegative shares; use bars for precise comparison.'],
  ['Explore a relationship', 'ScatterChart', 'scatter-chart', 'Two numeric measures; optional size for a third.'],
  ['Show an interval', 'RangeChart', 'range-chart', 'Low and high values in the same unit.'],
  ['Combine marks', 'ComboChart', 'combo-chart', 'Bars and lines sharing a meaningful value domain.'],
  ['Add a compact trend', 'Sparkline', 'sparkline', 'A supporting trend beside a metric, with a descriptive label.']
] as const

const recipes = [
  {
    name: 'CalendarHeatmap',
slug: 'calendar-heatmap',
title: 'See the rhythm of a week.',
    description: 'Use a calendar when the day itself matters. This example includes an observed zero and an unavailable day, which remain visibly different.',
    source: calendarSource,
    note: 'Use YYYY-MM-DD dates and an inclusive startDate/endDate range. Duplicate dates and observations outside the range are invalid. weekStartsOn=1 starts on Monday; weekdayLabels still uses Sunday-first order. When formatting date-only identities with Intl.DateTimeFormat, specify UTC to avoid shifting a day.'
  },
  {
    name: 'FunnelChart',
slug: 'funnel-chart',
title: 'Follow a cohort through each stage.',
    description: 'A common scale makes the relative stage sizes clear. Supply counts from the same population and measurement window so readers can make a meaningful comparison.',
    source: funnelSource,
    note: 'Stage order is preserved, including increases. Values must be nonnegative or null. Your application defines cohorts and conversion rates; Lumen does not infer percentages or reorder the funnel.'
  },
  {
    name: 'BoxPlot',
slug: 'box-plot',
title: 'Show the spread behind an average.',
    description: 'Compare the median, middle two quartiles, whiskers, and outliers for each group. Supply statistics you have already computed using a consistent method.',
    source: boxPlotSource,
    note: 'min and max are whisker bounds, not necessarily sample extremes. Keep min ≤ q1 ≤ median ≤ q3 ≤ max and include outliers in the domain. Use null for all five statistics when a summary is unavailable. Your application owns the quartile and outlier policy.'
  },
  {
    name: 'LollipopChart',
slug: 'lollipop-chart',
title: 'Rank with a shared baseline.',
    description: 'A filled dot makes each score easy to find. The stem starts at zero, and every row shares the same scale. Supply the order you want readers to see.',
    source: lollipopSource,
    note: 'Use valueLabel for the unit or measure. A reference field is not plotted by LollipopChart; use DumbbellChart when the earlier observation matters.'
  },
  {
    name: 'DumbbellChart',
slug: 'dumbbell-chart',
title: 'Make the change visible.',
    description: 'An outlined dot marks the reference; a filled dot marks the current value. This example includes a decrease as well as increases, without assigning good or bad meaning to either direction.',
    source: dumbbellSource,
    note: 'Name both observations with referenceLabel and valueLabel. Keep the same units. Use null for an unavailable measurement; the available dot and readable row remain, without a misleading connector.'
  },
  {
    name: 'BulletChart',
slug: 'bullet-chart',
title: 'Put performance in context.',
    description: 'Compare the actual value with a clearly labeled goal. Optional range bands add context, while the exact actual, target, and boundaries stay available in the data disclosure.',
    source: bulletSource,
    note: 'Range end values must be unique and finite. Lumen sorts them without changing your array. Include zero, the actual, the target, and every range end in a custom domain.'
  }
]

const setup = [
  { value: 'astro', label: 'Astro', language: 'astro', code: `---
// pnpm add @santi020k/lumen-astro
// In your root layout:
import '@santi020k/lumen-astro/styles.css'
import UIPrimitives from '@santi020k/lumen-astro/runtime'
---

<slot />
<UIPrimitives />` },
  { value: 'react', label: 'React', language: 'tsx', code: `// pnpm add @santi020k/lumen-react
// In your application entry or root layout:
import '@santi020k/lumen-react/styles.css'

// Import chart components where you use them:
import { LollipopChart, DumbbellChart, BulletChart } from '@santi020k/lumen-react'` },
  { value: 'elements', label: 'Elements', language: 'ts', code: `// pnpm add @santi020k/lumen-elements
// In your client entry, processed by your bundler:
import '@santi020k/lumen-elements/styles.css'
import { defineLumenElements } from '@santi020k/lumen-elements'

defineLumenElements(['LollipopChart', 'DumbbellChart', 'BulletChart'])` }
]
---

<div class="chart-guide" data-chart-guide>
  <section id="choose-a-chart" aria-labelledby="choose-chart-title">
    <header class="chart-guide-heading">
      <span class="chart-guide-step">01 / Choose</span>
      <h2 id="choose-chart-title">Start with the question.</h2>
      <p>Choose the smallest chart that makes the comparison clear. Use a <Link href="/docs/components/table">Table</Link> when readers primarily need to look up exact values.</p>
    </header>
    <Table layout="records">
      <table role="table">
        <caption>Chart selection guide</caption>
        <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Your question</th><th scope="col" role="columnheader">Component</th><th scope="col" role="columnheader">Best fit</th></tr></thead>
        <tbody role="rowgroup">{charts.map(([question, name, slug, fit]) => (
          <tr role="row"><th role="rowheader" scope="row" data-label="Your question">{question}</th><td role="cell" data-label="Component"><Link href={`/docs/components/${slug}`}>{name}</Link></td><td role="cell" data-label="Best fit">{fit}</td></tr>
        ))}</tbody>
      </table>
    </Table>
  </section>

  <section id="chart-setup" aria-labelledby="chart-setup-title">
    <header class="chart-guide-heading">
      <span class="chart-guide-step">02 / Set up</span>
      <h2 id="chart-setup-title">One import. Your framework.</h2>
      <p>Charts ship with the existing Lumen packages. Install the adapter you use and load its complete stylesheet once. No additional chart package is needed.</p>
    </header>
    <CodeTabs ariaLabel="Chart setup framework" items={setup} />
    <Callout>
      <p><strong>When do I need a runtime?</strong> Astro comparison charts and their native data disclosures work without client JavaScript. Mount <code>UIPrimitives</code> once in your layout for interactive line charts and Lumen tabs. React manages its own interaction; Elements requires client registration.</p>
    </Callout>
    <p>Complete setup: <Link href="/docs/frameworks/astro">Astro</Link> · <Link href="/docs/frameworks/react">React</Link> · <Link href="/docs/frameworks/elements">Web Components</Link>. In a React Server Components app, keep formatter functions inside a client component; they cannot cross a server-to-client boundary.</p>
  </section>

  <section id="chart-recipes" aria-labelledby="chart-recipes-title">
    <header class="chart-guide-heading">
      <span class="chart-guide-step">03 / Build</span>
      <h2 id="chart-recipes-title">From a question to a chart.</h2>
      <p>Copy a complete component example for your framework after setup. These are the same examples used on the component reference pages.</p>
    </header>
    {recipes.map(recipe => (
      <article class="chart-recipe" id={`${recipe.slug}-usage`} aria-labelledby={`${recipe.slug}-usage-title`}>
        <div class="chart-recipe-heading">
          <div><span class="chart-guide-step">{recipe.name}</span><h3 id={`${recipe.slug}-usage-title`}>{recipe.title}</h3></div>
          <Link href={`/docs/components/${recipe.slug}`}>Full API reference →</Link>
        </div>
        <p>{recipe.description}</p>
        <CodeTabs ariaLabel={`${recipe.name} code framework`} items={buildSnippets(recipe.name, recipe.source).map(snippet => ({ code: snippet.code, label: snippet.label, language: snippet.lang, value: snippet.label.toLowerCase() }))} />
        <p class="chart-recipe-note">{recipe.note}</p>
      </article>
    ))}
  </section>

  <section id="chart-data" aria-labelledby="chart-data-title">
    <header class="chart-guide-heading">
      <span class="chart-guide-step">04 / Prepare</span>
      <h2 id="chart-data-title">Keep the data honest.</h2>
      <p>Lumen draws the measurements you provide. Your application owns fetching, aggregation, sorting, units, and the meaning of a change.</p>
    </header>
    <div class="chart-guidance-grid">
      <div><h3>Zero is a measurement.</h3><p>Use <code>null</code> for unavailable observations and <code>0</code> for a real zero. Comparison rows keep their labels when a value is missing. An empty array shows the empty state; it does not indicate loading.</p></div>
      <div><h3>Use one meaningful scale.</h3><p>Comparison and bullet domains must contain zero and all displayed measurements. Use a common domain across cards you want readers to compare. Omit <code>domain</code> to let Lumen derive it.</p></div>
      <div><h3>Format at the boundary.</h3><p>Keep data numeric. Use <code>formatValue</code> in Astro and React, or the <code>valueFormatter</code> property in Elements. The same formatter labels visible values and exact data.</p><p>The bullet example stores 86 as a percentage point value and appends %. If using <code>Intl.NumberFormat</code> with <code>style: 'percent'</code>, store 0.86 instead and use a matching 0–1 domain.</p></div>
      <div><h3>Validate before rendering.</h3><p>Comparison rows need unique, non-empty IDs, non-empty labels, and finite numbers or <code>null</code>. Invalid input or a truncated domain shows an invalid-data message. Handle network errors and loading in your application with <Link href="/docs/components/error-state">ErrorState</Link> and <Link href="/docs/components/skeleton">Skeleton</Link>.</p></div>
    </div>
    <Callout><p><strong>Time series use a different contract.</strong> <Link href="/docs/components/line-chart">LineChart</Link> accepts series of <code>{'{ x, y }'}</code> points. Use <code>xScale="time"</code> for elapsed-time spacing, stable timestamps for identity, and an explicit locale and time zone for labels. A comparison chart uses <code>{'{ id, label, value, reference? }'}</code> rows.</p></Callout>
  </section>

  <section id="chart-accessibility" aria-labelledby="chart-accessibility-title">
    <header class="chart-guide-heading">
      <span class="chart-guide-step">05 / Refine</span>
      <h2 id="chart-accessibility-title">Readable beyond the plot.</h2>
    </header>
    <ul>
      <li><strong>Name the comparison.</strong> Supply an <code>aria-label</code>, a visible <code>heading</code>, and a <code>description</code> with the unit and period. Add a factual <code>summary</code> when readers need a written takeaway.</li>
      <li><strong>Keep exact values reachable.</strong> Leave <code>showTable</code> enabled. The data disclosure opens with Enter or Space. Only hide it when an equivalent accessible data view is already provided nearby.</li>
      <li><strong>Localize the whole experience.</strong> Use <code>labels</code> for messages and data-table headings, and <code>valueLabel</code>, <code>referenceLabel</code>, or <code>targetLabel</code> for the measure names. Elements uses label attributes such as <code>not-available-label</code> and <code>view-data-label</code>.</li>
      <li><strong>Use color deliberately.</strong> Categorical tones such as <code>series-1</code> work across themes. Reserve <code>success</code>, <code>warning</code>, and <code>danger</code> for meaningful status. Pair color with labels or mark shape.</li>
      <li><strong>Match interaction to the chart.</strong> Interactive LineChart supports pointer, touch, arrow keys, Home, End, and Escape. Lollipop, dumbbell, and bullet charts expose values directly and through the disclosure; they do not use the line-chart cursor.</li>
      <li><strong>Test the context.</strong> Check narrow cards, long labels, dark mode, keyboard navigation, enlarged text, missing measurements, and your largest realistic dataset. Split dense comparisons into focused groups instead of shrinking labels.</li>
    </ul>
    <p>Use <code>presentation="bare"</code> when a surrounding Lumen <Link href="/docs/components/card">Card</Link> already owns the surface. Keep the chart’s name and context available, and let the parent layout own spacing.</p>
  </section>

  <section id="native-charts" aria-labelledby="native-charts-title">
    <header class="chart-guide-heading">
      <span class="chart-guide-step">06 / Go native</span>
      <h2 id="native-charts-title">The same questions, on every platform.</h2>
      <p>CalendarHeatmap, FunnelChart, BoxPlot, LollipopChart, DumbbellChart, and BulletChart all have native counterparts with the <code>Lumen</code> prefix. Their reference pages include platform-specific examples and properties.</p>
    </header>
    <Table layout="records">
      <table role="table">
        <caption>Native comparison chart conventions</caption>
        <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Platform</th><th scope="col" role="columnheader">Domain & formatting</th><th scope="col" role="columnheader">Examples</th></tr></thead>
        <tbody role="rowgroup">
          <tr role="row"><th role="rowheader" scope="row" data-label="Platform">React Native</th><td role="cell" data-label="Domain & formatting"><code>{'{ min: 0, max: 100 }'}</code> · <code>formatValue</code></td><td role="cell" data-label="Examples"><Link href="/docs/react-native/components/lollipop-chart">Ranking</Link> · <Link href="/docs/react-native/components/dumbbell-chart">Comparison</Link> · <Link href="/docs/react-native/components/bullet-chart">Target</Link></td></tr>
          <tr role="row"><th role="rowheader" scope="row" data-label="Platform">SwiftUI</th><td role="cell" data-label="Domain & formatting"><code>0...100</code> · <code>labels.formatValue</code></td><td role="cell" data-label="Examples"><Link href="/docs/apple/components/lollipop-chart">Ranking</Link> · <Link href="/docs/apple/components/dumbbell-chart">Comparison</Link> · <Link href="/docs/apple/components/bullet-chart">Target</Link></td></tr>
          <tr role="row"><th role="rowheader" scope="row" data-label="Platform">Compose</th><td role="cell" data-label="Domain & formatting"><code>0.0..100.0</code> · <code>labels.formatValue</code></td><td role="cell" data-label="Examples"><Link href="/docs/android/components/lollipop-chart">Ranking</Link> · <Link href="/docs/android/components/dumbbell-chart">Comparison</Link> · <Link href="/docs/android/components/bullet-chart">Target</Link></td></tr>
        </tbody>
      </table>
    </Table>
    <p>Native charts use <code>label</code> for the accessible name and <code>showData</code> for the readable data disclosure. Follow your platform’s theme setup; preserve the same units, row order, and missing measurements across renderers.</p>
  </section>
</div>

<style>
  .chart-guide { display: grid; gap: 4rem; min-width: 0; }
  .chart-guide section, .chart-recipe { display: grid; gap: 1.5rem; min-width: 0; }
  .chart-guide section { border-top: 1px solid hsl(var(--line)); padding-top: 2rem; }
  .chart-guide-heading { display: grid; gap: 0.75rem; }
  .chart-guide-step { color: hsl(var(--brand)); font-size: 0.6875rem; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; }
  .chart-guide h2, .chart-guide h3, .chart-guide p { margin: 0; }
  .chart-guide h2 { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; letter-spacing: -0.04em; font-weight: 600; }
  .chart-guide h3 { font-size: 1.125rem; line-height: 1.4; letter-spacing: -0.025em; font-weight: 600; }
  .chart-guide p, .chart-guide li { color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.85; }
  .chart-guide strong { color: hsl(var(--ink)); }
  .chart-guide p code, .chart-guide li code, .chart-guide td code { color: hsl(var(--ink)); overflow-wrap: anywhere; font-size: 0.85em; }
  .chart-guide table { width: 100%; font-size: 0.8125rem; }
  .chart-guide caption { text-align: start; padding: 1rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; }
  .chart-guide th { text-align: start; }
  .chart-guide td { color: hsl(var(--ink-soft)); }
  .chart-guide th, .chart-guide td { padding: 0.875rem 1rem; vertical-align: top; }
  .chart-guide tbody th { font-weight: 550; }
  .chart-recipe { padding-top: 1rem; }
  .chart-recipe + .chart-recipe { border-top: 1px solid hsl(var(--line)); padding-top: 2rem; }
  .chart-recipe-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 0.75rem; }
  .chart-recipe-heading h3 { margin-top: 0.5rem; }
  .chart-recipe-heading :global(a) { font-size: 0.75rem; }
  .chart-recipe-note { border-inline-start: 2px solid hsl(var(--brand) / 0.4); padding-inline-start: 1rem; }
  .chart-guidance-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .chart-guidance-grid > div { display: grid; gap: 0.75rem; align-content: start; }
  .chart-guide ul { display: grid; gap: 1rem; margin: 0; padding-inline-start: 1.25rem; }
  @media (max-width: 48rem) {
    .chart-guide caption { display: block; width: 100%; box-sizing: border-box; }
    .chart-guide tbody tr { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    .chart-guide tbody th, .chart-guide tbody td { padding: 0; border: 0; }
  }
  @media (max-width: 640px) {
    .chart-guide { gap: 3rem; }
    .chart-guidance-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

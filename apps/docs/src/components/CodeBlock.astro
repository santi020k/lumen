---
import type { CodeLanguage } from 'astro'

import { Code as AstroCode } from 'astro:components'

import { Code } from '@santi020k/lumen-astro'

import { cachedLumenThemes, cachedSanti020kThemes } from '../lib/lumen-shiki-themes'

interface Props {
  code: string
  lang?: CodeLanguage
  title?: string
}

const { code, lang = 'plaintext', title } = Astro.props
const language = typeof lang === 'string' ? lang : lang.name
---

<Code
  class="docs-code-block"
  copy
  highlighted
  label={title ?? ''}
  language={language}
  variant="block"
>
  <div class="docs-code-block__variant docs-code-block__variant--santi020k">
    <AstroCode code={code} defaultColor={false} lang={lang} themes={cachedSanti020kThemes} />
  </div>
  <div class="docs-code-block__variant docs-code-block__variant--lumen">
    <AstroCode code={code} defaultColor={false} lang={lang} themes={cachedLumenThemes} />
  </div>
</Code>

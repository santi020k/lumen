---
import { Code as AstroCode } from 'astro:components'

import { Code } from '@santi020k/lumen-astro'
import { santi020kShikiThemes } from '@santi020k/theme/shiki'

import type { ComponentProps } from 'astro/types'

import { lumenShikiThemes } from '../lib/lumen-shiki-themes'

type AstroCodeProps = ComponentProps<typeof AstroCode>

interface Props {
  code: string
  lang?: AstroCodeProps['lang']
  title?: string
}

const santi020kThemes = {
  dark: santi020kShikiThemes.dark,
  light: santi020kShikiThemes.light
} as unknown as NonNullable<AstroCodeProps['themes']>

const lumenThemes = {
  dark: lumenShikiThemes.dark,
  light: lumenShikiThemes.light
} as unknown as NonNullable<AstroCodeProps['themes']>

const { code, lang = 'plaintext', title } = Astro.props
const language = typeof lang === 'string' ? lang : (lang?.name ?? 'code')
---

<Code
  class="docs-code-block"
  copy
  highlighted
  label={title}
  language={language}
  variant="block"
>
  <div class="docs-code-block__variant docs-code-block__variant--santi020k">
    <AstroCode code={code} defaultColor={false} lang={lang} themes={santi020kThemes} />
  </div>
  <div class="docs-code-block__variant docs-code-block__variant--lumen">
    <AstroCode code={code} defaultColor={false} lang={lang} themes={lumenThemes} />
  </div>
</Code>

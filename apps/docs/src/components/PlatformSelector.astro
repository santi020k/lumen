---
import { Icon, Label, NativeSelect } from '@santi020k/lumen-astro'

import { getDocsPlatform, platformGuides } from '../data/platforms'

interface Props {
  currentPath: string
}

const { currentPath } = Astro.props
const activePlatform = getDocsPlatform(currentPath)
---

<div class="docs-platform-selector" data-docs-platform-selector data-current-platform={activePlatform ?? ''}>
  <div class="docs-platform-selector__label">
    <Icon decorative name="panels-top-left" size="sm" />
    <Label for="docs-platform-select">Documentation for</Label>
  </div>
  <NativeSelect
    id="docs-platform-select"
    aria-label="Choose documentation platform"
    data-docs-platform-select
    size="sm"
  >
    <option value="/docs" selected={!activePlatform}>All platforms</option>
    {platformGuides.map(guide => (
      <option value={guide.href} selected={activePlatform === guide.id}>{guide.shortLabel}</option>
    ))}
  </NativeSelect>
</div>

<script>
  const docsPlatformStorageKey = 'lumen-docs-platform'

  const initPlatformSelectors = (): void => {
    document.querySelectorAll<HTMLElement>('[data-docs-platform-selector]').forEach(container => {
      if (container.dataset.initialized === 'true') return

      const select = container.querySelector<HTMLSelectElement>('[data-docs-platform-select]')

      if (!select) return

      const currentPlatform = container.dataset.currentPlatform

      if (!currentPlatform && window.location.pathname !== '/docs') {
        const savedHref = window.localStorage.getItem(docsPlatformStorageKey)
        const savedOption = [...select.options].find(option => option.value === savedHref)

        if (savedOption) select.value = savedOption.value
      }

      select.addEventListener('change', () => {
        if (select.value !== '/docs') {
          window.localStorage.setItem(docsPlatformStorageKey, select.value)
        }

        window.location.assign(select.value)
      })

      container.dataset.initialized = 'true'
    })
  }

  initPlatformSelectors()

  document.addEventListener('astro:after-swap', initPlatformSelectors)
</script>

<style>
  .docs-platform-selector {
    display: grid;
    gap: 0.5rem;
    padding: 0.85rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.9rem;
    background: hsl(var(--surface-muted));
  }

  .docs-platform-selector__label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: hsl(var(--ink-muted));
  }

  .docs-platform-selector__label :global(label) {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .docs-platform-selector :global(select) {
    width: 100%;
  }
</style>

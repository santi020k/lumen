---
import {
  Badge,
  ButtonLink,
  Icon,
  Link,
  Marker,
  Separator
} from '@santi020k/lumen-astro'
import { lumenComponentNames } from '@santi020k/lumen-core'

import GitHubIcon from './GitHubIcon.astro'
import LumenLogo from './LumenLogo.astro'

const footerGroups = [
  {
    links: [
      { href: '/docs', label: 'Start' },
      { href: '/docs/components', label: 'Components' },
      { href: '/docs/icons', label: 'Icons' },
      { href: '/docs/theme-playground', label: 'Theme playground' }
    ],
    title: 'Explore'
  },
  {
    links: [
      { href: '/docs/frameworks/astro', label: 'Astro' },
      { href: '/docs/frameworks/react', label: 'React' },
      { href: '/docs/frameworks/elements', label: 'Elements' },
      { href: '/docs/figma', label: 'Figma' },
      { href: '/docs/ai-skill', label: 'AI skill' },
      { href: '/docs/mcp', label: 'MCP server' }
    ],
    title: 'Use Lumen'
  },
  {
    links: [
      { href: 'https://github.com/santi020k/lumen', label: 'GitHub' },
      { href: 'https://www.npmjs.com/package/@santi020k/lumen', label: 'npm' },
      {
        href: 'https://www.figma.com/community/file/1662337342676541513',
        label: 'Figma Community'
      },
      { href: 'https://santi020k.com', label: 'Santi020k' }
    ],
    title: 'Resources'
  }
] as const

const currentYear = new Date().getFullYear()
const componentCount = lumenComponentNames.length
---

<footer class="docs-site-footer">
  <div class="
    docs-site-footer__inner mx-auto w-full max-w-7xl px-5
    sm:px-8
  ">
    <div class="docs-site-footer__statement">
      <div class="docs-site-footer__statement-copy">
        <div class="docs-site-footer__eyebrow">
          <Marker variant="success">Open source</Marker>
          <Badge variant="outline">{componentCount} primitives</Badge>
        </div>
        <h2>Good interfaces feel<br /><em>inevitable.</em></h2>
        <p>
          Lumen gives every framework the same considered foundation—so your
          product can feel coherent before the custom work even begins.
        </p>
      </div>
      <div class="docs-site-footer__actions">
        <ButtonLink href="/docs" showArrow variant="primary">
          Start building
        </ButtonLink>
        <ButtonLink
          href="https://github.com/santi020k/lumen"
          newTab
          variant="secondary"
        >
          <GitHubIcon />
          GitHub
        </ButtonLink>
      </div>
    </div>

    <Separator />

    <div class="docs-site-footer__directory">
      <div class="docs-site-footer__brand">
        <Link class="docs-site-footer__logo text-ink no-underline" href="/">
          <LumenLogo markClass="size-9" />
        </Link>
        <p>
          Multi-framework UI primitives for Astro, React, and the platform.
        </p>
        <span class="docs-site-footer__signature">
          <Icon name="sparkles" size="sm" />
          Built with Lumen
        </span>
      </div>

      <nav class="docs-site-footer__nav" aria-label="Footer">
        {footerGroups.map(group => (
          <section>
            <h2>{group.title}</h2>
            <ul>
              {group.links.map(link => {
                const isExternal = link.href.startsWith('http')

                return (
                  <li>
                    <Link
                      href={link.href}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                      target={isExternal ? '_blank' : undefined}
                    >
                      {link.label}
                      {isExternal && <Icon name="arrow-up-right" size="sm" />}
                    </Link>
                  </li>
                )
              })}
            </ul>
          </section>
        ))}
      </nav>
    </div>

    <div class="docs-site-footer__meta">
      <p>
        © {currentYear} Lumen UI. Crafted by{' '}
        <Link href="https://santi020k.com" rel="noopener noreferrer" target="_blank">
          Santi020k
          <Icon name="arrow-up-right" size="sm" />
        </Link>.
      </p>
      <p class="docs-site-footer__status">
        <Marker variant="success">Stable</Marker>
        Accessible by default
      </p>
    </div>
  </div>
</footer>

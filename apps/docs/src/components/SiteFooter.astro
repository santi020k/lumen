---
import {
  Badge,
  ButtonLink,
  CodeTabs,
  Icon,
  Link,
  Marker,
  Separator
} from '@santi020k/lumen-astro'
import { lumenComponentNames } from '@santi020k/lumen-core'

import type { DocsPlatformId } from '../data/platforms'
import { platformGuides } from '../data/platforms'

import GitHubIcon from './GitHubIcon.astro'
import LumenLogo from './LumenLogo.astro'

const footerGroups = [
  {
    links: [
      { href: '/docs', label: 'Start' },
      { href: '/guides', label: 'Guides' },
      { href: '/docs/components', label: 'Components' },
      { href: '/templates', label: 'Templates' },
      { href: '/community', label: 'Community' },
      { href: '/teams', label: 'For teams' },
      { href: '/docs/icons', label: 'Icons' }
    ],
    title: 'Explore'
  },
  {
    links: [
      { href: '/docs/web', label: 'Web' },
      { href: '/docs/frameworks/astro', label: 'Astro' },
      { href: '/docs/frameworks/react', label: 'React' },
      { href: '/docs/frameworks/elements', label: 'Web Components' },
      { href: '/docs/react-native', label: 'React Native' },
      { href: '/docs/apple', label: 'Apple / SwiftUI' },
      { href: '/docs/android', label: 'Android / Compose' },
      { href: '/docs/foundations', label: 'Foundations' }
    ],
    title: 'Platforms'
  },
  {
    links: [
      { href: '/docs/figma', label: 'Figma' },
      { href: '/docs/ai-skill', label: 'AI skill' },
      { href: '/docs/mcp', label: 'MCP server' },
      { href: '/docs/brand-icons', label: 'Brand icons' },
      { href: '/docs/theme-playground', label: 'Theme playground' }
    ],
    title: 'Tooling'
  },
  {
    links: [
      { href: 'https://github.com/santi020k/lumen', label: 'GitHub' },
      { href: 'https://www.npmjs.com/package/@santi020k/lumen', label: 'npm' },
      { href: '/changelog', label: 'Changelog' },
      { href: '/support', label: 'Support' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
      { href: '/guides/rss.xml', label: 'Guides RSS' },
      {
        href: 'https://www.figma.com/community/file/1662337342676541513',
        label: 'Figma Community'
      },
      { href: 'https://santi020k.com', label: 'Santi020k' }
    ],
    title: 'Resources'
  }
] as const

const currentYear = new Date().getFullYear()
const componentCount = lumenComponentNames.length

const webInstallers = [
  {
    command: 'pnpm add @santi020k/lumen-astro',
    label: 'Astro'
  },
  {
    command: 'pnpm add @santi020k/lumen-react',
    label: 'React'
  },
  {
    command: 'pnpm add @santi020k/lumen-elements',
    label: 'Elements'
  }
] as const

const installTabs = webInstallers.map(framework => ({
  code: framework.command,
  label: framework.label,
  language: 'bash',
  value: framework.label.toLowerCase()
}))

const platformPresentation = {
  android: { icon: 'bot', runtime: 'Jetpack Compose' },
  apple: { icon: 'apple', runtime: 'SwiftUI' },
  foundations: { icon: 'layers-3', runtime: 'Shared tokens' },
  'react-native': { icon: 'smartphone', runtime: 'React Native' },
  web: { icon: 'panels-top-left', runtime: 'Astro · React · Elements' }
} satisfies Record<DocsPlatformId, { icon: string, runtime: string }>

const footerPlatforms = platformGuides.map(guide => ({
  ...guide,
  ...platformPresentation[guide.id]
}))
---

<footer class="docs-site-footer">
  <div class="
    docs-site-footer__inner mx-auto w-full max-w-7xl px-5
    sm:px-8
  "
  >
    <section
      aria-labelledby="docs-site-footer-title"
      class="docs-site-footer__statement"
    >
      <div class="docs-site-footer__statement-copy">
        <div class="docs-site-footer__eyebrow">
          <span class="docs-site-footer__kicker">
            <Icon name="sparkles" size="sm" />
            Build with Lumen
          </span>
          <Badge variant="outline">{componentCount} primitives</Badge>
        </div>
        <h2 id="docs-site-footer-title">
          Pick your platform.<br /><em>Keep your system.</em>
        </h2>
        <p>
          Build for the web, React Native, Apple platforms, or Android with one
          semantic design language and native behavior in every environment.
        </p>
        <div class="docs-site-footer__actions">
          <ButtonLink href="/docs" showArrow variant="primary">
            Read the docs
          </ButtonLink>
          <ButtonLink
            href="https://github.com/santi020k/lumen"
            newTab
            variant="secondary"
          >
            <GitHubIcon />
            View on GitHub
          </ButtonLink>
        </div>
      </div>

      <div class="docs-site-footer__launchpad">
        <div class="docs-site-footer__launchpad-heading">
          <div>
            <span>Choose a platform</span>
            <p>Native behavior, one semantic foundation.</p>
          </div>
          <Badge variant="outline">{footerPlatforms.length} surfaces</Badge>
        </div>

        <div class="docs-site-footer__platforms">
          {footerPlatforms.map(platform => (
            <Link
              aria-label={`${platform.label} platform guide`}
              class:list={[
                'docs-site-footer__platform',
                platform.id === 'web' && 'docs-site-footer__platform--web'
              ]}
              href={platform.href}
            >
              <Icon decorative name={platform.icon} size="sm" />
              <span>
                <strong>{platform.label}</strong>
                <span class="docs-site-footer__platform-meta">
                  <small>{platform.runtime}</small>
                  <span class="docs-site-footer__platform-status">
                    {platform.maturity ?? platform.status}
                  </span>
                </span>
              </span>
              <Icon decorative name="arrow-right" size="sm" />
            </Link>
          ))}
        </div>

        <div class="docs-site-footer__quickstart">
          <div class="docs-site-footer__quickstart-heading">
            <span>Web quick start</span>
            <Marker variant="success">3 packages</Marker>
          </div>
          <CodeTabs
            ariaLabel="Choose a web framework package"
            items={installTabs}
            storageKey="lumen-footer-framework"
          />
        </div>
      </div>
    </section>

    <Separator />

    <div class="docs-site-footer__directory">
      <div class="docs-site-footer__brand">
        <Link class="docs-site-footer__logo text-ink no-underline" href="/">
          <LumenLogo markClass="size-9" />
        </Link>
        <p>
          Calm, accessible primitives for web and native platforms.
        </p>
        <span class="docs-site-footer__signature">
          <Icon name="heart" size="sm" />
          Open source
        </span>
      </div>

      <nav class="docs-site-footer__nav" aria-label="Footer">
        {footerGroups.map(group => (
          <section>
            <h2>{group.title}</h2>
            <ul>
              {group.links.map(link => {
                const isExternal = link.href.startsWith('http')

                return (
                  <li>
                    <Link
                      href={link.href}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                      target={isExternal ? '_blank' : undefined}
                    >
                      {link.label}
                      {isExternal && <Icon name="arrow-up-right" size="sm" />}
                    </Link>
                  </li>
                )
              })}
            </ul>
          </section>
        ))}
      </nav>
    </div>

    <div class="docs-site-footer__meta">
      <p>
        © {currentYear} Lumen UI. Crafted by{' '}
        <Link href="https://santi020k.com" rel="noopener noreferrer" target="_blank">
          Santi020k
          <Icon name="arrow-up-right" size="sm" />
        </Link>.
      </p>
      <p class="docs-site-footer__status">
        <Marker variant="success">Stable</Marker>
        Accessible by default
      </p>
    </div>
  </div>
</footer>

---
import { Card, Icon, Image, Link } from '@santi020k/lumen-astro'

import playgroundsCover from '../assets/figma-community/playgrounds/cover.png'
import templatesCover from '../assets/figma-community/templates/cover.png'
import { figmaCommunityFiles } from '../data/community'

const covers = {
  playgrounds: { image: playgroundsCover, title: 'Lumen Playgrounds' },
  templates: { image: templatesCover, title: 'Lumen Templates' }
}

interface Props {
  file: keyof typeof covers
}

const { file } = Astro.props
const { image, title } = covers[file]
---

<Link class="figma-cover" href={figmaCommunityFiles[file]} newTab variant="inherit">
  <Card class="figma-cover__card" density="compact" variant="interactive">
    <Image
      alt=""
      fit="contain"
      format="webp"
      radius="md"
      sizes="(max-width: 32rem) 32vw, 12rem"
      src={image}
      width={320}
      widths={[320, 480, 640]}
    />
    <span class="figma-cover__copy">
      <strong>{title}</strong>
      <span>Open in Figma <Icon decorative name="arrow-up-right" size="sm" /></span>
    </span>
  </Card>
</Link>

<style>
  .figma-cover {
    display: block;
    width: min(100%, 34rem);
    margin-block-start: var(--ui-space-lg);
    border-radius: var(--ui-radius);
    text-decoration: none;
  }

  .figma-cover__card {
    display: grid;
    grid-template-columns: min(36%, 12rem) minmax(0, 1fr);
    align-items: center;
    gap: var(--ui-space-lg);
  }

  .figma-cover__copy {
    display: grid;
    gap: var(--ui-space-xs);
    color: hsl(var(--ink));
  }

  .figma-cover__copy > span {
    display: inline-flex;
    align-items: center;
    gap: var(--ui-space-xs);
    color: hsl(var(--brand));
    font-size: 0.875rem;
  }
</style>

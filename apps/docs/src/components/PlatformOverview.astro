---
import { Badge, ButtonLink, Card, CodeTabs, Icon, Link, Marker } from '@santi020k/lumen-astro'

import { getNativeComponentsForPlatform } from '../data/native-components'
import { getNativeGuideTopics } from '../data/native-guide-topics'
import type { PlatformGuide } from '../data/platforms'
import DocsLayout from '../layouts/DocsLayout.astro'

import FoundationVisuals from './FoundationVisuals.astro'
import NativePlatformPreview from './NativePlatformPreview.astro'

interface Props { guide: PlatformGuide }

const { guide } = Astro.props
const nativePlatform = guide.id === 'android' || guide.id === 'apple' || guide.id === 'react-native' ? guide.id : undefined
const hasNativeCatalog = nativePlatform !== undefined
const components = nativePlatform ? getNativeComponentsForPlatform(nativePlatform) : []
const featuredComponents = components.filter(component => ['button', 'text-field', 'card', 'alert', 'line-chart', 'calendar-heatmap'].includes(component.slug))
const categories = [...new Set(components.map(component => component.category))]
const nativeTopics = nativePlatform ? getNativeGuideTopics(nativePlatform) : []
const topicLabels = { installation: 'Install and configure', theming: 'Theme and appearance', ai: 'Build with AI' }

const nativeGuideLinks = [
  ...nativeTopics.map(topic => ({ icon: topic.icon, label: topicLabels[topic.id], description: topic.description, href: topic.href, hash: topic.legacyHash })),
  { icon: 'play', label: 'Try the playground', description: 'Explore the gallery, inspect its source, and run it on your device.', href: `${guide.href}/playground`, hash: '#playground' },
  { icon: 'box', label: 'Component reference', description: `Explore ${components.length} primitives with native examples, APIs, and accessibility notes.`, href: `${guide.href}/components`, hash: '#components' },
  { icon: 'landmark', label: 'Platform contract', description: `See how Lumen follows ${guide.shortLabel} conventions.`, href: '#principles', hash: '' }
]
---

<DocsLayout
  breadcrumbs={[{ href: guide.href, label: guide.shortLabel }]}
  description={guide.summary}
  title={`${guide.title} - Lumen UI`}
>
  <section class:list={['platform-hero', { 'platform-hero--native': hasNativeCatalog }]} aria-labelledby="platform-title">
    <div class="platform-hero__copy">
      <div class="platform-hero__eyebrow">
        <Badge variant="outline">{guide.eyebrow}</Badge>
        <Marker variant="success">{guide.status}</Marker>
      </div>
      <h1 id="platform-title">{guide.title}</h1>
      <p>{guide.summary}</p>
      <div class="platform-hero__actions">
        <ButtonLink href={hasNativeCatalog ? `${guide.href}/installation` : '#installation'} showArrow>Start building</ButtonLink>
        <ButtonLink href={hasNativeCatalog ? `${guide.href}/components` : '#components'} variant="secondary">
          {hasNativeCatalog ? 'Browse components' : 'View coverage'}
        </ButtonLink>
      </div>
    </div>

    <Card class="platform-hero__package" glass="subtle">
      <span>Package</span>
      <code>{guide.packageName}</code>
      <p>{guide.installNote}</p>
    </Card>
  </section>

  {hasNativeCatalog && (
    <div data-native-platform={nativePlatform}>
      <NativePlatformPreview guide={guide} />
      <nav class="platform-guide-map" aria-labelledby="platform-guide-map-title">
        <div class="platform-guide-map__heading">
          <p>Pick your next step</p>
          <h2 id="platform-guide-map-title">Build with {guide.shortLabel}</h2>
          <p>Focused guides keep setup, appearance, and component details one click away.</p>
        </div>
        <div class="platform-guide-map__links">
          {nativeGuideLinks.map(link => (
            <Link
              class="platform-guide-map__link"
              id={link.hash && link.hash !== '#components' ? link.hash.slice(1) : undefined}
              data-native-legacy-hash={link.hash || undefined}
              href={link.href}
              variant="inherit"
            >
              <span><Icon decorative name={link.icon} size="sm" /></span>
              <span><strong>{link.label}</strong><small>{link.description}</small></span>
              <Icon decorative name="arrow-right" size="sm" />
            </Link>
          ))}
        </div>
      </nav>
      <section class="docs-section" id="components" aria-labelledby="components-title">
        <div class="docs-section-heading">
          <p>Component library</p>
          <h2 id="components-title">Start with the building blocks</h2>
          <p>{guide.componentNote}</p>
        </div>
        <div class="platform-featured-components">
          {featuredComponents.map(component => (
            <Link class="platform-featured-component" href={`${guide.href}/components/${component.slug}`} variant="inherit">
              <strong>{component.name}<Icon decorative name="arrow-up-right" size="sm" /></strong>
              <span>{component.summary}</span>
            </Link>
          ))}
        </div>
        <nav class="platform-category-links" aria-label={`${guide.shortLabel} component categories`}>
          {categories.map(category => (
            <Link href={`${guide.href}/components#category-${category.replaceAll(' ', '-').toLowerCase()}`}>{category}</Link>
          ))}
        </nav>
        <ButtonLink href={`${guide.href}/components`} showArrow>Explore all {components.length} components</ButtonLink>
      </section>
    </div>
  )}

  {guide.id === 'foundations' && <FoundationVisuals />}
  {!hasNativeCatalog && (
    <>
  <section class="docs-section" id="installation" aria-labelledby="installation-title">
    <div class="docs-section-heading">
      <p>Get started</p>
      <h2 id="installation-title">Install and configure</h2>
      <p>{guide.installNote}</p>
    </div>
    {guide.prerequisites && (
      <Card as="section" class="platform-prerequisites" variant="muted" aria-labelledby="prerequisites-title">
        <div>
          <Badge variant="outline">Before you begin</Badge>
          <h3 id="prerequisites-title">What you need</h3>
        </div>
        <ul>
          {guide.prerequisites.map(prerequisite => <li>{prerequisite}</li>)}
        </ul>
      </Card>
    )}
    {guide.setupSteps && (
      <ol class="platform-setup-steps" aria-label={`${guide.label} installation steps`}>
        {guide.setupSteps.map((step, index) => (
          <li>
            <Card as="article" class="platform-setup-step" variant="muted">
              <span aria-hidden="true">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </Card>
          </li>
        ))}
      </ol>
    )}
    <CodeTabs
      ariaLabel={`${guide.label} setup examples`}
      items={guide.codeExamples}
      storageKey={`lumen-${guide.id}-setup`}
    />
  </section>

      <section class="docs-section" id="components" aria-labelledby="components-title">
        <div class="docs-section-heading">
          <p>Supported surface</p>
          <h2 id="components-title">Components and capabilities</h2>
          <p>{guide.componentNote}</p>
        </div>
        <div class="platform-components" role="list" aria-label={`${guide.label} support`}>
          {guide.components.map(component => (
            <Card class="platform-component" role="listitem" variant="muted">
              <Icon decorative name="check" size="sm" />
              <span>{component}</span>
            </Card>
          ))}
        </div>
      </section>
    </>
  )}
  <section class="docs-section" id="principles" aria-labelledby="principles-title">
    <div class="docs-section-heading">
      <p>Platform contract</p>
      <h2 id="principles-title">Designed for {guide.label}</h2>
    </div>
    <div class="platform-principles">
      {guide.principles.map((principle, index) => (
        <Card as="article" class="platform-principle" variant="muted">
          <span aria-hidden="true">0{index + 1}</span>
          <h3>{principle.title}</h3>
          <p>{principle.description}</p>
        </Card>
      ))}
    </div>
  </section>

  <Card as="section" class="docs-next" variant="muted" aria-labelledby="related-title">
    <h2 id="related-title">Continue exploring</h2>
    <p>Move between platform guidance without losing the shared Lumen design language.</p>
    <div class="platform-related">
      {hasNativeCatalog && <><Link href="/docs/icons#icon-catalog">Interface icon names</Link><Link href="/docs/brand-icons#brand-icon-catalog">Brand icon names</Link></>}
      {guide.relatedLinks.map(link => {
        const isExternal = link.href.startsWith('http')

        return (
          <Link
            href={link.href}
            rel={isExternal ? 'noopener noreferrer' : undefined}
            target={isExternal ? '_blank' : undefined}
          >
            {link.label}
            <Icon decorative name={isExternal ? 'arrow-up-right' : 'arrow-right'} size="sm" />
          </Link>
        )
      })}
    </div>
  </Card>
</DocsLayout>

<script>
  const followLegacyNativeHash = () => {
    const overview = document.querySelector('[data-native-platform]')

    if (!overview || !window.location.hash) return

    const link = [...overview.querySelectorAll<HTMLAnchorElement>('a[data-native-legacy-hash]')]
      .find(candidate => candidate.dataset.nativeLegacyHash === window.location.hash)

    if (link) window.location.replace(link.href)
  }

  followLegacyNativeHash()

  document.addEventListener('astro:page-load', followLegacyNativeHash)

  window.addEventListener('hashchange', followLegacyNativeHash)
</script>

<style>
  .platform-hero {
    display: grid;
    gap: 2rem;
    overflow: hidden;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 92% 0%, hsl(var(--brand) / 0.2), transparent 34%),
      linear-gradient(145deg, hsl(var(--surface)), hsl(var(--surface-muted)));
  }

  .platform-hero__copy {
    display: grid;
    align-content: center;
    gap: 1.25rem;
  }

  .platform-hero__eyebrow,
  .platform-hero__actions,
  .platform-related {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .platform-hero h1 {
    max-width: 13ch;
    color: hsl(var(--ink));
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .platform-hero__copy > p {
    max-width: 44rem;
    color: hsl(var(--ink-soft));
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .platform-hero :global(.platform-hero__package) {
    display: grid;
    align-content: end;
    gap: 0.8rem;
    min-width: 0;
    padding: 1.5rem;
  }

  .platform-hero__package span {
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .platform-hero__package code {
    overflow-wrap: anywhere;
    color: hsl(var(--brand));
    font-size: 0.9rem;
    font-weight: 800;
  }

  .platform-hero__package p,
  .platform-principle p {
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .platform-guide-map {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid hsl(var(--line));
    border-radius: 1.25rem;
    background: hsl(var(--surface));
  }

  .platform-guide-map__heading {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }

  .platform-guide-map__heading > p:first-child {
    color: hsl(var(--brand));
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .platform-guide-map__heading h2 {
    color: hsl(var(--ink));
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 900;
  }

  .platform-guide-map__heading > p:last-child {
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .platform-guide-map__links {
    display: grid;
    gap: 0.75rem;
  }

  .platform-guide-map :global(.platform-guide-map__link) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem;
    border-radius: 0.85rem;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .platform-guide-map :global(.platform-guide-map__link:hover) {
    background: hsl(var(--surface-muted));
  }

  .platform-guide-map :global(.platform-guide-map__link:focus-visible) {
    outline: 2px solid hsl(var(--brand));
    outline-offset: 2px;
  }

  .platform-guide-map__link > span:first-child {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.65rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }

  .platform-guide-map__link > span:nth-child(2) {
    display: grid;
    gap: 0.15rem;
  }

  .platform-guide-map__link strong {
    color: hsl(var(--ink));
    font-size: 0.875rem;
    font-weight: 800;
  }

  .platform-guide-map__link small {
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .platform-guide-map__link > :global(svg:last-child) {
    color: hsl(var(--ink-soft));
  }

  .platform-components {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.75rem;
  }

  :global(.platform-prerequisites) {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 1.25rem;
  }

  .platform-prerequisites > div {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .platform-prerequisites h3,
  .platform-setup-step h3 {
    color: hsl(var(--ink));
    font-size: 1rem;
    font-weight: 800;
  }

  .platform-prerequisites ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.25rem;
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .platform-setup-steps {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  :global(.platform-setup-step) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    height: 100%;
    padding: 1rem;
  }

  .platform-setup-step > span {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
    font-size: 0.75rem;
    font-weight: 900;
  }

  .platform-setup-step p {
    margin-top: 0.25rem;
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .platform-components__action {
    margin-top: 1.25rem;
  }

  :global(.platform-component) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.85rem 1rem;
    color: hsl(var(--ink));
    font-size: 0.875rem;
    font-weight: 700;
  }

  .platform-component :global(svg) {
    flex: 0 0 auto;
    color: hsl(var(--success));
  }

  .platform-principles {
    display: grid;
    gap: 1rem;
  }

  :global(.platform-principle) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
    padding: 1.25rem;
  }

  .platform-principle > span {
    grid-row: 1 / span 2;
    color: hsl(var(--brand));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 900;
  }

  .platform-principle h3 {
    color: hsl(var(--ink));
    font-size: 1rem;
    font-weight: 800;
  }

  .platform-related :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  @media (min-width: 56rem) {
    .platform-hero {
      grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.55fr);
      min-height: 30rem;
    }

    .platform-principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .platform-prerequisites {
      grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr);
    }

    .platform-setup-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .platform-guide-map {
      grid-template-columns: minmax(14rem, 0.65fr) minmax(0, 1.35fr);
    }

    .platform-guide-map__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .platform-hero--native { min-height: 0; }
  .platform-featured-components { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 0.75rem; }
  .platform-featured-components :global(.platform-featured-component) { display: grid; gap: 0.5rem; padding: 1.25rem; border: 1px solid hsl(var(--line)); border-radius: 0.9rem; background: hsl(var(--surface)); text-decoration: none; }
  .platform-featured-component strong { display: flex; justify-content: space-between; gap: 0.5rem; color: hsl(var(--ink)); font-size: 1rem; }
  .platform-featured-component span { color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.6; }
  .platform-featured-components :global(.platform-featured-component:hover) { border-color: hsl(var(--brand)); background: hsl(var(--brand-soft)); }
  .platform-featured-components :global(.platform-featured-component:focus-visible) { outline: 2px solid hsl(var(--brand)); outline-offset: 2px; }
  .platform-category-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-block: 1.25rem; }
  .platform-category-links :global(a) { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: 0.875rem; }
  @media (min-width: 56rem) { .platform-hero--native { min-height: 0; } }
</style>

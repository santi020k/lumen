---
import { Link, NavigationMenu } from '@santi020k/lumen-astro'

import { visualGuideHref, visualGuides } from '../data/visual-guides'

const currentPath = Astro.url.pathname.replace(/\/$/, '')
const topics = [{ label: 'Overview', href: '/docs/visual-playground' }, ...visualGuides.map(guide => ({ label: guide.label, href: visualGuideHref(guide.id) }))]
---
<NavigationMenu aria-label="Visual guides" class="visual-guide-nav" variant="unstyled">
  {topics.map(topic => <Link href={topic.href} aria-current={currentPath === topic.href ? 'page' : undefined}>{topic.label}</Link>)}
</NavigationMenu>

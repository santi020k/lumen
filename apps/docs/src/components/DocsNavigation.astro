---
import { Badge, Icon, Link } from '@santi020k/lumen-astro'

import { componentCategories, componentDocs } from '../data/docs'
import { toSlug } from '../lib/routes'

interface Props {
  closeOnNavigate?: boolean
  currentPath: string
}

const { closeOnNavigate = false, currentPath } = Astro.props

const gettingStarted = [
  ['Introduction', '/docs'],
  ['Figma', '/docs/figma'],
  ['AI skill', '/docs/ai-skill'],
  ['MCP server', '/docs/mcp'],
  ['Icons', '/docs/icons'],
  ['Brand icons', '/docs/brand-icons'],
  ['Changelog', '/changelog'],
  ['Components', '/docs/components'],
  ['Theme playground', '/docs/theme-playground']
] as const

const frameworkLinks = [
  ['Astro', '/docs/frameworks/astro'],
  ['React', '/docs/frameworks/react'],
  ['Elements', '/docs/frameworks/elements']
] as const

const formLinks = [
  ['Forms overview', '/docs/forms'],
  ['React Hook Form', '/docs/forms/react-hook-form'],
  ['Astro Actions', '/docs/forms/astro-actions'],
  ['Web Components', '/docs/forms/elements']
] as const

const isCurrent = (href: string) => currentPath === href
const closeAttribute = closeOnNavigate ? true : undefined
---

<nav class="docs-sidebar__nav" data-docs-nav>
  <div class="docs-sidebar__group">
    <p>Start here</p>
    {gettingStarted.map(([label, href]) => (
      <Link
        aria-current={isCurrent(href) ? 'page' : undefined}
        class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
        data-ui-drawer-close={closeAttribute}
        href={href}
      >
        <span>{label}</span>
        {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
      </Link>
    ))}
  </div>
  <div class="docs-sidebar__group">
    <p>Frameworks</p>
    {frameworkLinks.map(([label, href]) => (
      <Link
        aria-current={isCurrent(href) ? 'page' : undefined}
        class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
        data-ui-drawer-close={closeAttribute}
        href={href}
      >
        <span>{label}</span>
        {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
      </Link>
    ))}
  </div>
  <div class="docs-sidebar__group">
    <p>Forms</p>
    {formLinks.map(([label, href]) => (
      <Link
        aria-current={isCurrent(href) ? 'page' : undefined}
        class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
        data-ui-drawer-close={closeAttribute}
        href={href}
      >
        <span>{label}</span>
        {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
      </Link>
    ))}
  </div>
  <div class="docs-sidebar__components-label">
    <span>Components</span>
    <Link data-ui-drawer-close={closeAttribute} href="/docs/components">Browse all</Link>
  </div>
  {componentCategories.map(category => (
    <details
      class="docs-sidebar__group docs-sidebar__group--collapsible"
      open
    >
      <summary>
        <span>{category}</span>
        <span>
          <Badge variant="outline">
            {componentDocs.filter(component => component.category === category).length}
          </Badge>
          <Icon decorative name="chevron-right" size="sm" />
        </span>
      </summary>
      <div>
        {componentDocs.filter(component => component.category === category).map(component => (
          <Link
            aria-current={isCurrent(`/docs/components/${toSlug(component.name)}`) ? 'page' : undefined}
            class:list={{
              'docs-sidebar__link': true,
              'is-current': isCurrent(`/docs/components/${toSlug(component.name)}`)
            }}
            data-ui-drawer-close={closeAttribute}
            href={`/docs/components/${toSlug(component.name)}`}
          >
            <span class="truncate">{component.name}</span>
            {component.glass && (
              <span class="docs-sidebar__glass">Glass</span>
            )}
          </Link>
        ))}
      </div>
    </details>
  ))}
</nav>

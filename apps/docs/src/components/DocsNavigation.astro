---
import { Badge, Icon, Link } from '@santi020k/lumen-astro'

import { componentCategories, componentDocs } from '../data/docs'
import { sharedDocumentationLinks } from '../data/docs-context-navigation'
import {
  getNativeComponentsForPlatform,
  nativeComponentCategories
} from '../data/native-components'
import type { DocsPlatformId } from '../data/platforms'
import { getPlatformGuide, productPlatformGuides } from '../data/platforms'
import { toSlug } from '../lib/routes'

interface Props {
  currentPath: string
  platform: DocsPlatformId | undefined
}

const { currentPath, platform } = Astro.props
const platformLinks = productPlatformGuides.map(guide => [guide.label, guide.href] as const)

const sharedLinks = sharedDocumentationLinks.filter((_, index) => {
  if (!platform) return true

  if (platform === 'foundations') return index === 0

  return index < 2
})

const frameworkLinks = [
  ['Web overview', '/docs/web'],
  ['Astro', '/docs/frameworks/astro'],
  ['React', '/docs/frameworks/react'],
  ['Elements', '/docs/frameworks/elements']
] as const

const formLinks = [
  ['Forms overview', '/docs/forms'],
  ['React Hook Form', '/docs/forms/react-hook-form'],
  ['Astro Actions', '/docs/forms/astro-actions'],
  ['Web Components', '/docs/forms/elements']
] as const

const webFoundationLinks = [
  ['Icons', '/docs/icons'],
  ['Brand icons', '/docs/brand-icons'],
  ['Theme playground', '/docs/theme-playground']
] as const

const activeGuide = platform && platform !== 'web' ? getPlatformGuide(platform) : undefined

const nativePlatform = platform === 'android' || platform === 'apple' || platform === 'react-native' ?
  platform :
  undefined

const nativeComponents = nativePlatform ? getNativeComponentsForPlatform(nativePlatform) : []

const platformSectionLinks = activeGuide ?
  [
    [`${activeGuide.shortLabel} guide`, activeGuide.href],
    ['Install and configure', `${activeGuide.href}#installation`],
    ...(nativePlatform ? [['Theme and appearance', `${activeGuide.href}#theme`] as const] : []),
    ...(nativePlatform ? [['Run the playground', `${activeGuide.href}/playground`] as const] : []),
    ...(nativePlatform ? [['Use with AI', `${activeGuide.href}#ai-usage`] as const] : []),
    ['Components', nativePlatform ? `${activeGuide.href}/components` : `${activeGuide.href}#components`],
    ['Platform contract', `${activeGuide.href}#principles`]
  ] as const :
  []

const isCurrent = (href: string) => currentPath === href
const nativeComponentsHref = activeGuide ? activeGuide.href + '/components' : ''

const isNativeCategoryCurrent = (category: string) => nativeComponents.some(component => (
  component.category === category && isCurrent(`${nativeComponentsHref}/${component.slug}`)
))

const isWebCategoryCurrent = (category: string) => componentDocs.some(component => (
  component.category === category && isCurrent(`/docs/components/${toSlug(component.name)}`)
))

---

<nav class="docs-sidebar__nav" data-docs-nav>
  <div class="docs-sidebar__group">
    <p>{platform ? 'Across Lumen' : 'Shared project'}</p>
    {sharedLinks.map(({ label, href }) => (
      <Link
        aria-current={isCurrent(href) ? 'page' : undefined}
        class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
        href={href}
      >
        <span>{label}</span>
        {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
      </Link>
    ))}
  </div>
  {(!platform || platform === 'foundations') && (
    <div class="docs-sidebar__group">
      <p>Platform guides</p>
      {platformLinks.map(([label, href]) => (
        <Link
          aria-current={isCurrent(href) ? 'page' : undefined}
          class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
          href={href}
        >
          <span>{label}</span>
          {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
        </Link>
      ))}
    </div>
  )}
  {activeGuide && (
    <div class="docs-sidebar__group">
      <p>{activeGuide.shortLabel}</p>
      {platformSectionLinks.map(([label, href]) => (
        <Link
          aria-current={isCurrent(href) ? 'page' : undefined}
          class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
          href={href}
        >
          <span>{label}</span>
          {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
        </Link>
      ))}
    </div>
  )}
  {platform === 'web' && (
    <div class="docs-sidebar__group">
      <p>Frameworks</p>
      {frameworkLinks.map(([label, href]) => (
        <Link
          aria-current={isCurrent(href) ? 'page' : undefined}
          class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
          href={href}
        >
          <span>{label}</span>
          {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
        </Link>
      ))}
    </div>
  )}
  {activeGuide && nativePlatform && (
    <>
      <div class="docs-sidebar__components-label">
        <span>Components</span>
        <Link href={`${activeGuide.href}/components`}>Browse all</Link>
      </div>
      {nativeComponentCategories.filter(category => (
        nativeComponents.some(component => component.category === category)
      )).map(category => (
        <details
          class="docs-sidebar__group docs-sidebar__group--collapsible"
          open={isNativeCategoryCurrent(category)}
        >
          <summary>
            <span>{category}</span>
            <span>
              <Badge variant="outline">
                {nativeComponents.filter(component => component.category === category).length}
              </Badge>
              <Icon decorative name="chevron-right" size="sm" />
            </span>
          </summary>
          <div>
            {nativeComponents.filter(component => component.category === category).map(component => {
              const href = `${activeGuide.href}/components/${component.slug}`

              return (
                <Link
                  aria-current={isCurrent(href) ? 'page' : undefined}
                  class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
                  href={href}
                >
                  <span class="truncate">{component.name}</span>
                </Link>
              )
            })}
          </div>
        </details>
      ))}
    </>
  )}
  {platform === 'web' && (
    <div class="docs-sidebar__group">
      <p>Forms</p>
      {formLinks.map(([label, href]) => (
        <Link
          aria-current={isCurrent(href) ? 'page' : undefined}
          class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
          href={href}
        >
          <span>{label}</span>
          {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
        </Link>
      ))}
    </div>
  )}
  {platform === 'web' && (
    <div class="docs-sidebar__group">
      <p>Web foundations</p>
      {webFoundationLinks.map(([label, href]) => (
        <Link
          aria-current={isCurrent(href) ? 'page' : undefined}
          class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
          href={href}
        >
          <span>{label}</span>
          {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
        </Link>
      ))}
    </div>
  )}
  {platform === 'web' && (
    <>
      <div class="docs-sidebar__components-label">
        <span>Components</span>
        <Link href="/docs/components">Browse all</Link>
      </div>
      {componentCategories.map(category => (
        <details
          class="docs-sidebar__group docs-sidebar__group--collapsible"
          open={isWebCategoryCurrent(category)}
        >
          <summary>
            <span>{category}</span>
            <span>
              <Badge variant="outline">
                {componentDocs.filter(component => component.category === category).length}
              </Badge>
              <Icon decorative name="chevron-right" size="sm" />
            </span>
          </summary>
          <div>
            {componentDocs.filter(component => component.category === category).map(component => (
              <Link
                aria-current={isCurrent(`/docs/components/${toSlug(component.name)}`) ? 'page' : undefined}
                class:list={{
                  'docs-sidebar__link': true,
                  'is-current': isCurrent(`/docs/components/${toSlug(component.name)}`)
                }}
                href={`/docs/components/${toSlug(component.name)}`}
              >
                <span class="truncate">{component.name}</span>
                {component.glass && (
                  <span class="docs-sidebar__glass">Glass</span>
                )}
              </Link>
            ))}
          </div>
        </details>
      ))}
    </>
  )}
</nav>

---
import { Button, Icon, Kbd, Label, SearchField } from '@santi020k/lumen-astro'

interface Props {
  class?: string
  className?: string
  inputId?: string
  optionIdPrefix?: string
  placeholder?: string
  resultsId?: string
}

const {
  class: classProp = '',
  className = '',
  inputId = 'docs-search-input',
  optionIdPrefix = inputId,
  placeholder = 'Search components, props, and recipes...',
  resultsId = `${inputId}-results`
} = Astro.props

const searchIndexHref = '/docs-search.json'
---

<div
  class:list={[
    'docs-search relative',
    classProp || className ? undefined : 'max-w-2xl',
    classProp,
    className
  ]}
  data-docs-search
  data-docs-search-id={optionIdPrefix}
  data-docs-search-source={searchIndexHref}
>
  <Label class="sr-only" for={inputId}>Search docs</Label>
  <div class="docs-search__control">
    <Icon class="docs-search__icon" decorative name="search" size="sm" />
    <SearchField
      id={inputId}
      autocomplete="off"
      class="w-full"
      placeholder={placeholder}
      role="combobox"
      aria-autocomplete="list"
      aria-controls={resultsId}
      aria-describedby={`${inputId}-status`}
      aria-expanded="false"
      aria-keyshortcuts="/"
      data-docs-search-input
    />
    <Button
      class="docs-search__clear"
      size="icon"
      variant="ghost"
      aria-label="Clear search"
      data-docs-search-clear
      hidden
    >
      <Icon decorative name="x" size="sm" />
    </Button>
    <Kbd class="docs-search__shortcut" aria-hidden="true">/</Kbd>
  </div>
  <p id={`${inputId}-status`} class="sr-only" aria-live="polite" data-docs-search-status>
    Type at least two characters to search.
  </p>
  <div
    id={resultsId}
    class="docs-search__results hidden"
    role="listbox"
    aria-label="Search results"
    data-docs-search-results
    hidden
  ></div>
</div>

<script>
  import type { DocsSearchItem as SearchItem } from '../lib/docs-search'
  import { getMatchedSearchItems, normalizeSearchText } from '../lib/docs-search'

  interface DocsSearchState {
    activeIndex: number
    clearButton: HTMLButtonElement
    input: HTMLInputElement
    optionIdPrefix: string
    results: HTMLElement
    status: HTMLElement
  }

  interface DocsSearchCommand {
    command: string
    description: string
    href: string
    keywords: string
    title: string
  }

  const docsSearchCommands: DocsSearchCommand[] = [
    {
      command: '/components',
      description: 'Browse every Lumen primitive by category and use case.',
      href: '/docs/components',
      keywords: 'components primitives catalog browse',
      title: 'Browse components'
    },
    {
      command: '/install',
      description: 'Install Lumen and choose the package for your framework.',
      href: '/docs#installation',
      keywords: 'install setup getting started astro react elements',
      title: 'Installation guide'
    },
    {
      command: '/theme',
      description: 'Generate, preview, and export a Lumen color theme.',
      href: '/docs/theme-playground',
      keywords: 'theme colors tokens playground customize',
      title: 'Theme playground'
    },
    {
      command: '/icons',
      description: 'Search the complete icon catalog and copy component names.',
      href: '/docs/icons',
      keywords: 'icons lucide catalog symbols',
      title: 'Icon catalog'
    },
    {
      command: '/brands',
      description: 'Search the optional catalog of namespaced company and product marks.',
      href: '/docs/brand-icons',
      keywords: 'brand icons logos font awesome company product marks',
      title: 'Brand icon catalog'
    },
    {
      command: '/figma',
      description: 'Open the Figma handoff and design-library guide.',
      href: '/docs/figma',
      keywords: 'figma design library variables handoff',
      title: 'Figma library'
    },
    {
      command: '/ai',
      description: 'Set up the Lumen Agent Skill or MCP server.',
      href: '/docs/ai-skill',
      keywords: 'ai agent skill mcp codex claude cursor',
      title: 'AI integrations'
    }
  ]

  declare global {
    interface Window {
      __lumenDocsSearchIndex?: Promise<SearchItem[]>
    }
  }

  const getDocsSearchSource = (): string => (
    document.querySelector<HTMLElement>('[data-docs-search-source]')?.dataset.docsSearchSource ?? '/docs-search.json'
  )

  const getDocsSearchIndex = (): Promise<SearchItem[]> => {
    if (!window.__lumenDocsSearchIndex) {
      window.__lumenDocsSearchIndex = fetch(getDocsSearchSource(), {
        headers: { accept: 'application/json' }
      })
        .then(response => response.ok ? response.json() as Promise<SearchItem[]> : [])
        .catch(() => [])
    }

    return window.__lumenDocsSearchIndex
  }

  const isSearchNavigationKey = (key: string): boolean =>
    key === 'ArrowDown' || key === 'ArrowUp' || key === 'Enter'

  const getSearchOptions = (results: HTMLElement): HTMLAnchorElement[] =>
    [...results.querySelectorAll<HTMLAnchorElement>('[role="option"]')]

  const openSearchResults = (state: DocsSearchState): void => {
    state.results.hidden = false

    state.results.classList.remove('hidden')

    state.input.setAttribute('aria-expanded', 'true')
  }

  const closeSearchResults = (state: DocsSearchState): void => {
    state.results.hidden = true

    state.results.classList.add('hidden')

    state.input.setAttribute('aria-expanded', 'false')

    state.input.removeAttribute('aria-activedescendant')

    state.activeIndex = -1
  }

  const updateSearchControls = (state: DocsSearchState): void => {
    const hasQuery = state.input.value.length > 0

    state.clearButton.hidden = !hasQuery

    state.input.classList.toggle('has-query', hasQuery)
  }

  const setActiveSearchOption = (state: DocsSearchState, index: number): void => {
    const options = getSearchOptions(state.results)

    if (!options.length) {
      closeSearchResults(state)

      return
    }

    state.activeIndex = (index + options.length) % options.length

    for (const [optionIndex, option] of options.entries()) {
      const selected = optionIndex === state.activeIndex

      option.setAttribute('aria-selected', String(selected))

      option.dataset.active = selected ? 'true' : 'false'
    }

    const activeOption = options[state.activeIndex]

    if (activeOption) {
      state.input.setAttribute('aria-activedescendant', activeOption.id)

      activeOption.scrollIntoView({ block: 'nearest' })
    }
  }

  const createSearchOption = (item: SearchItem, index: number, idPrefix: string): HTMLAnchorElement => {
    const option = document.createElement('a')
    const meta = document.createElement('span')
    const title = document.createElement('strong')
    const description = document.createElement('span')

    option.id = `${idPrefix}-option-${index}`

    option.href = item.href

    option.className = 'grid gap-1 rounded-md px-3 py-2 text-left no-underline hover:bg-brand-soft'

    option.setAttribute('role', 'option')

    option.setAttribute('aria-selected', 'false')

    meta.className = 'text-xs font-bold text-ink-muted'

    meta.textContent = `${item.type} / ${item.category}`

    title.className = 'text-sm font-bold text-ink'

    title.textContent = item.title

    description.className = 'line-clamp-2 text-xs/5 text-ink-soft'

    description.textContent = item.description

    option.append(meta, title, description)

    return option
  }

  const createCommandOption = (
    item: DocsSearchCommand,
    index: number,
    idPrefix: string
  ): HTMLAnchorElement => {
    const option = document.createElement('a')
    const heading = document.createElement('span')
    const command = document.createElement('code')
    const title = document.createElement('strong')
    const description = document.createElement('span')

    option.id = `${idPrefix}-option-${index}`

    option.href = item.href

    option.className = 'grid gap-1 rounded-md px-3 py-2 text-left no-underline hover:bg-brand-soft'

    option.setAttribute('role', 'option')

    option.setAttribute('aria-selected', 'false')

    heading.className = 'docs-search__command-heading'

    command.className = 'docs-search__command'

    command.textContent = item.command

    title.className = 'text-sm font-bold text-ink'

    title.textContent = item.title

    description.className = 'line-clamp-2 text-xs/5 text-ink-soft'

    description.textContent = item.description

    heading.append(command, title)

    option.append(heading, description)

    return option
  }

  const renderSearchCommands = (state: DocsSearchState, query = ''): void => {
    const normalizedQuery = normalizeSearchText(query.trim())

    const commands = normalizedQuery
      ? docsSearchCommands.filter(item =>
          normalizeSearchText(`${item.command} ${item.title} ${item.keywords}`).includes(normalizedQuery)
        )
      : docsSearchCommands

    state.results.replaceChildren()

    const label = document.createElement('p')

    label.className = 'docs-search__group-label'

    label.textContent = 'Quick commands'

    label.setAttribute('role', 'presentation')

    state.results.append(label)

    if (!commands.length) {
      const empty = document.createElement('p')

      empty.className = 'px-3 py-2 text-sm text-ink-soft'

      empty.textContent = `No quick command matches “/${query}”. Try another command or remove “/” to search the docs.`

      state.results.append(empty)

      state.status.textContent = 'No matching quick commands.'

      openSearchResults(state)

      return
    }

    for (const [commandIndex, item] of commands.entries()) {
      state.results.append(createCommandOption(item, commandIndex, state.optionIdPrefix))
    }

    state.status.textContent = `${commands.length} quick ${commands.length === 1 ? 'command' : 'commands'} available.`

    openSearchResults(state)

    setActiveSearchOption(state, 0)
  }

  const renderEmptySearchResults = (state: DocsSearchState): void => {
    const empty = document.createElement('p')

    empty.className = 'px-3 py-2 text-sm text-ink-soft'

    empty.textContent = `No results for “${state.input.value.trim()}”. Try a component, prop, or task.`

    state.results.append(empty)

    state.status.textContent = 'No search results found.'

    openSearchResults(state)
  }

  const renderSearchResults = (state: DocsSearchState, index: SearchItem[]): void => {
    const rawQuery = state.input.value.trim()
    const query = normalizeSearchText(rawQuery)

    state.results.replaceChildren()

    if (!query || query.startsWith('/')) {
      renderSearchCommands(state, rawQuery.startsWith('/') ? rawQuery.slice(1) : '')

      return
    }

    if (query.length < 2) {
      state.status.textContent = query.length === 1
        ? 'Type one more character to search.'
        : 'Type at least two characters to search.'

      closeSearchResults(state)

      return
    }

    const matchedResults = getMatchedSearchItems(index, query)

    if (!matchedResults.length) {
      renderEmptySearchResults(state)

      return
    }

    for (const [resultIndex, item] of matchedResults.entries()) {
      state.results.append(createSearchOption(item, resultIndex, state.optionIdPrefix))
    }

    state.status.textContent = `${matchedResults.length} search ${matchedResults.length === 1 ? 'result' : 'results'} available.`

    openSearchResults(state)

    setActiveSearchOption(state, 0)
  }

  const handleSearchKeyDown = (
    event: KeyboardEvent,
    state: DocsSearchState,
    index: SearchItem[]
  ): void => {
    if (event.key === 'Escape') {
      closeSearchResults(state)

      return
    }

    if (!isSearchNavigationKey(event.key)) return

    if (state.results.hidden && event.key !== 'Enter') {
      renderSearchResults(state, index)

      return
    }

    const options = getSearchOptions(state.results)

    if (!options.length) return

    event.preventDefault()

    if (event.key === 'ArrowDown') {
      setActiveSearchOption(state, state.activeIndex + 1)

      return
    }

    if (event.key === 'ArrowUp') {
      setActiveSearchOption(state, state.activeIndex - 1)

      return
    }

    options[Math.max(0, state.activeIndex)]?.click()
  }

  const initDocsSearch = (): void => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-docs-search]')) {
      if (root.dataset.docsSearchBound === 'true') continue

      const input = root.querySelector<HTMLInputElement>('[data-docs-search-input]')
      const results = root.querySelector<HTMLElement>('[data-docs-search-results]')
      const clearButton = root.querySelector<HTMLButtonElement>('[data-docs-search-clear]')
      const status = root.querySelector<HTMLElement>('[data-docs-search-status]')
      const optionIdPrefix = root.dataset.docsSearchId ?? 'docs-search'

      if (!input || !results || !clearButton || !status) continue

      root.dataset.docsSearchBound = 'true'

      const state: DocsSearchState = {
        activeIndex: -1,
        clearButton,
        input,
        optionIdPrefix,
        results,
        status
      }

      input.addEventListener('input', () => {
        updateSearchControls(state)

        if (!input.value.trim() || input.value.trim().startsWith('/')) {
          renderSearchCommands(state, input.value.trim().slice(1))

          return
        }

        getDocsSearchIndex()
          .then(index => renderSearchResults(state, index))
          .catch(() => renderSearchResults(state, []))
      })

      input.addEventListener('focus', () => {
        if (!input.value.trim() || input.value.trim().startsWith('/')) {
          renderSearchCommands(state, input.value.trim().slice(1))
        } else if (input.value.trim().length >= 2) {
          getDocsSearchIndex()
            .then(index => renderSearchResults(state, index))
            .catch(() => renderSearchResults(state, []))
        }
      })

      input.addEventListener('keydown', event => {
        if (!input.value.trim() || input.value.trim().startsWith('/')) {
          handleSearchKeyDown(event, state, [])

          return
        }

        getDocsSearchIndex()
          .then(index => handleSearchKeyDown(event, state, index))
          .catch(() => handleSearchKeyDown(event, state, []))
      })

      clearButton.addEventListener('click', () => {
        input.value = ''

        updateSearchControls(state)

        status.textContent = 'Search cleared.'

        input.focus()

        renderSearchCommands(state)
      })

      document.addEventListener('click', event => {
        if (event.target instanceof Node && !root.contains(event.target)) {
          closeSearchResults(state)
        }
      })
    }

    if (document.documentElement.dataset.docsSearchShortcutBound === 'true') return

    document.documentElement.dataset.docsSearchShortcutBound = 'true'

    document.addEventListener('keydown', event => {
      if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return

      const target = event.target

      if (
        target instanceof HTMLInputElement
        || target instanceof HTMLTextAreaElement
        || (target instanceof HTMLElement && target.isContentEditable)
      ) return

      const visibleSearchInput = [...document.querySelectorAll<HTMLInputElement>('[data-docs-search-input]')]
        .find(candidate => candidate.getClientRects().length > 0)

      if (!visibleSearchInput) return

      event.preventDefault()

      visibleSearchInput.focus()

      visibleSearchInput.select()
    })
  }

  initDocsSearch()

  document.addEventListener('astro:page-load', initDocsSearch)
</script>

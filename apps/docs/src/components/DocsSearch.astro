---
import { SearchField } from '@santi020k/lumen-astro'

import { docsSearchIndex } from '../data/search'

const searchJson = JSON.stringify(docsSearchIndex).replaceAll('<', '\\u003c')
---

<div class="docs-search relative max-w-2xl" data-docs-search>
  <label class="sr-only" for="docs-search-input">Search docs</label>
  <SearchField
    id="docs-search-input"
    autocomplete="off"
    class="w-full"
    placeholder="Search components, props, and recipes..."
    role="combobox"
    aria-autocomplete="list"
    aria-controls="docs-search-results"
    aria-expanded="false"
    data-docs-search-input
  />
  <div
    id="docs-search-results"
    class="
      absolute z-50 mt-2 hidden max-h-96 w-full overflow-y-auto rounded-xl
      border border-line bg-surface p-2 shadow-xl
    "
    role="listbox"
    aria-label="Search results"
    data-docs-search-results
    hidden
  ></div>
  <script is:inline type="application/json" data-docs-search-index set:html={searchJson}></script>
</div>

<script>
  interface SearchItem {
    category: string
    description: string
    href: string
    keywords: string
    title: string
    type: string
  }

  interface DocsSearchState {
    activeIndex: number
    input: HTMLInputElement
    results: HTMLElement
  }

  const getDocsSearchIndex = (): SearchItem[] => {
    const source = document.querySelector<HTMLScriptElement>('[data-docs-search-index]')

    if (!source?.textContent) return []

    try {
      return JSON.parse(source.textContent) as SearchItem[]
    } catch {
      return []
    }
  }

  const normalizeSearchText = (value: string): string =>
    value.toLowerCase().normalize('NFKD').replaceAll(/[\u0300-\u036f]/g, '')

  const scoreSearchItem = (item: SearchItem, query: string): number => {
    const title = normalizeSearchText(item.title)
    const category = normalizeSearchText(item.category)
    const keywords = normalizeSearchText(item.keywords)
    const tokens = query.split(/\s+/).filter(Boolean)

    if (!tokens.every(token => title.includes(token) || category.includes(token) || keywords.includes(token))) {
      return 0
    }

    let score = 1

    if (title === query) score += 80

    if (title.startsWith(query)) score += 45

    if (title.includes(query)) score += 25

    if (category.includes(query)) score += 12

    score += tokens.reduce((sum, token) => sum + (keywords.includes(token) ? 4 : 0), 0)

    return score
  }

  const isSearchNavigationKey = (key: string): boolean =>
    key === 'ArrowDown' || key === 'ArrowUp' || key === 'Enter'

  const getSearchOptions = (results: HTMLElement): HTMLAnchorElement[] =>
    [...results.querySelectorAll<HTMLAnchorElement>('[role="option"]')]

  const openSearchResults = (state: DocsSearchState): void => {
    state.results.hidden = false

    state.results.classList.remove('hidden')

    state.input.setAttribute('aria-expanded', 'true')
  }

  const closeSearchResults = (state: DocsSearchState): void => {
    state.results.hidden = true

    state.results.classList.add('hidden')

    state.input.setAttribute('aria-expanded', 'false')

    state.input.removeAttribute('aria-activedescendant')

    state.activeIndex = -1
  }

  const setActiveSearchOption = (state: DocsSearchState, index: number): void => {
    const options = getSearchOptions(state.results)

    if (!options.length) {
      closeSearchResults(state)

      return
    }

    state.activeIndex = (index + options.length) % options.length

    for (const [optionIndex, option] of options.entries()) {
      const selected = optionIndex === state.activeIndex

      option.setAttribute('aria-selected', String(selected))

      option.dataset.active = selected ? 'true' : 'false'
    }

    const activeOption = options[state.activeIndex]

    if (activeOption) {
      state.input.setAttribute('aria-activedescendant', activeOption.id)

      activeOption.scrollIntoView({ block: 'nearest' })
    }
  }

  const createSearchOption = (item: SearchItem, index: number): HTMLAnchorElement => {
    const option = document.createElement('a')
    const meta = document.createElement('span')
    const title = document.createElement('strong')
    const description = document.createElement('span')

    option.id = `docs-search-option-${index}`

    option.href = item.href

    option.className = 'grid gap-1 rounded-md px-3 py-2 text-left no-underline hover:bg-brand-soft'

    option.setAttribute('role', 'option')

    option.setAttribute('aria-selected', 'false')

    meta.className = 'text-xs font-bold text-ink-muted'

    meta.textContent = `${item.type} / ${item.category}`

    title.className = 'text-sm font-bold text-ink'

    title.textContent = item.title

    description.className = 'line-clamp-2 text-xs/5 text-ink-soft'

    description.textContent = item.description

    option.append(meta, title, description)

    return option
  }

  const renderEmptySearchResults = (state: DocsSearchState): void => {
    const empty = document.createElement('p')

    empty.className = 'px-3 py-2 text-sm text-ink-soft'

    empty.textContent = 'No results found.'

    state.results.append(empty)

    openSearchResults(state)
  }

  const getMatchedSearchItems = (index: SearchItem[], query: string): SearchItem[] =>
    index
      .map(item => ({ item, score: scoreSearchItem(item, query) }))
      .filter(result => result.score > 0)
      .sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title))
      .slice(0, 8)
      .map(result => result.item)

  const renderSearchResults = (state: DocsSearchState, index: SearchItem[]): void => {
    const query = normalizeSearchText(state.input.value.trim())

    state.results.replaceChildren()

    if (query.length < 2) {
      closeSearchResults(state)

      return
    }

    const matchedResults = getMatchedSearchItems(index, query)

    if (!matchedResults.length) {
      renderEmptySearchResults(state)

      return
    }

    for (const [resultIndex, item] of matchedResults.entries()) {
      state.results.append(createSearchOption(item, resultIndex))
    }

    openSearchResults(state)

    setActiveSearchOption(state, 0)
  }

  const handleSearchKeyDown = (
    event: KeyboardEvent,
    state: DocsSearchState,
    index: SearchItem[]
  ): void => {
    if (event.key === 'Escape') {
      closeSearchResults(state)

      return
    }

    if (!isSearchNavigationKey(event.key)) return

    if (state.results.hidden && event.key !== 'Enter') {
      renderSearchResults(state, index)

      return
    }

    const options = getSearchOptions(state.results)

    if (!options.length) return

    event.preventDefault()

    if (event.key === 'ArrowDown') {
      setActiveSearchOption(state, state.activeIndex + 1)

      return
    }

    if (event.key === 'ArrowUp') {
      setActiveSearchOption(state, state.activeIndex - 1)

      return
    }

    options[Math.max(0, state.activeIndex)]?.click()
  }

  const initDocsSearch = (): void => {
    const index = getDocsSearchIndex()

    for (const root of document.querySelectorAll<HTMLElement>('[data-docs-search]')) {
      if (root.dataset.docsSearchBound === 'true') continue

      const input = root.querySelector<HTMLInputElement>('[data-docs-search-input]')
      const results = root.querySelector<HTMLElement>('[data-docs-search-results]')

      if (!input || !results) continue

      root.dataset.docsSearchBound = 'true'

      const state: DocsSearchState = { activeIndex: -1, input, results }

      input.addEventListener('input', () => {
        renderSearchResults(state, index)
      })

      input.addEventListener('focus', () => {
        if (input.value.trim().length >= 2) renderSearchResults(state, index)
      })

      input.addEventListener('keydown', event => {
        handleSearchKeyDown(event, state, index)
      })

      document.addEventListener('click', event => {
        if (event.target instanceof Node && !root.contains(event.target)) {
          closeSearchResults(state)
        }
      })
    }
  }

  initDocsSearch()

  document.addEventListener('astro:page-load', initDocsSearch)
</script>

---
import { ClientRouter } from 'astro:transitions'

import '../styles/global.css'

import { UIPrimitives } from '@santi020k/lumen-astro'
import MetadataHead from '@santi020k/og/astro/head'
import {
  articleSchema,
  breadcrumbSchema,
  composeJsonLd,
  defineSchema,
  organizationSchema,
  personSchema,
  serializeJsonLd,
  webSiteSchema
} from '@santi020k/og/schema'
import { defineSite } from '@santi020k/og/site'

import ExposureMetrics from '../components/ExposureMetrics.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { getSocialImageUrl } from '../lib/social-image'

interface Props {
  article?: {
    author: string
    publishedAt: string
    updatedAt?: string
  }
  breadcrumbs?: {
    href: string
    label: string
  }[]
  description: string
  noindex?: boolean
  socialImage?: string
  title: string
}

const {
  article,
  breadcrumbs = [],
  description,
  noindex = false,
  socialImage,
  title
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const socialImageUrl = getSocialImageUrl(Astro.url.pathname, Astro.site, socialImage)

const site = defineSite({
  locale: 'en_US',
  siteName: 'Lumen UI',
  siteUrl: Astro.site ?? 'https://lumen.santi020k.com/'
})

const page = site.page({
  ...(article ?
{
    article: {
      authors: [article.author],
      ...(article.updatedAt ? { modifiedTime: article.updatedAt } : {}),
      publishedTime: article.publishedAt
    }
  } :
{}),
  description,
  image: { alt: title, url: socialImageUrl },
  pathname: Astro.url.pathname,
  robots: { index: !noindex },
  title,
  type: article ? 'article' : 'website'
})

const siteUrl = new URL('/', Astro.site)
const organizationId = new URL('/#organization', Astro.site)
const websiteId = new URL('/#website', Astro.site)
const softwareId = new URL('/#software', Astro.site)
const pageId = new URL(`${Astro.url.pathname}#webpage`, Astro.site)

const getCanonicalItemUrl = (href: string): URL => new URL(
  href === '/' || href.endsWith('/') ? href : `${href}/`,
  Astro.site
)

const organization = organizationSchema({ id: organizationId.href, name: 'Lumen UI', url: siteUrl }, {
  sameAs: [
    'https://github.com/santi020k/lumen',
    'https://www.figma.com/community/file/1662337342676541513'
  ]
})

const website = webSiteSchema({
  id: websiteId.href,
  name: 'Lumen UI',
  publisher: defineSchema({ '@id': organizationId.href, '@type': 'Organization' }),
  url: siteUrl
})

const software = defineSchema({
  '@id': softwareId.href,
  '@type': 'SoftwareSourceCode',
  author: defineSchema({ '@id': organizationId.href, '@type': 'Organization' }),
  codeRepository: 'https://github.com/santi020k/lumen',
  description: 'An open-source UI system for accessible web and native product interfaces.',
  isAccessibleForFree: true,
  license: 'https://opensource.org/license/mit',
  name: 'Lumen UI',
  programmingLanguage: ['TypeScript', 'Swift', 'Kotlin'],
  url: siteUrl.href
})

const pageStructuredData = article ?
  articleSchema({
    author: personSchema({ name: article.author }),
    dateModified: article.updatedAt ?? article.publishedAt,
    datePublished: article.publishedAt,
    description,
    id: pageId.href,
    image: socialImageUrl,
    isPartOf: defineSchema({ '@id': websiteId.href, '@type': 'WebSite' }),
    name: title,
    publisher: defineSchema({ '@id': organizationId.href, '@type': 'Organization' }),
    type: 'TechArticle',
    url: canonicalUrl
  }, { mainEntityOfPage: canonicalUrl.href }) :
  defineSchema({
    '@id': pageId.href,
    '@type': 'WebPage',
    description,
    isPartOf: defineSchema({ '@id': websiteId.href, '@type': 'WebSite' }),
    name: title,
    url: canonicalUrl.href
  })

const breadcrumbStructuredData = breadcrumbs.length > 0 ?
breadcrumbSchema(
  breadcrumbs.map(item => ({ name: item.label, url: getCanonicalItemUrl(item.href) }))
) :
undefined

const structuredData = composeJsonLd(organization, website, software, pageStructuredData, breadcrumbStructuredData)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <MetadataHead {page} site={site.options} noindexPolicy="minimal" />
    <meta name="theme-color" content="#f8fafc" />
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(structuredData)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lumen UI Guides"
      href={new URL('/guides/rss.xml', Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <ClientRouter />
    <script is:inline>
      const themeStorageKey = 'lumen-theme'
      const colorThemes = ['santi020k-light', 'santi020k-dark', 'lumen-light', 'lumen-dark']

      const getLegacyTheme = theme => {
        if (theme === 'dark') return 'lumen-dark'

        if (theme === 'light') return 'lumen-light'

        return null
      }

      const normalizeTheme = theme => {
        if (colorThemes.includes(theme)) return theme

        return getLegacyTheme(theme)
      }

      const getStoredTheme = () => {
        try {
          const storedTheme = localStorage.getItem(themeStorageKey)

          return normalizeTheme(storedTheme)
        } catch {
          return null
        }
      }

      const getSystemTheme = () => (
        window.matchMedia('(prefers-color-scheme: dark)').matches ? 'lumen-dark' : 'lumen-light'
      )

      const initialTheme = getStoredTheme() ?? getSystemTheme()

      document.documentElement.dataset.theme = initialTheme

      document.documentElement.classList.toggle('dark', initialTheme.endsWith('-dark'))
    </script>
  </head>
  <body>
    <UIPrimitives />
    <a class="docs-skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <div class="docs-site-content" id="main-content" tabindex="-1">
      <slot />
    </div>
    <SiteFooter />
    <ExposureMetrics />
  </body>
</html>

<script>
  let shouldScrollDocsContentToTop = false
  let docsSidebarScrollTop = 0
  const colorThemes = ['santi020k-light', 'santi020k-dark', 'lumen-light', 'lumen-dark'] as const
  const themeFamilies = ['santi020k', 'lumen'] as const

  type ColorTheme = typeof colorThemes[number]

  type ThemeFamily = typeof themeFamilies[number]

  type ThemeMode = 'dark' | 'light'

  type LegacyColorTheme = 'dark' | 'light'

  const themeStorageKey = 'lumen-theme'

  const getLegacyTheme = (theme: LegacyColorTheme): ColorTheme => (
    theme === 'dark' ? 'lumen-dark' : 'lumen-light'
  )

  const getThemeColor = (theme: ColorTheme): string => {
    if (theme === 'lumen-dark') return '#111827'

    if (theme === 'lumen-light') return '#f8fafc'

    if (theme === 'santi020k-dark') return '#110c1d'

    return '#f8f6fd'
  }

  const isColorTheme = (theme: string | null | undefined): theme is ColorTheme => (
    colorThemes.includes(theme as ColorTheme)
  )

  const normalizeTheme = (theme: string | null | undefined): ColorTheme | null => {
    if (isColorTheme(theme)) return theme

    return theme === 'dark' || theme === 'light' ? getLegacyTheme(theme) : null
  }

  const isThemeFamily = (themeFamily: string | null | undefined): themeFamily is ThemeFamily => (
    themeFamilies.includes(themeFamily as ThemeFamily)
  )

  const getThemeFamily = (theme: ColorTheme): ThemeFamily => (
    theme.startsWith('lumen') ? 'lumen' : 'santi020k'
  )

  const getThemeMode = (theme: ColorTheme): ThemeMode => (
    theme.endsWith('dark') ? 'dark' : 'light'
  )

  const getTheme = (themeFamily: ThemeFamily, mode: ThemeMode): ColorTheme => (
    `${themeFamily}-${mode}` as ColorTheme
  )

  const getStoredTheme = (): ColorTheme | null => {
    try {
      const storedTheme = localStorage.getItem(themeStorageKey)

      return normalizeTheme(storedTheme)
    } catch {
      return null
    }
  }

  const getSystemTheme = (): ColorTheme => (
    window.matchMedia('(prefers-color-scheme: dark)').matches ? 'lumen-dark' : 'lumen-light'
  )

  const getPreferredTheme = (): ColorTheme => getStoredTheme() ?? getSystemTheme()

  const getToggledTheme = (theme: ColorTheme): ColorTheme => {
    const nextMode = getThemeMode(theme) === 'dark' ? 'light' : 'dark'

    return getTheme(getThemeFamily(theme), nextMode)
  }

  const setThemeColor = (theme: ColorTheme, targetDocument = document) => {
    targetDocument
      .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
      ?.setAttribute('content', getThemeColor(theme))
  }

  const syncThemeToggles = (theme: ColorTheme, targetDocument = document) => {
    const nextTheme = getToggledTheme(theme)
    const label = `Switch to ${getThemeMode(nextTheme)} mode`

    for (const toggle of targetDocument.querySelectorAll<HTMLElement>('[data-theme-toggle], [data-ui-theme-toggle]')) {
      toggle.dataset.themeToggle = theme

      toggle.setAttribute('aria-label', label)

      toggle.setAttribute('title', label)

      toggle.querySelector('[data-theme-toggle-label]')?.replaceChildren(label)
    }
  }

  const syncThemeSelects = (theme: ColorTheme, targetDocument = document) => {
    for (const select of targetDocument.querySelectorAll<HTMLSelectElement>('[data-theme-select]')) {
      select.value = getThemeFamily(theme)
    }
  }

  const applyTheme = (theme: ColorTheme, targetDocument = document) => {
    targetDocument.documentElement.dataset.theme = theme

    targetDocument.documentElement.classList.toggle('dark', getThemeMode(theme) === 'dark')

    setThemeColor(theme, targetDocument)

    syncThemeToggles(theme, targetDocument)

    syncThemeSelects(theme, targetDocument)
  }

  const isDocsNavigation = (sourceElement: unknown) => (
    sourceElement instanceof Element && Boolean(sourceElement.closest('[data-docs-nav]'))
  )

  const getDocsSidebarScroller = (targetDocument = document): HTMLElement | null => (
    targetDocument.querySelector('[data-docs-sidebar] [data-docs-nav]')
  )

  const revealCurrentDocsLink = (scroller: HTMLElement | null): void => {
    const currentLink = scroller?.querySelector<HTMLElement>('[aria-current="page"]')

    if (!scroller || !currentLink) return

    const scrollerRect = scroller.getBoundingClientRect()
    const linkRect = currentLink.getBoundingClientRect()

    if (linkRect.top < scrollerRect.top || linkRect.bottom > scrollerRect.bottom) {
      scroller.scrollTop += linkRect.top - scrollerRect.top - 24
    }
  }

  const preferredColorScheme = window.matchMedia('(prefers-color-scheme: dark)')
  let isThemeAnimating = false

  const commitTheme = (nextTheme: ColorTheme) => {
    localStorage.setItem(themeStorageKey, nextTheme)

    applyTheme(nextTheme)
  }

  const circularRevealTheme = (toggle: HTMLElement, currentTheme: ColorTheme, nextTheme: ColorTheme) => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches

    if (prefersReducedMotion || isTouchDevice) {
      commitTheme(nextTheme)

      return
    }

    isThemeAnimating = true

    const rect = toggle.getBoundingClientRect()
    const x = Math.round(rect.left + rect.width / 2)
    const y = Math.round(rect.top + rect.height / 2)

    const maxRadius = Math.hypot(
      Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y)
    )

    const overlay = document.createElement('div')

    overlay.setAttribute('aria-hidden', 'true')

    Object.assign(overlay.style, {
      position: 'fixed',
      inset: '0',
      zIndex: '99999',
      pointerEvents: 'none',
      backgroundColor: getThemeColor(currentTheme),
      clipPath: `circle(${maxRadius}px at ${x}px ${y}px)`,
      willChange: 'clip-path'
    })

    document.body.appendChild(overlay)

    commitTheme(nextTheme)

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        overlay.style.transition = 'clip-path 580ms cubic-bezier(0.4, 0, 0.2, 1)'

        overlay.style.clipPath = `circle(0px at ${x}px ${y}px)`

        const done = () => {
          overlay.remove()

          isThemeAnimating = false
        }

        overlay.addEventListener('transitionend', done, { once: true })

        setTimeout(done, 750)
      })
    })
  }

  applyTheme(getPreferredTheme())

  revealCurrentDocsLink(getDocsSidebarScroller())

  document.addEventListener('click', event => {
    const toggle = event.target instanceof Element ?
      event.target.closest<HTMLElement>('[data-theme-toggle], [data-ui-theme-toggle]') :
      null

    if (!toggle || isThemeAnimating) return

    const currentTheme = getPreferredTheme()
    const nextTheme = getToggledTheme(currentTheme)

    circularRevealTheme(toggle, currentTheme, nextTheme)
  })

  document.addEventListener('change', event => {
    const select = event.target instanceof Element ?
      event.target.closest<HTMLSelectElement>('[data-theme-select]') :
      null

    if (!select) return

    const currentTheme = getPreferredTheme()
    const selectedFamily = select.value

    const nextTheme = isThemeFamily(selectedFamily) ?
      getTheme(selectedFamily, getThemeMode(currentTheme)) :
      normalizeTheme(selectedFamily)

    if (!nextTheme) {
      syncThemeSelects(currentTheme)

      return
    }

    localStorage.setItem(themeStorageKey, nextTheme)

    applyTheme(nextTheme)
  })

  preferredColorScheme.addEventListener('change', () => {
    if (getStoredTheme()) return

    applyTheme(getSystemTheme())
  })

  document.addEventListener('astro:before-preparation', event => {
    if (!('sourceElement' in event) || !isDocsNavigation(event.sourceElement)) {
      shouldScrollDocsContentToTop = false

      docsSidebarScrollTop = 0

      return
    }

    shouldScrollDocsContentToTop = true

    docsSidebarScrollTop = getDocsSidebarScroller()?.scrollTop ?? 0
  })

  document.addEventListener('astro:before-swap', event => {
    if (!('newDocument' in event)) return

    applyTheme(getPreferredTheme(), event.newDocument)
  })

  document.addEventListener('astro:after-swap', () => {
    applyTheme(getPreferredTheme())

    if (!shouldScrollDocsContentToTop) return

    window.scrollTo({
      behavior: 'instant',
      left: 0,
      top: 0
    })

    const docsSidebarScroller = getDocsSidebarScroller()

    if (docsSidebarScroller) {
      docsSidebarScroller.scrollTop = docsSidebarScrollTop
    }

    revealCurrentDocsLink(docsSidebarScroller)

    shouldScrollDocsContentToTop = false

    docsSidebarScrollTop = 0
  })
</script>

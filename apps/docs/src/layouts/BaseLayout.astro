---
import { ClientRouter } from 'astro:transitions'

import '../styles/global.css'

import UIPrimitives from '@santi020k/lumen-astro/runtime'
import MetadataHead from '@santi020k/og/astro/head'
import {
  articleSchema,
  breadcrumbSchema,
  composeJsonLd,
  defineSchema,
  organizationSchema,
  personSchema,
  serializeJsonLd,
  webSiteSchema
} from '@santi020k/og/schema'
import { defineSite } from '@santi020k/og/site'

import ExposureMetrics from '../components/ExposureMetrics.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { siteThemePreferences, themeStorageKey } from '../data/site-themes'
import { latinFontUrl } from '../data/web-font'
import { getSocialImageUrl } from '../lib/social-image'

interface Props {
  article?: {
    author: string
    publishedAt: string
    updatedAt?: string
  }
  breadcrumbs?: {
    href: string
    label: string
  }[]
  description: string
  noindex?: boolean
  socialImage?: string
  title: string
}

const {
  article,
  breadcrumbs = [],
  description,
  noindex = false,
  socialImage,
  title
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const socialImageUrl = getSocialImageUrl(Astro.url.pathname, Astro.site, socialImage)

const site = defineSite({
  locale: 'en_US',
  siteName: 'Lumen UI',
  siteUrl: Astro.site ?? 'https://lumen.santi020k.com/'
})

const page = site.page({
  ...(article ?
{
    article: {
      authors: [article.author],
      ...(article.updatedAt ? { modifiedTime: article.updatedAt } : {}),
      publishedTime: article.publishedAt
    }
  } :
{}),
  description,
  image: { alt: `${title} social preview`, height: 630, type: 'image/webp', url: socialImageUrl, width: 1200 },
  pathname: Astro.url.pathname,
  robots: { index: !noindex, maxImagePreview: 'large' },
  title,
  type: article ? 'article' : 'website'
})

const siteUrl = new URL('/', Astro.site)
const organizationId = new URL('/#organization', Astro.site)
const websiteId = new URL('/#website', Astro.site)
const softwareId = new URL('/#software', Astro.site)
const pageId = new URL(`${Astro.url.pathname}#webpage`, Astro.site)
const creatorId = 'https://santi020k.com/#person'
const getCanonicalItemUrl = (href: string): URL => new URL(href, Astro.site)

const organization = organizationSchema({ id: organizationId.href, name: 'Lumen UI', url: siteUrl }, {
  sameAs: [
    'https://github.com/santi020k/lumen',
    'https://www.figma.com/community/file/1662337342676541513'
  ]
})

const website = webSiteSchema({
  id: websiteId.href,
  name: 'Lumen UI',
  publisher: defineSchema({ '@id': organizationId.href, '@type': 'Organization' }),
  url: siteUrl
})

const creator = defineSchema({
  '@id': creatorId,
  '@type': 'Person',
  name: 'Santiago Molina',
  url: 'https://santi020k.com'
})

const software = defineSchema({
  '@id': softwareId.href,
  '@type': 'SoftwareSourceCode',
  author: defineSchema({ '@id': creatorId, '@type': 'Person' }),
  codeRepository: 'https://github.com/santi020k/lumen',
  description: 'An open-source UI library for AI-assisted development of accessible web and native interfaces.',
  isAccessibleForFree: true,
  license: 'https://opensource.org/license/mit',
  name: 'Lumen UI',
  programmingLanguage: ['TypeScript', 'Swift', 'Kotlin'],
  url: siteUrl.href
})

const pageStructuredData = article ?
  articleSchema({
    author: personSchema({ name: article.author }),
    dateModified: article.updatedAt ?? article.publishedAt,
    datePublished: article.publishedAt,
    description,
    id: pageId.href,
    image: socialImageUrl,
    isPartOf: defineSchema({ '@id': websiteId.href, '@type': 'WebSite' }),
    name: title,
    publisher: defineSchema({ '@id': organizationId.href, '@type': 'Organization' }),
    type: 'TechArticle',
    url: canonicalUrl
  }, { mainEntityOfPage: canonicalUrl.href }) :
  defineSchema({
    '@id': pageId.href,
    '@type': 'WebPage',
    description,
    isPartOf: defineSchema({ '@id': websiteId.href, '@type': 'WebSite' }),
    inLanguage: 'en',
    isAccessibleForFree: true,
    primaryImageOfPage: defineSchema({ '@type': 'ImageObject', contentUrl: socialImageUrl, height: 630, width: 1200 }),
    name: title,
    ...(Astro.url.pathname.startsWith('/docs') ? { about: defineSchema({ '@id': softwareId.href, '@type': 'SoftwareSourceCode' }) } : {}),
    url: canonicalUrl.href
  })

const breadcrumbStructuredData = breadcrumbs.length > 0 ?
breadcrumbSchema(
  breadcrumbs.map(item => ({ name: item.label, url: getCanonicalItemUrl(item.href) }))
) :
undefined

const structuredData = composeJsonLd(
  organization,
  website,
  creator,
  software,
  pageStructuredData,
  breadcrumbStructuredData
)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <MetadataHead {page} site={site.options} noindexPolicy="minimal" />
    <meta name="theme-color" content="#f5f4ef" />
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(structuredData)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lumen UI Guides"
      href={new URL('/guides/rss.xml', Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={latinFontUrl} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <script define:vars={{ siteThemePreferences, themeStorageKey }}>
      const systemMode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      let key = `lumen-${systemMode}`

      try {
        const stored = localStorage.getItem(themeStorageKey)

        if (stored && Object.hasOwn(siteThemePreferences, stored)) key = stored
      } catch {
        // Use the system scheme when storage is unavailable.
      }

      const theme = siteThemePreferences[key]
      const root = document.documentElement

      root.dataset.theme = theme.rootTheme

      if (theme.family.preset) root.dataset.lumenPreset = theme.family.preset

      root.classList.toggle('dark', theme.mode === 'dark')
    </script>
  </head>
  <body>
    <UIPrimitives />
    <a class="docs-skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <div class="docs-site-content" id="main-content" tabindex="-1">
      <slot />
    </div>
    <SiteFooter />
    <ExposureMetrics />
  </body>
</html>

<script>
  import {
    defaultThemeFamily,
    type SiteTheme,
    siteTheme,
    siteThemeFamilies,
    siteThemePreferences,
    themeStorageKey
  } from '../data/site-themes'

  let shouldScrollDocsContentToTop = false
  let docsSidebarScrollTop = 0
  let sessionTheme: SiteTheme | null = null

  const getStoredTheme = (): SiteTheme | null => {
    try {
      const stored = localStorage.getItem(themeStorageKey)

      return stored && Object.hasOwn(siteThemePreferences, stored) ? siteThemePreferences[stored] ?? null : null
    } catch {
      return null
    }
  }

  const preferredColorScheme = window.matchMedia('(prefers-color-scheme: dark)')
  const getSystemTheme = () => siteTheme(defaultThemeFamily, preferredColorScheme.matches ? 'dark' : 'light')
  const getPreferredTheme = () => sessionTheme ?? getStoredTheme() ?? getSystemTheme()
  const getNextMode = (theme: SiteTheme) => theme.mode === 'dark' ? 'light' : 'dark'

  const syncThemeToggles = (theme: SiteTheme, targetDocument = document) => {
    const label = `Switch to ${getNextMode(theme)} mode`

    for (const toggle of targetDocument.querySelectorAll<HTMLElement>('[data-theme-toggle], [data-ui-theme-toggle]')) {
      toggle.dataset.themeToggle = theme.key

      toggle.setAttribute('aria-label', label)

      toggle.setAttribute('title', label)

      toggle.querySelector('[data-theme-toggle-label]')?.replaceChildren(label)
    }
  }

  const syncThemeSelects = (theme: SiteTheme, targetDocument = document) => {
    for (const select of targetDocument.querySelectorAll<HTMLSelectElement>('[data-theme-select]')) {
      select.value = theme.family.value

      // Notify the enhanced Select without re-entering the delegated theme handler.
      select.dispatchEvent(new Event('change'))
    }
  }

  const applyTheme = (theme: SiteTheme, targetDocument = document) => {
    const root = targetDocument.documentElement

    root.dataset.theme = theme.rootTheme

    if (theme.family.preset) root.dataset.lumenPreset = theme.family.preset
    else delete root.dataset.lumenPreset

    root.classList.toggle('dark', theme.mode === 'dark')

    // During an Astro swap the incoming document has no computed styles yet.
    targetDocument.querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', getComputedStyle(document.documentElement).backgroundColor)

    syncThemeToggles(theme, targetDocument)

    syncThemeSelects(theme, targetDocument)
  }

  const isDocsNavigation = (sourceElement: unknown) => (
    sourceElement instanceof Element && Boolean(sourceElement.closest('[data-docs-nav]'))
  )

  const getDocsSidebarScroller = (targetDocument = document): HTMLElement | null => (
    targetDocument.querySelector('[data-docs-sidebar] [data-docs-nav]')
  )

  const revealCurrentDocsLink = (scroller: HTMLElement | null): void => {
    const currentLink = scroller?.querySelector<HTMLElement>('[aria-current="page"]')

    if (!scroller || !currentLink) return

    const scrollerRect = scroller.getBoundingClientRect()
    const linkRect = currentLink.getBoundingClientRect()

    if (linkRect.top < scrollerRect.top || linkRect.bottom > scrollerRect.bottom) {
      scroller.scrollTop += linkRect.top - scrollerRect.top - 24
    }
  }

  let isThemeAnimating = false

  const commitTheme = (nextTheme: SiteTheme) => {
    sessionTheme = nextTheme

    try {
      localStorage.setItem(themeStorageKey, nextTheme.key)
    } catch {
      // Theme controls still work for this document when storage is unavailable.
    }

    applyTheme(nextTheme)
  }

  const circularRevealTheme = (toggle: HTMLElement, nextTheme: SiteTheme) => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches

    if (prefersReducedMotion || isTouchDevice) {
      commitTheme(nextTheme)

      return
    }

    isThemeAnimating = true

    const rect = toggle.getBoundingClientRect()
    const x = Math.round(rect.left + rect.width / 2)
    const y = Math.round(rect.top + rect.height / 2)

    const maxRadius = Math.hypot(
      Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y)
    )

    const overlay = document.createElement('div')

    overlay.setAttribute('aria-hidden', 'true')

    Object.assign(overlay.style, {
      position: 'fixed',
      inset: '0',
      zIndex: '99999',
      pointerEvents: 'none',
      backgroundColor: getComputedStyle(document.documentElement).backgroundColor,
      clipPath: `circle(${maxRadius}px at ${x}px ${y}px)`,
      willChange: 'clip-path'
    })

    document.body.appendChild(overlay)

    commitTheme(nextTheme)

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        overlay.style.transition = 'clip-path 580ms cubic-bezier(0.4, 0, 0.2, 1)'

        overlay.style.clipPath = `circle(0px at ${x}px ${y}px)`

        const done = () => {
          overlay.remove()

          isThemeAnimating = false
        }

        overlay.addEventListener('transitionend', done, { once: true })

        setTimeout(done, 750)
      })
    })
  }

  applyTheme(getPreferredTheme())

  revealCurrentDocsLink(getDocsSidebarScroller())

  document.addEventListener('click', event => {
    const toggle = event.target instanceof Element ?
      event.target.closest<HTMLElement>('[data-theme-toggle], [data-ui-theme-toggle]') :
      null

    if (!toggle || isThemeAnimating) return

    const currentTheme = getPreferredTheme()

    circularRevealTheme(toggle, siteTheme(currentTheme.family, getNextMode(currentTheme)))
  })

  document.addEventListener('change', event => {
    const select = event.target instanceof Element ?
      event.target.closest<HTMLSelectElement>('[data-theme-select]') :
      null

    if (!select) return

    const currentTheme = getPreferredTheme()
    const family = siteThemeFamilies.find(option => option.value === select.value)

    if (!family) {
      syncThemeSelects(currentTheme)

      return
    }

    commitTheme(siteTheme(family, currentTheme.mode))
  })

  preferredColorScheme.addEventListener('change', () => {
    if (sessionTheme || getStoredTheme()) return

    applyTheme(getSystemTheme())
  })

  document.addEventListener('astro:before-preparation', event => {
    if (!('sourceElement' in event) || !isDocsNavigation(event.sourceElement)) {
      shouldScrollDocsContentToTop = false

      docsSidebarScrollTop = 0

      return
    }

    shouldScrollDocsContentToTop = true

    docsSidebarScrollTop = getDocsSidebarScroller()?.scrollTop ?? 0
  })

  document.addEventListener('astro:before-swap', event => {
    if (!('newDocument' in event)) return

    applyTheme(getPreferredTheme(), event.newDocument)
  })

  document.addEventListener('astro:after-swap', () => {
    applyTheme(getPreferredTheme())

    if (!shouldScrollDocsContentToTop) return

    window.scrollTo({
      behavior: 'instant',
      left: 0,
      top: 0
    })

    const docsSidebarScroller = getDocsSidebarScroller()

    if (docsSidebarScroller) {
      docsSidebarScroller.scrollTop = docsSidebarScrollTop
    }

    revealCurrentDocsLink(docsSidebarScroller)

    shouldScrollDocsContentToTop = false

    docsSidebarScrollTop = 0
  })
</script>

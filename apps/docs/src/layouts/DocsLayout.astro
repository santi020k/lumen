---
/* eslint-disable better-tailwindcss/no-unknown-classes */
import { Badge, Icon } from '@santi020k/lumen-astro'

import DocsSearch from '../components/DocsSearch.astro'
import { componentCategories, componentDocs, componentNavigationDocs } from '../data/docs'
import { toSlug } from '../lib/routes'

import BaseLayout from './BaseLayout.astro'

interface Props {
  description: string
  title: string
}

const { description, title } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '')

const gettingStarted = [
  ['Introduction', '/docs'],
  ['Figma', '/docs/figma'],
  ['MCP server', '/docs/mcp'],
  ['Icons', '/docs/icons'],
  ['Components', '/docs/components'],
  ['Theme playground', '/docs/theme-playground']
] as const

const frameworkLinks = [
  ['Astro', '/docs/frameworks/astro'],
  ['React', '/docs/frameworks/react'],
  ['Elements', '/docs/frameworks/elements']
] as const

const isCurrent = (href: string) => currentPath === href

const currentComponent = componentNavigationDocs.find(component =>
  isCurrent(`/docs/components/${toSlug(component.name)}`)
)

---

<BaseLayout description={description} title={title}>
  <div class="docs-shell">
    <div class="docs-shell__wash" aria-hidden="true"></div>
    <aside
      class="docs-sidebar"
      aria-label="Documentation"
      data-docs-sidebar
    >
      <div class="docs-sidebar__top">
        <div class="docs-sidebar__label">
          <span><Icon decorative name="book-open" size="sm" /></span>
          <div>
            <strong>Documentation</strong>
            <small>{componentDocs.length} production primitives</small>
          </div>
        </div>
        <DocsSearch
          class="max-w-none"
          inputId="docs-sidebar-search-input"
          optionIdPrefix="docs-sidebar-search"
          placeholder="Search the docs..."
          resultsId="docs-sidebar-search-results"
        />
      </div>

      <nav class="docs-sidebar__nav" data-docs-nav>
        <div class="docs-sidebar__group">
          <p>Start here</p>
          {gettingStarted.map(([label, href]) => (
            <a
              aria-current={isCurrent(href) ? 'page' : undefined}
              class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
              href={href}
            >
              <span>{label}</span>
              {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
            </a>
          ))}
        </div>
        <div class="docs-sidebar__group">
          <p>Frameworks</p>
          {frameworkLinks.map(([label, href]) => (
            <a
              aria-current={isCurrent(href) ? 'page' : undefined}
              class:list={{ 'docs-sidebar__link': true, 'is-current': isCurrent(href) }}
              href={href}
            >
              <span>{label}</span>
              {isCurrent(href) && <Icon decorative name="arrow-right" size="sm" />}
            </a>
          ))}
        </div>
        <div class="docs-sidebar__components-label">
          <span>Components</span>
          <a href="/docs/components">Browse all</a>
        </div>
        {componentCategories.map(category => (
          <details
            class="docs-sidebar__group docs-sidebar__group--collapsible"
            open={currentComponent?.category === category}
          >
            <summary>
              <span>{category}</span>
              <span>
                <Badge variant="outline">
                  {componentNavigationDocs.filter(component => component.category === category).length}
                </Badge>
                <Icon decorative name="chevron-right" size="sm" />
              </span>
            </summary>
            <div>
              {componentNavigationDocs.filter(component => component.category === category).map(component => (
                <a
                  aria-current={isCurrent(`/docs/components/${toSlug(component.name)}`) ? 'page' : undefined}
                  class:list={{
                    'docs-sidebar__link': true,
                    'is-current': isCurrent(`/docs/components/${toSlug(component.name)}`)
                  }}
                  href={`/docs/components/${toSlug(component.name)}`}
                >
                  <span class="truncate">{component.name}</span>
                  {component.glass && (
                    <span class="docs-sidebar__glass">Glass</span>
                  )}
                </a>
              ))}
            </div>
          </details>
        ))}
      </nav>
    </aside>
    <main class="docs-content">
      <div class="docs-mobile-search">
        <span>Documentation</span>
        <DocsSearch
          class="max-w-2xl"
          inputId="docs-mobile-search-input"
          optionIdPrefix="docs-mobile-search"
          resultsId="docs-mobile-search-results"
        />
      </div>
      <slot />
    </main>
  </div>
</BaseLayout>

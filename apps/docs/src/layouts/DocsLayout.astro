---
import { Button, Drawer, Icon } from '@santi020k/lumen-astro'

import DocsNavigation from '../components/DocsNavigation.astro'
import DocsPageNavigation from '../components/DocsPageNavigation.astro'
import { getDocsPlatform, getPlatformGuide } from '../data/platforms'
import { getDocsBreadcrumbs } from '../lib/docs-breadcrumbs'
import type { DocsPageNavigationItem } from '../lib/docs-page-navigation'

import BaseLayout from './BaseLayout.astro'

interface Props {
  breadcrumbs?: {
    href: string
    label: string
  }[]
  description: string
  pageNavigation?: DocsPageNavigationItem[] | false | undefined
  title: string
}

const { breadcrumbs, description, pageNavigation, title } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '')
const activePlatform = getDocsPlatform(currentPath)

const navigationDescription = activePlatform ?
  getPlatformGuide(activePlatform).status :
  'Web and native guides'

let navigationLabel = 'All documentation'

if (activePlatform) navigationLabel = `${getPlatformGuide(activePlatform).shortLabel} docs`

if (currentPath === '/changelog') navigationLabel = 'Changelog'

---

<BaseLayout breadcrumbs={getDocsBreadcrumbs(currentPath, title, breadcrumbs)} description={description} title={title}>
  <div class="docs-shell">
    <div class="docs-shell__wash" aria-hidden="true"></div>
    <aside
      class="docs-sidebar"
      aria-label="Documentation"
      data-docs-sidebar
    >
      <div class="docs-sidebar__top">
        <div class="docs-sidebar__label">
          <span><Icon decorative name="book-open" size="sm" /></span>
          <div>
            <strong>Documentation</strong>
            <small>{navigationDescription}</small>
          </div>
        </div>
      </div>

      <DocsNavigation currentPath={currentPath} platform={activePlatform} />
    </aside>
    <main class="docs-content">
      <div class="docs-mobile-navigation-bar" data-docs-page-bar>
        <div class="docs-mobile-navigation-bar__header">
          <span>{navigationLabel}</span>
          <DocsPageNavigation items={pageNavigation} />
          <Button
            class="docs-mobile-nav-trigger"
            size="sm"
            variant="outline"
            data-ui-drawer-trigger="docs-mobile-navigation"
            aria-label={`Browse ${navigationLabel.toLowerCase()}`}
          >
            <Icon decorative name="menu" size="sm" />
            Browse
          </Button>
        </div>
      </div>
      <slot />
    </main>
    <Drawer
      class="docs-mobile-drawer"
      id="docs-mobile-navigation"
      aria-labelledby="docs-mobile-navigation-title"
    >
      <div class="docs-mobile-drawer__header">
        <div>
          <strong id="docs-mobile-navigation-title">{navigationLabel}</strong>
          <small>{navigationDescription}</small>
        </div>
        <Button
          size="icon"
          variant="ghost"
          data-ui-drawer-close
          aria-label="Close documentation menu"
        >
          <Icon decorative name="x" size="sm" />
        </Button>
      </div>
      <DocsNavigation currentPath={currentPath} platform={activePlatform} />
    </Drawer>
  </div>
</BaseLayout>

<style>
  .docs-mobile-navigation-bar[data-docs-page-bar]:has(:global(.docs-page-navigation:not([hidden]))) > .docs-mobile-navigation-bar__header > span { display: none; }
  @media (min-width: 64rem) {
    .docs-mobile-navigation-bar[data-docs-page-bar]:has(:global(.docs-page-navigation:not([hidden]))) { display: block; margin: 0 0 1.25rem; padding: 0.25rem; border: 1px solid hsl(var(--line) / 0.7); border-radius: 0.65rem; }
    .docs-mobile-navigation-bar[data-docs-page-bar] :global(.docs-mobile-nav-trigger) { display: none; }
  }
</style>

<script>
  let headerObserver: ResizeObserver | undefined

  const syncDocsHeaderHeight = (): void => {
    headerObserver?.disconnect()

    const header = document.querySelector<HTMLElement>('.docs-site-header')

    if (!header || !document.querySelector('.docs-shell')) {
      document.documentElement.style.removeProperty('--docs-sticky-header-height')

      document.documentElement.style.removeProperty('--docs-sticky-navigation-height')

      return
    }

    const updateHeight = (): void => {
      document.documentElement.style.setProperty(
        '--docs-sticky-header-height',
        `${header.getBoundingClientRect().height}px`
      )

      const navigation = document.querySelector<HTMLElement>('.docs-mobile-navigation-bar')

      document.documentElement.style.setProperty(
        '--docs-sticky-navigation-height',
        `${navigation?.getBoundingClientRect().height ?? 0}px`
      )
    }

    updateHeight()

    headerObserver = new ResizeObserver(updateHeight)

    headerObserver.observe(header)

    const navigation = document.querySelector<HTMLElement>('.docs-mobile-navigation-bar')

    if (navigation) headerObserver.observe(navigation)
  }

  syncDocsHeaderHeight()

  document.addEventListener('astro:after-swap', syncDocsHeaderHeight)

  document.addEventListener('astro:before-swap', () => headerObserver?.disconnect())
</script>

---
import { componentCategories, componentDocs } from '../data/docs'
import { toSlug } from '../lib/routes'

import BaseLayout from './BaseLayout.astro'

interface Props {
  description: string
  title: string
}

const { description, title } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '')

const gettingStarted = [
  ['Introduction', '/docs'],
  ['Components', '/docs/components']
] as const

const isCurrent = (href: string) => currentPath === href
---

<BaseLayout description={description} title={title}>
  <div class="
    mx-auto grid w-full max-w-7xl gap-10 px-5 py-8
    sm:px-8
    lg:grid-cols-[15rem_minmax(0,1fr)]
  ">
    <aside class="
      hidden
      lg:sticky lg:top-20 lg:block lg:max-h-[calc(100vh-6rem)]
      lg:overflow-y-auto lg:pr-2 lg:pb-8
    " aria-label="Documentation">
      <nav class="grid gap-6 text-sm" data-docs-nav>
        <div class="grid gap-1">
          <p class="
            mb-1 text-xs font-black tracking-[0.14em] text-ink-muted uppercase
          ">Getting started</p>
          {gettingStarted.map(([label, href]) => (
            <a
              aria-current={isCurrent(href) ? 'page' : undefined}
              class:list={[
                `
                  rounded-sm px-2 py-1 no-underline
                  hover:text-ink
                `,
                isCurrent(href) ? 'bg-brand-soft font-bold text-ink' : `
                  text-ink-soft
                `
              ]}
              href={href}
            >{label}</a>
          ))}
        </div>
        {componentCategories.map(category => (
          <div class="grid gap-1">
            <p class="
              mb-1 text-xs font-black tracking-[0.14em] text-ink-muted uppercase
            ">{category}</p>
            {componentDocs.filter(component => component.category === category).map(component => (
              <a
                aria-current={isCurrent(`/docs/components/${toSlug(component.name)}`) ? 'page' : undefined}
                class:list={[
                  `
                    flex items-center justify-between gap-2 rounded-sm px-2 py-1 no-underline
                    hover:text-ink
                  `,
                  isCurrent(`/docs/components/${toSlug(component.name)}`)
                    ? 'bg-brand-soft font-bold text-ink'
                    : 'text-ink-soft'
                ]}
                href={`/docs/components/${toSlug(component.name)}`}
              >
                <span class="truncate">{component.name}</span>
                {component.glass && (
                  <span class="
                    shrink-0 rounded-sm border border-line px-1.5 py-0.5
                    text-[0.65rem] leading-none font-bold text-ink-muted
                  ">Glass</span>
                )}
              </a>
            ))}
          </div>
        ))}
      </nav>
    </aside>
    <div class="min-w-0 pb-16">
      <slot />
    </div>
  </div>
</BaseLayout>

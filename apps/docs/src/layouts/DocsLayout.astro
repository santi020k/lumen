---
import { Button, Drawer, Icon } from '@santi020k/lumen-astro'

import DocsNavigation from '../components/DocsNavigation.astro'
import { getDocsPlatform, getPlatformGuide } from '../data/platforms'

import BaseLayout from './BaseLayout.astro'

interface Props {
  breadcrumbs?: {
    href: string
    label: string
  }[]
  description: string
  title: string
}

const { breadcrumbs, description, title } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '')
const activePlatform = getDocsPlatform(currentPath)

const navigationDescription = activePlatform ?
  getPlatformGuide(activePlatform).status :
  'Web and native guides'

let navigationLabel = 'All documentation'

if (activePlatform) navigationLabel = `${getPlatformGuide(activePlatform).shortLabel} docs`

if (currentPath === '/changelog') navigationLabel = 'Changelog'

---

<BaseLayout breadcrumbs={breadcrumbs ?? []} description={description} title={title}>
  <div class="docs-shell">
    <div class="docs-shell__wash" aria-hidden="true"></div>
    <aside
      class="docs-sidebar"
      aria-label="Documentation"
      data-docs-sidebar
    >
      <div class="docs-sidebar__top">
        <div class="docs-sidebar__label">
          <span><Icon decorative name="book-open" size="sm" /></span>
          <div>
            <strong>Documentation</strong>
            <small>{navigationDescription}</small>
          </div>
        </div>
      </div>

      <DocsNavigation currentPath={currentPath} platform={activePlatform} />
    </aside>
    <main class="docs-content">
      <div class="docs-mobile-navigation-bar">
        <div class="docs-mobile-navigation-bar__header">
          <span>{navigationLabel}</span>
          <Button
            class="docs-mobile-nav-trigger"
            size="sm"
            variant="outline"
            data-ui-drawer-trigger="docs-mobile-navigation"
            aria-label={`Browse ${navigationLabel.toLowerCase()}`}
          >
            <Icon decorative name="menu" size="sm" />
            Browse
          </Button>
        </div>
      </div>
      <slot />
    </main>
    <Drawer
      class="docs-mobile-drawer"
      id="docs-mobile-navigation"
      aria-labelledby="docs-mobile-navigation-title"
    >
      <div class="docs-mobile-drawer__header">
        <div>
          <strong id="docs-mobile-navigation-title">{navigationLabel}</strong>
          <small>{navigationDescription}</small>
        </div>
        <Button
          size="icon"
          variant="ghost"
          data-ui-drawer-close
          aria-label="Close documentation menu"
        >
          <Icon decorative name="x" size="sm" />
        </Button>
      </div>
      <DocsNavigation currentPath={currentPath} platform={activePlatform} />
    </Drawer>
  </div>
</BaseLayout>

---
import { Button, Drawer, Icon } from '@santi020k/lumen-astro'

import DocsNavigation from '../components/DocsNavigation.astro'
import DocsSearch from '../components/DocsSearch.astro'
import { componentDocs } from '../data/docs'

import BaseLayout from './BaseLayout.astro'

interface Props {
  description: string
  title: string
}

const { description, title } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '')

---

<BaseLayout description={description} title={title}>
  <div class="docs-shell">
    <div class="docs-shell__wash" aria-hidden="true"></div>
    <aside
      class="docs-sidebar"
      aria-label="Documentation"
      data-docs-sidebar
    >
      <div class="docs-sidebar__top">
        <div class="docs-sidebar__label">
          <span><Icon decorative name="book-open" size="sm" /></span>
          <div>
            <strong>Documentation</strong>
            <small>{componentDocs.length} production primitives</small>
          </div>
        </div>
        <DocsSearch
          class="max-w-none"
          inputId="docs-sidebar-search-input"
          optionIdPrefix="docs-sidebar-search"
          placeholder="Search the docs..."
          resultsId="docs-sidebar-search-results"
        />
      </div>

      <DocsNavigation currentPath={currentPath} />
    </aside>
    <main class="docs-content">
      <div class="docs-mobile-search">
        <div class="docs-mobile-search__header">
          <span>Documentation</span>
          <Button
            class="docs-mobile-nav-trigger"
            size="sm"
            variant="outline"
            data-ui-drawer-trigger="docs-mobile-navigation"
            aria-label="Browse documentation pages"
          >
            <Icon decorative name="menu" size="sm" />
            Browse
          </Button>
        </div>
        <DocsSearch
          class="max-w-2xl"
          inputId="docs-mobile-search-input"
          optionIdPrefix="docs-mobile-search"
          resultsId="docs-mobile-search-results"
        />
      </div>
      <slot />
    </main>
    <Drawer
      class="docs-mobile-drawer"
      id="docs-mobile-navigation"
      aria-labelledby="docs-mobile-navigation-title"
    >
      <div class="docs-mobile-drawer__header">
        <div>
          <strong id="docs-mobile-navigation-title">Documentation</strong>
          <small>{componentDocs.length} production primitives</small>
        </div>
        <Button
          size="icon"
          variant="ghost"
          data-ui-drawer-close
          aria-label="Close documentation menu"
        >
          <Icon decorative name="x" size="sm" />
        </Button>
      </div>
      <DocsNavigation closeOnNavigate currentPath={currentPath} />
    </Drawer>
  </div>
</BaseLayout>

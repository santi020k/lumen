---
import {
  Field,
  InputOTP,
  Kbd,
  Label
} from '@santi020k/lumen-astro'
---

<Field>
  <Label for="ex-otp">Verification code</Label>
  <InputOTP
    aria-describedby="ex-otp-hint"
    id="ex-otp"
    length={6}
    name="code"
    value="123456"
    required
  />
  <p id="ex-otp-hint">Paste the full code, or move through digits with <Kbd>Arrow Left</Kbd> / <Kbd>Arrow Right</Kbd>.</p>
</Field>

---
import {
  AlertDialog,
  Button
} from '@santi020k/lumen-astro'
---

<div class="docs-glass-demo" style="justify-items: center;">
  <Button variant="destructive" data-ui-alert-dialog-trigger="ex-alert-dialog-glass">Delete project</Button>
</div>
<AlertDialog id="ex-alert-dialog-glass" glass>
  <h2>Delete this project?</h2>
  <p>The glass pane reads as a lens: the page behind it stays visible but blurred and dimmed.</p>
  <footer>
    <Button variant="ghost" data-ui-alert-dialog-close>Cancel</Button>
    <Button variant="destructive" data-ui-alert-dialog-close>Delete</Button>
  </footer>
</AlertDialog>

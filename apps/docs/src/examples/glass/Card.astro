---
import {
  Badge,
  Button,
  Card
} from '@santi020k/lumen-astro'
---

<div style="position: relative; overflow: hidden; padding: 2.75rem 2rem; border-radius: 1rem; background: linear-gradient(120deg, hsl(var(--brand)), hsl(var(--accent)) 55%, hsl(var(--warning)));">
  <span style="position: absolute; top: -3rem; right: 10%; width: 11rem; height: 11rem; border-radius: 999px; background: hsl(var(--danger) / 0.85);"></span>
  <span style="position: absolute; bottom: -3.5rem; left: 6%; width: 13rem; height: 13rem; border-radius: 999px; background: hsl(var(--warning) / 0.9);"></span>
  <Card glass style="position: relative; max-width: 20rem;">
    <Badge variant="outline">Glass</Badge>
    <h3>Pro</h3>
    <p>The glass card blurs and saturates whatever sits behind it.</p>
    <Button size="sm">Choose plan</Button>
  </Card>
</div>

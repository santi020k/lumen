---
import { BarChart } from '@santi020k/lumen-astro'

const series = [
  {
    data: [
      { x: 'Build', y: 18 },
      { x: 'Test', y: 11 },
      { x: 'Deploy', y: 7 }
    ],
    id: 'minutes',
    label: 'Minutes'
  }
]
---

<div class="docs-glass-demo">
  <BarChart
    aria-label="Pipeline duration"
    glass
    heading="Pipeline duration"
    {series}
  />
</div>

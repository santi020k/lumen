---
import {
  Button,
  DropdownMenu
} from '@santi020k/lumen-astro'
---

<div class="docs-glass-demo docs-glass-demo--float">
  <DropdownMenu glass>
    <Button data-ui-trigger>More actions</Button>
    <div role="menu">
      <button role="menuitem">Rename</button>
      <button role="menuitem">Duplicate</button>
      <button role="menuitem">Archive</button>
    </div>
  </DropdownMenu>
</div>

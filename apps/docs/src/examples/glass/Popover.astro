---
import {
  Button,
  Field,
  Input,
  Label,
  Popover
} from '@santi020k/lumen-astro'
---

<div class="docs-glass-demo docs-glass-demo--float">
  <Popover glass>
    <Button data-ui-trigger>Open glass popover</Button>
    <div>
      <Field>
        <Label for="ex-invite-glass">Email address</Label>
        <Input id="ex-invite-glass" type="email" placeholder="teammate@example.com" />
      </Field>
      <Button size="sm">Send invite</Button>
    </div>
  </Popover>
</div>

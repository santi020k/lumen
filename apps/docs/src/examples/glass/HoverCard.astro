---
import { HoverCard } from '@santi020k/lumen-astro'
---

<div style="position: relative; min-height: 14rem; padding: 2rem; border-radius: 1rem; background: linear-gradient(120deg, hsl(var(--brand)), hsl(var(--accent)) 55%, hsl(var(--warning)));">
  <span style="position: absolute; top: 16%; right: 8%; width: 8rem; height: 8rem; border-radius: 999px; background: hsl(var(--danger) / 0.85);"></span>
  <span style="position: absolute; bottom: 10%; left: 38%; width: 6.5rem; height: 6.5rem; border-radius: 999px; background: hsl(var(--warning) / 0.9);"></span>
  <HoverCard glass>
    <a href="/docs" data-ui-trigger>@santi020k</a>
    <div>
      <strong>Santiago Molina</strong>
      <p>The glass hover card blurs the colorful content behind it.</p>
    </div>
  </HoverCard>
</div>

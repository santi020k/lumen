---
import { Skeleton, Stack, VisuallyHidden } from '@santi020k/lumen-astro'
---

{/* Announce a loading group once, with deterministic placeholder widths for server rendering. */}
<Stack aria-busy="true" role="status" gap="md">
  <VisuallyHidden>Loading profile</VisuallyHidden>
  <Stack direction="horizontal" gap="sm" align="center">
    <Skeleton shape="circle" width={40} />
    <Stack gap="xs" style="flex: 1;">
      <Skeleton shape="text" height="1rem" width="40%" />
      <Skeleton shape="text" width="80%" />
      <Skeleton animation="pulse" height={8} width="60%" />
    </Stack>
  </Stack>
</Stack>
<Skeleton aria-label="Loading article" height="6rem" />

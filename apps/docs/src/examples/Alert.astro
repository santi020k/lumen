---
import { Alert } from '@santi020k/lumen-astro'
---

<Alert>
  <strong>Project synced.</strong>
  <p>Your design tokens are up to date.</p>
</Alert>
<Alert variant="success">
  <strong>Deployed.</strong>
  <p>lumen-docs is live in production.</p>
</Alert>
<Alert variant="warning">
  <strong>Certificate expiring.</strong>
  <p>Renew the custom domain certificate within 7 days.</p>
</Alert>
<Alert variant="destructive">
  <strong>Build failed.</strong>
  <p>Type error in Button.astro — deploy blocked.</p>
</Alert>

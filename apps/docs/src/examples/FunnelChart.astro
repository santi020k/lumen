---
import { FunnelChart } from '@santi020k/lumen-astro'

const data = [
  { id: 'visited', label: 'Visited', value: 600 },
  { id: 'signed-up', label: 'Signed up', value: 180 },
  { id: 'activated', label: 'Activated', value: 96 }
]
---

<FunnelChart

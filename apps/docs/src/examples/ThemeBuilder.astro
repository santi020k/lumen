---
import { Label, ThemeBuilder } from '@santi020k/lumen-astro'
---

<ThemeBuilder>
  <header><h3>Brand theme</h3></header>
  <div style="display: grid; gap: 0.45rem;">
    <Label for="ex-theme-hue">Brand hue</Label>
    <input
      id="ex-theme-hue"
      data-ui-theme-hue
      type="range"
      class="ui-slider"
      min="0"
      max="359"
      value="264"
    />
    <p style="margin: 0; font-size: 0.8125rem;">
      Dragging the slider regenerates the full token set from a single hue, live on this page.
    </p>
  </div>
  <span data-ui-swatch style="--ui-swatch:hsl(var(--brand))"></span>
  <span data-ui-swatch style="--ui-swatch:hsl(var(--accent))"></span>
  <button data-ui-theme-export type="button">Export CSS</button>
  <textarea data-ui-theme-output aria-label="Theme CSS"></textarea>
</ThemeBuilder>

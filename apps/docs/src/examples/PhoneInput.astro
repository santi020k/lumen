---
import { Label, PhoneInput, PhoneNumber } from '@santi020k/lumen-astro'
import { getLumenPhoneCountry, resolveLumenPhoneNumber } from '@santi020k/lumen-core'

const colombia = getLumenPhoneCountry('CO', { locale: 'en-US' })

if (!colombia) throw new Error('Missing Colombia phone metadata')

const contact = resolveLumenPhoneNumber(colombia, '+576015550123')
---

<div style="display: grid; gap: 1rem; width: 100%; max-width: 24rem;">
  <div>
    <Label for="ex-phone">Phone number</Label>
    <PhoneInput countryValue="CO" id="ex-phone" name="phone" placeholder="601 5550123" locale="en-US" required />
  </div>
  <div>
    <Label for="ex-phone-sm">Small</Label>
    <PhoneInput countryValue="GB" id="ex-phone-sm" name="phone-sm" placeholder="Mobile number" visualSize="sm" />
  </div>
  <div>
    <Label for="ex-phone-lg">Large</Label>
    <PhoneInput countryValue="ES" id="ex-phone-lg" name="phone-lg" placeholder="Work number" visualSize="lg" value="612345678" />
  </div>
  <div>
    <Label for="ex-phone-disabled">Disabled</Label>
    <PhoneInput countryValue="CO" disabled id="ex-phone-disabled" name="phone-disabled" value="6015550123" />
  </div>
  <div>
    <Label for="ex-phone-readonly">Read only</Label>
    <PhoneInput countryValue="CO" id="ex-phone-readonly" name="phone-readonly" readOnly value="6015550123" />
  </div>
  <div>
    <Label for="ex-phone-error">Field error</Label>
    <PhoneInput countryValue="CO" errorMessage="Check this contact number." id="ex-phone-error" name="phone-error" value="601" />
  </div>
  <PhoneNumber value={contact} link />
</div>

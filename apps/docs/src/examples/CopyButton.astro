---
import { CopyButton, Stack, Typography } from '@santi020k/lumen-astro'
---

<Stack align="start" gap="related">
  <Typography><p id="share-message">Join the Lumen workspace at https://lumen.santi020k.com</p></Typography>
  <CopyButton target="#share-message" recoveryLabel="Select and copy the complete message">
    Copy message
  </CopyButton>
  <CopyButton
    value="https://lumen.santi020k.com"
    variant="default"
    size="sm"
    toast
    recoveryLabel="Select and copy the link"
  >
    Copy link
    <span slot="copied">Link copied</span>
    <span slot="error">Copy failed</span>
  </CopyButton>
</Stack>

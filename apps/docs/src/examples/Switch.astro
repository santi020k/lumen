---
import {
  Label,
  Switch
} from '@santi020k/lumen-astro'
---

<div style="display: grid; gap: 1rem;">
  <Label style="display: flex; align-items: center; gap: 0.5rem;">
    <Switch name="notifications" checked /> Email notifications
  </Label>
  <Label style="display: flex; align-items: center; gap: 0.5rem;">
    <Switch name="digest" /> Weekly digest
  </Label>
  <Label style="display: flex; align-items: center; gap: 0.5rem; color: hsl(var(--ink-muted));">
    <Switch disabled name="beta" /> Beta features (disabled)
  </Label>
</div>

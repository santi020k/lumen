---
import { AnimatedPortrait } from '@santi020k/lumen-astro'

import type { ImageMetadata } from 'astro'

const dummyImage: ImageMetadata = {
  src: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&q=80&w=400&h=400',
  width: 400,
  height: 400,
  format: 'jpg'
}
---

<AnimatedPortrait 
  src={dummyImage} 
  alt="Portrait" 
  showFloatingBadges 
  badgeProps={{
    experience: { label: 'Experience', value: '5+ Years' },
    location: { label: 'Location', text: 'San Francisco, CA' }
  }}
/>

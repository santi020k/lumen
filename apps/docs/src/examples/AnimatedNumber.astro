---
import { AnimatedNumber, Grid, Stat, StatValue } from '@santi020k/lumen-astro'
---

<Grid gap="md" minItemWidth="12rem">
  <Stat label="Active workspaces">
    <StatValue><AnimatedNumber value={1234} /></StatValue>
  </Stat>
  <Stat label="Deploy success">
    <StatValue><AnimatedNumber decimals={1} suffix="%" value={99.8} /></StatValue>
  </Stat>
  <Stat label="Median build">
    <StatValue><AnimatedNumber suffix="s" value={42} /></StatValue>
  </Stat>
</Grid>

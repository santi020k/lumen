---
import { Stack, Typography, VisualEffect } from '@santi020k/lumen-astro'
---

<Stack gap="group">
  <VisualEffect variant="mesh"><Typography>A clearer project workspace</Typography><Typography>Mesh colors follow the active semantic theme.</Typography></VisualEffect>
  <VisualEffect intensity={0.75} variant="border"><Typography>Gradient edges frame a single useful highlight.</Typography></VisualEffect>
  <VisualEffect variant="spotlight"><Typography>Move your pointer to explore the light.</Typography></VisualEffect>
</Stack>

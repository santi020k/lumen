---
import {
  Backdrop,
  Card,
  Grid
} from '@santi020k/lumen-astro'

const variants = ['aurora', 'dots', 'grid', 'rays'] as const
---

<Grid columns="auto" gap="lg" minItemWidth="13rem">
  {variants.map(variant => (
    <Backdrop style="border-radius:0.75rem;min-height:10rem" tone={variant === 'dots' ? 'accent' : 'brand'} variant={variant}>
      <Card style="margin:2rem;padding:1rem" variant="glass">
        <strong>{variant[0]?.toUpperCase()}{variant.slice(1)}</strong>
        <p style="margin:0.25rem 0 0">Readable content stays above the ambient layer.</p>
      </Card>
    </Backdrop>
  ))}
</Grid>

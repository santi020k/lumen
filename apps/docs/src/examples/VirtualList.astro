---
import { VirtualList } from '@santi020k/lumen-astro'

const rows = Array.from({ length: 200 }, (_, index) => `Deployment #${200 - index}`)
---

{/* 200 rows remain mounted; only the fixed-height visible window is displayed. */}
<VirtualList aria-label="Deployments" itemSize={44} style="--ui-list-height: 12rem">
  {rows.map(row => <div>{row}</div>)}
</VirtualList>

---
import { AnimatedPortrait } from '@santi020k/lumen-astro'
import portraitDummy from '../assets/portrait-dummy.jpg'
---

<AnimatedPortrait
  src={portraitDummy}
  alt="Portrait"
  showFloatingBadges
  badgeProps={{
    experience: { label: 'Experience', value: '5+ Years' },
    location: { label: 'Location', text: 'San Francisco, CA' }
  }}
/>

---
import { Histogram } from '@santi020k/lumen-astro'

const bins = [
  { start: 0, end: 100, count: 8 },
  { start: 100, end: 200, count: 24 },
  { start: 200, end: 300, count: 42 },
  { start: 300, end: 400, count: 18 },
  { start: 400, end: 500, count: 5 }
]
---

<Histogram aria-label="Illustrative response time distribution" heading="Response time distribution" caption="Illustrative response times in milliseconds. Bins are calculated by the application." {bins} />

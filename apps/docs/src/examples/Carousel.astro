---
import {
  Button,
  Carousel
} from '@santi020k/lumen-astro'
---

<Carousel aria-label="Featured templates">
  <div data-ui-carousel-viewport>
    <article>Dashboard</article>
    <article>Portfolio</article>
    <article>Storefront</article>
  </div>
  <footer>
    <Button size="sm" variant="outline" data-ui-carousel-prev>Previous</Button>
    <Button size="sm" variant="outline" data-ui-carousel-next>Next</Button>
  </footer>
</Carousel>

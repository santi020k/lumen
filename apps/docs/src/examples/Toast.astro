---
import { Toast } from '@santi020k/lumen-astro'
---

<Toast>
  <strong>Build complete</strong>
  <p>lumen-docs deployed to production.</p>
</Toast>
<Toast variant="success">
  <strong>Saved</strong>
  <p>Your changes are live.</p>
</Toast>
<Toast variant="warning">
  <strong>Slow build</strong>
  <p>Build took longer than 5 minutes.</p>
</Toast>
<Toast variant="destructive">
  <strong>Build failed</strong>
  <p>Type error in Button.astro.</p>
</Toast>

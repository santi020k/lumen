---
import { DatePicker, DateRangePicker } from '@santi020k/lumen-astro'
---

{/* The runtime keeps the range consistent: picking a start date sets the
    minimum of the end input, and vice versa. */}
<DateRangePicker>
  <DatePicker aria-label="Start date" value="2026-07-06" />
  <DatePicker aria-label="End date" value="2026-07-10" />
</DateRangePicker>

---
import {
  Checkbox,
  Label
} from '@santi020k/lumen-astro'
---

<div style="display: grid; gap: 0.5rem;">
  <Label>
    <Checkbox name="updates" /> Email me product updates
  </Label>
  <Label>
    <Checkbox checked name="terms" /> Accept terms (checked)
  </Label>
  <Label>
    <Checkbox id="ex-checkbox-indeterminate" name="permissions" /> Some permissions selected
  </Label>
  <Label>
    <Checkbox disabled name="legacy" /> Legacy option (disabled)
  </Label>
</div>

<script>
  const checkbox = document.querySelector<HTMLInputElement>('#ex-checkbox-indeterminate')

  if (checkbox) {
    checkbox.indeterminate = true
  }
</script>

---
import {
  Button,
  Field,
  Input,
  Label,
  Popover,
  PopoverPanel,
  PopoverTrigger
} from '@santi020k/lumen-astro'
---

<Popover>
  <PopoverTrigger>Invite teammates</PopoverTrigger>
  <PopoverPanel style="display: grid; gap: 0.75rem;">
    <Field>
      <Label for="ex-invite">Email address</Label>
      <Input id="ex-invite" type="email" placeholder="teammate@example.com" />
    </Field>
    <Button size="sm">Send invite</Button>
  </PopoverPanel>
</Popover>

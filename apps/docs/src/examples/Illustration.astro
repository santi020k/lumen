---
import {
  Card,
  Grid,
  Illustration
} from '@santi020k/lumen-astro'

const variants = ['empty', 'success', 'error', 'offline'] as const
---

<Grid columns="auto" gap="lg" minItemWidth="10rem">
  {variants.map(variant => (
    <Card style="display:grid;gap:0.5rem;justify-items:center;padding:1rem" variant="muted">
      <Illustration size="sm" variant={variant} />
      <strong>{variant[0]?.toUpperCase()}{variant.slice(1)}</strong>
    </Card>
  ))}
</Grid>

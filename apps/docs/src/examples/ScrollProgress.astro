---
import { ScrollProgress } from '@santi020k/lumen-astro'
---

<div style="position: relative; min-height: 6rem; overflow: hidden; border: 1px solid hsl(var(--line)); border-radius: 0.75rem;">
  <ScrollProgress
    aria-label="Example reading progress"
    style="position: absolute;"
  />
  <p style="padding: 1.25rem; color: hsl(var(--ink-soft)); font-size: 0.875rem;">
    The fixed component tracks the full document in production. This preview keeps its visual
    treatment inside the example frame.
  </p>
</div>

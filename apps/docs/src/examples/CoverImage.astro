---
import { CoverImage, Grid } from '@santi020k/lumen-astro'

import dummyImage from '../assets/cover-dummy.jpg'
---

<Grid gap="md" minItemWidth="14rem">
  <CoverImage
    alt="Cover image"
    image={dummyImage}
    sizes="(min-width: 1024px) 400px, 100vw"
  />
  <CoverImage
    alt="Cover image with hover lift"
    hover
    image={dummyImage}
    sizes="(min-width: 1024px) 400px, 100vw"
  />
  <CoverImage
    alt="Cover image with bottom gradient"
    image={dummyImage}
    showBottomGradient
    sizes="(min-width: 1024px) 400px, 100vw"
  />
</Grid>

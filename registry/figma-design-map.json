{
  "$schema": "https://santi020k.dev/lumen/figma-design-map.schema.json",
  "name": "lumen-figma-design-map",
  "version": 1,
  "description": "Machine-readable mapping for translating Figma design output into Lumen components and tokens.",
  "documentation": "docs/figma-design-to-code.md",
  "tokenMap": {
    "color/canvas": { "token": "canvas", "cssVariable": "--canvas", "role": "Page background" },
    "color/surface": { "token": "surface", "cssVariable": "--surface", "role": "Component background" },
    "color/surface-muted": { "token": "surface-muted", "cssVariable": "--surface-muted", "role": "Subtle component background" },
    "color/surface-strong": { "token": "surface-strong", "cssVariable": "--surface-strong", "role": "Raised component background" },
    "color/ink": { "token": "ink", "cssVariable": "--ink", "role": "Primary text" },
    "color/ink-muted": { "token": "ink-muted", "cssVariable": "--ink-muted", "role": "Secondary text" },
    "color/ink-soft": { "token": "ink-soft", "cssVariable": "--ink-soft", "role": "Tertiary text" },
    "color/line": { "token": "line", "cssVariable": "--line", "role": "Borders and dividers" },
    "color/brand": { "token": "brand", "cssVariable": "--brand", "role": "Primary brand color" },
    "color/brand-solid": { "token": "brand-solid", "cssVariable": "--brand-solid", "role": "High-emphasis brand fill" },
    "color/brand-soft": { "token": "brand-soft", "cssVariable": "--brand-soft", "role": "Brand tint" },
    "color/accent": { "token": "accent", "cssVariable": "--accent", "role": "Secondary emphasis" },
    "color/danger": { "token": "danger", "cssVariable": "--danger", "role": "Destructive or error" },
    "color/success": { "token": "success", "cssVariable": "--success", "role": "Positive or complete" },
    "color/warning": { "token": "warning", "cssVariable": "--warning", "role": "Caution" },
    "color/glass/bg": { "token": "glass-bg", "cssVariable": "--glass-bg", "role": "Default translucent glass surface background." },
    "color/glass/bg-subtle": { "token": "glass-bg-subtle", "cssVariable": "--glass-bg-subtle", "role": "Lower-emphasis translucent glass surface background." },
    "color/glass/bg-strong": { "token": "glass-bg-strong", "cssVariable": "--glass-bg-strong", "role": "Higher-emphasis translucent glass surface background." },
    "color/glass/border": { "token": "glass-border", "cssVariable": "--glass-border", "role": "Border color for glass surfaces." },
    "color/glass/highlight": { "token": "glass-highlight", "cssVariable": "--glass-highlight", "role": "Inner highlight used along glass surface edges." },
    "color/glass/edge": { "token": "glass-edge", "cssVariable": "--glass-edge", "role": "Strong refractive edge highlight for glass surfaces." },
    "color/glass/edge-soft": { "token": "glass-edge-soft", "cssVariable": "--glass-edge-soft", "role": "Soft refractive edge highlight for glass surfaces." },
    "color/glass/shade": { "token": "glass-shade", "cssVariable": "--glass-shade", "role": "Low-opacity shade that gives glass surfaces depth." },
    "color/glass/refraction": { "token": "glass-refraction", "cssVariable": "--glass-refraction", "role": "Brand-tinted refraction color for glass surfaces." },
    "color/on-danger": { "token": "on-danger", "cssVariable": "--on-danger", "role": "Foreground paired with the current theme\u2019s destructive fill." },
    "color/chart/series-1": { "token": "chart-series-1", "cssVariable": "--chart-series-1", "role": "Categorical data visualization color 1." },
    "color/chart/series-2": { "token": "chart-series-2", "cssVariable": "--chart-series-2", "role": "Categorical data visualization color 2." },
    "color/chart/series-3": { "token": "chart-series-3", "cssVariable": "--chart-series-3", "role": "Categorical data visualization color 3." },
    "color/chart/series-4": { "token": "chart-series-4", "cssVariable": "--chart-series-4", "role": "Categorical data visualization color 4." },
    "color/chart/series-5": { "token": "chart-series-5", "cssVariable": "--chart-series-5", "role": "Categorical data visualization color 5." },
    "color/chart/series-6": { "token": "chart-series-6", "cssVariable": "--chart-series-6", "role": "Categorical data visualization color 6." },
    "color/chart/series-7": { "token": "chart-series-7", "cssVariable": "--chart-series-7", "role": "Categorical data visualization color 7." },
    "color/chart/series-8": { "token": "chart-series-8", "cssVariable": "--chart-series-8", "role": "Categorical data visualization color 8." },
    "color/chart/diverging-mid": { "token": "chart-diverging-mid", "cssVariable": "--chart-diverging-mid", "role": "Midpoint color for diverging data scales." },
    "color/chart/diverging-negative": { "token": "chart-diverging-negative", "cssVariable": "--chart-diverging-negative", "role": "Negative direction color for diverging data scales." },
    "color/chart/diverging-positive": { "token": "chart-diverging-positive", "cssVariable": "--chart-diverging-positive", "role": "Positive direction color for diverging data scales." },
    "color/chart/sequential-high": { "token": "chart-sequential-high", "cssVariable": "--chart-sequential-high", "role": "High endpoint for sequential data scales." },
    "color/chart/sequential-low": { "token": "chart-sequential-low", "cssVariable": "--chart-sequential-low", "role": "Low endpoint for sequential data scales." },
    "color/chart/sequential-mid": { "token": "chart-sequential-mid", "cssVariable": "--chart-sequential-mid", "role": "Midpoint for sequential data scales." },
    "color/chart/axis": { "token": "chart-axis", "cssVariable": "--chart-axis", "role": "Axis labels and tick values for data visualizations." },
    "color/chart/grid": { "token": "chart-grid", "cssVariable": "--chart-grid", "role": "Grid lines for data visualizations." },
    "color/chart/reference": { "token": "chart-reference", "cssVariable": "--chart-reference", "role": "Chart reference line." },
    "color/chart/selection": { "token": "chart-selection", "cssVariable": "--chart-selection", "role": "Selected data marks." },
    "color/chart/tooltip-background": { "token": "chart-tooltip-background", "cssVariable": "--chart-tooltip-background", "role": "Chart tooltip surface." },
    "color/chart/tooltip-foreground": { "token": "chart-tooltip-foreground", "cssVariable": "--chart-tooltip-foreground", "role": "Chart tooltip label." },
    "color/on-brand": { "token": "on-brand", "cssVariable": "--on-brand", "role": "Foreground paired with the semantic brand fill." }
  },
  "componentPaints": {
    "color/on-solid": "Legacy white foreground. Use the component’s current on-brand or on-danger role for new designs.",
    "color/shadow/sm": "Small elevation shadow color.",
    "color/shadow/md": "Medium elevation shadow color.",
    "color/shadow/lg": "Large elevation shadow color.",
    "color/shadow/specimen": "Soft documentation specimen shadow derived from ink.",
    "color/shadow/specimen-strong": "Stronger documentation specimen shadow derived from ink.",
    "color/shadow/glass-mid": "Mid-layer shadow color for glass elevation.",
    "color/shadow/button": "Legacy tinted shadow. Current buttons use color/shadow/primary.",
    "color/button/outline-bg": "Translucent surface background for outline buttons. hsl(var(--surface) / 0.76).",
    "color/badge/destructive-bg": "Low-opacity danger background for destructive badges. hsl(var(--danger) / 0.1).",
    "color/badge/destructive-border": "Danger border for destructive badges. hsl(var(--danger) / 0.32).",
    "color/badge/success-bg": "Low-opacity success background for success badges. hsl(var(--success) / 0.1).",
    "color/badge/success-border": "Success border for success badges. hsl(var(--success) / 0.32).",
    "color/badge/warning-bg": "Low-opacity warning background for warning badges. hsl(var(--warning) / 0.12).",
    "color/badge/warning-border": "Warning border for warning badges. hsl(var(--warning) / 0.36).",
    "color/alert/destructive-bg": "Low-opacity danger background for destructive alerts. hsl(var(--danger) / 0.08).",
    "color/alert/destructive-border": "Danger border for destructive alerts. hsl(var(--danger) / 0.36).",
    "color/alert/success-bg": "Low-opacity success background for success alerts. hsl(var(--success) / 0.08).",
    "color/alert/success-border": "Success border for success alerts. hsl(var(--success) / 0.36).",
    "color/alert/warning-bg": "Low-opacity warning background for warning alerts. hsl(var(--warning) / 0.1).",
    "color/alert/warning-border": "Warning border for warning alerts. hsl(var(--warning) / 0.42).",
    "color/button/primary-bg": "Primary actions use brand-solid, or ink in the santi020k appearance.",
    "color/button/primary-label": "Primary action labels use on-brand, or surface in the santi020k appearance.",
    "color/button/secondary-bg": "Secondary action fills use surface-muted, or surface in the santi020k appearance.",
    "color/button/secondary-stroke": "The secondary button uses line, with 65% opacity in the santi020k appearance.",
    "color/card/stroke": "The standard Card uses line, with 65% opacity in the santi020k appearance.",
    "color/badge/success-label": "Text on a soft success badge mixes 65% success with 35% ink.",
    "color/shadow/glass-front": "CSS glass-front shadow color.",
    "color/shadow/glass-middle": "CSS glass-middle shadow color.",
    "color/shadow/glass-back": "CSS glass-back shadow color.",
    "color/shadow/card": "CSS card shadow color.",
    "color/shadow/primary": "CSS primary shadow color."
  },
  "componentHints": [
    { "pattern": "clickable filled or outlined rectangle with label", "components": ["Button"] },
    { "pattern": "row of related buttons", "components": ["ButtonGroup", "ToggleGroup"] },
    { "pattern": "bordered or elevated content container", "components": ["Card", "CardHeader", "CardTitle", "CardDescription", "CardContent", "CardFooter"] },
    { "pattern": "single-line text input", "components": ["Input", "Field", "Label"] },
    { "pattern": "password input with reveal control and validation feedback", "components": ["PasswordField", "FieldError"] },
    { "pattern": "form-level validation summary or submission state", "components": ["Form", "ErrorSummary"] },
    { "pattern": "input with icon or addon", "components": ["InputGroup", "Icon"] },
    { "pattern": "multi-line text input", "components": ["Textarea"] },
    { "pattern": "dropdown with fixed options", "components": ["Select", "NativeSelect"] },
    { "pattern": "dropdown with text filtering", "components": ["Combobox", "Autocomplete"] },
    { "pattern": "search input", "components": ["SearchField", "Command"] },
    { "pattern": "small status pill", "components": ["Badge"] },
    { "pattern": "standalone pictogram or interface icon", "components": ["Icon"] },
    { "pattern": "user photo or initials circle", "components": ["Avatar"] },
    { "pattern": "divider line", "components": ["Separator"] },
    { "pattern": "centered modal overlay", "components": ["Dialog", "AlertDialog"] },
    { "pattern": "edge-anchored overlay panel", "components": ["Sheet", "Drawer"] },
    { "pattern": "floating panel anchored to trigger", "components": ["Popover", "HoverCard", "Tooltip"] },
    { "pattern": "contextual action menu", "components": ["DropdownMenu", "ContextMenu", "Menubar"] },
    { "pattern": "section switcher row", "components": ["Tabs"] },
    { "pattern": "expandable sections", "components": ["Accordion", "Collapsible"] },
    { "pattern": "on/off toggle", "components": ["Switch", "Toggle"] },
    { "pattern": "checkbox rows", "components": ["Checkbox", "CheckboxGroup"] },
    { "pattern": "radio option rows", "components": ["RadioGroup"] },
    { "pattern": "value slider", "components": ["Slider"] },
    { "pattern": "data grid", "components": ["Table", "DataTable", "TreeGrid"] },
    { "pattern": "hierarchical list", "components": ["Tree"] },
    { "pattern": "long scrolling list", "components": ["VirtualList", "ScrollArea"] },
    { "pattern": "keyboard-selectable option list", "components": ["ListBox"] },
    { "pattern": "page navigation numbers", "components": ["Pagination"] },
    { "pattern": "breadcrumb trail", "components": ["Breadcrumb"] },
    { "pattern": "left navigation column", "components": ["Sidebar", "NavigationMenu"] },
    { "pattern": "contextual product or platform subnavigation", "components": ["ContextNavigation", "NavigationMenu", "NativeSelect"] },
    { "pattern": "progress bar", "components": ["Progress"] },
    { "pattern": "loading placeholder blocks", "components": ["Skeleton", "Spinner"] },
    { "pattern": "inline notification banner", "components": ["Alert"] },
    { "pattern": "transient corner notification", "components": ["Toast", "ToastViewport"] },
    { "pattern": "date picking interface", "components": ["DatePicker", "DateRangePicker", "Calendar"] },
    { "pattern": "time input", "components": ["TimeField"] },
    { "pattern": "numeric stepper input", "components": ["NumberField"] },
    { "pattern": "one-time code input boxes", "components": ["InputOTP"] },
    { "pattern": "color swatch picker", "components": ["ColorPicker"] },
    { "pattern": "tag chips group", "components": ["TagGroup"] },
    { "pattern": "keyboard shortcut hint", "components": ["Kbd"] },
    { "pattern": "code block or inline code", "components": ["Code"] },
    { "pattern": "tabbed package-manager, language, or configuration code examples", "components": ["CodeTabs", "Code"] },
    { "pattern": "chart or graph", "components": ["Chart", "BarChart", "LineChart", "PieChart", "ScatterChart", "Heatmap", "RangeChart", "ComboChart", "Sparkline"] },
    { "pattern": "image with fixed proportions", "components": ["AspectRatio"] },
    { "pattern": "carousel of slides", "components": ["Carousel"] },
    { "pattern": "resizable split panes", "components": ["Resizable"] },
    { "pattern": "chat message bubbles", "components": ["Bubble", "Message", "MessageScroller"] },
    { "pattern": "calendar schedule grid", "components": ["Schedule", "Agenda"] },
    { "pattern": "rich text editing surface", "components": ["RichTextEditor"] },
    { "pattern": "file attachment row", "components": ["Attachment"] },
    { "pattern": "empty-state block", "components": ["Empty"] },
    { "pattern": "text content with styles", "components": ["Typography"] },
    { "pattern": "element pinned to a viewport or container edge", "components": ["Affix"] },
    { "pattern": "in-page section navigation links", "components": ["Anchor"] },
    { "pattern": "floating control that returns to the page start", "components": ["BackToTop"] },
    { "pattern": "animated product mark or brand lockup", "components": ["AnimatedLogo"] },
    { "pattern": "animated profile or hero portrait", "components": ["AnimatedPortrait"] },
    { "pattern": "ambient particle background decoration", "components": ["Particles"] },
    { "pattern": "content revealed as it enters the viewport", "components": ["ScrollReveal"] },
    { "pattern": "button-styled navigation link", "components": ["ButtonLink"] },
    { "pattern": "inline text navigation link", "components": ["Link"] },
    { "pattern": "prominent contextual information panel", "components": ["Callout"] },
    { "pattern": "compact editorial annotation", "components": ["Note"] },
    { "pattern": "hierarchical multi-level option picker", "components": ["Cascader", "TreeSelect"] },
    { "pattern": "hero or card cover artwork", "components": ["CoverImage"] },
    { "pattern": "responsive content image", "components": ["Image"] },
    { "pattern": "label and value description list", "components": ["Descriptions"] },
    { "pattern": "composable list or menu row", "components": ["Item"] },
    { "pattern": "right-to-left or left-to-right layout context", "components": ["Direction"] },
    { "pattern": "small uppercase section preheading", "components": ["Eyebrow"] },
    { "pattern": "drag-and-drop or browse file input", "components": ["FileUpload"] },
    { "pattern": "badge floating over another object", "components": ["FloatingBadge"] },
    { "pattern": "compact rounded metadata label", "components": ["Pill"] },
    { "pattern": "localized human-readable date text", "components": ["FormattedDate"] },
    { "pattern": "decorative gradient divider", "components": ["GradientDivider"] },
    { "pattern": "language or locale switch control", "components": ["LanguageToggle"] },
    { "pattern": "light and dark appearance switch control", "components": ["ThemeToggle"] },
    { "pattern": "interactive semantic theme editor", "components": ["ThemeBuilder"] },
    { "pattern": "map point or location marker", "components": ["Marker"] },
    { "pattern": "text input with mention suggestions", "components": ["Mentions"] },
    { "pattern": "bounded value meter", "components": ["Meter"] },
    { "pattern": "star or score rating input", "components": ["Rating"] },
    { "pattern": "headline metric with supporting context", "components": ["Stat", "StatLabel", "StatValue", "StatDescription", "StatIcon", "StatTrend"] },
    { "pattern": "international telephone number input", "components": ["PhoneInput"] },
    { "pattern": "confirmation prompt anchored to an action", "components": ["Popconfirm"] },
    { "pattern": "long-form rendered article content", "components": ["Prose"] },
    { "pattern": "scannable QR code", "components": ["QRCode"] },
    { "pattern": "compact mutually exclusive segment control", "components": ["Segmented"] },
    { "pattern": "keyboard-accessible skip navigation link", "components": ["SkipLink"] },
    { "pattern": "expanding floating action menu", "components": ["SpeedDial"] },
    { "pattern": "ordered multi-step progress flow", "components": ["Stepper"] },
    { "pattern": "chronological event sequence", "components": ["Timeline"] },
    { "pattern": "horizontal or vertical action toolbar", "components": ["Toolbar"] },
    { "pattern": "guided product walkthrough", "components": ["Tour"] },
    { "pattern": "move selected items between two lists", "components": ["Transfer"] },
    { "pattern": "responsive centered page-width constraint", "components": ["Container"] },
    { "pattern": "one-dimensional spacing and alignment layout", "components": ["Stack"] },
    { "pattern": "responsive multi-column layout", "components": ["Grid"] },
    { "pattern": "assistive-technology text hidden from visual layout", "components": ["VisuallyHidden"] },
    { "pattern": "content ownership or preview watermark", "components": ["Watermark"] }
  ],
  "rules": [
    "Map colors to semantic tokens; never hard-code hex values from Figma output.",
    "Reproduce auto-layout with flex/grid; never use absolute positioning from Figma coordinates.",
    "Do not re-implement hover, focus, or disabled states that Lumen components already provide.",
    "Prefer Lumen component spacing and radius over pixel values measured in Figma.",
    "Treat fixed frame sizes as design-canvas artifacts; implement responsive behavior by default."
  ]
}

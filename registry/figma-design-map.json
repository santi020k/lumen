{
  "$schema": "https://santi020k.dev/lumen/figma-design-map.schema.json",
  "name": "lumen-figma-design-map",
  "version": 1,
  "description": "Machine-readable mapping for translating Figma design output into Lumen components and tokens.",
  "documentation": "docs/figma-design-to-code.md",
  "tokenMap": {
    "color/canvas": { "token": "canvas", "cssVariable": "--canvas", "role": "Page background" },
    "color/surface": { "token": "surface", "cssVariable": "--surface", "role": "Component background" },
    "color/surface-muted": { "token": "surface-muted", "cssVariable": "--surface-muted", "role": "Subtle component background" },
    "color/surface-strong": { "token": "surface-strong", "cssVariable": "--surface-strong", "role": "Raised component background" },
    "color/ink": { "token": "ink", "cssVariable": "--ink", "role": "Primary text" },
    "color/ink-muted": { "token": "ink-muted", "cssVariable": "--ink-muted", "role": "Secondary text" },
    "color/ink-soft": { "token": "ink-soft", "cssVariable": "--ink-soft", "role": "Tertiary text" },
    "color/line": { "token": "line", "cssVariable": "--line", "role": "Borders and dividers" },
    "color/brand": { "token": "brand", "cssVariable": "--brand", "role": "Primary brand color" },
    "color/brand-solid": { "token": "brand-solid", "cssVariable": "--brand-solid", "role": "High-emphasis brand fill" },
    "color/brand-soft": { "token": "brand-soft", "cssVariable": "--brand-soft", "role": "Brand tint" },
    "color/accent": { "token": "accent", "cssVariable": "--accent", "role": "Secondary emphasis" },
    "color/danger": { "token": "danger", "cssVariable": "--danger", "role": "Destructive or error" },
    "color/success": { "token": "success", "cssVariable": "--success", "role": "Positive or complete" },
    "color/warning": { "token": "warning", "cssVariable": "--warning", "role": "Caution" }
  },
  "componentHints": [
    { "pattern": "clickable filled or outlined rectangle with label", "components": ["Button"] },
    { "pattern": "row of related buttons", "components": ["ButtonGroup", "ToggleGroup"] },
    { "pattern": "bordered or elevated content container", "components": ["Card"] },
    { "pattern": "single-line text input", "components": ["Input", "Field", "Label"] },
    { "pattern": "input with icon or addon", "components": ["InputGroup"] },
    { "pattern": "multi-line text input", "components": ["Textarea"] },
    { "pattern": "dropdown with fixed options", "components": ["Select", "NativeSelect"] },
    { "pattern": "dropdown with text filtering", "components": ["Combobox", "Autocomplete"] },
    { "pattern": "search input", "components": ["SearchField", "Command"] },
    { "pattern": "small status pill", "components": ["Badge"] },
    { "pattern": "user photo or initials circle", "components": ["Avatar"] },
    { "pattern": "divider line", "components": ["Separator"] },
    { "pattern": "centered modal overlay", "components": ["Dialog", "AlertDialog"] },
    { "pattern": "edge-anchored overlay panel", "components": ["Sheet", "Drawer"] },
    { "pattern": "floating panel anchored to trigger", "components": ["Popover", "HoverCard", "Tooltip"] },
    { "pattern": "contextual action menu", "components": ["DropdownMenu", "ContextMenu", "Menubar"] },
    { "pattern": "section switcher row", "components": ["Tabs"] },
    { "pattern": "expandable sections", "components": ["Accordion", "Collapsible"] },
    { "pattern": "on/off toggle", "components": ["Switch", "Toggle"] },
    { "pattern": "checkbox rows", "components": ["Checkbox"] },
    { "pattern": "radio option rows", "components": ["RadioGroup"] },
    { "pattern": "value slider", "components": ["Slider"] },
    { "pattern": "data grid", "components": ["Table", "DataTable", "TreeGrid"] },
    { "pattern": "hierarchical list", "components": ["Tree"] },
    { "pattern": "long scrolling list", "components": ["VirtualList", "ScrollArea"] },
    { "pattern": "page navigation numbers", "components": ["Pagination"] },
    { "pattern": "breadcrumb trail", "components": ["Breadcrumb"] },
    { "pattern": "left navigation column", "components": ["Sidebar", "NavigationMenu"] },
    { "pattern": "progress bar", "components": ["Progress"] },
    { "pattern": "loading placeholder blocks", "components": ["Skeleton", "Spinner"] },
    { "pattern": "inline notification banner", "components": ["Alert"] },
    { "pattern": "transient corner notification", "components": ["Toast", "Sonner"] },
    { "pattern": "date picking interface", "components": ["DatePicker", "DateRangePicker", "Calendar"] },
    { "pattern": "time input", "components": ["TimeField"] },
    { "pattern": "numeric stepper input", "components": ["NumberField"] },
    { "pattern": "one-time code input boxes", "components": ["InputOTP"] },
    { "pattern": "color swatch picker", "components": ["ColorPicker"] },
    { "pattern": "tag chips group", "components": ["TagGroup"] },
    { "pattern": "keyboard shortcut hint", "components": ["Kbd"] },
    { "pattern": "code block or inline code", "components": ["Code"] },
    { "pattern": "chart or graph", "components": ["Chart"] },
    { "pattern": "image with fixed proportions", "components": ["AspectRatio"] },
    { "pattern": "carousel of slides", "components": ["Carousel"] },
    { "pattern": "resizable split panes", "components": ["Resizable"] },
    { "pattern": "chat message bubbles", "components": ["Bubble", "Message", "MessageScroller"] },
    { "pattern": "calendar schedule grid", "components": ["Schedule", "Agenda"] },
    { "pattern": "rich text editing surface", "components": ["RichTextEditor"] },
    { "pattern": "file attachment row", "components": ["Attachment"] },
    { "pattern": "empty-state block", "components": ["Empty"] },
    { "pattern": "text content with styles", "components": ["Typography"] }
  ],
  "rules": [
    "Map colors to semantic tokens; never hard-code hex values from Figma output.",
    "Reproduce auto-layout with flex/grid; never use absolute positioning from Figma coordinates.",
    "Do not re-implement hover, focus, or disabled states that Lumen components already provide.",
    "Prefer Lumen component spacing and radius over pixel values measured in Figma.",
    "Treat fixed frame sizes as design-canvas artifacts; implement responsive behavior by default."
  ]
}

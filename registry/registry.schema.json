{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/santi020k/lumen/main/registry/registry.schema.json",
  "title": "Lumen registry manifest",
  "description": "Manifest describing Lumen components, recipes, and documentation installable with `lumen add`.",
  "type": "object",
  "required": ["name", "version", "description", "packages", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/component"
      }
    }
  },
  "definitions": {
    "file": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": ["path", "source"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string"
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["component-set", "documentation", "recipe"]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/file"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["name", "type", "description", "category", "files"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "component"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "$ref": "#/definitions/componentContract"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/file"
          }
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "componentContract": {
      "type": "object",
      "required": ["imports", "usage"],
      "additionalProperties": false,
      "properties": {
        "imports": { "type": "object", "additionalProperties": { "type": "string" } },
        "usage": { "type": "object", "additionalProperties": { "type": "string" } },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "default": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        },
        "composition": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "string" } },
        "runtime": { "type": "string" },
        "slots": { "type": "array", "items": { "type": "string" } },
        "stylingParts": { "type": "array", "items": { "type": "string" } },
        "tokens": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

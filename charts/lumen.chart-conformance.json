        { "x": "Mon", "y": 4 },
        { "x": "Tue", "y": null },
        { "x": "Wed", "y": 8 }
      ],
      "expected": {
        "domain": { "min": 4, "max": 8 },
        "pointCount": 2,
        "segmentCount": 2
      }
    },
    "linear": {
      "data": [

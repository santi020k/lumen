{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.santi020k.com/schemas/lumen.graphics.schema.json",
  "title": "Lumen graphics catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "illustrations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "illustrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "semanticTone", "elements"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "semanticTone": {
            "enum": ["accent", "brand", "danger", "ink-muted", "success"]
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "cx", "cy", "r"],
                  "properties": {
                    "kind": { "const": "circle" },
                    "cx": { "type": "number" },
                    "cy": { "type": "number" },
                    "r": { "type": "number", "exclusiveMinimum": 0 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "points"],
                  "properties": {
                    "kind": { "enum": ["line", "polygon", "polyline"] },
                    "points": {
                      "type": "array",
                      "minItems": 4,
                      "items": { "type": "number" }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "x", "y", "width", "height", "radius"],
                  "properties": {
                    "kind": { "const": "rounded-rect" },
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "width": { "type": "number", "exclusiveMinimum": 0 },
                    "height": { "type": "number", "exclusiveMinimum": 0 },
                    "radius": { "type": "number", "minimum": 0 }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}

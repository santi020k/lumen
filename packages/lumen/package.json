{
  "name": "@santi020k/lumen",
  "version": "5.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Umbrella package for the Lumen multi-framework primitive UI system.",
  "type": "module",
  "sideEffects": [
    "./layers.css",
    "./styles.css",
    "./styles/critical.css",
    "./styles/motion.css",
    "./styles/world-map.css",
    "./tailwind.css",
    "./styles/**/*.css",
    "./mascot/lu.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./cli": "./dist/cli.js",
    "./release-manifest.json": "./release-manifest.json",
    "./styles.css": "./styles.css",
    "./styles/critical.css": "./styles/critical.css",
    "./layers.css": "./layers.css",
    "./package.json": "./package.json",
    "./styles/motion.css": "./styles/motion.css",
    "./styles/world-map.css": "./styles/world-map.css",
    "./tailwind.css": "./tailwind.css",
    "./styles/foundation.css": "./styles/foundation.css",
    "./styles/themes/studio.css": "./styles/themes/studio.css",
    "./styles/themes/paper.css": "./styles/themes/paper.css",
    "./styles/themes/field.css": "./styles/themes/field.css",
    "./styles/themes/santi020k.css": "./styles/themes/santi020k.css",
    "./styles/effects/glass.css": "./styles/effects/glass.css",
    "./styles/components/*.css": "./styles/components/*.css",
    "./vite/build-report": {
      "types": "./dist/build-report-plugin.d.ts",
      "import": "./dist/build-report-plugin.js"
    },
    "./lu": {
      "types": "./dist/lu.d.ts",
      "import": "./dist/lu.js"
    },
    "./lu/styles.css": "./mascot/lu.css",
    "./lu/sprites.webp": "./mascot/lu-sprites.webp",
    "./lu/still.webp": "./mascot/lu-still.webp",
    "./lu/manifest.json": "./dist/lu-manifest.json"
  },
  "files": [
    "bin",
    "dist",
    "layers.css",
    "native-components.json",
    "release-manifest.json",
    "styles.css",
    "styles",
    "templates",
    "README.md",
    "LICENSE",
    "v4-migration.json",
    "tailwind.css",
    "v5-migration.json",
    "mascot"
  ],
  "bin": {
    "lumen": "./bin/lumen.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project lumen",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project lumen --coverage",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@santi020k/lumen-core": "workspace:^",
    "semver": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@santi020k/lumen-elements": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/semver": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "astro": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "tailwindcss": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/santi020k/lumen.git",
    "directory": "packages/lumen"
  },
  "homepage": "https://lumen.santi020k.com/docs",
  "bugs": {
    "url": "https://github.com/santi020k/lumen/issues"
  },
  "keywords": [
    "accessible-ui",
    "component-library",
    "cross-platform",
    "design-system",
    "lumen",
    "ui"
  ],
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "license": "MIT"
}

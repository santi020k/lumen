{
  "name": "@santi020k/lumen",
  "version": "0.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Umbrella package for the Lumen multi-framework primitive UI system.",
  "type": "module",
  "sideEffects": ["./styles.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": ["bin", "dist", "styles.css", "README.md", "LICENSE"],
  "bin": {
    "lumen": "./bin/lumen.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project lumen",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project lumen --coverage",
    "lint": "eslint . --no-warn-ignored",
    "lint:fix": "eslint . --fix --no-warn-ignored",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@santi020k/lumen-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/santi020k/lumen.git",
    "directory": "packages/lumen"
  },
  "homepage": "https://lumen.santi020k.com",
  "bugs": {
    "url": "https://github.com/santi020k/lumen/issues"
  },
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "license": "MIT"
}

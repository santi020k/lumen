---
import { Callout, Icon, Link, Typography } from '@santi020k/lumen-astro'

interface Props {
  currentLabel: string
  destinationLabel: string
  href: string
  linkLabel: string
  newTab?: boolean
  replacementDetail?: string
  replacementLabel: string
  title: string
}

const { currentLabel, destinationLabel, href, linkLabel, newTab = false, replacementDetail, replacementLabel, title } = Astro.props
---

<Callout aria-label={title} class="editorial-replacement">
  <div class="editorial-replacement__spread">
    <Typography class="editorial-replacement__context">
      <p class="editorial-replacement__title">{title}</p>
      <p class="editorial-replacement__current">{currentLabel}</p>
    </Typography>
    <Link class="editorial-replacement__destination" href={href} {newTab} variant="inherit">
      <span class="editorial-replacement__label">{destinationLabel}</span>
      <span class="editorial-replacement__name">
        {replacementDetail && <span class="editorial-replacement__detail">{replacementDetail}</span>}
        {replacementLabel}
      </span>
      <span class="editorial-replacement__action">
        <span>{linkLabel}</span><span class="editorial-replacement__arrow"><Icon name={newTab ? 'arrow-up-right' : 'arrow-right'} /></span>
      </span>
    </Link>
  </div>
  {Astro.slots.has('default') && (
<Typography class="editorial-replacement__description"><slot /></Typography>
)}
</Callout>

<style>
  .editorial-replacement {
    container: editorial-replacement / inline-size;
    display: block;
    margin: 0;
    padding: 1.5rem 0;
    border: 0;
    border-block: 1px solid hsl(var(--line));
    border-radius: 0;
    background: transparent;
    color: hsl(var(--ink));
    box-shadow: none;
  }

  .editorial-replacement__spread {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: 1.75rem;
  }

  .editorial-replacement__spread :global(.editorial-replacement__context) {
    min-width: 0;
  }

  .editorial-replacement__title {
    margin: 0 0 1.125rem;
    color: hsl(var(--ink));
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .editorial-replacement__current {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .editorial-replacement__spread :global(.editorial-replacement__destination) {
    display: block;
    min-width: 0;
    padding: 1.5rem;
    border-radius: 0.25rem 1.75rem 1.75rem 1.75rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--ink));
    text-decoration: none;
  }

  .editorial-replacement__label, .editorial-replacement__action {
    color: hsl(var(--brand));
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .editorial-replacement__name {
    display: block;
    margin-block: 1.125rem 1.375rem;
    color: hsl(var(--ink));
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  .editorial-replacement__detail {
    display: block;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.8;
    letter-spacing: 0;
  }

  .editorial-replacement__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    overflow-wrap: anywhere;
  }

  .editorial-replacement__arrow {
    display: grid;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 50%;
    background: hsl(var(--surface));
  }

  .editorial-replacement__spread :global(.editorial-replacement__destination:is(:hover, :focus-visible)) .editorial-replacement__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3125rem;
  }

  .editorial-replacement__spread :global(.editorial-replacement__destination:focus-visible) {
    outline: 2px solid hsl(var(--brand));
    outline-offset: 4px;
  }

  .editorial-replacement :global(.editorial-replacement__description) {
    margin-block-start: 1.5rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9375rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .editorial-replacement :global(.editorial-replacement__description p) {
    margin: 0;
    color: inherit;
    font: inherit;
  }

  @container editorial-replacement (width < 35rem) {
    .editorial-replacement__spread {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.375rem;
    }
    .editorial-replacement__title {
      margin-block-end: 0.75rem;
    }
    .editorial-replacement__name {
      margin-block: 1rem 1.25rem;
    }
  }

  @container editorial-replacement (width < 26rem) {
    .editorial-replacement__spread :global(.editorial-replacement__destination) {
      padding: 1.25rem;
    }
    .editorial-replacement__name {
      font-size: 1.5625rem;
    }
    .editorial-replacement__action {
      flex-wrap: wrap;
    }
  }
</style>

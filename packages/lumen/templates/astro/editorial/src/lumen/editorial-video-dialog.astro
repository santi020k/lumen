---
import Button from '@santi020k/lumen-astro/components/Button'
import ButtonLink from '@santi020k/lumen-astro/components/ButtonLink'
import Collapsible from '@santi020k/lumen-astro/components/Collapsible'
import Dialog from '@santi020k/lumen-astro/components/Dialog'
import DialogBody from '@santi020k/lumen-astro/components/DialogBody'
import DialogTitle from '@santi020k/lumen-astro/components/DialogTitle'
import Icon from '@santi020k/lumen-astro/components/Icon'
import Link from '@santi020k/lumen-astro/components/Link'

interface Props {
  id: string
  title: string
  src: string
  poster?: string
  playLabel: string
  closeLabel: string
  fileLabel: string
  errorLabel: string
  transcriptLabel: string
  loadingLabel?: string
  retryLabel?: string
  captions?: readonly {
    src: string
    language: string
    label: string
    default?: boolean
  }[]
}

const { id, title, src, poster, playLabel, closeLabel, fileLabel, errorLabel, transcriptLabel, loadingLabel = 'Loading video…', retryLabel = 'Retry video', captions = [] } = Astro.props
---

<lumen-editorial-video data-src={src} data-poster={poster} data-loading-label={loadingLabel}>
  <slot name="artwork" />
  <ButtonLink class="editorial-video__control" data-video-fallback href={src} variant="secondary">{playLabel}</ButtonLink>
  <Button
    aria-controls={id}
    aria-haspopup="dialog"
    class="editorial-video__control"
    data-video-open
    hidden
    type="button"
  >
    <Icon aria-hidden="true" name="play" />
    <span>{playLabel}</span>
  </Button>
  {Astro.slots.has('transcript') && <Collapsible data-video-transcript><summary>{transcriptLabel}</summary><slot name="transcript" /></Collapsible>}
  <template data-video-tracks>
    {captions.map(track => <track kind="captions" src={track.src} srclang={track.language} label={track.label} default={track.default} />)}
    <slot name="tracks" />
  </template>
  <Dialog aria-labelledby={`${id}-title`} id={id}>
    <DialogBody class="editorial-video__body">
      <div class="editorial-video__heading">
        <DialogTitle id={`${id}-title`}>{title}</DialogTitle>
        <form method="dialog">
          <Button autofocus class="editorial-video__control" type="submit" variant="outline">{closeLabel}</Button>
        </form>
      </div>
      <video aria-label={title} controls playsinline preload="none"></video>
      <p data-video-error={errorLabel} role="status"></p>
      <Button data-video-retry hidden variant="outline">{retryLabel}</Button>
      <Link data-video-file href={src}>{fileLabel}</Link>
    </DialogBody>
  </Dialog>
</lumen-editorial-video>

<script>
  const moveTranscript = (root: HTMLElement) => {
    const transcript = root.querySelector<HTMLElement>('[data-video-transcript]')
    const file = root.querySelector('[data-video-file]')

    if (transcript && file) file.before(transcript)
  }

  class LumenEditorialVideo extends HTMLElement {
    #listeners?: AbortController
    #video?: HTMLVideoElement

    connectedCallback() {
      const dialog = this.querySelector('dialog')
      const video = this.querySelector('video')
      const trigger = this.querySelector<HTMLButtonElement>('[data-video-open]')
      const fallback = this.querySelector<HTMLElement>('[data-video-fallback]')
      const error = this.querySelector<HTMLElement>('[data-video-error]')
      const retry = this.querySelector<HTMLButtonElement>('[data-video-retry]')
      const tracks = this.querySelector<HTMLTemplateElement>('[data-video-tracks]')
      const src = this.dataset.src

      if (!dialog || !video || !trigger || !fallback || !error || !retry || !tracks || !src || typeof dialog.showModal !== 'function') return

      this.disconnectedCallback()

      this.#listeners = new AbortController()

      this.#video = video

      const { signal } = this.#listeners

      const load = () => {
        error.textContent = this.dataset.loadingLabel ?? ''

        retry.hidden = true

        video.replaceChildren(document.importNode(tracks.content, true))

        if (this.dataset.poster) video.poster = this.dataset.poster

        video.src = src

        video.load()
      }

      const pause = () => video.pause()

      trigger.addEventListener('click', () => {
        if (dialog.open) return

        dialog.showModal()

        if (!video.hasAttribute('src') || video.error) load()
      }, { signal })

      retry.addEventListener('click', load, { signal })

      video.addEventListener('loadedmetadata', () => {
 error.textContent = ''
}, { signal })

      document.addEventListener('astro:before-swap', pause, { signal })

      window.addEventListener('pagehide', pause, { signal })

      moveTranscript(this)

      dialog.addEventListener('close', () => {
        if (dialog.open) return

        video.pause()

        trigger.focus({ preventScroll: true })
      }, { signal })

      video.addEventListener('error', () => {
        error.textContent = error.dataset.videoError ?? ''

        retry.hidden = false
      }, { signal })

      trigger.hidden = false

      fallback.hidden = true
    }

    disconnectedCallback() {
      this.#listeners?.abort()

      this.#video?.pause()
    }
  }

  if (!customElements.get('lumen-editorial-video')) {
    customElements.define('lumen-editorial-video', LumenEditorialVideo)
  }
</script>

<style>
  lumen-editorial-video { display: block; min-inline-size: 0; overflow-wrap: anywhere; }
  lumen-editorial-video > [hidden] { display: none; }
  [data-video-error] { margin: 0; }
  .editorial-video__control { max-inline-size: 100%; block-size: auto; white-space: normal; }
  .editorial-video__control :global(.ui-button__content) { min-inline-size: 0; }
  .editorial-video__control span { min-inline-size: 0; }
  .editorial-video__body { display: grid; gap: 1rem; min-inline-size: 0; }
  .editorial-video__heading { display: flex; flex-wrap: wrap; align-items: start; justify-content: space-between; gap: 0.75rem; }
  video { inline-size: 100%; max-block-size: 55dvh; background: hsl(var(--surface-strong)); }
  [data-video-retry][hidden] { display: none; }
  details { margin-block-start: 0.75rem; }
  summary { cursor: pointer; }
</style>

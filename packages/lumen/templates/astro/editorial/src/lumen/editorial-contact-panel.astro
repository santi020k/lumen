---

import { Card, Icon, Typography } from '@santi020k/lumen-astro'

interface Props {
  headingId: string
  headingLevel?: 2 | 3 | 4
  icon?: string
  label: string
  title: string
}

const { headingId, headingLevel = 2, icon = 'mail', label, title } = Astro.props
const Heading = `h${headingLevel}` as const
---

<div class="editorial-contact-container">
  <Card as="section" aria-labelledby={headingId} class="editorial-contact" variant="unstyled">
    <header class="editorial-contact__label"><p>{label}</p><Icon name={icon} size="sm" /></header>
    <Typography class="editorial-contact__title"><Heading id={headingId}>{title}</Heading></Typography>
    <Typography class="editorial-contact__copy"><slot /></Typography>
    {Astro.slots.has('note') && <Typography class="editorial-contact__note"><slot name="note" /></Typography>}
  </Card>
</div>

<style>
  .editorial-contact-container {
    container: editorial-contact / inline-size;
  }

  .editorial-contact[data-slot='card'] {
    min-width: 0;
    max-width: 48rem;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.375rem 1.75rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: anywhere;
  }

  .editorial-contact__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.375rem 1.75rem;
    border-block-end: 1px solid hsl(var(--line));
    border-radius: 1.6875rem 1.6875rem 0 0;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
    font-size: 0.75rem;
    line-height: 1.25rem;
    font-weight: 500;
  }

  .editorial-contact__label p {
    margin: 0;
    color: inherit;
  }

  .editorial-contact-container :global(.editorial-contact__title) {
    padding: 1.625rem 1.75rem 0;
  }

  .editorial-contact-container :global(.editorial-contact__title :is(h2, h3, h4)) {
    margin: 0;
    color: hsl(var(--ink));
    font-size: 1.875rem;
    line-height: 1.25;
    letter-spacing: -0.04em;
    font-weight: 500;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .editorial-contact-container :global(.editorial-contact__copy) {
    padding: 1rem 1.75rem 1.5rem;
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.75rem;
  }

  .editorial-contact-container :global(.editorial-contact__note) {
    padding: 1.125rem 1.75rem 1.375rem;
    border-block-start: 1px solid hsl(var(--line));
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.5rem;
  }

  .editorial-contact-container :global(:is(.editorial-contact__copy, .editorial-contact__note) p) {
    margin: 0;
    color: inherit;
  }

  .editorial-contact-container :global(a) {
    overflow-wrap: anywhere;
    white-space: normal;
  }

  @container editorial-contact (width < 27.5rem) {
    .editorial-contact__label {
      padding: 1.25rem;
    }
    .editorial-contact-container :global(.editorial-contact__title) {
      padding: 1.375rem 1.25rem 0;
    }
    .editorial-contact-container :global(.editorial-contact__title :is(h2, h3, h4)) {
      font-size: 1.625rem;
      line-height: 1.3;
    }
    .editorial-contact-container :global(.editorial-contact__copy) {
      padding: 1rem 1.25rem 1.375rem;
    }
    .editorial-contact-container :global(.editorial-contact__note) {
      padding: 1.125rem 1.25rem 1.375rem;
    }
  }
</style>

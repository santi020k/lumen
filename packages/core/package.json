{
  "name": "@santi020k/lumen-core",
  "version": "4.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared tokens, metadata, and behavior helpers for Lumen UI packages.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "import": "./dist/code.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./figma": {
      "types": "./dist/figma.d.ts",
      "import": "./dist/figma.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./phone": {
      "types": "./dist/phone.d.ts",
      "import": "./dist/phone.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "import": "./dist/rich-text.js"
    },
    "./schedule": {
      "types": "./dist/schedule.d.ts",
      "import": "./dist/schedule.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./package.json": "./package.json",
    "./icon-data": {
      "types": "./dist/icon-data.generated.d.ts",
      "import": "./dist/icon-data.generated.js"
    },
    "./image-comparison": {
      "types": "./dist/image-comparison.d.ts",
      "import": "./dist/image-comparison.js"
    },
    "./virtual-list": {
      "types": "./dist/virtual-list.d.ts",
      "import": "./dist/virtual-list.js"
    },
    "./virtual-window": {
      "types": "./dist/virtual-window.d.ts",
      "import": "./dist/virtual-window.js"
    },
    "./rive": {
      "types": "./dist/rive.d.ts",
      "import": "./dist/rive.js"
    },
    "./world-map": {
      "types": "./dist/world-map.d.ts",
      "import": "./dist/world-map.js"
    },
    "./world-map-data": {
      "types": "./dist/world-map-data.generated.d.ts",
      "import": "./dist/world-map-data.generated.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PHONE_FLAG_LICENSE.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project core",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project core --coverage",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@lucide/icons": "catalog:",
    "libphonenumber-js": "catalog:"
  },
  "devDependencies": {
    "@rive-app/canvas": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@rive-app/canvas": "^2.44.0"
  },
  "peerDependenciesMeta": {
    "@rive-app/canvas": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/santi020k/lumen.git",
    "directory": "packages/core"
  },
  "homepage": "https://lumen.santi020k.com/docs/foundations",
  "bugs": {
    "url": "https://github.com/santi020k/lumen/issues"
  },
  "keywords": [
    "accessible-ui",
    "component-metadata",
    "design-system",
    "design-tokens",
    "lumen",
    "ui"
  ],
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "license": "MIT"
}

{
  "name": "@santi020k/lumen-templates",
  "version": "0.0.0",
  "private": true,
  "description": "Shared product templates and dashboard examples for Lumen UI.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./TemplateGallery.astro": "./src/TemplateGallery.astro",
    "./TemplateRenderer.astro": "./src/TemplateRenderer.astro",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "astro sync && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .astro coverage",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts --project templates",
    "typecheck": "astro sync && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@santi020k/lumen-astro": "workspace:^"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "catalog:",
    "astro": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

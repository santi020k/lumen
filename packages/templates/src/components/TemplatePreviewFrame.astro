---
import type { ImageMetadata } from 'astro'

import { Badge, ButtonLink, Card, CodeTabs, Icon, Image } from '@santi020k/lumen-astro'

import {
  getTemplateInstallCommand,
  type LumenTemplate
} from '../templates'

interface Props {
  template: LumenTemplate
}

const { template } = Astro.props

const previewThemes = [
  'santi020k-light',
  'santi020k-dark',
  'lumen-light',
  'lumen-dark'
] as const

type PreviewTheme = typeof previewThemes[number]

type PreviewViewport = 'desktop' | 'mobile'

const previewImageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/previews/*-{lumen,santi020k}-{light,dark}-{desktop,mobile}.jpg',
  { eager: true }
)

const getPreviewImage = (theme: PreviewTheme, viewport: PreviewViewport): ImageMetadata => {
  const path = `../assets/previews/${template.slug}-${theme}-${viewport}.jpg`
  const image = previewImageModules[path]

  if (!image) throw new Error(`Missing template preview image: ${path}`)

  return image.default
}

const themedPreviews = previewThemes.map(theme => ({
  desktop: getPreviewImage(theme, 'desktop'),
  mobile: getPreviewImage(theme, 'mobile'),
  theme
}))

const frameworkLabels = {
  astro: 'Astro',
  elements: 'Web Components',
  react: 'React'
} as const

const installCommands = template.frameworks.map(framework => ({
  code: getTemplateInstallCommand(template.slug, framework),
  label: frameworkLabels[framework],
  language: 'bash',
  value: framework
}))
---

<Card as="article" class="template-gallery-card" variant="interactive">
  <a
    class="template-gallery-card__preview"
    href={`/templates/${template.slug}`}
    aria-label={`Preview ${template.name}`}
  >
    <span class="template-gallery-card__preview-stage">
      <span class="template-gallery-card__desktop-preview">
        <span class="template-gallery-card__viewport-label">Desktop</span>
        <span class="template-gallery-card__image-stack">
          {themedPreviews.map(preview => (
            <Image
              alt=""
              class="template-gallery-card__theme-image"
              data-preview-theme={preview.theme}
              src={preview.desktop}
            />
          ))}
        </span>
      </span>
      <span class="template-gallery-card__mobile-preview">
        <span class="template-gallery-card__viewport-label">Mobile</span>
        <span class="template-gallery-card__image-stack">
          {themedPreviews.map(preview => (
            <Image
              alt=""
              class="template-gallery-card__theme-image"
              data-preview-theme={preview.theme}
              src={preview.mobile}
            />
          ))}
        </span>
      </span>
    </span>
  </a>
  <div class="template-gallery-card__body">
    <div class="template-gallery-card__icon">
      <Icon name={template.icon} />
    </div>
    <div>
      <span class="template-gallery-card__eyebrow">{template.eyebrow}</span>
      <h2>{template.name}</h2>
      <p>{template.description}</p>
    </div>
    <div class="template-gallery-card__availability">
      <Badge variant="outline">
        <Icon name="blocks" size="sm" />
        One recipe, three targets
      </Badge>
      <span>Switch once; every card remembers your platform.</span>
    </div>
    <CodeTabs
      ariaLabel={`Install ${template.name} by platform`}
      class="template-gallery-card__install"
      items={installCommands}
      storageKey="lumen-template-platform"
      wrap={false}
    />
    <div class="template-gallery-card__actions">
      <ButtonLink href={`/templates/${template.slug}`} showArrow>
        Live preview
      </ButtonLink>
      <ButtonLink
        href="https://github.com/santi020k/lumen/tree/main/packages/lumen/templates"
        newTab
        variant="secondary"
      >
        Browse implementations
      </ButtonLink>
    </div>
  </div>
</Card>

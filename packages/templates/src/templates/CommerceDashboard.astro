---
import {
  BarChart,
  Button,
  Card,
  Icon,
  PieChart,
  Progress,
  Stat
} from '@santi020k/lumen-astro'

import MetricGrid from '../components/MetricGrid.astro'
import StatusTable from '../components/StatusTable.astro'
import TemplateHeader from '../components/TemplateHeader.astro'
import TemplateShell from '../components/TemplateShell.astro'

const navigation = [
  { icon: 'layout-dashboard', label: 'Overview' },
  { icon: 'receipt-text', label: 'Orders' },
  { icon: 'package', label: 'Products' },
  { icon: 'warehouse', label: 'Inventory' },
  { icon: 'users-round', label: 'Customers' }
] as const

const metrics = [
  { change: '+18.6%', direction: 'up', label: 'Gross sales', points: [32, 36, 34, 41, 44, 49, 58], value: '$92,840' },
  { change: '+7.4%', direction: 'up', label: 'Orders', points: [41, 43, 46, 45, 50, 53, 55], value: '1,284' },
  { change: '+$6.20', direction: 'up', label: 'Average order', points: [64, 65, 63, 68, 69, 71, 72], value: '$72.31' },
  { change: '-0.4%', direction: 'up', label: 'Return rate', points: [28, 27, 26, 25, 25, 24, 22], value: '2.1%' }
] as const

const salesSeries = [{
  data: [
    { x: 'Mon', y: 11200 },
    { x: 'Tue', y: 13800 },
    { x: 'Wed', y: 12600 },
    { x: 'Thu', y: 15400 },
    { x: 'Fri', y: 16800 },
    { x: 'Sat', y: 14100 },
    { x: 'Sun', y: 8940 }
  ],
  id: 'sales',
  label: 'Sales',
  tone: 'brand'
}] as const

const orderSources = {
  data: [
    { label: 'Online store', x: 'Online store', y: 812 },
    { label: 'Marketplace', x: 'Marketplace', y: 286 },
    { label: 'Point of sale', x: 'Point of sale', y: 186 }
  ],
  id: 'orders',
  label: 'Orders'
} as const

const rows = [
  { detail: '2 items', id: '#10482', label: 'Nora Singh', owner: 'Maya Chen', status: 'Completed', value: '$148.00' },
  { detail: '1 item', id: '#10481', label: 'Theo Martin', owner: 'Jon Bell', status: 'Pending', value: '$84.50' },
  { detail: '4 items', id: '#10480', label: 'Amina Bello', owner: 'Maya Chen', status: 'At risk', value: '$312.20' },
  { detail: '3 items', id: '#10479', label: 'Luca Reed', owner: 'Nora Singh', status: 'Completed', value: '$226.40' }
] as const
---

<TemplateShell activeItem="Overview" {navigation} product="Mercury" workspace="Northstar Goods">
  <TemplateHeader
    actionIcon="package-plus"
    actionLabel="Add product"
    description="Track store performance, fulfillment pressure, and inventory risk."
    eyebrow="Store overview"
    title="Commerce command center"
  />

  <MetricGrid {metrics} />

  <section class="template-chart-grid" aria-label="Commerce charts">
    <BarChart
      description="Daily gross sales for the current week."
      heading="Sales this week"
      series={salesSeries}
    />
    <PieChart
      centerLabel="orders"
      centerValue="1,284"
      description="Order volume grouped by sales channel."
      heading="Order sources"
      series={orderSources}
    />
  </section>

  <section class="template-commerce-grid">
    <Card as="section" class="template-section">
      <div class="template-section__header">
        <div>
          <h2>Fulfillment</h2>
          <p>Today’s packing and shipping queue.</p>
        </div>
        <Button variant="ghost">Open queue</Button>
      </div>
      <div class="template-fulfillment">
        <Stat label="Orders ready" value="42" />
        <Progress aria-label="42 of 58 orders fulfilled" max={58} value={42} />
        <span>16 orders remain before the 4:00 PM pickup.</span>
      </div>
    </Card>
    <Card as="section" class="template-section">
      <div class="template-section__header">
        <div>
          <h2>Inventory signals</h2>
          <p>Items that need a purchasing decision.</p>
        </div>
      </div>
      <ul class="template-signal-list">
        <li><Icon name="triangle-alert" /><span><strong>3 products</strong> below safety stock</span></li>
        <li><Icon name="timer" /><span><strong>8 transfers</strong> arriving this week</span></li>
        <li><Icon name="circle-check" /><span><strong>94%</strong> inventory accuracy</span></li>
      </ul>
    </Card>
  </section>

  <Card as="section" class="template-section">
    <div class="template-section__header">
      <div>
        <h2>Recent orders</h2>
        <p>Orders placed across every active channel.</p>
      </div>
      <Button variant="ghost">View all orders</Button>
    </div>
    <StatusTable caption="Recent commerce orders" {rows} />
  </Card>
</TemplateShell>

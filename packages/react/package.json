{
  "name": "@santi020k/lumen-react",
  "version": "4.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "React primitive components for Lumen UI.",
  "type": "module",
  "sideEffects": [
    "./layers.css",
    "./styles.css",
    "./styles/critical.css",
    "./styles/data-table-view.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./styles.css": "./styles.css",
    "./styles/critical.css": "./styles/critical.css",
    "./layers.css": "./layers.css",
    "./package.json": "./package.json",
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./components/attachments": {
      "types": "./dist/attachments.d.ts",
      "import": "./dist/attachments.js"
    },
    "./components/bullet-chart": {
      "types": "./dist/bullet-chart.d.ts",
      "import": "./dist/bullet-chart.js"
    },
    "./components/comparison-chart": {
      "types": "./dist/comparison-chart.d.ts",
      "import": "./dist/comparison-chart.js"
    },
    "./components/data-table": {
      "types": "./dist/data-table.d.ts",
      "import": "./dist/data-table.js"
    },
    "./components/date-range-calendar": {
      "types": "./dist/date-range-calendar.d.ts",
      "import": "./dist/date-range-calendar.js"
    },
    "./components/date-range-input": {
      "types": "./dist/date-range-input.d.ts",
      "import": "./dist/date-range-input.js"
    },
    "./components/expanded-charts": {
      "types": "./dist/expanded-charts.d.ts",
      "import": "./dist/expanded-charts.js"
    },
    "./components/image-comparison": {
      "types": "./dist/image-comparison.d.ts",
      "import": "./dist/image-comparison.js"
    },
    "./components/interval-charts": {
      "types": "./dist/interval-charts.d.ts",
      "import": "./dist/interval-charts.js"
    },
    "./components/virtual-list": {
      "types": "./dist/virtual-list.d.ts",
      "import": "./dist/virtual-list.js"
    },
    "./components/world-map": {
      "types": "./dist/world-map.d.ts",
      "import": "./dist/world-map.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./components/data-table-view": {
      "types": "./dist/data-table-view.d.ts",
      "import": "./dist/data-table-view.js"
    },
    "./styles/data-table-view.css": "./styles/data-table-view.css",
    "./forms": {
      "types": "./dist/form-workflow.d.ts",
      "import": "./dist/form-workflow.js"
    },
    "./components/device-frame": {
      "types": "./dist/device-frame.d.ts",
      "import": "./dist/device-frame.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "layers.css",
    "styles.css",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "lumen": "./bin/lumen.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/minify-build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project react",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project react --coverage",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "clean": "rm -rf dist coverage",
    "measure:selective-imports": "node scripts/measure-selective-imports.mjs"
  },
  "dependencies": {
    "@santi020k/lumen": "workspace:^",
    "@santi020k/lumen-core": "workspace:^",
    "@tanstack/react-table": "catalog:",
    "uqr": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "motion": "^14.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/santi020k/lumen.git",
    "directory": "packages/react"
  },
  "homepage": "https://lumen.santi020k.com/docs/frameworks/react",
  "bugs": {
    "url": "https://github.com/santi020k/lumen/issues"
  },
  "keywords": [
    "accessible-ui",
    "component-library",
    "design-system",
    "lumen",
    "react",
    "ui"
  ],
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "license": "MIT"
}

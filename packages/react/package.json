{
  "name": "@santi020k/lumen-react",
  "version": "1.6.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "React primitive components for Lumen UI.",
  "type": "module",
  "sideEffects": [
    "./layers.css",
    "./styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./layers.css": "./layers.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "layers.css",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project react",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project react --coverage",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@santi020k/lumen": "workspace:^",
    "@santi020k/lumen-core": "workspace:^",
    "uqr": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/santi020k/lumen.git",
    "directory": "packages/react"
  },
  "homepage": "https://lumen.santi020k.com/docs/frameworks/react",
  "bugs": {
    "url": "https://github.com/santi020k/lumen/issues"
  },
  "keywords": [
    "accessible-ui",
    "component-library",
    "design-system",
    "lumen",
    "react",
    "ui"
  ],
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "license": "MIT"
}

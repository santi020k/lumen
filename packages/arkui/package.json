  "private": true,
  "description": "Workspace checks for the Lumen UI ArkUI pilot. The HarmonyOS package is described by oh-package.json5.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'dialog'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<dialog
  data-ui-sheet
  class:list={[
    'ui-sheet',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</dialog>

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'dialog'> {
  class?: string
  className?: string
  surface?: 'default' | 'glass'
}

const {
  class: classProp = '',
  className = '',
  surface = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<dialog
  data-surface={surface}
  data-ui-sheet
  class:list={[
    'ui-sheet',
    surface === 'glass' && 'ui-sheet--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</dialog>

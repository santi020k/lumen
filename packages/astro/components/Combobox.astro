---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'input'> {
  class?: string
  className?: string
  label?: string
  list: string
  options?: string[]
}

const {
  class: classProp = '',
  className = '',
  id,
  label,
  list,
  options = [],
  type = 'text',
  ...rest
} = Astro.props

const inputId = id ?? `${list}-input`
const passthrough = rest as Record<string, unknown>
---

<div class:list={['ui-combobox', classProp, className]} data-ui-combobox>
  {label && <label class="ui-label" for={inputId}>{label}</label>}
  <input
    aria-autocomplete="list"
    aria-controls={list}
    aria-expanded="false"
    class="ui-input"
    id={inputId}
    role="combobox"
    type={type}
    {...passthrough}
  />
  <div class="ui-combobox__list" hidden id={list} role="listbox">
    {options.map(option => (
      <button data-ui-combobox-option data-value={option} role="option" type="button">{option}</button>
    ))}
  </div>
</div>

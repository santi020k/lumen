---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'input'> {
  class?: string | null
  className?: string
  label?: string
  list: string
  options?: ComboboxOption[]
}

interface Option {
  disabled?: boolean
  label: string
  value: string
}

type ComboboxOption = Option | string

const {
  class: classProp = '',
  className = '',
  id,
  label,
  list,
  options = [],
  type = 'text',
  ...rest
} = Astro.props

const inputId = id ?? `${list}-input`
const normalizedOptions = options.map(option => typeof option === 'string' ? { label: option, value: option } : option)

const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-combobox'
], classProp, className)
---

<div class:list={classList} data-ui-combobox>
  {label && <label class="ui-label" for={inputId}>{label}</label>}
  <input
    aria-autocomplete="list"
    aria-controls={list}
    aria-expanded="false"
    class="ui-input"
    id={inputId}
    role="combobox"
    type={type}
    {...passthrough}
  />
  <div class="ui-combobox__list" hidden id={list} role="listbox">
    {normalizedOptions.map(option => (
      <button
        aria-disabled={option.disabled ? 'true' : undefined}
        data-ui-combobox-option
        data-value={option.value}
        disabled={option.disabled}
        role="option"
        type="button"
      >
        {option.label}
      </button>
    ))}
  </div>
</div>

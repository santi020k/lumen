---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'
import Icon from './Icon.astro'

import type { HTMLAttributes } from 'astro/types'

type TransferItem = { key: string; label: string }

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  items?: TransferItem[]
  name?: string
  sourceTitle?: string
  targetItems?: TransferItem[]
  targetTitle?: string
}

const {
  class: classProp = '',
  className = '',
  items = [],
  name,
  sourceTitle = 'Available',
  targetItems = [],
  targetTitle = 'Selected',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-transfer'
], classProp, className)
---

<div class:list={classList} data-ui-transfer data-ui-transfer-name={name} {...passthrough}>
  <div class="ui-transfer__panel">
    <p class="ui-transfer__title">{sourceTitle}</p>
    <ul class="ui-transfer__list" data-side="source" data-ui-transfer-list>
      {items.map(item => (
        <li class="ui-transfer__item">
          <label class="ui-transfer__option">
            <input class="ui-checkbox" data-ui-transfer-item type="checkbox" value={item.key} />
            <span>{item.label}</span>
          </label>
        </li>
      ))}
    </ul>
  </div>
  <div class="ui-transfer__controls">
    <button aria-label={`Move to ${targetTitle}`} class="ui-button ui-button--outline ui-button--icon" data-ui-transfer-move="target" type="button">
      <Icon name="chevron-right" />
    </button>
    <button aria-label={`Move to ${sourceTitle}`} class="ui-button ui-button--outline ui-button--icon" data-ui-transfer-move="source" type="button">
      <Icon name="chevron-left" />
    </button>
  </div>
  <div class="ui-transfer__panel">
    <p class="ui-transfer__title">{targetTitle}</p>
    <ul class="ui-transfer__list" data-side="target" data-ui-transfer-list>
      {targetItems.map(item => (
        <li class="ui-transfer__item">
          <label class="ui-transfer__option">
            <input class="ui-checkbox" data-ui-transfer-item type="checkbox" value={item.key} />
            <span>{item.label}</span>
          </label>
        </li>
      ))}
    </ul>
  </div>
</div>

---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'section'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
}

const { class: classProp = '', className = '', glass = false, ...rest } = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-rich-text-editor', glass && 'ui-rich-text-editor--glass', glass === 'subtle' && 'ui-glass-subtle', glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<section class:list={classList} data-ui-rich-text-editor {...passthrough}>
  <slot />
</section>

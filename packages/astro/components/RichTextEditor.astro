---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'section'> {
  class?: string
  className?: string
}

const { class: classProp = '', className = '', ...rest } = Astro.props
const passthrough = rest as Record<string, unknown>
---

<section class:list={['ui-rich-text-editor', classProp, className]} data-ui-rich-text-editor {...passthrough}>
  <slot />
</section>

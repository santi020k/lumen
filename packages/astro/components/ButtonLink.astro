---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import Icon from './Icon.astro'

interface Props extends HTMLAttributes<'a'> {
  ariaLabel?: string
  class?: string | null
  className?: string
  href: string
  newTab?: boolean
  shape?: 'default' | 'icon'
  showArrow?: boolean
  variant?: 'ghost' | 'inline' | 'primary' | 'secondary' | 'unstyled'
}

const {
  ariaLabel,
  class: classProp = '',
  className = '',
  href,
  newTab = false,
  shape = 'default',
  showArrow = false,
  variant = 'primary',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-button-link',
  variant !== 'unstyled' && 'group inline-flex cursor-pointer items-center justify-center gap-2 text-sm font-semibold tracking-[0.01em]',
  variant !== 'inline' && variant !== 'unstyled' && 'min-h-11 rounded-full border',
  variant === 'primary' && 'ui-button ui-button--primary',
  variant === 'secondary' && 'ui-button ui-button--secondary',
  variant === 'ghost' && 'ui-button ui-button--ghost',
  variant === 'inline' && 'ui-button ui-button--inline',
  variant === 'unstyled' && 'ui-button-link--unstyled',
  shape === 'icon' && variant !== 'inline' && 'ui-button-link--icon'
], classProp, className)
---

<a
  aria-label={ariaLabel}
  class:list={classList}
  href={href}
  rel={newTab ? 'noreferrer noopener' : undefined}
  target={newTab ? '_blank' : undefined}
  {...passthrough}
>
  <slot />
  {showArrow && (
    <Icon
      aria-hidden="true"
      class="
        size-4 shrink-0 transition-transform duration-200
        motion-safe:group-hover:translate-x-0.5
        motion-reduce:transition-none
      "
      name={newTab ? 'arrow-up-right' : 'arrow-right'}
    />
  )}
</a>

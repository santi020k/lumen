---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'figure'> {
  class?: string
  className?: string
  glass?: boolean
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<figure
  class:list={[
    'ui-chart',
    glass && 'ui-chart--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</figure>

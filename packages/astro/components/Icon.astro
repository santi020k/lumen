---
import type { HTMLAttributes } from 'astro/types'

import {
  type LumenIconName,
  renderLumenIconSvg,
  resolveLumenAstroProps } from '@santi020k/lumen-core'

type IconSize = 'default' | 'lg' | 'sm' | 'xl'

interface Props extends HTMLAttributes<'span'> {
  class?: string | null
  className?: string
  decorative?: boolean
  label?: string
  name?: LumenIconName
  size?: IconSize
}

const {
  'aria-hidden': ariaHidden,
  'aria-label': ariaLabel,
  class: classProp = '',
  className = '',
  decorative,
  label,
  name,
  role,
  size = 'default',
  ...rest
} = Astro.props

const accessibleLabel = label ?? ariaLabel
const isDecorative = decorative ?? (ariaHidden === undefined ? !accessibleLabel : ariaHidden === true || ariaHidden === 'true')
const iconSvg = name ? renderLumenIconSvg(name) : ''

if (name && !iconSvg && import.meta.env.DEV) {
  console.warn(
    `[Lumen Icon] Unknown icon "${name}". ` +
    'Register an icon pack or use the default slot for project-specific SVGs.'
  )
}

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-icon',
  size === 'sm' && 'ui-icon--sm',
  size === 'lg' && 'ui-icon--lg',
  size === 'xl' && 'ui-icon--xl'
], classProp, className)
---

<span
  aria-hidden={isDecorative ? 'true' : undefined}
  aria-label={!isDecorative ? accessibleLabel : undefined}
  class:list={classList}
  role={!isDecorative ? role ?? 'img' : undefined}
  {...passthrough}
>
  {name ? <Fragment set:html={iconSvg} /> : <slot />}
</span>

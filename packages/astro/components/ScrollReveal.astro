---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/scroll-reveal.css'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'
import { normalizeLumenRevealThreshold } from '@santi020k/lumen-core/reveal'

interface Props extends HTMLAttributes<'div'> {
  animation?: 'fade' | 'slide-up' | 'scale'
  as?: 'article' | 'div' | 'section'
  class?: string | null
  className?: string
  delay?: number
  duration?: 'fast' | 'standard' | 'slow'
  once?: boolean
  threshold?: number
}

const {
  animation = 'fade',
  as: Tag = 'div',
  class: classProp = '',
  className = '',
  delay = 0,
  duration = 'slow',
  once = true,
  style,
  threshold = 0.15,
  ...rest
} = Astro.props

const safeDelay = Math.max(0, delay)
const safeThreshold = normalizeLumenRevealThreshold(threshold)

const motionStyle = [
  typeof style === 'string' ? style : '',
  `--ui-reveal-delay:${safeDelay}ms`
].filter(Boolean).join(';')

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-scroll-reveal',
  `ui-scroll-reveal-${animation}`,
  `ui-motion-duration-${duration}`
], classProp, className)
---

<Tag
  class:list={classList}
  data-ui-reveal-once={String(once)}
  data-ui-reveal-threshold={safeThreshold}
  data-ui-scroll-reveal
  style={motionStyle}
  {...passthrough}
>
  <slot />
</Tag>

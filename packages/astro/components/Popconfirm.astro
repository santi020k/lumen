---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  cancelLabel?: string
  class?: string | null
  className?: string
  confirmLabel?: string
  title?: string
}

const {
  cancelLabel = 'Cancel',
  class: classProp = '',
  className = '',
  confirmLabel = 'Confirm',
  title = 'Are you sure?',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-popover',
  'ui-popconfirm'
], classProp, className)
---

<div class:list={classList} data-surface="default" data-ui-popconfirm data-ui-popover {...passthrough}>
  <span aria-expanded="false" aria-haspopup="dialog" class="ui-popconfirm__trigger" data-ui-trigger>
    <slot />
  </span>
  <div class="ui-popover__panel ui-popconfirm__panel" data-ui-panel hidden role="dialog">
    <p class="ui-popconfirm__message">{title}</p>
    <div class="ui-popconfirm__actions">
      <button class="ui-button ui-button--ghost ui-button--sm" data-ui-popconfirm-cancel type="button">{cancelLabel}</button>
      <button class="ui-button ui-button--destructive ui-button--sm" data-ui-popconfirm-confirm type="button">{confirmLabel}</button>
    </div>
  </div>
</div>

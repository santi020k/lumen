---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'section'> {
  label?: string
  resultLabel?: string
  pending?: boolean
  open?: boolean
  class?: string | null
  className?: string
}

const { label = 'Filters', resultLabel, pending = false, open = true, class: classProp, className, ...rest } = Astro.props
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-filter-bar'], classProp, className)
---
<section class:list={classList} aria-label={label} aria-busy={pending} {...passthrough}>
  <details open={open}>
    <summary>{label}</summary>
    <div class="ui-filter-bar__controls"><slot /></div>
  </details>
  <div class="ui-filter-bar__active"><slot name="active" /><slot name="actions" /></div>
  <p class="ui-filter-bar__results" role="status" aria-live="polite" aria-atomic="true">{resultLabel}</p>
</section>

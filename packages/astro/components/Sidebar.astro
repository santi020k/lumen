---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'aside'> {
  class?: string
  className?: string
  glass?: boolean
  surface?: 'default' | 'glass'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  surface = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
const resolvedSurface = glass || surface === 'glass' ? 'glass' : surface
---

<aside
  data-surface={resolvedSurface}
  class:list={[
    'ui-sidebar',
    resolvedSurface === 'glass' && 'ui-sidebar--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</aside>

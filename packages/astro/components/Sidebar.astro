---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps, resolveLumenGlass } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'aside'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  variant?: 'default' | 'unstyled'

  /**
   * @deprecated Use `glass` instead. `surface="glass"` maps to `glass={true}`.
   */
  surface?: 'default' | 'glass'
}

type InternalProps = Omit<Props, 'surface'> & { surface?: 'default' | 'glass' }

const internalProps: InternalProps = Astro.props

const {
  class: classProp = '',
  className = '',
  glass = false,
  surface = 'default',
  variant = 'default',
  ...rest
} = internalProps

const resolvedGlass = resolveLumenGlass(glass, surface)

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-sidebar',
  variant === 'unstyled' && 'ui-sidebar--unstyled',
  resolvedGlass && 'ui-sidebar--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<aside
  data-slot="sidebar"
  data-surface={resolvedGlass ? 'glass' : 'default'}
  data-variant={variant}
  class:list={classList}
  {...passthrough}
>
  <slot />
</aside>

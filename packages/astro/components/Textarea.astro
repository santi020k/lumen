---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'textarea'> {
  class?: string
  className?: string
}

const { class: classProp = '', className = '', rows = 4, ...rest } = Astro.props
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-textarea'
], classProp, className)
---

{/* Slot must stay inline: whitespace inside <textarea> becomes its value and hides the placeholder. */}
<textarea class:list={classList} rows={rows} {...passthrough}><slot /></textarea>

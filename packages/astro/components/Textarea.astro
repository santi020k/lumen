---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'textarea'> {
  class?: string
  className?: string
}

const { class: classProp = '', className = '', rows = 4, ...rest } = Astro.props
const passthrough = rest as Record<string, unknown>
---

<textarea
  class:list={['ui-textarea', classProp, className]}
  rows={rows}
  {...passthrough}
>
  <slot />
</textarea>

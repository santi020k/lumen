---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'textarea'> {
  class?: string
  className?: string
}

const { class: classProp = '', className = '', rows = 4, ...rest } = Astro.props
const passthrough = rest as Record<string, unknown>
---

{/* Slot must stay inline: whitespace inside <textarea> becomes its value and hides the placeholder. */}
<textarea class:list={['ui-textarea', classProp, className]} rows={rows} {...passthrough}><slot /></textarea>

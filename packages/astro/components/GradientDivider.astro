---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-gradient-divider'
], classProp, className)
---

<div aria-hidden="true" class:list={classList} {...passthrough}>
  <div class="ui-gradient-divider__line"></div>
</div>

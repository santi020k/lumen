---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'section'> {
  class?: string
  className?: string
  glass?: boolean
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<section
  data-ui-carousel
  class:list={[
    'ui-carousel',
    glass && 'ui-carousel--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</section>

---
import type { HTMLAttributes } from 'astro/types'

import { isLumenDateBoundsValid, type LumenDateLabels, parseLumenDate, resolveLumenAstroProps, resolveLumenDateLabels, resolveLumenDateLocale } from '@santi020k/lumen-core'

interface Props extends Omit<HTMLAttributes<'div'>, 'value'> {
  class?: string | null
  className?: string
  disabled?: boolean
  glass?: boolean | 'subtle' | 'strong'
  labels?: Partial<Pick<LumenDateLabels, 'previousMonth' | 'nextMonth'>>
  locale?: string
  readOnly?: boolean
  max?: string
  min?: string
  month?: string
  name?: string
  value?: string
}

const createDate = (year: number, month: number, day: number): Date => {
  const date = new Date(0)

  date.setUTCFullYear(year, month, day)

  return date
}

const parseIsoDate = (date: string | undefined): Date | undefined => parseLumenDate(date) ?? undefined
const parseIsoMonth = (date: string | undefined): Date | undefined => date ? parseIsoDate(`${date}-01`) : undefined
const formatIsoDate = (date: Date): string => date.toISOString().split('T')[0] ?? ''
const formatIsoMonth = (date: Date): string => formatIsoDate(date).slice(0, -3)
const addDays = (date: Date, days: number): Date => createDate(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate() + days)
const isBefore = (date: Date, limit: Date | undefined): boolean => Boolean(limit && date < limit)
const isAfter = (date: Date, limit: Date | undefined): boolean => Boolean(limit && date > limit)

const {
  class: classProp = '',
  className = '',
  disabled: requestedDisabled = false,
  glass = false,
  id,
  labels,
  locale,
  readOnly = false,
  max,
  min,
  month,
  name,
  value,
  ...rest
} = Astro.props

const disabled = requestedDisabled || !isLumenDateBoundsValid(min, max)
const resolvedLocale = resolveLumenDateLocale(locale)
const resolvedLabels = { ...resolveLumenDateLabels(resolvedLocale), ...labels }
const weekdayFormatter = new Intl.DateTimeFormat(resolvedLocale, { timeZone: 'UTC', weekday: 'short' })
const monthFormatter = new Intl.DateTimeFormat(resolvedLocale, { month: 'long', timeZone: 'UTC', year: 'numeric' })

const dayFormatter = new Intl.DateTimeFormat(resolvedLocale, {
  day: 'numeric', month: 'long', timeZone: 'UTC', weekday: 'long', year: 'numeric'
})

const today = new Date()
const todayUtc = createDate(today.getFullYear(), today.getMonth(), today.getDate())
const selectedDate = parseIsoDate(value)
const minDate = parseIsoDate(min ?? '0001-01-01')
const maxDate = parseIsoDate(max ?? '9999-12-31')
const selectedIso = selectedDate ? formatIsoDate(selectedDate) : ''

const monthDate = parseIsoMonth(month) ??
  (selectedDate ? createDate(selectedDate.getUTCFullYear(), selectedDate.getUTCMonth(), 1) : undefined) ??
  createDate(todayUtc.getUTCFullYear(), todayUtc.getUTCMonth(), 1)

const calendarId = id ?? `ui-calendar-${Math.random().toString(36).slice(2)}`
const labelId = `${calendarId}-label`
const monthIso = formatIsoMonth(monthDate)
const todayIso = formatIsoDate(todayUtc)
const firstWeekday = (monthDate.getUTCDay() + 6) % 7
const firstCell = addDays(monthDate, -firstWeekday)
const visibleDates = Array.from({ length: 42 }, (_, index) => addDays(firstCell, index))

const firstSelectableDate = visibleDates.find(date => date.getUTCMonth() === monthDate.getUTCMonth() &&
  !isBefore(date, minDate) &&
  !isAfter(date, maxDate))

let focusIso = formatIsoDate(monthDate)

if (selectedDate && !isBefore(selectedDate, minDate) && !isAfter(selectedDate, maxDate) && formatIsoMonth(selectedDate) === monthIso) focusIso = selectedIso
else if (
  !isBefore(todayUtc, minDate) && !isAfter(todayUtc, maxDate) &&
  todayUtc.getUTCMonth() === monthDate.getUTCMonth() &&
  todayUtc.getUTCFullYear() === monthDate.getUTCFullYear()
) focusIso = todayIso
else if (firstSelectableDate) focusIso = formatIsoDate(firstSelectableDate)

const weekdays = Array.from(
  { length: 7 }, (_, index) => weekdayFormatter.format(new Date(Date.UTC(2026, 0, 5 + index)))
)

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-calendar',
  glass && 'ui-calendar--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<div
  aria-disabled={disabled ? 'true' : undefined}
  class:list={classList}
  data-ui-calendar
  data-locale={locale}
  data-readonly={readOnly ? 'true' : undefined}
  data-previous-month-label={labels?.previousMonth}
  data-next-month-label={labels?.nextMonth}
  data-ui-calendar-initial-month={monthIso}
  data-ui-calendar-max={max}
  data-ui-calendar-min={min}
  data-ui-calendar-month={monthIso}
  data-ui-calendar-value={selectedIso || undefined}
  data-disabled={requestedDisabled ? 'true' : undefined}
  data-ui-glass-track={glass ? true : undefined}
  id={calendarId}
  {...passthrough}
>
  <input
    data-ui-calendar-input
    disabled={disabled || undefined}
    name={name}
    type="hidden"
    value={selectedIso}
  />

  <div class="ui-calendar__header">
    <button
      aria-label={resolvedLabels.previousMonth}
      class="ui-calendar__nav"
      data-ui-calendar-prev
      disabled={disabled || isBefore(addDays(monthDate, -1), minDate) || undefined}
      type="button"
    >
      <span aria-hidden="true">&lsaquo;</span>
    </button>
    <strong class="ui-calendar__label" data-ui-calendar-label id={labelId}>{monthFormatter.format(monthDate)}</strong>
    <button
      aria-label={resolvedLabels.nextMonth}
      class="ui-calendar__nav"
      data-ui-calendar-next
      disabled={disabled || isAfter(createDate(monthDate.getUTCFullYear(), monthDate.getUTCMonth() + 1, 1), maxDate) || undefined}
      type="button"
    >
      <span aria-hidden="true">&rsaquo;</span>
    </button>
  </div>

  <table
aria-readonly={readOnly ? 'true' : undefined}
aria-labelledby={labelId}
class="ui-calendar__grid"
data-ui-calendar-grid
role="grid"
  >
    <thead>
      <tr role="row">
        {weekdays.map(weekday => <th role="columnheader" scope="col">{weekday}</th>)}
      </tr>
    </thead>
    <tbody>
      {Array.from({ length: 6 }, (_, rowIndex) => (
        <tr role="row">
          {visibleDates.slice(rowIndex * 7, rowIndex * 7 + 7).map(date => {
            const dateIso = formatIsoDate(date)
            const outside = date.getUTCMonth() !== monthDate.getUTCMonth()
            const unavailable = disabled || isBefore(date, minDate) || isAfter(date, maxDate)

            return (
              <td
                aria-disabled={unavailable ? 'true' : undefined}
                aria-label={dayFormatter.format(date)}
                aria-selected={selectedIso === dateIso ? 'true' : 'false'}
                data-date={dateIso}
                data-outside={outside ? 'true' : undefined}
                data-selected={selectedIso === dateIso ? 'true' : undefined}
                data-today={todayIso === dateIso ? 'true' : undefined}
                data-ui-calendar-day
                role="gridcell"
                tabindex={!unavailable && focusIso === dateIso ? '0' : '-1'}
              >
                {date.getUTCDate()}
              </td>
            )
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>

---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'article'> {
  class?: string
  className?: string
  from?: 'user' | 'assistant'
}

const {
  class: classProp = '',
  className = '',
  from = 'assistant',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
    'ui-message',
    from === 'user' && 'ui-message--user',
    from === 'assistant' && 'ui-message--assistant'
], classProp, className)
---

<article
  data-from={from}
  class:list={classList}
  {...passthrough}
>
  <slot />
</article>

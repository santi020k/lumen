---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'article'> {
  class?: string
  className?: string
  from?: 'user' | 'assistant'
}

const {
  class: classProp = '',
  className = '',
  from = 'assistant',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<article
  data-from={from}
  class:list={[
    'ui-message',
    from === 'user' && 'ui-message--user',
    from === 'assistant' && 'ui-message--assistant',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</article>

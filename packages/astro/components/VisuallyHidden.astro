---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'span'> {
  class?: string | null
  className?: string
  focusable?: boolean
}

const {
  class: classProp = '',
  className = '',
  focusable = false,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-visually-hidden',
  focusable && 'ui-visually-hidden--focusable'
], classProp, className)
---

<span class:list={classList} data-ui-visually-hidden {...passthrough}>
  <slot />
</span>

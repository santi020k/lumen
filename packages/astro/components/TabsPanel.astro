---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  value: string
}

const {
  class: classProp = '',
  className = '',
  value,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(
  rest,
  [],
  classProp,
  className
)
---

<div
  role="tabpanel"
  data-value={value}
  tabindex="0"
  class:list={classList}
  {...passthrough}
>
  <slot />
</div>

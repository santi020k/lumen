---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'section'> {
  class?: string
  className?: string
  glass?: boolean | 'subtle' | 'strong'
}

const { class: classProp = '', className = '', glass = false, ...rest } = Astro.props
const passthrough = rest as Record<string, unknown>
---

<section class:list={['ui-theme-builder', glass && 'ui-theme-builder--glass', glass === 'subtle' && 'ui-glass-subtle', glass === 'strong' && 'ui-glass-strong', classProp, className]} data-ui-theme-builder {...passthrough}>
  <slot />
</section>

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'kbd'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<kbd
  class:list={[
    'ui-kbd',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</kbd>

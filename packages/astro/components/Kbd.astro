---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'kbd'> {
  class?: string | null
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-kbd'
], classProp, className)
---

<kbd
  class:list={classList}
  {...passthrough}
>
  <slot />
</kbd>

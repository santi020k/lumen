---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'span'> {
  class?: string | null
  className?: string
  alt?: string
  fallback?: string
  src?: string
}

const {
  class: classProp = '',
  className = '',
  alt = '',
  fallback,
  src,
  ...rest
} = Astro.props

const hasDefaultSlot = Astro.slots.has('default')
const fallbackText = fallback ?? (!src && !hasDefaultSlot ? '?' : undefined)
const { classList, passthrough } = resolveLumenAstroProps(rest, [
    'ui-avatar'
], classProp, className)
---

<span
  class:list={classList}
  {...passthrough}
>
  {src ? <img alt={alt} src={src} /> : fallbackText && <span aria-hidden={fallback ? undefined : 'true'}>{fallbackText}</span>}
  <slot />
</span>

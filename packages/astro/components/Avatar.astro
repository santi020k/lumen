---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'span'> {
  class?: string
  className?: string
  alt?: string
  fallback?: string
  src?: string
}

const {
  class: classProp = '',
  className = '',
  alt = '',
  fallback,
  src,
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<span
  class:list={[
    'ui-avatar',
    classProp,
    className
  ]}
  {...passthrough}
>
  {src ? <img alt={alt} src={src} /> : fallback && <span>{fallback}</span>}
  <slot />
</span>

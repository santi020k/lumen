---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'
import { renderSVG } from 'uqr'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'figure'> {
  class?: string | null
  className?: string
  size?: number
  src?: string
  value?: string
}

const {
  class: classProp = '',
  className = '',
  size = 160,
  src,
  value,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-qr-code'
], classProp, className)

const qrSvg = !src && value ? renderSVG(value) : null
const qrSrc = qrSvg ? `data:image/svg+xml;utf8,${encodeURIComponent(qrSvg)}` : src
---

<figure
  class:list={classList}
  data-ui-qr-code
  style={`--ui-qr-code-size:${size}px`}
  {...passthrough}
>
  <div class="ui-qr-code__frame">
    {qrSrc
      ? <img alt={value ? `QR code for ${value}` : 'QR code'} class="ui-qr-code__image" height={size} src={qrSrc} width={size} />
      : <slot />}
  </div>
  {value && <figcaption class="ui-qr-code__value">{value}</figcaption>}
</figure>

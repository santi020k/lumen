---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'figure'> {
  class?: string
  className?: string
  size?: number
  src?: string
  value?: string
}

const {
  class: classProp = '',
  className = '',
  size = 160,
  src,
  value,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-qr-code'
], classProp, className)
---

<figure
  class:list={classList}
  data-ui-qr-code
  style={`--ui-qr-code-size:${size}px`}
  {...passthrough}
>
  <div class="ui-qr-code__frame">
    {src
      ? <img alt={value ? `QR code for ${value}` : 'QR code'} class="ui-qr-code__image" height={size} src={src} width={size} />
      : <slot />}
  </div>
  {value && <figcaption class="ui-qr-code__value">{value}</figcaption>}
</figure>

---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

type MentionOption = string | { label: string, value: string }

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  label?: string
  name?: string
  options?: MentionOption[]
  placeholder?: string
  trigger?: string
}

const {
  class: classProp = '',
  className = '',
  label = 'Mentions',
  name,
  options = [],
  placeholder,
  trigger = '@',
  ...rest
} = Astro.props

const normalized = options.map(option => typeof option === 'string' ? { label: option, value: option } : option)
const listId = `ui-mentions-${Math.random().toString(36).slice(2)}-list`

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-mentions'
], classProp, className)
---

<div class:list={classList} data-ui-mentions data-ui-mentions-trigger={trigger} {...passthrough}>
  <textarea
    aria-autocomplete="list"
    aria-controls={listId}
    aria-expanded="false"
    aria-label={label}
    class="ui-textarea ui-mentions__input"
    data-ui-mentions-input
    name={name}
    placeholder={placeholder}
    role="combobox"
    rows={3}
  />
  <ul class="ui-mentions__list" data-ui-mentions-list hidden id={listId} role="listbox">
    {normalized.map((option, index) => (
      <li>
        <button
          aria-selected="false"
          class="ui-mentions__option"
          data-ui-mentions-option
          data-value={option.value}
          id={`${listId}-option-${index}`}
          role="option"
          type="button"
        >
          {option.label}
        </button>
      </li>
    ))}
  </ul>
</div>

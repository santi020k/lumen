---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/schedule.css'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'section'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
}

const { class: classProp = '', className = '', glass = false, ...rest } = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-schedule', glass && 'ui-schedule--glass', glass === 'subtle' && 'ui-glass-subtle', glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<section class:list={classList} data-ui-schedule {...passthrough}>
  <slot />
</section>

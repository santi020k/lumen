---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  class?: string
  className?: string
  loading?: boolean
  size?: 'default' | 'sm' | 'lg' | 'icon'
  variant?: 'default' | 'destructive' | 'ghost' | 'link' | 'outline' | 'secondary'
}

const {
  class: classProp = '',
  className = '',
  disabled,
  loading = false,
  size = 'default',
  type = 'button',
  variant = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
const isDisabled = Boolean(disabled) || loading
---

<button
  class:list={[
    'ui-button',
    variant === 'default' && 'ui-button--default',
    variant === 'destructive' && 'ui-button--destructive',
    variant === 'ghost' && 'ui-button--ghost',
    variant === 'link' && 'ui-button--link',
    variant === 'outline' && 'ui-button--outline',
    variant === 'secondary' && 'ui-button--secondary',
    size === 'default' && 'ui-button--default-size',
    size === 'sm' && 'ui-button--sm',
    size === 'lg' && 'ui-button--lg',
    size === 'icon' && 'ui-button--icon',
    isDisabled && 'ui-button--disabled',
    loading && 'ui-button--loading',
    classProp,
    className
  ]}
  aria-busy={loading || undefined}
  disabled={isDisabled || undefined}
  type={type}
  {...passthrough}
>
  {loading && <span aria-hidden="true" class="ui-spinner"></span>}
  <slot />
</button>

---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'
import Icon from './Icon.astro'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  class?: string | null
  className?: string
  controlled?: boolean
  darkTheme?: string
  lightTheme?: string
  storageKey?: string
}

const {
  class: classProp = '',
  className = '',
  controlled = false,
  darkTheme = 'dark',
  lightTheme = 'light',
  storageKey = 'lumen-theme',
  type = 'button',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-theme-toggle'
], classProp, className)
---

<button
  type={type}
  class:list={classList}
  data-dark-theme={darkTheme}
  data-light-theme={lightTheme}
  data-storage-key={storageKey}
  data-ui-controlled={controlled || undefined}
  data-ui-theme-toggle
  {...passthrough}
>
  <span class="ui-sr-only">Toggle color theme</span>
  <Icon
    aria-hidden="true"
    class="ui-theme-toggle__sun"
    name="sun"
  />
  <Icon
    aria-hidden="true"
    class="ui-theme-toggle__moon"
    name="moon"
  />
</button>

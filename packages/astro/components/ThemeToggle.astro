---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'
import Icon from './Icon.astro'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  type = 'button',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-theme-toggle'
], classProp, className)
---

<button
  type={type}
  class:list={classList}
  data-ui-theme-toggle
  {...passthrough}
>
  <span class="ui-sr-only">Toggle color theme</span>
  <Icon
    aria-hidden="true"
    class="ui-theme-toggle__sun"
    name="sun"
  />
  <Icon
    aria-hidden="true"
    class="ui-theme-toggle__moon"
    name="moon"
  />
</button>

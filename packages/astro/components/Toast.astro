---
import { resolveLumenAstroProps, resolveLumenGlass } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'aside'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  /**
   * @deprecated Use `glass` instead. `surface="glass"` maps to `glass={true}`.
   */
  surface?: 'default' | 'glass'
  variant?: 'default' | 'destructive' | 'success' | 'warning'
}

const {
  'aria-live': ariaLive,
  class: classProp = '',
  className = '',
  glass = false,
  role,
  surface = 'default',
  variant = 'default',
  ...rest
} = Astro.props

const resolvedGlass = resolveLumenGlass(glass, surface)
const { classList, passthrough } = resolveLumenAstroProps(rest, [
    'ui-toast',
    variant === 'destructive' && 'ui-toast--destructive',
    variant === 'success' && 'ui-toast--success',
    variant === 'warning' && 'ui-toast--warning',
    resolvedGlass && 'ui-toast--glass',
    glass === 'subtle' && 'ui-glass-subtle',
    glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<aside
  data-surface={resolvedGlass ? 'glass' : 'default'}
  data-ui-toast
  data-variant={variant}
  aria-live={ariaLive ?? (variant === 'destructive' ? 'assertive' : 'polite')}
  class:list={classList}
  role={role ?? (variant === 'destructive' ? 'alert' : 'status')}
  {...passthrough}
>
  <slot />
</aside>

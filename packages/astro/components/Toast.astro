---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'aside'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  variant?: 'default' | 'destructive' | 'success' | 'warning'
}

const {
  'aria-live': ariaLive,
  class: classProp = '',
  className = '',
  glass = false,
  role,
  variant = 'default',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-toast',
  variant === 'destructive' && 'ui-toast--destructive',
  variant === 'success' && 'ui-toast--success',
  variant === 'warning' && 'ui-toast--warning',
  glass && 'ui-toast--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<aside
  data-surface={glass ? 'glass' : 'default'}
  data-ui-toast
  data-variant={variant}
  aria-live={ariaLive ?? (variant === 'destructive' ? 'assertive' : 'polite')}
  class:list={classList}
  role={role ?? (variant === 'destructive' ? 'alert' : 'status')}
  {...passthrough}
>
  <slot />
</aside>

---
import type { HTMLAttributes } from 'astro/types'

import {
  createLumenBarGeometry,
  getLumenChartTicks,
  getLumenChartToneClassName,
  hasLumenChartData,
  type LumenBarChartLayout,
  type LumenChartOrientation,
  type LumenChartSeries,
  scaleLumenChartValue
} from '@santi020k/lumen-core'

import Chart from './Chart.astro'

interface Props extends HTMLAttributes<'figure'> {
  caption?: string
  categoryWidth?: number
  class?: string | null
  className?: string
  description?: string
  emptyLabel?: string
  formatCategory?: (category: number | string) => string
  formatValue?: (value: number) => string
  glass?: boolean | 'subtle' | 'strong'
  heading?: string
  layout?: LumenBarChartLayout
  orientation?: LumenChartOrientation
  presentation?: 'bare' | 'default'
  series: readonly LumenChartSeries[]
  showLegend?: boolean
  showTable?: boolean
}

const {
  caption,
  categoryWidth,
  class: classProp = '',
  className = '',
  description,
  emptyLabel = 'No chart data available.',
  formatCategory = String,
  formatValue = String,
  glass = false,
  heading,
  layout = 'grouped',
  orientation = 'vertical',
  series,
  showLegend = series.length > 1,
  showTable = true,
  ...rest
} = Astro.props

const geometry = createLumenBarGeometry(series, { categoryWidth, layout, orientation })
const hasData = hasLumenChartData(series)
const ticks = getLumenChartTicks(geometry.domain)
const categories = geometry.categories.map(category => category.category)
const valueFor = (item: LumenChartSeries, category: number | string) => item.data.find(datum => datum.x === category)?.y ?? null
const labelFor = (item: LumenChartSeries, category: number | string) => item.data.find(datum => datum.x === category)?.label

const formattedValueFor = (item: LumenChartSeries, category: number | string) => {
  const value = valueFor(item, category)

  return value === null ? 'Not available' : formatValue(value)
}

const categoryLabelFor = (category: number | string) => {
  const label = series.flatMap(item => item.data).find(datum => datum.x === category)?.xLabel

  return label ?? formatCategory(category)
}

const margin = orientation === 'horizontal' ?
  { bottom: 24, left: Math.max(64, Math.min(240, categoryWidth ?? 112)), right: 20, top: 16 } :
  { bottom: 52, left: 52, right: 16, top: 16 }
---

<Chart
  class:list={['ui-bar-chart', classProp, className]}
  {caption}
  {description}
  {glass}
  {heading}
  {...rest}
>
  {
    showLegend && hasData && (
      <ul class="ui-chart__legend" aria-label="Chart legend">
        {series.map((item, index) => (
          <li class={getLumenChartToneClassName(item.tone, index)}>
            <span aria-hidden="true" />
            {item.label}
          </li>
        ))}
      </ul>
    )
  }
  {!hasData && <p class="ui-chart__empty" role="status">{emptyLabel}</p>}
  <div class="ui-chart__plot" hidden={!hasData}>
    <svg
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
      viewBox={`0 0 ${geometry.width} ${geometry.height}`}
    >
      <g class="ui-chart__grid">
        {
          ticks.map(tick => {
            const coordinate =
              orientation === 'horizontal' ?
                scaleLumenChartValue(
                  tick, geometry.domain, margin.left, geometry.width - margin.right
                ) :
                scaleLumenChartValue(
                  tick, geometry.domain, geometry.height - margin.bottom, margin.top
                )

            return orientation === 'horizontal' ?
              (
                <line
                  x1={coordinate}
                  x2={coordinate}
                  y1={margin.top}
                  y2={geometry.height - margin.bottom}
                />
              ) :
              (
                <line
                  x1={margin.left}
                  x2={geometry.width - margin.right}
                  y1={coordinate}
                  y2={coordinate}
                />
              )
          })
        }
      </g>
      <g class="ui-chart__axis-labels">
        {
          geometry.categories.map(category => (
            <text
              dominant-baseline={orientation === 'horizontal' ? 'middle' : undefined}
              text-anchor={orientation === 'horizontal' ? 'end' : 'middle'}
              x={category.x}
              y={category.y}
            >
              {String(category.label)}
            </text>
          ))
        }
      </g>
      <g class="ui-bar-chart__marks">
        {
          geometry.marks.map(mark => (
            <rect
              class={getLumenChartToneClassName(mark.tone)}
              height={mark.height}
              rx="4"
              width={mark.width}
              x={mark.x}
              y={mark.y}
            >
              <title>
                {`${categoryLabelFor(mark.category)} · ${mark.seriesLabel}: ${formatValue(mark.value)}`}
              </title>
            </rect>
          ))
        }
      </g>
    </svg>
  </div>
  {
    showTable && hasData && (
      <details class="ui-chart__data">
        <summary>View chart data</summary>
        <div>
          <table>
            <thead>
              <tr>
                <th scope="col">Category</th>
                {series.map(item => <th scope="col">{item.label}</th>)}
              </tr>
            </thead>
            <tbody>
              {categories.map(category => (
                <tr>
                  <th scope="row">{categoryLabelFor(category)}</th>
                  {series.map(item => (
                    <td>
                      {labelFor(item, category) ?? formattedValueFor(item, category)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )
  }
</Chart>

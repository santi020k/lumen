---
import type { HTMLAttributes } from 'astro/types'

import {   alignLumenChartSeries,
  createLumenBarGeometry,
createLumenChartDatumActivation,
  formatLumenChartSummary,
  getLumenChartCategories,
  getLumenChartCategoryLabel,
  getLumenChartCategoryTicks,
  getLumenChartTicks,
  getLumenChartToneClassName,
  hasLumenChartData,
  type LumenBarChartLayout,
  type LumenChartLabels,
  type LumenChartOrientation,
  type LumenChartSeries,
  resolveLumenChartLabels,
  scaleLumenChartValue
} from '@santi020k/lumen-core'

import { createChartDatumAction } from '../runtime/chart-actions'

import Chart from './Chart.astro'
import ChartDatumActions from './ChartDatumActions.astro'

interface Props extends HTMLAttributes<'figure'> {
  caption?: string
  categoryWidth?: number
  class?: string | null
  className?: string
  description?: string
  drilldown?: boolean
  emptyLabel?: string
  formatCategory?: (category: number | string) => string
  formatValue?: (value: number) => string
  glass?: boolean | 'subtle' | 'strong'
  heading?: string
  labels?: Partial<LumenChartLabels>
  layout?: LumenBarChartLayout
  orientation?: LumenChartOrientation
  presentation?: 'bare' | 'default'
  series: readonly LumenChartSeries[]
  showLegend?: boolean
  showTable?: boolean
  summary?: string
}

const {
  caption,
  categoryWidth,
  class: classProp = '',
  className = '',
  description,
  drilldown = false,
  emptyLabel,
  formatCategory,
  formatValue = String,
  glass = false,
  heading,
  labels,
  layout = 'grouped',
  orientation = 'vertical',
  series,
  showLegend = series.length > 1,
  showTable = true,
  summary: summaryProp,
  ...rest
} = Astro.props

const resolvedLabels = resolveLumenChartLabels(labels)
const categories = getLumenChartCategories(series)
const alignedSeries = series.map(item => alignLumenChartSeries(item, categories))
const summary = summaryProp ?? formatLumenChartSummary(alignedSeries, formatValue, resolvedLabels)

const geometry = createLumenBarGeometry(alignedSeries, {
  width: 480,
  height: 240,
  categoryWidth: categoryWidth ?? 160,
  ...(formatCategory === undefined ? {} : { formatCategory }),
  formatValue,
  layout,
  orientation
})

const hasData = hasLumenChartData(alignedSeries)
const ticks = getLumenChartTicks(geometry.domain)
const margin = geometry.margin

const categoryTicks = getLumenChartCategoryTicks(geometry.categories.map(category => String(category.label)), {
  end: geometry.width - margin.right,
  positions: geometry.categories.map(category => category.x),
  start: margin.left
})

const valueTicks = getLumenChartCategoryTicks(ticks.map(tick => formatValue(tick)), {
  end: geometry.width - margin.right,
  minimumGap: 48,
  positions: ticks.map(tick => scaleLumenChartValue(tick, geometry.domain, margin.left, geometry.width - margin.right)),
  start: margin.left
})

const datumFor = (item: LumenChartSeries, category: number | string) => (
  item.data.find(datum => datum.x === category)
)

const valueFor = (item: LumenChartSeries, category: number | string) => (
  datumFor(item, category)?.y ?? null
)

const labelFor = (item: LumenChartSeries, category: number | string) => (
  datumFor(item, category)?.label
)

const formattedValueFor = (item: LumenChartSeries, category: number | string) => {
  const value = valueFor(item, category)

  return value === null || !Number.isFinite(value) ? resolvedLabels.notAvailable : formatValue(value)
}

const categoryLabelFor = (category: number | string) => getLumenChartCategoryLabel(alignedSeries, category, formatCategory, 'detail')

const datumActions = drilldown ?
geometry.marks.map(mark => {
  const item = alignedSeries.find(candidate => candidate.id === mark.seriesId)
  const datum = item?.data.find(candidate => candidate.x === mark.category)

  return item && datum ?
createChartDatumAction(
    createLumenChartDatumActivation(item.id, datum),
    `${categoryLabelFor(mark.category)} · ${mark.seriesLabel}: ${formatValue(mark.value)}`,
    resolvedLabels
  ) :
null
}) :
[]

---

<Chart
  class:list={['ui-bar-chart', classProp, className]}
  {caption}
  {description}
  {glass}
  {heading}
  {summary}
  {...rest}
  data-ui-chart-activation={drilldown || undefined}
>
  {
    showLegend && hasData && (
      <ul class="ui-chart__legend" aria-label={resolvedLabels.chartLegend}>
        {series.map((item, index) => (
          <li class={getLumenChartToneClassName(item.tone, index)}>
            <span aria-hidden="true" />
            {item.label}
          </li>
        ))}
      </ul>
    )
  }
  {!hasData && <p class="ui-chart__empty" role="status">{emptyLabel ?? resolvedLabels.empty}</p>}
  <div aria-label={resolvedLabels.chartData} class="ui-chart__plot" role="region" tabindex="0" hidden={!hasData}>
    <svg
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
      viewBox={`0 0 ${geometry.width} ${geometry.height}`}
    >
      <g class="ui-chart__grid">
        {
          ticks.map(tick => {
            const coordinate =
              orientation === 'horizontal' ?
                scaleLumenChartValue(
                  tick, geometry.domain, margin.left, geometry.width - margin.right
                ) :
                scaleLumenChartValue(
                  tick, geometry.domain, geometry.height - margin.bottom, margin.top
                )

            return orientation === 'horizontal' ?
              (
                <line
                  x1={coordinate}
                  x2={coordinate}
                  y1={margin.top}
                  y2={geometry.height - margin.bottom}
                />
              ) :
              (
                <>
                  <line x1={margin.left} x2={geometry.width - margin.right} y1={coordinate} y2={coordinate} />
                  <text x={margin.left - 8} y={coordinate}>{formatValue(tick)}</text>
                </>
              )
          })
        }
      </g>
      <g class="ui-chart__axis-labels">
        {
          orientation === 'horizontal' ?
geometry.categories.map(category => (
            <text dominant-baseline="middle" text-anchor="end" x={category.x} y={category.y}>
              {getLumenChartCategoryTicks([String(category.label)], { end: margin.left - 16, start: 0 })[0]?.label}
            </text>
          )) :
categoryTicks.map(tick => (
            <text text-anchor={tick.textAnchor} x={tick.position} y={geometry.height - 20}>{tick.label}</text>
          ))
        }
      </g>
      {orientation === 'horizontal' && (
<g class="ui-chart__axis-labels">{valueTicks.map(tick => (
        <text text-anchor={tick.textAnchor} x={tick.position} y={geometry.height - 6}>{tick.label}</text>
      ))}</g>
)}
      <g class="ui-bar-chart__marks">
        {
          geometry.marks.map((mark, index) => (
            <rect
              class={getLumenChartToneClassName(mark.tone)}
              height={mark.height}
              data-ui-chart-datum={datumActions[index]?.serialized}
              rx="4"
              width={mark.width}
              x={mark.x}
              y={mark.y}
            >
              <title>
                {`${categoryLabelFor(mark.category)} · ${mark.seriesLabel}: ${formatValue(mark.value)}`}
              </title>
            </rect>
          ))
        }
{drilldown && geometry.marks.map((mark, index) => (
  <rect
class="ui-chart__datum-hit"
width={Math.max(12, mark.width)}
height={Math.max(12, mark.height)}
    x={mark.x - Math.max(0, 12 - mark.width) / 2}
y={mark.y - Math.max(0, 12 - mark.height) / 2}
    data-ui-chart-datum={datumActions[index]?.serialized}
  />
))}
      </g>
    </svg>
  </div>
  {
    showTable && hasData && (
      <details class="ui-chart__data">
        <summary>{resolvedLabels.viewData}</summary>
        <div role="group" tabindex="0" aria-label={resolvedLabels.chartData}>
          <table>
            <thead>
              <tr>
                <th scope="col">{resolvedLabels.category}</th>
                {series.map(item => <th scope="col">{item.label}</th>)}
              </tr>
            </thead>
            <tbody>
              {categories.map(category => (
                <tr>
                  <th scope="row">{categoryLabelFor(category)}</th>
                  {alignedSeries.map(item => (
                    <td>
                      {labelFor(item, category) ?? formattedValueFor(item, category)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )
  }
  {drilldown && <ChartDatumActions actions={datumActions} label={resolvedLabels.exploreData} />}
</Chart>

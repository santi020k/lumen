---
import type { HTMLAttributes } from 'astro/types'

import type { LumenFormStatus } from '@santi020k/lumen-core'
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'form'> {
  class?: string | null
  className?: string
  enhance?: boolean
  status?: LumenFormStatus
}

const {
  class: classProp = '',
  className = '',
  enhance = true,
  status = 'idle',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-form'], classProp, className)
---

<form
  aria-busy={status === 'submitting' ? 'true' : undefined}
  class:list={classList}
  data-status={status}
  data-ui-form={enhance ? true : undefined}
  {...passthrough}
>
  <slot />
</form>

---
/**
 * Select is an alias of NativeSelect: both render a styled native <select>.
 * Keeping a single implementation avoids the two files drifting apart.
 */
import type { ComponentProps } from 'astro/types'

import NativeSelect from './NativeSelect.astro'

type Props = ComponentProps<typeof NativeSelect>

const props = Astro.props as Props
---

<NativeSelect {...props}><slot /></NativeSelect>

---
import type { HTMLAttributes } from 'astro/types'

interface Option {
  disabled?: boolean
  label: string
  value: string
}

type SelectOption = Option | string

interface Props extends HTMLAttributes<'select'> {
  class?: string
  className?: string
  options?: SelectOption[]
  placeholder?: string
}

const { class: classProp = '', className = '', options = [], placeholder, ...rest } = Astro.props
const hasValue = Object.hasOwn(rest, 'value')
const normalizedOptions = options.map(option =>
  typeof option === 'string' ? { label: option, value: option } : option
)
const passthrough = rest as Record<string, unknown>
---

<select class:list={['ui-select', classProp, className]} {...passthrough}>
  {placeholder && <option disabled selected={!hasValue} value="">{placeholder}</option>}
  <slot />
  {normalizedOptions.map(option => (
    <option disabled={option.disabled} value={option.value}>{option.label}</option>
  ))}
</select>

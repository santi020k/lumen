---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
}

const { class: classProp = '', className = '', ...rest } = Astro.props
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-date-range-picker'
], classProp, className)
---

<div class:list={classList} data-ui-date-range-picker {...passthrough}>
  <slot />
</div>

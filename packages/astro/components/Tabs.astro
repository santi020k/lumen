---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  initialValue?: string
  storageKey?: string
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  initialValue,
  storageKey,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
    'ui-tabs',
    glass && 'ui-tabs--glass',
    glass === 'subtle' && 'ui-glass-subtle',
    glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<div
  data-initial-value={initialValue}
  data-storage-key={storageKey}
  data-ui-tabs
  class:list={classList}
  {...passthrough}
>
  <slot />
</div>

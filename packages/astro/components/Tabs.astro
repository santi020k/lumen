---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  glass?: boolean
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<div
  data-ui-tabs
  class:list={[
    'ui-tabs',
    glass && 'ui-tabs--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</div>

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  ratio?: number | string
}

const {
  class: classProp = '',
  className = '',
  ratio = '16 / 9',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
const ratioValue = typeof ratio === 'number' && Number.isFinite(ratio)
  ? String(ratio)
  : typeof ratio === 'string'
    ? ratio.trim()
    : ''
const isValidRatio =
  /^\d+(\.\d+)?(\s*\/\s*\d+(\.\d+)?)?$/.test(ratioValue) &&
  ratioValue.split('/').every(value => Number(value.trim()) > 0)
const safeRatio = isValidRatio ? ratioValue : '16 / 9'
---

<div
  style={`aspect-ratio: ${safeRatio}`}
  class:list={[
    'ui-aspect-ratio',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</div>

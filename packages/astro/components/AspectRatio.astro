---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  ratio?: number | string
}

const {
  class: classProp = '',
  className = '',
  ratio = '16 / 9',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-aspect-ratio'
], classProp, className)

let ratioValue = ''

if (typeof ratio === 'number' && Number.isFinite(ratio)) ratioValue = String(ratio)
else if (typeof ratio === 'string') ratioValue = ratio.trim()

const isValidRatio =
  /^\d+(\.\d+)?(\s*\/\s*\d+(\.\d+)?)?$/.test(ratioValue) &&
  ratioValue.split('/').every(value => Number(value.trim()) > 0)

const safeRatio = isValidRatio ? ratioValue : '16 / 9'
---

<div
  style={`aspect-ratio: ${safeRatio}`}
  class:list={classList}
  {...passthrough}
>
  <slot />
</div>

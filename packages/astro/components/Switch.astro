---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

type HTMLInputAttributes = HTMLAttributes<'input'>

interface Props extends Omit<HTMLInputAttributes, 'type'> {
  class?: string | null
  className?: string
}

const { class: classProp = '', className = '', role = 'switch', ...rest } = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-switch'
], classProp, className)
---

<input
  class:list={classList}
  role={role}
  type="checkbox"
  {...passthrough}
/>

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'dialog'> {
  class?: string
  className?: string
  glass?: boolean
  surface?: 'default' | 'glass'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  surface = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
const resolvedSurface = glass || surface === 'glass' ? 'glass' : surface
---

<dialog
  data-surface={resolvedSurface}
  data-ui-alert-dialog
  class:list={[
    'ui-dialog ui-alert-dialog',
    resolvedSurface === 'glass' && 'ui-dialog--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</dialog>

---
import type { HTMLAttributes } from 'astro/types'

import {
  createLumenLineChartModel,
  formatLumenChartSummary,
  getLumenChartCategoryLabel,
  getLumenChartToneClassName,
  hasLumenChartData,
  type LumenChartLabels,
  type LumenChartSeries,
  type LumenLineChartOptions,
  resolveLumenChartLabels,
  resolveLumenChartTone,
  scaleLumenChartValue
} from '@santi020k/lumen-core'

import ChartInspection from '../internal/ChartInspection.astro'

import Button from './Button.astro'
import Chart from './Chart.astro'

interface Props extends HTMLAttributes<'figure'>, LumenLineChartOptions {
  interactive?: boolean
  syncGroup?: string
  area?: boolean
  caption?: string
  class?: string | null
  className?: string
  description?: string
  emptyLabel?: string
  formatCategory?: (category: number | string) => string
  formatValue?: (value: number) => string
  glass?: boolean | 'subtle' | 'strong'
  heading?: string
  labels?: Partial<LumenChartLabels>
  markers?: 'all' | 'auto' | 'none' | boolean | number
  presentation?: 'bare' | 'default'
  referenceValue?: number
  series: readonly LumenChartSeries[]
  showLegend?: boolean
  showTable?: boolean
  summary?: string
}

const {
  area = false,
  annotations = [],
  domain: requestedDomain,
  height: requestedHeight,
  width: requestedWidth,
  xDomain,
  xScale = 'categorical',
  interactive = false,
  syncGroup,
  caption,
  class: classProp = '',
  className = '',
  description,
  emptyLabel,
  formatCategory,
  formatValue = String,
  glass = false,
  heading,
  labels,
  markers = 'auto',
  referenceValue,
  series,
  showLegend = series.length > 1,
  showTable = true,
  summary: summaryProp,
  ...rest
} = Astro.props

const resolvedLabels = resolveLumenChartLabels(labels)

const model = createLumenLineChartModel(series, {
  annotations,
xScale,
  ...(requestedDomain ? { domain: requestedDomain } : {}),
  ...(requestedHeight === undefined ? {} : { height: requestedHeight }),
  ...(requestedWidth === undefined ? {} : { width: requestedWidth }),
  ...(xDomain ? { xDomain } : {}),
  ...(referenceValue === undefined ? {} : { referenceValue }),
  ...(formatCategory ? { formatCategory } : {}),
  formatValue
})

const { width, height, padding, paddingLeft, categories, categoryTicks, domain, geometries, ticks, series: alignedSeries } = model
const hasData = hasLumenChartData(alignedSeries)
const summary = summaryProp ?? formatLumenChartSummary(alignedSeries, formatValue, resolvedLabels)
let markerStep = 1

if (markers === false || markers === 'none') markerStep = Number.POSITIVE_INFINITY
else if (typeof markers === 'number') markerStep = Math.max(1, Math.round(markers))
else if (markers === 'auto') markerStep = Math.max(1, Math.ceil(categories.length / 24))

const valueFor = (item: LumenChartSeries, category: number | string) => item.data.find(datum => datum.x === category)
const categoryLabelFor = (category: number | string) => getLumenChartCategoryLabel(alignedSeries, category, formatCategory, 'detail')

const referenceY =
  referenceValue === undefined ?
    undefined :
    scaleLumenChartValue(referenceValue, domain, height - padding, padding)
---

<Chart
  class:list={['ui-line-chart', classProp, className]}
  {caption}
  {description}
  {glass}
  {heading}
  {summary}
  data-ui-chart-interactive={interactive || undefined}
  data-ui-chart-sync={syncGroup}
  {...rest}
>
  {
    showLegend && hasData && (
      <ul class="ui-chart__legend" aria-label={resolvedLabels.chartLegend}>
        {series.map((item, index) => (
          <li class={getLumenChartToneClassName(item.tone, index)}>
            {interactive ? <Button aria-pressed="true" data-ui-chart-toggle={item.id} disabled size="sm" variant="ghost">{item.label}</Button> : <><span aria-hidden="true" />{item.label}</>}
          </li>
        ))}
      </ul>
    )
  }
  {!hasData && <p class="ui-chart__empty" role="status">{emptyLabel ?? resolvedLabels.empty}</p>}
  <div
aria-label={rest['aria-label'] ?? heading ?? resolvedLabels.chartData}
class="ui-chart__plot"
data-ui-chart-interaction-plot={interactive || undefined}
role="region"
tabindex="0"
hidden={!hasData}
  >
    <svg
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
      viewBox={`0 0 ${width} ${height}`}
    >
      <g class="ui-chart__grid">
        {
          ticks.map(tick => {
            const y = scaleLumenChartValue(
              tick, domain, height - padding, padding
            )

            return (
              <>
                <line x1={paddingLeft} x2={width - padding} y1={y} y2={y} />
                <text x={paddingLeft - 8} y={y}>
                  {formatValue(tick)}
                </text>
              </>
            )
          })
        }
      </g>
      <g class="ui-chart__axis-labels">
        {
          categoryTicks.map(tick => (
            <text text-anchor={tick.textAnchor} x={tick.position} y={height - 14}>
              {tick.label}
            </text>
          ))
        }
      </g>
      <svg
x={paddingLeft}
y={padding}
width={width - padding - paddingLeft}
height={height - 2 * padding}
        viewBox={`${paddingLeft} ${padding} ${width - padding - paddingLeft} ${height - 2 * padding}`}
        overflow="hidden"
      >
      {
        referenceY !== undefined && (
          <line
            class="ui-chart__reference"
            x1={paddingLeft}
            x2={width - padding}
            y1={referenceY}
            y2={referenceY}
          />
        )
      }
      {
        geometries.map((geometry, index) => {
          const item = alignedSeries[index]

          if (!item) return null

          const tone = resolveLumenChartTone(item.tone, index)

          return (
            <g
data-ui-chart-series={item.id}
class:list={['ui-line-chart__series', getLumenChartToneClassName(tone)]}
            >
              {area &&
                geometry.areaPaths.map(path => (
                  <path class="ui-line-chart__area" d={path} />
                ))}
              <path class="ui-line-chart__line" d={geometry.path} />
              {Number.isFinite(markerStep) &&
                geometry.points.map((point, pointIndex) => pointIndex % markerStep === 0 && (
                  <circle
                    class="ui-line-chart__point"
                    cx={point.xCoordinate}
                    cy={point.yCoordinate}
                    r="3"
                  >
                    <title>
                      {`${categoryLabelFor(point.x)} · ${item.label}: ${formatValue(point.y ?? 0)}`}
                    </title>
                  </circle>
                ))}
            </g>
          )
        })
      }
      </svg>
      {model.annotationMarks.map(mark => (
<g class:list={['ui-chart__annotation', getLumenChartToneClassName(mark.tone)]}>
        {mark.axis === 'x' ? <><line x1={mark.coordinate} x2={mark.coordinate} y1={padding} y2={height - padding} /><text x={mark.coordinate + 4} y={padding - 8}>{mark.label}</text></> : <><line x1={paddingLeft} x2={width - padding} y1={mark.coordinate} y2={mark.coordinate} /><text text-anchor="end" x={width - padding} y={mark.coordinate - 8}>{mark.label}</text></>}
      </g>
))}
      {interactive && <line class="ui-chart__crosshair" data-ui-chart-crosshair style="display: none" y1={padding} y2={height - padding} />}
    </svg>
  </div>
  {model.annotationMarks.length > 0 && <ul class="ui-sr-only">{model.annotationMarks.map(mark => <li>{mark.label}: {mark.axis === 'x' ? categoryLabelFor(mark.value) : formatValue(Number(mark.value))}</li>)}</ul>}
  {interactive && hasData && <ChartInspection {model} {formatCategory} {formatValue} labels={resolvedLabels} />}
  {
    showTable && hasData && (
      <details class="ui-chart__data">
        <summary>{resolvedLabels.viewData}</summary>
        <div>
          <table>
            <thead>
              <tr>
                <th scope="col">{resolvedLabels.category}</th>
                {series.map(item => <th scope="col">{item.label}</th>)}
              </tr>
            </thead>
            <tbody>
              {categories.map(category => (
                <tr>
                  <th scope="row">{categoryLabelFor(category)}</th>
                  {alignedSeries.map(item => {
                    const datum = valueFor(item, category)

                    return (
                      <td>
                        {datum?.label ??
                          (datum?.y === undefined || datum.y === null || !Number.isFinite(datum.y) ?
                            resolvedLabels.notAvailable :
                            formatValue(datum.y))}
                      </td>
                    )
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )
  }
</Chart>

---
import type { HTMLAttributes } from 'astro/types'

import {   alignLumenChartSeries,
createLumenChartDatumActivation,
  createLumenLineGeometry,
  formatLumenChartSummary,
  getLumenChartAxisPadding,
  getLumenChartCategories,
  getLumenChartCategoryLabel,
  getLumenChartCategoryTicks,
  getLumenChartDomain,
  getLumenChartTicks,
  getLumenChartToneClassName,
  hasLumenChartData,
  type LumenChartLabels,
  type LumenChartSeries,
  resolveLumenChartLabels,
  resolveLumenChartTone,
  scaleLumenChartValue
} from '@santi020k/lumen-core'

import { createChartDatumAction } from '../runtime/chart-actions'

import Chart from './Chart.astro'
import ChartDatumActions from './ChartDatumActions.astro'

interface Props extends HTMLAttributes<'figure'> {
  area?: boolean
  caption?: string
  class?: string | null
  className?: string
  description?: string
  drilldown?: boolean
  emptyLabel?: string
  formatCategory?: (category: number | string) => string
  formatValue?: (value: number) => string
  glass?: boolean | 'subtle' | 'strong'
  heading?: string
  labels?: Partial<LumenChartLabels>
  markers?: 'all' | 'auto' | 'none' | boolean | number
  presentation?: 'bare' | 'default'
  referenceValue?: number
  series: readonly LumenChartSeries[]
  showLegend?: boolean
  showTable?: boolean
  summary?: string
}

const {
  area = false,
  caption,
  class: classProp = '',
  className = '',
  description,
  drilldown = false,
  emptyLabel,
  formatCategory,
  formatValue = String,
  glass = false,
  heading,
  labels,
  markers = 'auto',
  referenceValue,
  series,
  showLegend = series.length > 1,
  showTable = true,
  summary: summaryProp,
  ...rest
} = Astro.props

const resolvedLabels = resolveLumenChartLabels(labels)
const width = 640
const height = 320
const padding = 44
const categories = getLumenChartCategories(series)
const alignedSeries = series.map(item => alignLumenChartSeries(item, categories))
const hasData = hasLumenChartData(alignedSeries)
const summary = summaryProp ?? formatLumenChartSummary(alignedSeries, formatValue, resolvedLabels)

const domain = getLumenChartDomain([
  ...alignedSeries.flatMap(item => item.data.map(datum => datum.y)),
  referenceValue ?? null
], false)

const ticks = getLumenChartTicks(domain)
const paddingLeft = getLumenChartAxisPadding(ticks.map(tick => formatValue(tick)))

const geometries = alignedSeries.map(item => createLumenLineGeometry(item.data, {
  domain,
  height,
  includeZero: false,
  padding,
  paddingLeft,
  width
}))

const categoryTicks = getLumenChartCategoryTicks(
  categories.map(category => getLumenChartCategoryLabel(alignedSeries, category, formatCategory)),
  { end: width - padding, start: paddingLeft }
)

let markerStep = 1

if (markers === false || markers === 'none') markerStep = Number.POSITIVE_INFINITY
else if (typeof markers === 'number') markerStep = Math.max(1, Math.round(markers))
else if (markers === 'auto') markerStep = Math.max(1, Math.ceil(categories.length / 24))

const valueFor = (item: LumenChartSeries, category: number | string) => item.data.find(datum => datum.x === category)
const categoryLabelFor = (category: number | string) => getLumenChartCategoryLabel(alignedSeries, category, formatCategory, 'detail')

const referenceY =
  referenceValue === undefined ?
    undefined :
    scaleLumenChartValue(referenceValue, domain, height - padding, padding)

const pointActions = drilldown ?
geometries.map((geometry, index) => {
  const item = alignedSeries[index]

  return geometry.points.map(point => item ?
createChartDatumAction(
    createLumenChartDatumActivation(item.id, point),
    `${categoryLabelFor(point.x)} · ${item.label}: ${formatValue(point.y ?? 0)}`,
    resolvedLabels
  ) :
null)
}) :
[]

const datumActions = pointActions.flat()

---

<Chart
  class:list={['ui-line-chart', classProp, className]}
  {caption}
  {description}
  {glass}
  {heading}
  {summary}
  {...rest}
  data-ui-chart-activation={drilldown || undefined}
>
  {
    showLegend && hasData && (
      <ul class="ui-chart__legend" aria-label={resolvedLabels.chartLegend}>
        {series.map((item, index) => (
          <li class={getLumenChartToneClassName(item.tone, index)}>
            <span aria-hidden="true" />
            {item.label}
          </li>
        ))}
      </ul>
    )
  }
  {!hasData && <p class="ui-chart__empty" role="status">{emptyLabel ?? resolvedLabels.empty}</p>}
  <div aria-label={resolvedLabels.chartData} class="ui-chart__plot" role="region" tabindex="0" hidden={!hasData}>
    <svg
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
      viewBox={`0 0 ${width} ${height}`}
    >
      <g class="ui-chart__grid">
        {
          ticks.map(tick => {
            const y = scaleLumenChartValue(
              tick, domain, height - padding, padding
            )

            return (
              <>
                <line x1={paddingLeft} x2={width - padding} y1={y} y2={y} />
                <text x={paddingLeft - 8} y={y}>
                  {formatValue(tick)}
                </text>
              </>
            )
          })
        }
      </g>
      <g class="ui-chart__axis-labels">
        {
          categoryTicks.map(tick => (
            <text text-anchor={tick.textAnchor} x={tick.position} y={height - 14}>
              {tick.label}
            </text>
          ))
        }
      </g>
      {
        referenceY !== undefined && (
          <line
            class="ui-chart__reference"
            x1={paddingLeft}
            x2={width - padding}
            y1={referenceY}
            y2={referenceY}
          />
        )
      }
      {
        geometries.map((geometry, index) => {
          const item = alignedSeries[index]

          if (!item) return null

          const tone = resolveLumenChartTone(item.tone, index)

          return (
            <g class:list={['ui-line-chart__series', getLumenChartToneClassName(tone)]}>
              {area &&
                geometry.areaPaths.map(path => (
                  <path class="ui-line-chart__area" d={path} />
                ))}
              <path class="ui-line-chart__line" d={geometry.path} />
              {Number.isFinite(markerStep) &&
                geometry.points.map((point, pointIndex) => pointIndex % markerStep === 0 && (
                  <circle
                    data-ui-chart-datum={pointActions[index]?.[pointIndex]?.serialized}
                    class="ui-line-chart__point"
                    cx={point.xCoordinate}
                    cy={point.yCoordinate}
                    r="3"
                  >
                    <title>
                      {`${categoryLabelFor(point.x)} · ${item.label}: ${formatValue(point.y ?? 0)}`}
                    </title>
                  </circle>
                ))}
              {drilldown && geometry.points.map((point, pointIndex) => (
                <circle
class="ui-chart__datum-hit"
cx={point.xCoordinate}
cy={point.yCoordinate}
r="10"
                  data-ui-chart-datum={pointActions[index]?.[pointIndex]?.serialized}
                />
              ))}
            </g>
          )
        })
      }
    </svg>
  </div>
  {
    showTable && hasData && (
      <details class="ui-chart__data">
        <summary>{resolvedLabels.viewData}</summary>
        <div>
          <table>
            <thead>
              <tr>
                <th scope="col">{resolvedLabels.category}</th>
                {series.map(item => <th scope="col">{item.label}</th>)}
              </tr>
            </thead>
            <tbody>
              {categories.map(category => (
                <tr>
                  <th scope="row">{categoryLabelFor(category)}</th>
                  {alignedSeries.map(item => {
                    const datum = valueFor(item, category)

                    return (
                      <td>
                        {datum?.label ??
                          (datum?.y === undefined || datum.y === null || !Number.isFinite(datum.y) ?
                            resolvedLabels.notAvailable :
                            formatValue(datum.y))}
                      </td>
                    )
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )
  }
  {drilldown && <ChartDatumActions actions={datumActions} label={resolvedLabels.exploreData} />}
</Chart>

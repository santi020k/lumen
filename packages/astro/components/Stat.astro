---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  label?: string
  value?: string
}

const {
  class: classProp = '',
  className = '',
  label,
  value,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-stat'
], classProp, className)
---

<div
  class:list={classList}
  {...passthrough}
>
  {label && <div class="ui-stat-label">{label}</div>}
  {value && <div class="ui-stat-value">{value}</div>}
  <slot />
</div>

<style is:global>
  .ui-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    background: var(--ui-surface);
    border: 1px solid var(--ui-line);
    border-radius: 0.5rem;
  }
  .ui-stat-label {
    font-size: 0.875rem;
    color: var(--ui-ink-muted);
  }
  .ui-stat-value {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ui-ink);
  }
</style>

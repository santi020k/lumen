---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  label?: string
  value?: string
}

const {
  class: classProp = '',
  className = '',
  label,
  value,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-stat'
], classProp, className)
---

<div
  class:list={classList}
  {...passthrough}
>
  {label && <div class="ui-stat-label">{label}</div>}
  {value && <div class="ui-stat-value">{value}</div>}
  <slot />
</div>


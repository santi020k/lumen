---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  as?: 'article' | 'div' | 'section'
  class?: string | null
  className?: string
  label?: string
  value?: string
  variant?: 'accent' | 'default' | 'glass'
}

const {
  as: Tag = 'div',
  class: classProp = '',
  className = '',
  label,
  value,
  variant = 'default',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-stat',
  variant !== 'default' && `ui-stat--${variant}`
], classProp, className)
---

<Tag
  class:list={classList}
  data-variant={variant}
  {...passthrough}
>
  {label && <div class="ui-stat-label">{label}</div>}
  {value && <div class="ui-stat-value">{value}</div>}
  <slot />
</Tag>

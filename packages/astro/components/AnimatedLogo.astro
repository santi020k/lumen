---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'span'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-animated-logo'
], classProp, className)
---

<span
  class:list={classList}
  data-ui-animated-logo
  {...passthrough}
>
  <slot />
</span>

---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/separator.css'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'hr'> {
  class?: string | null
  className?: string
  orientation?: 'horizontal' | 'vertical'
}

const {
  class: classProp = '',
  className = '',
  orientation = 'horizontal',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-separator',
  orientation === 'horizontal' && 'ui-separator--horizontal',
  orientation === 'vertical' && 'ui-separator--vertical'
], classProp, className)
---

<hr
  aria-orientation={orientation}
  class:list={classList}
  data-orientation={orientation}
  {...passthrough}
/>

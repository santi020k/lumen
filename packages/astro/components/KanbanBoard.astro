---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'section'> {
  class?: string | null
  className?: string
}

const {
  class: classProp = '',
  className = '',
  tabindex = '0',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-kanban-board',
  'ui-kanban'
], classProp, className)
---

<section
  aria-orientation="horizontal"
  class:list={classList}
  data-ui-kanban
  tabindex={tabindex}
  {...passthrough}
>
  <slot />
</section>

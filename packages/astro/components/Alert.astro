---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'aside'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  variant?: 'default' | 'destructive' | 'success' | 'warning'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  variant = 'default',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-alert',
  variant === 'destructive' && 'ui-alert--destructive',
  variant === 'success' && 'ui-alert--success',
  variant === 'warning' && 'ui-alert--warning',
  glass && 'ui-alert--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<aside
  data-variant={variant}
  class:list={classList}
  {...passthrough}
>
  <slot />
</aside>

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'aside'> {
  class?: string
  className?: string
  variant?: 'default' | 'destructive' | 'success' | 'warning'
}

const {
  class: classProp = '',
  className = '',
  variant = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<aside
  data-variant={variant}
  class:list={[
    'ui-alert',
    variant === 'destructive' && 'ui-alert--destructive',
    variant === 'success' && 'ui-alert--success',
    variant === 'warning' && 'ui-alert--warning',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</aside>

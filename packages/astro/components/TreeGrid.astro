---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  glass?: boolean | 'subtle' | 'strong'
}

const { class: classProp = '', className = '', glass = false, ...rest } = Astro.props
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-tree-grid', glass && 'ui-tree-grid--glass', glass === 'subtle' && 'ui-glass-subtle', glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<div class:list={classList} role="treegrid" {...passthrough}>
  <slot />
</div>

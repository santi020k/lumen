---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  glass?: boolean | 'subtle' | 'strong'
}

const { class: classProp = '', className = '', glass = false, ...rest } = Astro.props
const passthrough = rest as Record<string, unknown>
---

<div class:list={['ui-tree-grid', glass && 'ui-tree-grid--glass', glass === 'subtle' && 'ui-glass-subtle', glass === 'strong' && 'ui-glass-strong', classProp, className]} role="treegrid" {...passthrough}>
  <slot />
</div>

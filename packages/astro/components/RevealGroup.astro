---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  animation?: 'fade' | 'slide-up' | 'scale'
  as?: 'div' | 'ol' | 'section' | 'ul'
  class?: string | null
  className?: string
  delay?: number
  duration?: 'fast' | 'standard' | 'slow'
  once?: boolean
  stagger?: number
  threshold?: number
}

const {
  animation = 'slide-up',
  as: Tag = 'div',
  class: classProp = '',
  className = '',
  delay = 0,
  duration = 'slow',
  once = true,
  stagger = 80,
  style,
  threshold = 0.15,
  ...rest
} = Astro.props

const safeDelay = Math.max(0, delay)
const safeStagger = Math.max(0, stagger)
const safeThreshold = Math.min(1, Math.max(0, threshold))

const motionStyle = [
  typeof style === 'string' ? style : '',
  `--ui-reveal-delay:${safeDelay}ms`,
  `--ui-reveal-stagger:${safeStagger}ms`
].filter(Boolean).join(';')

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-reveal-group',
  `ui-reveal-group-${animation}`,
  `ui-motion-duration-${duration}`
], classProp, className)
---

<Tag
  class:list={classList}
  data-ui-reveal-group
  data-ui-reveal-once={String(once)}
  data-ui-reveal-threshold={safeThreshold}
  style={motionStyle}
  {...passthrough}
>
  <slot />
</Tag>

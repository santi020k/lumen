---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  glass?: boolean | 'subtle' | 'strong'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<div
  data-ui-command
  class:list={[
    'ui-command',
    glass && 'ui-command--glass',
    glass === 'subtle' && 'ui-glass-subtle',
    glass === 'strong' && 'ui-glass-strong',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</div>

---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'input'>, 'type' | 'size'> {
  class?: string | null
  className?: string
  label?: string
  hint?: string
}

const {
  class: classProp = '',
  className = '',
  label = 'Choose a file or drag it here',
  hint,
  id,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-file-upload'
], classProp, className)
---

<label class:list={classList} data-ui-file-upload for={id}>
  <input class="ui-file-upload__input" data-ui-file-upload-input id={id} type="file" {...passthrough} />
  <svg
    aria-hidden="true"
    class="ui-file-upload__icon"
    fill="none"
    focusable="false"
    viewBox="0 0 24 24"
  >
    <path d="M12 16V4m0 0L8 8m4-4 4 4"></path>
    <path d="M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"></path>
  </svg>
  <span class="ui-file-upload__prompt">
    <slot>{label}</slot>
  </span>
  {hint && <span class="ui-file-upload__hint">{hint}</span>}
  <span aria-live="polite" class="ui-file-upload__files" data-ui-file-upload-files></span>
</label>

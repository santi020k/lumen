---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/code.css'

import { renderLumenCodeHtml, renderLumenIconSvg, resolveLumenAstroProps } from '@santi020k/lumen-core'

import ScrollCue from '../internal/ScrollCue.astro'

type CodeTheme = 'auto' | 'lumen' | 'santi020k'

type CodeVariant = 'block' | 'inline'

interface Props extends HTMLAttributes<'code'> {
  class?: string | null
  className?: string
  code?: string
  appearance?: 'default' | 'editorial'
  copy?: boolean
  codeLabel?: string
  copyLabel?: string
  copiedLabel?: string
  errorLabel?: string
  recoveryLabel?: string
  highlighted?: boolean
  label?: string
  language?: string
  scrollCue?: boolean | string
  theme?: CodeTheme
  variant?: CodeVariant
  wrap?: boolean
}

const {
  class: classProp = '',
  className = '',
  code,
  appearance = 'default',
  copy = false,
  codeLabel = 'Code example',
  copyLabel = 'Copy code to clipboard',
  copiedLabel = 'Code copied to clipboard',
  recoveryLabel,
  errorLabel = 'Could not copy code. Select and copy it manually.',
  highlighted = false,
  label,
  language,
  scrollCue = false,
  theme = 'auto',
  variant = 'inline',
  wrap = false,
  ...rest
} = Astro.props

const { classList: blockClassList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-code',
  'ui-code--block',
  appearance === 'editorial' && 'ui-code--editorial',
  wrap && 'ui-code--wrap'
], classProp, className)

const { classList: inlineClassList } = resolveLumenAstroProps(rest, [
  'ui-code',
  'ui-code--inline'
], classProp, className)

const shouldShowHeader = variant === 'block' && Boolean(copy || label || language)
const cueLabel = typeof scrollCue === 'string' ? scrollCue : 'Scroll horizontally to read more'
const showCue = Boolean(scrollCue) && !wrap
const hasCode = code !== undefined
const renderedCode = hasCode ? renderLumenCodeHtml(code, language) : ''
---

{variant === 'block' ?
  (
    <figure
      class:list={blockClassList}
      data-code-label={codeLabel}
      data-code-theme={theme}
      data-language={language}
      data-slot="code"
      data-ui-code
      data-ui-scroll-cue={showCue ? '' : undefined}
      {...passthrough}
    >
      {shouldShowHeader && (
        <figcaption class="ui-code__header">
          <Fragment set:html={renderLumenIconSvg('code-xml', { className: 'ui-code__symbol' })} />
          <span class="ui-code__dots" aria-hidden="true">
            <span class="ui-code__dot ui-code__dot--red"></span>
            <span class="ui-code__dot ui-code__dot--yellow"></span>
            <span class="ui-code__dot ui-code__dot--green"></span>
          </span>
          <span class="ui-code__meta">
            {language && <span class="ui-code__language">{language}</span>}
            {label && <span class="ui-code__label">{label}</span>}
          </span>
          {copy && (
            <button
              aria-label={copyLabel}
              class="ui-code__copy"
              data-copy-value={highlighted || recoveryLabel ? code : undefined}
              data-copy-label={copyLabel}
              data-copy-copied-label={copiedLabel}
              data-copy-error-label={errorLabel}
              data-copy-recovery-label={recoveryLabel}
              data-state="idle"
              title={copyLabel}
              data-ui-code-copy
              type="button"
            >
              <Fragment set:html={renderLumenIconSvg('copy', { className: 'ui-code__copy-icon' })} />
              <Fragment set:html={renderLumenIconSvg('check', { className: 'ui-code__check-icon' })} />
              {appearance === 'editorial' && (
<span class="ui-code__copy-text">
                <span data-slot="copy-idle">{copyLabel}</span>
                <span data-slot="copy-copied" hidden>{copiedLabel}</span>
                <span data-slot="copy-error" hidden>{errorLabel}</span>
              </span>
)}
            </button>
          )}
        </figcaption>
      )}
      {highlighted && <slot />}
      {!highlighted && hasCode && <pre aria-label={!wrap ? codeLabel : undefined} role={!wrap ? 'region' : undefined} tabindex={!wrap ? 0 : undefined}><code set:html={renderedCode}></code></pre>}
      {!highlighted && !hasCode && <pre aria-label={!wrap ? codeLabel : undefined} role={!wrap ? 'region' : undefined} tabindex={!wrap ? 0 : undefined}><code><slot /></code></pre>}
      {showCue && <ScrollCue label={cueLabel} />}
    </figure>
  ) :
  (
    <code
      class:list={inlineClassList}
      data-code-theme={theme}
      data-language={language}
      data-slot="code"
      {...passthrough}
    >
      {hasCode ? code : <slot />}
    </code>
  )}

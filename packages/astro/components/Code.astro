---
import type { HTMLAttributes } from 'astro/types'

type CodeTheme = 'auto' | 'lumen' | 'santi020k'
type CodeVariant = 'block' | 'inline'

interface Props extends HTMLAttributes<'code'> {
  class?: string
  className?: string
  copy?: boolean
  highlighted?: boolean
  label?: string
  language?: string
  theme?: CodeTheme
  variant?: CodeVariant
}

const {
  class: classProp = '',
  className = '',
  copy = false,
  highlighted = false,
  label,
  language,
  theme = 'auto',
  variant = 'inline',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
const shouldShowHeader = variant === 'block' && Boolean(copy || label || language)
---

{variant === 'block' ? (
  <figure
    class:list={[
      'ui-code',
      'ui-code--block',
      classProp,
      className
    ]}
    data-code-theme={theme}
    data-language={language}
    data-ui-code
    {...passthrough}
  >
    {shouldShowHeader && (
      <figcaption class="ui-code__header">
        <span class="ui-code__dots" aria-hidden="true">
          <span class="ui-code__dot ui-code__dot--red"></span>
          <span class="ui-code__dot ui-code__dot--yellow"></span>
          <span class="ui-code__dot ui-code__dot--green"></span>
        </span>
        <span class="ui-code__meta">
          {language && <span class="ui-code__language">{language}</span>}
          {label && <span class="ui-code__label">{label}</span>}
        </span>
        {copy && (
          <button
            aria-label="Copy code to clipboard"
            class="ui-code__copy"
            data-ui-code-copy
            type="button"
          >
            <svg
              aria-hidden="true"
              class="ui-code__copy-icon"
              fill="none"
              focusable="false"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect height="14" rx="2" ry="2" width="14" x="8" y="8"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <svg
              aria-hidden="true"
              class="ui-code__check-icon"
              fill="none"
              focusable="false"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </button>
        )}
      </figcaption>
    )}
    {highlighted ? (
      <slot />
    ) : (
      <pre><code><slot /></code></pre>
    )}
  </figure>
) : (
  <code
    class:list={[
      'ui-code',
      'ui-code--inline',
      classProp,
      className
    ]}
    data-code-theme={theme}
    data-language={language}
    {...passthrough}
  >
    <slot />
  </code>
)}

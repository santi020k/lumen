---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/tag-group.css'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
}

const { class: classProp = '', className = '', ...rest } = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-tag-group'
], classProp, className)
---

<div class:list={classList} role="list" {...passthrough}>
  <slot />
</div>

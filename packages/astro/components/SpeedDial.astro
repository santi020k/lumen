---
import type { HTMLAttributes } from 'astro/types'

import {
  renderLumenIconSvg,
  resolveLumenAstroProps
} from '@santi020k/lumen-core'

interface SpeedDialAction { icon?: string, label: string, value?: string }

interface Props extends HTMLAttributes<'div'> {
  actions?: SpeedDialAction[]
  class?: string | null
  className?: string
  defaultOpen?: boolean
  direction?: 'up' | 'down' | 'left' | 'right'
  label?: string
}

const {
  actions = [],
  class: classProp = '',
  className = '',
  defaultOpen = false,
  direction = 'up',
  label = 'Actions',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-speed-dial',
  `ui-speed-dial--${direction}`
], classProp, className)
---

<div
  class:list={classList}
  data-direction={direction}
  data-state={defaultOpen ? 'open' : 'closed'}
  data-ui-speed-dial
  {...passthrough}
>
  <button
    aria-expanded={defaultOpen ? 'true' : 'false'}
    aria-haspopup="menu"
    aria-label={label}
    class="ui-speed-dial__trigger"
    data-ui-speed-dial-trigger
    type="button"
  >
    <span aria-hidden="true" class="ui-speed-dial__icon"></span>
  </button>
  <menu aria-label={label} class="ui-speed-dial__actions" data-ui-speed-dial-actions role="menu">
    {actions.map((action, index) => (
      <li role="presentation" style={`--ui-speed-dial-index: ${index}`}>
        <button
          aria-label={action.label}
          class="ui-speed-dial__action"
          data-icon={action.icon}
          data-value={action.value ?? action.label}
          role="menuitem"
          type="button"
        >
          {action.icon && (
            <span
              aria-hidden="true"
              class="ui-speed-dial__action-icon ui-icon"
              set:html={renderLumenIconSvg(action.icon)}
            />
          )}
          <span class="ui-speed-dial__action-label">{action.label}</span>
        </button>
      </li>
    ))}
    <slot />
  </menu>
</div>

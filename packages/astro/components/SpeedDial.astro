---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

type SpeedDialAction = { icon?: string; label: string; value?: string }

interface Props extends HTMLAttributes<'div'> {
  actions?: SpeedDialAction[]
  class?: string
  className?: string
  direction?: 'up' | 'down' | 'left' | 'right'
  label?: string
}

const {
  actions = [],
  class: classProp = '',
  className = '',
  direction = 'up',
  label = 'Actions',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-speed-dial',
  `ui-speed-dial--${direction}`
], classProp, className)
---

<div class:list={classList} data-direction={direction} data-ui-speed-dial {...passthrough}>
  <button aria-expanded="false" aria-label={label} class="ui-speed-dial__trigger" data-ui-speed-dial-trigger type="button">
    <span aria-hidden="true" class="ui-speed-dial__icon"></span>
  </button>
  <menu class="ui-speed-dial__actions" data-ui-speed-dial-actions>
    {actions.map(action => (
      <li>
        <button
          aria-label={action.label}
          class="ui-speed-dial__action"
          data-icon={action.icon}
          data-value={action.value ?? action.label}
          type="button"
        >
          <span class="ui-speed-dial__action-label">{action.label}</span>
        </button>
      </li>
    ))}
    <slot />
  </menu>
</div>

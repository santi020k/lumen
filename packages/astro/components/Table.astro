---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import ScrollCue from '../internal/ScrollCue.astro'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  layout?: 'records' | 'scroll'
  scrollCue?: boolean | string
}

const {
  'aria-label': ariaLabel,
  role,
  tabindex,
  class: classProp = '',
  className = '',
  glass = false,
  layout = 'scroll',
  scrollCue = false,
  ...rest
} = Astro.props

const showCue = Boolean(scrollCue) && layout === 'scroll'
const cueLabel = typeof scrollCue === 'string' ? scrollCue : 'Scroll horizontally to compare'

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-table-wrap',
  layout === 'records' && 'ui-table-wrap--records',
  glass && 'ui-table-wrap--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

{showCue ?
(
  <div class="ui-table-scroll" data-ui-scroll-cue>
    <ScrollCue label={cueLabel} />
    <div
      class:list={classList}
      data-scroll-cue-viewport
      data-slot="table"
      role={role ?? 'region'}
      tabindex={tabindex ?? 0}
      aria-label={ariaLabel ?? (Astro.props['aria-labelledby'] ? undefined : 'Table')}
      {...passthrough}
    >
      <slot />
    </div>
  </div>
) :
(
  <div aria-label={ariaLabel} role={role} tabindex={tabindex} class:list={classList} data-slot="table" {...passthrough}>
    <slot />
  </div>
)}

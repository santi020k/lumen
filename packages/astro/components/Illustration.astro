---
import type { HTMLAttributes } from 'astro/types'

import {
  renderLumenIllustrationSvg,
  resolveLumenAstroProps
} from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'span'> {
  class?: string | null
  className?: string
  label?: string
  size?: 'lg' | 'md' | 'sm'
  tone?: 'accent' | 'auto' | 'brand' | 'neutral'
  variant?: 'empty' | 'error' | 'offline' | 'success'
}

const {
  class: classProp = '',
  className = '',
  label,
  size = 'md',
  tone = 'auto',
  variant = 'empty',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-illustration',
  `ui-illustration--${variant}`,
  `ui-illustration--${tone}`,
  `ui-illustration--${size}`
], classProp, className)

const artwork = renderLumenIllustrationSvg(variant)
---

<span
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  class:list={classList}
  role={label ? 'img' : undefined}
  {...passthrough}
  set:html={artwork}
/>

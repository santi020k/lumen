---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  maxCount?: number
  placement?: 'bottom-center' | 'bottom-left' | 'bottom-right' | 'top-center' | 'top-left' | 'top-right'
}

const {
  'aria-atomic': ariaAtomic = 'false',
  'aria-live': ariaLive = 'polite',
  class: classProp = '',
  className = '',
  maxCount,
  placement = 'bottom-right',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-tvp'
], classProp, className)
---

<div
  aria-atomic={ariaAtomic}
  aria-live={ariaLive}
  data-ui-toast-viewport
  data-ui-toast-max={maxCount}
  data-placement={placement}
  class:list={classList}
  {...passthrough}
>
  <slot />
</div>

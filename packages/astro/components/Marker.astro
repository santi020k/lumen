---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'span'> {
  class?: string
  className?: string
  variant?: 'default' | 'success' | 'warning' | 'danger'
}

const {
  class: classProp = '',
  className = '',
  variant = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<span
  data-variant={variant}
  class:list={[
    'ui-marker',
    variant === 'success' && 'ui-marker--success',
    variant === 'warning' && 'ui-marker--warning',
    variant === 'danger' && 'ui-marker--danger',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</span>

---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'span'> {
  class?: string
  className?: string
  variant?: 'default' | 'success' | 'warning' | 'danger'
}

const {
  class: classProp = '',
  className = '',
  variant = 'default',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
    'ui-marker',
    variant === 'success' && 'ui-marker--success',
    variant === 'warning' && 'ui-marker--warning',
    variant === 'danger' && 'ui-marker--danger'
], classProp, className)
---

<span
  data-variant={variant}
  class:list={classList}
  {...passthrough}
>
  <slot />
</span>

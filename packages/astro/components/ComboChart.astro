---
import type { HTMLAttributes } from 'astro/types'

import {   alignLumenChartSeries,
  createLumenBarGeometry,
createLumenChartDatumActivation,
  createLumenLineGeometry,
  formatLumenChartSummary,
  getLumenChartCategories,
  getLumenChartDomain,
  getLumenChartToneClassName,
  hasLumenChartData,
  type LumenChartDatum,
  type LumenChartLabels,
  type LumenComboSeries,
  resolveLumenChartLabels,
  resolveLumenChartTone } from '@santi020k/lumen-core'

import { createChartDatumAction } from '../runtime/chart-actions'

import Chart from './Chart.astro'
import ChartDatumActions from './ChartDatumActions.astro'

interface Props extends HTMLAttributes<'figure'> {
  caption?: string
  class?: string | null
  className?: string
  description?: string
  drilldown?: boolean
  formatValue?: (value: number) => string
  heading?: string
  labels?: Partial<LumenChartLabels>
  series: readonly LumenComboSeries[]
  showLegend?: boolean
  showTable?: boolean
  summary?: string
}

const { caption, class: classProp = '', className = '', description, drilldown = false, formatValue = String, heading, labels, series, showLegend = true, showTable = true, summary: summaryProp, ...rest } = Astro.props
const resolvedLabels = resolveLumenChartLabels(labels)
const summary = summaryProp ?? formatLumenChartSummary(series, formatValue, resolvedLabels)
const width = 640
const height = 320
const padding = 44
const categories = getLumenChartCategories(series)

const alignedSeries = series.map(item => ({
  ...item,
  data: alignLumenChartSeries(item, categories).data
}))

const domain = getLumenChartDomain(alignedSeries.flatMap(item => item.data.map(datum => datum.y)))
const barSeries = alignedSeries.filter(item => item.mark === 'bar')
const lineSeries = alignedSeries.filter(item => item.mark !== 'bar')
const bars = createLumenBarGeometry(barSeries, { domain, height, width })

const categoryPositions = new Map(
  bars.categories.map(category => [`${typeof category.category}:${String(category.category)}`, category.x])
)

const drawableWidth = width - padding * 2

const alignComboLineDatum = (datum: LumenChartDatum): LumenChartDatum => {
  if (barSeries.length === 0) return datum

  return {
    ...datum,
    x: ((categoryPositions.get(`${typeof datum.x}:${String(datum.x)}`) ?? padding) - padding) / drawableWidth
  }
}

const lineGeometryOptions = {
  domain,
  height,
  padding,
  width,
  ...(barSeries.length === 0 ?
    {} :
    {
      paddingBottom: bars.margin.bottom,
      paddingTop: bars.margin.top,
      xDomain: { max: 1, min: 0 },
      xScale: 'linear' as const
    })
}

const lines = lineSeries.map(item => createLumenLineGeometry(
  item.data.map(alignComboLineDatum),
  lineGeometryOptions
))

const hasData = hasLumenChartData(series)

const barActions = drilldown ?
bars.marks.map(mark => {
  const item = barSeries.find(candidate => candidate.id === mark.seriesId)
  const datum = item?.data.find(candidate => candidate.x === mark.category)

  return item && datum ?
createChartDatumAction(
    createLumenChartDatumActivation(item.id, datum),
    `${datum.xLabel ?? datum.x} · ${item.label}: ${datum.label ?? formatValue(mark.value)}`,
    resolvedLabels
  ) :
null
}) :
[]

const pointActions = drilldown ?
lines.map((geometry, index) => {
  const item = lineSeries[index]

  return geometry.points.map(point => {
    const datum = item?.data.find(candidate => alignComboLineDatum(candidate).x === point.x)

    return item && datum ?
createChartDatumAction(
      createLumenChartDatumActivation(item.id, datum),
      `${datum.xLabel ?? datum.x} · ${item.label}: ${datum.label ?? formatValue(point.y ?? 0)}`,
      resolvedLabels
    ) :
null
  })
}) :
[]

const datumActions = [...barActions, ...pointActions.flat()]

---

<Chart class:list={['ui-combo-chart', classProp, className]} {caption} {description} {heading} {summary} {...rest} data-ui-chart-activation={drilldown || undefined}>
  {showLegend && hasData && <ul class="ui-chart__legend" aria-label={resolvedLabels.chartLegend}>{series.map((item, index) => <li class={getLumenChartToneClassName(item.tone, index)}><span aria-hidden="true" />{item.label}</li>)}</ul>}
  {!hasData && <p class="ui-chart__empty" role="status">{resolvedLabels.empty}</p>}
  <div aria-label={resolvedLabels.chartData} class="ui-chart__plot" role="region" tabindex="0" hidden={!hasData}><svg aria-hidden="true" viewBox={`0 0 ${width} ${height}`}><g class="
    ui-bar-chart__marks
  "
                                                                                                                                                                            >{bars.marks.map((mark, index) => <rect data-ui-chart-datum={barActions[index]?.serialized} class={getLumenChartToneClassName(mark.tone)} height={mark.height} rx="4" width={mark.width} x={mark.x} y={mark.y}><title>{`${mark.seriesLabel}: ${formatValue(mark.value)}`}</title></rect>)}{drilldown && bars.marks.map((mark, index) => (
  <rect
class="ui-chart__datum-hit"
width={Math.max(12, mark.width)}
height={Math.max(12, mark.height)}
    x={mark.x - Math.max(0, 12 - mark.width) / 2}
y={mark.y - Math.max(0, 12 - mark.height) / 2}
    data-ui-chart-datum={barActions[index]?.serialized}
  />
))}</g>{lines.map((geometry, index) => {
 const item = lineSeries[index]

 if (!item) return null

 const tone = resolveLumenChartTone(item.tone, index + barSeries.length)

 return (
<g class:list={['ui-line-chart__series', getLumenChartToneClassName(tone)]}>{item.mark === 'area' && geometry.areaPaths.map(path => (
<path
class="ui-line-chart__area"
d={path}
/>
)) }<path
class="ui-line-chart__line"
d={geometry.path}
    />{drilldown && geometry.points.map((point, pointIndex) => (
      <circle
class="ui-chart__datum-hit"
cx={point.xCoordinate}
cy={point.yCoordinate}
r="10"
        data-ui-chart-datum={pointActions[index]?.[pointIndex]?.serialized}
      />
    ))}</g>
)
})}</svg></div>
  {showTable && hasData && (
<details class="ui-chart__data"><summary>{resolvedLabels.viewData}</summary><div role="group" tabindex="0" aria-label={resolvedLabels.chartData}><table><thead><tr><th scope="col">{resolvedLabels.category}</th>{series.map(item => <th scope="col">{item.label}</th>)}</tr></thead><tbody>{categories.map(category => (
<tr><th scope="row">{String(category)}</th>{alignedSeries.map(item => {
 const datum = item.data.find(point => point.x === category)

 return <td>{datum?.label ?? (datum?.y === undefined || datum.y === null || !Number.isFinite(datum.y) ? resolvedLabels.notAvailable : formatValue(datum.y))}</td>
})}</tr>
))}</tbody></table></div></details>
)}
  {drilldown && <ChartDatumActions actions={datumActions} label={resolvedLabels.exploreData} />}
</Chart>

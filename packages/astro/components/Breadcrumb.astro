---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'nav'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<nav
  aria-label="Breadcrumb"
  class:list={[
    'ui-breadcrumb',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</nav>

---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'img'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  loading = 'eager',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-image'
], classProp, className)
---

<img
  loading={loading}
  class:list={classList}
  {...passthrough}
/>

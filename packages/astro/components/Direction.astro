---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  dir?: 'ltr' | 'rtl' | 'auto'
}

const {
  class: classProp = '',
  className = '',
  dir = 'ltr',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-direction'
], classProp, className)
---

<div
  dir={dir}
  class:list={classList}
  {...passthrough}
>
  <slot />
</div>

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  dir?: 'ltr' | 'rtl' | 'auto'
}

const {
  class: classProp = '',
  className = '',
  dir = 'ltr',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<div
  dir={dir}
  class:list={[
    'ui-direction',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</div>

---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/color-picker.css'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'input'> {
  class?: string | null
  className?: string
}

const { class: classProp = '', className = '', type = 'color', ...rest } = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-color-picker'
], classProp, className)
---

<input class:list={classList} type={type} {...passthrough} />

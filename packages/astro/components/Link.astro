---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'a'> {
  class?: string | null
  className?: string
  newTab?: boolean
  variant?: 'default' | 'inherit'
}

const {
  class: classProp = '',
  className = '',
  newTab = false,
  rel,
  target,
  variant = 'default',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-link',
  variant === 'inherit' && 'ui-link--inherit'
], classProp, className)

const safeRel = newTab ?
  [...new Set(`${rel ?? ''} noopener noreferrer`.trim().split(/\s+/))].join(' ') :
  rel
---

<a
  class:list={classList}
  data-slot="link"
  data-variant={variant}
  rel={safeRel}
  target={newTab ? '_blank' : target}
  {...passthrough}
>
  <slot />
</a>

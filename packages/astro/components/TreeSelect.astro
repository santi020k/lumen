---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface TreeNode {
  children?: TreeNode[]
  label: string
  value: string
}

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  name?: string
  placeholder?: string
  treeData?: TreeNode[]
}

const {
  class: classProp = '',
  className = '',
  name,
  placeholder = 'Select…',
  treeData = [],
  ...rest
} = Astro.props

const flatten = (nodes: TreeNode[], depth = 0, acc: { depth: number, label: string, value: string }[] = []) => {
  for (const node of nodes) {
    acc.push({ depth, label: node.label, value: node.value })

    if (node.children && node.children.length > 0) {
      flatten(node.children, depth + 1, acc)
    }
  }

  return acc
}

const rows = flatten(treeData)

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-tree-select'
], classProp, className)
---

<div class:list={classList} data-surface="default" data-ui-popover data-ui-tree-select {...passthrough}>
  <button
    aria-expanded="false"
    aria-haspopup="tree"
    class="ui-select ui-select__trigger ui-tree-select__trigger"
    data-ui-trigger
    type="button"
  >
    <span data-ui-tree-select-placeholder={placeholder} data-ui-tree-select-value>{placeholder}</span>
  </button>
  <div class="ui-tree-select__panel" data-ui-panel hidden>
    <div class="ui-tree-select__tree" role="tree">
      {rows.map(row => (
        <button
          class="ui-tree-select__option"
          data-value={row.value}
          role="treeitem"
          style={`--ui-tree-depth:${row.depth}`}
          type="button"
        >
          {row.label}
        </button>
      ))}
    </div>
    <slot />
  </div>
  {name && <input data-ui-tree-select-input name={name} type="hidden" />}
</div>

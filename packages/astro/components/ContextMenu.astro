---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'menu'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-menu',
  glass && 'ui-menu--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

{/* Point an element at this menu with data-ui-context-menu-trigger="<menu id>"
    to get right-click / Shift+F10 open behavior from the runtime. Without a
    trigger the menu renders statically. */}
<menu
  data-surface={glass ? 'glass' : 'default'}
  data-ui-context-menu
  role="menu"
  class:list={classList}
  {...passthrough}
>
  <slot />
</menu>

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'menu'> {
  class?: string
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  surface?: 'default' | 'glass'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  surface = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
const resolvedSurface = glass || surface === 'glass' ? 'glass' : surface
---

{/* Point an element at this menu with data-ui-context-menu-trigger="<menu id>"
    to get right-click / Shift+F10 open behavior from the runtime. Without a
    trigger the menu renders statically. */}
<menu
  data-surface={resolvedSurface}
  data-ui-context-menu
  role="menu"
  class:list={[
    'ui-menu',
    resolvedSurface === 'glass' && 'ui-menu--glass',
    glass === 'subtle' && 'ui-glass-subtle',
    glass === 'strong' && 'ui-glass-strong',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</menu>

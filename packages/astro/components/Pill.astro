---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'span'> {
  class?: string | null
  className?: string
  count?: number | string
  href?: string
  variant?: 'brand' | 'neutral' | 'outline'
}

const {
  class: classProp = '',
  className = '',
  count,
  href,
  variant = 'neutral',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-pill',
  variant !== 'neutral' && `ui-pill--${variant}`
], classProp, className)
---

{href
  ? <a class:list={classList} data-variant={variant} href={href} {...passthrough}>
      <slot />
      {count != null && <span class="ui-pill__count">{count}</span>}
    </a>
  : <span class:list={classList} data-variant={variant} {...passthrough}>
      <slot />
      {count != null && <span class="ui-pill__count">{count}</span>}
    </span>
}

---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'span'> {
  class?: string | null
  className?: string
  count?: number | string
  href?: string
}

const {
  class: classProp = '',
  className = '',
  count,
  href,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-pill'
], classProp, className)
---

{href
  ? <a class:list={classList} href={href} {...passthrough}>
      <slot />
      {count != null && <span class="ui-pill__count">{count}</span>}
    </a>
  : <span class:list={classList} {...passthrough}>
      <slot />
      {count != null && <span class="ui-pill__count">{count}</span>}
    </span>
}

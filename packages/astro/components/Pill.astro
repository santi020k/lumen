---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'span'> {
  class?: string
  className?: string
  count?: number | string
}

const {
  class: classProp = '',
  className = '',
  count,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-pill'
], classProp, className)
---

<span
  class:list={classList}
  {...passthrough}
>
  <slot />
  {count != null && <span class="ui-pill__count">{count}</span>}
</span>

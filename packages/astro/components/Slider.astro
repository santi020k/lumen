---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'input'> {
  class?: string | null
  className?: string
}

const { class: classProp = '', className = '', type = 'range', ...rest } = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-slider'
], classProp, className)
---

<input
  class:list={classList}
  type={type}
  {...passthrough}
/>

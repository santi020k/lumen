---
import type { HTMLAttributes } from 'astro/types'

import {
  getLumenPhoneCountries,
  getLumenPhoneCountry,
  type LumenPhoneCountry,
  type LumenPhoneCountryOptions,
  resolveLumenAstroProps,
  resolveLumenPhoneNumber
} from '@santi020k/lumen-core'

interface CountryOption {
  disabled?: boolean
  label: string
  value: string
}

type Country = CountryOption | string

interface NormalizedCountryOption extends CountryOption {
  regionCode?: string
}

interface Props extends Omit<HTMLAttributes<'div'>, 'size'> {
  class?: string | null
  className?: string
  countries?: Country[]
  countryOptions?: readonly LumenPhoneCountry[]
  countryLabel?: string
  countryName?: string
  countryValue?: string
  invalidNumberMessage?: string
  locale?: LumenPhoneCountryOptions['locale']
  name?: string
  placeholder?: string
  size?: 'default' | 'lg' | 'sm'
  value?: string
}

const {
  class: classProp = '',
  className = '',
  countries = [],
  countryOptions,
  countryLabel = 'Country code',
  countryName = 'country',
  countryValue = 'US',
  invalidNumberMessage = 'Enter a complete phone number.',
  locale,
  name = 'phone',
  placeholder = 'Phone number',
  size = 'default',
  value,
  ...rest
} = Astro.props

const phoneOptions = locale === undefined ? {} : { locale }
const metadataCountries = countryOptions ?? getLumenPhoneCountries(phoneOptions)
const usesMetadata = countries.length === 0

const normalizedCountries: NormalizedCountryOption[] = usesMetadata ?
  metadataCountries.map(country => ({
  label: country.pickerLabel,
  regionCode: country.regionCode,
  value: country.regionCode
  })) :
  countries.map(country => typeof country === 'string' ? { label: country, value: country } : country)

const selectedCountry = metadataCountries.find(country => (
  country.regionCode === countryValue || country.callingCode === countryValue
)) ?? metadataCountries[0] ?? getLumenPhoneCountry('US', phoneOptions)

const phoneValue = selectedCountry && value ? resolveLumenPhoneNumber(selectedCountry, value, phoneOptions) : null
const selectedCountryValue = usesMetadata ? phoneValue?.country.regionCode ?? selectedCountry?.regionCode : countryValue
const renderedValue = usesMetadata ? phoneValue?.nationalNumber ?? value : value

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-phone-input',
  'ui-input-group'
], classProp, className)
---

<div
  class:list={classList}
  data-e164={phoneValue?.e164}
  data-invalid-number-message={invalidNumberMessage}
  data-ui-phone-input={usesMetadata ? '' : undefined}
  data-valid={phoneValue ? String(phoneValue.isValid) : undefined}
  {...passthrough}
>
  <select
    aria-label={countryLabel}
    class:list={[
      'ui-select',
      'ui-phone-input__country',
      size === 'sm' && 'ui-select--sm',
      size === 'lg' && 'ui-select--lg'
    ]}
    name={countryName}
  >
    {normalizedCountries.map(country => (
      <option
        disabled={country.disabled}
        data-region={country.regionCode}
        selected={country.value === selectedCountryValue}
        value={country.value}
      >{country.label}
      </option>
    ))}
  </select>
  <input
    autocomplete="tel"
    class:list={[
      'ui-input',
      'ui-phone-input__number',
      size === 'sm' && 'ui-input--sm',
      size === 'lg' && 'ui-input--lg'
    ]}
    inputmode="tel"
    name={name}
    placeholder={placeholder}
    type="tel"
    value={renderedValue}
  />
</div>

---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends Omit<HTMLAttributes<'input'>, 'size'> {
  class?: string | null
  className?: string
  size?: 'default' | 'lg' | 'sm'
}

const { class: classProp = '', className = '', size = 'default', type = 'text', ...rest } = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-input',
  size === 'sm' && 'ui-input--sm',
  size === 'lg' && 'ui-input--lg'
], classProp, className)
---

<input
  class:list={classList}
  type={type}
  {...passthrough}
/>

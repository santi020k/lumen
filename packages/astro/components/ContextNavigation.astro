---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  variant?: 'default' | 'unstyled'
}

const {
  class: classProp = '',
  className = '',
  variant = 'default',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-context-navigation',
  variant === 'unstyled' && 'ui-context-navigation--unstyled'
], classProp, className)
---

<div
  class:list={classList}
  data-slot="context-navigation"
  data-variant={variant}
  {...passthrough}
>
  {Astro.slots.has('context') && (
    <div class="ui-context-navigation__context" data-slot="context-navigation-context">
      <slot name="context" />
    </div>
  )}
  <slot />
</div>

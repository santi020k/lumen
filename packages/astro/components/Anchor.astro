---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'nav'> {
  class?: string
  className?: string
}

const {
  'aria-label': ariaLabel = 'On this page',
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-anchor'
], classProp, className)
---

<nav
  aria-label={ariaLabel}
  class:list={classList}
  data-ui-anchor
  {...passthrough}
>
  <slot />
</nav>

---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

type AnchorLink = { href: string; label: string }

export interface Props extends HTMLAttributes<'nav'> {
  class?: string
  className?: string
  items?: AnchorLink[]
}

const {
  'aria-label': ariaLabel = 'On this page',
  class: classProp = '',
  className = '',
  items = [],
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-anchor'
], classProp, className)
---

<nav
  aria-label={ariaLabel}
  class:list={classList}
  data-ui-anchor
  {...passthrough}
>
  {items.length > 0 && (
    <ol>
      {items.map((item, index) => (
        <li>
          <a data-active={index === 0 ? 'true' : 'false'} href={item.href}>{item.label}</a>
        </li>
      ))}
    </ol>
  )}
  <slot />
</nav>

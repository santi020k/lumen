---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'a'> {
  class?: string | null
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-skip-link'
], classProp, className)
---

<a
  class:list={classList}
  data-slot="skip-link"
  {...passthrough}
>
  <slot />
</a>

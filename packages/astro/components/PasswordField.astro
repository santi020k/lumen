---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import Button from './Button.astro'
import Field from './Field.astro'
import FieldError from './FieldError.astro'
import Input from './Input.astro'
import Label from './Label.astro'

interface Props extends Omit<HTMLAttributes<'input'>, 'size' | 'type'> {
  class?: string | null
  className?: string
  error?: string
  hideLabel?: string
  hint?: string
  label?: string
  showLabel?: string
}

const {
  class: classProp = '',
  className = '',
  error,
  hideLabel = 'Hide password',
  hint,
  id,
  label = 'Password',
  name,
  showLabel = 'Show password',
  ...rest
} = Astro.props

const controlId = id ?? `ui-password-${name ?? 'field'}`
const hintId = hint ? `${controlId}-hint` : undefined
const errorId = `${controlId}-error`
const describedBy = [hintId, error ? errorId : undefined].filter(Boolean).join(' ') || undefined
const { classList } = resolveLumenAstroProps({}, ['ui-password-field'], classProp, className)
---

<Field
  class={classList.join(' ')}
  controlId={controlId}
  data-invalid={error ? 'true' : undefined}
  describedBy={describedBy}
>
  <Label for={controlId}>{label}</Label>
  <div class="ui-password-field__control" data-ui-password-field>
    <Input
      aria-describedby={describedBy}
      aria-invalid={error ? 'true' : undefined}
      id={controlId}
      name={name}
      type="password"
      {...rest}
    />
    <Button
      aria-controls={controlId}
      aria-label={showLabel}
      data-hide-label={hideLabel}
      data-show-label={showLabel}
      data-ui-password-toggle
      size="icon"
      type="button"
      variant="ghost"
    >
      <span aria-hidden="true" data-ui-password-toggle-label>Show</span>
    </Button>
  </div>
  {hint && <p class="ui-field__hint" data-ui-field-hint id={hintId}>{hint}</p>}
  <FieldError id={errorId} message={error} />
</Field>

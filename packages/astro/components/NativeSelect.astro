---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Option {
  disabled?: boolean
  label: string
  value: string
}

type SelectOption = Option | string

interface Props extends Omit<HTMLAttributes<'select'>, 'size'> {
  class?: string
  className?: string
  size?: 'default' | 'lg' | 'sm'
  options?: SelectOption[]
  placeholder?: string
}

const { class: classProp = '', className = '', options = [], placeholder, size = 'default', ...rest } = Astro.props
const hasValue = Object.hasOwn(rest, 'value')
const normalizedOptions = options.map(option =>
  typeof option === 'string' ? { label: option, value: option } : option
)
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-select', size === 'sm' && 'ui-select--sm', size === 'lg' && 'ui-select--lg'
], classProp, className)
---

<select class:list={classList} {...passthrough}>
  {placeholder && <option disabled selected={!hasValue} value="">{placeholder}</option>}
  <slot />
  {normalizedOptions.map(option => (
    <option disabled={option.disabled} value={option.value}>{option.label}</option>
  ))}
</select>

---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Option {
  disabled?: boolean
  label: string
  value: string
}

type SelectOption = Option | string

interface Props extends Omit<HTMLAttributes<'select'>, 'size'> {
  class?: string | null
  className?: string
  size?: HTMLAttributes<'select'>['size']
  options?: SelectOption[]
  placeholder?: string
  visualSize?: 'default' | 'lg' | 'sm'
}

const {
  class: classProp = '',
  className = '',
  options = [],
  placeholder,
  size,
  visualSize,
  ...rest
} = Astro.props

const hasValue = Object.hasOwn(rest, 'value')
const normalizedOptions = options.map(option => typeof option === 'string' ? { label: option, value: option } : option)
const resolvedVisualSize = visualSize ?? 'default'

const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-select', resolvedVisualSize === 'sm' && 'ui-select--sm', resolvedVisualSize === 'lg' && 'ui-select--lg'
], classProp, className)
---

<select class:list={classList} size={size} {...passthrough}>
  {placeholder && <option disabled selected={!hasValue} value="">{placeholder}</option>}
  <slot />
  {normalizedOptions.map(option => (
    <option disabled={option.disabled} value={option.value}>{option.label}</option>
  ))}
</select>

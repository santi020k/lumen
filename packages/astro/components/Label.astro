---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'label'> {
  class?: string
  className?: string
}

const { class: classProp = '', className = '', ...rest } = Astro.props
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-label'
], classProp, className)
---

<label class:list={classList} {...passthrough}>
  <slot />
</label>

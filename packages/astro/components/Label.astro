---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'label'> {
  class?: string
  className?: string
}

const { class: classProp = '', className = '', ...rest } = Astro.props
const passthrough = rest as Record<string, unknown>
---

<label class:list={['ui-label', classProp, className]} {...passthrough}>
  <slot />
</label>

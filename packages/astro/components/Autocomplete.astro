---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'input'> {
  class?: string | null
  className?: string
  list: string
}

const { class: classProp = '', className = '', type = 'search', ...rest } = Astro.props
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-input', 'ui-autocomplete'
], classProp, className)
---

{/* No explicit role: an input with a `list` attribute already has native combobox
    semantics, and the browser manages aria-expanded for the datalist popup. */}
<input
  aria-autocomplete="list"
  class:list={classList}
  type={type}
  {...passthrough}
/>

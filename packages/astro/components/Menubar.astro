---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'nav'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-menubar',
  glass && 'ui-menubar--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<nav
  data-surface={glass ? 'glass' : 'default'}
  data-ui-menubar
  class:list={classList}
  {...passthrough}
>
  <slot />
</nav>

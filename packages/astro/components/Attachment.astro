---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'article'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  href?: string
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  href,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-attachment',
  glass && 'ui-attachment--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

{href ?
  (
    <a
      href={href}
      class:list={classList}
      {...passthrough}
    >
      <slot />
    </a>
  ) :
  (
    <article
      class:list={classList}
      {...passthrough}
    >
      <slot />
    </article>
  )}

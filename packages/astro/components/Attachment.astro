---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'article'> {
  class?: string
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  href?: string
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  href,
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

{href
  ? (
      <a
        href={href}
        class:list={[
          'ui-attachment',
          glass && 'ui-attachment--glass',
          glass === 'subtle' && 'ui-glass-subtle',
          glass === 'strong' && 'ui-glass-strong',
          classProp,
          className
        ]}
        {...passthrough}
      >
        <slot />
      </a>
    )
  : (
      <article
        class:list={[
          'ui-attachment',
          glass && 'ui-attachment--glass',
          glass === 'subtle' && 'ui-glass-subtle',
          glass === 'strong' && 'ui-glass-strong',
          classProp,
          className
        ]}
        {...passthrough}
      >
        <slot />
      </article>
    )}

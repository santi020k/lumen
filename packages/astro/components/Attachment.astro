---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'article'> {
  class?: string
  className?: string
  href?: string
}

const {
  class: classProp = '',
  className = '',
  href,
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<article
  data-href={href}
  class:list={[
    'ui-attachment',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</article>

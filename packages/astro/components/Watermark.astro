---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  content?: string
  gap?: number
  rotate?: number
  text?: string
}

const {
  class: classProp = '',
  className = '',
  content,
  gap = 120,
  rotate = -22,
  text = 'Confidential',
  ...rest
} = Astro.props

const watermarkText = content ?? text

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-watermark'
], classProp, className)
---

<div
  class:list={classList}
  data-ui-watermark
  style={`--ui-watermark-gap:${gap}px;--ui-watermark-rotate:${rotate}deg`}
  {...passthrough}
>
  <slot />
  <div aria-hidden="true" class="ui-watermark__overlay" data-text={watermarkText}></div>
</div>

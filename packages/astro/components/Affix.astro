---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  offset?: number
  position?: 'top' | 'bottom'
}

const {
  class: classProp = '',
  className = '',
  offset = 0,
  position = 'top',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-affix',
  position === 'bottom' && 'ui-affix--bottom'
], classProp, className)
---

<div
  class:list={classList}
  data-position={position}
  style={`--ui-affix-offset:${offset}px`}
  {...passthrough}
>
  <slot />
</div>

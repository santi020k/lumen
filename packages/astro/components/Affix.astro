---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  offset?: number
  offsetBottom?: number
  offsetTop?: number
  position?: 'top' | 'bottom'
}

const {
  class: classProp = '',
  className = '',
  offset = 0,
  offsetBottom,
  offsetTop,
  position: positionProp,
  ...rest
} = Astro.props

const position = positionProp ?? (offsetBottom !== undefined ? 'bottom' : 'top')
const resolvedOffset = offsetBottom ?? offsetTop ?? offset

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-affix',
  position === 'bottom' && 'ui-affix--bottom'
], classProp, className)
---

<div
  class:list={classList}
  data-position={position}
  style={`--ui-affix-offset:${resolvedOffset}px`}
  {...passthrough}
>
  <slot />
</div>

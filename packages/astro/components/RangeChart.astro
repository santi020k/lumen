---
import type { HTMLAttributes } from 'astro/types'

import { createLumenRangeDatumActivation, createLumenRangeGeometry, getLumenChartTicks, getLumenChartToneClassName, type LumenChartLabels, type LumenChartTone, type LumenRangeDatum, resolveLumenChartLabels, scaleLumenChartValue } from '@santi020k/lumen-core'

import { createChartDatumAction } from '../runtime/chart-actions'

import Chart from './Chart.astro'
import ChartDatumActions from './ChartDatumActions.astro'

interface Props extends HTMLAttributes<'figure'> {
  caption?: string
  class?: string | null
  className?: string
  data: readonly LumenRangeDatum[]
  description?: string
  drilldown?: boolean
  formatValue?: (value: number) => string
  heading?: string
  labels?: Partial<LumenChartLabels>
  showTable?: boolean
  summary?: string
  tone?: LumenChartTone
}

const { caption, class: classProp = '', className = '', data, description, drilldown = false, formatValue = String, heading, labels, showTable = true, summary: summaryProp, tone = 'series-1', ...rest } = Astro.props
const width = 640
const height = 320
const padding = 44
const geometry = createLumenRangeGeometry(data, { height, padding, width })
const resolvedLabels = resolveLumenChartLabels(labels)

const summary = summaryProp ?? (
  geometry.points.length === 0 ?
    resolvedLabels.formatRangeSummary(0) :
    resolvedLabels.formatRangeSummary(geometry.points.length)
)

const ticks = getLumenChartTicks(geometry.domain)

const datumActions = drilldown ?
geometry.points.map(point => createChartDatumAction(
  createLumenRangeDatumActivation(point),
  `${point.xLabel ?? point.x}: ${point.label ?? `${formatValue(point.low ?? 0)}–${formatValue(point.high ?? 0)}`}`,
  resolvedLabels
)) :
[]

---

<Chart class:list={['ui-range-chart', getLumenChartToneClassName(tone), classProp, className]} {caption} {description} {heading} {summary} {...rest} data-ui-chart-activation={drilldown || undefined}>
  {geometry.points.length === 0 && <p class="ui-chart__empty" role="status">{resolvedLabels.empty}</p>}
  <div aria-label={resolvedLabels.chartData} class="ui-chart__plot" role="region" tabindex="0" hidden={geometry.points.length === 0}><svg aria-hidden="true" viewBox={`0 0 ${width} ${height}`}><g class="
    ui-chart__grid
  "
                                                                                                                                                                                                >{ticks.map(tick => {
 const y = scaleLumenChartValue(tick, geometry.domain, height - padding, padding)

 return <><line x1={padding} x2={width - padding} y1={y} y2={y}/><text x={padding - 8} y={y}>{formatValue(tick)}</text></>
})}</g><path
class="ui-range-chart__area"
d={geometry.areaPath}
       />{geometry.points.map((point, index) => (
<line
data-ui-chart-datum={datumActions[index]?.serialized}
class="ui-range-chart__interval"
x1={point.xCoordinate}
x2={point.xCoordinate}
y1={point.highCoordinate}
y2={point.lowCoordinate}
><title>{`${point.xLabel ?? point.x}: ${point.label ?? `${formatValue(point.low ?? 0)}–${formatValue(point.high ?? 0)}`}`}</title></line>
))}{drilldown && geometry.points.map((point, index) => (
  <rect
class="ui-chart__datum-hit"
x={point.xCoordinate - 10}
    y={Math.min(point.highCoordinate, point.lowCoordinate) - Math.max(0, 20 - Math.abs(point.highCoordinate - point.lowCoordinate)) / 2}
    width="20"
height={Math.max(20, Math.abs(point.highCoordinate - point.lowCoordinate))}
    data-ui-chart-datum={datumActions[index]?.serialized}
  />
))}</svg></div>
  {showTable && <details class="ui-chart__data"><summary>{resolvedLabels.viewData}</summary><div><table><thead><tr><th scope="col">{resolvedLabels.category}</th><th scope="col">{resolvedLabels.low}</th><th scope="col">{resolvedLabels.high}</th></tr></thead><tbody>{data.map(item => <tr><th scope="row">{item.xLabel ?? item.x}</th><td>{item.low === null || !Number.isFinite(item.low) ? resolvedLabels.notAvailable : formatValue(item.low)}</td><td>{item.high === null || !Number.isFinite(item.high) ? resolvedLabels.notAvailable : formatValue(item.high)}</td></tr>)}</tbody></table></div></details>}
  {drilldown && <ChartDatumActions actions={datumActions} label={resolvedLabels.exploreData} />}
</Chart>

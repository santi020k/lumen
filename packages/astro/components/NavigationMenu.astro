---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'nav'> {
  class?: string
  className?: string
  glass?: boolean
  surface?: 'default' | 'glass'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  surface = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
const resolvedSurface = glass || surface === 'glass' ? 'glass' : surface
---

<nav
  data-surface={resolvedSurface}
  data-ui-navigation-menu
  class:list={[
    'ui-navigation-menu',
    resolvedSurface === 'glass' && 'ui-navigation-menu--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</nav>

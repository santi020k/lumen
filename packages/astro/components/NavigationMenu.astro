---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'nav'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  variant?: 'default' | 'unstyled'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  variant = 'default',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-navigation-menu',
  variant === 'unstyled' && 'ui-navigation-menu--unstyled',
  glass && 'ui-navigation-menu--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<nav
  data-slot="navigation-menu"
  data-surface={glass ? 'glass' : 'default'}
  data-ui-navigation-menu
  data-variant={variant}
  class:list={classList}
  {...passthrough}
>
  <slot />
</nav>

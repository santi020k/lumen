---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/back-to-top.css'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'button'> {
  class?: string | null
  className?: string
}

const {
  class: classProp = '',
  className = '',
  type = 'button',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-back-to-top'
], classProp, className)
---

<button
  type={type}
  class:list={classList}
  data-ui-back-to-top
  {...passthrough}
>
  <slot />
</button>

---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  as?: 'article' | 'div' | 'section'
  class?: string | null
  className?: string
  density?: 'comfortable' | 'compact' | 'spacious'
  glass?: boolean | 'subtle' | 'strong'
  variant?: 'default' | 'glass' | 'interactive' | 'muted' | 'unstyled'
}

const {
  as: Tag = 'div',
  class: classProp = '',
  className = '',
  density = 'comfortable',
  glass = false,
  variant = 'default',
  ...rest
} = Astro.props

const isGlass = glass || variant === 'glass'

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-card',
  `ui-card--${density}`,
  variant === 'unstyled' && 'ui-card--unstyled',
  variant === 'muted' && 'ui-card--muted',
  variant === 'interactive' && 'ui-card--interactive',
  isGlass && 'ui-card--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<Tag
  class:list={classList}
  data-density={density}
  data-slot="card"
  data-variant={variant}
  {...passthrough}
>
  <slot />
</Tag>

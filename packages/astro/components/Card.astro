---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  as?: 'article' | 'div' | 'section'
  class?: string
  className?: string
  variant?: 'default' | 'glass' | 'interactive' | 'muted'
}

const {
  as: Tag = 'div',
  class: classProp = '',
  className = '',
  variant = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<Tag
  data-variant={variant}
  class:list={[
    'ui-card',
    variant === 'muted' && 'ui-card--muted',
    variant === 'interactive' && 'ui-card--interactive',
    variant === 'glass' && 'ui-card--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</Tag>

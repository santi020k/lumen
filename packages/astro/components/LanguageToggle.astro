---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  type = 'button',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-language-toggle'
], classProp, className)
---

<button
  type={type}
  class:list={classList}
  data-ui-language-toggle
  {...passthrough}
>
  <slot />
</button>

<script>
  function initLanguageToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-ui-language-toggle]')
    buttons.forEach(button => {
      button.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('language-change'))
      })
    })
  }
  
  initLanguageToggle()
  
  document.addEventListener('astro:after-swap', initLanguageToggle)
</script>

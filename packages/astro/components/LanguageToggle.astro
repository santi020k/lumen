---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  type = 'button',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-language-toggle'
], classProp, className)
---

<lumen-language-toggle
  type={type}
  class:list={classList}
  data-ui-language-toggle
  {...passthrough}
>
  <slot />
</lumen-language-toggle>

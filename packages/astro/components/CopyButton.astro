---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'button'> {
  class?: string | null
  className?: string
  copiedLabel?: string
  errorLabel?: string
  label?: string
  resetAfter?: number
  size?: 'default' | 'sm' | 'lg' | 'icon'
  target?: string
  toast?: boolean
  value?: string
  variant?: 'default' | 'destructive' | 'ghost' | 'link' | 'outline' | 'secondary'
}

const {
  class: classProp = '',
  className = '',
  copiedLabel = 'Copied to clipboard',
  errorLabel = 'Could not copy to clipboard',
  label = 'Copy to clipboard',
  resetAfter = 2000,
  size = 'default',
  target,
  toast = false,
  type = 'button',
  value,
  variant = 'outline',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-button',
  `ui-button--${variant}`,
  size === 'default' && 'ui-button--default-size',
  size === 'sm' && 'ui-button--sm',
  size === 'lg' && 'ui-button--lg',
  size === 'icon' && 'ui-button--icon',
  'ui-copy-button'
], classProp, className)
---

<button
  aria-label={label}
  class:list={classList}
  data-copy-copied-label={copiedLabel}
  data-copy-error-label={errorLabel}
  data-copy-label={label}
  data-copy-reset-after={Math.max(0, resetAfter)}
  data-copy-target={target}
  data-copy-toast={toast ? 'true' : undefined}
  data-copy-value={value}
  data-size={size}
  data-slot="copy-button"
  data-state="idle"
  data-ui-copy-button
  data-variant={variant}
  type={type}
  {...passthrough}
>
  <span data-slot="copy-idle"><slot>Copy</slot></span>
  <span aria-hidden="true" data-slot="copy-copied" hidden>
    <slot name="copied">{copiedLabel}</slot>
  </span>
  <span aria-hidden="true" data-slot="copy-error" hidden>
    <slot name="error">{errorLabel}</slot>
  </span>
</button>

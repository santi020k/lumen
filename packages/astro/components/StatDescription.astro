---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/stat-description.css'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'p'
  class?: string | null
  className?: string
}

const { as: Tag = 'div', class: classProp = '', className = '', ...rest } = Astro.props
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-stat-description'], classProp, className)
---

<Tag class:list={classList} data-slot="stat-description" {...passthrough}><slot /></Tag>

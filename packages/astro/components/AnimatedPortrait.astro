---
import type { ImageMetadata } from 'astro'
import type { HTMLAttributes } from 'astro/types'

import { Picture } from 'astro:assets'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  alt: string
  badgeProps?: {
    experience?: {
      label: string
      value: string
    }
    location?: {
      label: string
      text: string
    }
  }
  class?: string | null
  className?: string
  showFloatingBadges?: boolean
  sizes?: string
  src: ImageMetadata | string
  widths?: number[]
}

const {
  alt,
  badgeProps,
  class: classProp = '',
  className = '',
  showFloatingBadges = false,
  sizes = '(min-width: 1024px) 352px, 75vw',
  src,
  widths = [400, 600, 800],
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-animated-portrait',
  'relative isolate mx-auto w-full max-w-88 animate-reveal-lcp motion-reduce:animate-none'
], classProp, className)
---

<div class:list={classList} {...passthrough}>
  <div
    aria-hidden="true"
    class="ui-animated-portrait__glow"
  />

  <div
    aria-hidden="true"
    class="ui-animated-portrait__orbit ui-animated-portrait__orbit--outer"
  />

  <div
    aria-hidden="true"
    class="ui-animated-portrait__orbit ui-animated-portrait__orbit--inner"
  />

  <div
    class="panel-card ui-animated-portrait__card"
  >
    <div
      aria-hidden="true"
      class="grid-fade ui-animated-portrait__grid"
    />
    <div
      aria-hidden="true"
      class="ui-animated-portrait__wash"
    />
    {typeof src === 'string' ?
      (
        <Picture
          alt={alt}
          class="ui-animated-portrait__image"
          decoding="sync"
          fetchpriority="high"
          formats={['avif', 'webp']}
          height={440}
          loading="eager"
          sizes={sizes}
          src={src}
          width={352}
          widths={widths}
        />
      ) :
      (
        <Picture
          alt={alt}
          class="ui-animated-portrait__image"
          decoding="sync"
          fetchpriority="high"
          formats={['avif', 'webp']}
          height={440}
          loading="eager"
          sizes={sizes}
          src={src}
          width={352}
          widths={widths}
        />
      )}
  </div>

  {showFloatingBadges && badgeProps?.location && (
    <div class="
      ui-animated-portrait__badge ui-animated-portrait__badge--location
    "
    >
      <p class="
        ui-animated-portrait__label ui-animated-portrait__label--location
      "
      >
        <span class="ui-animated-portrait__status" />
        {badgeProps.location.label}
      </p>
      <p class="ui-animated-portrait__location">{badgeProps.location.text}</p>
    </div>
  )}

  {showFloatingBadges && badgeProps?.experience && (
    <div class="
      ui-animated-portrait__badge ui-animated-portrait__badge--experience
    "
    >
      <p class="ui-animated-portrait__label">{badgeProps.experience.label}</p>
      <p class="ui-animated-portrait__experience">
        {badgeProps.experience.value}
      </p>
    </div>
  )}
</div>

---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'footer'> {
  class?: string | null
  className?: string
}

const { class: classProp = '', className = '', ...rest } = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(
  rest, ['ui-dialog-footer'], classProp, className
)
---

<footer class:list={classList} data-slot="dialog-footer" {...passthrough}>
  <slot />
</footer>

---
import type { HTMLAttributes } from 'astro/types'

import { createLumenHeatmapDatumActivation, createLumenHeatmapGeometry, type LumenChartLabels, type LumenHeatmapDatum, resolveLumenChartLabels } from '@santi020k/lumen-core'

import { createChartDatumAction } from '../runtime/chart-actions'

import Chart from './Chart.astro'
import ChartDatumActions from './ChartDatumActions.astro'

interface Props extends HTMLAttributes<'figure'> {
  caption?: string
  class?: string | null
  className?: string
  data: readonly LumenHeatmapDatum[]
  description?: string
  drilldown?: boolean
  formatValue?: (value: number) => string
  heading?: string
  labels?: Partial<LumenChartLabels>
  showTable?: boolean
  summary?: string
}

const { caption, class: classProp = '', className = '', data, description, drilldown = false, formatValue = String, heading, labels, showTable = true, summary: summaryProp, ...rest } = Astro.props
const geometry = createLumenHeatmapGeometry(data)
const hasData = geometry.cells.some(cell => cell.value !== null && Number.isFinite(cell.value))
const resolvedLabels = resolveLumenChartLabels(labels)
const summary = summaryProp ?? resolvedLabels.formatHeatmapSummary(geometry.cells.filter(cell => cell.value !== null && Number.isFinite(cell.value)).length)
const availableCells = geometry.cells.filter(cell => cell.value !== null && Number.isFinite(cell.value))

const datumActions = drilldown ?
availableCells.map(cell => createChartDatumAction(
  createLumenHeatmapDatumActivation(cell),
  `${cell.xLabel ?? cell.x} · ${cell.yLabel ?? cell.y}: ${cell.label ?? formatValue(cell.value ?? 0)}`,
  resolvedLabels
)) :
[]

---

<Chart class:list={['ui-heatmap', classProp, className]} {caption} {description} {heading} {summary} {...rest} data-ui-chart-activation={drilldown || undefined}>
  {!hasData && <p class="ui-chart__empty" role="status">{resolvedLabels.empty}</p>}
  <div aria-label={resolvedLabels.chartData} class="ui-chart__plot" role="region" tabindex="0" hidden={!hasData}><svg aria-hidden="true" viewBox={`0 0 ${geometry.width} ${geometry.height}`}><g class="
    ui-heatmap__cells
  "
                                                                                                                                                                                              >{availableCells.map((cell, index) => <rect data-ui-chart-datum={datumActions[index]?.serialized} height={Math.max(0, cell.height - 2)} opacity={Math.max(0.12, cell.ratio)} width={Math.max(0, cell.width - 2)} x={cell.xCoordinate + 1} y={cell.yCoordinate + 1}><title>{`${cell.xLabel ?? cell.x} · ${cell.yLabel ?? cell.y}: ${cell.label ?? formatValue(cell.value ?? 0)}`}</title></rect>)}</g></svg></div>
  {showTable && <details class="ui-chart__data"><summary>{resolvedLabels.viewData}</summary><div><table><thead><tr><th scope="col">{resolvedLabels.column}</th><th scope="col">{resolvedLabels.row}</th><th scope="col">{resolvedLabels.value}</th></tr></thead><tbody>{data.map(cell => <tr><th scope="row">{cell.xLabel ?? cell.x}</th><td>{cell.yLabel ?? cell.y}</td><td>{cell.label ?? (cell.value === null || !Number.isFinite(cell.value) ? resolvedLabels.notAvailable : formatValue(cell.value))}</td></tr>)}</tbody></table></div></details>}
  {drilldown && <ChartDatumActions actions={datumActions} label={resolvedLabels.exploreData} />}
</Chart>

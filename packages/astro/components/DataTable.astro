---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<div
  class:list={[
    'ui-data-table',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</div>

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'article'> {
  class?: string
  className?: string
  from?: 'user' | 'assistant'
  glass?: boolean
}

const {
  class: classProp = '',
  className = '',
  from = 'assistant',
  glass = false,
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<article
  data-from={from}
  class:list={[
    'ui-bubble',
    from === 'user' && 'ui-bubble--user',
    glass && 'ui-bubble--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</article>

---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'article'> {
  class?: string
  className?: string
  from?: 'user' | 'assistant'
  glass?: boolean | 'subtle' | 'strong'
}

const {
  class: classProp = '',
  className = '',
  from = 'assistant',
  glass = false,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
    'ui-bubble',
    from === 'user' && 'ui-bubble--user',
    glass && 'ui-bubble--glass',
    glass === 'subtle' && 'ui-glass-subtle',
    glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<article
  data-from={from}
  class:list={classList}
  {...passthrough}
>
  <slot />
</article>

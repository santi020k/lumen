---
import type { HTMLAttributes } from 'astro/types'

import {
  createLumenScatterGeometry,
  formatLumenChartSummary,
  getLumenChartTicks,
  getLumenChartToneClassName,
  type LumenChartScaleType,
  type LumenChartSeries,
  scaleLumenChartValue } from '@santi020k/lumen-core'

import Chart from './Chart.astro'

interface Props extends HTMLAttributes<'figure'> {
  caption?: string
  class?: string | null
  className?: string
  description?: string
  emptyLabel?: string
  formatValue?: (value: number) => string
  heading?: string
  series: readonly LumenChartSeries[]
  showLegend?: boolean
  showTable?: boolean
  summary?: string
  xScale?: Exclude<LumenChartScaleType, 'categorical'>
}

const {
  caption,
  class: classProp = '',
  className = '',
  description,
  emptyLabel = 'No chart data available.',
  formatValue = String,
  heading,
  series,
  showLegend = series.length > 1,
  showTable = true,
  summary: summaryProp,
  xScale = 'linear',
  ...rest
} = Astro.props

const geometry = createLumenScatterGeometry(series, { xScale })

const projectedSeries = series.map(item => ({
  ...item,
  data: geometry.points.filter(point => point.seriesId === item.id)
})).filter(item => item.data.length > 0)

const hasData = geometry.points.length > 0
const summary = summaryProp ?? formatLumenChartSummary(projectedSeries, formatValue)
const xTicks = getLumenChartTicks(geometry.xDomain)
const yTicks = getLumenChartTicks(geometry.domain)
---

<Chart class:list={['ui-scatter-chart', classProp, className]} {caption} {description} {heading} {summary} {...rest}>
  {showLegend && hasData && <ul class="ui-chart__legend" aria-label="Chart legend">{series.map((item, index) => <li class={getLumenChartToneClassName(item.tone, index)}><span aria-hidden="true" />{item.label}</li>)}</ul>}
  {!hasData && <p class="ui-chart__empty" role="status">{emptyLabel}</p>}
  <div class="ui-chart__plot" hidden={!hasData}>
    <svg aria-hidden="true" viewBox={`0 0 ${geometry.width} ${geometry.height}`}>
      <g class="ui-chart__grid">{yTicks.map(tick => {
 const y = scaleLumenChartValue(tick, geometry.domain, geometry.height - 44, 44)

 return <><line x1="44" x2={geometry.width - 44} y1={y} y2={y}/><text x="36" y={y}>{formatValue(tick)}</text></>
})}</g>
      <g class="ui-chart__axis-labels">{xTicks.map(tick => {
 const x = scaleLumenChartValue(tick, geometry.xDomain, 44, geometry.width - 44)

 return <text text-anchor="middle" x={x} y={geometry.height - 14}>{formatValue(tick)}</text>
})}</g>
      <g class="ui-scatter-chart__marks">{geometry.points.map(point => <circle class={getLumenChartToneClassName(point.tone)} cx={point.xCoordinate} cy={point.yCoordinate} r={point.radius}><title>{`${point.xLabel ?? point.x} · ${point.seriesLabel}: ${point.label ?? formatValue(point.y ?? 0)}`}</title></circle>)}</g>
    </svg>
  </div>
  {showTable && hasData && <details class="ui-chart__data"><summary>View chart data</summary><div><table><thead><tr><th scope="col">X</th><th scope="col">Series</th><th scope="col">Value</th><th scope="col">Size</th></tr></thead><tbody>{geometry.points.map(point => <tr><th scope="row">{point.xLabel ?? point.x}</th><td>{point.seriesLabel}</td><td>{point.label ?? formatValue(point.y ?? 0)}</td><td>{point.size === undefined ? 'Not available' : formatValue(point.size)}</td></tr>)}</tbody></table></div></details>}
</Chart>

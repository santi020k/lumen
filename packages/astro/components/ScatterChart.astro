---
import type { HTMLAttributes } from 'astro/types'

import { createLumenChartDatumActivation,
  createLumenScatterGeometry,
  createLumenScatterReferences,
  formatLumenChartSummary,
  getLumenChartTicks,
  getLumenChartToneClassName,
  getLumenScatterXTicks,
  type LumenChartDomain,
  type LumenChartLabels,
  type LumenChartSeries,
  type LumenScatterReference,
  type LumenScatterScaleType,
  resolveLumenChartLabels,
  scaleLumenChartValue,  scaleLumenScatterX } from '@santi020k/lumen-core'

import { createChartDatumAction } from '../runtime/chart-actions'

import Chart from './Chart.astro'
import ChartDatumActions from './ChartDatumActions.astro'

interface Props extends HTMLAttributes<'figure'> {
  caption?: string
  class?: string | null
  className?: string
  description?: string
  drilldown?: boolean
  emptyLabel?: string
  formatValue?: (value: number) => string
  formatX?: (value: number | string) => string
  formatY?: (value: number) => string
  xDomain?: Partial<LumenChartDomain>
  domain?: Partial<LumenChartDomain>
  references?: readonly LumenScatterReference[]
  heading?: string
  labels?: Partial<LumenChartLabels>
  series: readonly LumenChartSeries[]
  showLegend?: boolean
  showTable?: boolean
  summary?: string
  xScale?: LumenScatterScaleType
}

const {
  caption,
  class: classProp = '',
  className = '',
  description,
  drilldown = false,
  emptyLabel,
  formatValue = String,
  formatX = String,
  formatY = formatValue,
  xDomain,
  domain,
  references = [],
  heading,
  labels,
  series,
  showLegend = series.length > 1,
  showTable = true,
  summary: summaryProp,
  xScale = 'linear',
  ...rest
} = Astro.props

const plotId = `ui-scatter-${crypto.randomUUID()}`
const geometry = createLumenScatterGeometry(series, { xScale, ...(xDomain ? { xDomain } : {}), ...(domain ? { domain } : {}) })
const referenceGeometry = createLumenScatterReferences(references, geometry, xScale)
const resolvedLabels = resolveLumenChartLabels(labels)

const projectedSeries = series.map(item => ({
  ...item,
  data: geometry.points.filter(point => point.seriesId === item.id)
})).filter(item => item.data.length > 0)

const hasData = geometry.points.length > 0
const summary = summaryProp ?? formatLumenChartSummary(projectedSeries, formatY, resolvedLabels)
const xTicks = getLumenScatterXTicks(geometry.xDomain, xScale)
const yTicks = getLumenChartTicks(geometry.domain)

const datumActions = drilldown ?
geometry.points.map(point => createChartDatumAction(
  createLumenChartDatumActivation(point.seriesId, point),
  `${point.xLabel ?? formatX(point.x)} · ${point.seriesLabel}: ${point.label ?? formatY(point.y ?? 0)}`,
  resolvedLabels
)) :
[]

---

<Chart class:list={['ui-scatter-chart', classProp, className]} {caption} {description} {heading} {summary} {...rest} data-ui-chart-activation={drilldown || undefined}>
  {showLegend && hasData && <ul class="ui-chart__legend" aria-label={resolvedLabels.chartLegend}>{series.map((item, index) => <li class={getLumenChartToneClassName(item.tone, index)}><span aria-hidden="true" />{item.label}</li>)}</ul>}
  {!hasData && <p class="ui-chart__empty" role="status">{emptyLabel ?? resolvedLabels.empty}</p>}
  <div aria-label={resolvedLabels.chartData} class="ui-chart__plot" role="region" tabindex="0" hidden={!hasData}>
    <svg aria-hidden="true" viewBox={`0 0 ${geometry.width} ${geometry.height}`}>
      <defs><clipPath id={plotId}><rect x="44" y="44" width={geometry.width - 88} height={geometry.height - 88} /></clipPath></defs>
      <g class="ui-chart__grid">{yTicks.map(tick => {
 const y = scaleLumenChartValue(tick, geometry.domain, geometry.height - 44, 44)

 return <><line x1="44" x2={geometry.width - 44} y1={y} y2={y}/><text x="36" y={y}>{formatY(tick)}</text></>
})}</g>
      <g class="ui-chart__axis-labels">{xTicks.map(tick => {
 const x = scaleLumenScatterX(tick, geometry.xDomain, 44, geometry.width - 44, xScale)

 return <text text-anchor="middle" x={x} y={geometry.height - 14}>{formatX(tick)}</text>
})}</g>
      <g class="ui-scatter-chart__references" clip-path={`url(#${plotId})`}>{referenceGeometry.map(reference => reference.region ?
        <rect x={Math.min(reference.x1, reference.x2)} y={Math.min(reference.y1, reference.y2)} width={Math.abs(reference.x2 - reference.x1)} height={Math.abs(reference.y2 - reference.y1)}><title>{reference.label}</title></rect> :
        <line x1={reference.x1} x2={reference.x2} y1={reference.y1} y2={reference.y2}><title>{reference.label}</title></line>)}</g>
      <g class="ui-scatter-chart__marks" clip-path={`url(#${plotId})`}>{geometry.points.map((point, index) => <circle data-ui-chart-datum={datumActions[index]?.serialized} class={getLumenChartToneClassName(point.tone)} cx={point.xCoordinate} cy={point.yCoordinate} r={point.radius}><title>{`${point.xLabel ?? formatX(point.x)} · ${point.seriesLabel}: ${point.label ?? formatY(point.y ?? 0)}`}</title></circle>)}</g>
      {drilldown && geometry.points.map((point, index) => point.xCoordinate >= 44 && point.xCoordinate <= geometry.width - 44 && point.yCoordinate >= 44 && point.yCoordinate <= geometry.height - 44 && (
        <circle
class="ui-chart__datum-hit"
cx={point.xCoordinate}
cy={point.yCoordinate}
r={Math.max(10, point.radius)}
          data-ui-chart-datum={datumActions[index]?.serialized}
        />
      ))}

    </svg>
  </div>
  {referenceGeometry.length > 0 && (
<ul class="ui-scatter-chart__reference-labels">{referenceGeometry.map(reference => <li>{reference.label}</li>)}</ul>
)}
  {showTable && hasData && <details class="ui-chart__data"><summary>{resolvedLabels.viewData}</summary><div role="group" tabindex="0" aria-label={resolvedLabels.chartData}><table><thead><tr><th scope="col">{resolvedLabels.x}</th><th scope="col">{resolvedLabels.series}</th><th scope="col">{resolvedLabels.value}</th><th scope="col">{resolvedLabels.size}</th></tr></thead><tbody>{geometry.points.map(point => <tr><th scope="row">{point.xLabel ?? formatX(point.x)}</th><td>{point.seriesLabel}</td><td>{point.label ?? formatY(point.y ?? 0)}</td><td>{point.size === undefined || point.size === null || !Number.isFinite(point.size) ? resolvedLabels.notAvailable : formatValue(point.size)}</td></tr>)}</tbody></table></div></details>}
  {drilldown && <ChartDatumActions actions={datumActions} label={resolvedLabels.exploreData} />}
</Chart>

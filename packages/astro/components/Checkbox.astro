---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/checkbox.css'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

type HTMLInputAttributes = HTMLAttributes<'input'>

interface Props extends Omit<HTMLInputAttributes, 'type'> {
  class?: string | null
  className?: string
}

const { class: classProp = '', className = '', ...rest } = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-checkbox'
], classProp, className)
---

<input
  class:list={classList}
  type="checkbox"
  {...passthrough}
/>

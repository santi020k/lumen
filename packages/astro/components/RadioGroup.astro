---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'fieldset'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<fieldset
  data-ui-radio-group
  class:list={[
    'ui-radio-group',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</fieldset>

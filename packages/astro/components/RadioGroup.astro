---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'fieldset'> {
  class?: string | null
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
    'ui-radio-group'
], classProp, className)
---

<fieldset
  data-ui-radio-group
  class:list={classList}
  {...passthrough}
>
  <slot />
</fieldset>

---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
}

const {
  'aria-hidden': ariaHidden,
  'aria-label': ariaLabel,
  'aria-labelledby': ariaLabelledby,
  class: classProp = '',
  className = '',
  role,
  ...rest
} = Astro.props

const isAccessible = Boolean(ariaLabel || ariaLabelledby)

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-skeleton'
], classProp, className)
---

<div
  aria-hidden={ariaHidden ?? (isAccessible ? undefined : 'true')}
  aria-label={ariaLabel}
  aria-labelledby={ariaLabelledby}
  class:list={classList}
  role={role ?? (isAccessible ? 'status' : undefined)}
  {...passthrough}
>
  <slot />
</div>

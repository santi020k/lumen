---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'section'> {
  class?: string | null
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  variant?: 'compact' | 'default'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  variant = 'default',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-empty',
  variant === 'compact' && 'ui-empty--compact',
  glass && 'ui-empty--glass',
  glass === 'subtle' && 'ui-glass-subtle',
  glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<section
  class:list={classList}
  {...passthrough}
>
  <slot />
</section>

---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'section'> {
  class?: string
  className?: string
  glass?: boolean | 'subtle' | 'strong'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
    'ui-empty',
    glass && 'ui-empty--glass',
    glass === 'subtle' && 'ui-glass-subtle',
    glass === 'strong' && 'ui-glass-strong'
], classProp, className)
---

<section
  class:list={classList}
  {...passthrough}
>
  <slot />
</section>

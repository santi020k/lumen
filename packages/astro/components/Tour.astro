---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-tour'
], classProp, className)
---

<div
  class:list={classList}
  data-ui-tour
  hidden
  {...passthrough}
>
  <div aria-hidden="true" class="ui-tour__backdrop" data-ui-tour-backdrop></div>
  <div class="ui-tour__popover" data-ui-tour-popover role="dialog" aria-modal="false">
    <slot />
  </div>
</div>

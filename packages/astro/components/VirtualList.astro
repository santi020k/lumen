---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
}

const { class: classProp = '', className = '', ...rest } = Astro.props
const passthrough = rest as Record<string, unknown>
---

<div class:list={['ui-virtual-list', classProp, className]} data-ui-virtual-list {...passthrough}>
  <slot />
</div>

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  class?: string
  className?: string
  glass?: boolean
}

const { class: classProp = '', className = '', glass = false, ...rest } = Astro.props
const passthrough = rest as Record<string, unknown>
---

<div class:list={['ui-virtual-list', glass && 'ui-virtual-list--glass', classProp, className]} data-ui-virtual-list {...passthrough}>
  <slot />
</div>

---
import type { HTMLAttributes } from 'astro/types'

import {
  formatLumenImageComparisonValue,
  type LumenImageComparisonMode,
  normalizeLumenImageComparisonMode,
  normalizeLumenImageComparisonRatio,
  normalizeLumenImageComparisonValue,
  resolveLumenAstroProps
} from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'figure'> {
  afterLabel?: string
  beforeLabel?: string
  class?: string | null
  className?: string
  disabled?: boolean
  fit?: 'contain' | 'cover'
  label: string
  locale?: string
  mode?: LumenImageComparisonMode
  name?: string
  ratio?: number
  value?: number
}

const {
  afterLabel = 'After', beforeLabel = 'Before', class: classProp = '', className = '',
  disabled = false, fit = 'cover', label, locale, mode: requestedMode = 'reveal', name, ratio = 16 / 9, value = 50,
  ...rest
} = Astro.props

const mode = normalizeLumenImageComparisonMode(requestedMode)
const position = normalizeLumenImageComparisonValue(value)
const aspectRatio = normalizeLumenImageComparisonRatio(ratio)
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-image-comparison'], classProp, className)
---

<figure
  class:list={classList}
  data-ui-image-comparison
  data-after-label={afterLabel}
  data-disabled={disabled ? 'true' : undefined}
  data-fit={fit}
  data-mode={mode}
  data-locale={locale}
  {...passthrough}
>
  <div class="ui-image-comparison__frame" style={`--ui-image-comparison-position: ${position}%; --ui-image-comparison-ratio: ${aspectRatio}`}>
    <div class="ui-image-comparison__before" hidden={mode === 'after'}><slot name="before" /></div>
    <div class="ui-image-comparison__after" hidden={mode === 'before'}><slot name="after" /></div>
    <div aria-hidden="true" class="ui-image-comparison__divider"></div>
  </div>
  <div aria-hidden="true" class="ui-image-comparison__labels"><span hidden={mode === 'after'}>{beforeLabel}</span><span hidden={mode === 'before'}>{afterLabel}</span></div>
  <figcaption class="ui-image-comparison__caption">
    <label class="ui-image-comparison__control" hidden={mode !== 'reveal'}>
      <span>{label}</span>
      <input
        aria-valuetext={formatLumenImageComparisonValue(position, afterLabel, locale)}
        class="ui-slider ui-image-comparison__range"
        data-ui-image-comparison-input
        disabled
        max="100"
        min="0"
        name={name}
        step="1"
        type="range"
        value={position}
      />
    </label>
    <slot />
  </figcaption>
</figure>

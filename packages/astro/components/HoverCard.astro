---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'aside'> {
  class?: string
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<aside
  data-ui-hover-card
  class:list={[
    'ui-hover-card',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</aside>

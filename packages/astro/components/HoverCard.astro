---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'aside'> {
  class?: string
  className?: string
  glass?: boolean | 'subtle' | 'strong'
  surface?: 'default' | 'glass'
}

const {
  class: classProp = '',
  className = '',
  glass = false,
  surface = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
const resolvedSurface = glass || surface === 'glass' ? 'glass' : surface
---

<aside
  data-surface={resolvedSurface}
  data-ui-hover-card
  class:list={[
    'ui-hover-card',
    resolvedSurface === 'glass' && 'ui-hover-card--glass',
    glass === 'subtle' && 'ui-glass-subtle',
    glass === 'strong' && 'ui-glass-strong',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</aside>

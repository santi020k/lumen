---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'aside'> {
  class?: string
  className?: string
  surface?: 'default' | 'glass'
}

const {
  class: classProp = '',
  className = '',
  surface = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<aside
  data-surface={surface}
  data-ui-hover-card
  class:list={[
    'ui-hover-card',
    surface === 'glass' && 'ui-hover-card--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</aside>

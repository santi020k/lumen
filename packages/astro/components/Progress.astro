---
import type { HTMLAttributes } from 'astro/types'

import { normalizeLumenProgress, resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  max?: number
  value?: number
}

const { class: classProp = '', className = '', max = 100, value = 0, ...rest } = Astro.props
const { max: safeMax, percentage, value: safeValue } = normalizeLumenProgress(max, value)

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-progress'
], classProp, className)
---

<div
  aria-valuemax={safeMax}
  aria-valuemin="0"
  aria-valuenow={safeValue}
  class:list={classList}
  data-ui-progress
  role="progressbar"
  {...passthrough}
>
  <span
    class="ui-progress__bar"
    data-slot="progress-indicator"
    style={`width: ${percentage}%`}
  >
  </span>
</div>

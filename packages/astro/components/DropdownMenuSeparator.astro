---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/dropdown-menu-separator.css'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
}

const {
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(
  rest,
  ['ui-menu__separator'],
  classProp,
  className
)
---

<div role="separator" class:list={classList} {...passthrough} />

---
import type { HTMLAttributes } from 'astro/types'

import '../styles/foundation.css'
import '../styles/components/scroll-progress.css'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  class?: string | null
  className?: string
  targetId?: string
  position?: 'bottom' | 'top'
}

const {
  'aria-label': ariaLabel = 'Reading progress',
  class: classProp = '',
  className = '',
  position = 'top',
  targetId,
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(rest, [
  'ui-scroll-progress',
  position === 'bottom' && 'ui-scroll-progress--bottom'
], classProp, className)
---

<div
  aria-label={ariaLabel}
  aria-valuemax="100"
  aria-valuemin="0"
  aria-valuenow="0"
  class:list={classList}
  data-position={position}
  data-ui-scroll-progress
  data-ui-scroll-progress-target={targetId}
  role="progressbar"
  {...passthrough}
>
  <span class="ui-scroll-progress__bar"></span>
</div>

---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'menu'> {
  class?: string
  className?: string
  surface?: 'default' | 'glass'
}

const {
  class: classProp = '',
  className = '',
  surface = 'default',
  ...rest
} = Astro.props

const passthrough = rest as Record<string, unknown>
---

<menu
  data-surface={surface}
  data-ui-dropdown-menu
  class:list={[
    'ui-menu',
    surface === 'glass' && 'ui-menu--glass',
    classProp,
    className
  ]}
  {...passthrough}
>
  <slot />
</menu>

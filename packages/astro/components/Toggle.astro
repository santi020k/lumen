---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  class?: string | null
  className?: string
  controlled?: boolean
  pressed?: boolean
}

const {
  class: classProp = '',
  className = '',
  controlled = false,
  pressed = false,
  type = 'button',
  ...rest
} = Astro.props
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-toggle'], classProp, className)
---

<button
  aria-pressed={pressed}
  class:list={classList}
  data-ui-controlled={controlled || undefined}
  data-ui-toggle
  type={type}
  {...passthrough}
>
  <slot />
</button>

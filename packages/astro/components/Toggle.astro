---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  class?: string
  className?: string
  pressed?: boolean
}

const { class: classProp = '', className = '', pressed = false, type = 'button', ...rest } = Astro.props
const passthrough = rest as Record<string, unknown>
---

<button
  aria-pressed={pressed}
  class:list={['ui-toggle', pressed && 'ui-toggle--pressed', classProp, className]}
  data-ui-toggle
  type={type}
  {...passthrough}
>
  <slot />
</button>

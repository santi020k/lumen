---
import { resolveLumenAstroProps } from '@santi020k/lumen-core'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  class?: string
  className?: string
  pressed?: boolean
}

const { class: classProp = '', className = '', pressed = false, type = 'button', ...rest } = Astro.props
const { classList, passthrough } = resolveLumenAstroProps(rest, ['ui-toggle', pressed && 'ui-toggle--pressed'
], classProp, className)
---

<button
  aria-pressed={pressed}
  class:list={classList}
  data-ui-toggle
  type={type}
  {...passthrough}
>
  <slot />
</button>

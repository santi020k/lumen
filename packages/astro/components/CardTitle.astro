---
import type { HTMLAttributes } from 'astro/types'

import { resolveLumenAstroProps } from '@santi020k/lumen-core'

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'h2' | 'h3' | 'h4'
  class?: string | null
  className?: string
}

const {
  as: Tag = 'div',
  class: classProp = '',
  className = '',
  ...rest
} = Astro.props

const { classList, passthrough } = resolveLumenAstroProps(
  rest, ['ui-card__title'], classProp, className
)
---

<Tag class:list={classList} data-slot="card-title" {...passthrough}>
  <slot />
</Tag>

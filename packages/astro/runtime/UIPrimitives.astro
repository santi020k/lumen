  const focusSelectOption = (
    root: HTMLElement,
    key: string,
    currentItem?: HTMLElement
  ): void => {
    const items = getEnabledSelectItems(root)

    if (!items.length) return

    const current = currentItem ?? getSelectedSelectItem(root) ?? items[0]
    const currentIndex = items.indexOf(current)
    const nextItem = items[getLoopedIndex(key, Math.max(0, currentIndex), items.length, ['ArrowDown'])]

    nextItem?.focus()
  }

  const focusLoopedOption = (
    items: HTMLElement[],
    currentItem: HTMLElement,
    key: string
  ): void => {
    const visibleItems = getVisibleItems(items)

    if (!visibleItems.length) return

    const currentIndex = visibleItems.indexOf(currentItem)
    const nextItem = visibleItems[getLoopedIndex(key, Math.max(0, currentIndex), visibleItems.length, ['ArrowDown'])]

    nextItem?.focus()

---

/**
 * Astro UI primitives controller.
 *
 * Provides progressive enhancement for local UI components without
 * adding a framework runtime.
 */
---

<script>
import {
  createLumenKanbanMoveDetail,
  createThemeFromHue,
  exportThemeCss,
  exportThemeDesignTokens,
  exportThemeFigmaVariables,
  formatLumenLanguageLabel,
  getLumenLocalePair,
  getLumenPhoneCountry,
  getLumenRichTextShortcut,
  isLumenRichTextToggleCommand,
  type LumenLocaleOption,
  type LumenRichTextChangeDetail,
  type LumenRichTextCommandDetail,
  type LumenThemeTokens,
  lumenTokenNames,
  normalizeLumenLocales,
  resolveLumenPhoneNumber } from '@santi020k/lumen-core'

/* eslint-disable complexity */
/* Stateful DOM handlers stay local so Astro consumers do not need a framework runtime. */
type ThemeBuilderExportFormat = 'css' | 'figma' | 'tokens'

type ThemeBuilderMode = 'generated' | 'manual'

type ThemeBuilderScheme = 'dark' | 'light'

interface RichTextCommandDocument {
  execCommand?: (command: string, showUi?: boolean, value?: string) => boolean
  queryCommandState?: (command: string) => boolean
  queryCommandValue?: (command: string) => string
}

const focusableSelector = [
  'a[href]',
  'button:not([disabled])',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

const disclosureSelector = '[data-ui-popover], [data-ui-dropdown-menu], [data-ui-hover-card]'

const fieldControlSelector = [
  'input:not([type="hidden"])',
  'select',
  'textarea',
  '[contenteditable="true"]',
  '[role="combobox"]',
  '[role="listbox"]',
  '[role="spinbutton"]',
  '[role="textbox"]'
].join(',')

const fieldDescriptionSelector = '[data-ui-field-hint], [data-ui-field-error], .ui-field__hint, .ui-field__error'
const fieldErrorSelector = '[data-ui-field-error], .ui-field__error'

const formControlSelector = [
  'input:not([type="hidden"])',
  'select',
  'textarea'
].join(',')

const phoneInputSelector = '[data-ui-phone-input]'

const initPhoneInputs = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>(phoneInputSelector)) {
    if (root.dataset.uiPhoneBound === 'true') continue

    const countrySelect = root.querySelector<HTMLSelectElement>('.ui-phone-input__country')
    const numberInput = root.querySelector<HTMLInputElement>('.ui-phone-input__number')

    if (!countrySelect || !numberInput) continue

    root.dataset.uiPhoneBound = 'true'

    const locale = root.lang || document.documentElement.lang || undefined
    const phoneOptions = locale ? { locale } : {}

    const commit = (): void => {
      const selectedOption = countrySelect.selectedOptions[0]
      const regionCode = selectedOption?.dataset.region ?? countrySelect.value
      const country = getLumenPhoneCountry(regionCode, phoneOptions)

      if (!country) return

      const detectedPhoneNumber = resolveLumenPhoneNumber(country, numberInput.value, phoneOptions)

      const detectedCountryIsAllowed = Array.from(countrySelect.options).some(option => (
        option.value === detectedPhoneNumber.country.regionCode
      ))

      const phoneNumber = detectedCountryIsAllowed ?
        detectedPhoneNumber :
        resolveLumenPhoneNumber(
          country,
          detectedPhoneNumber.nationalNumber.startsWith('+') ?
            detectedPhoneNumber.nationalNumber.slice(1) :
            detectedPhoneNumber.nationalNumber,
          phoneOptions
        )

      const hasInput = phoneNumber.nationalNumber.length > 0
      const invalidMessage = root.dataset.invalidNumberMessage ?? 'Enter a complete phone number.'

      numberInput.value = phoneNumber.nationalNumber

      countrySelect.value = phoneNumber.country.regionCode

      numberInput.setCustomValidity(hasInput && !phoneNumber.isValid ? invalidMessage : '')

      numberInput.setAttribute('aria-invalid', String(hasInput && !phoneNumber.isValid))

      root.dataset.e164 = phoneNumber.e164 ?? ''

      root.dataset.valid = String(phoneNumber.isValid)

      root.dispatchEvent(new CustomEvent('ui:phone-change', {
        bubbles: true,
        detail: phoneNumber
      }))
    }

    countrySelect.addEventListener('change', commit)

    numberInput.addEventListener('input', commit)

    if (numberInput.value) commit()
  }
}

const validityMessageAttributes = [
  ['valueMissing', 'data-error-required'],
  ['typeMismatch', 'data-error-type'],
  ['patternMismatch', 'data-error-pattern'],
  ['tooShort', 'data-error-too-short'],
  ['tooLong', 'data-error-too-long'],
  ['rangeUnderflow', 'data-error-min'],
  ['rangeOverflow', 'data-error-max'],
  ['stepMismatch', 'data-error-step'],
  ['badInput', 'data-error-bad-input'],
  ['customError', 'data-error-custom']
] as const

/**
   * Top-layer mode: when the browser supports both the Popover API and CSS
   * anchor positioning, floating panels are promoted to [popover] so they
   * escape overflow clipping and get collision-aware placement via
   * position-try-fallbacks. Other browsers keep the absolute fallback.
   */
const supportsAnchoredPopovers =
  typeof HTMLElement !== 'undefined' &&
  'showPopover' in HTMLElement.prototype &&
  typeof CSS !== 'undefined' &&
  CSS.supports('anchor-name: --ui-anchor') &&
  CSS.supports('position-area: block-end')

let uiAnchorCount = 0
let uiTabsCount = 0
const nextAnchorName = (): string => `--ui-anchor-${++uiAnchorCount}`

const isElementVisible = (element: HTMLElement): boolean => typeof element.checkVisibility === 'function' ?
  element.checkVisibility() :
  element.offsetParent !== null

const getFocusable = (root: ParentNode): HTMLElement[] => [...root.querySelectorAll<HTMLElement>(focusableSelector)]
  .filter(element => !element.hasAttribute('hidden') && isElementVisible(element))

const getPanel = (trigger: HTMLElement): HTMLElement | null => {
  const controls = trigger.getAttribute('aria-controls')

  if (controls) {
    return document.getElementById(controls)
  }

  return trigger.nextElementSibling instanceof HTMLElement ? trigger.nextElementSibling : null
}

const getLoopedIndex = (
  key: string,
  currentIndex: number,
  itemCount: number,
  forwardKeys: readonly string[]
): number => {
  const lastIndex = itemCount - 1

  if (key === 'Home') return 0

  if (key === 'End') return lastIndex

  if (forwardKeys.includes(key)) return (currentIndex + 1) % itemCount

  return (currentIndex - 1 + itemCount) % itemCount
}

const setOpen = (trigger: HTMLElement, panel: HTMLElement, open: boolean): void => {
  trigger.setAttribute('aria-expanded', String(open))

  if (panel.hasAttribute('popover')) {
    try {
      if (open) {
        panel.hidden = false

        panel.showPopover()
      } else {
        panel.hidePopover()
      }
    } catch {
      /* popover already in requested state */
    }

    panel.hidden = !open
  } else {
    panel.hidden = !open
  }

  panel.dataset.state = open ? 'open' : 'closed'
}

const closeDisclosure = (root: HTMLElement): void => {
  const trigger = root.querySelector<HTMLElement>('[data-ui-trigger]')

  if (!trigger) return

  const panel = getPanel(trigger)

  if (!panel) return

  setOpen(trigger, panel, false)
}

const initDisclosures = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>(disclosureSelector)) {
    const trigger = root.querySelector<HTMLElement>('[data-ui-trigger]')

    if (!trigger) continue

    const panel = getPanel(trigger)

    if (!panel || trigger.dataset.uiBound === 'true') continue

    trigger.dataset.uiBound = 'true'

    trigger.setAttribute('aria-haspopup', trigger.getAttribute('aria-haspopup') ?? 'menu')

    if (supportsAnchoredPopovers) {
      const anchorName = nextAnchorName()

      panel.hidden = false

      panel.setAttribute('popover', 'manual')

      trigger.style.setProperty('anchor-name', anchorName)

      panel.style.setProperty('position-anchor', anchorName)
    }

    setOpen(trigger, panel, trigger.getAttribute('aria-expanded') === 'true')

    trigger.addEventListener('click', () => {
      setOpen(trigger, panel, trigger.getAttribute('aria-expanded') !== 'true')
    })

    trigger.addEventListener('keydown', event => {
      if (event.key !== 'ArrowDown' && event.key !== 'Enter' && event.key !== ' ') return

      event.preventDefault()

      setOpen(trigger, panel, true)

      getFocusable(panel)[0]?.focus()
    })

    panel.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        event.preventDefault()

        setOpen(trigger, panel, false)

        trigger.focus({ preventScroll: true })

        return
      }

      if (root.hasAttribute('data-ui-cascader')) return

      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Home' && event.key !== 'End') return

      const items = getFocusable(panel)

      if (!items.length) return

      event.preventDefault()

      const currentIndex = items.indexOf(document.activeElement as HTMLElement)
      const nextItem = items[getLoopedIndex(event.key, Math.max(0, currentIndex), items.length, ['ArrowDown'])]

      nextItem?.focus()
    })

    if (root.hasAttribute('data-ui-dropdown-menu')) {
      panel.addEventListener('click', event => {
        const item = event.target instanceof Element ?
          event.target.closest<HTMLElement>('[role="menuitem"]') :
          null

        if (!item || item.matches(':disabled, [aria-disabled="true"]')) return

        setOpen(trigger, panel, false)
      })
    }

    if (root.hasAttribute('data-ui-hover-card')) {
      root.addEventListener('mouseenter', () => setOpen(trigger, panel, true))

      root.addEventListener('mouseleave', () => setOpen(trigger, panel, false))
    }
  }
}

const initTooltips = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('.ui-tooltip, [data-ui-tooltip]')) {
    if (root.dataset.uiTooltipBound === 'true') continue

    const tip = root.querySelector<HTMLElement>('[role="tooltip"]')

    const triggerSelector = [
      '[data-ui-tooltip-trigger]',
      '[data-ui-trigger]',
      'button',
      'a[href]',
      'input:not([type="hidden"])',
      'select',
      'textarea',
      '[tabindex]:not([tabindex="-1"])'
    ].join(', ')

    const trigger = root.querySelector<HTMLElement>(triggerSelector)

    if (!tip) continue

    root.dataset.uiTooltipBound = 'true'

    if (trigger && !trigger.closest('[role="tooltip"]')) {
      if (!tip.id) {
        tip.id = `ui-tooltip-${crypto.randomUUID()}`
      }

      const describedBy = new Set((trigger.getAttribute('aria-describedby') ?? '').split(/\s+/).filter(Boolean))

      describedBy.add(tip.id)

      trigger.setAttribute('aria-describedby', [...describedBy].join(' '))
    }

    if (supportsAnchoredPopovers) {
      const anchorName = nextAnchorName()

      tip.setAttribute('popover', 'manual')

      root.style.setProperty('anchor-name', anchorName)

      tip.style.setProperty('position-anchor', anchorName)

      let showTimer = 0

      const show = (delay: number): void => {
        window.clearTimeout(showTimer)

        showTimer = window.setTimeout(() => {
          try {
            tip.showPopover()
          } catch {
            /* already open */
          }
        }, delay)
      }

      const hide = (): void => {
        window.clearTimeout(showTimer)

        try {
          tip.hidePopover()
        } catch {
          /* already closed */
        }
      }

      root.addEventListener('mouseenter', () => show(250))

      root.addEventListener('mouseleave', hide)

      root.addEventListener('focusin', () => show(0))

      root.addEventListener('focusout', hide)

      root.addEventListener('keydown', event => {
        if (event.key === 'Escape') hide()
      })
    } else {
      /* WCAG 1.4.13: hover/focus tooltips must be dismissible with Escape. */
      root.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return

        tip.style.visibility = 'hidden'
      })

      root.addEventListener('mouseleave', () => {
        tip.style.removeProperty('visibility')
      })

      root.addEventListener('focusout', () => {
        tip.style.removeProperty('visibility')
      })
    }
  }
}

const initGlassTracking = (scope: ParentNode): void => {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

  for (const element of scope.querySelectorAll<HTMLElement>('[data-ui-glass-track]')) {
    if (element.dataset.uiGlassBound === 'true') continue

    element.dataset.uiGlassBound = 'true'

    element.addEventListener('pointermove', event => {
      const rect = element.getBoundingClientRect()

      if (!rect.width || !rect.height) return

      element.style.setProperty('--glass-x', `${(((event.clientX - rect.left) / rect.width) * 100).toFixed(1)}%`)

      element.style.setProperty('--glass-y', `${(((event.clientY - rect.top) / rect.height) * 100).toFixed(1)}%`)
    })

    element.addEventListener('pointerleave', () => {
      element.style.removeProperty('--glass-x')

      element.style.removeProperty('--glass-y')
    })
  }
}

const initDialogs = (scope: ParentNode): void => {
  const dialogSelector =
    '[data-ui-dialog], [data-ui-alert-dialog], [data-ui-drawer], [data-ui-sheet]'

  for (const dialog of scope.querySelectorAll<HTMLDialogElement>(dialogSelector)) {
    if (dialog.dataset.uiBound === 'true') continue

    dialog.dataset.uiBound = 'true'

    dialog.setAttribute('aria-modal', 'true')

    dialog.setAttribute('role', dialog.hasAttribute('data-ui-alert-dialog') ? 'alertdialog' : 'dialog')

    dialog.addEventListener('click', event => {
      if (event.target === dialog && !dialog.hasAttribute('data-ui-alert-dialog')) {
        dialog.close()
      }
    })

    dialog.addEventListener('close', () => {
      const triggerId = dialog.dataset.uiLastTrigger
      const trigger = triggerId ? document.getElementById(triggerId) : null

      if (trigger instanceof HTMLElement) {
        trigger.focus({ preventScroll: true })
      }
    })
  }

  const triggerSelector = [
    '[data-ui-dialog-trigger]',
    '[data-ui-alert-dialog-trigger]',
    '[data-ui-drawer-trigger]',
    '[data-ui-sheet-trigger]'
  ].join(', ')

  for (const trigger of scope.querySelectorAll<HTMLElement>(triggerSelector)) {
    if (trigger.dataset.uiBound === 'true') continue

    trigger.dataset.uiBound = 'true'

    trigger.setAttribute('aria-haspopup', 'dialog')

    trigger.addEventListener('click', () => {
      const targetId =
        trigger.dataset.uiDialogTrigger ??
        trigger.dataset.uiAlertDialogTrigger ??
        trigger.dataset.uiDrawerTrigger ??
        trigger.dataset.uiSheetTrigger

      if (!targetId) return

      const dialog = document.getElementById(targetId)

      if (!(dialog instanceof HTMLDialogElement)) return

      if (!trigger.id) {
        trigger.id = `ui-trigger-${crypto.randomUUID()}`
      }

      dialog.dataset.uiLastTrigger = trigger.id

      dialog.showModal()

      getFocusable(dialog)[0]?.focus({ preventScroll: true })
    })
  }

  const closeSelector = [
    '[data-ui-dialog-close]',
    '[data-ui-alert-dialog-close]',
    '[data-ui-drawer-close]',
    '[data-ui-sheet-close]'
  ].join(', ')

  for (const closeButton of scope.querySelectorAll<HTMLElement>(closeSelector)) {
    if (closeButton.dataset.uiBound === 'true') continue

    closeButton.dataset.uiBound = 'true'

    closeButton.addEventListener('click', () => {
      closeButton.closest<HTMLDialogElement>('dialog')?.close()
    })
  }
}

const getFieldControl = (root: HTMLElement): HTMLElement | null => {
  const controlId = root.dataset.uiFieldControl

  if (controlId) {
    const control = document.getElementById(controlId)

    if (control instanceof HTMLElement) return control
  }

  return root.querySelector<HTMLElement>(fieldControlSelector)
}

const getFieldDescriptionId = (element: HTMLElement): string => {
  if (!element.id) {
    element.id = `ui-field-description-${crypto.randomUUID()}`
  }

  return element.id
}

const getFieldRoot = (control: HTMLElement): HTMLElement | null => (
  control.closest<HTMLElement>('.ui-field, [data-ui-field]')
)

type NativeFormControl = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement

const isNativeFormControl = (element: EventTarget | null): element is NativeFormControl => (
  element instanceof HTMLInputElement ||
  element instanceof HTMLSelectElement ||
  element instanceof HTMLTextAreaElement
)

const getValidationMessage = (
  control: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
  field: HTMLElement | null
): string => {
  const validity = control.validity

  for (const [validityKey, attributeName] of validityMessageAttributes) {
    if (!validity[validityKey]) continue

    return control.getAttribute(attributeName) ??
      field?.getAttribute(attributeName) ??
      control.validationMessage
  }

  return control.validationMessage
}

const setFieldValidity = (
  control: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
  invalid: boolean,
  message = ''
): void => {
  const field = getFieldRoot(control)

  if (invalid) {
    control.setAttribute('aria-invalid', 'true')

    control.dataset.uiValidationInvalid = 'true'
  } else if (control.dataset.uiValidationInvalid === 'true') {
    control.removeAttribute('aria-invalid')

    delete control.dataset.uiValidationInvalid
  }

  if (!field) return

  field.dataset.invalid = String(invalid)

  for (const error of field.querySelectorAll<HTMLElement>(fieldErrorSelector)) {
    error.dataset.uiValidationErrorBound = 'true'

    error.hidden = !invalid

    error.textContent = invalid ? message : ''
  }
}

const validateControl = (
  control: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
  form: HTMLFormElement
): boolean => {
  form.dispatchEvent(new CustomEvent('ui:validate', {
    bubbles: true,
    detail: { control, form, value: control.value }
  }))

  const invalid = !control.validity.valid
  const message = invalid ? getValidationMessage(control, getFieldRoot(control)) : ''

  setFieldValidity(control, invalid, message)

  return !invalid
}

const getFormControls = (form: HTMLFormElement): NativeFormControl[] => [
  ...form.querySelectorAll<NativeFormControl>(formControlSelector)
].filter(control => control.form === form && !control.disabled)

const validateForm = (form: HTMLFormElement): Array<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement> => {
  const invalidControls: Array<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement> = []

  for (const control of getFormControls(form)) {
    if (!validateControl(control, form)) {
      invalidControls.push(control)
    }
  }

  return invalidControls
}

const initFields = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('.ui-field, [data-ui-field]')) {
    if (root.dataset.uiFieldBound === 'true') continue

    const control = getFieldControl(root)

    if (!control) continue

    root.dataset.uiFieldBound = 'true'

    const existingIds = control.getAttribute('aria-describedby')?.trim().split(/\s+/) ?? []
    const configuredIds = root.dataset.uiFieldDescribedby?.trim().split(/\s+/) ?? []

    const descriptionIds = [...root.querySelectorAll<HTMLElement>(fieldDescriptionSelector)]
      .map(element => getFieldDescriptionId(element))

    const describedBy = [...new Set([...existingIds, ...configuredIds, ...descriptionIds].filter(Boolean))]

    if (describedBy.length) {
      control.setAttribute('aria-describedby', describedBy.join(' '))
    }
  }
}

const initForms = (scope: ParentNode): void => {
  for (const form of scope.querySelectorAll<HTMLFormElement>('form[data-ui-form]')) {
    if (form.dataset.uiFormBound === 'true') continue

    form.dataset.uiFormBound = 'true'

    form.noValidate = true

    const setStatus = (status: 'error' | 'idle' | 'submitting'): void => {
      form.dataset.status = status

      if (status === 'submitting') form.setAttribute('aria-busy', 'true')
      else form.removeAttribute('aria-busy')
    }

    form.addEventListener('click', event => {
      const target = event.target

      if (!(target instanceof Element)) return

      const link = target.closest<HTMLAnchorElement>('[data-ui-error-summary] a[href^="#"]')
      const controlId = link?.hash.slice(1)
      const control = controlId ? document.getElementById(controlId) : null

      if (!link || !(control instanceof HTMLElement) || !form.contains(control)) return

      event.preventDefault()

      control.focus({ preventScroll: true })

      control.scrollIntoView({ behavior: 'smooth', block: 'center' })
    })

    form.addEventListener('focusout', event => {
      if (!isNativeFormControl(event.target) || event.target.form !== form) return

      const valid = validateControl(event.target, form)

      form.dispatchEvent(new CustomEvent(valid ? 'ui:valid' : 'ui:invalid', {
        bubbles: true,
        detail: valid ?
          { control: event.target, form } :
          { control: event.target, controls: [event.target], form }
      }))
    })

    form.addEventListener('submit', event => {
      if (form.dataset.status === 'submitting') {
        event.preventDefault()

        return
      }

      const invalidControls = validateForm(form)

      if (invalidControls.length) {
        event.preventDefault()

        setStatus('error')

        const firstInvalid = invalidControls[0]
        const errorSummary = form.querySelector<HTMLElement>('[data-ui-error-summary]:not([hidden])')

        form.dispatchEvent(new CustomEvent('ui:invalid', {
          bubbles: true,
          detail: { control: firstInvalid, controls: invalidControls, form }
        }))

        if (errorSummary) {
          errorSummary.focus({ preventScroll: true })
        } else {
          firstInvalid?.focus({ preventScroll: true })

          firstInvalid?.reportValidity()
        }

        return
      }

      form.dispatchEvent(new CustomEvent('ui:valid', {
        bubbles: true,
        detail: { controls: getFormControls(form), form }
      }))

      setStatus('submitting')

      queueMicrotask(() => {
        if (event.defaultPrevented) setStatus('idle')
      })
    })

    form.addEventListener('reset', () => {
      setStatus('idle')
    })
  }
}

const initPasswordFields = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-password-field]')) {
    if (root.dataset.uiPasswordBound === 'true') continue

    const input = root.querySelector<HTMLInputElement>('input')
    const toggle = root.querySelector<HTMLButtonElement>('[data-ui-password-toggle]')

    if (!input || !toggle) continue

    root.dataset.uiPasswordBound = 'true'

    const showLabel = toggle.dataset.showLabel ?? 'Show password'
    const hideLabel = toggle.dataset.hideLabel ?? 'Hide password'
    const visibleLabel = toggle.querySelector<HTMLElement>('[data-ui-password-toggle-label]')

    const setVisible = (visible: boolean): void => {
      input.type = visible ? 'text' : 'password'

      toggle.setAttribute('aria-label', visible ? hideLabel : showLabel)

      toggle.setAttribute('aria-pressed', String(visible))

      if (visibleLabel) visibleLabel.textContent = visible ? 'Hide' : 'Show'
    }

    toggle.addEventListener('click', () => {
      setVisible(input.type === 'password')

      input.focus({ preventScroll: true })
    })

    const form = input.form

    form?.addEventListener('reset', () => {
      setVisible(false)
    })

    if (form) {
      const hideAfterSuccess = (): void => {
        if (form.dataset.status === 'success') setVisible(false)
      }

      const observer = new MutationObserver(hideAfterSuccess)

      observer.observe(form, { attributeFilter: ['data-status'], attributes: true })

      hideAfterSuccess()
    }

    setVisible(false)
  }
}

const getListBoxSelectedValues = (select: HTMLSelectElement): string[] => [
  ...select.selectedOptions
].map(option => option.value)

const initListBoxes = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-list-box]')) {
    if (root.dataset.uiListBoxBound === 'true') continue

    const select = root.querySelector<HTMLSelectElement>('[data-ui-list-box-native]')
    const list = root.querySelector<HTMLElement>('[data-ui-list-box-list]')
    const options = [...(list?.querySelectorAll<HTMLElement>('[data-ui-list-box-option]') ?? [])]

    if (!select || !list || !options.length) continue

    root.dataset.uiListBoxBound = 'true'

    select.dataset.uiListBoxEnhanced = 'true'

    list.hidden = false

    let activeIndex = Math.max(
      0, options.findIndex(option => option.getAttribute('aria-disabled') !== 'true')
    )

    let typeahead = ''
    let typeaheadTimer = 0

    const syncActive = (): void => {
      options.forEach((option, index) => {
        option.id ||= `${select.id || 'ui-list-box'}-option-${index}`

        option.dataset.active = index === activeIndex ? 'true' : 'false'
      })

      const activeOption = options[activeIndex]

      if (activeOption) list.setAttribute('aria-activedescendant', activeOption.id)
    }

    const syncSelected = (): void => {
      const selectedValues = new Set(getListBoxSelectedValues(select))

      for (const option of options) {
        option.setAttribute('aria-selected', String(selectedValues.has(option.dataset.value ?? '')))
      }
    }

    const commitOption = (index: number): void => {
      const option = options[index]

      if (!option || option.getAttribute('aria-disabled') === 'true' || select.disabled) return

      const nativeOption = [...select.options].find(item => item.value === option.dataset.value)

      if (!nativeOption) return

      if (select.multiple) nativeOption.selected = !nativeOption.selected
      else select.value = nativeOption.value

      syncSelected()

      select.dispatchEvent(new Event('input', { bubbles: true }))

      select.dispatchEvent(new Event('change', { bubbles: true }))

      root.dispatchEvent(new CustomEvent('ui:list-box-change', {
        bubbles: true,
        detail: { values: getListBoxSelectedValues(select) }
      }))
    }

    const moveActive = (direction: 1 | -1): void => {
      let nextIndex = activeIndex

      for (const _option of options) {
        nextIndex = (nextIndex + direction + options.length) % options.length

        if (options[nextIndex]?.getAttribute('aria-disabled') !== 'true') {
          activeIndex = nextIndex

          syncActive()

          if (root.dataset.selectionFollowsFocus === 'true') commitOption(activeIndex)

          return
        }
      }
    }

    list.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown') {
        event.preventDefault()

        moveActive(1)
      } else if (event.key === 'ArrowUp') {
        event.preventDefault()

        moveActive(-1)
      } else if (event.key === 'Home') {
        event.preventDefault()

        activeIndex = Math.max(
          0, options.findIndex(option => option.getAttribute('aria-disabled') !== 'true')
        )

        syncActive()

        if (root.dataset.selectionFollowsFocus === 'true') commitOption(activeIndex)
      } else if (event.key === 'End') {
        event.preventDefault()

        for (let index = options.length - 1; index >= 0; index -= 1) {
          if (options[index]?.getAttribute('aria-disabled') !== 'true') {
            activeIndex = index

            break
          }
        }

        syncActive()

        if (root.dataset.selectionFollowsFocus === 'true') commitOption(activeIndex)
      } else if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault()

        commitOption(activeIndex)
      } else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
        typeahead += event.key.toLowerCase()

        window.clearTimeout(typeaheadTimer)

        typeaheadTimer = window.setTimeout(() => {
          typeahead = ''
        }, 700)

        const nextIndex = options.findIndex(
          option => option.getAttribute('aria-disabled') !== 'true' &&
            option.textContent?.trim().toLowerCase().startsWith(typeahead)
        )

        if (nextIndex >= 0) {
          activeIndex = nextIndex

          syncActive()

          if (root.dataset.selectionFollowsFocus === 'true') commitOption(activeIndex)
        }
      }
    })

    options.forEach((option, index) => {
      option.addEventListener('click', () => {
        activeIndex = index

        syncActive()

        commitOption(index)
      })
    })

    select.addEventListener('change', syncSelected)

    select.form?.addEventListener('reset', () => {
      window.setTimeout(() => {
        syncSelected()

        activeIndex = Math.max(
          0, options.findIndex(option => option.getAttribute('aria-selected') === 'true')
        )

        syncActive()
      })
    })

    syncSelected()

    syncActive()
  }
}

const initTabs = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-tabs]')) {
    if (root.dataset.uiBound === 'true') continue

    root.dataset.uiBound = 'true'

    const tabs = [...root.querySelectorAll<HTMLElement>('[role="tab"]')]
      .filter(tab => tab.closest('[data-ui-tabs]') === root)

    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')]
      .filter(panel => panel.closest('[data-ui-tabs]') === root)

    const tabList = tabs[0]?.closest<HTMLElement>('[role="tablist"]')

    const orientation = tabList?.getAttribute('aria-orientation') === 'vertical' ?
      'vertical' :
      'horizontal'

    if (!tabs.length || !panels.length) continue

    const rootId = root.id || `ui-tabs-${++uiTabsCount}`

    root.id = rootId

    for (const [index, tab] of tabs.entries()) {
      const panel = panels.find(candidate => (
        candidate.dataset.value && candidate.dataset.value === tab.dataset.value
      )) ?? panels[index]

      const value = tab.dataset.value ?? panel?.dataset.value ?? String(index)

      tab.dataset.value = value

      if (panel) {
        panel.dataset.value = value

        tab.id ||= `${rootId}-tab-${index + 1}`

        panel.id ||= `${rootId}-panel-${index + 1}`

        tab.setAttribute('aria-controls', panel.id)

        panel.setAttribute('aria-labelledby', tab.id)
      }
    }

    const activate = (tab: HTMLElement, emit = true): void => {
      const value = tab.dataset.value ?? ''
      const wasSelected = tab.getAttribute('aria-selected') === 'true'

      for (const [index, item] of tabs.entries()) {
        const selected = item === tab
        const panelId = item.getAttribute('aria-controls')
        const panel = panelId ? document.getElementById(panelId) : panels[index]

        item.setAttribute('aria-selected', String(selected))

        item.tabIndex = selected ? 0 : -1

        if (panel) {
          panel.hidden = !selected
        }
      }

      root.dataset.value = value

      if (!emit || wasSelected) return

      const storageKey = root.dataset.storageKey

      if (storageKey) {
        try {
          localStorage.setItem(storageKey, value)
        } catch {
          // Storage can be unavailable in privacy modes; tab selection should still work.
        }

        for (const otherRoot of document.querySelectorAll<HTMLElement>('[data-ui-tabs][data-storage-key]')) {
          if (otherRoot === root || otherRoot.dataset.storageKey !== storageKey || otherRoot.dataset.value === value) {
            continue
          }

          const matchingTab = [...otherRoot.querySelectorAll<HTMLElement>('[role="tab"]')]
            .find(candidate => candidate.closest('[data-ui-tabs]') === otherRoot && candidate.dataset.value === value)

          matchingTab?.click()
        }
      }

      root.dispatchEvent(new CustomEvent('ui:tabs-change', {
        bubbles: true,
        detail: { storageKey, value }
      }))
    }

    let storedValue: string | null = null

    if (root.dataset.storageKey) {
      try {
        storedValue = localStorage.getItem(root.dataset.storageKey)
      } catch {
        // Storage can be unavailable in privacy modes.
      }
    }

    const initialValue = storedValue ?? root.dataset.initialValue

    const initiallySelected = (
      initialValue ?
        tabs.find(tab => tab.dataset.value === initialValue) :
        undefined
    ) ?? tabs.find(tab => tab.getAttribute('aria-selected') === 'true') ?? tabs[0]

    if (initiallySelected) activate(initiallySelected, false)

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => activate(tab))

      tab.addEventListener('keydown', event => {
        const keys = orientation === 'vertical' ?
          ['ArrowUp', 'ArrowDown', 'Home', 'End'] :
          ['ArrowLeft', 'ArrowRight', 'Home', 'End']

        if (!keys.includes(event.key)) return

        event.preventDefault()

        const nextTab = tabs[
          getLoopedIndex(
            event.key,
            index,
            tabs.length,
            orientation === 'vertical' ? ['ArrowDown'] : ['ArrowRight']
          )
        ]

        if (nextTab) {
          activate(nextTab)

          nextTab.focus()
        }
      })
    }
  }
}

const initRovingGroups = (scope: ParentNode): void => {
  const groupSelector = [
    '[data-ui-menubar]',
    '[data-ui-navigation-menu]',
    '[data-ui-radio-group]',
    '[data-ui-toggle-group]',
    '[data-ui-toolbar]'
  ].join(', ')

  for (const root of scope.querySelectorAll<HTMLElement>(groupSelector)) {
    if (root.dataset.uiBound === 'true') continue

    root.dataset.uiBound = 'true'

    const itemSelector =
      'button, a[href], input[type="radio"], [role="menuitem"], [role="radio"]'

    const items = [...root.querySelectorAll<HTMLElement>(itemSelector)]

    if (!items.length) continue

    for (const [index, item] of items.entries()) {
      item.tabIndex = index === 0 ? 0 : -1

      item.addEventListener('keydown', event => {
        const keys = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End']

        if (!keys.includes(event.key)) return

        event.preventDefault()

        for (const nextItem of items) {
          nextItem.tabIndex = -1
        }

        const nextItem = items[getLoopedIndex(event.key, index, items.length, ['ArrowRight', 'ArrowDown'])]

        if (nextItem) {
          nextItem.tabIndex = 0

          nextItem.focus()

          if (nextItem instanceof HTMLInputElement && nextItem.type === 'radio') {
            nextItem.checked = true

            nextItem.dispatchEvent(new Event('input', { bubbles: true }))

            nextItem.dispatchEvent(new Event('change', { bubbles: true }))
          } else if (nextItem.getAttribute('role') === 'radio') {
            for (const radio of items) {
              if (radio.getAttribute('role') === 'radio') {
                radio.setAttribute('aria-checked', String(radio === nextItem))
              }
            }

            nextItem.dispatchEvent(new Event('change', { bubbles: true }))
          }
        }
      })
    }
  }
}

const initToggles = (scope: ParentNode): void => {
  for (const toggle of scope.querySelectorAll<HTMLButtonElement>('[data-ui-toggle]')) {
    if (toggle.dataset.uiBound === 'true') continue

    toggle.dataset.uiBound = 'true'

    toggle.addEventListener('click', () => {
      const pressed = toggle.getAttribute('aria-pressed') !== 'true'

      const intent = new CustomEvent('ui:toggle-intent', {
        bubbles: true,
        cancelable: true,
        detail: { pressed }
      })

      toggle.dispatchEvent(intent)

      if (intent.defaultPrevented || toggle.hasAttribute('data-ui-controlled')) return

      toggle.setAttribute('aria-pressed', String(pressed))
    })
  }
}

const initThemeToggles = (scope: ParentNode): void => {
  const root = document.documentElement
  const selector = '[data-ui-theme-toggle]'
  const transitionDurationMs = 580
  const transitionFallbackDelayMs = 750
  const transitionZIndex = 99999
  const animatingControls = new WeakSet<HTMLButtonElement>()

  const sync = (theme: string): void => {
    for (const control of document.querySelectorAll<HTMLButtonElement>(selector)) {
      const darkTheme = control.dataset.darkTheme ?? 'dark'
      const isDark = theme === darkTheme

      control.setAttribute('aria-pressed', String(isDark))

      control.dataset.uiTheme = theme
    }
  }

  const apply = (theme: string, control?: HTMLButtonElement): void => {
    const previousTheme = root.dataset.theme
    const darkTheme = control?.dataset.darkTheme ?? 'dark'

    root.dataset.theme = theme

    root.classList.toggle('dark', theme === darkTheme || theme.endsWith('-dark'))

    sync(theme)

    if (!control || previousTheme === theme) return

    const storageKey = control.dataset.storageKey ?? 'lumen-theme'

    try {
      localStorage.setItem(storageKey, theme)
    } catch {
      // Storage can be unavailable in privacy modes; theme switching should still work.
    }

    control.dispatchEvent(new CustomEvent('ui:theme-change', {
      bubbles: true,
      detail: { previousTheme, storageKey, theme }
    }))
  }

  const transition = (control: HTMLButtonElement, theme: string): void => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches

    if (prefersReducedMotion || isTouchDevice) {
      apply(theme, control)

      return
    }

    animatingControls.add(control)

    control.dataset.uiThemeAnimating = 'true'

    const rect = control.getBoundingClientRect()
    const originX = Math.round(rect.left + (rect.width / 2))
    const originY = Math.round(rect.top + (rect.height / 2))

    const maximumRadius = Math.hypot(
      Math.max(originX, window.innerWidth - originX), Math.max(originY, window.innerHeight - originY)
    )

    const overlay = document.createElement('div')
    const backgroundColor = getComputedStyle(document.body).backgroundColor

    overlay.dataset.uiThemeTransition = ''

    overlay.setAttribute('aria-hidden', 'true')

    Object.assign(overlay.style, {
      position: 'fixed',
      inset: '0',
      zIndex: String(transitionZIndex),
      pointerEvents: 'none',
      backgroundColor,
      clipPath: `circle(${maximumRadius}px at ${originX}px ${originY}px)`,
      willChange: 'clip-path'
    })

    document.body.appendChild(overlay)

    apply(theme, control)

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        overlay.style.transition = `clip-path ${transitionDurationMs}ms cubic-bezier(0.4, 0, 0.2, 1)`

        overlay.style.clipPath = `circle(0 at ${originX}px ${originY}px)`

        const complete = (): void => {
          overlay.remove()

          animatingControls.delete(control)

          delete control.dataset.uiThemeAnimating
        }

        overlay.addEventListener('transitionend', complete, { once: true })

        window.setTimeout(complete, transitionFallbackDelayMs)
      })
    })
  }

  for (const control of scope.querySelectorAll<HTMLButtonElement>(selector)) {
    if (control.dataset.uiBound === 'true') continue

    control.dataset.uiBound = 'true'

    const storageKey = control.dataset.storageKey ?? 'lumen-theme'
    let storedTheme: string | null = null

    try {
      storedTheme = localStorage.getItem(storageKey)
    } catch {
      // Storage can be unavailable in privacy modes.
    }

    const currentTheme = storedTheme ?? root.dataset.theme

    if (currentTheme) {
      apply(currentTheme)
    } else {
      sync(control.dataset.lightTheme ?? 'light')
    }

    control.addEventListener('click', () => {
      if (control.hasAttribute('data-ui-controlled') || animatingControls.has(control)) return

      const lightTheme = control.dataset.lightTheme ?? 'light'
      const darkTheme = control.dataset.darkTheme ?? 'dark'
      const current = root.dataset.theme

      transition(control, current === darkTheme ? lightTheme : darkTheme)
    })
  }
}

const isUnknownArray = (value: unknown): value is unknown[] => Array.isArray(value)

const parseLanguageToggleLocales = (value: string | undefined): readonly LumenLocaleOption[] => {
  if (!value) return normalizeLumenLocales(undefined)

  try {
    const parsed: unknown = JSON.parse(value)

    if (!isUnknownArray(parsed)) return normalizeLumenLocales(undefined)

    const locales = parsed.flatMap(item => {
      if (!item || typeof item !== 'object' || !('label' in item) || !('value' in item)) return []

      const { label, value: localeValue } = item

      return typeof label === 'string' && typeof localeValue === 'string' ?
        [{ label, value: localeValue }] :
        []
    })

    return normalizeLumenLocales(locales)
  } catch {
    return normalizeLumenLocales(undefined)
  }
}

const initLanguageToggles = (scope: ParentNode): void => {
  for (const control of scope.querySelectorAll<HTMLButtonElement>('[data-ui-language-toggle]')) {
    if (control.dataset.uiBound === 'true') continue

    control.dataset.uiBound = 'true'

    const locales = parseLanguageToggleLocales(control.dataset.uiLanguageLocales)
    const storageKey = control.dataset.uiLanguageStorageKey
    const controlled = control.hasAttribute('data-ui-language-controlled')

    const labelTemplate = control.dataset.uiLanguageLabelTemplate ??
      'Change language from {current} to {next}'

    const sync = (value: string): void => {
      const { current, next } = getLumenLocalePair(locales, value)
      const label = control.querySelector<HTMLElement>('[data-ui-language-label]')

      control.dataset.uiLanguageValue = current.value

      control.dataset.uiLanguageNextValue = next.value

      control.setAttribute('aria-label', formatLumenLanguageLabel(labelTemplate, current, next))

      if (label) {
        label.lang = next.value

        label.textContent = next.label
      }
    }

    let storedValue: string | null = null

    if (!controlled && storageKey) {
      try {
        storedValue = localStorage.getItem(storageKey)
      } catch {
        // Storage can be unavailable in privacy modes.
      }
    }

    const documentValue = document.documentElement.lang || undefined

    const initialValue = controlled ?
      control.dataset.uiLanguageValue :
      storedValue ?? control.dataset.uiLanguageInitialValue ?? documentValue

    const initialPair = getLumenLocalePair(locales, initialValue)

    sync(initialPair.current.value)

    if (!controlled) document.documentElement.lang = initialPair.current.value

    control.addEventListener('click', () => {
      const { current, next } = getLumenLocalePair(locales, control.dataset.uiLanguageValue)

      if (!controlled) {
        document.documentElement.lang = next.value

        sync(next.value)

        if (storageKey) {
          try {
            localStorage.setItem(storageKey, next.value)
          } catch {
            // Storage can be unavailable in privacy modes.
          }
        }
      }

      control.dispatchEvent(new CustomEvent('ui:language-change', {
        bubbles: true,
        detail: { previousValue: current.value, value: next.value }
      }))
    })
  }
}

const getVisibleItems = (items: HTMLElement[]): HTMLElement[] => items.filter(item => !item.hidden &&
  item.offsetParent !== null &&
  !item.hasAttribute('disabled') &&
  item.getAttribute('aria-disabled') !== 'true')

const closeCombobox = (root: HTMLElement): void => {
  const input = root.querySelector<HTMLInputElement>('input[role="combobox"]')
  const listbox = root.querySelector<HTMLElement>('[role="listbox"]')

  if (!input || !listbox) return

  input.setAttribute('aria-expanded', 'false')

  listbox.hidden = true

  listbox.dataset.state = 'closed'
}

const openCombobox = (root: HTMLElement): void => {
  const input = root.querySelector<HTMLInputElement>('input[role="combobox"]')
  const listbox = root.querySelector<HTMLElement>('[role="listbox"]')

  if (!input || !listbox) return

  input.setAttribute('aria-expanded', 'true')

  listbox.hidden = false

  listbox.dataset.state = 'open'
}

let codeCopyLiveRegion: HTMLElement | undefined

const getCodeCopyLiveRegion = (): HTMLElement => {
  if (codeCopyLiveRegion) return codeCopyLiveRegion

  codeCopyLiveRegion = document.createElement('div')

  codeCopyLiveRegion.setAttribute('aria-atomic', 'true')

  codeCopyLiveRegion.setAttribute('aria-live', 'polite')

  codeCopyLiveRegion.style.position = 'absolute'

  codeCopyLiveRegion.style.width = '1px'

  codeCopyLiveRegion.style.height = '1px'

  codeCopyLiveRegion.style.overflow = 'hidden'

  codeCopyLiveRegion.style.clipPath = 'inset(50%)'

  codeCopyLiveRegion.style.whiteSpace = 'nowrap'

  document.body.append(codeCopyLiveRegion)

  return codeCopyLiveRegion
}

const initCodeCopy = (scope: ParentNode): void => {
  for (const button of scope.querySelectorAll<HTMLButtonElement>('[data-ui-code-copy]')) {
    if (button.dataset.uiCodeCopyBound === 'true') continue

    button.dataset.uiCodeCopyBound = 'true'

    button.addEventListener('click', async () => {
      const root = button.closest<HTMLElement>('[data-ui-code]')
      const code = root?.querySelector<HTMLElement>('pre code, code')
      const text = code?.innerText ?? code?.textContent

      if (!text || !navigator.clipboard) return

      try {
        await navigator.clipboard.writeText(text)
      } catch {
        return
      }

      button.classList.add('ui-code__copy--copied')

      button.setAttribute('aria-label', 'Code copied!')

      getCodeCopyLiveRegion().textContent = 'Code copied to clipboard'

      window.setTimeout(() => {
        button.classList.remove('ui-code__copy--copied')

        button.setAttribute('aria-label', 'Copy code to clipboard')

        getCodeCopyLiveRegion().textContent = ''
      }, 2000)
    })
  }
}

const getCopyButtonValue = (button: HTMLElement): string | undefined => {
  if (button.hasAttribute('data-copy-value')) {
    return button.dataset.copyValue
  }

  const selector = button.dataset.copyTarget

  if (!selector) return undefined

  const target = document.querySelector<HTMLElement>(selector)

  if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) {
    return target.value
  }

  return target?.innerText ?? target?.textContent ?? undefined
}

const initCopyButtons = (scope: ParentNode): void => {
  for (const button of scope.querySelectorAll<HTMLButtonElement>(
    '[data-ui-copy-button]'
  )) {
    if (button.dataset.uiCopyButtonBound === 'true') continue

    button.dataset.uiCopyButtonBound = 'true'

    let resetTimer = 0

    button.addEventListener('click', async () => {
      const label = button.dataset.copyLabel ?? 'Copy to clipboard'

      const copiedLabel = button.dataset.copyCopiedLabel ??
        'Copied to clipboard'

      const errorLabel = button.dataset.copyErrorLabel ??
        'Could not copy to clipboard'

      try {
        const value = getCopyButtonValue(button)

        if (value === undefined || !navigator.clipboard) {
          throw new Error(errorLabel)
        }

        await navigator.clipboard.writeText(value)

        button.dataset.state = 'copied'

        button.setAttribute('aria-label', copiedLabel)

        button.dispatchEvent(new CustomEvent('ui:copy-success', {
          bubbles: true,
          detail: { value }
        }))

        getCodeCopyLiveRegion().textContent = copiedLabel

        if (button.dataset.copyToast === 'true') {
          document.dispatchEvent(new CustomEvent('ui:toast', {
            detail: { title: copiedLabel, variant: 'success' }
          }))
        }
      } catch (error) {
        button.dataset.state = 'error'

        button.setAttribute('aria-label', errorLabel)

        button.dispatchEvent(new CustomEvent('ui:copy-error', {
          bubbles: true,
          detail: { error }
        }))

        getCodeCopyLiveRegion().textContent = errorLabel

        if (button.dataset.copyToast === 'true') {
          document.dispatchEvent(new CustomEvent('ui:toast', {
            detail: { title: errorLabel, variant: 'destructive' }
          }))
        }
      }

      window.clearTimeout(resetTimer)

      const parsedResetAfter = Number(button.dataset.copyResetAfter)

      const resetAfter = Number.isFinite(parsedResetAfter) ?
        Math.max(0, parsedResetAfter) :
        2000

      resetTimer = window.setTimeout(() => {
        button.dataset.state = 'idle'

        button.setAttribute('aria-label', label)

        getCodeCopyLiveRegion().textContent = ''
      }, resetAfter)
    })
  }
}

interface ProgressChangeDetail {
  max?: number
  value?: number
}

const updateProgress = (
  root: HTMLElement,
  { max, value }: ProgressChangeDetail
): void => {
  const currentMax = Number(root.getAttribute('aria-valuemax')) || 100
  const safeMax = max && max > 0 ? max : currentMax
  const currentValue = Number(root.getAttribute('aria-valuenow')) || 0

  const safeValue = Math.min(
    safeMax, Math.max(0, Number.isFinite(value) ? (value ?? 0) : currentValue)
  )

  const indicator = root.querySelector<HTMLElement>(
    '[data-slot="progress-indicator"]'
  )

  root.setAttribute('aria-valuemax', String(safeMax))

  root.setAttribute('aria-valuenow', String(safeValue))

  if (indicator) indicator.style.width = `${(safeValue / safeMax) * 100}%`
}

const initProgress = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-progress]')) {
    if (root.dataset.uiProgressBound === 'true') continue

    root.dataset.uiProgressBound = 'true'

    root.addEventListener('ui:progress-change', event => {
      const detail = event instanceof CustomEvent ?
        (event.detail as ProgressChangeDetail) :
        {}

      updateProgress(root, detail)
    })
  }
}

const filterItems = (input: HTMLInputElement, items: HTMLElement[]): void => {
  const query = input.value.trim().toLowerCase()

  for (const item of items) {
    const text = item.textContent?.toLowerCase() ?? ''

    item.hidden = Boolean(query) && !text.includes(query)
  }
}

const selectComboboxOption = (root: HTMLElement, option: HTMLElement): void => {
  const input = root.querySelector<HTMLInputElement>('input[role="combobox"]')

  if (!input) return

  input.value = option.dataset.value ?? option.textContent?.trim() ?? ''

  input.dispatchEvent(new Event('input', { bubbles: true }))

  input.dispatchEvent(new Event('change', { bubbles: true }))

  closeCombobox(root)

  input.focus({ preventScroll: true })
}

const closeSelect = (root: HTMLElement): void => {
  const trigger = root.querySelector<HTMLElement>('[data-ui-select-trigger]')
  const listbox = root.querySelector<HTMLElement>('[data-ui-select-list]')

  if (!trigger || !listbox) return

  trigger.setAttribute('aria-expanded', 'false')

  listbox.hidden = true

  listbox.dataset.state = 'closed'
}

const openSelect = (root: HTMLElement): void => {
  const trigger = root.querySelector<HTMLElement>('[data-ui-select-trigger]')
  const listbox = root.querySelector<HTMLElement>('[data-ui-select-list]')

  if (!trigger || !listbox) return

  trigger.setAttribute('aria-expanded', 'true')

  listbox.hidden = false

  listbox.dataset.state = 'open'
}

const getSelectItems = (root: HTMLElement): HTMLElement[] => [
  ...root.querySelectorAll<HTMLElement>('[data-ui-select-option]')
]

const getEnabledSelectItems = (root: HTMLElement): HTMLElement[] => (
  getSelectItems(root).filter(
    item => !item.hasAttribute('disabled') && item.getAttribute('aria-disabled') !== 'true'
  )
)

const getSelectedSelectItem = (root: HTMLElement): HTMLElement | undefined => (
  getEnabledSelectItems(root).find(item => item.getAttribute('aria-selected') === 'true')
)

const isPrintableKey = (event: KeyboardEvent): boolean => (
  event.key.length === 1 && !event.altKey && !event.ctrlKey && !event.metaKey
)

const renderSelectOptions = (select: HTMLSelectElement, listbox: HTMLElement): void => {
  const items = [...select.options]
    .filter(option => !option.hasAttribute('data-ui-select-placeholder'))
    .map(option => {
      const item = document.createElement('button')

      item.type = 'button'

      item.role = 'option'

      item.dataset.uiSelectOption = ''

      item.dataset.value = option.value

      item.textContent = option.label

      if (option.disabled) {
        item.disabled = true

        item.setAttribute('aria-disabled', 'true')
      }

      return item
    })

  listbox.replaceChildren(...items)
}

const syncSelectValue = (root: HTMLElement): void => {
  const select = root.querySelector<HTMLSelectElement>('[data-ui-select-native]')
  const trigger = root.querySelector<HTMLElement>('[data-ui-select-trigger]')
  const value = root.querySelector<HTMLElement>('[data-ui-select-value]')

  if (!select || !trigger || !value) return

  const selectedOption = select.selectedOptions[0]
  const hasSelection = Boolean(selectedOption && !selectedOption.hasAttribute('data-ui-select-placeholder'))
  const placeholder = select.querySelector<HTMLOptionElement>('[data-ui-select-placeholder]')

  value.textContent = hasSelection ?
    selectedOption.label :
    placeholder?.textContent?.trim() || 'Select an option'

  root.dataset.placeholder = hasSelection ? 'false' : 'true'

  for (const item of getSelectItems(root)) {
    item.setAttribute('aria-selected', String(hasSelection && item.dataset.value === select.value))
  }
}

const selectSelectOption = (root: HTMLElement, item: HTMLElement): void => {
  const select = root.querySelector<HTMLSelectElement>('[data-ui-select-native]')
  const trigger = root.querySelector<HTMLElement>('[data-ui-select-trigger]')

  if (!select || !trigger || item.hasAttribute('disabled') || item.getAttribute('aria-disabled') === 'true') return

  select.value = item.dataset.value ?? ''

  select.dispatchEvent(new Event('input', { bubbles: true }))

  select.dispatchEvent(new Event('change', { bubbles: true }))

  syncSelectValue(root)

  closeSelect(root)

  trigger.focus({ preventScroll: true })
}

const focusSelectOption = (
  root: HTMLElement,
  key: string,
  currentItem?: HTMLElement
): void => {
  const items = getEnabledSelectItems(root)

  if (!items.length) return

  const current = currentItem ?? getSelectedSelectItem(root) ?? items[0]
  const currentIndex = items.indexOf(current)
  const nextItem = items[getLoopedIndex(key, Math.max(0, currentIndex), items.length, ['ArrowDown'])]

  nextItem?.focus()
}

const focusLoopedOption = (
  items: HTMLElement[],
  currentItem: HTMLElement,
  key: string
): void => {
  const visibleItems = getVisibleItems(items)

  if (!visibleItems.length) return

  const currentIndex = visibleItems.indexOf(currentItem)
  const nextItem = visibleItems[getLoopedIndex(key, Math.max(0, currentIndex), visibleItems.length, ['ArrowDown'])]

  nextItem?.focus()
}

const initCommand = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-command]')) {
    if (root.dataset.uiBound === 'true') continue

    const input = root.querySelector<HTMLInputElement>('input[type="search"], input[type="text"], input:not([type])')

    if (!input) continue

    root.dataset.uiBound = 'true'

    const items = [...root.querySelectorAll<HTMLElement>('[data-ui-command-item], [role="option"], option')]

    input.addEventListener('input', () => {
      filterItems(input, items)
    })
  }
}

const initComboboxes = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-combobox]')) {
    if (root.dataset.uiBound === 'true') continue

    const input = root.querySelector<HTMLInputElement>('input[role="combobox"]')
    const listbox = root.querySelector<HTMLElement>('[role="listbox"]')

    if (!input || !listbox) continue

    root.dataset.uiBound = 'true'

    const items = [...listbox.querySelectorAll<HTMLElement>('[role="option"]')]

    closeCombobox(root)

    input.addEventListener('focus', () => openCombobox(root))

    input.addEventListener('input', () => {
      filterItems(input, items)

      openCombobox(root)
    })

    input.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        closeCombobox(root)

        return
      }

      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Enter') return

      const visibleItems = getVisibleItems(items)

      if (!visibleItems.length) return

      event.preventDefault()

      openCombobox(root)

      if (event.key === 'Enter') {
        selectComboboxOption(root, visibleItems[0])

        return
      }

      const targetIndex = event.key === 'ArrowUp' ? visibleItems.length - 1 : 0

      visibleItems[targetIndex]?.focus()
    })

    for (const item of items) {
      item.tabIndex = -1

      item.addEventListener('click', () => selectComboboxOption(root, item))

      item.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          closeCombobox(root)

          input.focus({ preventScroll: true })

          return
        }

        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault()

          selectComboboxOption(root, item)

          return
        }

        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Home' && event.key !== 'End') return

        event.preventDefault()

        focusLoopedOption(items, item, event.key)
      })
    }
  }
}

const initSelects = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-select]')) {
    if (root.dataset.uiBound === 'true') continue

    const select = root.querySelector<HTMLSelectElement>('[data-ui-select-native]')
    const control = root.querySelector<HTMLElement>('[data-ui-select-control]')
    const trigger = root.querySelector<HTMLButtonElement>('[data-ui-select-trigger]')
    const listbox = root.querySelector<HTMLElement>('[data-ui-select-list]')

    if (!select || !control || !trigger || !listbox) continue

    root.dataset.uiBound = 'true'

    renderSelectOptions(select, listbox)

    control.hidden = false

    select.dataset.uiEnhanced = 'true'

    select.tabIndex = -1

    select.setAttribute('aria-hidden', 'true')

    trigger.disabled = select.disabled

    trigger.setAttribute('aria-haspopup', 'listbox')

    for (const attribute of ['aria-label', 'aria-labelledby', 'aria-describedby', 'aria-invalid']) {
      const value = select.getAttribute(attribute)

      if (value) {
        trigger.setAttribute(attribute, value)
      }
    }

    if (select.required) {
      trigger.setAttribute('aria-required', 'true')
    }

    if (!trigger.hasAttribute('aria-label') && !trigger.hasAttribute('aria-labelledby')) {
      const label = [...(select.labels ?? [])].find(item => item.textContent?.trim())

      if (label?.textContent) {
        trigger.setAttribute('aria-label', label.textContent.trim())
      }
    }

    for (const label of select.labels ?? []) {
      label.addEventListener('click', event => {
        event.preventDefault()

        trigger.focus({ preventScroll: true })
      })
    }

    let typeahead = ''
    let typeaheadTimer = 0

    const focusTypeaheadOption = (currentItem?: HTMLElement): void => {
      const items = getEnabledSelectItems(root)

      if (!items.length || !typeahead) return

      const selectedItem = getSelectedSelectItem(root) ?? items[0]
      const currentIndex = currentItem ? items.indexOf(currentItem) : items.indexOf(selectedItem)
      const startIndex = Math.max(0, currentIndex + 1)
      const orderedItems = [...items.slice(startIndex), ...items.slice(0, startIndex)]
      const nextItem = orderedItems.find(item => item.textContent?.trim().toLowerCase().startsWith(typeahead))

      nextItem?.focus()
    }

    const handleTypeahead = (event: KeyboardEvent, currentItem?: HTMLElement): boolean => {
      if (!isPrintableKey(event)) return false

      event.preventDefault()

      typeahead += event.key.toLowerCase()

      window.clearTimeout(typeaheadTimer)

      typeaheadTimer = window.setTimeout(() => {
        typeahead = ''
      }, 700)

      openSelect(root)

      focusTypeaheadOption(currentItem)

      return true
    }

    syncSelectValue(root)

    closeSelect(root)

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true'

      if (isOpen) {
        closeSelect(root)
      } else {
        openSelect(root)
      }
    })

    trigger.addEventListener('keydown', event => {
      if (handleTypeahead(event)) return

      if (event.key === 'Escape') {
        closeSelect(root)

        return
      }

      const navigationKeys = ['ArrowDown', 'ArrowUp', 'Home', 'End', 'Enter', ' ']

      if (!navigationKeys.includes(event.key)) return

      event.preventDefault()

      openSelect(root)

      if (event.key === 'Enter' || event.key === ' ') {
        ;

        (getSelectedSelectItem(root) ?? getEnabledSelectItems(root)[0])?.focus()

        return
      }

      focusSelectOption(root, event.key)
    })

    select.addEventListener('change', () => syncSelectValue(root))

    select.form?.addEventListener('reset', () => {
      window.setTimeout(() => syncSelectValue(root))
    })

    for (const item of getSelectItems(root)) {
      item.tabIndex = -1

      item.addEventListener('click', () => selectSelectOption(root, item))

      item.addEventListener('keydown', event => {
        if (handleTypeahead(event, item)) return

        if (event.key === 'Escape') {
          closeSelect(root)

          trigger.focus({ preventScroll: true })

          return
        }

        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault()

          selectSelectOption(root, item)

          return
        }

        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Home' && event.key !== 'End') return

        event.preventDefault()

        focusSelectOption(root, event.key, item)
      })
    }
  }
}

const parseNumberList = (value: string | undefined, count: number, fallback: number): number[] => {
  const values = (value ?? '')
    .split(',')
    .map(item => Number.parseFloat(item.trim()))
    .filter(Number.isFinite)

  return Array.from({ length: count }, (_, index) => values[index] ?? values[0] ?? fallback)
}

const normalizeSizes = (sizes: number[], count: number): number[] => {
  const fallbackSize = 100 / Math.max(1, count)

  const usableSizes = Array.from({ length: count }, (_, index) => {
    const size = sizes[index] ?? fallbackSize

    return Number.isFinite(size) && size > 0 ? size : fallbackSize
  })

  const total = usableSizes.reduce((sum, size) => sum + size, 0)

  if (total <= 0) return Array.from({ length: count }, () => fallbackSize)

  return usableSizes.map(size => (size / total) * 100)
}

const initResizableGroups = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-resizable]')) {
    if (root.dataset.uiBound === 'true') continue

    const panes = [...root.children].filter((child): child is HTMLElement => child instanceof HTMLElement &&
      !child.hasAttribute('data-ui-resizable-handle') &&
      !child.hasAttribute('data-ui-resizable-handle-template'))

    if (panes.length < 2) continue

    root.dataset.uiBound = 'true'

    root.dataset.uiResizableEnhanced = 'true'

    const direction = root.dataset.orientation === 'vertical' ? 'vertical' : 'horizontal'
    const separatorOrientation = direction === 'horizontal' ? 'vertical' : 'horizontal'
    const axis = direction === 'horizontal' ? 'clientX' : 'clientY'
    const sizeProperty = direction === 'horizontal' ? 'width' : 'height'
    const minSizes = parseNumberList(root.dataset.uiResizableMinSize, panes.length, 12)
    const maxSizes = parseNumberList(root.dataset.uiResizableMaxSize, panes.length, 88)

    const initialSizes = normalizeSizes(
      parseNumberList(root.dataset.uiResizableDefaultSizes, panes.length, 100 / panes.length), panes.length
    )

    const handleTemplate = root.querySelector<HTMLTemplateElement>(':scope > [data-ui-resizable-handle-template]')
    let sizes = [...initialSizes]

    const applySizes = (): void => {
      for (const [index, pane] of panes.entries()) {
        pane.dataset.uiResizablePanel = ''

        pane.style.setProperty('--ui-resizable-size', `${sizes[index]}%`)
      }

      for (const handle of root.querySelectorAll<HTMLElement>('[data-ui-resizable-handle]')) {
        const index = Number.parseInt(handle.dataset.index ?? '0', 10)

        handle.setAttribute('aria-valuemin', String(Math.round(minSizes[index] ?? 0)))

        handle.setAttribute('aria-valuemax', String(Math.round(maxSizes[index] ?? 100)))

        handle.setAttribute('aria-valuenow', String(Math.round(sizes[index] ?? 0)))
      }
    }

    const resizePair = (index: number, nextSize: number): void => {
      const nextIndex = index + 1
      const total = sizes[index] + sizes[nextIndex]
      const min = Math.max(minSizes[index] ?? 0, total - (maxSizes[nextIndex] ?? 100))
      const max = Math.min(maxSizes[index] ?? 100, total - (minSizes[nextIndex] ?? 0))
      const paneSize = Math.min(max, Math.max(min, nextSize))

      sizes[index] = paneSize

      sizes[nextIndex] = total - paneSize

      applySizes()
    }

    for (const [index, pane] of panes.entries()) {
      pane.dataset.uiResizablePanel = ''

      if (index >= panes.length - 1) continue

      const handleFromTemplate = handleTemplate?.content
        .querySelector<HTMLButtonElement>('[data-ui-resizable-handle]')
        ?.cloneNode(true)

      const handle = handleFromTemplate instanceof HTMLButtonElement ?
        handleFromTemplate :
        document.createElement('button')

      handle.type = 'button'

      handle.className = 'ui-resizable__handle'

      handle.dataset.uiResizableHandle = ''

      handle.dataset.index = String(index)

      handle.tabIndex = 0

      handle.setAttribute('aria-label', `Resize panel ${index + 1}`)

      handle.setAttribute('role', 'separator')

      handle.setAttribute('aria-orientation', separatorOrientation)

      pane.after(handle)

      let startPosition = 0
      let startSize = 0
      let containerSize = 1

      handle.addEventListener('pointerdown', event => {
        if (event.button !== 0) return

        event.preventDefault()

        startPosition = event[axis]

        startSize = sizes[index]

        containerSize = Math.max(1, root.getBoundingClientRect()[sizeProperty])

        root.dataset.resizing = 'true'

        handle.dataset.active = 'true'

        handle.setPointerCapture(event.pointerId)
      })

      handle.addEventListener('pointermove', event => {
        if (handle.dataset.active !== 'true') return

        const delta = ((event[axis] - startPosition) / containerSize) * 100

        resizePair(index, startSize + delta)
      })

      handle.addEventListener('pointerup', event => {
        if (handle.dataset.active !== 'true') return

        delete handle.dataset.active

        delete root.dataset.resizing

        handle.releasePointerCapture(event.pointerId)
      })

      handle.addEventListener('dblclick', () => {
        if (root.dataset.uiResizableReset !== 'true') return

        sizes = [...initialSizes]

        applySizes()
      })

      handle.addEventListener('keydown', event => {
        const step = event.shiftKey ? 10 : 2

        const keyDeltas: Record<string, number> = direction === 'horizontal' ?
          { ArrowLeft: -step, ArrowRight: step } :
          { ArrowDown: step, ArrowUp: -step }

        if (event.key === 'Home') {
          event.preventDefault()

          resizePair(index, minSizes[index] ?? 0)

          return
        }

        if (event.key === 'End') {
          event.preventDefault()

          resizePair(index, maxSizes[index] ?? 100)

          return
        }

        const delta = keyDeltas[event.key]

        if (delta === undefined) return

        event.preventDefault()

        resizePair(index, sizes[index] + delta)
      })
    }

    applySizes()
  }
}

const sanitizeOtpValue = (input: HTMLInputElement, value: string, length: number): string => {
  const numericOnly = input.inputMode === 'numeric' || input.getAttribute('pattern') === '[0-9]*'
  const normalized = numericOnly ? value.replaceAll(/\D/g, '') : value.replaceAll(/\s/g, '')

  return normalized.slice(0, length)
}

const initInputOtpFields = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-input-otp]')) {
    if (root.dataset.uiBound === 'true') continue

    const input = root.querySelector<HTMLInputElement>('[data-ui-input-otp-native]')
    const segments = [...root.querySelectorAll<HTMLButtonElement>('[data-ui-input-otp-segment]')]

    if (!input || segments.length === 0) continue

    root.dataset.uiBound = 'true'

    const length = Number.parseInt(root.dataset.uiInputOtpLength ?? '', 10) || segments.length

    input.dataset.uiEnhanced = 'true'

    const syncSegments = (): void => {
      const value = sanitizeOtpValue(input, input.value, length)

      if (input.value !== value) {
        input.value = value
      }

      const activeIndex = Math.min(length - 1, Math.max(0, input.selectionStart ?? value.length))

      root.dataset.disabled = input.disabled ? 'true' : 'false'

      root.dataset.invalid = input.getAttribute('aria-invalid') === 'true' ? 'true' : 'false'

      for (const [index, segment] of segments.entries()) {
        const char = segment.querySelector<HTMLElement>('[data-ui-input-otp-char]')

        segment.disabled = input.disabled

        segment.dataset.active = String(document.activeElement === input && index === activeIndex)

        if (char) {
          char.textContent = value[index] ?? '\u00a0'
        }
      }
    }

    const setSelection = (index: number): void => {
      const position = Math.min(input.value.length, Math.max(0, index))

      input.focus({ preventScroll: true })

      input.setSelectionRange(position, position)

      syncSegments()
    }

    const setValue = (value: string): void => {
      input.value = sanitizeOtpValue(input, value, length)

      input.setSelectionRange(input.value.length, input.value.length)

      input.dispatchEvent(new Event('input', { bubbles: true }))

      input.dispatchEvent(new Event('change', { bubbles: true }))

      syncSegments()
    }

    const segmentsRoot = root.querySelector<HTMLElement>('[data-ui-input-otp-segments]')

    if (segmentsRoot) {
      segmentsRoot.hidden = false
    }

    syncSegments()

    input.addEventListener('input', syncSegments)

    input.addEventListener('change', syncSegments)

    input.addEventListener('focus', syncSegments)

    input.addEventListener('blur', syncSegments)

    input.addEventListener('click', syncSegments)

    input.addEventListener('keyup', syncSegments)

    input.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault()

        setSelection((input.selectionStart ?? input.value.length) - 1)

        return
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault()

        setSelection((input.selectionStart ?? input.value.length) + 1)

        return
      }

      if (event.key === 'Home') {
        event.preventDefault()

        setSelection(0)

        return
      }

      if (event.key === 'End') {
        event.preventDefault()

        setSelection(input.value.length)
      }
    })

    input.addEventListener('paste', event => {
      const pasted = event.clipboardData?.getData('text') ?? ''

      if (!pasted) return

      event.preventDefault()

      setValue(pasted)
    })

    input.form?.addEventListener('reset', () => {
      window.setTimeout(syncSegments)
    })

    for (const [index, segment] of segments.entries()) {
      segment.addEventListener('click', () => setSelection(index))
    }
  }
}

/* cspell:ignore Datatable datatable */
/* eslint-disable @stylistic/padding-line-between-statements, no-nested-ternary */
const getDataTableSortValue = (
  cell: HTMLTableCellElement | undefined
): string => cell?.dataset.sortValue ?? cell?.textContent?.trim() ?? ''

const compareDataTableValues = (value: string, other: string, sortType: string | undefined): number => {
  const numericValue = Number(value.replace(/,/g, ''))
  const numericOther = Number(other.replace(/,/g, ''))
  const useNumeric = sortType === 'number' || (
    sortType !== 'string' &&
    value.trim() !== '' &&
    other.trim() !== '' &&
    Number.isFinite(numericValue) &&
    Number.isFinite(numericOther)
  )

  if (useNumeric) {
    return numericValue - numericOther
  }

  return value.localeCompare(other, undefined, { numeric: true, sensitivity: 'base' })
}

const sortDataTableRows = (
  table: HTMLTableElement,
  header: HTMLTableCellElement,
  columnIndex: number,
  direction: 'ascending' | 'descending' | 'none'
): void => {
  const body = table.tBodies[0]

  if (!body) return

  const rows = [...body.rows]
  const sortType = header.dataset.uiDatatableSortType

  rows.sort((row, other) => {
    if (direction === 'none') {
      return Number(row.dataset.uiDatatableIndex ?? '0') - Number(other.dataset.uiDatatableIndex ?? '0')
    }

    const result = compareDataTableValues(
      getDataTableSortValue(row.cells[columnIndex]), getDataTableSortValue(other.cells[columnIndex]), sortType
    )

    return (direction === 'ascending' ? result : -result) ||
      Number(row.dataset.uiDatatableIndex ?? '0') - Number(other.dataset.uiDatatableIndex ?? '0')
  })

  rows.forEach(row => body.append(row))
}

const updateDataTableSort = (
  root: HTMLElement,
  table: HTMLTableElement,
  header: HTMLTableCellElement,
  direction: 'ascending' | 'descending' | 'none'
): void => {
  for (const item of table.querySelectorAll<HTMLTableCellElement>('thead th[aria-sort]')) {
    item.setAttribute('aria-sort', item === header ? direction : 'none')
    item.dataset.sort = item === header ? direction : 'none'
  }

  root.dataset.uiDatatableSortDirection = direction

  if (direction === 'none') {
    delete root.dataset.uiDatatableSortColumn
  } else {
    root.dataset.uiDatatableSortColumn = header.dataset.uiDatatableColumn ?? ''
  }
}

const initDataTableSorting = (root: HTMLElement, table: HTMLTableElement): void => {
  const headers = [...table.querySelectorAll<HTMLTableCellElement>('thead th')].filter(
    header => header.dataset.uiDatatableSortable === 'true' ||
      header.dataset.sortable === 'true' ||
      header.hasAttribute('data-sortable')
  )

  for (const header of headers) {
    if (header.dataset.uiDatatableSortBound === 'true') continue

    const row = header.parentElement
    const columnIndex = row ? [...row.children].indexOf(header) : -1

    if (columnIndex < 0) continue

    header.dataset.uiDatatableSortBound = 'true'
    header.dataset.uiDatatableColumn = String(columnIndex)
    header.setAttribute('aria-sort', 'none')

    const button = document.createElement('button')

    button.type = 'button'
    button.className = 'ui-data-table__sort'
    button.dataset.uiDatatableSort = ''

    while (header.firstChild) {
      button.append(header.firstChild)
    }

    header.append(button)

    button.addEventListener('click', () => {
      const currentColumn = root.dataset.uiDatatableSortColumn
      const currentDirection = header.getAttribute('aria-sort')
      const nextDirection = currentColumn !== String(columnIndex) || currentDirection === 'none' ?
        'ascending' :
        currentDirection === 'ascending' ?
          'descending' :
          'none'

      updateDataTableSort(root, table, header, nextDirection)
      sortDataTableRows(table, header, columnIndex, nextDirection)
    })
  }

  const body = table.tBodies[0]

  if (!body) return

  ;[...body.rows].forEach((row, index) => {
    row.dataset.uiDatatableIndex = row.dataset.uiDatatableIndex ?? String(index)
  })
}

const getDataTableRows = (table: HTMLTableElement): HTMLTableRowElement[] => [
  ...(table.tBodies[0]?.rows ?? [])
]

const getDataTableRowValue = (
  row: HTMLTableRowElement,
  index: number
): string => row.dataset.value ?? row.id ?? String(index)

const syncDataTableSelection = (
  root: HTMLElement,
  table: HTMLTableElement,
  selectAll: HTMLInputElement,
  dispatch = false
): void => {
  const rows = getDataTableRows(table)
  const selectedValues: string[] = []

  rows.forEach((row, index) => {
    const checkbox = row.querySelector<HTMLInputElement>('[data-ui-datatable-row-select]')
    const selected = checkbox?.checked === true

    row.setAttribute('aria-selected', String(selected))

    if (selected) {
      row.dataset.state = 'selected'
      selectedValues.push(getDataTableRowValue(row, index))
    } else {
      delete row.dataset.state
    }
  })

  selectAll.checked = rows.length > 0 && selectedValues.length === rows.length
  selectAll.indeterminate = selectedValues.length > 0 && selectedValues.length < rows.length

  const name = root.dataset.uiDatatableName
  let inputs = root.querySelector<HTMLElement>('[data-ui-datatable-inputs]')

  if (name) {
    if (!inputs) {
      inputs = document.createElement('div')
      inputs.hidden = true
      inputs.dataset.uiDatatableInputs = ''
      root.append(inputs)
    }

    inputs.replaceChildren(...selectedValues.map(value => {
      const input = document.createElement('input')

      input.type = 'hidden'
      input.name = name
      input.value = value

      return input
    }))
  } else {
    inputs?.replaceChildren()
  }

  if (dispatch) {
    const detail = { values: selectedValues }

    root.dispatchEvent(new CustomEvent('ui:data-table-selection-change', { bubbles: true, detail }))
  }
}

const initDataTableSelection = (root: HTMLElement, table: HTMLTableElement): void => {
  if (root.dataset.uiDatatableSelectable !== 'true' || root.dataset.uiDatatableSelectionBound === 'true') return

  const headRow = table.tHead?.rows[0]
  const body = table.tBodies[0]

  if (!headRow || !body) return

  root.dataset.uiDatatableSelectionBound = 'true'

  const headerCell = document.createElement('th')
  const selectAll = document.createElement('input')

  headerCell.className = 'ui-data-table__selection'
  headerCell.scope = 'col'
  selectAll.type = 'checkbox'
  selectAll.className = 'ui-data-table__checkbox'
  selectAll.dataset.uiDatatableSelectAll = ''
  selectAll.setAttribute('aria-label', 'Select all rows')
  headerCell.append(selectAll)
  headRow.prepend(headerCell)

  getDataTableRows(table).forEach((row, index) => {
    row.dataset.uiDatatableRow = ''
    row.dataset.value = getDataTableRowValue(row, index)

    const cell = document.createElement('td')
    const checkbox = document.createElement('input')
    const selected = row.dataset.state === 'selected' || row.getAttribute('aria-selected') === 'true'

    cell.className = 'ui-data-table__selection'
    checkbox.type = 'checkbox'
    checkbox.className = 'ui-data-table__checkbox'
    checkbox.dataset.uiDatatableRowSelect = ''
    checkbox.checked = selected
    checkbox.defaultChecked = selected
    checkbox.setAttribute('aria-label', `Select row ${index + 1}`)
    checkbox.addEventListener('change', () => syncDataTableSelection(root, table, selectAll, true))

    cell.append(checkbox)
    row.prepend(cell)
  })

  selectAll.addEventListener('change', () => {
    for (const checkbox of table.querySelectorAll<HTMLInputElement>('[data-ui-datatable-row-select]')) {
      checkbox.checked = selectAll.checked
    }

    syncDataTableSelection(root, table, selectAll, true)
  })

  root.closest('form')?.addEventListener('reset', () => {
    window.setTimeout(() => syncDataTableSelection(root, table, selectAll, true))
  })

  syncDataTableSelection(root, table, selectAll)
}

const initDataTables = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-datatable]')) {
    if (root.dataset.uiBound === 'true') continue

    const table = root.querySelector<HTMLTableElement>('table')

    if (!table) continue

    root.dataset.uiBound = 'true'

    initDataTableSelection(root, table)
    initDataTableSorting(root, table)
  }
}

---
/**
 * Astro UI primitives controller.
 *
 * Provides progressive enhancement for local UI components without
 * adding a framework runtime.
 */
---

<script>
  const focusableSelector = [
    'a[href]',
    'button:not([disabled])',
    'input:not([disabled])',
    'select:not([disabled])',
    'textarea:not([disabled])',
    '[tabindex]:not([tabindex="-1"])'
  ].join(',')

  const disclosureSelector = '[data-ui-popover], [data-ui-dropdown-menu], [data-ui-hover-card]'

  /**
   * Top-layer mode: when the browser supports both the Popover API and CSS
   * anchor positioning, floating panels are promoted to [popover] so they
   * escape overflow clipping and get collision-aware placement via
   * position-try-fallbacks. Other browsers keep the absolute fallback.
   */
  const supportsAnchoredPopovers =
    typeof HTMLElement !== 'undefined' &&
    'showPopover' in HTMLElement.prototype &&
    typeof CSS !== 'undefined' &&
    CSS.supports('anchor-name: --ui-anchor') &&
    CSS.supports('position-area: block-end')

  let uiAnchorCount = 0

  const nextAnchorName = (): string => `--ui-anchor-${++uiAnchorCount}`

  const isElementVisible = (element: HTMLElement): boolean =>
    typeof element.checkVisibility === 'function'
      ? element.checkVisibility()
      : element.offsetParent !== null

  const getFocusable = (root: ParentNode): HTMLElement[] =>
    [...root.querySelectorAll<HTMLElement>(focusableSelector)]
      .filter(element => !element.hasAttribute('hidden') && isElementVisible(element))

  const getPanel = (trigger: HTMLElement): HTMLElement | null => {
    const controls = trigger.getAttribute('aria-controls')

    if (controls) {
      return document.getElementById(controls)
    }

    return trigger.nextElementSibling instanceof HTMLElement ? trigger.nextElementSibling : null
  }

  const getLoopedIndex = (
    key: string,
    currentIndex: number,
    itemCount: number,
    forwardKeys: readonly string[]
  ): number => {
    const lastIndex = itemCount - 1

    if (key === 'Home') return 0

    if (key === 'End') return lastIndex

    if (forwardKeys.includes(key)) return (currentIndex + 1) % itemCount

    return (currentIndex - 1 + itemCount) % itemCount
  }

  const setOpen = (trigger: HTMLElement, panel: HTMLElement, open: boolean): void => {
    trigger.setAttribute('aria-expanded', String(open))

    if (panel.hasAttribute('popover')) {
      try {
        if (open) {
          panel.showPopover()
        } else {
          panel.hidePopover()
        }
      } catch {
        /* popover already in requested state */
      }
    } else {
      panel.hidden = !open
    }

    panel.dataset.state = open ? 'open' : 'closed'
  }

  const closeDisclosure = (root: HTMLElement): void => {
    const trigger = root.querySelector<HTMLElement>('[data-ui-trigger]')

    if (!trigger) return

    const panel = getPanel(trigger)

    if (!panel) return

    setOpen(trigger, panel, false)
  }

  const initDisclosures = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>(disclosureSelector)) {
      const trigger = root.querySelector<HTMLElement>('[data-ui-trigger]')

      if (!trigger) continue

      const panel = getPanel(trigger)

      if (!panel || trigger.dataset.uiBound === 'true') continue

      trigger.dataset.uiBound = 'true'

      trigger.setAttribute('aria-haspopup', trigger.getAttribute('aria-haspopup') ?? 'menu')

      if (supportsAnchoredPopovers) {
        const anchorName = nextAnchorName()

        panel.hidden = false

        panel.setAttribute('popover', 'manual')

        trigger.style.setProperty('anchor-name', anchorName)

        panel.style.setProperty('position-anchor', anchorName)
      }

      setOpen(trigger, panel, trigger.getAttribute('aria-expanded') === 'true')

      trigger.addEventListener('click', () => {
        setOpen(trigger, panel, trigger.getAttribute('aria-expanded') !== 'true')
      })

      trigger.addEventListener('keydown', event => {
        if (event.key !== 'ArrowDown' && event.key !== 'Enter' && event.key !== ' ') return

        event.preventDefault()

        setOpen(trigger, panel, true)

        getFocusable(panel)[0]?.focus()
      })

      panel.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          event.preventDefault()

          setOpen(trigger, panel, false)

          trigger.focus({ preventScroll: true })

          return
        }

        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Home' && event.key !== 'End') return

        const items = getFocusable(panel)

        if (!items.length) return

        event.preventDefault()

        const currentIndex = items.indexOf(document.activeElement as HTMLElement)
        const nextItem = items[getLoopedIndex(event.key, Math.max(0, currentIndex), items.length, ['ArrowDown'])]

        nextItem?.focus()
      })

      if (root.hasAttribute('data-ui-hover-card')) {
        root.addEventListener('mouseenter', () => setOpen(trigger, panel, true))

        root.addEventListener('mouseleave', () => setOpen(trigger, panel, false))
      }
    }
  }

  const initTooltips = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('.ui-tooltip, [data-ui-tooltip]')) {
      if (root.dataset.uiTooltipBound === 'true') continue

      const tip = root.querySelector<HTMLElement>('[role="tooltip"]')

      if (!tip) continue

      root.dataset.uiTooltipBound = 'true'

      if (supportsAnchoredPopovers) {
        const anchorName = nextAnchorName()

        tip.setAttribute('popover', 'manual')

        root.style.setProperty('anchor-name', anchorName)

        tip.style.setProperty('position-anchor', anchorName)

        let showTimer = 0

        const show = (delay: number): void => {
          window.clearTimeout(showTimer)

          showTimer = window.setTimeout(() => {
            try {
              tip.showPopover()
            } catch {
              /* already open */
            }
          }, delay)
        }

        const hide = (): void => {
          window.clearTimeout(showTimer)

          try {
            tip.hidePopover()
          } catch {
            /* already closed */
          }
        }

        root.addEventListener('mouseenter', () => show(250))

        root.addEventListener('mouseleave', hide)

        root.addEventListener('focusin', () => show(0))

        root.addEventListener('focusout', hide)

        root.addEventListener('keydown', event => {
          if (event.key === 'Escape') hide()
        })
      } else {
        /* WCAG 1.4.13: hover/focus tooltips must be dismissible with Escape. */
        root.addEventListener('keydown', event => {
          if (event.key !== 'Escape') return

          tip.style.visibility = 'hidden'
        })

        root.addEventListener('mouseleave', () => {
          tip.style.removeProperty('visibility')
        })

        root.addEventListener('focusout', () => {
          tip.style.removeProperty('visibility')
        })
      }
    }
  }

  const initGlassTracking = (scope: ParentNode): void => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    for (const element of scope.querySelectorAll<HTMLElement>('[data-ui-glass-track]')) {
      if (element.dataset.uiGlassBound === 'true') continue

      element.dataset.uiGlassBound = 'true'

      element.addEventListener('pointermove', event => {
        const rect = element.getBoundingClientRect()

        if (!rect.width || !rect.height) return

        element.style.setProperty('--glass-x', `${(((event.clientX - rect.left) / rect.width) * 100).toFixed(1)}%`)

        element.style.setProperty('--glass-y', `${(((event.clientY - rect.top) / rect.height) * 100).toFixed(1)}%`)
      })

      element.addEventListener('pointerleave', () => {
        element.style.removeProperty('--glass-x')

        element.style.removeProperty('--glass-y')
      })
    }
  }

  const initDialogs = (scope: ParentNode): void => {
    for (const dialog of scope.querySelectorAll<HTMLDialogElement>('[data-ui-dialog], [data-ui-alert-dialog], [data-ui-drawer], [data-ui-sheet]')) {
      if (dialog.dataset.uiBound === 'true') continue

      dialog.dataset.uiBound = 'true'

      dialog.setAttribute('aria-modal', 'true')

      dialog.setAttribute('role', dialog.hasAttribute('data-ui-alert-dialog') ? 'alertdialog' : 'dialog')

      dialog.addEventListener('click', event => {
        if (event.target === dialog && !dialog.hasAttribute('data-ui-alert-dialog')) {
          dialog.close()
        }
      })

      dialog.addEventListener('close', () => {
        const triggerId = dialog.dataset.uiLastTrigger
        const trigger = triggerId ? document.getElementById(triggerId) : null

        if (trigger instanceof HTMLElement) {
          trigger.focus({ preventScroll: true })
        }
      })
    }

    for (const trigger of scope.querySelectorAll<HTMLElement>('[data-ui-dialog-trigger], [data-ui-alert-dialog-trigger], [data-ui-drawer-trigger], [data-ui-sheet-trigger]')) {
      if (trigger.dataset.uiBound === 'true') continue

      trigger.dataset.uiBound = 'true'

      trigger.setAttribute('aria-haspopup', 'dialog')

      trigger.addEventListener('click', () => {
        const targetId =
          trigger.dataset.uiDialogTrigger ??
          trigger.dataset.uiAlertDialogTrigger ??
          trigger.dataset.uiDrawerTrigger ??
          trigger.dataset.uiSheetTrigger

        if (!targetId) return

        const dialog = document.getElementById(targetId)

        if (!(dialog instanceof HTMLDialogElement)) return

        if (!trigger.id) {
          trigger.id = `ui-trigger-${crypto.randomUUID()}`
        }

        dialog.dataset.uiLastTrigger = trigger.id

        dialog.showModal()

        getFocusable(dialog)[0]?.focus({ preventScroll: true })
      })
    }

    for (const closeButton of scope.querySelectorAll<HTMLElement>('[data-ui-dialog-close], [data-ui-alert-dialog-close], [data-ui-drawer-close], [data-ui-sheet-close]')) {
      if (closeButton.dataset.uiBound === 'true') continue

      closeButton.dataset.uiBound = 'true'

      closeButton.addEventListener('click', () => {
        closeButton.closest<HTMLDialogElement>('dialog')?.close()
      })
    }
  }

  const initTabs = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-tabs]')) {
      if (root.dataset.uiBound === 'true') continue

      root.dataset.uiBound = 'true'

      const tabs = [...root.querySelectorAll<HTMLElement>('[role="tab"]')]
      const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')]

      if (!tabs.length || !panels.length) continue

      const activate = (tab: HTMLElement): void => {
        for (const item of tabs) {
          const selected = item === tab
          const panelId = item.getAttribute('aria-controls')
          const panel = panelId ? document.getElementById(panelId) : null

          item.setAttribute('aria-selected', String(selected))

          item.tabIndex = selected ? 0 : -1

          if (panel) {
            panel.hidden = !selected
          }
        }
      }

      const initiallySelected = tabs.find(tab => tab.getAttribute('aria-selected') === 'true') ?? tabs[0]

      if (initiallySelected) activate(initiallySelected)

      for (const [index, tab] of tabs.entries()) {
        tab.addEventListener('click', () => activate(tab))

        tab.addEventListener('keydown', event => {
          const keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End']

          if (!keys.includes(event.key)) return

          event.preventDefault()

          const nextTab = tabs[getLoopedIndex(event.key, index, tabs.length, ['ArrowRight'])]

          if (nextTab) {
            activate(nextTab)

            nextTab.focus()
          }
        })
      }
    }
  }

  const initRovingGroups = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-menubar], [data-ui-navigation-menu], [data-ui-radio-group], [data-ui-toggle-group]')) {
      if (root.dataset.uiBound === 'true') continue

      root.dataset.uiBound = 'true'

      const items = [...root.querySelectorAll<HTMLElement>('button, a[href], input[type="radio"], [role="menuitem"], [role="radio"]')]

      if (!items.length) continue

      for (const [index, item] of items.entries()) {
        item.tabIndex = index === 0 ? 0 : -1

        item.addEventListener('keydown', event => {
          const keys = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End']

          if (!keys.includes(event.key)) return

          event.preventDefault()

          for (const nextItem of items) {
            nextItem.tabIndex = -1
          }

          const nextItem = items[getLoopedIndex(event.key, index, items.length, ['ArrowRight', 'ArrowDown'])]

          if (nextItem) {
            nextItem.tabIndex = 0

            nextItem.focus()
          }
        })
      }
    }
  }

  const initToggles = (scope: ParentNode): void => {
    for (const toggle of scope.querySelectorAll<HTMLButtonElement>('[data-ui-toggle]')) {
      if (toggle.dataset.uiBound === 'true') continue

      toggle.dataset.uiBound = 'true'

      toggle.addEventListener('click', () => {
        const pressed = toggle.getAttribute('aria-pressed') !== 'true'

        toggle.setAttribute('aria-pressed', String(pressed))

        toggle.classList.toggle('ui-toggle--pressed', pressed)
      })
    }
  }

  const getVisibleItems = (items: HTMLElement[]): HTMLElement[] =>
    items.filter(item => !item.hidden && item.offsetParent !== null)

  const closeCombobox = (root: HTMLElement): void => {
    const input = root.querySelector<HTMLInputElement>('input[role="combobox"]')
    const listbox = root.querySelector<HTMLElement>('[role="listbox"]')

    if (!input || !listbox) return

    input.setAttribute('aria-expanded', 'false')

    listbox.hidden = true

    listbox.dataset.state = 'closed'
  }

  const openCombobox = (root: HTMLElement): void => {
    const input = root.querySelector<HTMLInputElement>('input[role="combobox"]')
    const listbox = root.querySelector<HTMLElement>('[role="listbox"]')

    if (!input || !listbox) return

    input.setAttribute('aria-expanded', 'true')

    listbox.hidden = false

    listbox.dataset.state = 'open'
  }

  let codeCopyLiveRegion: HTMLElement | undefined

  const getCodeCopyLiveRegion = (): HTMLElement => {
    if (codeCopyLiveRegion) return codeCopyLiveRegion

    codeCopyLiveRegion = document.createElement('div')
    codeCopyLiveRegion.setAttribute('aria-atomic', 'true')
    codeCopyLiveRegion.setAttribute('aria-live', 'polite')
    codeCopyLiveRegion.style.position = 'absolute'
    codeCopyLiveRegion.style.width = '1px'
    codeCopyLiveRegion.style.height = '1px'
    codeCopyLiveRegion.style.overflow = 'hidden'
    codeCopyLiveRegion.style.clipPath = 'inset(50%)'
    codeCopyLiveRegion.style.whiteSpace = 'nowrap'

    document.body.append(codeCopyLiveRegion)

    return codeCopyLiveRegion
  }

  const initCodeCopy = (scope: ParentNode): void => {
    for (const button of scope.querySelectorAll<HTMLButtonElement>('[data-ui-code-copy]')) {
      if (button.dataset.uiCodeCopyBound === 'true') continue

      button.dataset.uiCodeCopyBound = 'true'

      button.addEventListener('click', async () => {
        const root = button.closest<HTMLElement>('[data-ui-code]')
        const code = root?.querySelector<HTMLElement>('pre code, code')
        const text = code?.innerText ?? code?.textContent

        if (!text || !navigator.clipboard) return

        try {
          await navigator.clipboard.writeText(text)
        } catch {
          return
        }

        button.classList.add('ui-code__copy--copied')

        button.setAttribute('aria-label', 'Code copied!')

        getCodeCopyLiveRegion().textContent = 'Code copied to clipboard'

        window.setTimeout(() => {
          button.classList.remove('ui-code__copy--copied')

          button.setAttribute('aria-label', 'Copy code to clipboard')

          getCodeCopyLiveRegion().textContent = ''
        }, 2000)
      })
    }
  }

  const filterItems = (input: HTMLInputElement, items: HTMLElement[]): void => {
    const query = input.value.trim().toLowerCase()

    for (const item of items) {
      const text = item.textContent?.toLowerCase() ?? ''

      item.hidden = Boolean(query) && !text.includes(query)
    }
  }

  const selectComboboxOption = (root: HTMLElement, option: HTMLElement): void => {
    const input = root.querySelector<HTMLInputElement>('input[role="combobox"]')

    if (!input) return

    input.value = option.dataset.value ?? option.textContent?.trim() ?? ''

    input.dispatchEvent(new Event('input', { bubbles: true }))

    input.dispatchEvent(new Event('change', { bubbles: true }))

    closeCombobox(root)

    input.focus({ preventScroll: true })
  }

  const focusLoopedOption = (
    items: HTMLElement[],
    currentItem: HTMLElement,
    key: string
  ): void => {
    const visibleItems = getVisibleItems(items)

    if (!visibleItems.length) return

    const currentIndex = visibleItems.indexOf(currentItem)
    const nextItem = visibleItems[getLoopedIndex(key, Math.max(0, currentIndex), visibleItems.length, ['ArrowDown'])]

    nextItem?.focus()
  }

  const initCommand = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-command]')) {
      if (root.dataset.uiBound === 'true') continue

      const input = root.querySelector<HTMLInputElement>('input[type="search"], input[type="text"], input:not([type])')

      if (!input) continue

      root.dataset.uiBound = 'true'

      const items = [...root.querySelectorAll<HTMLElement>('[data-ui-command-item], [role="option"], option')]

      input.addEventListener('input', () => {
        filterItems(input, items)
      })
    }
  }

  const initComboboxes = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-combobox]')) {
      if (root.dataset.uiBound === 'true') continue

      const input = root.querySelector<HTMLInputElement>('input[role="combobox"]')
      const listbox = root.querySelector<HTMLElement>('[role="listbox"]')

      if (!input || !listbox) continue

      root.dataset.uiBound = 'true'

      const items = [...listbox.querySelectorAll<HTMLElement>('[role="option"]')]

      closeCombobox(root)

      input.addEventListener('focus', () => openCombobox(root))

      input.addEventListener('input', () => {
        filterItems(input, items)

        openCombobox(root)
      })

      input.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          closeCombobox(root)

          return
        }

        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Enter') return

        const visibleItems = getVisibleItems(items)

        if (!visibleItems.length) return

        event.preventDefault()

        openCombobox(root)

        if (event.key === 'Enter') {
          selectComboboxOption(root, visibleItems[0])

          return
        }

        const targetIndex = event.key === 'ArrowUp' ? visibleItems.length - 1 : 0

        visibleItems[targetIndex]?.focus()
      })

      for (const item of items) {
        item.tabIndex = -1

        item.addEventListener('click', () => selectComboboxOption(root, item))

        item.addEventListener('keydown', event => {
          if (event.key === 'Escape') {
            closeCombobox(root)

            input.focus({ preventScroll: true })

            return
          }

          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault()

            selectComboboxOption(root, item)

            return
          }

          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Home' && event.key !== 'End') return

          event.preventDefault()

          focusLoopedOption(items, item, event.key)
        })
      }
    }
  }

  const initCarousel = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-carousel]')) {
      if (root.dataset.uiBound === 'true') continue

      const viewport = root.querySelector<HTMLElement>('[data-ui-carousel-viewport]')

      if (!viewport) continue

      root.dataset.uiBound = 'true'

      for (const button of root.querySelectorAll<HTMLElement>('[data-ui-carousel-prev]')) {
        button.addEventListener('click', () => viewport.scrollBy({ behavior: 'smooth', left: -viewport.clientWidth }))
      }

      for (const button of root.querySelectorAll<HTMLElement>('[data-ui-carousel-next]')) {
        button.addEventListener('click', () => viewport.scrollBy({ behavior: 'smooth', left: viewport.clientWidth }))
      }
    }
  }

  const initSchedules = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-schedule]')) {
      if (root.dataset.uiBound === 'true') continue

      root.dataset.uiBound = 'true'

      for (const event of root.querySelectorAll<HTMLElement>('[data-ui-schedule-event]')) {
        event.draggable = event.draggable || event.dataset.uiDraggable === 'true'

        event.addEventListener('dragstart', dragEvent => {
          dragEvent.dataTransfer?.setData('text/plain', event.id || event.textContent?.trim() || '')

          root.dataset.uiDragging = 'true'
        })

        event.addEventListener('dragend', () => {
          delete root.dataset.uiDragging
        })
      }

      for (const dropzone of root.querySelectorAll<HTMLElement>('[data-ui-schedule-slot]')) {
        dropzone.addEventListener('dragover', event => {
          event.preventDefault()

          dropzone.dataset.state = 'drag-over'
        })

        dropzone.addEventListener('dragleave', () => {
          delete dropzone.dataset.state
        })

        dropzone.addEventListener('drop', event => {
          event.preventDefault()

          delete dropzone.dataset.state

          const draggedId = event.dataTransfer?.getData('text/plain')
          const dragged = draggedId ? document.getElementById(draggedId) : null

          if (dragged instanceof HTMLElement) {
            dropzone.append(dragged)
          }

          root.dispatchEvent(new CustomEvent('ui:schedule-change', {
            bubbles: true,
            detail: {
              eventId: draggedId,
              slot: dropzone.dataset.uiScheduleSlot
            }
          }))
        })
      }
    }
  }

  const initTreeCollections = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('[role="tree"], [role="treegrid"]')) {
      if (root.dataset.uiBound === 'true') continue

      const items = [...root.querySelectorAll<HTMLElement>('[role="treeitem"], [role="row"]')]

      if (!items.length) continue

      root.dataset.uiBound = 'true'

      for (const [index, item] of items.entries()) {
        item.tabIndex = index === 0 ? 0 : -1

        item.addEventListener('keydown', event => {
          const keys = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End', 'Enter', ' ']

          if (!keys.includes(event.key)) return

          if ((event.key === 'ArrowRight' || event.key === 'Enter' || event.key === ' ') && item.hasAttribute('aria-expanded')) {
            event.preventDefault()

            item.setAttribute('aria-expanded', 'true')

            return
          }

          if (event.key === 'ArrowLeft' && item.hasAttribute('aria-expanded')) {
            event.preventDefault()

            item.setAttribute('aria-expanded', 'false')

            return
          }

          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Home' && event.key !== 'End') return

          event.preventDefault()

          for (const nextItem of items) {
            nextItem.tabIndex = -1
          }

          const nextItem = items[getLoopedIndex(event.key, index, items.length, ['ArrowDown'])]

          if (nextItem) {
            nextItem.tabIndex = 0

            nextItem.focus()
          }
        })
      }
    }
  }

  const initVirtualLists = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-virtual-list]')) {
      if (root.dataset.uiBound === 'true') continue

      const items = [...root.children].filter((child): child is HTMLElement => child instanceof HTMLElement)

      if (!items.length) continue

      root.dataset.uiBound = 'true'

      const overscan = Number(root.dataset.uiOverscan ?? 4)
      const itemSize = Number(root.dataset.uiItemSize ?? 44)

      const update = (): void => {
        const visibleCount = Math.ceil(root.clientHeight / itemSize) + overscan
        const startIndex = Math.max(0, Math.floor(root.scrollTop / itemSize) - overscan)
        const endIndex = startIndex + visibleCount

        for (const [index, item] of items.entries()) {
          item.hidden = index < startIndex || index > endIndex
        }

        root.dispatchEvent(new CustomEvent('ui:virtual-list-range', {
          bubbles: true,
          detail: {
            endIndex: Math.min(items.length - 1, endIndex),
            startIndex
          }
        }))
      }

      root.addEventListener('scroll', update, { passive: true })

      update()
    }
  }

  const initTagGroups = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('.ui-tag-group, [data-ui-tag-group]')) {
      if (root.dataset.uiBound === 'true') continue

      root.dataset.uiBound = 'true'

      for (const button of root.querySelectorAll<HTMLElement>('[data-ui-tag-remove]')) {
        button.addEventListener('click', () => {
          const tag = button.closest<HTMLElement>('[data-ui-tag], [role="listitem"]')

          tag?.remove()

          root.dispatchEvent(new CustomEvent('ui:tag-remove', {
            bubbles: true,
            detail: {
              value: tag?.dataset.value ?? tag?.textContent?.trim()
            }
          }))
        })
      }
    }
  }

  const initRichTextEditors = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-rich-text-editor]')) {
      if (root.dataset.uiBound === 'true') continue

      root.dataset.uiBound = 'true'

      for (const control of root.querySelectorAll<HTMLElement>('[data-ui-editor-command]')) {
        control.addEventListener('click', () => {
          const command = control.dataset.uiEditorCommand

          if (!command) return

          document.execCommand(command)

          root.dispatchEvent(new CustomEvent('ui:editor-command', {
            bubbles: true,
            detail: { command }
          }))
        })
      }
    }
  }

  const initThemeBuilders = (scope: ParentNode): void => {
    for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-theme-builder]')) {
      if (root.dataset.uiBound === 'true') continue

      root.dataset.uiBound = 'true'

      const exportButton = root.querySelector<HTMLElement>('[data-ui-theme-export]')
      const output = root.querySelector<HTMLTextAreaElement | HTMLOutputElement>('[data-ui-theme-output]')
      const hueInput = root.querySelector<HTMLInputElement>('[data-ui-theme-hue]')

      hueInput?.addEventListener('input', () => {
        const hue = ((Number(hueInput.value) % 360) + 360) % 360

        if (Number.isNaN(hue)) return

        const target = root.dataset.uiThemeTarget
          ? document.querySelector<HTMLElement>(root.dataset.uiThemeTarget)
          : document.documentElement

        if (!target) return

        const isDark = document.documentElement.dataset.theme?.includes('dark') ?? false
        const accentHue = (hue + 150) % 360
        const tokens: Record<string, string> = isDark
          ? {
              accent: `${accentHue} 70% 48%`,
              brand: `${hue} 88% 60%`,
              'brand-soft': `${hue} 80% 16%`,
              'brand-solid': `${hue} 88% 46%`,
              canvas: `${hue} 24% 8%`,
              ink: `${hue} 20% 96%`,
              'ink-muted': `${hue} 10% 58%`,
              'ink-soft': `${hue} 14% 77%`,
              line: `${hue} 14% 26%`,
              surface: `${hue} 18% 11%`,
              'surface-muted': `${hue} 16% 15%`,
              'surface-strong': `${hue} 14% 22%`
            }
          : {
              accent: `${accentHue} 70% 40%`,
              brand: `${hue} 85% 53%`,
              'brand-soft': `${hue} 90% 96%`,
              'brand-solid': `${hue} 85% 45%`,
              canvas: `${hue} 20% 99%`,
              ink: `${hue} 40% 11%`,
              'ink-muted': `${hue} 10% 48%`,
              'ink-soft': `${hue} 14% 32%`,
              line: `${hue} 14% 86%`,
              surface: `${hue} 20% 100%`,
              'surface-muted': `${hue} 16% 96%`,
              'surface-strong': `${hue} 14% 91%`
            }

        for (const [token, value] of Object.entries(tokens)) {
          target.style.setProperty(`--${token}`, value)
        }

        root.dispatchEvent(new CustomEvent('ui:theme-change', {
          bubbles: true,
          detail: { hue, tokens }
        }))
      })

      exportButton?.addEventListener('click', async () => {
        const target = root.dataset.uiThemeTarget ? document.querySelector<HTMLElement>(root.dataset.uiThemeTarget) : document.documentElement
        const styles = getComputedStyle(target ?? document.documentElement)

        const tokens = [
          'canvas',
          'surface',
          'surface-muted',
          'surface-strong',
          'line',
          'ink',
          'ink-soft',
          'ink-muted',
          'brand',
          'brand-solid',
          'brand-soft',
          'accent',
          'success',
          'warning',
          'danger'
        ]

        const css = `:root {\n${tokens.map(token => `  --${token}: ${styles.getPropertyValue(`--${token}`).trim()};`).join('\n')}\n}`

        if (output) {
          output.value = css
        }

        await navigator.clipboard?.writeText(css).catch(() => null)

        root.dispatchEvent(new CustomEvent('ui:theme-export', {
          bubbles: true,
          detail: { css }
        }))
      })
    }
  }

  const getToastVariantClass = (variant: string | undefined): string => {
    if (variant === 'success') return 'ui-toast--success'

    if (variant === 'warning') return 'ui-toast--warning'

    if (variant === 'destructive') return 'ui-toast--destructive'

    return ''
  }

  const initToasts = (): void => {
    if (document.documentElement.dataset.uiToastsBound === 'true') return

    document.documentElement.dataset.uiToastsBound = 'true'

    document.addEventListener('ui:toast', event => {
      const detail = event instanceof CustomEvent ? event.detail as { description?: string, title?: string, variant?: string } : {}
      const viewport = document.querySelector<HTMLElement>('[data-ui-sonner]') ?? document.body
      const toast = document.createElement('aside')
      const title = document.createElement('strong')
      const variantClass = getToastVariantClass(detail.variant)

      toast.className = variantClass ? `ui-toast ${variantClass}` : 'ui-toast'

      toast.setAttribute('role', detail.variant === 'destructive' ? 'alert' : 'status')

      title.textContent = detail.title ?? 'Notification'

      toast.append(title)

      if (detail.description) {
        const description = document.createElement('p')

        description.textContent = detail.description

        toast.append(description)
      }

      viewport.append(toast)

      window.setTimeout(() => {
        toast.dataset.state = 'closed'

        window.setTimeout(() => toast.remove(), 240)
      }, 5000)
    })
  }

  const initUiPrimitives = (scope: ParentNode = document): void => {
    initDialogs(scope)

    initDisclosures(scope)

    initTabs(scope)

    initRovingGroups(scope)

    initToggles(scope)

    initCommand(scope)

    initComboboxes(scope)

    initCodeCopy(scope)

    initCarousel(scope)

    initSchedules(scope)

    initTreeCollections(scope)

    initVirtualLists(scope)

    initTagGroups(scope)

    initRichTextEditors(scope)

    initThemeBuilders(scope)

    initTooltips(scope)

    initGlassTracking(scope)

    initToasts()
  }

  document.addEventListener('click', event => {
    const target = event.target

    if (!(target instanceof Node)) return

    for (const root of document.querySelectorAll<HTMLElement>(disclosureSelector)) {
      if (!root.contains(target)) {
        closeDisclosure(root)
      }
    }

    for (const root of document.querySelectorAll<HTMLElement>('[data-ui-combobox]')) {
      if (!root.contains(target)) {
        closeCombobox(root)
      }
    }
  })

  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return

    for (const root of document.querySelectorAll<HTMLElement>(disclosureSelector)) {
      closeDisclosure(root)
    }

    for (const root of document.querySelectorAll<HTMLElement>('[data-ui-combobox]')) {
      closeCombobox(root)
    }
  })

  document.addEventListener('astro:page-load', () => initUiPrimitives())

  document.addEventListener('astro:after-swap', () => initUiPrimitives())

  initUiPrimitives()
</script>

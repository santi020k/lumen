const calendarDatePattern = /^\d{4}-\d{2}-\d{2}$/
const calendarMonthPattern = /^\d{4}-\d{2}$/

const parseCalendarDate = (value: string | null | undefined): Date | null => {
  if (!value || !calendarDatePattern.test(value)) return null

  const [year, month, day] = value.split('-').map(Number)
  const date = new Date(Date.UTC(year, month - 1, day))

  return date.getUTCFullYear() === year &&
    date.getUTCMonth() === month - 1 &&
    date.getUTCDate() === day ?
    date :
    null
}

const parseCalendarMonth = (value: string | null | undefined): Date | null => {
  if (!value || !calendarMonthPattern.test(value)) return null

  const [year, month] = value.split('-').map(Number)
  const date = new Date(Date.UTC(year, month - 1, 1))

  return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 ? date : null
}

const formatCalendarDate = (date: Date): string => date.toISOString().slice(0, 10)
const formatCalendarMonth = (date: Date): string => date.toISOString().slice(0, 7)

const addCalendarDays = (date: Date, days: number): Date => new Date(
  Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate() + days)
)

const getCalendarDaysInMonth = (date: Date): number => new Date(
  Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + 1, 0)
).getUTCDate()

const addCalendarMonths = (date: Date, months: number): Date => {
  const year = date.getUTCFullYear()
  const month = date.getUTCMonth() + months
  const day = date.getUTCDate()
  const targetMonth = new Date(Date.UTC(year, month, 1))
  const daysInTargetMonth = getCalendarDaysInMonth(targetMonth)

  return new Date(Date.UTC(
    targetMonth.getUTCFullYear(), targetMonth.getUTCMonth(), Math.min(day, daysInTargetMonth)
  ))
}

const compareCalendarDates = (date: Date, other: Date | null): number => {
  if (!other) return 0

  return formatCalendarDate(date).localeCompare(formatCalendarDate(other))
}

const isCalendarDateDisabled = (
  root: HTMLElement,
  date: Date,
  min: Date | null,
  max: Date | null
): boolean => root.dataset.disabled === 'true' ||
  compareCalendarDates(date, min) < 0 ||
  compareCalendarDates(date, max) > 0

const clampCalendarDate = (date: Date, min: Date | null, max: Date | null): Date => {
  if (min && compareCalendarDates(date, min) < 0) return min

  if (max && compareCalendarDates(date, max) > 0) return max

  return date
}

const getCalendarLocale = (): string => document.documentElement.lang || navigator.language || 'en'

const getCalendarToday = (): Date => {
  const today = new Date()

  return new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()))
}

const getCalendarGridStart = (month: Date): Date => addCalendarDays(month, -((month.getUTCDay() + 6) % 7))

const getCalendarFocusDate = (
  root: HTMLElement,
  month: Date,
  min: Date | null,
  max: Date | null,
  requestedDate?: Date | null
): Date => {
  const selectedDate = parseCalendarDate(root.dataset.uiCalendarValue)
  const today = getCalendarToday()
  const candidates = [requestedDate, selectedDate, today, month]

  for (const candidate of candidates) {
    if (
      candidate &&
      formatCalendarMonth(candidate) === formatCalendarMonth(month) &&
      !isCalendarDateDisabled(root, candidate, min, max)
    ) {
      return candidate
    }
  }

  for (let index = 0; index < getCalendarDaysInMonth(month); index += 1) {
    const date = addCalendarDays(month, index)

    if (!isCalendarDateDisabled(root, date, min, max)) return date
  }

  return month
}

const syncCalendarNavigation = (
  root: HTMLElement,
  month: Date,
  min: Date | null,
  max: Date | null
): void => {
  const previous = root.querySelector<HTMLButtonElement>('[data-ui-calendar-prev]')
  const next = root.querySelector<HTMLButtonElement>('[data-ui-calendar-next]')
  const disabled = root.dataset.disabled === 'true'
  const previousMonthLastDay = addCalendarDays(month, -1)
  const nextMonthFirstDay = addCalendarMonths(month, 1)

  if (previous) {
    previous.disabled = disabled || compareCalendarDates(previousMonthLastDay, min) < 0
  }

  if (next) {
    next.disabled = disabled || compareCalendarDates(nextMonthFirstDay, max) > 0
  }
}

const renderCalendar = (
  root: HTMLElement,
  requestedFocusDate?: Date | null,
  shouldFocus = false
): void => {
  const label = root.querySelector<HTMLElement>('[data-ui-calendar-label]')
  const grid = root.querySelector<HTMLElement>('[data-ui-calendar-grid]')

  if (!label || !grid) return

  const locale = getCalendarLocale()
  const min = parseCalendarDate(root.dataset.uiCalendarMin)
  const max = parseCalendarDate(root.dataset.uiCalendarMax)
  const selectedDate = parseCalendarDate(root.dataset.uiCalendarValue)
  const todayIso = formatCalendarDate(getCalendarToday())

  const month = parseCalendarMonth(root.dataset.uiCalendarMonth) ??
    (selectedDate ? new Date(Date.UTC(selectedDate.getUTCFullYear(), selectedDate.getUTCMonth(), 1)) : null) ??
    getCalendarToday()

  const visibleMonth = new Date(Date.UTC(month.getUTCFullYear(), month.getUTCMonth(), 1))
  const focusDate = getCalendarFocusDate(root, visibleMonth, min, max, requestedFocusDate)
  const focusIso = formatCalendarDate(focusDate)
  const selectedIso = selectedDate ? formatCalendarDate(selectedDate) : ''

  const monthLabel = new Intl.DateTimeFormat(locale, {
    month: 'long',
    timeZone: 'UTC',
    year: 'numeric'
  }).format(visibleMonth)

  const dayLabel = new Intl.DateTimeFormat(locale, {
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
    weekday: 'long',
    year: 'numeric'
  })

  const weekdayLabel = new Intl.DateTimeFormat(locale, {
    timeZone: 'UTC',
    weekday: 'short'
  })

  const table = grid instanceof HTMLTableElement ? grid : null

  root.dataset.uiCalendarMonth = formatCalendarMonth(visibleMonth)

  label.textContent = monthLabel

  syncCalendarNavigation(root, visibleMonth, min, max)

  const header = document.createElement('thead')
  const headerRow = document.createElement('tr')

  headerRow.role = 'row'

  for (let index = 0; index < 7; index += 1) {
    const cell = document.createElement('th')

    cell.scope = 'col'

    cell.role = 'columnheader'

    cell.textContent = weekdayLabel.format(new Date(Date.UTC(2026, 0, 5 + index)))

    headerRow.append(cell)
  }

  header.append(headerRow)

  const body = document.createElement('tbody')
  const firstCell = getCalendarGridStart(visibleMonth)

  for (let rowIndex = 0; rowIndex < 6; rowIndex += 1) {
    const row = document.createElement('tr')

    row.role = 'row'

    for (let columnIndex = 0; columnIndex < 7; columnIndex += 1) {
      const date = addCalendarDays(firstCell, rowIndex * 7 + columnIndex)
      const dateIso = formatCalendarDate(date)
      const cell = document.createElement('td')
      const unavailable = isCalendarDateDisabled(root, date, min, max)

      cell.role = 'gridcell'

      cell.tabIndex = !unavailable && dateIso === focusIso ? 0 : -1

      cell.textContent = String(date.getUTCDate())

      cell.dataset.date = dateIso

      cell.dataset.uiCalendarDay = ''

      cell.setAttribute('aria-label', dayLabel.format(date))

      cell.setAttribute('aria-selected', String(selectedIso === dateIso))

      if (unavailable) {
        cell.setAttribute('aria-disabled', 'true')
      }

      if (formatCalendarMonth(date) !== formatCalendarMonth(visibleMonth)) {
        cell.dataset.outside = 'true'
      }

      if (dateIso === todayIso) {
        cell.dataset.today = 'true'
      }

      if (selectedIso === dateIso) {
        cell.dataset.selected = 'true'
      }

      row.append(cell)
    }

    body.append(row)
  }

  if (table) {
    table.replaceChildren(header, body)
  } else {
    grid.replaceChildren(header, body)
  }

  if (shouldFocus) {
    root.querySelector<HTMLElement>(`[data-ui-calendar-day][data-date="${focusIso}"]`)?.focus({ preventScroll: true })
  }
}

const selectCalendarDate = (root: HTMLElement, date: Date): void => {
  const input = root.querySelector<HTMLInputElement>('[data-ui-calendar-input]')

  if (!input || root.dataset.disabled === 'true') return

  const min = parseCalendarDate(root.dataset.uiCalendarMin)
  const max = parseCalendarDate(root.dataset.uiCalendarMax)
  const nextDate = clampCalendarDate(date, min, max)

  if (isCalendarDateDisabled(root, nextDate, min, max)) return

  input.value = formatCalendarDate(nextDate)

  root.dataset.uiCalendarValue = input.value

  root.dataset.uiCalendarMonth = formatCalendarMonth(nextDate)

  input.dispatchEvent(new Event('input', { bubbles: true }))

  input.dispatchEvent(new Event('change', { bubbles: true }))

  renderCalendar(root, nextDate, true)
}

const focusCalendarDate = (root: HTMLElement, date: Date): void => {
  const min = parseCalendarDate(root.dataset.uiCalendarMin)
  const max = parseCalendarDate(root.dataset.uiCalendarMax)
  const nextDate = clampCalendarDate(date, min, max)

  root.dataset.uiCalendarMonth = formatCalendarMonth(nextDate)

  renderCalendar(root, nextDate, true)
}

const moveCalendarFocus = (root: HTMLElement, currentDate: Date, key: string): void => {
  const column = (currentDate.getUTCDay() + 6) % 7

  const keyOffsets: Record<string, number> = {
    ArrowDown: 7,
    ArrowLeft: -1,
    ArrowRight: 1,
    ArrowUp: -7,
    End: 6 - column,
    Home: -column
  }

  if (key === 'PageDown' || key === 'PageUp') {
    focusCalendarDate(root, addCalendarMonths(currentDate, key === 'PageDown' ? 1 : -1))

    return
  }

  const offset = keyOffsets[key]

  if (offset === undefined) return

  focusCalendarDate(root, addCalendarDays(currentDate, offset))
}

const initCalendars = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-calendar]')) {
    if (root.dataset.uiBound === 'true') continue

    const input = root.querySelector<HTMLInputElement>('[data-ui-calendar-input]')

    if (!input) continue

    root.dataset.uiBound = 'true'

    renderCalendar(root)

    root.querySelector<HTMLButtonElement>('[data-ui-calendar-prev]')?.addEventListener('click', () => {
      const month = parseCalendarMonth(root.dataset.uiCalendarMonth)

      if (!month) return

      const nextMonth = addCalendarMonths(month, -1)

      root.dataset.uiCalendarMonth = formatCalendarMonth(nextMonth)

      renderCalendar(root, nextMonth, true)
    })

    root.querySelector<HTMLButtonElement>('[data-ui-calendar-next]')?.addEventListener('click', () => {
      const month = parseCalendarMonth(root.dataset.uiCalendarMonth)

      if (!month) return

      const nextMonth = addCalendarMonths(month, 1)

      root.dataset.uiCalendarMonth = formatCalendarMonth(nextMonth)

      renderCalendar(root, nextMonth, true)
    })

    root.addEventListener('click', event => {
      const target = event.target

      if (!(target instanceof Element)) return

      const cell = target.closest<HTMLElement>('[data-ui-calendar-day]')

      if (!cell || !root.contains(cell) || cell.getAttribute('aria-disabled') === 'true') return

      const date = parseCalendarDate(cell.dataset.date)

      if (date) {
        selectCalendarDate(root, date)
      }
    })

    root.addEventListener('keydown', event => {
      const target = event.target

      if (!(target instanceof HTMLElement) || !target.hasAttribute('data-ui-calendar-day')) return

      const date = parseCalendarDate(target.dataset.date)

      if (!date) return

      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault()

        selectCalendarDate(root, date)

        return
      }

      if (
        event.key !== 'ArrowDown' &&
        event.key !== 'ArrowLeft' &&
        event.key !== 'ArrowRight' &&
        event.key !== 'ArrowUp' &&
        event.key !== 'End' &&
        event.key !== 'Home' &&
        event.key !== 'PageDown' &&
        event.key !== 'PageUp'
      ) {
        return
      }

      event.preventDefault()

      moveCalendarFocus(root, date, event.key)
    })

    input.form?.addEventListener('reset', () => {
      window.setTimeout(() => {
        root.dataset.uiCalendarValue = input.value

        root.dataset.uiCalendarMonth = root.dataset.uiCalendarInitialMonth ?? root.dataset.uiCalendarMonth

        renderCalendar(root)
      })
    })
  }
}

const formatDatePickerValue = (value: string, placeholder: string): string => {
  const date = parseCalendarDate(value)

  if (!date) return placeholder

  return new Intl.DateTimeFormat(getCalendarLocale(), {
    day: 'numeric',
    month: 'short',
    timeZone: 'UTC',
    year: 'numeric'
  }).format(date)
}

const closeDatePicker = (root: HTMLElement, restoreFocus = false): void => {
  const trigger = root.querySelector<HTMLButtonElement>('[data-ui-date-picker-trigger]')
  const popover = root.querySelector<HTMLElement>('[data-ui-date-picker-popover]')

  if (!trigger || !popover || popover.hidden) return

  popover.hidden = true

  popover.dataset.state = 'closed'

  trigger.setAttribute('aria-expanded', 'false')

  if (restoreFocus) trigger.focus()
}

const syncDatePickerValue = (root: HTMLElement): void => {
  const native = root.querySelector<HTMLInputElement>('[data-ui-date-picker-native]')
  const value = root.querySelector<HTMLElement>('[data-ui-date-picker-value]')

  if (!native || !value) return

  const placeholder = native.getAttribute('placeholder') || 'Choose a date'

  value.textContent = formatDatePickerValue(native.value, placeholder)

  if (native.value) {
    delete root.dataset.placeholder
  } else {
    root.dataset.placeholder = 'true'
  }

  if (native.validity.valid) {
    root.querySelector<HTMLElement>('[data-ui-date-picker-trigger]')?.removeAttribute('aria-invalid')
  }
}

const openDatePicker = (root: HTMLElement): void => {
  const native = root.querySelector<HTMLInputElement>('[data-ui-date-picker-native]')
  const trigger = root.querySelector<HTMLButtonElement>('[data-ui-date-picker-trigger]')
  const popover = root.querySelector<HTMLElement>('[data-ui-date-picker-popover]')
  const calendar = root.querySelector<HTMLElement>('[data-ui-calendar]')

  if (!native || !trigger || !popover || native.disabled) return

  for (const other of document.querySelectorAll<HTMLElement>('[data-ui-date-picker]')) {
    if (other !== root) closeDatePicker(other)
  }

  if (calendar) {
    calendar.dataset.uiCalendarValue = native.value

    if (native.value) calendar.dataset.uiCalendarMonth = native.value.slice(0, 7)

    if (native.min) calendar.dataset.uiCalendarMin = native.min
    else delete calendar.dataset.uiCalendarMin

    if (native.max) calendar.dataset.uiCalendarMax = native.max
    else delete calendar.dataset.uiCalendarMax

    renderCalendar(calendar)
  }

  popover.hidden = false

  popover.dataset.state = 'open'

  trigger.setAttribute('aria-expanded', 'true')

  window.requestAnimationFrame(() => {
    calendar?.querySelector<HTMLElement>('[data-ui-calendar-day][tabindex="0"]')?.focus({ preventScroll: true })
  })
}

const initDatePickers = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-date-picker]')) {
    if (root.dataset.uiDatePickerBound === 'true') continue

    const native = root.querySelector<HTMLInputElement>('[data-ui-date-picker-native]')
    const control = root.querySelector<HTMLElement>('[data-ui-date-picker-control]')
    const trigger = root.querySelector<HTMLButtonElement>('[data-ui-date-picker-trigger]')
    const popover = root.querySelector<HTMLElement>('[data-ui-date-picker-popover]')
    const calendarInput = root.querySelector<HTMLInputElement>('[data-ui-calendar-input]')

    if (!native || !control || !trigger || !popover || !calendarInput) continue

    root.dataset.uiDatePickerBound = 'true'

    native.dataset.uiEnhanced = 'true'

    native.setAttribute('aria-hidden', 'true')

    native.tabIndex = -1

    control.hidden = false

    const accessibleName = native.getAttribute('aria-label')
    const labelledBy = native.getAttribute('aria-labelledby')
    const describedBy = native.getAttribute('aria-describedby')

    if (accessibleName) trigger.setAttribute('aria-label', accessibleName)

    if (labelledBy) trigger.setAttribute('aria-labelledby', labelledBy)

    if (describedBy) trigger.setAttribute('aria-describedby', describedBy)

    syncDatePickerValue(root)

    trigger.addEventListener('click', () => {
      if (popover.hidden) openDatePicker(root)
      else closeDatePicker(root)
    })

    trigger.addEventListener('keydown', event => {
      if (event.key !== 'ArrowDown') return

      event.preventDefault()

      openDatePicker(root)
    })

    calendarInput.addEventListener('change', () => {
      native.value = calendarInput.value

      syncDatePickerValue(root)

      native.dispatchEvent(new Event('input', { bubbles: true }))

      native.dispatchEvent(new Event('change', { bubbles: true }))

      closeDatePicker(root, true)
    })

    native.addEventListener('change', () => syncDatePickerValue(root))

    native.addEventListener('invalid', event => {
      event.preventDefault()

      trigger.setAttribute('aria-invalid', 'true')

      trigger.focus()
    })

    native.form?.addEventListener('reset', () => {
      window.setTimeout(() => {
        syncDatePickerValue(root)

        closeDatePicker(root)
      })
    })
  }
}

const initCarousel = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-carousel]')) {
    if (root.dataset.uiBound === 'true') continue

    const viewport = root.querySelector<HTMLElement>('[data-ui-carousel-viewport]')

    if (!viewport) continue

    root.dataset.uiBound = 'true'

    for (const button of root.querySelectorAll<HTMLElement>('[data-ui-carousel-prev]')) {
      button.addEventListener('click', () => viewport.scrollBy({ behavior: 'smooth', left: -viewport.clientWidth }))
    }

    for (const button of root.querySelectorAll<HTMLElement>('[data-ui-carousel-next]')) {
      button.addEventListener('click', () => viewport.scrollBy({ behavior: 'smooth', left: viewport.clientWidth }))
    }
  }
}

const initSchedules = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-schedule]')) {
    if (root.dataset.uiBound === 'true') continue

    root.dataset.uiBound = 'true'

    for (const event of root.querySelectorAll<HTMLElement>('[data-ui-schedule-event]')) {
      event.draggable = event.draggable || event.dataset.uiDraggable === 'true'

      event.addEventListener('dragstart', dragEvent => {
        dragEvent.dataTransfer?.setData('text/plain', event.id || event.textContent?.trim() || '')

        root.dataset.uiDragging = 'true'
      })

      event.addEventListener('dragend', () => {
        delete root.dataset.uiDragging
      })
    }

    for (const dropzone of root.querySelectorAll<HTMLElement>('[data-ui-schedule-slot]')) {
      dropzone.addEventListener('dragover', event => {
        event.preventDefault()

        dropzone.dataset.state = 'drag-over'
      })

      dropzone.addEventListener('dragleave', () => {
        delete dropzone.dataset.state
      })

      dropzone.addEventListener('drop', event => {
        event.preventDefault()

        delete dropzone.dataset.state

        const draggedId = event.dataTransfer?.getData('text/plain')
        const dragged = draggedId ? document.getElementById(draggedId) : null

        if (dragged instanceof HTMLElement) {
          dropzone.append(dragged)
        }

        root.dispatchEvent(new CustomEvent('ui:schedule-change', {
          bubbles: true,
          detail: {
            eventId: draggedId,
            slot: dropzone.dataset.uiScheduleSlot
          }
        }))
      })
    }
  }
}

const kanbanColumnSelector = '[data-ui-kanban-column]'

const initKanbanBoards = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-kanban]')) {
    for (const handle of root.querySelectorAll<HTMLElement>('[data-ui-kanban-handle]'))
      handle.draggable = true

    if (root.dataset.uiKanbanBound === 'true') continue

    root.dataset.uiKanbanBound = 'true'

    let pointer: {
      active: boolean
      handle: HTMLElement
      item: HTMLElement
      pointerId: number
      startX: number
      startY: number
    } | undefined

    const itemFor = (target: EventTarget | null): HTMLElement | null => {
      const item = target instanceof Element ?
        target.closest<HTMLElement>('[data-ui-kanban-item]') :
        null

      return item?.closest<HTMLElement>('[data-ui-kanban]') === root ? item : null
    }

    const columnFor = (target: EventTarget | null): HTMLElement | null => {
      const column = target instanceof Element ?
        target.closest<HTMLElement>(kanbanColumnSelector) :
        null

      return column?.closest<HTMLElement>('[data-ui-kanban]') === root ? column : null
    }

    const clearState = (): void => {
      pointer = undefined

      for (const item of root.querySelectorAll<HTMLElement>('[data-ui-kanban-item]'))
        if (item.dataset.state === 'dragging') delete item.dataset.state

      for (const column of root.querySelectorAll<HTMLElement>(kanbanColumnSelector))
        if (column.dataset.state === 'drop-target') delete column.dataset.state
    }

    const announce = (column: HTMLElement): void => {
      let live = root.querySelector<HTMLElement>('[data-ui-kanban-live]')

      if (!live) {
        live = document.createElement('span')

        live.className = 'ui-visually-hidden'

        live.dataset.uiKanbanLive = ''

        live.setAttribute('aria-live', 'polite')

        live.setAttribute('role', 'status')

        root.append(live)
      }

      const label = column.getAttribute('aria-label') ||
        column.querySelector('h2, h3, [data-ui-kanban-column-label]')?.textContent?.trim() ||
        column.dataset.uiKanbanColumn || ''

      live.textContent = `Move requested to ${label}.`
    }

    const requestMove = (
      item: HTMLElement,
      targetColumn: HTMLElement,
      input: 'keyboard' | 'pointer'
    ): void => {
      const fromColumn = item.closest<HTMLElement>(kanbanColumnSelector)
        ?.dataset.uiKanbanColumn ?? ''

      const detail = createLumenKanbanMoveDetail({
        fromColumn,
        input,
        itemId: item.dataset.uiKanbanItem ?? item.id,
        toColumn: targetColumn.dataset.uiKanbanColumn ?? ''
      })

      if (!detail) return

      const accepted = root.dispatchEvent(new CustomEvent('ui:kanban-move-request', {
        bubbles: true,
        cancelable: true,
        detail
      }))

      if (accepted) announce(targetColumn)
    }

    root.addEventListener('dragstart', event => {
      const handle = event.target instanceof Element ?
        event.target.closest<HTMLElement>('[data-ui-kanban-handle]') :
        null

      const item = itemFor(handle)

      if (!handle || !item || item.getAttribute('aria-busy') === 'true') {
        event.preventDefault()

        return
      }

      event.dataTransfer?.setData('text/plain', item.dataset.uiKanbanItem ?? item.id)

      if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move'

      item.dataset.state = 'dragging'
    })

    root.addEventListener('dragend', clearState)

    root.addEventListener('dragover', event => {
      const column = columnFor(event.target)

      if (!column) return

      event.preventDefault()

      column.dataset.state = 'drop-target'

      if (event.dataTransfer) event.dataTransfer.dropEffect = 'move'
    })

    root.addEventListener('dragleave', event => {
      const column = columnFor(event.target)

      if (
        !column ||
        (event.relatedTarget instanceof Node && column.contains(event.relatedTarget))
      ) return

      delete column.dataset.state
    })

    root.addEventListener('drop', event => {
      const column = columnFor(event.target)
      const itemId = event.dataTransfer?.getData('text/plain') ?? ''

      const item = [...root.querySelectorAll<HTMLElement>('[data-ui-kanban-item]')]
        .find(candidate => (candidate.dataset.uiKanbanItem ?? candidate.id) === itemId)

      if (!column || !item) return

      event.preventDefault()

      requestMove(item, column, 'pointer')

      clearState()
    })

    root.addEventListener('keydown', event => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return

      const handle = event.target instanceof Element ?
        event.target.closest<HTMLElement>('[data-ui-kanban-handle]') :
        null

      const item = itemFor(handle)
      const currentColumn = columnFor(item)

      if (!handle || !item || !currentColumn || item.getAttribute('aria-busy') === 'true') return

      const columns = [...root.querySelectorAll<HTMLElement>(kanbanColumnSelector)]
      const currentIndex = columns.indexOf(currentColumn)
      const direction = event.key === 'ArrowRight' ? 1 : -1
      const rtl = getComputedStyle(root).direction === 'rtl'
      const target = columns[currentIndex + (rtl ? -direction : direction)]

      if (!target) return

      event.preventDefault()

      requestMove(item, target, 'keyboard')
    })

    root.addEventListener('pointerdown', event => {
      if (event.pointerType === 'mouse') return

      const handle = event.target instanceof Element ?
        event.target.closest<HTMLElement>('[data-ui-kanban-handle]') :
        null

      const item = itemFor(handle)

      if (!handle || !item || item.getAttribute('aria-busy') === 'true') return

      pointer = {
        active: false,
        handle,
        item,
        pointerId: event.pointerId,
        startX: event.clientX,
        startY: event.clientY
      }
    })

    root.addEventListener('pointermove', event => {
      if (!pointer || pointer.pointerId !== event.pointerId) return

      if (!pointer.active && Math.hypot(
        event.clientX - pointer.startX,
        event.clientY - pointer.startY
      ) < 8) return

      pointer.active = true

      pointer.handle.setPointerCapture(event.pointerId)

      pointer.item.dataset.state = 'dragging'

      const target = columnFor(document.elementFromPoint(event.clientX, event.clientY))

      for (const column of root.querySelectorAll<HTMLElement>(kanbanColumnSelector)) {
        if (column === target) column.dataset.state = 'drop-target'
        else delete column.dataset.state
      }
    })

    root.addEventListener('pointerup', event => {
      if (!pointer || pointer.pointerId !== event.pointerId) return

      const target = columnFor(document.elementFromPoint(event.clientX, event.clientY))

      if (pointer.active && target) requestMove(pointer.item, target, 'pointer')

      clearState()
    })

    root.addEventListener('pointercancel', clearState)
  }
}

const initTreeCollections = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[role="tree"], [role="treegrid"]')) {
    if (root.dataset.uiBound === 'true') continue

    const items = [...root.querySelectorAll<HTMLElement>('[role="treeitem"], [role="row"]')]

    if (!items.length) continue

    root.dataset.uiBound = 'true'

    for (const [index, item] of items.entries()) {
      item.tabIndex = index === 0 ? 0 : -1

      item.addEventListener('keydown', event => {
        const keys = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End', 'Enter', ' ']

        if (!keys.includes(event.key)) return

        const opensBranch = ['ArrowRight', 'Enter', ' '].includes(event.key)

        if (opensBranch && item.hasAttribute('aria-expanded')) {
          event.preventDefault()

          item.setAttribute('aria-expanded', 'true')

          return
        }

        if (event.key === 'ArrowLeft' && item.hasAttribute('aria-expanded')) {
          event.preventDefault()

          item.setAttribute('aria-expanded', 'false')

          return
        }

        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Home' && event.key !== 'End') return

        event.preventDefault()

        for (const nextItem of items) {
          nextItem.tabIndex = -1
        }

        const nextItem = items[getLoopedIndex(event.key, index, items.length, ['ArrowDown'])]

        if (nextItem) {
          nextItem.tabIndex = 0

          nextItem.focus()
        }
      })
    }
  }
}

const initVirtualLists = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-virtual-list]')) {
    if (root.dataset.uiBound === 'true') continue

    const items = [...root.children].filter((child): child is HTMLElement => child instanceof HTMLElement)

    if (!items.length) continue

    root.dataset.uiBound = 'true'

    const overscan = Number(root.dataset.uiOverscan ?? 4)
    const itemSize = Number(root.dataset.uiItemSize ?? 44)

    const update = (): void => {
      const visibleCount = Math.ceil(root.clientHeight / itemSize) + overscan
      const startIndex = Math.max(0, Math.floor(root.scrollTop / itemSize) - overscan)
      const endIndex = startIndex + visibleCount

      for (const [index, item] of items.entries()) {
        item.hidden = index < startIndex || index > endIndex
      }

      root.dispatchEvent(new CustomEvent('ui:virtual-list-range', {
        bubbles: true,
        detail: {
          endIndex: Math.min(items.length - 1, endIndex),
          startIndex
        }
      }))
    }

    root.addEventListener('scroll', update, { passive: true })

    update()
  }
}

const initTagGroups = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('.ui-tag-group, [data-ui-tag-group]')) {
    if (root.dataset.uiBound === 'true') continue

    root.dataset.uiBound = 'true'

    for (const button of root.querySelectorAll<HTMLElement>('[data-ui-tag-remove]')) {
      button.addEventListener('click', () => {
        const tag = button.closest<HTMLElement>('[data-ui-tag], [role="listitem"]')

        tag?.remove()

        root.dispatchEvent(new CustomEvent('ui:tag-remove', {
          bubbles: true,
          detail: {
            value: tag?.dataset.value ?? tag?.textContent?.trim()
          }
        }))
      })
    }
  }
}

const richTextEditorContentSelector = '[data-ui-rich-text-editable], [contenteditable="true"]'

const getRichTextCommandValue = (control: HTMLElement): string | undefined => {
  if (control.dataset.uiEditorValue !== undefined) return control.dataset.uiEditorValue

  if (
    control instanceof HTMLInputElement ||
    control instanceof HTMLSelectElement ||
    control instanceof HTMLTextAreaElement
  ) return control.value

  return undefined
}

const syncRichTextCommandStates = (root: HTMLElement): void => {
  const commandDocument = document as unknown as RichTextCommandDocument

  for (const control of root.querySelectorAll<HTMLElement>('[data-ui-editor-command]')) {
    const command = control.dataset.uiEditorCommand ?? ''
    const value = getRichTextCommandValue(control)
    let active = false

    if (isLumenRichTextToggleCommand(command)) {
      active = commandDocument.queryCommandState?.(command) ?? false

      control.setAttribute('aria-pressed', String(active))
    } else if (command === 'formatBlock' && value) {
      const currentValue = commandDocument.queryCommandValue?.(command)
        .replaceAll(/[<>]/g, '')
        .toLowerCase()

      active = currentValue === value.replaceAll(/[<>]/g, '').toLowerCase()
    }

    control.dataset.state = active ? 'on' : 'off'
  }
}

const dispatchRichTextChange = (root: HTMLElement): void => {
  const editable = root.querySelector<HTMLElement>(richTextEditorContentSelector)

  if (!editable) return

  const detail: LumenRichTextChangeDetail = {
    html: editable.innerHTML,
    text: editable.textContent ?? ''
  }

  root.dispatchEvent(new CustomEvent<LumenRichTextChangeDetail>('ui:editor-change', {
    bubbles: true,
    detail
  }))
}

const executeRichTextCommand = (
  root: HTMLElement,
  command: string,
  value?: string
): boolean => {
  if (!command) return false

  const commandDocument = document as unknown as RichTextCommandDocument
  let executed = false

  if (typeof commandDocument.execCommand === 'function') {
    executed = value === undefined ?
      commandDocument.execCommand(command) :
      commandDocument.execCommand(command, false, value)
  }

  const detail: LumenRichTextCommandDetail = {
    command,
    executed,
    ...(value === undefined ? {} : { value })
  }

  root.dispatchEvent(new CustomEvent<LumenRichTextCommandDetail>('ui:editor-command', {
    bubbles: true,
    detail
  }))

  syncRichTextCommandStates(root)

  dispatchRichTextChange(root)

  return executed
}

const initRichTextEditors = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-rich-text-editor]')) {
    if (root.dataset.uiBound === 'true') continue

    root.dataset.uiBound = 'true'

    for (const control of root.querySelectorAll<HTMLElement>('[data-ui-editor-command]')) {
      const execute = () => {
        executeRichTextCommand(
          root, control.dataset.uiEditorCommand ?? '', getRichTextCommandValue(control)
        )
      }

      if (control instanceof HTMLSelectElement) control.addEventListener('change', execute)
      else control.addEventListener('click', execute)
    }

    root.addEventListener('keydown', event => {
      if (!(event.target instanceof HTMLElement) ||
        !event.target.closest(richTextEditorContentSelector)) return

      const command = getLumenRichTextShortcut(event)

      if (!command) return

      event.preventDefault()

      executeRichTextCommand(root, command)
    })

    root.addEventListener('input', event => {
      if (!(event.target instanceof HTMLElement) ||
        !event.target.closest(richTextEditorContentSelector)) return

      syncRichTextCommandStates(root)

      dispatchRichTextChange(root)
    })

    root.addEventListener('keyup', () => {
      syncRichTextCommandStates(root)
    })

    root.addEventListener('mouseup', () => {
      syncRichTextCommandStates(root)
    })

    syncRichTextCommandStates(root)
  }
}

const themeBuilderExportButtonLabels: Record<ThemeBuilderExportFormat, string> = {
  css: 'Copy CSS',
  figma: 'Copy Figma JSON',
  tokens: 'Copy token JSON'
}

const coerceThemeBuilderExportFormat = (value?: string | null): ThemeBuilderExportFormat => {
  if (value === 'figma' || value === 'tokens') return value

  return 'css'
}

const coerceThemeBuilderMode = (value?: string | null): ThemeBuilderMode => (
  value === 'manual' ? 'manual' : 'generated'
)

const coerceThemeBuilderScheme = (value?: string | null): ThemeBuilderScheme => (
  value === 'dark' ? 'dark' : 'light'
)

const getDefaultThemeBuilderScheme = (): ThemeBuilderScheme => (
  document.documentElement.dataset.theme?.includes('dark') ? 'dark' : 'light'
)

const normalizeThemeBuilderHue = (
  value: number | string | null | undefined,
  fallback = 0
): number => {
  const parsed = Number(value)

  if (!Number.isFinite(parsed)) return fallback

  return ((Math.round(parsed) % 360) + 360) % 360
}

const normalizeThemeBuilderHex = (value: string): string | null => {
  const hex = value.trim().replace(/^#/, '')

  if (/^[\da-f]{3}$/i.test(hex)) {
    return `#${[...hex].map(character => `${character}${character}`).join('').toLowerCase()}`
  }

  return /^[\da-f]{6}$/i.test(hex) ? `#${hex.toLowerCase()}` : null
}

const hexToThemeBuilderHsl = (value: string): { hue: number, value: string } | null => {
  const normalized = normalizeThemeBuilderHex(value)

  if (!normalized) return null

  const red = Number.parseInt(normalized.slice(1, 3), 16) / 255
  const green = Number.parseInt(normalized.slice(3, 5), 16) / 255
  const blue = Number.parseInt(normalized.slice(5, 7), 16) / 255
  const max = Math.max(red, green, blue)
  const min = Math.min(red, green, blue)
  const lightness = (max + min) / 2
  const delta = max - min
  let hue = 0
  let saturation = 0

  if (delta !== 0) {
    saturation = delta / (1 - Math.abs(2 * lightness - 1))

    if (max === red) {
      hue = 60 * (((green - blue) / delta) % 6)
    } else if (max === green) {
      hue = 60 * ((blue - red) / delta + 2)
    } else {
      hue = 60 * ((red - green) / delta + 4)
    }
  }

  const normalizedHue = normalizeThemeBuilderHue(hue)

  return {
    hue: normalizedHue,
    value: `${normalizedHue} ${Math.round(saturation * 100)}% ${Math.round(lightness * 100)}%`
  }
}

const setThemeBuilderHexValidity = (input: HTMLInputElement, isValid: boolean): void => {
  if (isValid) {
    input.removeAttribute('aria-invalid')

    return
  }

  input.setAttribute('aria-invalid', 'true')
}

const getThemeBuilderTarget = (root: HTMLElement): HTMLElement | null => {
  const selector = root.dataset.uiThemeTarget

  if (!selector) return document.documentElement

  try {
    return document.querySelector<HTMLElement>(selector)
  } catch {
    return null
  }
}

const getThemeBuilderButtonValue = (
  root: HTMLElement,
  buttons: HTMLButtonElement[],
  attribute: string,
  fallback: string
): string => {
  const activeButton = buttons.find(button => button.getAttribute('aria-selected') === 'true' ||
    button.getAttribute('aria-pressed') === 'true')

  return activeButton?.getAttribute(attribute) ?? root.getAttribute(attribute) ?? fallback
}

const setThemeBuilderPressedState = (
  buttons: HTMLButtonElement[],
  attribute: string,
  value: string
): void => {
  for (const button of buttons) {
    const isPressed = button.getAttribute(attribute) === value

    if (button.hasAttribute('aria-pressed')) {
      button.setAttribute('aria-pressed', String(isPressed))
    }

    button.classList.toggle('ui-button--secondary', isPressed)

    button.classList.toggle('ui-button--outline', !isPressed)
  }
}

const bindSyncedThemeBuilderHueInputs = (
  range: HTMLInputElement | null,
  number: HTMLInputElement | null,
  onChange: () => void
): void => {
  const sync = (source: HTMLInputElement, target: HTMLInputElement | null): void => {
    source.value = String(normalizeThemeBuilderHue(source.value))

    if (target) {
      target.value = source.value
    }

    onChange()
  }

  range?.addEventListener('input', () => sync(range, number))

  number?.addEventListener('input', () => sync(number, range))
}

const bindThemeBuilderHexInputs = (
  color: HTMLInputElement | null,
  text: HTMLInputElement | null,
  onChange: () => void
): void => {
  color?.addEventListener('input', () => {
    if (!text) {
      onChange()

      return
    }

    text.value = color.value

    setThemeBuilderHexValidity(text, true)

    onChange()
  })

  text?.addEventListener('change', () => {
    const normalized = normalizeThemeBuilderHex(text.value)

    setThemeBuilderHexValidity(text, Boolean(normalized))

    if (normalized) {
      if (color) color.value = normalized

      text.value = normalized
    }

    onChange()
  })

  text?.addEventListener('input', () => {
    const normalized = normalizeThemeBuilderHex(text.value)

    setThemeBuilderHexValidity(text, Boolean(normalized))

    if (normalized) {
      if (color) color.value = normalized

      onChange()
    }
  })
}

const getComputedThemeBuilderTokens = (target: HTMLElement): LumenThemeTokens => {
  const styles = getComputedStyle(target)
  const tokens: LumenThemeTokens = {}

  for (const token of lumenTokenNames) {
    const value = styles.getPropertyValue(`--${token}`).trim()

    if (value) {
      tokens[token] = value
    }
  }

  return tokens
}

const applyThemeBuilderTokens = (
  target: HTMLElement,
  tokens: LumenThemeTokens,
  scheme: ThemeBuilderScheme
): void => {
  target.style.colorScheme = scheme

  for (const token of lumenTokenNames) {
    target.style.setProperty(`--${token}`, tokens[token] ?? '')
  }
}

const buildThemeBuilderCss = (
  tokens: LumenThemeTokens,
  scheme: ThemeBuilderScheme
): string => exportThemeCss(tokens).replace('{', `{\n  color-scheme: ${scheme};`)

const buildThemeBuilderExport = (
  tokens: LumenThemeTokens,
  scheme: ThemeBuilderScheme,
  format: ThemeBuilderExportFormat
): string => {
  if (format === 'figma') {
    return JSON.stringify(exportThemeFigmaVariables(tokens, {
      collectionName: 'Lumen',
      modeName: scheme === 'dark' ? 'Dark' : 'Light'
    }), null, 2)
  }

  if (format === 'tokens') {
    return JSON.stringify(exportThemeDesignTokens(tokens), null, 2)
  }

  return buildThemeBuilderCss(tokens, scheme)
}

const initThemeBuilders = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-theme-builder]')) {
    if (root.dataset.uiThemeBuilderBound === 'true') continue

    root.dataset.uiThemeBuilderBound = 'true'

    root.dataset.uiBound = 'true'

    const exportButton = root.querySelector<HTMLElement>('[data-ui-theme-export]')
    const output = root.querySelector<HTMLTextAreaElement | HTMLOutputElement>('[data-ui-theme-output]')
    const brandHue = root.querySelector<HTMLInputElement>('[data-ui-theme-brand-hue], [data-ui-theme-hue]')
    const brandHueNumber = root.querySelector<HTMLInputElement>('[data-ui-theme-brand-hue-number]')
    const accentHue = root.querySelector<HTMLInputElement>('[data-ui-theme-accent-hue]')
    const accentHueNumber = root.querySelector<HTMLInputElement>('[data-ui-theme-accent-hue-number]')
    const primaryColor = root.querySelector<HTMLInputElement>('[data-ui-theme-primary-color]')
    const primaryHex = root.querySelector<HTMLInputElement>('[data-ui-theme-primary-hex]')
    const secondaryColor = root.querySelector<HTMLInputElement>('[data-ui-theme-secondary-color]')
    const secondaryHex = root.querySelector<HTMLInputElement>('[data-ui-theme-secondary-hex]')
    const exportFormatButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-ui-theme-export-format]')]
    const modeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-ui-theme-mode]')]
    const schemeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-ui-theme-scheme]')]

    const hasTokenControls = Boolean(
      brandHue ||
      brandHueNumber ||
      accentHue ||
      accentHueNumber ||
      primaryColor ||
      primaryHex ||
      secondaryColor ||
      secondaryHex ||
      root.hasAttribute('data-ui-theme-brand-hue') ||
      root.hasAttribute('data-ui-theme-accent-hue') ||
      root.hasAttribute('data-ui-theme-hue')
    )

    let currentExportValue = ''

    let currentFormat = coerceThemeBuilderExportFormat(
      getThemeBuilderButtonValue(
        root, exportFormatButtons, 'data-ui-theme-export-format', 'css'
      )
    )

    let currentScheme = coerceThemeBuilderScheme(
      getThemeBuilderButtonValue(
        root, schemeButtons, 'data-ui-theme-scheme', getDefaultThemeBuilderScheme()
      )
    )

    let currentTokens: LumenThemeTokens | null = null

    const updateExportButtonLabel = (): void => {
      if (!exportButton || exportFormatButtons.length === 0) return

      exportButton.replaceChildren(themeBuilderExportButtonLabels[currentFormat])
    }

    const writeExport = (tokens: LumenThemeTokens, scheme: ThemeBuilderScheme): void => {
      currentExportValue = buildThemeBuilderExport(tokens, scheme, currentFormat)

      if (output) {
        output.value = currentExportValue
      }

      updateExportButtonLabel()
    }

    const writeComputedExport = (): void => {
      const target = getThemeBuilderTarget(root) ?? document.documentElement

      currentTokens = getComputedThemeBuilderTokens(target)

      writeExport(currentTokens, currentScheme)
    }

    const update = (
      options: { apply?: boolean, dispatch?: boolean } = {}
    ): void => {
      const hue = normalizeThemeBuilderHue(
        brandHue?.value ??
        brandHueNumber?.value ??
        root.getAttribute('data-ui-theme-brand-hue') ??
        root.getAttribute('data-ui-theme-hue')
      )

      const nextAccentHue = normalizeThemeBuilderHue(
        accentHue?.value ??
        accentHueNumber?.value ??
        root.getAttribute('data-ui-theme-accent-hue'), normalizeThemeBuilderHue(hue + 150)
      )

      const mode = coerceThemeBuilderMode(
        getThemeBuilderButtonValue(
          root, modeButtons, 'data-ui-theme-mode', 'generated'
        )
      )

      const primaryValue = primaryHex?.value ?? primaryColor?.value
      const secondaryValue = secondaryHex?.value ?? secondaryColor?.value
      const primary = primaryValue ? hexToThemeBuilderHsl(primaryValue) : null
      const secondary = secondaryValue ? hexToThemeBuilderHsl(secondaryValue) : null
      const baseHue = mode === 'manual' ? primary?.hue ?? hue : hue
      const baseAccentHue = mode === 'manual' ? secondary?.hue ?? nextAccentHue : nextAccentHue

      const tokens = createThemeFromHue(baseHue, {
        accentHue: baseAccentHue,
        scheme: currentScheme
      })

      if (mode === 'manual') {
        if (primary) {
          tokens.brand = primary.value

          tokens['brand-solid'] = primary.value
        }

        if (secondary) {
          tokens.accent = secondary.value
        }
      }

      currentTokens = tokens

      const target = getThemeBuilderTarget(root)

      if (options.apply !== false && target) {
        applyThemeBuilderTokens(target, tokens, currentScheme)
      }

      writeExport(tokens, currentScheme)

      if (options.dispatch === false) return

      root.dispatchEvent(new CustomEvent('ui:theme-change', {
        bubbles: true,
        detail: {
          accentHue: baseAccentHue,
          hue: baseHue,
          mode,
          scheme: currentScheme,
          tokens
        }
      }))
    }

    bindSyncedThemeBuilderHueInputs(brandHue, brandHueNumber, update)

    bindSyncedThemeBuilderHueInputs(accentHue, accentHueNumber, update)

    bindThemeBuilderHexInputs(primaryColor, primaryHex, update)

    bindThemeBuilderHexInputs(secondaryColor, secondaryHex, update)

    for (const button of exportFormatButtons) {
      button.addEventListener('click', () => {
        currentFormat = coerceThemeBuilderExportFormat(button.getAttribute('data-ui-theme-export-format'))

        setThemeBuilderPressedState(exportFormatButtons, 'data-ui-theme-export-format', currentFormat)

        if (hasTokenControls) {
          update({ apply: false, dispatch: false })
        } else {
          writeComputedExport()
        }
      })
    }

    for (const button of modeButtons) {
      button.addEventListener('click', () => {
        const mode = coerceThemeBuilderMode(button.getAttribute('data-ui-theme-mode'))

        if (button.getAttribute('role') !== 'tab') {
          setThemeBuilderPressedState(modeButtons, 'data-ui-theme-mode', mode)
        }

        update()
      })

      button.addEventListener('keydown', event => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return

        queueMicrotask(update)
      })
    }

    for (const button of schemeButtons) {
      button.addEventListener('click', () => {
        currentScheme = coerceThemeBuilderScheme(button.getAttribute('data-ui-theme-scheme'))

        setThemeBuilderPressedState(schemeButtons, 'data-ui-theme-scheme', currentScheme)

        update()
      })
    }

    exportButton?.addEventListener('click', async () => {
      if (hasTokenControls && !currentTokens) {
        update({ apply: false, dispatch: false })
      } else if (!hasTokenControls) {
        writeComputedExport()
      }

      const value = output?.value || currentExportValue

      await navigator.clipboard?.writeText(value).catch(() => null)

      root.dispatchEvent(new CustomEvent('ui:theme-export', {
        bubbles: true,
        detail: {
          css: currentFormat === 'css' ? value : undefined,
          format: currentFormat,
          tokens: currentTokens,
          value
        }
      }))
    })

    if (hasTokenControls) {
      update({
        apply: Boolean(root.dataset.uiThemeTarget || root.hasAttribute('data-ui-theme-apply-on-init')),
        dispatch: false
      })
    } else if (output) {
      writeComputedExport()
    }
  }
}

const closeContextMenu = (menu: HTMLElement): void => {
  if (menu.dataset.state !== 'open') return

  menu.dataset.state = 'closed'

  menu.hidden = true
}

const openContextMenuAt = (menu: HTMLElement, x: number, y: number): void => {
  for (const other of document.querySelectorAll<HTMLElement>('[data-ui-context-menu][data-state="open"]')) {
    if (other !== menu) closeContextMenu(other)
  }

  menu.hidden = false

  menu.style.position = 'fixed'

  menu.style.zIndex = '60'

  menu.dataset.state = 'open'

  const rect = menu.getBoundingClientRect()
  const left = Math.max(8, Math.min(x, window.innerWidth - rect.width - 8))
  const top = Math.max(8, Math.min(y, window.innerHeight - rect.height - 8))

  menu.style.left = `${left}px`

  menu.style.top = `${top}px`

  getFocusable(menu)[0]?.focus()
}

/**
   * Context menus stay inert (statically visible) unless an element points at
   * them with data-ui-context-menu-trigger="<menu id>". With a trigger bound,
   * the menu hides until right-click / Shift+F10 opens it at the pointer.
   */
const initContextMenus = (scope: ParentNode): void => {
  for (const target of scope.querySelectorAll<HTMLElement>('[data-ui-context-menu-trigger]')) {
    if (target.dataset.uiBound === 'true') continue

    target.dataset.uiBound = 'true'

    const menuId = target.getAttribute('data-ui-context-menu-trigger')
    const menu = menuId ? document.getElementById(menuId) : null

    if (!menu) continue

    menu.hidden = true

    menu.dataset.state = 'closed'

    target.addEventListener('contextmenu', event => {
      event.preventDefault()

      openContextMenuAt(menu, event.clientX, event.clientY)
    })

    target.addEventListener('keydown', event => {
      if (event.key !== 'ContextMenu' && !(event.shiftKey && event.key === 'F10')) return

      event.preventDefault()

      const rect = target.getBoundingClientRect()

      openContextMenuAt(menu, rect.left + 16, rect.top + 16)
    })

    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        closeContextMenu(menu)

        target.focus()

        return
      }

      if (!['ArrowDown', 'ArrowUp', 'End', 'Home'].includes(event.key)) return

      const items = getFocusable(menu)

      if (items.length === 0) return

      event.preventDefault()

      const currentIndex = items.indexOf(document.activeElement as HTMLElement)

      items[getLoopedIndex(event.key, currentIndex, items.length, ['ArrowDown'])]?.focus()
    })

    menu.addEventListener('click', event => {
      if (event.target instanceof HTMLElement && event.target.closest('[role="menuitem"]')) {
        closeContextMenu(menu)
      }
    })
  }
}

/**
   * Date range pickers keep the two native date inputs consistent: the end
   * input cannot go before the start, and vice versa.
   */
const initDateRangePickers = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-date-range-picker]')) {
    if (root.dataset.uiBound === 'true') continue

    root.dataset.uiBound = 'true'

    const inputs = root.querySelectorAll<HTMLInputElement>('input[type="date"]')
    const start = inputs[0]
    const end = inputs[inputs.length - 1]

    if (!start || !end || start === end) continue

    const syncRange = (): void => {
      const datePickers = root.querySelectorAll<HTMLElement>('[data-ui-date-picker]')

      datePickers[0]?.setAttribute('data-range-part', 'start')

      datePickers[datePickers.length - 1]?.setAttribute('data-range-part', 'end')

      if (start.value) {
        end.min = start.value
      } else {
        end.removeAttribute('min')
      }

      if (end.value) {
        start.max = end.value
      } else {
        start.removeAttribute('max')
      }

      if (start.value && end.value && end.value < start.value) {
        end.value = start.value

        end.dispatchEvent(new Event('change', { bubbles: true }))
      }

      let rangeState = 'empty'

      if (start.value && end.value) {
        rangeState = 'complete'
      } else if (start.value) {
        rangeState = 'selecting-end'
      }

      root.dataset.rangeState = rangeState
    }

    start.addEventListener('change', syncRange)

    end.addEventListener('change', syncRange)

    syncRange()
  }
}

const getToastVariantClass = (variant: string | undefined): string => {
  if (variant === 'success') return 'ui-toast--success'

  if (variant === 'warning') return 'ui-toast--warning'

  if (variant === 'destructive') return 'ui-toast--destructive'

  return ''
}

type ToastPlacement =
  | 'bottom-center' |
  'bottom-left' |
  'bottom-right' |
  'top-center' |
  'top-left' |
  'top-right'

type ToastAction = {
  event?: string
  label?: string
  onClick?: (event: MouseEvent, toast: HTMLElement) => void
  value?: unknown
}

type ToastDetail = {
  action?: ToastAction
  description?: string
  duration?: number
  id?: string
  max?: number
  placement?: ToastPlacement
  title?: string
  variant?: string
}

type ToastApi = {
  create: (detail: ToastDetail) => string
  dismiss: (id?: string) => void
  update: (id: string, detail: ToastDetail) => void
}

const defaultToastDuration = 5000
const defaultToastMax = 5
const noop = (): void => undefined

const toastTimers = new WeakMap<HTMLElement, {
  cleanup: () => void
  duration: number
  remaining: number
  startedAt: number
  timer: number
}>()

const isToastPlacement = (placement: string | undefined): placement is ToastPlacement => placement === 'top-left' ||
  placement === 'top-center' ||
  placement === 'top-right' ||
  placement === 'bottom-left' ||
  placement === 'bottom-center' ||
  placement === 'bottom-right'

const getToastPlacement = (placement: string | undefined): ToastPlacement => (
  isToastPlacement(placement) ? placement : 'bottom-right'
)

const getToastViewport = (placement: string | undefined): HTMLElement => {
  const resolvedPlacement = getToastPlacement(placement)
  const shouldUseAnyViewport = placement === undefined

  const existing = document.querySelector<HTMLElement>(`[data-ui-sonner][data-placement="${resolvedPlacement}"]`) ??
    (shouldUseAnyViewport ? document.querySelector<HTMLElement>('[data-ui-sonner]') : null)

  if (existing) {
    existing.dataset.placement = existing.dataset.placement ?? resolvedPlacement

    existing.setAttribute('aria-live', existing.getAttribute('aria-live') ?? 'polite')

    existing.setAttribute('aria-atomic', existing.getAttribute('aria-atomic') ?? 'false')

    return existing
  }

  const viewport = document.createElement('div')

  viewport.className = 'ui-sonner'

  viewport.dataset.uiSonner = ''

  viewport.dataset.placement = resolvedPlacement

  viewport.setAttribute('aria-live', 'polite')

  viewport.setAttribute('aria-atomic', 'false')

  viewport.setAttribute('aria-label', 'Notifications')

  document.body.append(viewport)

  return viewport
}

const clearToastTimer = (toast: HTMLElement): void => {
  const timer = toastTimers.get(toast)

  if (!timer) return

  window.clearTimeout(timer.timer)

  timer.cleanup()

  toastTimers.delete(toast)
}

const dismissToast = (toast: HTMLElement): void => {
  clearToastTimer(toast)

  toast.dataset.state = 'closed'

  window.setTimeout(() => toast.remove(), 240)
}

const scheduleToastDismiss = (toast: HTMLElement, duration: number): void => {
  clearToastTimer(toast)

  if (!Number.isFinite(duration) || duration <= 0) return

  const timerState = {
    cleanup: noop,
    duration,
    remaining: duration,
    startedAt: Date.now(),
    timer: 0
  }

  const start = (): void => {
    timerState.startedAt = Date.now()

    timerState.timer = window.setTimeout(() => dismissToast(toast), timerState.remaining)
  }

  const pause = (): void => {
    window.clearTimeout(timerState.timer)

    timerState.remaining = Math.max(0, timerState.remaining - (Date.now() - timerState.startedAt))
  }

  const resume = (): void => {
    if (timerState.remaining > 0) start()
  }

  timerState.cleanup = () => {
    toast.removeEventListener('mouseenter', pause)

    toast.removeEventListener('mouseleave', resume)

    toast.removeEventListener('focusin', pause)

    toast.removeEventListener('focusout', resume)
  }

  toast.addEventListener('mouseenter', pause)

  toast.addEventListener('mouseleave', resume)

  toast.addEventListener('focusin', pause)

  toast.addEventListener('focusout', resume)

  toastTimers.set(toast, timerState)

  start()
}

const setToastContent = (toast: HTMLElement, detail: ToastDetail): void => {
  const title = detail.title ?? toast.dataset.title ?? 'Notification'
  const description = detail.description ?? toast.dataset.description ?? ''
  const variant = detail.variant ?? toast.dataset.variant ?? 'default'
  const variantClass = getToastVariantClass(variant)

  toast.className = variantClass ? `ui-toast ${variantClass}` : 'ui-toast'

  toast.dataset.variant = variant

  toast.dataset.title = title

  toast.dataset.description = description

  toast.setAttribute('role', variant === 'destructive' ? 'alert' : 'status')

  toast.setAttribute('aria-live', variant === 'destructive' ? 'assertive' : 'polite')

  toast.replaceChildren()

  const body = document.createElement('div')
  const heading = document.createElement('strong')

  body.className = 'ui-toast__body'

  heading.textContent = title

  body.append(heading)

  if (description) {
    const text = document.createElement('p')

    text.textContent = description

    body.append(text)
  }

  toast.append(body)

  if (detail.action?.label) {
    const action = document.createElement('button')

    action.className = 'ui-button ui-button--secondary ui-button--sm ui-toast__action'

    action.type = 'button'

    action.textContent = detail.action.label

    action.addEventListener('click', event => {
      detail.action?.onClick?.(event, toast)

      toast.dispatchEvent(new CustomEvent(detail.action?.event ?? 'ui:toast-action', {
        bubbles: true,
        detail: { id: toast.id, value: detail.action?.value }
      }))

      dismissToast(toast)
    })

    toast.append(action)
  }

  const dismiss = document.createElement('button')

  dismiss.className = 'ui-toast__dismiss'

  dismiss.type = 'button'

  dismiss.setAttribute('aria-label', 'Dismiss notification')

  dismiss.textContent = 'Dismiss'

  dismiss.addEventListener('click', () => dismissToast(toast))

  toast.append(dismiss)
}

const initToasts = (): void => {
  if (document.documentElement.dataset.uiToastsBound === 'true') return

  document.documentElement.dataset.uiToastsBound = 'true'

  const createToast = (detail: ToastDetail): string => {
    const viewport = getToastViewport(detail.placement)
    const id = detail.id ?? `ui-toast-${crypto.randomUUID()}`
    const duration = detail.duration ?? defaultToastDuration
    const max = detail.max ?? Number(viewport.dataset.uiToastMax ?? defaultToastMax)
    const existingToast = document.getElementById(id)

    if (existingToast instanceof HTMLElement && existingToast.hasAttribute('data-ui-toast')) {
      existingToast.dataset.state = 'open'

      setToastContent(existingToast, detail)

      viewport.append(existingToast)

      scheduleToastDismiss(existingToast, duration)

      return id
    }

    const toast = document.createElement('aside')

    toast.id = id

    toast.dataset.uiToast = ''

    toast.dataset.state = 'open'

    toast.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return

      event.preventDefault()

      dismissToast(toast)
    })

    setToastContent(toast, detail)

    viewport.append(toast)

    scheduleToastDismiss(toast, duration)

    const toasts = [...viewport.querySelectorAll<HTMLElement>('[data-ui-toast]')]

    for (const staleToast of toasts.slice(0, Math.max(0, toasts.length - max))) {
      dismissToast(staleToast)
    }

    return id
  }

  const updateToast = (id: string, detail: ToastDetail): void => {
    const toast = document.getElementById(id)

    if (!(toast instanceof HTMLElement) || !toast.hasAttribute('data-ui-toast')) return

    setToastContent(toast, { ...detail, id })

    if (detail.duration !== undefined) {
      scheduleToastDismiss(toast, detail.duration)
    }
  }

  const dismissToastById = (id?: string): void => {
    const selector = id ? `#${CSS.escape(id)}` : '[data-ui-toast]'

    for (const toast of document.querySelectorAll<HTMLElement>(selector)) {
      if (toast.hasAttribute('data-ui-toast')) {
        dismissToast(toast)
      }
    }
  }

  const api: ToastApi = {
    create: createToast,
    dismiss: dismissToastById,
    update: updateToast
  }

    ;(window as Window & { LumenToast?: ToastApi }).LumenToast = api

  for (const viewport of document.querySelectorAll<HTMLElement>('[data-ui-sonner]')) {
    viewport.dataset.placement = getToastPlacement(viewport.dataset.placement)

    viewport.setAttribute('aria-live', viewport.getAttribute('aria-live') ?? 'polite')

    viewport.setAttribute('aria-atomic', viewport.getAttribute('aria-atomic') ?? 'false')
  }

  for (const toast of document.querySelectorAll<HTMLElement>('[data-ui-toast], .ui-toast')) {
    toast.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return

      event.preventDefault()

      dismissToast(toast)
    })
  }

  document.addEventListener('ui:toast', event => {
    createToast(event instanceof CustomEvent ? event.detail as ToastDetail : {})
  })

  document.addEventListener('ui:toast-update', event => {
    const detail = event instanceof CustomEvent ? event.detail as ToastDetail : {}

    if (detail.id) updateToast(detail.id, detail)
  })

  document.addEventListener('ui:toast-dismiss', event => {
    const detail = event instanceof CustomEvent ? event.detail as { id?: string } : {}

    dismissToastById(detail.id)
  })
}

const initFileUploads = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-file-upload]')) {
    if (root.dataset.uiBound === 'true') continue

    const input = root.querySelector<HTMLInputElement>('[data-ui-file-upload-input]')

    if (!input) continue

    root.dataset.uiBound = 'true'

    const files = root.querySelector<HTMLElement>('[data-ui-file-upload-files]')

    const renderFiles = (): void => {
      const selectedFiles = input.files ? [...input.files] : []

      root.dataset.state = selectedFiles.length > 0 ? 'selected' : 'idle'

      if (!files) return

      if (selectedFiles.length === 1) {
        files.textContent = selectedFiles[0]?.name ?? ''
      } else {
        files.textContent = selectedFiles.length > 1 ?
          `${selectedFiles.length} files selected` :
          ''
      }
    }

    input.addEventListener('change', renderFiles)

    root.addEventListener('dragover', event => {
      if (input.disabled) return

      event.preventDefault()

      root.dataset.state = 'drag-over'
    })

    root.addEventListener('dragleave', event => {
      if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return

      root.dataset.state = input.files?.length ? 'selected' : 'idle'
    })

    root.addEventListener('drop', event => {
      if (input.disabled) return

      event.preventDefault()

      if (event.dataTransfer) {
        input.files = event.dataTransfer.files

        input.dispatchEvent(new Event('change', { bubbles: true }))
      }
    })

    renderFiles()
  }
}

const initAnchors = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-anchor]')) {
    if (root.dataset.uiBound === 'true') continue

    root.dataset.uiBound = 'true'

    const links = [...root.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
    const targets: { link: HTMLAnchorElement, target: HTMLElement }[] = []

    for (const link of links) {
      const id = decodeURIComponent(link.getAttribute('href')?.slice(1) ?? '')
      const target = id ? document.getElementById(id) : null

      if (target) {
        targets.push({ link, target })
      }
    }

    if (!targets.length) continue

    const setActive = (active: HTMLAnchorElement): void => {
      for (const link of links) {
        const isActive = link === active

        link.dataset.active = String(isActive)

        if (isActive) {
          link.setAttribute('aria-current', 'location')
        } else {
          link.removeAttribute('aria-current')
        }
      }
    }

    const update = (): void => {
      const scrollingElement = document.scrollingElement ?? document.documentElement

      const atEnd = scrollingElement.scrollTop + scrollingElement.clientHeight >=
        scrollingElement.scrollHeight - 1

      const offset = Number(root.dataset.uiAnchorOffset) || 0
      let active = targets[0]?.link

      if (atEnd) {
        active = targets.at(-1)?.link
      } else {
        for (const item of targets) {
          if (item.target.getBoundingClientRect().top > offset) break

          active = item.link
        }
      }

      if (active) setActive(active)
    }

    let frame = 0

    const requestUpdate = (): void => {
      if (frame) return

      frame = requestAnimationFrame(() => {
        frame = 0

        update()
      })
    }

    for (const { link } of targets) {
      link.addEventListener('click', () => setActive(link))
    }

    window.addEventListener('resize', requestUpdate, { passive: true })

    window.addEventListener('scroll', requestUpdate, { passive: true })

    update()
  }
}

let scrollProgressFrame = 0

const updateScrollProgress = (): void => {
  scrollProgressFrame = 0

  const scrollingElement = document.scrollingElement ?? document.documentElement
  const maximum = scrollingElement.scrollHeight - scrollingElement.clientHeight

  const percentage = maximum > 0 ?
    Math.min(100, Math.max(0, (scrollingElement.scrollTop / maximum) * 100)) :
    0

  for (const root of document.querySelectorAll<HTMLElement>('[data-ui-scroll-progress]')) {
    const bar = root.querySelector<HTMLElement>('.ui-scroll-progress__bar')

    root.setAttribute('aria-valuenow', `${Math.round(percentage)}`)

    if (bar) bar.style.transform = `scaleX(${percentage / 100})`
  }
}

const requestScrollProgressUpdate = (): void => {
  if (scrollProgressFrame) return

  scrollProgressFrame = requestAnimationFrame(updateScrollProgress)
}

const initScrollProgress = (scope: ParentNode): void => {
  if (!scope.querySelector('[data-ui-scroll-progress]')) return

  requestScrollProgressUpdate()

  if (document.documentElement.dataset.uiScrollProgressBound === 'true') return

  document.documentElement.dataset.uiScrollProgressBound = 'true'

  window.addEventListener('resize', requestScrollProgressUpdate, { passive: true })

  window.addEventListener('scroll', requestScrollProgressUpdate, { passive: true })
}

const initTours = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-tour]')) {
    if (root.dataset.uiBound === 'true') continue

    const popover = root.querySelector<HTMLElement>('[data-ui-tour-popover]')
    const steps = [...root.querySelectorAll<HTMLElement>('[data-ui-tour-step]')]

    if (!popover || !steps.length) continue

    root.dataset.uiBound = 'true'

    let index = 0

    const positionStep = (): void => {
      const step = steps[index]

      if (!step) return

      for (const [stepIndex, node] of steps.entries()) {
        node.hidden = stepIndex !== index
      }

      const selector = step.dataset.target
      const target = selector ? document.querySelector<HTMLElement>(selector) : null

      if (target) {
        const rect = target.getBoundingClientRect()

        popover.style.top = `${rect.bottom + 8}px`

        popover.style.left = `${rect.left}px`
      }
    }

    const open = (): void => {
      root.hidden = false

      index = 0

      positionStep()
    }

    const close = (): void => {
      root.hidden = true
    }

    root.addEventListener('click', event => {
      const target = event.target

      if (!(target instanceof HTMLElement)) return

      if (target.closest('[data-ui-tour-next]')) {
        if (index < steps.length - 1) {
          index += 1

          positionStep()
        } else {
          close()
        }
      } else if (target.closest('[data-ui-tour-prev]')) {
        if (index > 0) {
          index -= 1

          positionStep()
        }
      } else if (target.closest('[data-ui-tour-close]') || target.hasAttribute('data-ui-tour-backdrop')) {
        close()
      }
    })

    const opener = root.id ? document.querySelector<HTMLElement>(`[data-ui-tour-open="#${root.id}"]`) : null

    if (opener) {
      opener.addEventListener('click', open)
    }

    const lumenTourWindow = window as Window & { LumenTours?: Record<string, () => void> }

    lumenTourWindow.LumenTours = lumenTourWindow.LumenTours ?? {}

    if (root.id) {
      lumenTourWindow.LumenTours[root.id] = open
    }
  }
}

const initTransfers = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-transfer]')) {
    if (root.dataset.uiBound === 'true') continue

    root.dataset.uiBound = 'true'

    const lists = new Map<string, HTMLElement>()

    for (const list of root.querySelectorAll<HTMLElement>('[data-ui-transfer-list]')) {
      if (list.dataset.side) {
        lists.set(list.dataset.side, list)
      }
    }

    const move = (fromSide: string, toSide: string): void => {
      const from = lists.get(fromSide)
      const to = lists.get(toSide)

      if (!from || !to) return

      const moved: string[] = []

      for (const checkbox of from.querySelectorAll<HTMLInputElement>('[data-ui-transfer-item]')) {
        if (!checkbox.checked) continue

        const item = checkbox.closest<HTMLElement>('.ui-transfer__item')

        if (item) {
          checkbox.checked = false

          to.append(item)

          moved.push(checkbox.value)
        }
      }

      if (moved.length) {
        root.dispatchEvent(new CustomEvent('ui:transfer-change', {
          bubbles: true,
          detail: { from: fromSide, to: toSide, values: moved }
        }))
      }
    }

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-ui-transfer-move]')) {
      button.addEventListener('click', () => {
        if (button.dataset.uiTransferMove === 'target') {
          move('source', 'target')
        } else if (button.dataset.uiTransferMove === 'source') {
          move('target', 'source')
        }
      })
    }
  }
}

const initMentions = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-mentions]')) {
    if (root.dataset.uiBound === 'true') continue

    const input = root.querySelector<HTMLTextAreaElement>('[data-ui-mentions-input]')
    const list = root.querySelector<HTMLElement>('[data-ui-mentions-list]')

    if (!input || !list) continue

    root.dataset.uiBound = 'true'

    const trigger = root.dataset.uiMentionsTrigger ?? '@'
    const escapedTrigger = trigger.replaceAll(/[.*+?^${}()|[\]\\]/g, '\\$&')
    const options = [...list.querySelectorAll<HTMLButtonElement>('[data-ui-mentions-option]')]
    let activeIndex = -1

    const setActive = (index: number): void => {
      const visibleOptions = options.filter(option => !option.hidden)

      activeIndex = visibleOptions.length && index >= 0 ?
        Math.min(index, visibleOptions.length - 1) :
        -1

      for (const option of options) {
        option.setAttribute('aria-selected', option === visibleOptions[activeIndex] ? 'true' : 'false')
      }

      const active = visibleOptions[activeIndex]

      if (active?.id) input.setAttribute('aria-activedescendant', active.id)
      else input.removeAttribute('aria-activedescendant')
    }

    const close = (): void => {
      list.hidden = true

      input.setAttribute('aria-expanded', 'false')

      setActive(-1)
    }

    const filter = (): void => {
      const caret = input.selectionStart ?? input.value.length
      const match = new RegExp(`${escapedTrigger}(\\w*)$`).exec(input.value.slice(0, caret))

      if (!match) {
        close()

        return
      }

      const query = (match[1] ?? '').toLowerCase()
      let visibleCount = 0

      for (const option of options) {
        const visible = (option.dataset.value ?? '').toLowerCase().startsWith(query)

        option.hidden = !visible

        if (visible) visibleCount += 1
      }

      list.hidden = visibleCount === 0

      input.setAttribute('aria-expanded', visibleCount > 0 ? 'true' : 'false')

      setActive(0)
    }

    const insert = (value: string): void => {
      const caret = input.selectionStart ?? input.value.length
      const before = input.value.slice(0, caret).replace(new RegExp(`${escapedTrigger}\\w*$`), `${trigger}${value} `)

      input.value = before + input.value.slice(caret)

      input.focus()

      input.setSelectionRange(before.length, before.length)

      close()

      input.dispatchEvent(new Event('input', { bubbles: true }))
    }

    input.addEventListener('input', filter)

    input.addEventListener('keydown', event => {
      const visibleOptions = options.filter(option => !option.hidden)

      if (event.key === 'Escape' && !list.hidden) {
        event.preventDefault()

        close()
      } else if (['ArrowDown', 'ArrowUp', 'End', 'Home'].includes(event.key) && visibleOptions.length) {
        event.preventDefault()

        const nextIndex = getLoopedIndex(
          event.key, activeIndex, visibleOptions.length, ['ArrowDown']
        )

        setActive(nextIndex)
      } else if (event.key === 'Enter' && activeIndex >= 0 && !list.hidden) {
        event.preventDefault()

        insert(visibleOptions[activeIndex]?.dataset.value ?? '')
      }
    })

    input.addEventListener('blur', () => window.setTimeout(close, 120))

    for (const option of options) {
      option.addEventListener('mousedown', event => {
        event.preventDefault()
      })

      option.addEventListener('click', () => {
        insert(option.dataset.value ?? '')
      })
    }
  }
}

const closeSpeedDial = (root: HTMLElement, restoreFocus = false): void => {
  const trigger = root.querySelector<HTMLButtonElement>('[data-ui-speed-dial-trigger]')

  root.dataset.state = 'closed'

  trigger?.setAttribute('aria-expanded', 'false')

  if (restoreFocus) trigger?.focus()
}

const speedDialNavigationKeys = ['ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'End', 'Home']

const initSpeedDials = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-speed-dial]')) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-ui-speed-dial-trigger]')
    const actions = root.querySelector<HTMLElement>('[data-ui-speed-dial-actions]')

    if (!trigger || !actions || root.dataset.uiBound === 'true') continue

    const items = [...actions.querySelectorAll<HTMLElement>('[role="menuitem"], button:not([disabled]), a[href]')]

    root.dataset.uiBound = 'true'

    root.dataset.state = root.dataset.state === 'open' ? 'open' : 'closed'

    trigger.setAttribute('aria-expanded', String(root.dataset.state === 'open'))

    const open = (focusPosition?: 'first' | 'last') => {
      root.dataset.state = 'open'

      trigger.setAttribute('aria-expanded', 'true')

      if (focusPosition === 'first') items[0]?.focus()

      if (focusPosition === 'last') items.at(-1)?.focus()
    }

    trigger.addEventListener('click', () => {
      if (root.dataset.state === 'open') {
        closeSpeedDial(root)
      } else {
        open()
      }
    })

    trigger.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeSpeedDial(root)

      if (['ArrowDown', 'ArrowRight'].includes(event.key)) {
        event.preventDefault()

        open('first')

        return
      }

      if (['ArrowLeft', 'ArrowUp'].includes(event.key)) {
        event.preventDefault()

        open('last')
      }
    })

    actions.addEventListener('click', event => {
      if ((event.target as HTMLElement).closest('[role="menuitem"], button, a')) {
        closeSpeedDial(root)
      }
    })

    actions.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        event.preventDefault()

        closeSpeedDial(root, true)

        return
      }

      if (!speedDialNavigationKeys.includes(event.key)) return

      const currentIndex = items.indexOf(document.activeElement as HTMLElement)

      const targetIndex = getLoopedIndex(
        event.key, currentIndex, items.length, ['ArrowDown', 'ArrowRight']
      )

      event.preventDefault()

      items[targetIndex]?.focus()
    })
  }
}

// cspell:disable-next-line
const initCascaders = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-cascader]')) {
    if (root.dataset.uiCascaderBound === 'true') continue

    root.dataset.uiCascaderBound = 'true'

    const valueLabel = root.querySelector<HTMLElement>('[data-ui-cascader-value]')
    const input = root.querySelector<HTMLInputElement>('[data-ui-cascader-input]')
    const trigger = root.querySelector<HTMLElement>('[data-ui-trigger]')
    const panel = trigger ? getPanel(trigger) : null
    const columns = [...root.querySelectorAll<HTMLElement>('.ui-cascader__column')]

    for (const option of root.querySelectorAll<HTMLButtonElement>('[data-ui-cascader-option]')) {
      option.addEventListener('click', () => {
        const column = option.closest<HTMLElement>('.ui-cascader__column')

        if (column) {
          const columnIndex = columns.indexOf(column)

          for (const descendant of columns.slice(columnIndex + 1)) {
            descendant.hidden = true

            for (const descendantOption of descendant.querySelectorAll<HTMLElement>('[data-ui-cascader-option]')) {
              descendantOption.dataset.active = 'false'

              descendantOption.setAttribute('aria-selected', 'false')
            }
          }

          for (const sibling of column.querySelectorAll<HTMLElement>('[data-ui-cascader-option]')) {
            sibling.dataset.active = 'false'

            sibling.setAttribute('aria-selected', 'false')
          }
        }

        option.dataset.active = 'true'

        option.setAttribute('aria-selected', 'true')

        const nextSelector = option.dataset.uiCascaderNext
        const next = nextSelector ? root.querySelector<HTMLElement>(nextSelector) : null

        if (next) {
          next.hidden = false

          return
        }

        const value = option.dataset.value ?? (option.textContent ?? '').trim()

        if (valueLabel) {
          valueLabel.textContent = option.dataset.label ?? (option.textContent ?? '').trim()
        }

        if (input) {
          input.value = value
        }

        if (trigger && panel) {
          setOpen(trigger, panel, false)
        }

        root.dispatchEvent(new CustomEvent('ui:cascader-change', { bubbles: true, detail: { value } }))
      })
    }

    panel?.addEventListener('keydown', event => {
      const target = event.target

      if (!(target instanceof HTMLElement)) return

      const option = target.closest<HTMLButtonElement>('[data-ui-cascader-option]')
      const column = option?.closest<HTMLElement>('.ui-cascader__column')

      if (!option || !column) return

      const columnIndex = columns.indexOf(column)
      const options = [...column.querySelectorAll<HTMLButtonElement>('[data-ui-cascader-option]')]

      if (event.key === 'ArrowDown' || event.key === 'ArrowUp' || event.key === 'Home' || event.key === 'End') {
        event.preventDefault()

        const currentIndex = options.indexOf(option)
        const nextIndex = getLoopedIndex(event.key, currentIndex, options.length, ['ArrowDown'])

        options[nextIndex]?.focus()

        return
      }

      if (event.key === 'ArrowRight') {
        const nextSelector = option.dataset.uiCascaderNext
        const next = nextSelector ? root.querySelector<HTMLElement>(nextSelector) : null

        if (!next) return

        event.preventDefault()

        option.click()

        next.querySelector<HTMLElement>('[data-ui-cascader-option]')?.focus()

        return
      }

      if (event.key !== 'ArrowLeft' || columnIndex <= 0) return

      event.preventDefault()

      const previousColumn = columns.findLast((candidate, index) => index < columnIndex && !candidate.hidden)

      for (const descendant of columns.slice(columnIndex)) {
        descendant.hidden = true
      }

      previousColumn?.querySelector<HTMLElement>('[data-ui-cascader-option][data-active="true"]')?.focus()
    })
  }
}

const initTreeSelects = (scope: ParentNode): void => {
  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-tree-select]')) {
    if (root.dataset.uiTreeSelectBound === 'true') continue

    root.dataset.uiTreeSelectBound = 'true'

    const valueLabel = root.querySelector<HTMLElement>('[data-ui-tree-select-value]')
    const input = root.querySelector<HTMLInputElement>('[data-ui-tree-select-input]')
    const trigger = root.querySelector<HTMLElement>('[data-ui-trigger]')
    const panel = root.querySelector<HTMLElement>('[data-ui-panel]')

    for (const item of root.querySelectorAll<HTMLElement>('[data-ui-panel] [data-value]')) {
      item.addEventListener('click', () => {
        const value = item.dataset.value ?? ''

        if (valueLabel) {
          valueLabel.textContent = (item.textContent ?? '').trim()
        }

        if (input) {
          input.value = value
        }

        if (trigger && panel) {
          setOpen(trigger, panel, false)
        }

        root.dispatchEvent(new CustomEvent('ui:tree-select-change', { bubbles: true, detail: { value } }))
      })
    }
  }
}

const initOptionalControllers = (scope: ParentNode): void => {
  if (!scope.querySelector(
    '[data-ui-back-to-top], [data-ui-scroll-reveal], [data-ui-reveal-group], [data-ui-animated-number]'
  )) return

  import('./controllers/motion.js')
    .then(({ initMotionControllers }) => initMotionControllers(scope))
    .catch(error => {
      window.setTimeout(() => {
        throw error
      })
    })
}

const initUiPrimitives = (scope: ParentNode = document): void => {
  initDialogs(scope)

  initFields(scope)

  initPhoneInputs(scope)

  initForms(scope)

  initPasswordFields(scope)

  initListBoxes(scope)

  initDisclosures(scope)

  initTabs(scope)

  initRovingGroups(scope)

  initToggles(scope)

  initThemeToggles(scope)

  initLanguageToggles(scope)

  initCommand(scope)

  initComboboxes(scope)

  initSelects(scope)

  initResizableGroups(scope)

  initInputOtpFields(scope)

  initDataTables(scope)

  initCalendars(scope)

  initDatePickers(scope)

  initCodeCopy(scope)

  initCopyButtons(scope)

  initProgress(scope)

  initCarousel(scope)

  initSchedules(scope)

  initKanbanBoards(scope)

  initTreeCollections(scope)

  initVirtualLists(scope)

  initTagGroups(scope)

  initRichTextEditors(scope)

  initThemeBuilders(scope)

  initTooltips(scope)

  initContextMenus(scope)

  initDateRangePickers(scope)

  initGlassTracking(scope)

  initFileUploads(scope)

  initAnchors(scope)

  initScrollProgress(scope)

  initTours(scope)

  initTransfers(scope)

  initMentions(scope)

  initSpeedDials(scope)

  // cspell:disable-next-line
  initCascaders(scope)

  initTreeSelects(scope)

  initOptionalControllers(scope)

  initToasts()
}

const lumenWindow = window as Window & { LumenInitUiPrimitives?: (scope?: ParentNode) => void }

lumenWindow.LumenInitUiPrimitives = initUiPrimitives

if (document.documentElement.dataset.uiPrimitivesGlobalBound !== 'true') {
  document.documentElement.dataset.uiPrimitivesGlobalBound = 'true'

  document.addEventListener('click', event => {
    const target = event.target

    if (!(target instanceof Node)) return

    for (const root of document.querySelectorAll<HTMLElement>(disclosureSelector)) {
      if (!root.contains(target)) {
        closeDisclosure(root)
      }
    }

    for (const root of document.querySelectorAll<HTMLElement>('[data-ui-combobox]')) {
      if (!root.contains(target)) {
        closeCombobox(root)
      }
    }

    for (const root of document.querySelectorAll<HTMLElement>('[data-ui-select]')) {
      if (!root.contains(target)) {
        closeSelect(root)
      }
    }

    for (const root of document.querySelectorAll<HTMLElement>('[data-ui-date-picker]')) {
      if (!root.contains(target)) {
        closeDatePicker(root)
      }
    }

    for (const menu of document.querySelectorAll<HTMLElement>('[data-ui-context-menu][data-state="open"]')) {
      if (!menu.contains(target)) {
        closeContextMenu(menu)
      }
    }

    for (const root of document.querySelectorAll<HTMLElement>('[data-ui-speed-dial][data-state="open"]')) {
      if (!root.contains(target)) {
        closeSpeedDial(root)
      }
    }
  })

  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return

    for (const root of document.querySelectorAll<HTMLElement>(disclosureSelector)) {
      closeDisclosure(root)
    }

    for (const root of document.querySelectorAll<HTMLElement>('[data-ui-combobox]')) {
      closeCombobox(root)
    }

    for (const root of document.querySelectorAll<HTMLElement>('[data-ui-select]')) {
      closeSelect(root)
    }

    for (const root of document.querySelectorAll<HTMLElement>('[data-ui-date-picker]')) {
      closeDatePicker(root, root.contains(document.activeElement))
    }

    for (const menu of document.querySelectorAll<HTMLElement>('[data-ui-context-menu][data-state="open"]')) {
      closeContextMenu(menu)
    }

    for (const root of document.querySelectorAll<HTMLElement>('[data-ui-speed-dial][data-state="open"]')) {
      closeSpeedDial(root, root.contains(document.activeElement))
    }
  })

  document.addEventListener('astro:page-load', () => lumenWindow.LumenInitUiPrimitives?.())

  document.addEventListener('astro:after-swap', () => lumenWindow.LumenInitUiPrimitives?.())
}

initUiPrimitives()
</script>

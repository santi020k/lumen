        if (!items.length || !typeahead) return

        const currentIndex = currentItem ? items.indexOf(currentItem) : items.indexOf(getSelectedSelectItem(root) ?? items[0])
        const orderedItems = [...items.slice(Math.max(0, currentIndex + 1)), ...items.slice(0, Math.max(0, currentIndex + 1))]
        const nextItem = orderedItems.find(item => item.textContent?.trim().toLowerCase().startsWith(typeahead))


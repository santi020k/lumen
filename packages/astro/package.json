{
  "name": "@santi020k/lumen-astro",
  "version": "5.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Astro components and progressive-enhancement runtime for Lumen UI.",
  "type": "module",
  "sideEffects": [
    "./styles/lumen.css",
    "./styles/critical.css",
    "./styles/scroll-cue.css",
    "./styles.css",
    "./styles/tailwind.css",
    "./styles/layers.css",
    "./styles/**/*.css"
  ],
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./forms": {
      "types": "./forms.ts",
      "import": "./forms.ts"
    },
    "./components/*": "./components/*.astro",
    "./runtime": "./runtime/UIPrimitives.astro",
    "./layers.css": "./styles/layers.css",
    "./styles.css": "./styles/lumen.css",
    "./styles/critical.css": "./styles/critical.css",
    "./package.json": "./package.json",
    "./tailwind.css": "./styles/tailwind.css",
    "./styles/foundation.css": "./styles/foundation.css",
    "./styles/themes/studio.css": "./styles/themes/studio.css",
    "./styles/themes/paper.css": "./styles/themes/paper.css",
    "./styles/themes/field.css": "./styles/themes/field.css",
    "./styles/themes/santi020k.css": "./styles/themes/santi020k.css",
    "./styles/effects/glass.css": "./styles/effects/glass.css",
    "./styles/components/*.css": "./styles/components/*.css"
  },
  "files": [
    "components",
    "internal",
    "runtime",
    "styles",
    "index.ts",
    "forms.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "astro sync && tsc -p tsconfig.json --noEmit",
    "dev": "astro sync --watch",
    "typecheck": "astro sync && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project astro",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project astro --coverage",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "clean": "rm -rf .astro coverage"
  },
  "dependencies": {
    "@santi020k/lumen-core": "workspace:^",
    "uqr": "catalog:"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "catalog:",
    "astro": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "astro": ">=5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/santi020k/lumen.git",
    "directory": "packages/astro"
  },
  "homepage": "https://lumen.santi020k.com/docs/frameworks/astro",
  "bugs": {
    "url": "https://github.com/santi020k/lumen/issues"
  },
  "keywords": [
    "astro",
    "astro-component",
    "astro-components",
    "accessible-ui",
    "component-library",
    "design-system",
    "lumen",
    "ui"
  ],
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "license": "MIT"
}

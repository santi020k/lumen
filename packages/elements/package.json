{
  "name": "@santi020k/lumen-elements",
  "version": "0.4.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Web Components for Lumen UI.",
  "type": "module",
  "sideEffects": [
    "./layers.css",
    "./styles.css",
    "./dist/define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./styles.css": "./styles.css",
    "./layers.css": "./layers.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "layers.css",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/minify-build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project elements",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project elements --coverage",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@santi020k/lumen": "workspace:^",
    "@santi020k/lumen-core": "workspace:^"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "axe-core": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/santi020k/lumen.git",
    "directory": "packages/elements"
  },
  "homepage": "https://lumen.santi020k.com",
  "bugs": {
    "url": "https://github.com/santi020k/lumen/issues"
  },
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "license": "MIT"
}

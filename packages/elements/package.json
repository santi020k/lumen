{
  "name": "@santi020k/lumen-elements",
  "version": "5.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Web Components for Lumen UI.",
  "type": "module",
  "sideEffects": [
    "./layers.css",
    "./styles.css",
    "./styles/critical.css",
    "./dist/define.js",
    "./tailwind.css",
    "./styles/**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./components/badge": {
      "types": "./dist/components/badge.d.ts",
      "import": "./dist/components/badge.js"
    },
    "./components/button": {
      "types": "./dist/entries/button.d.ts",
      "import": "./dist/entries/button.js"
    },
    "./components/card": {
      "types": "./dist/components/card.d.ts",
      "import": "./dist/components/card.js"
    },
    "./components/combobox": {
      "types": "./dist/components/combobox.d.ts",
      "import": "./dist/components/combobox.js"
    },
    "./components/image-comparison": {
      "types": "./dist/components/image-comparison.d.ts",
      "import": "./dist/components/image-comparison.js"
    },
    "./components/foundations": {
      "types": "./dist/components/foundations.d.ts",
      "import": "./dist/components/foundations.js"
    },
    "./styles.css": "./styles.css",
    "./styles/critical.css": "./styles/critical.css",
    "./layers.css": "./layers.css",
    "./package.json": "./package.json",
    "./components/dashboard": {
      "types": "./dist/components/dashboard.d.ts",
      "import": "./dist/components/dashboard.js"
    },
    "./components/virtual-list": {
      "types": "./dist/components/virtual-list.d.ts",
      "import": "./dist/components/virtual-list.js"
    },
    "./components/device-frame": {
      "types": "./dist/components/device-frame.d.ts",
      "import": "./dist/components/device-frame.js"
    },
    "./components/world-map": {
      "types": "./dist/components/world-map.d.ts",
      "import": "./dist/components/world-map.js"
    },
    "./components/media-viewport": {
      "types": "./dist/components/media-viewport.d.ts",
      "import": "./dist/components/media-viewport.js"
    },
    "./components/media-selection": {
      "types": "./dist/components/media-selection.d.ts",
      "import": "./dist/components/media-selection.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./styles/foundation.css": "./styles/foundation.css",
    "./styles/themes/studio.css": "./styles/themes/studio.css",
    "./styles/themes/santi020k.css": "./styles/themes/santi020k.css",
    "./styles/effects/glass.css": "./styles/effects/glass.css",
    "./styles/components/*.css": "./styles/components/*.css",
    "./components/dialog": {
      "types": "./dist/entries/dialog.d.ts",
      "import": "./dist/entries/dialog.js"
    },
    "./components/anchor": {
      "types": "./dist/entries/anchor.d.ts",
      "import": "./dist/entries/anchor.js"
    },
    "./components/scroll-progress": {
      "types": "./dist/entries/scroll-progress.d.ts",
      "import": "./dist/entries/scroll-progress.js"
    },
    "./components/search-field": {
      "types": "./dist/entries/search-field.d.ts",
      "import": "./dist/entries/search-field.js"
    },
    "./components/collapsible": {
      "types": "./dist/entries/collapsible.d.ts",
      "import": "./dist/entries/collapsible.js"
    },
    "./components/empty": {
      "types": "./dist/entries/empty.d.ts",
      "import": "./dist/entries/empty.js"
    },
    "./components/kbd": {
      "types": "./dist/entries/kbd.d.ts",
      "import": "./dist/entries/kbd.js"
    },
    "./components/link": {
      "types": "./dist/entries/link.d.ts",
      "import": "./dist/entries/link.js"
    },
    "./components/skip-link": {
      "types": "./dist/entries/skip-link.d.ts",
      "import": "./dist/entries/skip-link.js"
    },
    "./components/label": {
      "types": "./dist/entries/label.d.ts",
      "import": "./dist/entries/label.js"
    },
    "./components/timeline": {
      "types": "./dist/components/timeline.d.ts",
      "import": "./dist/components/timeline.js"
    }
  },
  "files": [
    "dist",
    "layers.css",
    "styles.css",
    "styles",
    "README.md",
    "LICENSE",
    "tailwind.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/minify-build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project elements",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project elements --coverage",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "measure:registration": "pnpm run build && node scripts/measure-registration.mjs",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@santi020k/lumen-core": "workspace:^"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/santi020k/lumen.git",
    "directory": "packages/elements"
  },
  "homepage": "https://lumen.santi020k.com/docs/frameworks/elements",
  "bugs": {
    "url": "https://github.com/santi020k/lumen/issues"
  },
  "keywords": [
    "accessible-ui",
    "component-library",
    "custom-elements",
    "design-system",
    "lumen",
    "ui",
    "web-components"
  ],
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "license": "MIT"
}

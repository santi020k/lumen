{
  "name": "@santi020k/lumen-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @santi020k/lumen-docs dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:turbo": "turbo run test",
    "lint": "pnpm run lint:repo && turbo run lint",
    "lint:repo": "eslint . --cache --no-warn-ignored --max-warnings=0",
    "lint:fix": "pnpm run lint:repo:fix && turbo run lint:fix",
    "lint:repo:fix": "eslint . --cache --fix --no-warn-ignored --max-warnings=0",
    "lint:commits": "commitlint --from=origin/main --to=HEAD",
    "lint:spell": "cspell \"**\" --gitignore --cache --show-suggestions --show-context",
    "lint:knip": "knip",
    "check:publish-dry-run": "node scripts/check-publish-dry-run.mjs",
    "check:security": "pnpm audit --prod --audit-level moderate",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "measure:imports": "node scripts/measure-import-performance.mjs",
    "measure:react-icons": "node scripts/measure-react-icon-performance.mjs",
    "check:figma-tokens": "node scripts/check-figma-theme-tokens.mjs",
    "generate:platform-tokens": "node scripts/generate-platform-tokens.mjs",
    "check:platform-tokens": "node scripts/generate-platform-tokens.mjs --check",
    "check:framework-contracts": "node scripts/check-framework-contracts.mjs",
    "check:native-contracts": "node scripts/check-native-contracts.mjs",
    "check:mcp-snapshot": "pnpm --filter @santi020k/lumen-mcp run check:snapshot",
    "check:mcp-package": "pnpm --filter @santi020k/lumen-mcp run smoke:package",
    "check:consumer-packages": "node scripts/smoke-consumer-packages.mjs",
    "check:exposure-launch": "node apps/docs/scripts/check-exposure-launch.mjs",
    "check:mcp-evaluation": "pnpm --filter @santi020k/lumen-mcp run eval",
    "sync:registry": "node scripts/sync-registry.mjs",
    "check:registry": "node scripts/sync-registry.mjs --check && node scripts/validate-registry.mjs && pnpm run check:figma-tokens",
    "validate": "pnpm run check:platform-tokens && pnpm run build && pnpm run check:bundle-size && pnpm run check:framework-contracts && pnpm run check:native-contracts && pnpm run check:mcp-snapshot && pnpm run check:mcp-evaluation && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run lint:spell && pnpm run lint:knip && pnpm run check:registry && pnpm run check:security && pnpm run check:publish-dry-run && pnpm run check:consumer-packages && pnpm run check:mcp-package",
    "ok": "pnpm install --frozen-lockfile && pnpm run validate",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && pnpm --filter @santi020k/lumen-mcp run generate",
    "release": "pnpm run validate && changeset publish",
    "publish-packages": "pnpm run build && changeset publish",
    "docs:dev": "pnpm --filter @santi020k/lumen-docs dev",
    "docs:build": "turbo run build --filter=@santi020k/lumen-docs",
    "docs:preview": "pnpm --filter @santi020k/lumen-docs preview",
    "playground:android:build": "./packages/compose/gradlew -p apps/playground-android assembleDebug",
    "playground:apple:build": "swift build --package-path apps/playground-apple",
    "playground:react-native": "pnpm --filter @santi020k/lumen-playground-react-native dev",
    "playground:react-native:web": "pnpm --filter @santi020k/lumen-playground-react-native web",
    "docs:pages:dev": "pnpm run docs:build && pnpm exec wrangler pages dev apps/docs/dist",
    "docs:deploy": "pnpm run docs:build && pnpm exec wrangler pages deploy apps/docs/dist --project-name=lumen --branch=main",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run typecheck && pnpm run test && pnpm run lint",
    "commit": "commitprompt",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:interactions": "playwright test -c playwright.interactions.config.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@playwright/test": "catalog:",
    "@santi020k/commitprompt": "catalog:",
    "@santi020k/eslint-config-astro": "catalog:",
    "@santi020k/eslint-config-basic": "catalog:",
    "@santi020k/eslint-config-extensions": "catalog:",
    "@santi020k/eslint-config-expo": "catalog:",
    "@santi020k/eslint-config-formats": "catalog:",
    "@santi020k/eslint-config-libraries": "catalog:",
    "@santi020k/eslint-config-next": "catalog:",
    "@santi020k/eslint-config-react": "catalog:",
    "@santi020k/eslint-config-testing": "catalog:",
    "@santi020k/eslint-config-tools": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.32.1",
  "lint-staged": {
    "*": [
      "cspell --no-must-find-files"
    ],
    "*.{astro,js,mjs,ts,tsx,mts}": [
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ]
  }
}

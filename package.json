{
  "name": "@santi020k/lumen-root",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible UI primitives and shared design foundations for web and native applications.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @santi020k/lumen-docs dev",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "typecheck": "turbo run typecheck",
    "typecheck:affected": "turbo run typecheck --affected",
    "test": "vitest run",
    "test:affected": "turbo run test --affected",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:web-coverage": "vitest run --coverage --coverage.thresholds.statements=70 --coverage.thresholds.branches=60 --coverage.thresholds.functions=70 --coverage.thresholds.lines=74 --project core --project astro --project react --project elements",
    "test:turbo": "turbo run test",
    "lint": "pnpm run lint:repo && turbo run lint",
    "lint:affected": "turbo run lint --affected && node scripts/check-affected-files.mjs",
    "lint:repo": "eslint . --cache --no-warn-ignored --max-warnings=0 --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
    "lint:fix": "pnpm run lint:repo:fix && turbo run lint:fix",
    "lint:repo:fix": "eslint . --cache --fix --no-warn-ignored --max-warnings=0 --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
    "lint:commits": "commitlint --from=origin/main --to=HEAD",
    "lint:spell": "cspell \"**\" --gitignore --cache --show-suggestions --show-context",
    "lint:knip": "knip",
    "check:publish-dry-run": "node scripts/check-publish-dry-run.mjs",
    "test:published-package-family": "node --test scripts/check-published-package-family.test.mjs",
    "check:security": "node --test scripts/check-image-size-security.test.mjs && pnpm audit --prod --audit-level moderate",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:web-api-baseline": "node scripts/check-web-api-baseline.mjs",
    "test:web-api-baseline": "node --test scripts/check-web-api-baseline.test.mjs",
    "check:web-consumer-evidence": "node scripts/check-web-consumer-evidence.mjs",
    "check:web-consumer-evidence:complete": "node scripts/check-web-consumer-evidence.mjs --require-complete",
    "test:web-consumer-evidence": "node --test scripts/check-web-consumer-evidence.test.mjs",
    "measure:imports": "node scripts/measure-import-performance.mjs",
    "measure:elements-registration": "pnpm --filter @santi020k/lumen-elements run measure:registration",
    "measure:react-icons": "node scripts/measure-react-icon-performance.mjs",
    "measure:react-server": "node scripts/measure-react-server-boundary.mjs",
    "check:figma-tokens": "node scripts/check-figma-theme-tokens.mjs",
    "generate:platform-graphics": "node scripts/generate-platform-graphics.mjs",
    "check:platform-graphics": "node scripts/generate-platform-graphics.mjs --check",
    "generate:platform-icons": "node scripts/generate-platform-icons.mjs",
    "check:platform-icons": "node scripts/generate-platform-icons.mjs --check",
    "check:swift-assets": "node scripts/check-swift-assets.mjs",
    "test:platform-icons": "node --test scripts/core-svg-path.test.mjs",
    "generate:platform-tokens": "node scripts/generate-platform-tokens.mjs",
    "generate:critical-web-css": "node scripts/generate-critical-web-css.mjs",
    "check:critical-web-css": "node scripts/generate-critical-web-css.mjs --check && node --test scripts/generate-critical-web-css.test.mjs",
    "check:platform-tokens": "node scripts/generate-platform-tokens.mjs --check",
    "check:playground-store-readiness": "node scripts/check-playground-store-readiness.mjs",
    "check:playground-eas-version": "node scripts/check-playground-eas-version.mjs",
    "test:playground-eas-version": "node --test scripts/check-playground-eas-version.test.mjs",
    "sync:compose-version": "node scripts/sync-compose-version.mjs",
    "check:compose-version": "node scripts/sync-compose-version.mjs --check",
    "sync:swift-version": "node scripts/sync-swift-version.mjs",
    "check:swift-version": "node scripts/sync-swift-version.mjs --check",
    "test:swift-version": "node --test scripts/sync-swift-version.test.mjs",
    "sync:coordinated-v2-versions": "node scripts/sync-coordinated-v2-versions.mjs",
    "test:coordinated-v2-versions": "node --test scripts/sync-coordinated-v2-versions.test.mjs",
    "generate:release-manifest": "node scripts/generate-release-manifest.mjs",
    "check:release-manifest": "node scripts/generate-release-manifest.mjs --check",
    "check:react-native-peer-docs": "node scripts/check-react-native-peer-docs.mjs",
    "test:react-native-peer-docs": "node --test scripts/check-react-native-peer-docs.test.mjs",
    "check:lumen-2-contract": "node scripts/check-lumen-2-contract.mjs && pnpm run test:swift-source-compatibility",
    "test:lumen-2-contract": "node --test scripts/check-lumen-2-contract.test.mjs",
    "check:framework-contracts": "node scripts/check-framework-contracts.mjs && pnpm run check:critical-web-css && pnpm run check:web-consumer-evidence && pnpm run test:web-consumer-evidence",
    "check:native-contracts": "node scripts/check-native-contracts.mjs && pnpm run check:native-cli-registry",
    "sync:native-cli-registry": "node scripts/sync-native-cli-registry.mjs",
    "check:native-cli-registry": "node scripts/sync-native-cli-registry.mjs --check",
    "sync:native-captures": "pnpm --filter @santi020k/lumen-docs run sync:native-captures",
    "check:native-captures": "pnpm --filter @santi020k/lumen-docs run check:native-captures",
    "check:native-api-baseline": "node scripts/check-native-api-baseline.mjs",
    "check:compose-api-classification": "node scripts/check-compose-api-classification.mjs",
    "test:compose-api-classification": "node --test scripts/check-compose-api-classification.test.mjs",
    "check:wear-api-classification": "node scripts/check-wear-api-classification.mjs",
    "check:native-consumer-evidence": "node scripts/check-native-consumer-evidence.mjs",
    "check:native-consumer-readiness": "node scripts/check-native-consumer-evidence.mjs --require-complete",
    "test:native-consumer-evidence": "node --test scripts/check-native-consumer-evidence.test.mjs",
    "check:native-device-evidence": "node scripts/check-native-device-evidence.mjs",
    "check:native-device-readiness": "node scripts/check-native-device-evidence.mjs --require-complete",
    "test:native-device-evidence": "node --test scripts/check-native-device-evidence.test.mjs",
    "check:native-stability-soak": "node scripts/check-native-stability-soak.mjs",
    "test:native-stability-soak": "node --test scripts/check-native-stability-soak.test.mjs",
    "check:native-stability-readiness": "node scripts/check-native-stability-soak.mjs --require-complete",
    "check:native-stable-readiness": "node scripts/check-native-stable-readiness.mjs",
    "test:native-stable-readiness": "node --test scripts/check-native-stable-readiness.test.mjs",
    "test:approved-release-revision": "node --test scripts/check-approved-release-revision.test.mjs",
    "test:coordinated-release-revision": "node --test scripts/check-coordinated-release-revision.test.mjs",
    "check:graduated-release-revision": "node scripts/check-graduated-release-revision.mjs",
    "test:graduated-release-revision": "node --test scripts/check-graduated-release-revision.test.mjs",
    "test:maven-release-artifacts": "node --test scripts/check-maven-pom-metadata.test.mjs scripts/check-maven-release-artifacts.test.mjs",
    "check:npm-release-provenance": "node scripts/check-npm-release-provenance.mjs",
    "test:npm-release-provenance": "node --test scripts/check-npm-release-provenance.test.mjs",
    "test:v2-release-workflows": "node --test scripts/check-v2-release-workflows.test.mjs",
    "test:platform-identifiers": "node --test scripts/platform-identifiers.test.mjs",
    "generate:swift-api-baseline": "node scripts/check-swift-api-baseline.mjs --update && node scripts/check-swift-api-baseline.mjs --module LumenWidgetUI --update",
    "check:swift-api-baseline": "node scripts/check-swift-api-baseline.mjs && node scripts/check-swift-api-baseline.mjs --module LumenWidgetUI",
    "check:swift-source-compatibility": "node scripts/check-swift-source-compatibility.mjs",
    "test:swift-source-compatibility": "node --test scripts/check-swift-source-compatibility.test.mjs",
    "check:swift-package-candidate": "node scripts/smoke-swift-package-candidate.mjs",
    "check:swift-package-release": "node scripts/smoke-swift-package-candidate.mjs --url https://github.com/santi020k/lumen",
    "check:mcp-snapshot": "pnpm --filter @santi020k/lumen-mcp run check:snapshot",
    "check:mcp-package": "pnpm --filter @santi020k/lumen-mcp run smoke:package",
    "check:plugin-package": "node scripts/check-plugin-package.mjs",
    "check:consumer-packages": "node scripts/smoke-consumer-packages.mjs",
    "check:rendered-migration": "node scripts/check-rendered-migration.mjs",
    "check:react-native-package": "node scripts/smoke-react-native-package.mjs",
    "check:react-native-native-package:android": "node scripts/smoke-react-native-native-package.mjs android",
    "check:react-native-native-package:ios": "node scripts/smoke-react-native-native-package.mjs ios",
    "check:react-native-native-release:android": "node scripts/smoke-react-native-native-package.mjs android",
    "check:react-native-native-release:ios": "node scripts/smoke-react-native-native-package.mjs ios",
    "check:exposure-launch": "node apps/docs/scripts/check-exposure-launch.mjs",
    "check:mcp-evaluation": "pnpm --filter @santi020k/lumen-mcp run eval",
    "sync:registry": "node scripts/sync-registry.mjs",
    "check:registry": "node scripts/sync-registry.mjs --check && node scripts/validate-registry.mjs && pnpm run check:figma-tokens",
    "validate": "pnpm run check:platform-graphics && pnpm run test:platform-identifiers && pnpm run check:platform-icons && pnpm run test:platform-icons && pnpm run check:swift-assets && pnpm run check:platform-tokens && pnpm run check:playground-store-readiness && pnpm run check:playground-eas-version && pnpm run test:playground-eas-version && pnpm run check:compose-version && pnpm run check:release-manifest && pnpm run check:react-native-peer-docs && pnpm run test:react-native-peer-docs && pnpm run check:swift-version && pnpm run test:swift-version && pnpm run test:coordinated-v2-versions && pnpm run check:lumen-2-contract && pnpm run test:lumen-2-contract && pnpm run build && pnpm run check:bundle-size && pnpm run check:web-api-baseline && pnpm run test:web-api-baseline && pnpm run check:framework-contracts && pnpm run check:native-contracts && pnpm run check:native-captures && pnpm run check:native-api-baseline && pnpm run check:compose-api-classification && pnpm run test:compose-api-classification && pnpm run check:wear-api-classification && pnpm run check:native-consumer-evidence && pnpm run test:native-consumer-evidence && pnpm run check:native-device-evidence && pnpm run test:native-device-evidence && pnpm run check:native-stability-readiness && pnpm run test:native-stability-soak && pnpm run test:native-stable-readiness && pnpm run test:approved-release-revision && pnpm run test:coordinated-release-revision && pnpm run check:graduated-release-revision && pnpm run test:graduated-release-revision && pnpm run test:maven-release-artifacts && pnpm run test:npm-release-provenance && pnpm run test:published-package-family && pnpm run test:v2-release-workflows && pnpm run check:mcp-snapshot && pnpm run check:mcp-evaluation && pnpm run check:plugin-package && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run lint:spell && pnpm run lint:knip && pnpm run check:registry && pnpm run check:security && pnpm run check:publish-dry-run && pnpm run check:consumer-packages && pnpm run check:react-native-package && pnpm run check:mcp-package",
    "check:affected": "turbo run build typecheck lint test --affected && node scripts/check-affected-files.mjs",
    "ok": "pnpm install --frozen-lockfile && pnpm run validate",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm run sync:coordinated-v2-versions && pnpm run sync:compose-version && pnpm install --lockfile-only && pnpm run generate:release-manifest && pnpm run sync:swift-version && pnpm --filter @santi020k/lumen-mcp run generate",
    "release": "pnpm run validate && node scripts/check-approved-release-revision.mjs && changeset publish",
    "publish-packages": "node scripts/check-approved-release-revision.mjs && pnpm run check:graduated-release-revision && pnpm run check:native-consumer-evidence && pnpm run check:native-stability-readiness && pnpm run build && changeset publish",
    "docs:dev": "pnpm --filter @santi020k/lumen-docs dev",
    "docs:build": "turbo run build --filter=@santi020k/lumen-docs",
    "docs:preview": "pnpm --filter @santi020k/lumen-docs preview",
    "playground:android:build": "./packages/compose/gradlew -p apps/playground-android assembleDebug",
    "playground:android:bundle": "./packages/compose/gradlew -p apps/playground-android :app:bundleRelease",
    "playground:android:bundle:signed": "infisical run --env=dev --path=/playground/google-play -- apps/playground-android/scripts/build-signed-bundle.sh",
    "playground:apple:build": "swift build --package-path apps/playground-apple",
    "playground:apple:release-preflight": "apps/playground-apple/scripts/release-preflight.sh",
    "playground:store-assets": "apps/playground-apple/scripts/generate-app-icons.sh && apps/playground-android/scripts/generate-app-icons.sh && apps/playground-react-native/scripts/generate-app-assets.sh",
    "playground:react-native": "pnpm --filter @santi020k/lumen-playground-react-native dev",
    "playground:react-native:web": "pnpm --filter @santi020k/lumen-playground-react-native web",
    "playground:react-native:capture": "pnpm --filter @santi020k/lumen-playground-react-native run capture:components",
    "playground:react-native:test:a11y": "pnpm --filter @santi020k/lumen-playground-react-native run test:a11y:web",
    "docs:pages:dev": "pnpm run docs:build && pnpm exec wrangler pages dev apps/docs/dist",
    "docs:deploy": "pnpm run docs:build && pnpm exec wrangler pages deploy apps/docs/dist --project-name=lumen --branch=main",
    "mcp:deploy": "pnpm --filter @santi020k/lumen-mcp run build && pnpm exec wrangler deploy --config wrangler.mcp.jsonc",
    "clean": "turbo run clean && rm -rf node_modules",
    "hooks:install": "quality hooks install",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run check:affected",
    "commit": "commitprompt",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:interactions": "playwright test -c playwright.interactions.config.ts",
    "test:framework-conformance": "playwright test -c playwright.conformance.config.ts",
    "test:framework-visual": "playwright test -c playwright.frameworks.config.ts",
    "test:framework-visual:update": "playwright test -c playwright.frameworks.config.ts --update-snapshots",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@lucide/icons": "catalog:",
    "@playwright/test": "catalog:",
    "@santi020k/commitprompt": "catalog:",
    "@santi020k/eslint-config-astro": "catalog:",
    "@santi020k/eslint-config-basic": "catalog:",
    "@santi020k/eslint-config-expo": "catalog:",
    "@santi020k/eslint-config-extensions": "catalog:",
    "@santi020k/eslint-config-formats": "catalog:",
    "@santi020k/eslint-config-libraries": "catalog:",
    "@santi020k/eslint-config-next": "catalog:",
    "@santi020k/eslint-config-react": "catalog:",
    "@santi020k/eslint-config-testing": "catalog:",
    "@santi020k/eslint-config-tools": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "lint-staged": {
    "*": [
      "cspell --no-must-find-files"
    ],
    "*.{astro,js,mjs,ts,tsx,mts}": [
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ]
  }
}

---
import {
  Badge,
  ButtonLink,
  Card,
  Icon,
  Link,
  Progress
} from '@santi020k/lumen-astro'

interface Props {
  basePath: string
}

const { basePath } = Astro.props

const templates = [
  {
    number: '01',
    name: 'Everyday commerce',
    route: 'ecommerce',
    text: 'A considered storefront, a working cart, and room for your own collection.',
    icon: 'shopping-bag'
  },
  {
    number: '02',
    name: 'Clarity at a glance',
    route: 'dashboard',
    text: 'Readable metrics, period comparisons, and charts that share your visual language.',
    icon: 'chart-no-axes-combined'
  },
  {
    number: '03',
    name: 'Work worth showing',
    route: 'portfolio',
    text: 'An editorial portfolio that gives your projects the space they deserve.',
    icon: 'layers'
  }
] as const
---

<section class="starter-hero starter-container">
  <div class="starter-hero-copy">
    <Badge variant="outline">Built with Astro + Lumen UI</Badge>
    <h1>
      Make room for
      <br />
      your <em>next idea.</em>
    </h1>
    <p class="starter-lead">
      A thoughtful beginning for whatever you’re building. Four free templates,
      seven expressive themes, and components ready to make your own.
    </p>
    <div class="starter-actions">
      <ButtonLink href="#templates" showArrow>
        Find your starting point
      </ButtonLink>
      <ButtonLink href={`${basePath}/dashboard`} variant="ghost">
        Explore the dashboard
      </ButtonLink>
    </div>
    <p class="starter-fine">
      Open source. Free for personal and commercial projects.
    </p>
  </div>
  <div
    class="starter-hero-art"
    aria-label="A preview of the starter's adaptable interface"
  >
    <div class="starter-orbit" aria-hidden="true"></div>
    <Card class="starter-mini-window">
      <div class="starter-mini-heading">
        <span class="starter-dots" aria-hidden="true">
          ● ● ●
        </span>
        <span>Your next chapter</span>
        <Icon name="arrow-up-right" />
      </div>
      <div class="starter-mini-content">
        <Badge variant="secondary">A little more possibility</Badge>
        <h2>
          Good ideas.
          <br />
          <em>Great beginnings.</em>
        </h2>
        <div class="starter-mini-grid">
          <div class="starter-mini-tile">
            <Icon name="layers" size="lg" />
            <strong>7 themes</strong>
            <span>One shared foundation</span>
          </div>
          <div class="starter-mini-tile starter-mini-tile-accent">
            <Icon name="sparkles" size="lg" />
            <strong>Yours to build</strong>
            <span>From the first commit</span>
          </div>
        </div>
        <div class="starter-progress-label">
          <span>Your starting point</span>
          <strong>Ready</strong>
        </div>
        <Progress value={100} aria-label="Starter readiness" />
      </div>
    </Card>
    <div class="starter-art-caption">
      <span class="starter-dot"></span> Change the theme. Keep the idea.
    </div>
  </div>
</section>
<section class="starter-values" aria-label="Starter features">
  <div class="starter-container starter-values-inner">
    <span>
      <Icon name="palette" /> Seven theme families
    </span>
    <span>
      <Icon name="sun-moon" /> Light & dark
    </span>
    <span>
      <Icon name="keyboard" /> Keyboard friendly
    </span>
    <span>
      <Icon name="code" /> Editable Astro source
    </span>
  </div>
</section>
<section class="starter-container starter-section" id="templates">
  <div class="starter-section-heading">
    <div>
      <p class="starter-eyebrow">A place to begin</p>
      <h2>
        Different ideas.
        <br />
        <em>The same good foundation.</em>
      </h2>
    </div>
    <p>
      Choose a direction, then shape every detail around your work. Each
      template uses the same Lumen components and tokens.
    </p>
  </div>
  <div class="starter-template-grid">
    {templates.map(template => (
      <Card class="starter-template-card" as="article">
        <div class="starter-template-art">
          <span>{template.number}</span>
          <Icon name={template.icon} size="xl" />
          <div class="starter-art-lines" aria-hidden="true"></div>
        </div>
        <div class="starter-template-copy">
          <h3>{template.name}</h3>
          <p>{template.text}</p>
          <Link href={`${basePath}/${template.route}`}>
            Explore {template.route} <Icon name="arrow-up-right" />
          </Link>
        </div>
      </Card>
    ))}
  </div>
</section>
<section class="starter-container starter-section starter-closing">
  <p class="starter-eyebrow">Small start. Wide open possibilities.</p>
  <h2>
    Your content.
    <br />
    <em>Your kind of beautiful.</em>
  </h2>
  <p>
    Start with the page you need. Add your identity, connect your data, and
    build from there.
  </p>
  <ButtonLink
    href="https://lumen.santi020k.com/docs/frameworks/astro"
    showArrow
  >
    Build with Lumen
  </ButtonLink>
</section>

---
interface Props {
  kind: 'lamp' | 'chair' | 'table' | 'vase'
  label: string
}

const { kind, label } = Astro.props

const artClasses = {
  lamp: 'starter-product-art-lamp',
  chair: 'starter-product-art-chair',
  table: 'starter-product-art-table',
  vase: 'starter-product-art-vase'
}
---

<div class:list={['starter-product-art', artClasses[kind]]}>
  <svg viewBox="0 0 320 300" role="img" aria-label={label}>
    <ellipse
      cx="160"
      cy="258"
      rx="95"
      ry="13"
      fill="currentColor"
      opacity="0.09"
    />
    {kind === 'lamp' && (
      <g>
        <path d="M154 123h12v123h-12z" class="starter-object-detail" />
        <ellipse
          cx="160"
          cy="246"
          rx="57"
          ry="9"
          class="starter-object-detail"
        />
        <path d="M87 134a73 73 0 0 1 146 0z" class="starter-object" />
        <ellipse
          cx="160"
          cy="134"
          rx="73"
          ry="10"
          class="starter-object-shadow"
        />
        <path
          d="M114 116c5-25 20-39 39-43"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          opacity="0.18"
        />
      </g>
    )}
    {kind === 'chair' && (
      <g>
        <path
          d="m101 178-13 71m123-71 17 71"
          stroke="currentColor"
          stroke-width="12"
          stroke-linecap="round"
          class="starter-object-detail"
        />
        <path d="M94 74q66-35 132 0l-12 100H107z" class="starter-object" />
        <path d="M86 172q74-16 148 0l-8 26H94z" class="starter-object-shadow" />
        <path
          d="M112 82q48-22 96 0"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          opacity="0.18"
        />
      </g>
    )}
    {kind === 'table' && (
      <g>
        <path d="M126 142h68l12 100h-92z" class="starter-object" />
        <ellipse
          cx="160"
          cy="244"
          rx="46"
          ry="11"
          class="starter-object-shadow"
        />
        <ellipse
          cx="160"
          cy="140"
          rx="92"
          ry="28"
          class="starter-object-shadow"
        />
        <ellipse cx="160" cy="131" rx="92" ry="28" class="starter-object" />
        <ellipse
          cx="160"
          cy="128"
          rx="67"
          ry="17"
          fill="none"
          stroke="currentColor"
          opacity="0.14"
        />
      </g>
    )}
    {kind === 'vase' && (
      <g>
        <path
          d="M139 80h42v41c0 23 45 42 39 89-3 30-25 40-60 40s-57-10-60-40c-6-47 39-66 39-89z"
          class="starter-object"
        />
        <ellipse
          cx="160"
          cy="80"
          rx="21"
          ry="6"
          class="starter-object-shadow"
        />
        <path
          d="M127 164c-17 21-15 45-8 55"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          opacity="0.18"
        />
      </g>
    )}
  </svg>
</div>

---
import {
  Badge,
  Button,
  ButtonLink,
  Card,
  Icon,
  Link,
  Stat
} from '@santi020k/lumen-astro'

import ProductArt from './ProductArt.astro'

const products = [
  {
    id: 'arc',
    name: 'Arc table lamp',
    description: 'A softer light for slower evenings.',
    price: 89,
    kind: 'lamp'
  },
  {
    id: 'form',
    name: 'Form lounge chair',
    description: 'A quiet corner, comfortably yours.',
    price: 249,
    kind: 'chair'
  },
  {
    id: 'column',
    name: 'Column side table',
    description: 'A little space for your everyday rituals.',
    price: 129,
    kind: 'table'
  },
  {
    id: 'still',
    name: 'Still ceramic vase',
    description: 'A sculptural home for a single stem.',
    price: 45,
    kind: 'vase'
  }
] as const
---

<section class="starter-container starter-store-heading">
  <div class="starter-store-brand">
    form<span> / everyday objects</span>
  </div>
  <Link href="#bag">
    <Icon name="shopping-bag" /> Your bag <span data-cart-count>0</span>
  </Link>
</section>
<section class="starter-container starter-store-hero">
  <div>
    <p class="starter-eyebrow">The everyday collection / 01</p>
    <h1>
      Less, but
      <br />
      <em>lovelier.</em>
    </h1>
    <p class="starter-lead">
      Considered objects for the spaces you live in. Useful, familiar, and a
      little unexpected.
    </p>
    <ButtonLink href="#collection" showArrow>
      Explore the collection
    </ButtonLink>
  </div>
  <div class="starter-featured-product">
    <ProductArt kind="lamp" label="Illustration of an arched dome table lamp" />
    <div>
      <span>Arc table lamp</span>
      <strong>$89</strong>
    </div>
    <Badge variant="outline">Everyday favorite</Badge>
  </div>
</section>
<section class="starter-container starter-section" id="collection">
  <div class="starter-section-heading">
    <div>
      <p class="starter-eyebrow">Made for your space</p>
      <h2>
        Good company.
        <br />
        <em>Every day.</em>
      </h2>
    </div>
    <p>
      This sample collection is ready for your products, photography, and
      commerce backend.
    </p>
  </div>
  <div class="starter-product-grid">
    {products.map(product => (
      <Card as="article" class="starter-product-card">
        <ProductArt
          kind={product.kind}
          label={`Illustration of ${product.name.toLowerCase()}`}
        />
        <div class="starter-product-copy">
          <div class="starter-between">
            <h3>{product.name}</h3>
            <strong>${product.price}</strong>
          </div>
          <p>{product.description}</p>
          <Button variant="outline" data-add-product={product.id}>
            <Icon name="plus" /> Add to bag
            <span class="starter-sr-only">, {product.name}</span>
          </Button>
        </div>
      </Card>
    ))}
  </div>
</section>
<section
  class="starter-container starter-section starter-cart-layout"
  id="bag"
  aria-labelledby="bag-title"
>
  <div>
    <p class="starter-eyebrow">A few good things</p>
    <h2 id="bag-title">Your bag.</h2>
    <p class="starter-lead">Keep the things you love close.</p>
    <p class="starter-muted">
      Demo storefront · Prices in USD. Connect your commerce service to accept
      orders and calculate shipping and tax.
    </p>
  </div>
  <Card class="starter-cart">
    <p data-cart-empty>Your bag is waiting for something lovely.</p>
    <ul class="starter-cart-items" aria-label="Items in your bag">
      {products.map(product => (
        <li data-cart-row={product.id} data-price={product.price} hidden>
          <div>
            <strong>{product.name}</strong>
            <span>
              <span data-cart-quantity>0</span> × ${product.price}
            </span>
          </div>
          <Button
            variant="ghost"
            size="sm"
            data-remove-product={product.id}
            aria-label={`Remove ${product.name}`}
          >
            Remove
          </Button>
        </li>
      ))}
    </ul>
    <div class="starter-cart-total">
      <Stat variant="bare" label="Subtotal" value="$0.00" data-cart-total />
    </div>
    <Button data-demo-checkout disabled>
      Preview checkout <Icon name="arrow-right" />
    </Button>
    <p class="starter-fine" data-cart-status role="status" aria-live="polite">
      Add a product to try the sample cart.
    </p>
  </Card>
</section>
<script>
  import '../scripts/cart'
</script>

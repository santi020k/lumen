---
import {
  Badge,
  Card,
  Icon,
  Label,
  LineChart,
  Link,
  Select,
  Stat,
  Table
} from '@santi020k/lumen-astro'

const periods = [
  {
    id: '7',
    label: 'Last 7 days',
    revenue: '$4,820',
    orders: '42',
    average: '$114.76',
    growth: '+8.2%',
    points: [420, 610, 580, 720, 690, 840, 960],
    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
  },
  {
    id: '30',
    label: 'Last 30 days',
    revenue: '$18,640',
    orders: '164',
    average: '$113.66',
    growth: '+12.4%',
    points: [3800, 4220, 4800, 5820],
    labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4']
  },
  {
    id: '90',
    label: 'Last 90 days',
    revenue: '$51,280',
    orders: '456',
    average: '$112.46',
    growth: '+16.8%',
    points: [15200, 17440, 18640],
    labels: ['Month 1', 'Month 2', 'Month 3']
  }
]

const orders = [
  {
    id: '#FM-1048',
    item: 'Arc table lamp',
    date: 'Nov 8',
    amount: '$89.00',
    status: 'Delivered'
  },
  {
    id: '#FM-1047',
    item: 'Form lounge chair',
    date: 'Nov 8',
    amount: '$249.00',
    status: 'Shipped'
  },
  {
    id: '#FM-1046',
    item: 'Still ceramic vase',
    date: 'Nov 7',
    amount: '$45.00',
    status: 'Delivered'
  },
  {
    id: '#FM-1045',
    item: 'Column side table',
    date: 'Nov 7',
    amount: '$129.00',
    status: 'Processing'
  }
]
---

<div class="starter-container starter-dashboard">
  <aside class="starter-dashboard-sidebar" aria-label="Dashboard sections">
    <strong>
      form<span> / studio</span>
    </strong>
    <p class="starter-eyebrow">Workspace</p>
    <nav>
      <Link href="#overview" aria-current="page">
        <Icon name="layout-dashboard" /> Overview
      </Link>
      <Link href="#revenue">
        <Icon name="chart-no-axes-combined" /> Revenue
      </Link>
      <Link href="#orders">
        <Icon name="shopping-bag" /> Recent orders
      </Link>
    </nav>
    <div class="starter-sidebar-note">
      <Icon name="sparkles" />
      <p>A little clarity goes a long way.</p>
      <span>Illustrative business data</span>
    </div>
  </aside>
  <div class="starter-dashboard-content" id="overview">
    <header class="starter-dashboard-header">
      <div>
        <p class="starter-eyebrow">Your business, in perspective</p>
        <h1>
          A good day
          <br />
          <em>to see the bigger picture.</em>
        </h1>
      </div>
      <div class="starter-period-control">
        <Label for="starter-period">Reporting period</Label>
        <Select
          id="starter-period"
          value="30"
          options={periods.map(period => ({
            value: period.id,
            label: period.label
          }))}
        />
      </div>
    </header>
    <p class="starter-muted" data-period-status role="status">
      Showing illustrative results for the last 30 days.
    </p>
    {periods.map(period => (
      <section
        data-period-panel={period.id}
        hidden={period.id !== '30'}
        aria-label={`${period.label} results`}
      >
        <div class="starter-metrics">
          <Card>
            <Stat variant="bare" label="Revenue" value={period.revenue} />
            <Badge variant="success">{period.growth}</Badge>
            <p class="starter-fine">vs. previous period</p>
          </Card>
          <Card>
            <Stat variant="bare" label="Orders" value={period.orders} />
            <p class="starter-fine">A little joy, delivered</p>
          </Card>
          <Card>
            <Stat variant="bare" label="Average order" value={period.average} />
            <p class="starter-fine">Revenue per order</p>
          </Card>
        </div>
        <Card
          class="starter-chart"
          id={period.id === '30' ? 'revenue' : undefined}
        >
          <div class="starter-between">
            <div>
              <p class="starter-eyebrow">Steady progress</p>
              <h2>Revenue over time</h2>
            </div>
            <Badge variant="outline">{period.label}</Badge>
          </div>
          <LineChart
            area
            heading={`Revenue, ${period.label.toLowerCase()}`}
            presentation="bare"
            formatValue={(value: number) => `$${value.toLocaleString('en-US')}`}
            series={[
              {
                id: 'revenue',
                label: 'Revenue (USD)',
                tone: 'brand',
                data: period.points.map((y, index) => ({
                  x: period.labels[index] ?? String(index),
                  y
                }))
              }
            ]}
          />
        </Card>
      </section>
    ))}
    <Card class="starter-orders" id="orders">
      <div class="starter-between">
        <div>
          <p class="starter-eyebrow">The latest</p>
          <h2>Recent orders</h2>
        </div>
        <div class="starter-order-filter">
          <Label for="starter-order-status">Order status</Label>
          <Select
            id="starter-order-status"
            value="all"
            options={[
              { value: 'all', label: 'All orders' },
              { value: 'Delivered', label: 'Delivered' },
              { value: 'Shipped', label: 'Shipped' },
              { value: 'Processing', label: 'Processing' }
            ]}
          />
        </div>
      </div>
      <Table aria-label="Recent sample orders" scrollCue stickyFirstColumn>
        <table>
          <thead>
            <tr>
              <th scope="col">Order</th>
              <th scope="col">Product</th>
              <th scope="col">Date</th>
              <th scope="col">Amount</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {orders.map(order => (
              <tr data-order-status={order.status}>
                <td>{order.id}</td>
                <td>{order.item}</td>
                <td>{order.date}</td>
                <td>{order.amount}</td>
                <td>
                  <Badge
                    variant={
                      order.status === 'Delivered' ? 'success' : 'secondary'
                    }
                  >
                    {order.status}
                  </Badge>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </Table>
      <p class="starter-fine" data-order-status-message role="status">
        Showing all 4 sample orders.
      </p>
    </Card>
  </div>
</div>
<script>
  const periodSelect =
    document.querySelector<HTMLSelectElement>('#starter-period')

  periodSelect?.addEventListener('change', () => {
    for (const panel of document.querySelectorAll<HTMLElement>(
      '[data-period-panel]'
  )) {
      const selected = panel.dataset.periodPanel === periodSelect.value

      panel.hidden = !selected

      const chart = panel.querySelector<HTMLElement>('.starter-chart')

      if (chart) {
        if (selected) chart.id = 'revenue'
        else chart.removeAttribute('id')
      }
    }

    document
      .querySelector('[data-period-status]')
      ?.replaceChildren(
        `Showing illustrative results for the last ${periodSelect.value} days.`
    )
  })

  const orderStatus = document.querySelector<HTMLSelectElement>(
    '#starter-order-status'
)

  orderStatus?.addEventListener('change', () => {
    let count = 0

    for (const row of document.querySelectorAll<HTMLTableRowElement>(
      '[data-order-status]'
  )) {
      row.hidden =
        orderStatus.value !== 'all' &&
        row.dataset.orderStatus !== orderStatus.value

      if (!row.hidden) count += 1
    }

    document
      .querySelector('[data-order-status-message]')
      ?.replaceChildren(
        `Showing ${count} sample ${count === 1 ? 'order' : 'orders'}.`
    )
  })
</script>

---
import {
  Badge,
  Button,
  ButtonLink,
  Card,
  Icon,
  Link
} from '@santi020k/lumen-astro'

const projects = [
  {
    number: '01',
    title: 'Form, a quieter kind of commerce',
    category: 'Product',
    type: 'Digital storefront · 2026',
    description:
      'An exploration of intentional shopping, thoughtful details, and a little more breathing room.',
    style: 'starter-project-art-form',
    heading: 'Objects for\neveryday living.'
  },
  {
    number: '02',
    title: 'Field notes, collected',
    category: 'Editorial',
    type: 'Reading experience · 2026',
    description:
      'A home for ideas in progress. An editorial system designed around the simple pleasure of reading.',
    style: 'starter-project-art-field',
    heading: 'A place for\nsmall discoveries.'
  },
  {
    number: '03',
    title: 'A clearer picture',
    category: 'Product',
    type: 'Analytics workspace · 2025',
    description:
      'A useful overview that helps a small team understand its work and choose what comes next.',
    style: 'starter-project-art-clarity',
    heading: 'See what\ncomes next.'
  },
  {
    number: '04',
    title: 'Studio, in good company',
    category: 'Brand',
    type: 'Visual identity · 2025',
    description:
      'A flexible identity for people doing thoughtful work together. Built to feel human at every size.',
    style: 'starter-project-art-studio',
    heading: 'Good ideas\nlike company.'
  }
]
---

<section class="starter-container starter-portfolio-intro">
  <div class="starter-between">
    <span class="starter-portfolio-wordmark">
      Alex Morgan<span> / independent designer</span>
    </span>
    <Badge variant="outline">
      <span class="starter-dot"></span> Sample portfolio
    </Badge>
  </div>
  <h1>
    Good design
    <br />
    <em>makes space.</em>
  </h1>
  <div class="starter-portfolio-summary">
    <p class="starter-lead">
      I make thoughtful digital experiences for people with something to share.
      A little strategy, a lot of care, and room for the unexpected.
    </p>
    <ButtonLink href="#selected-work" variant="ghost" showArrow>
      See selected work
    </ButtonLink>
  </div>
</section>
<section
  class="starter-container starter-section"
  id="selected-work"
  aria-labelledby="work-heading"
>
  <div class="starter-between starter-work-header">
    <div>
      <p class="starter-eyebrow">A few things I’ve made</p>
      <h2 id="work-heading">Selected work</h2>
    </div>
    <div class="starter-filters" role="group" aria-label="Filter projects">
      {['All', 'Product', 'Editorial', 'Brand'].map(category => (
        <Button
          variant="ghost"
          data-project-filter={category}
          aria-pressed={category === 'All'}
        >
          {category}
        </Button>
      ))}
    </div>
  </div>
  <p class="starter-sr-only" data-project-status role="status">
    Showing all 4 projects.
  </p>
  <div class="starter-project-grid">
    {projects.map(project => (
      <article data-project-category={project.category}>
        <Card class:list={['starter-project-art', project.style]}>
          <span>
            {project.number} / {project.category}
          </span>
          <strong>{project.heading}</strong>
          <div class="starter-project-shape" aria-hidden="true"></div>
          <Icon name="arrow-up-right" />
        </Card>
        <div class="starter-project-copy">
          <p class="starter-eyebrow">{project.type}</p>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
<section class="starter-container starter-section starter-about" id="about">
  <div>
    <p class="starter-eyebrow">A little about me</p>
    <h2>
      Curious by nature.
      <br />
      <em>Thoughtful by design.</em>
    </h2>
  </div>
  <div>
    <p>
      I’m Alex, an independent designer working across digital products,
      websites, and visual identities. I like simple ideas that hold up to
      everyday life.
    </p>
    <p>
      This is a sample portfolio. Replace these projects and this introduction
      with your own story, then add your preferred contact link.
    </p>
    <Link href="https://lumen.santi020k.com/docs">
      Explore the components behind this portfolio{' '}
      <Icon name="arrow-up-right" />
    </Link>
  </div>
</section>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(
    '[data-project-filter]'
)

  const projects = document.querySelectorAll<HTMLElement>(
    '[data-project-category]'
)

  for (const filter of filters) {
    filter.addEventListener('click', () => {
      const category = filter.dataset.projectFilter
      let count = 0

      for (const project of projects) {
        project.hidden =
          category !== 'All' && project.dataset.projectCategory !== category

        if (!project.hidden) count += 1
      }

      for (const button of filters)
        button.setAttribute('aria-pressed', String(button === filter))

      document
        .querySelector('[data-project-status]')
        ?.replaceChildren(
          `Showing ${count} ${category === 'All' ? '' : `${category?.toLowerCase()} `}projects.`
      )
    })
  }
</script>

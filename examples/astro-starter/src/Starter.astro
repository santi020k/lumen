---
import '@santi020k/lumen-astro/styles/foundation.css'
import '@santi020k/lumen-astro/styles/themes/studio.css'
import '@santi020k/lumen-astro/styles/themes/paper.css'
import '@santi020k/lumen-astro/styles/themes/field.css'
import '@santi020k/lumen-astro/styles/themes/santi020k.css'
import '@santi020k/lumen-astro/styles/effects/glass.css'
import './styles/harbor.css'
import './styles/starter.css'

import {
  Badge,
  ButtonLink,
  Label,
  Link,
  Select,
  ThemeToggle
} from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import lumenIcon from './assets/lumen-icon.svg?url'
import Dashboard from './components/Dashboard.astro'
import Landing from './components/Landing.astro'
import Portfolio from './components/Portfolio.astro'
import Storefront from './components/Storefront.astro'

interface Props {
  page?: 'landing' | 'ecommerce' | 'dashboard' | 'portfolio'
  basePath?: string
  showStarterLinks?: boolean
  socialImage?: string
  socialImageWidth?: number
  socialImageHeight?: number
}

const {
  page = 'landing', basePath = '', showStarterLinks = false, socialImage,
  socialImageWidth = 1200, socialImageHeight = 630
} = Astro.props

const route = (name: string) => name === 'landing' ? basePath || '/' : `${basePath}/${name}`

const pages = [
  { id: 'landing', label: 'Landing' },
  { id: 'ecommerce', label: 'Ecommerce' },
  { id: 'dashboard', label: 'Dashboard' },
  { id: 'portfolio', label: 'Portfolio' }
]

const themes = [
  { value: 'lumen', label: 'Lumen' },
  { value: 'santi020k', label: 'Santi020k' },
  { value: 'studio', label: 'Studio' },
  { value: 'paper', label: 'Paper' },
  { value: 'field', label: 'Field' },
  { value: 'glass', label: 'Glass' },
  { value: 'harbor', label: 'Harbor' }
]

const titles = {
  landing: 'Make room for your next idea',
  ecommerce: 'Objects for everyday living',
  dashboard: 'A clearer view of your business',
  portfolio: 'Good design makes space'
}

const title = `${titles[page]} · Lumen Astro Starter`
const description = 'Four free Astro templates built with Lumen UI. Explore a storefront, dashboard, landing page, and portfolio in seven themes.'
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined
const imageAlt = `${title} social preview`

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'en'
}).replaceAll('<', '\\u003c')
---

<!doctype html>
<html lang="en" data-theme="lumen-light" data-starter-family="lumen">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href={lumenIcon} type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="description"
      content={description}
    />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {canonical && <meta name="twitter:url" content={canonical} />}
    {canonical && <script is:inline type="application/ld+json" set:html={structuredData} />}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:alt" content={imageAlt} />
        <meta property="og:image:width" content={String(socialImageWidth)} />
        <meta property="og:image:height" content={String(socialImageHeight)} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
    <script is:inline>
      ;

(() => {
        const root = document.documentElement
        let family = 'lumen'

        let mode = window.matchMedia('(prefers-color-scheme: dark)').matches ?
    'dark' :
    'light'

        try {
          const savedFamily = localStorage.getItem('lumen-starter-family')
          const savedMode = localStorage.getItem('lumen-starter-mode')

          if (
            [
              'lumen',
              'santi020k',
              'studio',
              'paper',
              'field',
              'glass',
              'harbor'
      ].includes(savedFamily)
          )
            family = savedFamily

          if (savedMode === 'light' || savedMode === 'dark') mode = savedMode
        } catch {
          /* The starter also works when browser storage is unavailable. */
        }

        root.dataset.theme = `${family === 'santi020k' ? family : 'lumen'}-${mode}`

        root.dataset.starterFamily = family

        root.dataset.lumenScheme = mode

        if (family !== 'lumen' && family !== 'santi020k')
          root.dataset.lumenPreset =
            family === 'harbor' ? 'example-harbor' : family

        root.classList.toggle('dark', mode === 'dark')
      })()
</script>
  </head>
  <body class="starter-body">
    <Link class="starter-skip" href="#main">
      Skip to content
    </Link>
    <div class="starter-toolbar">
      <div class="starter-toolbar-inner">
        <Link
          class="starter-wordmark"
          href={route('landing')}
          variant="inherit"
        >
          <img src={lumenIcon} alt="Lumen UI" width="28" height="28" />
          <span>Astro starter</span>
        </Link>
        <nav aria-label="Template previews" class="starter-nav">
          {pages.map(item => (
            <Link
              aria-current={page === item.id ? 'page' : undefined}
              href={route(item.id)}
              variant="inherit"
            >
              {item.label}
            </Link>
          ))}
        </nav>
        <div class="starter-appearance">
          <Label class="starter-sr-only" for="starter-theme">
            Theme family
          </Label>
          <Select
            id="starter-theme"
            options={themes}
            value="lumen"
            visualSize="sm"
          />
          <ThemeToggle
            controlled
            data-starter-mode
            aria-label="Switch to dark mode"
          />
        </div>
      </div>
    </div>
    <main id="main" tabindex="-1" class="starter-main">
      {page === 'landing' && <Landing basePath={basePath} />}
      {page === 'ecommerce' && <Storefront />}
      {page === 'dashboard' && <Dashboard />}
      {page === 'portfolio' && <Portfolio />}
    </main>
    <footer class="starter-footer">
      <div>
        <strong>Make it yours.</strong>
        <p>Four starting points. Seven themes. Your next idea.</p>
      </div>
      <div class="starter-footer-links">
        {showStarterLinks && (
          <>
            <ButtonLink
              href="/downloads/lumen-astro-starter.zip"
              variant="secondary"
              download
            >
              Download starter
            </ButtonLink>
            <ButtonLink
              href="https://stackblitz.com/github/santi020k/lumen/tree/main/examples/astro-starter"
              variant="ghost"
              newTab
            >
              Open in browser
            </ButtonLink>
          </>
        )}
        <Badge variant="outline">Free · MIT license</Badge>
        <Link href="https://lumen.santi020k.com/docs/frameworks/astro">
          Lumen documentation
        </Link>
        <Link href="https://santi020k.com">Made by santi020k</Link>
      </div>
    </footer>
    <UIPrimitives />
    <script>
      import './scripts/theme'
    </script>
  </body>
</html>

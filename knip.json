{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/motion": {
      "entry": ["src/pages/**/*.astro", "src/scripts/timeline.ts", "scripts/*.mjs"],
      "project": ["src/**/*.{astro,ts}", "scripts/*.mjs"]
    },
    "apps/figma-plugin": {
      "entry": ["src/plugin.ts", "src/ui.tsx"],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.mjs"]
    },
    ".": {
      "entry": [
        "scripts/check-maven-pom-metadata.mjs",
        "scripts/report-android-workspace-runtime.mjs",
        "examples/astro-starter/astro.config.mjs",
        "examples/astro-starter/src/pages/**/*.astro"
      ],
      "ignoreBinaries": ["codex", "infisical", "pod", "quality", "swift"],
      "project": [
        "*.{js,css}",
        "scripts/*.mjs",
        "scripts/lib/named-themes.mjs",
        "scripts/lib/santi020k-site-colors.mjs",
        "examples/astro-starter/src/**/*.{astro,css,ts}"
      ]
    },
    "apps/docs": {
      "entry": ["src/pages/**/*.astro", "scripts/**/*.{js,mjs}"],
      "ignoreDependencies": [
        "@santi020k/lumen-playground-react-native"
      ],
      "project": ["src/**/*.{astro,css,ts,tsx}", "scripts/**/*.{js,mjs}"]
    },
    "apps/playground-react-native": {
      "entry": ["src/fixtures/TextLayoutProbe.tsx"],
      "project": ["src/**/*.{ts,tsx}", "plugins/*.{cjs,ts}"]
    },
    "packages/astro": {
      "entry": ["components/**/*.astro", "strict-props.fixture.astro"],
      "project": ["**/*.{astro,ts}"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/elements": {
      "project": ["src/**/*.ts"]
    },
    "packages/lumen": {
      "astro": false,
      "entry": [
        "src/index.ts",
        "src/cli.ts",
        "src/build-report-plugin.ts",
        "bin/*.mjs",
        "templates/shared/common/src/lumen/lumen-template.css",
        "templates/{shared,elements}/media-workspace/src/lumen/media-workspace.css",
        "templates/astro/editable-ticket/src/lumen/editable-ticket-controller.ts",
        "templates/astro/editable-ticket/src/lumen/editable-ticket.css",
        "templates/astro/site-search-dialog/src/lumen/site-search-provider.ts",
        "templates/elements/article-reading/src/lumen/article-reading.ts",
        "templates/elements/image-viewer/src/lumen/image-viewer.ts",
        "templates/elements/site-search-dialog/src/lumen/site-search-dialog.ts",
        "templates/react/article-reading/src/lumen/article-reading.css",
        "templates/react/image-viewer/src/lumen/image-viewer.css",
        "templates/react/site-search-dialog/src/lumen/site-search-dialog.css"
      ],
      "ignoreDependencies": ["@types/react", "react"],
      "project": ["bin/*.mjs", "**/*.{css,ts}"]
    },
    "packages/mcp": {
      "entry": ["src/cloudflare-worker.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/react-native": {
      "entry": ["src/static-icon-exports.generated.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/react": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}

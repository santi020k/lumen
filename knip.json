{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "tailwindcss"
      ],
      "project": [
        "*.js",
        "scripts/*.mjs"
      ]
    },
    "apps/docs": {
      "entry": [
        "src/pages/**/*.astro"
      ],
      "project": [
        "src/**/*.{astro,css,ts}"
      ]
    },
    "packages/astro": {
      "entry": [
        "components/**/*.astro"
      ],
      "project": [
        "**/*.{astro,ts}"
      ]
    },
    "packages/core": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/elements": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/lumen": {
      "project": [
        "bin/*.mjs",
        "src/**/*.ts"
      ]
    },
    "packages/react": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  }
}
